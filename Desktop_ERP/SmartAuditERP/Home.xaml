<dx:ThemedWindow
    x:Class="SmartAuditERP.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="تطبيقات المدقق : برنامج الفوترة الإلكترونية للمحاسبة والمستودعات"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    FontFamily="Cairo, Tahoma, Arial"
    Background="#F0F2F7"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown"
    SizeChanged="Window_SizeChanged">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════════════════════════════════
             BRUSHES
        ═══════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="MenuBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3D0073" Offset="0"/>
            <GradientStop Color="#290050" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MenuHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5A0099" Offset="0"/>
            <GradientStop Color="#4F0087" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3D0073" Offset="0"/>
            <GradientStop Color="#5A0099" Offset="0.5"/>
            <GradientStop Color="#3D0073" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2A0050" Offset="0"/>
            <GradientStop Color="#3D0073" Offset="0.5"/>
            <GradientStop Color="#2A0050" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SideBarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A0050" Offset="0"/>
            <GradientStop Color="#1A0030" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="POSBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF8C00" Offset="0"/>
            <GradientStop Color="#CC6600" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3498DB" Offset="0"/>
            <GradientStop Color="#2471A3" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#C8B8E0"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14" ShadowDepth="3"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <DropShadowEffect x:Key="MenuShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.35"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.25"
                          Color="#000000"/>

        <!-- ═══════════════════════════════════════════
             TOP MENU ITEM STYLE
        ═══════════════════════════════════════════ -->
        <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter x:Name="Icon"
                                                  Grid.Row="0"
                                                  Content="{TemplateBinding Icon}"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,4,0,2"/>
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  TextElement.Foreground="White"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.FontSize="10"
                                                  Margin="0,0,0,4"/>
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="#3D0073"
                                            BorderBrush="#5A0099"
                                            BorderThickness="1"
                                            CornerRadius="0,0,6,6"
                                            MinWidth="160"
                                            Effect="{StaticResource MenuShadow}">
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════
             SUB MENU ITEM STYLE
        ═══════════════════════════════════════════ -->
        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  TextElement.Foreground="White"
                                                  VerticalAlignment="Center"/>
                                <Path Grid.Column="1"
                                      x:Name="Arrow"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="White" StrokeThickness="1.5"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       Placement="Right"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="#3D0073"
                                            BorderBrush="#5A0099"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinWidth="180"
                                            Effect="{StaticResource MenuShadow}">
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A0099"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════
             ACTION BUTTON STYLE
        ═══════════════════════════════════════════ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource MenuBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="POSBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource POSBrush}"/>
        </Style>

        <!-- ═══════════════════════════════════════════
             STATUS BAR STYLES
        ═══════════════════════════════════════════ -->
        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3D0073"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusSeparatorStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="|"/>
            <Setter Property="Foreground" Value="#8A6AAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 0 : شريط القوائم الرئيسي
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource MenuBrush}"
                Effect="{StaticResource MenuShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu x:Name="MainMenuStrip"
                      Grid.Column="0"
                      Background="Transparent"
                      Foreground="White"
                      FontFamily="Cairo, Tahoma, Arial"
                      FlowDirection="RightToLeft"
                      Padding="4,0">

                    <!-- ═══ المحاسبة ═══ -->
                    <MenuItem x:Name="StripAccount"
                              Header="المحاسبة"
                              Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem.Icon>
                            <TextBlock Text="📊" FontSize="26" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>

                        <MenuItem x:Name="AccountDefinintionMenu" Header="تعاريف" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripAccountsDirectory"    Header="دليل الحسابات"     Style="{StaticResource SubMenuItemStyle}" Click="stripAccountsDirectory_Click"/>
                            <MenuItem x:Name="stripTreeAcc"              Header="شجرة الحسابات"     Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripTreeAcc_Click"/>
                            <MenuItem x:Name="stripBox"                  Header="بطاقة صندوق"       Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripBox_Click"/>
                            <MenuItem x:Name="stripBank"                 Header="بطاقة بنك"         Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripBank_Click"/>
                            <MenuItem x:Name="stripCostCenterCard"       Header="بطاقة مركز تكلفة"  Style="{StaticResource SubMenuItemStyle}" Click="stripCostCenterCard_Click"/>
                            <MenuItem x:Name="StripPaymentMethodCustomr" Header="طريقة دفع عميل"    Style="{StaticResource SubMenuItemStyle}" Click="StripPaymentMethodCustomr_Click"/>
                            <MenuItem x:Name="StripExpenses"             Header="بطاقة المصاريف"    Style="{StaticResource SubMenuItemStyle}" Click="StripExpenses_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="AccountOper" Header="العمليات" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripIntialBalance"  Header="قيد إفتتاحي"     Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripIntialBalance_Click"/>
                            <MenuItem x:Name="stripAddRestriction" Header="سند قيد"          Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripAddRestriction_Click"/>
                            <MenuItem x:Name="stripSandQabth"      Header="سند قبض"          Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripSandQabth_Click"/>
                            <MenuItem x:Name="stripSandSarf"       Header="سند صرف"          Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripSandSarf_Click"/>
                            <MenuItem x:Name="stripSandVAT"        Header="سند صرف الضريبة"  Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripSandVAT_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="AccountRpt" Header="تقارير محاسبية" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripRestraction"      Header="القيود اليومية"        Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripRestraction_Click"/>
                            <MenuItem x:Name="stripSandat"           Header="عرض السندات"           Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripSandat_Click"/>
                            <MenuItem x:Name="stripAccountBala"      Header="كشف حساب"              Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripAccountBala_Click"/>
                            <MenuItem x:Name="stripAccountStatement" Header="كشف حساب رئيسي"       Style="{StaticResource SubMenuItemStyle}" Click="stripAccountStatement_Click"/>
                            <MenuItem x:Name="stripShowKhzna"        Header="حركة الصندوق"          Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripShowKhzna_Click"/>
                            <MenuItem x:Name="stripRptBalances"      Header="أرصدة الحسابات"        Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripRptBalances_Click"/>
                            <MenuItem x:Name="StripRptCostCenter"    Header="أرصدة مراكز التكلفة"   Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="StripRptCostCenter_Click"/>
                            <MenuItem x:Name="StripCostCenter"       Header="تقرير مركز الكلفة"     Style="{StaticResource SubMenuItemStyle}" Click="StripCostCenter_Click"/>
                            <MenuItem x:Name="stripDailyProcess"     Header="الحركة اليومية"        Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripDailyProcess_Click"/>
                            <MenuItem x:Name="stripMezan"            Header="ميزان المراجعة رئيسي"  Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripMezan_Click"/>
                            <MenuItem x:Name="stripIncomeAnalysis"   Header="قائمة الدخل التحليلية" Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripIncomeAnalysis_Click"/>
                            <MenuItem x:Name="stripIncomeAnalysis2"  Header="قائمة الدخل (جديد)"    Style="{StaticResource SubMenuItemStyle}" Click="stripIncomeAnalysis2_Click"/>
                            <MenuItem x:Name="stripMainbadget1"      Header=""                       Style="{StaticResource SubMenuItemStyle}" Visibility="Collapsed"/>
                            <MenuItem x:Name="stripBadgetAnalys"     Header="ميزانية تحليلية"       Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripBadgetAnalys_Click"/>
                            <MenuItem x:Name="stripMenuTaxReport"    Header="الإقرار الضريبي"       Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripMenuTaxReport_Click"/>
                        </MenuItem>
                    </MenuItem>

                    <!-- ═══ المستودعات ═══ -->
                    <MenuItem x:Name="StripStores"
                              Header="المستودعات"
                              Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem.Icon>
                            <TextBlock Text="🏭" FontSize="26" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>

                        <MenuItem x:Name="StoreDefinition" Header="التعاريف" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="StripItemDirctory" Header="دليل المواد"   Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="StripItemDirctory_Click"/>
                            <MenuItem x:Name="stripStore"        Header="بطاقة مستودع"  Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripStore_Click"/>
                            <MenuItem x:Name="stripGroup"        Header="بطاقة مجموعة"  Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripGroup_Click"/>
                            <MenuItem x:Name="stripUnit"         Header="بطاقة وحدة"    Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripUnit_Click"/>
                            <MenuItem x:Name="stripItem"         Header="بطاقة مادة"    Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripItem_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="StoreOper" Header="العمليات" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripTransfer"            Header="مناقلة"          Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripTransfer_Click"/>
                            <MenuItem x:Name="stripFirstStock"          Header="بضاعة أول مدة"   Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripFirstStock_Click"/>
                            <MenuItem x:Name="stripInputInv"            Header="فاتورة إدخال"    Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripInputInv_Click"/>
                            <MenuItem x:Name="stripOutputInv"           Header="فاتورة إخراج"    Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripOutputInv_Click"/>
                            <MenuItem x:Name="strIpinventoryAdjustment" Header="تسوية مخزنية"    Style="{StaticResource SubMenuItemStyle}" Click="strIpinventoryAdjustment_Click"/>
                            <MenuItem x:Name="StripInvertoryDeliveries" Header="توصيل مخزني"     Style="{StaticResource SubMenuItemStyle}" Click="StripInvertoryDeliveries_Click"/>
                            <MenuItem x:Name="stripInvertoryOrderInv"   Header="طلب بضاعة"       Style="{StaticResource SubMenuItemStyle}" Click="stripInvertoryOrderInv_Click"/>
                            <MenuItem x:Name="StripPrintBarcode"        Header="طباعة الباركود"  Style="{StaticResource SubMenuItemStyle}" Click="StripPrintBarcode_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="StoreRpt" Header="تقارير مستودعية" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripSafeGrd"                  Header="جرد المواد"                      Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripSafeGrd_Click"/>
                            <MenuItem x:Name="StripSafeGrdDate"              Header="جرد المواد حتى تاريخ"           Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="StripSafeGrdDate_Click"/>
                            <MenuItem x:Name="stripItemMov"                  Header="حركة مادة تفصيلي"              Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripItemMov_Click"/>
                            <MenuItem x:Name="stripItemsMovs"                Header="حركة مواد تجميعي"              Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripItemsMovs_Click"/>
                            <MenuItem x:Name="stripExpire"                   Header="صلاحية المواد"                  Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripExpire_Click"/>
                            <MenuItem x:Name="stripSalesAanalysis"           Header="تحليل المبيعات"                 Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripSalesAanalysis_Click"/>
                            <MenuItem x:Name="stripTotalSalePurch"           Header="إجمالي المبيعات والمشتريات"    Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripTotalSalePurch_Click"/>
                            <MenuItem x:Name="stripBenefits"                 Header="أرباح الفواتير"                 Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripBenefits_Click"/>
                            <MenuItem x:Name="stripDecision"                 Header="معدل الدوران والركود"           Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripDecision_Click"/>
                            <MenuItem x:Name="StripRptProducedItems"         Header="تقرير أمر الإنتاج"             Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="StripRptProducedItems_Click"/>
                            <MenuItem x:Name="stripInvbyTypes"               Header="الفواتير بحسب النوع"           Style="{StaticResource SubMenuItemStyle}" Click="stripInvbyTypes_Click"/>
                            <MenuItem x:Name="stripIInvoicesByType"          Header="فواتير بحسب النوع 2"           Style="{StaticResource SubMenuItemStyle}" Click="stripIInvoicesByType_Click"/>
                            <MenuItem x:Name="StripItemsExpiration"          Header="انتهاء صلاحية الأصناف"         Style="{StaticResource SubMenuItemStyle}" Click="StripItemsExpiration_Click"/>
                            <MenuItem x:Name="StripItemsRptSerialNo"         Header="تقرير الأرقام التسلسلية"       Style="{StaticResource SubMenuItemStyle}" Click="StripItemsRptSerialNo_Click"/>
                            <MenuItem x:Name="StripItemsRptSerialNoSummary"  Header="تقرير الأرقام التسلسلية تجميعي" Style="{StaticResource SubMenuItemStyle}" Click="StripItemsRptSerialNoSummary_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="ToolStripsallastore" Header="متجر سلة" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="ToolStripListProductsalla"       Header="المنتجات"         Style="{StaticResource SubMenuItemStyle}" Click="ToolStripListProductsalla_Click"/>
                            <MenuItem x:Name="ToolStripMenuItemGetOrderSallah" Header="إدارة الطلبات"   Style="{StaticResource SubMenuItemStyle}" Click="ToolStripMenuItemGetOrderSallah_Click"/>
                            <MenuItem x:Name="ToolStripMenuItemSallaSafes"     Header="ربط المستودعات"  Style="{StaticResource SubMenuItemStyle}" Click="ToolStripMenuItemSallaSafes_Click"/>
                        </MenuItem>
                    </MenuItem>

                    <!-- ═══ المشتريات ═══ -->
                    <MenuItem x:Name="StripPurches"
                              Header="المشتريات"
                              Style="{StaticResource TopMenuItemStyle}">
                        <MenuItem.Icon>
                            <TextBlock Text="🛒" FontSize="26" HorizontalAlignment="Center"/>
                        </MenuItem.Icon>

                        <MenuItem x:Name="PurchOper" Header="العمليات" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripPurchInv"    Header="فاتورة المشتريات" Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripPurchInv_Click"/>
                            <MenuItem x:Name="stripPurchReturn" Header="مردود المشتريات"  Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripPurchReturn_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="PurchSand" Header="السندات" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripPaySupl"    Header="سند صرف لمورد" Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripPaySupl_Click"/>
                            <MenuItem x:Name="stripShowSand"   Header="عرض السندات"   Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripShowSand_Click"/>
                            <MenuItem x:Name="stripCreditNote" Header="إشعار دائن"    Style="{StaticResource SubMenuItemStyle}" Visibility="Collapsed" Click="stripCreditNote_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="ToolStripNotficPurch" Header="الإشعارات" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="ToolStripNotficDeptPurch"   Header="إشعار دائن"      Style="{StaticResource SubMenuItemStyle}" Click="ToolStripNotficDeptPurch_Click"/>
                            <MenuItem x:Name="ToolStripNotficCreditPurch" Header="إشعار مدين"      Style="{StaticResource SubMenuItemStyle}" Click="ToolStripNotficCreditPurch_Click"/>
                            <MenuItem x:Name="RptNotficPurch"             Header="تقرير الإشعارات" Style="{StaticResource SubMenuItemStyle}" Click="RptNotficPurch_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="PurchRpt" Header="التقارير" Style="{StaticResource SubMenuItemStyle}">
                            <MenuItem x:Name="stripSupplAccou"               Header="كشف مورد"                       Style="{StaticResource SubMenuItemStyle}" IsEnabled="False" Click="stripSupplAccou_Click"/>
                            <MenuItem x:Name="StripRptInvPurchaseDetails"    Header="تقرير فواتير المشتريات"         Style="{StaticResource SubMenuItemStyle}" Click="StripRptInvPurchaseDetails_Click"/>
                            <MenuItem x:Name="StripRptReturnPurchaseDetails" Header="تقرير مردود فواتير المشتريات"  Style="{StaticResource SubMenuItemStyle}" Click="StripRptReturnPurchaseDetails_Click"/>
                            <MenuItem x:Name="StripRptNetPurchase"           Header="صافي المشتريات"                 Style="{StaticResource SubMenuItemStyle}" Click="StripRptNetPurchase_Click"/>
