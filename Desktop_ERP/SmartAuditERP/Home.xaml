        <!-- ═══════════════════════════════════════════════════════════════
             ROW 1 : المحتوى الرئيسي
        ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- المنطقة الرئيسية -->
            <Border Grid.Column="0"
                    x:Name="Panel2"
                    Background="#F0F2F7">
                <Grid>
                    <!-- لوحة الترحيب والوصول السريع -->
                    <StackPanel x:Name="PanelCenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="White"
                                CornerRadius="16"
                                Padding="40,30"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🏢"
                                           FontSize="64"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="lblWelcomeTitle"
                                           Text="مرحباً بكم في تطبيقات المدقق"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#3D0073"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="برنامج الفوترة الإلكترونية للمحاسبة والمستودعات"
                                           FontSize="14"
                                           Foreground="#666"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,20"/>

                                <!-- بطاقات الوصول السريع -->
                                <WrapPanel HorizontalAlignment="Center"
                                           Orientation="Horizontal">

                                    <Button x:Name="BtnSales"
                                            Style="{StaticResource ActionBtn}"
                                            Width="110" Height="80"
                                            Margin="6"
                                            Visibility="Collapsed"
                                            Click="BtnSales_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🧾" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="فاتورة مبيعات" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnPurches"
                                            Style="{StaticResource ActionBtn}"
                                            Width="110" Height="80"
                                            Margin="6"
                                            Visibility="Collapsed"
                                            Click="BtnPurches_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🛒" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="فاتورة مشتريات" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnQutation"
                                            Style="{StaticResource ActionBtn}"
                                            Width="110" Height="80"
                                            Margin="6"
                                            Visibility="Collapsed"
                                            Click="BtnQutation_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="عرض سعر" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnaddSupplier"
                                            Style="{StaticResource ActionBtn}"
                                            Width="110" Height="80"
                                            Margin="6"
                                            Background="{StaticResource InfoBrush}"
                                            Visibility="Collapsed"
                                            Click="BtnaddSupplier_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🏢" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="تعريف مورد" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnAddcustomer"
                                            Style="{StaticResource ActionBtn}"
                                            Width="110" Height="80"
                                            Margin="6"
                                            Background="{StaticResource SaveBrush}"
                                            Visibility="Collapsed"
                                            Click="BtnAddcustomer_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="تعريف عميل" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnAddItems"
                                            Style="{StaticResource ActionBtn}"
                                            Width="110" Height="80"
                                            Margin="6"
                                            Background="{StaticResource POSBrush}"
                                            Visibility="Collapsed"
                                            Click="BtnAddItems_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center"/>
                                            <TextBlock Text="تعريف مادة" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- الشريط الجانبي -->
            <Border Grid.Column="1"
                    x:Name="FlowLayoutPanel1"
                    Width="110"
                    Background="{StaticResource SideBarBrush}"
                    VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Top"
                            Margin="4,8">
                    <Button x:Name="btnPOS2"
                            Style="{StaticResource POSBtn}"
                            Height="90"
                            Width="98"
                            Margin="0,0,0,6"
                            Click="btnPOS2_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🖥️" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="نقطة بيع" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
     ROW 2 : شريط الحالة السفلي
════════════════════════════════════════════════════════════════ -->
        <Border x:Name="ToolStrip1"
        Grid.Row="2"
        Background="#E8E0F0"
        BorderBrush="#C8B8E0"
        BorderThickness="0,1,0,0"
        Padding="6,4"
        MinHeight="34">

            <DockPanel LastChildFill="True">

                <!-- ═══ الجانب الأيمن (يظهر أولاً في RTL) ═══ -->
                <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- زر تسجيل الخروج -->
                    <Button x:Name="btnLogOutSmall"
                    Width="28" Height="28"
                    Margin="4,0"
                    Style="{StaticResource ActionBtn}"
                    Background="{StaticResource DangerBrush}"
                    ToolTip="تسجيل الخروج"
                    Click="btnLogOut_Click">
                        <TextBlock Text="🚪" FontSize="13"/>
                    </Button>

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- الوقت -->
                    <TextBlock Text="🕐" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock x:Name="lblTime2"
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="2,0,6,0"
                       FlowDirection="LeftToRight"
                       MinWidth="130"/>

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- المستخدم -->
                    <TextBlock Text="👤" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock x:Name="txtLoggedUser1"
                       Style="{StaticResource StatusLabelStyle}"
                       Foreground="#3D0073"
                       Margin="2,0,6,0"/>

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- الفرع -->
                    <TextBlock Text="🏢" FontSize="12" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock x:Name="lblBranch1"
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="2,0,6,0"/>

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- نسخة تجريبية -->
                    <TextBlock x:Name="lblIsTrial1"
                       Style="{StaticResource StatusLabelStyle}"
                       Foreground="#B92F2F"
                       FontWeight="Bold"
                       Margin="2,0,6,0"/>

                    <!-- حالة الاتصال بالبصمة -->
                    <TextBlock x:Name="lblConnectBar"
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="2,0,4,0"/>

                </StackPanel>

                <!-- ═══ الجانب الأيسر (يظهر ثانياً في RTL) ═══ -->
                <StackPanel DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- إشعارات Zatca والترخيص -->
                    <TextBlock x:Name="LblZatca"
                       Text="✅ الربط الضريبي فعال"
                       Foreground="#0F9609"
                       FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Visibility="Collapsed"/>

                    <TextBlock x:Name="lblNosendzatca"
                       Text="يوجد"
                       Foreground="Crimson"
                       FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="2,0"
                       Visibility="Collapsed"
                       Cursor="Hand"
                       MouseLeftButtonUp="lblNosendzatca_Click"/>

                    <TextBlock x:Name="LblLicenseExpire"
                       Foreground="Red"
                       FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Cursor="Hand"
                       MouseLeftButtonUp="LblLicenseExpire_Click"/>

                    <TextBlock x:Name="lblnotify"
                       Text="حالة المزامنة نشطة"
                       FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       Visibility="Collapsed"
                       Cursor="Hand"
                       MouseLeftButtonUp="lblnotify_Click"/>

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- زر إطلب المساعدة -->
                    <Button x:Name="btnSupportTicketBar"
                    Style="{StaticResource ActionBtn}"
                    Padding="8,3"
                    Margin="4,0"
                    Click="BtnSupportTicket_Click">
                        <TextBlock Text="🆘 إطلب المساعدة" FontSize="10" FontWeight="Bold"/>
                    </Button>

                </StackPanel>

                <!-- ═══ المنتصف (يملأ المساحة المتبقية) ═══ -->
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- الإصدار -->
                    <TextBlock Text="📦" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock x:Name="lblVersion"
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="2,0,6,0"/>

                    <!-- قاعدة البيانات -->
                    <TextBlock Text="🗄️" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock x:Name="lbldbName"
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="2,0,6,0"/>

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- نوع الجهاز -->
                    <TextBlock x:Name="lblDeviceType"
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="2,0,6,0"/>

                    <TextBlock Style="{StaticResource StatusSeparatorStyle}"/>

                    <!-- حالة المزامنة -->
                    <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
                    <TextBlock x:Name="btnSyncIng"
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="2,0,4,0"
                       Cursor="Hand"
                       MouseLeftButtonUp="btnSyncIng_Click"/>

                    <!-- زر تحديث المزامنة -->
                    <Button x:Name="btnRefreshSync"
                    Width="24" Height="24"
                    Margin="2,0"
                    Style="{StaticResource ActionBtn}"
                    Visibility="Collapsed"
                    ToolTip="تحديث المزامنة"
                    Click="btnRefreshSync_Click">
                        <TextBlock Text="🔄" FontSize="12"/>
                    </Button>

                    <!-- شريط التقدم -->
                    <ProgressBar x:Name="ProgressBarC"
                         Width="120" Height="14"
                         Margin="4,0"
                         Visibility="Collapsed"
                         Foreground="#3D0073"
                         Background="#E0D0F0"/>

                </StackPanel>

            </DockPanel>
        </Border>

    </Grid>
</dx:ThemedWindow>