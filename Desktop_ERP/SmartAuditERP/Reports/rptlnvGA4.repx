    <Item6 Ref="271" ControlType="GroupFooterBand" Name="GroupFooter2" PrintAtBottom="true" Level="1" PageBreak="AfterBandExceptLastEntry" HeightF="106.508507" KeepTogether="true" StyleName="baseControlStyle">
      <Controls>
        <Item1 Ref="272" ControlType="XRLabel" Name="label91" RightToLeft="No" Multiline="true" Text="Notes :&#xD;&#xA;1- This receipt shall be canceled after the lapse of two months in the event that the sold goods are not received.&#xD;&#xA;2- It is not allowed to return the cash paid.&#xD;&#xA;3- The invoice is the proof of purchase and is used in the warranty.&#xD;&#xA;4- One year warranty against manufacturing defects on the frame (peeling - discoloration - de-welding).&#xD;&#xA;5- A guarantee on the lenses in case the sizes are not as requested." TextAlignment="MiddleLeft" SizeF="323.958344,96.875" LocationFloat="20.27963, 9.15047" Font="Arial, 7pt" Padding="2,2,0,0,100" Borders="None">
          <StylePriority Ref="273" UseFont="false" UseBorders="false" UseTextAlignment="false" />
        </Item1>
        <Item2 Ref="274" ControlType="XRLabel" Name="label90" RightToLeft="Yes" Multiline="true" Text="ملاحظات :&#xD;&#xA;1- يلغى هذا الإيصال بعدمضي شهرين في حالة عدم استلام البضاعة المباعة .&#xD;&#xA;2- غير مسموح بإسترجاع المبالغ النقدية المدفوعة .&#xD;&#xA;3- الفاتورة هي دليل الشراء و تستخدم في الضمان .&#xD;&#xA;4- ضمان لمدة عام ضد عيوب التصنيع على الإيطار (التقشير - تغيير اللون - فك اللحام) .&#xD;&#xA;5- ضمان على العدسات في حالة لم تكن المقاسات كما الطلب." TextAlignment="MiddleLeft" SizeF="323.958344,96.875" LocationFloat="489.583344, 9.15047" Font="Arial, 8pt" Padding="2,2,0,0,100" Borders="None">
          <StylePriority Ref="275" UseFont="false" UseBorders="false" UseTextAlignment="false" />
        </Item2>
        <Item3 Ref="276" ControlType="XRBarCode" Name="barCode3" AutoModule="true" TextAlignment="BottomCenter" ShowText="false" SizeF="115.701965,98.24982" LocationFloat="359.294861, 5.99997425" Padding="10,10,0,0,100">
          <Symbology Ref="277" Name="QRCode" CompactionMode="Byte" Version="Version1" />
          <ExpressionBindings>
            <Item1 Ref="278" Expression="[QRCode]" PropertyName="Text" EventName="BeforePrint" />
          </ExpressionBindings>
          <StylePriority Ref="279" UseTextAlignment="false" />
        </Item3>
      </Controls>
    </Item6>
