<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSandQ"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="سند قبض عميل"
    Width="980" Height="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3FA8D5" Offset="0"/>
            <GradientStop Color="#1E7AA8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B5EA7" Offset="0"/>
            <GradientStop Color="#4D3278" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="6"  ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Field Label ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ═══ TextBox ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxMulti" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="52"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- TextBox رصيد بخلفية وردية -->
        <Style x:Key="BalanceTypeBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="#FFD0D0"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- ═══ ComboBox ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Buttons ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>
        <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
        </Style>
        <Style x:Key="NavBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <!-- ═══ RadioButton ═══ -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ═══ CheckBox ═══ -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ DataGrid ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#3A63C3"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════ -->
    <!--                 Main Layout                 -->
    <!-- ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TabControl ═══ -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    Margin="4,4,4,2"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,6"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </TabControl.Resources>

            <!-- ══════════════════════════════════ -->
            <!--      TabPage1: سند قبض عميل        -->
            <!-- ══════════════════════════════════ -->
            <TabItem x:Name="TabPage1" Header="📄 سند قبض عميل">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ─── GroupBox3: بيانات السند الرئيسية ─── -->
                    <Border x:Name="GroupBox3"
                            Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="4,4,4,3"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7" Padding="10,4"
                                    Margin="0,0,0,8">
                                <TextBlock Text="📄 سند قبض عميل"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Fields Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: رقم السند + التاريخ + الوقت + الفرع -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="🔢 رقم السند" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNo"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="📅 التاريخ" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtDate"
                                                  Height="28" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="⏰ الوقت" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtTime"
                                             Style="{StaticResource ModernTextBox}"
                                             GotFocus="txtTime_GotFocus"
                                             LostFocus="txtTime_LostFocus"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="🏢 الفرع" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbBranches"
                                              Style="{StaticResource ModernComboBox}"
                                              IsEnabled="False"/>
                                </StackPanel>

                                <!-- Row 2: حساب العميل + قيمة السند + الرصيد -->
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="👤 حساب العميل" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbClients"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  SelectionChanged="cmbClients_SelectionChanged"
                                                  KeyDown="cmbClients_KeyDown"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            x:Name="btnClient"
                                            Content="➕"
                                            Style="{StaticResource ActionBtn}"
                                            Width="28" Height="26"
                                            FontSize="12"
                                            Padding="0"
                                            VerticalAlignment="Bottom"
                                            ToolTip="إضافة عميل جديد"
                                            Click="btnClient_Click"/>
                                    <Button Grid.Column="4"
                                            x:Name="btnSearchAcc"
                                            Content="🔍"
                                            Style="{StaticResource ActionBtn}"
                                            Width="28" Height="26"
                                            FontSize="12"
                                            Padding="0"
                                            VerticalAlignment="Bottom"
                                            ToolTip="بحث عن حساب"
                                            Click="btnSearchAcc_Click"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Grid.Column="4">
                                    <TextBlock Text="💰 قيمة السند" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtVal"
                                             Style="{StaticResource ModernTextBox}"
                                             TextChanged="txtVal_TextChanged"
                                             GotFocus="txtVal_GotFocus"/>
                                </StackPanel>

                                <!-- الرصيد -->
                                <Grid Grid.Row="2" Grid.Column="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📊 الرصيد" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtBalance"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="2"
                                             x:Name="txtBalanceType"
                                             Style="{StaticResource BalanceTypeBox}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Bottom"/>
                                </Grid>

                                <!-- Row 4: رقم المرجع + تاريخ المرجع + مركز التكلفة + المحرر -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="📎 رقم المرجع" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtRef"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="📅 تاريخ المرجع" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtRefDate"
                                                  Height="28" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="4">
                                    <TextBlock Text="📊 مركز التكلفة" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbCostCenter"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <!-- المحرر + Label3 -->
                                <StackPanel Grid.Row="4" Grid.Column="6">
                                    <TextBlock Text="👤 المحرر" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Label3 -->
                                        <TextBlock x:Name="Label3"
                                                   Grid.Column="0"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#1B2642"
                                                   VerticalAlignment="Center"/>
                                        <!-- Editereciept -->
                                        <TextBlock x:Name="Editereciept"
                                                   Grid.Column="2"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="Red"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ─── GroupBox5: تفاصيل الدفع ─── -->
                    <Border x:Name="GroupBox5"
                            Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="4,0,4,3"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7" Padding="10,4"
                                    Margin="0,0,0,8">
                                <TextBlock Text="💼 تفاصيل الدفع"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- نوع الدفع -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="💳 نوع الدفع:" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,12,0"/>
                                <RadioButton x:Name="rdCash"
                                             Content="💵 نقدي"
                                             Style="{StaticResource ModernRadio}"
                                             IsChecked="True"
                                             Checked="rdCash_Checked"/>
                                <RadioButton x:Name="rdCheck"
                                             Content="🏦 بنكي"
                                             Style="{StaticResource ModernRadio}"
                                             Checked="rdCheck_Checked"/>
                                <RadioButton x:Name="rdCheckAll"
                                             Content="📋 الكل"
                                             Style="{StaticResource ModernRadio}"
                                             Checked="rdCheckAll_Checked"/>
                            </StackPanel>

                            <!-- حقول الدفع الرئيسية -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblEda3Text"
                                               Text="🏧 يودع في حساب"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbDepositTO"
                                              Style="{StaticResource ModernComboBox}"
                                              KeyDown="cmbDepositTO_KeyDown"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="👔 المندوب" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbSalesMan"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="📝 البيان" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNotes"
                                             Style="{StaticResource ModernTextBoxMulti}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Panel1: بيانات الشيك/البنك (مع العناصر الناقصة) -->
                            <Border Grid.Row="3"
                                    x:Name="Panel1"
                                    Background="#F0F4FF"
                                    BorderBrush="#B0BFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- الصف الأول: رقم الشيك + تاريخ الاستحقاق + حالة الشيك + مسحوب على بنك -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🔢 رقم الشيك" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtCheckNo"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="📅 تاريخ الاستحقاق" Style="{StaticResource FieldLabel}"/>
                                            <dxe:DateEdit x:Name="txtCheckDate"
                                                          Height="28" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="📋 حالة الشيك" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbCheckType"
                                                      Style="{StaticResource ModernComboBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="🏦 مسحوب على بنك" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtBankCheck"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ═══ الصف الثاني: رصيد الطلب + قيمة السند (دولار) ← العناصر الناقصة ═══ -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- txtRequest: رصيد الطلب (Label16) -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="Label16"
                                                       Text="📊 رصيد الطلب"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtRequest"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <!-- txtValD: قيمة السند بالدولار (Label17 + Label18) -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="Label17"
                                                       Text="💵 قيمة السند"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtValD"
                                                         Grid.Column="0"
                                                         Style="{StaticResource ModernTextBox}"
                                                         TextChanged="txtValD_TextChanged"
                                                         GotFocus="txtValD_GotFocus"/>
                                                <TextBlock x:Name="Label18"
                                                           Grid.Column="1"
                                                           Text="💲 دولار"
                                                           Style="{StaticResource FieldLabel}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ─── شريط أزرار TabPage1 ─── -->
                    <Border Grid.Row="2"
                            Background="{StaticResource FooterBrush}"
                            FlowDirection="LeftToRight"
                            Padding="10,6"
                            CornerRadius="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- أزرار التنقل -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="btnClose"
                                        Content="✖"
                                        Style="{StaticResource DangerBtn}"
                                        Width="40" ToolTip="إغلاق"
                                        Margin="0,0,4,0"
                                        Click="btnClose_Click"/>
                                <Button x:Name="btnFirst"
                                        Content="⏮"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="الأول"
                                        Margin="0,0,3,0"
                                        Click="btnFirst_Click"/>
                                <Button x:Name="btnPrevious"
                                        Content="◀"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="السابق"
                                        Margin="0,0,3,0"
                                        Click="btnPrevious_Click"/>
                                <Button x:Name="btnNext"
                                        Content="▶"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="التالي"
                                        Margin="0,0,3,0"
                                        Click="btnNext_Click"/>
                                <Button x:Name="btnLast"
                                        Content="⏭"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="الأخير"
                                        Click="btnLast_Click"/>
                            </StackPanel>

                            <!-- أزرار العمليات -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnImportDocument"
                                        Content="📂 إرفاق"
                                        Style="{StaticResource PurpleBtn}"
                                        Width="80" Margin="0,0,4,0"
                                        ToolTip="إرفاق مستند"
                                        Click="BtnImportDocument_Click"/>
                                <Button x:Name="Btnshowdocument"
                                        Content="👁️ مستندات"
                                        Style="{StaticResource InfoBtn}"
                                        Width="90" Margin="0,0,4,0"
                                        ToolTip="عرض المستندات"
                                        Click="Btnshowdocument_Click"/>
                                <Button x:Name="btnView"
                                        Content="👁️ معاينة"
                                        Style="{StaticResource ActionBtn}"
                                        Width="82" Margin="0,0,4,0"
                                        Click="btnView_Click"/>
                                <Button x:Name="btnPrint"
                                        Content="🖨️ طباعة"
                                        Style="{StaticResource ActionBtn}"
                                        Width="82" Margin="0,0,4,0"
                                        Click="btnPrint_Click"/>
                                <Button x:Name="btnDelete"
                                        Content="🗑️ حذف"
                                        Style="{StaticResource DangerBtn}"
                                        Width="74" Margin="0,0,4,0"
                                        Click="btnDelete_Click"/>
                                <Button x:Name="btnSave"
                                        Content="💾 حفظ"
                                        Style="{StaticResource SaveBtn}"
                                        Width="74" Margin="0,0,4,0"
                                        Click="btnSave_Click"/>
                                <Button x:Name="btnNew"
                                        Content="➕ جديد"
                                        Style="{StaticResource ActionBtn}"
                                        Width="74"
                                        Click="btnNew_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════ -->
            <!--          TabPage2: البحث           -->
            <!-- ══════════════════════════════════ -->
            <TabItem x:Name="TabPage2" Header="🔍 البحث">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ─── GroupBox6: معايير البحث ─── -->
                    <Border x:Name="GroupBox6"
                            Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="4,4,4,3"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7" Padding="10,4"
                                    Margin="0,0,0,8">
                                <TextBlock Text="🔍 معايير البحث"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- الصف الأول -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔢 رقم السند" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchNo"
                                             Style="{StaticResource ModernTextBox}"
                                             PreviewTextInput="txtSrchNo_PreviewTextInput"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📎 رقم المرجع" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchRef"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <Button Grid.Column="4"
                                        x:Name="btnSearch"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="90"
                                        VerticalAlignment="Bottom"
                                        Click="btnSearch_Click"/>
                            </Grid>

                            <!-- الصف الثاني -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📅 من تاريخ" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtFromDate"
                                                  Height="28" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📅 إلى تاريخ" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtToDate"
                                                  Height="28" FontSize="11"/>
                                </StackPanel>

                                <CheckBox Grid.Column="4"
                                          x:Name="chkall"
                                          Content="📋 كل الفترة"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Checked="chkall_CheckedChanged"
                                          Unchecked="chkall_CheckedChanged"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ─── GroupBox4: نتائج البحث ─── -->
                    <Border x:Name="GroupBox4"
                            Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="4,0,4,4"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0" Padding="10,5">
                                <TextBlock Text="📊 نتائج البحث"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      BorderThickness="0"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="GID"
                                                        Binding="{Binding GlobalId}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn Header="🔢 الرقم"
                                                        Binding="{Binding ReceiptNo}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="📅 التاريخ"
                                                        Binding="{Binding ReceiptDate}"
                                                        Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="💰 المبلغ"
                                                        Binding="{Binding Payment}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="👤 العميل"
                                                        Binding="{Binding ClientName}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="14,5">
            <TextBlock x:Name="lblStatus"
                       Text="جاهز"
                       Foreground="White"
                       FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

    </Grid>
</dx:ThemedWindow>