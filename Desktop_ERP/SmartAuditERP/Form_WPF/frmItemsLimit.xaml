<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmItemsLimit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="الأصناف التي وصلت لحد الطلب"
    Width="1000"
    Height="520"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmItemsLimit_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12"
                          Color="#000000"/>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10">
            <TextBlock Text="⚠️ الأصناف التي وصلت لحد الطلب"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1"
                Margin="6"
                Background="White"
                CornerRadius="8"
                Effect="{StaticResource CardShadow}">

            <DataGrid x:Name="dgvData"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowStyle="{StaticResource GridRowStyle}"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      AlternatingRowBackground="#F8F9FD"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E7ECF5"
                      Background="White">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="الرقم"
                                        Binding="{Binding Column3}"
                                        Width="70"
                                        Visibility="Collapsed"/>

                    <DataGridTextColumn Header="📂 المجموعة"
                                        Binding="{Binding Column2}"
                                        Width="160"
                                        ElementStyle="{StaticResource GridCellText}"/>

                    <DataGridTextColumn Header="🏷️ الصنف"
                                        Binding="{Binding Column4}"
                                        Width="200"
                                        ElementStyle="{StaticResource GridCellText}"/>

                    <DataGridTextColumn Header="💰 سعر الشراء"
                                        Binding="{Binding Column1}"
                                        Width="*"
                                        ElementStyle="{StaticResource GridCellText}"/>

                    <DataGridTextColumn Header="💵 سعر البيع"
                                        Binding="{Binding Column5}"
                                        Width="*"
                                        ElementStyle="{StaticResource GridCellText}"/>

                    <DataGridTextColumn Header="📦 الرصيد"
                                        Binding="{Binding Column7}"
                                        Width="*"
                                        ElementStyle="{StaticResource GridCellText}"/>

                    <DataGridTextColumn Header="⚠️ حد الطلب"
                                        Binding="{Binding Column6}"
                                        Width="*"
                                        ElementStyle="{StaticResource GridCellText}"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</dx:ThemedWindow>