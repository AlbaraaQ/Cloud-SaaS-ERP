<Window x:Class="SmartAuditERP.Form_WPF.frmAssignProjectPM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 عقد مقاول" 
        Height="800" 
        Width="1300"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        MinWidth="1200"
        MinHeight="750">

    <Window.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#f8fafc" Offset="0"/>
            <GradientStop Color="#e2e8f0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#5568d3" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="10" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="5" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#667eea"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- DatePicker Style -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#f8fafc"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- TabControl Style -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="White" 
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                CornerRadius="8,8,0,0"
                                Padding="25,12"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource BackgroundGradient}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderGradient}" 
                    CornerRadius="10" 
                    Padding="20,15"
                    Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="10" ShadowDepth="3"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="📋 إدارة عقود المقاولين والمشاريع" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="txtuser"
                                   Text="المستخدم"
                                   FontSize="12"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="txtTime"
                                   Text="الوقت"
                                   FontSize="12"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button x:Name="btnCloseWindow"
                                Width="35" Height="35"
                                Background="#dc2626"
                                BorderThickness="0"
                                ToolTip="إغلاق"
                                Cursor="Hand"
                                Click="btnClose_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8">
                                        <TextBlock Text="✖" 
                                                   FontSize="18" 
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contract Info Bar -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="20,12"
                    Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="🔢 رقم العقد" 
                               Style="{StaticResource ModernLabel}"/>
                    <TextBox x:Name="txtNo"
                             Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             TextAlignment="Center"
                             IsReadOnly="True"/>

                    <TextBlock Grid.Column="3" 
                               Text="📅 التاريخ" 
                               Style="{StaticResource ModernLabel}"/>
                    <DatePicker x:Name="txtDate"
                                Grid.Column="4"
                                Style="{StaticResource ModernDatePicker}"/>

                    <TextBlock Grid.Column="6" 
                               Text="📊 حالة العقد" 
                               Style="{StaticResource ModernLabel}"/>
                    <ComboBox x:Name="cmbStatus"
                              Grid.Column="7"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              IsEnabled="False"/>
                </Grid>
            </Border>

            <!-- TabControl -->
            <TabControl Grid.Row="2" 
                        x:Name="TabControl1"
                        Style="{StaticResource ModernTabControl}"
                        Margin="0,0,0,15">

                <!-- Tab 1: Project Data -->
                <TabItem Header="📋 بيانات المشروع" Style="{StaticResource ModernTabItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="520"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Project Details -->
                        <Border Grid.Column="0"
                                Background="White" 
                                CornerRadius="0,10,10,0" 
                                Padding="20"
                                Margin="0,5,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                            </Border.Effect>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="📝 معلومات المشروع"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#667eea"
                                               Margin="0,0,0,15"/>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 1: Project Number -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                                   Text="🔢 رقم المشروع" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <TextBox x:Name="txtProjectNo"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"/>

                                        <!-- Row 2: Project Name -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                                   Text="📋 اسم المشروع" 
                                                   Style="{StaticResource ModernLabel}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,8,10,0"/>
                                        <TextBox x:Name="txtPname"
                                                 Grid.Row="2" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="50"
                                                 VerticalContentAlignment="Top"
                                                 Padding="8"/>

                                        <!-- Row 3: Project Name EN -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" 
                                                   Text="📝 الاسم EN" 
                                                   Style="{StaticResource ModernLabel}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,8,10,0"/>
                                        <TextBox x:Name="txtPnameEn"
                                                 Grid.Row="4" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="50"
                                                 VerticalContentAlignment="Top"
                                                 Padding="8"/>

                                        <!-- Row 4: Terms -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" 
                                                   Text="📑 البند" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <ComboBox x:Name="cmbTerms"
                                                  Grid.Row="6" Grid.Column="1"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"/>

                                        <!-- Row 5: Location -->
                                        <TextBlock Grid.Row="8" Grid.Column="0" 
                                                   Text="📍 الموقع" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <TextBox x:Name="txtLocation"
                                                 Grid.Row="8" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"/>

                                        <!-- Row 6: Country -->
                                        <TextBlock Grid.Row="10" Grid.Column="0" 
                                                   Text="🌍 البلد" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <Grid Grid.Row="10" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="cmbCountry"
                                                      Grid.Column="0"
                                                      Style="{StaticResource ModernComboBox}"
                                                      IsEditable="True"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"/>
                                            <Button x:Name="btnAddCountry"
                                                    Grid.Column="1"
                                                    Content="➕"
                                                    Background="#10b981"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    FontSize="16"
                                                    Cursor="Hand"
                                                    Margin="5,0,0,0"
                                                    ToolTip="إضافة بلد"
                                                    Click="btnAddCountry_Click"/>
                                        </Grid>

                                        <!-- Row 7: Status -->
                                        <TextBlock Grid.Row="12" Grid.Column="0" 
                                                   Text="📊 الحالة" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <ComboBox x:Name="cmbStatus1"
                                                  Grid.Row="12" Grid.Column="1"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"/>

                                        <!-- Row 8: Start Date -->
                                        <TextBlock Grid.Row="14" Grid.Column="0" 
                                                   Text="📅 تاريخ البدء" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <DatePicker x:Name="txtStartDate"
                                                    Grid.Row="14" Grid.Column="1"
                                                    Style="{StaticResource ModernDatePicker}"/>

                                        <!-- Row 9: End Date -->
                                        <TextBlock Grid.Row="16" Grid.Column="0" 
                                                   Text="📅 تاريخ الانتهاء" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <DatePicker x:Name="txtEndDate"
                                                    Grid.Row="16" Grid.Column="1"
                                                    Style="{StaticResource ModernDatePicker}"/>

                                        <!-- Row 10: Execution Period -->
                                        <TextBlock Grid.Row="18" Grid.Column="0" 
                                                   Text="⏱️ مدة التنفيذ" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <StackPanel Grid.Row="18" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="txtPeriod"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Width="100"
                                                     TextAlignment="Center"/>
                                            <TextBlock Text="يوم"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Row 11: Project Cost -->
                                        <TextBlock Grid.Row="20" Grid.Column="0" 
                                                   Text="💰 تكلفة المشروع" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <TextBox x:Name="txtProjCost"
                                                 Grid.Row="20" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 TextChanged="txtProjCost_TextChanged"/>

                                        <!-- Row 12: Contractor -->
                                        <TextBlock Grid.Row="22" Grid.Column="0" 
                                                   Text="👷 المقاول" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <Grid Grid.Row="22" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="cmbContractor"
                                                      Grid.Column="0"
                                                      Style="{StaticResource ModernComboBox}"
                                                      IsEditable="True"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"/>
                                            <Button x:Name="btnAddControctor"
                                                    Grid.Column="1"
                                                    Content="➕"
                                                    Background="#10b981"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    FontSize="16"
                                                    Cursor="Hand"
                                                    Margin="5,0,0,0"
                                                    ToolTip="إضافة مقاول"
                                                    Click="btnAddControctor_Click"/>
                                        </Grid>

                                        <!-- Row 13: Reference -->
                                        <TextBlock Grid.Row="24" Grid.Column="0" 
                                                   Text="📎 المرجع" 
                                                   Style="{StaticResource ModernLabel}"/>
                                        <TextBox x:Name="txtReff"
                                                 Grid.Row="24" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </Grid>

                                    <!-- Accreditate Button -->
                                    <Button x:Name="btnAccreditate"
                                            Content="✅ تعميد المشروع"
                                            Background="#10b981"
                                            Foreground="White"
                                            Height="45"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,25,0,0"
                                            Click="btnAccreditate_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="20,12">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Panel: Projects List -->
                        <Border Grid.Column="1"
                                Background="White" 
                                CornerRadius="10,0,0,10" 
                                Padding="15"
                                Margin="0,5,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Search Panel -->
                                <Border Grid.Row="0"
                                        Background="#f8fafc"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="🔍 بحث المشاريع"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#667eea"
                                                   Margin="0,0,0,12"/>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                                       Text="📋 رقم العقد" 
                                                       Style="{StaticResource ModernLabel}"/>
                                            <TextBox x:Name="txtContrNo"
                                                     Grid.Row="0" Grid.Column="1"
                                                     Style="{StaticResource ModernTextBox}"
                                                     TextAlignment="Center"
                                                     KeyDown="txtContrNo_KeyDown"/>
                                            <Button x:Name="btnSrch"
                                                    Grid.Row="0" Grid.Column="2"
                                                    Content="🔎"
                                                    Background="{StaticResource PrimaryButtonGradient}"
                                                    Foreground="White"
                                                    FontSize="18"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="5,0,0,0"
                                                    Height="32"
                                                    ToolTip="بحث"
                                                    Click="btnSrch_Click"/>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                        Orientation="Horizontal">
                                                <CheckBox x:Name="ckAllProj"
                                                          Content="الكل"
                                                          IsChecked="True"
                                                          Margin="0,0,20,0"
                                                          VerticalAlignment="Center"
                                                          Checked="ckAllProj_CheckedChanged"
                                                          Unchecked="ckAllProj_CheckedChanged"/>
                                                <CheckBox x:Name="ckNewProjects"
                                                          Content="مشاريع العقد الجديدة"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Projects DataGrid -->
                                <DataGrid x:Name="dgvProjects"
                                          Grid.Row="1"
                                          Style="{StaticResource ModernDataGrid}"
                                          MouseDoubleClick="dgvProjects_CellClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="🔢 رقم المشروع" 
                                                            Binding="{Binding ProjectNo}" 
                                                            Width="110"/>
                                        <DataGridTextColumn Header="📋 اسم المشروع" 
                                                            Binding="{Binding ProjectName}" 
                                                            Width="*"/>
                                        <DataGridTextColumn Header="📊 الحالة" 
                                                            Binding="{Binding Status}" 
                                                            Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Search -->
                <TabItem Header="🔍 البحث" Style="{StaticResource ModernTabItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Results -->
                        <Border Grid.Column="0"
                                Background="White" 
                                CornerRadius="0,10,10,0" 
                                Padding="15"
                                Margin="0,5,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                            </Border.Effect>

                            <DataGrid x:Name="dgvSrch"
                                      Style="{StaticResource ModernDataGrid}"
                                      MouseDoubleClick="dgvSrch_CellClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" 
                                                        Binding="{Binding Id}" 
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="🔢 الرقم" 
                                                        Binding="{Binding ContractNo}" 
                                                        Width="100"/>
                                    <DataGridTextColumn Header="📅 التاريخ" 
                                                        Binding="{Binding ContractDate}" 
                                                        Width="120"/>
                                    <DataGridTextColumn Header="👷 العميل/المقاول" 
                                                        Binding="{Binding ContractorName}" 
                                                        Width="*"/>
                                    <DataGridTextColumn Header="📊 الحالة" 
                                                        Binding="{Binding Status}" 
                                                        Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Search Panel -->
                        <Border Grid.Column="1"
                                Background="White" 
                                CornerRadius="10,0,0,10" 
                                Padding="20"
                                Margin="0,5,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock Text="🔍 معايير البحث"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#667eea"
                                           Margin="0,0,0,20"/>

                                <!-- Contract Type -->
                                <Border Background="#f8fafc"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbContract"
                                                     Content="📄 عقد"
                                                     IsChecked="False"
                                                     Margin="0,0,20,0"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Checked="rbContract_CheckedChanged"/>
                                        <RadioButton x:Name="rbProject"
                                                     Content="📋 مشروع"
                                                     IsChecked="True"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Checked="rbProject_CheckedChanged"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 1: Number -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="🔢 الرقم" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtSrchNo"
                                             Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"/>

                                    <!-- Row 2: Status -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="📊 الحالة" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <ComboBox x:Name="cmbStatusSrch"
                                              Grid.Row="2" Grid.Column="1"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"/>

                                    <!-- Row 3: Contractor -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" 
                                               x:Name="lblClientSrch"
                                               Text="👷 المقاول" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <Grid Grid.Row="4" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbClientSrch"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  IsEnabled="False"/>
                                        <CheckBox x:Name="chkAll"
                                                  Grid.Column="1"
                                                  Content="الكل"
                                                  IsChecked="True"
                                                  Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Checked="chkAll_CheckedChanged"
                                                  Unchecked="chkAll_CheckedChanged"/>
                                    </Grid>

                                    <!-- Row 4: Country -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" 
                                               x:Name="lblcountry"
                                               Text="🌍 البلد" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <ComboBox x:Name="cmbCountries"
                                              Grid.Row="6" Grid.Column="1"
                                              Style="{StaticResource ModernComboBox}"
                                              IsEditable="True"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"/>

                                    <!-- Search Button -->
                                    <Button x:Name="btnSearch"
                                            Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                            Content="🔎 بحث"
                                            Background="{StaticResource PrimaryButtonGradient}"
                                            Foreground="White"
                                            Height="45"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="btnSearch_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="20,10">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Footer with Totals and Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Totals Panel -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="8"
                        Padding="20,12"
                        Margin="0,0,15,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="💰 الإجمالي:"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox x:Name="txtTotCost"
                                 Width="150"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True"
                                 Background="#f8fafc"
                                 Foreground="#10b981"
                                 FontWeight="Bold"
                                 TextAlignment="Center"/>

                        <TextBlock Text="📊 الضريبة:"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="30,0,10,0"/>
                        <TextBlock x:Name="txtNetVAT"
                                   Width="150"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#10b981"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Text="0"/>

                        <TextBlock Text="✅ الصافي:"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="30,0,10,0"/>
                        <TextBox x:Name="txtNetVal"
                                 Width="150"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True"
                                 Background="#f8fafc"
                                 Foreground="#10b981"
                                 FontWeight="Bold"
                                 TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <Button x:Name="btnNew"
                            Content="➕"
                            FontSize="20"
                            Style="{StaticResource NavButton}"
                            ToolTip="جديد"
                            Click="btnNew_Click"/>

                    <Button x:Name="btnSave"
                            Content="💾"
                            FontSize="20"
                            Style="{StaticResource NavButton}"
                            ToolTip="حفظ"
                            Click="btnSave_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️"
                            FontSize="20"
                            Style="{StaticResource NavButton}"
                            ToolTip="طباعة"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnDelete"
                            Content="🗑️"
                            FontSize="20"
                            Background="#ef4444"
                            Style="{StaticResource NavButton}"
                            ToolTip="حذف"
                            Click="btnDelete_Click"/>

                    <Separator Width="20" Background="Transparent"/>

                    <Button x:Name="btnFirst"
                            Content="⏮️"
                            FontSize="18"
                            Style="{StaticResource NavButton}"
                            ToolTip="الأول"
                            Click="btnFirst_Click"/>

                    <Button x:Name="btnPrevious"
                            Content="◀️"
                            FontSize="18"
                            Style="{StaticResource NavButton}"
                            ToolTip="السابق"
                            Click="btnPrevious_Click"/>

                    <Button x:Name="btnNext"
                            Content="▶️"
                            FontSize="18"
                            Style="{StaticResource NavButton}"
                            ToolTip="التالي"
                            Click="btnNext_Click"/>

                    <Button x:Name="btnLast"
                            Content="⏭️"
                            FontSize="18"
                            Style="{StaticResource NavButton}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>

                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>