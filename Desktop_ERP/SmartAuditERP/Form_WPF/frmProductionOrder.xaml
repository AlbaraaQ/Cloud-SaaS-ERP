<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmProductionOrder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="أمر إنتاج"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════ Brushes ═══════════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B9BD5" Offset="0"/>
            <GradientStop Color="#2E75B6" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.13" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="5" ShadowDepth="1"
                          Direction="270" Opacity="0.17" Color="#000000"/>

        <!-- ═══════════════ Styles ═══════════════ -->

        <!-- FieldLabel -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- ModernTextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ReadonlyTextBox -->
        <Style x:Key="ReadonlyTextBox" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- MultiLineTextBox -->
        <Style x:Key="MultiLineTextBox" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ModernComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
        </Style>

        <!-- ActionBtn -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <!-- SummaryLabel -->
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBox"
               BasedOn="{StaticResource ReadonlyTextBox}">
            <Setter Property="Width" Value="85"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ══════════════════════════════════════════════════ -->
    <!--                 التخطيط الرئيسي                    -->
    <!-- ══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ TabControl ═══════════════ -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold"
                    Background="#F3F5F9">

            <!-- ══════════════════════════════════════ -->
            <!--        تبويب 1: أمر الإنتاج            -->
            <!-- ══════════════════════════════════════ -->
            <TabItem Header="   🏭 أمر الإنتاج   ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">

                        <!-- ════════════════════════════════════ -->
                        <!--  بطاقة 1: بيانات الأمر الأساسية      -->
                        <!-- ════════════════════════════════════ -->
                        <Border Background="White"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <!-- عنوان البطاقة -->
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="8" Padding="10,6"
                                        Margin="0,0,0,12">
                                    <TextBlock Text="📋 بيانات أمر الإنتاج"
                                               Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- صف 1: الرقم + التاريخ + رقم المرجع + تاريخ المرجع -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🔢 الرقم:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtNo"
                                                 Style="{StaticResource ReadonlyTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="📅 التاريخ:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <dxe:DateEdit x:Name="txtDate"
                                                      Height="30"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="📄 رقم المرجع:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtRefNo"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="📅 تاريخ المرجع:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <dxe:DateEdit x:Name="txtRefDate"
                                                      Height="30"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- صف 2: المنتج + الوحدة + مستودع الإنتاج -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📦 المنتج:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbItems"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"
                                                  SelectionChanged="cmbItems_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="📐 الوحدة:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbUnits"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="unitName"
                                                  SelectedValuePath="unitId"
                                                  SelectionChanged="cmbUnits_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="🏭 مستودع الإنتاج:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbProductionStore"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"/>
                                    </StackPanel>
                                </Grid>

                                <!-- صف 3: الكمية المنتجة + الكمية الأساسية + الكمية المتوفرة -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🔢 الكمية المنتجة:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtQty"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 TextChanged="txtQty_TextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="🔢 الكمية الأساسية للإنتاج:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TextBox1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="📊 الكمية المتوفرة:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtCurrentQty"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- صف 4: البيان -->
                                <StackPanel>
                                    <TextBlock Text="📝 البيان:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNote"
                                             Style="{StaticResource MultiLineTextBox}"
                                             MinHeight="50"
                                             MaxHeight="80"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- ════════════════════════════════════ -->
                        <!--  بطاقة 2: جدول مكونات الإنتاج       -->
                        <!-- ════════════════════════════════════ -->
                        <Border Background="White"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/>
                                    <RowDefinition Height="250"/>
                                </Grid.RowDefinitions>

                                <!-- عنوان الجدول -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource HeaderBrush}"
                                        CornerRadius="10,10,0,0">
                                    <TextBlock Text="🧾 مكونات الإنتاج"
                                               Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="14,0"/>
                                </Border>

                                <!-- جدول المكونات -->
                                <DataGrid x:Name="dgvItems"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                          RowStyle="{StaticResource DgvRow}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          FlowDirection="RightToLeft"
                                          Background="White"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E8EBF5"
                                          AlternatingRowBackground="#F8F9FD"
                                          SelectionChanged="dgvItems_SelectionChanged"
                                          CellEditEnding="dgvItems_CellEditEnding">
                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding RowNo}"
                                                            Width="40" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="رمز الصنف"
                                                            Binding="{Binding ItemCode}"
                                                            Width="100" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="ItemId"
                                                            Binding="{Binding ItemId}"
                                                            Visibility="Collapsed"/>

                                        <DataGridTextColumn Header="الصنف"
                                                            Binding="{Binding ItemName}"
                                                            Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الوحدة"
                                                            Binding="{Binding UnitName}"
                                                            Width="90" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الكمية الأساسية"
                                                            Binding="{Binding BaseQty}"
                                                            Visibility="Collapsed"/>

                                        <DataGridTextColumn Header="الكمية"
                                                            Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="السعر"
                                                            Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="المجموع"
                                                            Binding="{Binding Total, StringFormat=N2}"
                                                            Width="90" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="المستودع"
                                                            Binding="{Binding StoreName}"
                                                            Width="110" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="المتوفرة"
                                                            Binding="{Binding StockQty}"
                                                            Width="80" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Binding="{Binding UnitEquality}"
                                                            Visibility="Collapsed"/>
                                        <DataGridTextColumn Binding="{Binding AvgCost}"
                                                            Visibility="Collapsed"/>
                                        <DataGridTextColumn Binding="{Binding UnitId}"
                                                            Visibility="Collapsed"/>
                                        <DataGridTextColumn Binding="{Binding StoreId}"
                                                            Visibility="Collapsed"/>

                                        <DataGridTemplateColumn Header="حذف" Width="55">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️"
                                                            Tag="{Binding}"
                                                            FontSize="13"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Click="DeleteItemRow_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- ════════════════════════════════════ -->
                        <!--  بطاقة 3: المجموع ومعلومات الصنف    -->
                        <!-- ════════════════════════════════════ -->
                        <Border Background="White"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Padding="14,10"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- صف المجموع -->
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="💰 المجموع:"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#1B2642"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox x:Name="txtSumVal"
                                             Style="{StaticResource ReadonlyTextBox}"
                                             Width="180" Height="34"
                                             FontSize="14"/>
                                </StackPanel>

                                <!-- صف 1: عدد البنود + إجمالي الكمية + الكمية الحالية -->
                                <WrapPanel Grid.Row="2"
                                           Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="📊 عدد البنود:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtTirmsNo"
                                                 Style="{StaticResource SummaryValue}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="📦 إجمالي الكمية:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtTotQuan"
                                                 Style="{StaticResource SummaryValue}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="📊 الكمية الحالية:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtStock"
                                                 Style="{StaticResource SummaryValue}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="⚖️ التعادل:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtPerUnit"
                                                 Style="{StaticResource SummaryValue}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="📐 كمية و/س:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtTotUnitQuan"
                                                 Style="{StaticResource SummaryValue}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- صف 2: الأسعار والباركود -->
                                <WrapPanel Grid.Row="4"
                                           Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="💵 متوسط التكلفة:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtCostAvrg"
                                                 Style="{StaticResource SummaryValue}"
                                                 Width="95"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="💵 آخر سعر شراء:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtRecentPurchPrice"
                                                 Style="{StaticResource SummaryValue}"
                                                 Width="95"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="💵 سعر المنافس:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtCompetitorPrice"
                                                 Style="{StaticResource SummaryValue}"
                                                 Width="95"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="💵 آخر سعر بيع:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtLastSalePrice"
                                                 Style="{StaticResource SummaryValue}"
                                                 Width="95"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <TextBlock Text="📊 الباركود:"
                                                   Style="{StaticResource SummaryLabel}"/>
                                        <TextBox x:Name="txtItemBarcode"
                                                 Style="{StaticResource SummaryValue}"
                                                 Width="140"/>
                                    </StackPanel>
                                </WrapPanel>

                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════ -->
            <!--        تبويب 2: البحث                  -->
            <!-- ══════════════════════════════════════ -->
            <TabItem Header="   🔍 البحث   ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- بطاقة البحث -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            Padding="14,10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8" Padding="10,6"
                                    Margin="0,0,0,10">
                                <TextBlock Text="🔍 بحث في أوامر الإنتاج"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📅 من تاريخ:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtFromDate"
                                                  Height="30" FontSize="12"
                                                  FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📅 إلى تاريخ:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtToDate"
                                                  Height="30" FontSize="12"
                                                  FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="🔢 رقم أمر الإنتاج:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchNo"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"
                                             KeyDown="txtSrchNo_KeyDown"/>
                                </StackPanel>

                                <Button x:Name="btnSearch"
                                        Grid.Column="6"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="85"
                                        VerticalAlignment="Bottom"
                                        Click="btnSearch_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- جدول نتائج البحث -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="InvGlobalID"
                                                        Binding="{Binding InvGlobalID}"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الرقم"
                                                        Binding="{Binding id}"
                                                        Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التاريخ"
                                                        Binding="{Binding vDate}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════════════════════ -->
        <!--              Footer Buttons             -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- التنقل والخروج -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="40" ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- العمليات -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="btnSavePrint"
                            Content="🖨️ حفظ مع طباعة"
                            Style="{StaticResource InfoBtn}"
                            Width="130"
                            Margin="0,0,6,0"
                            Click="btnSavePrint_Click"/>
                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnView_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="78"
                            Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="78"
                            Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="78"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>