<Window x:Class="SmartAuditERP.Form_WPF.frmContractorPM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="بطاقة مقاول 🏗️"
        Height="500" Width="800"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        FontFamily="Tahoma">

    <Window.Resources>
        <!-- ==================== Styles ==================== -->

        <!-- Style: Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#CBD5E1" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Modern Label -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Style: Action Button (Add +) -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#16A34A" BlurRadius="6" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16A34A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Modern ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style: Toolbar Button (DarkSlateBlue) -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#483D8B" Offset="0"/>
                        <GradientStop Color="#2F2A6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#483D8B" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="9"
                                           FontFamily="Tahoma"
                                           HorizontalAlignment="Center"
                                           Foreground="White"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#5B4F9E" Offset="0"/>
                                            <GradientStop Color="#3D3580" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2F2A6B" Offset="0"/>
                                            <GradientStop Color="#1E1B4B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Close Button (Red) -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DC2626" Offset="0"/>
                        <GradientStop Color="#991B1B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#DC2626" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="9"
                                           FontFamily="Tahoma"
                                           HorizontalAlignment="Center"
                                           Foreground="White"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#EF4444" Offset="0"/>
                                            <GradientStop Color="#B91C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Section GroupBox -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Tab Header -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0"
                                CornerRadius="8,8,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#483D8B" Offset="0"/>
                                    <GradientStop Color="#2F2A6B" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontFamily" Value="Tahoma"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Search Button -->
        <Style x:Key="SearchButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#60A5FA" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: Scan Button -->
        <Style x:Key="ScanButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="#6D28D9" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,6">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C3AED" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#A78BFA" Offset="0"/>
                                            <GradientStop Color="#7C3AED" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: RadioButton -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style: CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- ==================== Main Layout ==================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Gradient Bar -->
        <Border Grid.Row="0" VerticalAlignment="Top" Height="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="0.5"/>
                    <GradientStop Color="#EC4899" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="0"
                    Margin="0,5,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Tab Headers Background -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Right" Margin="8,0"/>
                        </Border>
                        <!-- Tab Content -->
                        <Border Grid.Row="1" Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ========== Tab 1: عام ========== -->
            <TabItem Header="🏠 عام" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <!-- Right Side: Form Fields -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                                <!-- Section Title -->
                                <TextBlock Text="👤 البيانات الأساسية"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#1E293B" Margin="0,0,0,16"/>

                                <!-- Name Field -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtName"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="الإسم 👤"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,8,0"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Mobile Field -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtMobile"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="الجوال 📱"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,8,0"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- National ID Field -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtNationalID"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="رقم الهوية 🪪"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,8,0"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Scan Button -->
                                <Button x:Name="btnScan"
                                        Content="📷 مسح ضوئي"
                                        Style="{StaticResource ScanButton}"
                                        HorizontalAlignment="Right"
                                        Width="160"
                                        Click="btnScan_Click"
                                        Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Left Side: ID Scan Image -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="📄 صورة الهوية"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#64748B"
                                           Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <Border x:Name="IDscanBorder"
                                        Width="230" Height="160"
                                        CornerRadius="10"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="2"
                                        Background="#F8FAFC"
                                        ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#94A3B8" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                                    </Border.Effect>
                                    <Image x:Name="IDscan"
                                           Stretch="Uniform"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Tab 2: بيانات إضافية ========== -->
            <TabItem Header="📋 بيانات إضافية" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>

                        <!-- Account & Financial Card -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="💰 بيانات الحساب"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#1E293B" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 1: Account Code + Nature + Account Button -->
                                    <StackPanel Grid.Column="2" Grid.Row="0">
                                        <TextBlock Text="رقم الحساب" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="Button1"
                                                    Grid.Column="0"
                                                    Content="..."
                                                    Width="32" Height="32"
                                                    Margin="0,0,4,0"
                                                    FontWeight="Bold"
                                                    Visibility="Collapsed"
                                                    Click="Button1_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#E2E8F0" CornerRadius="6" Padding="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBox x:Name="txtAccCode"
                                                     Grid.Column="1"
                                                     Style="{StaticResource ModernTextBox}"
                                                     TextAlignment="Center"
                                                     Visibility="Collapsed"
                                                     TextChanged="txtAccCode_TextChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Nature (Debt/Credit) -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center">
                                        <TextBlock Text="طبيعة الحساب" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="8,4" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <RadioButton x:Name="debt"
                                                             Content="مدين"
                                                             Style="{StaticResource ModernRadioButton}"/>
                                                <RadioButton x:Name="credit"
                                                             Content="دائن"
                                                             Style="{StaticResource ModernRadioButton}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Opening Balance -->
                                    <StackPanel Grid.Column="0" Grid.Row="0">
                                        <TextBlock Text="الرصيد الافتتاحي 💵" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="IValue" Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Row 2: Tax No -->
                                    <StackPanel Grid.Column="2" Grid.Row="2">
                                        <TextBlock Text="الرقم الضريبي 🧾" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtTaxNo" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Location & Contact Card -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="📍 بيانات العنوان والتواصل"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#1E293B" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Country -->
                                    <StackPanel Grid.Column="2" Grid.Row="0">
                                        <TextBlock Text="الدولة 🌍" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnCountryAdd"
                                                    Grid.Column="0"
                                                    Content="+"
                                                    Style="{StaticResource AddButton}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="إضافة دولة جديدة"
                                                    Click="btnCountryAdd_Click"/>
                                            <ComboBox x:Name="cmbCountry"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernComboBox}"
                                                      SelectionChanged="cmbCountry_SelectionChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- City -->
                                    <StackPanel Grid.Column="1" Grid.Row="0">
                                        <TextBlock Text="المدينة 🏙️" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnCityAdd"
                                                    Grid.Column="0"
                                                    Content="+"
                                                    Style="{StaticResource AddButton}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="إضافة مدينة جديدة"
                                                    Click="btnCityAdd_Click"/>
                                            <ComboBox x:Name="cmbCity"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernComboBox}"
                                                      SelectionChanged="cmbCity_SelectionChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Area -->
                                    <StackPanel Grid.Column="0" Grid.Row="0">
                                        <TextBlock Text="المنطقة 📌" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnAreaAdd"
                                                    Grid.Column="0"
                                                    Content="+"
                                                    Style="{StaticResource AddButton}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="إضافة منطقة جديدة"
                                                    Click="btnAreaAdd_Click"/>
                                            <ComboBox x:Name="cmbArea"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernComboBox}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Field of Work -->
                                    <StackPanel Grid.Column="2" Grid.Row="2">
                                        <TextBlock Text="مجال العمل 💼" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnActAdd"
                                                    Grid.Column="0"
                                                    Content="+"
                                                    Style="{StaticResource AddButton}"
                                                    Margin="0,0,4,0"
                                                    ToolTip="إضافة نشاط جديد"
                                                    Click="btnActAdd_Click"/>
                                            <ComboBox x:Name="cmbActs"
                                                      Grid.Column="1"
                                                      Style="{StaticResource ModernComboBox}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Phone -->
                                    <StackPanel Grid.Column="1" Grid.Row="2">
                                        <TextBlock Text="رقم الهاتف ☎️" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtTel" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Email -->
                                    <StackPanel Grid.Column="0" Grid.Row="2">
                                        <TextBlock Text="البريد الإلكتروني 📧" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Notes -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4">
                                        <TextBlock Text="ملاحظات 📝" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtNotes"
                                                 Height="70"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Tab 3: بيانات البنك ========== -->
            <TabItem Header="🏦 بيانات البنك" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <!-- CheckBox -->
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                                    BorderBrush="#BFDBFE" BorderThickness="1">
                                <CheckBox x:Name="chAddBankInf"
                                          Content="🏦 إضافة بيانات البنك"
                                          Style="{StaticResource ModernCheckBox}"
                                          Foreground="#1D4ED8"
                                          Checked="chAddBankInf_CheckedChanged"
                                          Unchecked="chAddBankInf_CheckedChanged"/>
                            </Border>

                            <!-- Bank Info Panel -->
                            <StackPanel x:Name="BankInfPanel" IsEnabled="False">
                                <TextBlock Text="🏦 بيانات البنك"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#1E293B" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Bank Name -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0">
                                        <TextBlock Text="اسم البنك 🏦" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtBankName" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Bank Account -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2">
                                        <TextBlock Text="رقم الحساب البنكي 💳" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtBankAccount" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Bank Address -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4">
                                        <TextBlock Text="عنوان البنك 📍" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtBankAddress" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Swift Code -->
                                    <StackPanel Grid.Column="1" Grid.Row="6">
                                        <TextBlock Text="Swift Code 🔑" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtSwiftCode" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- IBAN -->
                                    <StackPanel Grid.Column="0" Grid.Row="6">
                                        <TextBlock Text="IBAN 🔢" Style="{StaticResource ModernLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtIBAN" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- Info Notice -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="8"
                                            Background="#FFF7ED" CornerRadius="8" Padding="10,6"
                                            BorderBrush="#FED7AA" BorderThickness="1">
                                        <TextBlock Text="⚠️ تأكد من صحة جميع البيانات البنكية قبل الحفظ"
                                                   FontSize="12" Foreground="#C2410C"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Tab 4: البحث ========== -->
            <TabItem Header="🔍 البحث" Style="{StaticResource ModernTabItem}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="6,6,6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnSearch"
                                    Grid.Column="0"
                                    Content="🔍 بحث"
                                    Style="{StaticResource SearchButton}"
                                    Height="36"
                                    Margin="0,0,12,0"
                                    Click="btnSearch_Click"/>

                            <TextBox x:Name="txtNameSrch"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     KeyDown="txtNameSrch_KeyDown"
                                     TextChanged="txtNameSrch_TextChanged"/>

                            <TextBlock Grid.Column="2"
                                       Text="الإسم 🔤"
                                       Style="{StaticResource ModernLabel}"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Results Grid -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="6,4,6,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="📊 النتائج"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#374151" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgvCustomers"
                                      Grid.Row="1"
                                      Style="{StaticResource ModernDataGrid}"
                                      MouseLeftButtonUp="dgvCustomers_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColID"
                                                        Header="الرقم"
                                                        Binding="{Binding ID}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="ColName"
                                                        Header="الإسم"
                                                        Binding="{Binding Name}"
                                                        Width="200"/>
                                    <DataGridTextColumn x:Name="ColNationalID"
                                                        Header="رقم الهوية"
                                                        Binding="{Binding NationalID}"
                                                        Width="150"/>
                                    <DataGridTextColumn x:Name="ColPhone"
                                                        Header="رقم الهاتف"
                                                        Binding="{Binding Phone}"
                                                        Width="*"/>
                                    <DataGridTextColumn x:Name="ColMobile"
                                                        Header="رقم الجوال"
                                                        Binding="{Binding Mobile}"
                                                        Width="*"/>
                                    <DataGridTextColumn x:Name="ColCountry"
                                                        Header="الدولة"
                                                        Binding="{Binding Country}"
                                                        Width="*"/>
                                    <DataGridTextColumn x:Name="ColCity"
                                                        Header="المدينة"
                                                        Binding="{Binding City}"
                                                        Width="*"/>
                                    <DataGridTextColumn x:Name="ColArea"
                                                        Header="المنطقة"
                                                        Binding="{Binding Area}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== Toolbar Bottom ==================== -->
        <Border Grid.Row="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Direction="90" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="12,10">

                <!-- Close -->
                <Button x:Name="btnClose"
                        Content="إغلاق" Tag="❌"
                        Style="{StaticResource CloseButton}"
                        ToolTip="إغلاق النافذة"
                        Click="btnClose_Click"
                        Margin="3,0,20,0"/>

                <!-- Separator -->
                <Border Width="1" Background="#334155" Margin="4,8"/>

                <!-- Navigation Buttons -->
                <Button x:Name="btnFirst"
                        Content="الأول" Tag="⏮️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="السجل الأول"
                        Click="btnFirst_Click"/>

                <Button x:Name="btnPrevious"
                        Content="السابق" Tag="◀️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="السجل السابق"
                        Click="btnPrevious_Click"/>

                <Button x:Name="btnNext"
                        Content="التالي" Tag="▶️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="السجل التالي"
                        Click="btnNext_Click"/>

                <Button x:Name="btnLast"
                        Content="الأخير" Tag="⏭️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="آخر سجل"
                        Click="btnLast_Click"/>

                <!-- Separator -->
                <Border Width="1" Background="#334155" Margin="8,8"/>

                <!-- Action Buttons -->
                <Button x:Name="btnNew"
                        Content="جديد" Tag="➕"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="سجل جديد"
                        Click="btnNew_Click"/>

                <Button x:Name="btnSave"
                        Content="حفظ" Tag="💾"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="حفظ البيانات"
                        Click="btnSave_Click"/>

                <Button x:Name="btnDelete"
                        Content="حذف" Tag="🗑️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="حذف السجل"
                        Click="btnDelete_Click"/>

                <Button x:Name="btnPrint"
                        Content="طباعة" Tag="🖨️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="طباعة"
                        Click="btnPrint_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>