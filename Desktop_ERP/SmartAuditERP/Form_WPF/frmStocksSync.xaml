<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmStocksSync"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="مزامنة أرصدة المستودعات"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3FA8D5" Offset="0"/>
            <GradientStop Color="#1E7AA8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#C47D0A" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="6"  ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>
        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
        </Style>
        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- الجدول -->
                <ColumnDefinition Width="*"/>
                <!-- لوحة الخيارات -->
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ GroupBox2: منطقة الجدول ═══ -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="6,6,3,4"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0" Padding="10,5">
                        <TextBlock Text="📦 بيانات أرصدة المستودعات"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cairo, Tahoma, Arial"/>
                    </Border>

                    <!-- الجدول -->
                    <DataGrid x:Name="GridControl1"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              HorizontalScrollBarVisibility="Auto"
                              BorderThickness="0">
                        <DataGrid.Columns>

                            <!-- ProductId (مخفي) -->
                            <DataGridTextColumn Header="ProductId"
                                                Binding="{Binding ProductId}"
                                                Width="0" Visibility="Collapsed"/>

                            <!-- # -->
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding RowNo}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- رمز الصنف -->
                            <DataGridTextColumn Header="🔖 رمز الصنف"
                                                Binding="{Binding ItemCode}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الصنف -->
                            <DataGridTextColumn Header="📦 الصنف"
                                                Binding="{Binding ItemName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الوحدة -->
                            <DataGridTextColumn Header="📐 الوحدة"
                                                Binding="{Binding UnitName}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الكمية -->
                            <DataGridTextColumn Header="📊 الكمية"
                                                Binding="{Binding Quantity, StringFormat=N2}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الفرع -->
                            <DataGridTextColumn Header="🏢 الفرع"
                                                Binding="{Binding BranchName}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- المستودع -->
                            <DataGridTextColumn Header="🏪 المستودع"
                                                Binding="{Binding InventoryName}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- آخر تحديث -->
                            <DataGridTextColumn Header="🕒 آخر تحديث"
                                                Binding="{Binding LastUpdate}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- بطاقات المجاميع -->
                    <Border Grid.Row="2"
                            Background="#F0F4FF"
                            CornerRadius="0,0,10,10"
                            Padding="10,6"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="📦 إجمالي الأصناف"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                                <TextBlock x:Name="lblTotalItems"
                                           Text="0"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#213A7A"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="📊 إجمالي الكمية"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                                <TextBlock x:Name="lblTotalQty"
                                           Text="0.00"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#1B8E4A"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ GroupBox1: خيارات البحث ═══ -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="3,6,6,4"
                    FlowDirection="RightToLeft"
                    Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,6,8,10">

                        <!-- عنوان -->
                        <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="8,5"
                                Margin="0,0,0,8">
                            <TextBlock Text="⚙️ خيارات البحث"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       FontFamily="Cairo, Tahoma, Arial"/>
                        </Border>

                        <!-- المستودع -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🏪 المستودع" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox x:Name="ckAllStore"
                                              Content="الكل"
                                              Style="{StaticResource ModernCheckBox}"
                                              IsChecked="True"
                                              Margin="0,0,8,0"
                                              Checked="ckAllStore_CheckedChanged"
                                              Unchecked="ckAllStore_CheckedChanged"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbStores"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- المجموعة -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📂 المجموعة" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbGroup"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,4,0,4"
                                          SelectionChanged="cmbGroup_SelectionChanged"/>
                                <TextBlock Text="🔖 رمز المجموعة" Style="{StaticResource FieldLabel}"
                                           Margin="0,2,0,2"/>
                                <TextBox x:Name="txtGroupNo"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="txtGroupNo_TextChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- الصنف -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📦 الصنف" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Content="🔍"
                                            Style="{StaticResource ActionBtn}"
                                            Width="26" Height="24"
                                            FontSize="11" Padding="0"
                                            Click="btnSearch_Click"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="txtItemName"
                                             Style="{StaticResource ModernTextBox}"
                                             Margin="3,0,0,0"
                                             MaxLength="50"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- الفترة -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📅 الرصيد حتى التاريخ"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtLastDate"
                                              Height="26" FontSize="11"
                                              Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- الكمية -->
                        <Border Background="#F0F8F0" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="#2CC36B"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Background="{StaticResource SaveBrush}"
                                        CornerRadius="5" Padding="6,2" Margin="0,0,0,5">
                                    <TextBlock Text="📊 الكمية"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="11" HorizontalAlignment="Center"
                                               FontFamily="Cairo, Tahoma, Arial"/>
                                </Border>
                                <RadioButton x:Name="rbAllQty"
                                             Content="الكل"
                                             Style="{StaticResource ModernRadio}"
                                             IsChecked="True"/>
                                <RadioButton x:Name="rbPositiveQty"
                                             Content="أعلى من الصفر"
                                             Style="{StaticResource ModernRadio}"/>
                                <RadioButton x:Name="rbNegativeQnty"
                                             Content="أقل من الصفر"
                                             Style="{StaticResource ModernRadio}"/>
                                <RadioButton x:Name="rbZeroQnty"
                                             Content="يساوي الصفر"
                                             Style="{StaticResource ModernRadio}"/>
                            </StackPanel>
                        </Border>

                        <!-- زر عرض -->
                        <Button x:Name="btnShow"
                                Content="👁️ عرض"
                                Style="{StaticResource ActionBtn}"
                                Height="34"
                                Margin="0,4,0,4"
                                Click="btnShow_Click"/>

                        <!-- زر تحديث المستودعات الأخرى -->
                        <Button x:Name="btnUpdateStocks"
                                Content="🔄 تحديث مستودعات أخرى"
                                Style="{StaticResource OrangeBtn}"
                                Height="34"
                                Margin="0,2,0,4"
                                Click="btnUpdateStocks_Click"/>

                        <!-- زر تحديث المستودع الحالي (مخفي افتراضياً) -->
                        <Button x:Name="btnItemQuantity"
                                Content="🔄 تحديث المستودع الحالي"
                                Style="{StaticResource SaveBtn}"
                                Height="34"
                                Margin="0,0,0,4"
                                Visibility="Collapsed"
                                Click="btnItemQuantity_Click"/>

                        <!-- ProgressBar -->
                        <ProgressBar x:Name="ProgressBar1"
                                     Height="6"
                                     Margin="0,4,0,0"
                                     Background="#E0E6F5"
                                     Foreground="{StaticResource HeaderBrush}"
                                     Minimum="0" Maximum="100" Value="0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnClose"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnExportExcel"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource InfoBtn}"
                            Width="110" Margin="0,0,6,0"
                            Click="btnExportExcel_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="90" Margin="0,0,6,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>