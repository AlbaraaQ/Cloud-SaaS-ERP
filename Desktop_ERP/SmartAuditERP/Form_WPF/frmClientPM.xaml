<Window x:Class="SmartAuditERP.Form_WPF.frmClientPM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="👤 بطاقة عميل"
        Width="800"
        Height="530"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ═══════════ GRADIENTS ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#283593" Offset="0.5"/>
            <GradientStop Color="#3949AB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolbarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#283593" Offset="0"/>
            <GradientStop Color="#1A237E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F7FF" Offset="0"/>
            <GradientStop Color="#EEF0FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════ SHADOWS ═══════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Direction="270" Opacity="0.28"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="FieldShadow"
                          BlurRadius="5" ShadowDepth="1"
                          Direction="270" Opacity="0.08"
                          Color="#44000000"/>

        <!-- ═══════════ LABEL ═══════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ═══════════ TEXTBOX ═══════════ -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Effect="{StaticResource FieldShadow}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3949AB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ECEFF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MultiLineTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- ═══════════ COMBOBOX ═══════════ -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- ═══════════ RADIOBUTTON ═══════════ -->
        <Style x:Key="ModernRadioStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#283593"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ═══════════ ADD BUTTON ═══════════ -->
        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C8E6C9"/>
            <Setter Property="BorderBrush" Value="#81C784"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A5D6A7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ SEARCH BUTTON ═══════════ -->
        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C5CAE9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ NAV/ACTION/CLOSE BUTTONS ═══════════ -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5C6BC0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#283593"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF5350"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ TAB STYLE ═══════════ -->
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3949AB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9FA8DA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ DATAGRID ═══════════ -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EAF6"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="AlternationCount" Value="2"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#283593"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C5CAE9"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self},
                             Path=AlternationIndex}" Value="1">
                    <Setter Property="Background" Value="#F8F9FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ═══════════ WINDOW BORDER ═══════════ -->
    <Border CornerRadius="16"
            Background="{StaticResource CardBrush}"
            BorderBrush="#C5CAE9"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <!-- ─── HEADER ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="22" Margin="8,0,0,0"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="بطاقة عميل / مورد"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="إدارة بيانات العملاء والموردين"
                                       Foreground="#9FA8DA"
                                       FontFamily="Tahoma"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WinCloseStyle}"
                            Click="btnClose_Click">
                        <TextBlock Text="✖"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ─── TAB CONTROL ─── -->
            <TabControl Grid.Row="1"
                        x:Name="TabControl1"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="10,8,10,4">

                <!-- ══════════════════════════════════════════ -->
                <!--              تاب عام                      -->
                <!-- ══════════════════════════════════════════ -->
                <TabItem Header="👤  عام  "
                         Style="{StaticResource ModernTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="4,6">
                        <StackPanel>

                            <!-- بيانات أساسية -->
                            <Border Background="{StaticResource SectionBrush}"
                                    BorderBrush="#C5CAE9"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Margin="0,0,0,8"
                                    Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- صورة الهوية -->
                                    <Border Grid.Column="0"
                                            Background="White"
                                            BorderBrush="#C5CAE9"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Height="160"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image x:Name="IDscan"
                                                   Stretch="Uniform"/>
                                            <TextBlock Text="🪪"
                                                       FontSize="48"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.3"/>
                                        </Grid>
                                    </Border>

                                    <!-- الحقول -->
                                    <StackPanel Grid.Column="2">

                                        <!-- الاسم -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="🏷️ الإسم:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtName"
                                                     Style="{StaticResource ModernTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- الجوال -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="📱 الجوال:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtMobile"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     FlowDirection="LeftToRight"/>
                                        </StackPanel>

                                        <!-- رقم الهوية -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="🪪 رقم الهوية:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtNationalID"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     FlowDirection="LeftToRight"/>
                                        </StackPanel>

                                        <!-- الدولة -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="🌍 البلد:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnCountryAdd"
                                                        Grid.Column="0"
                                                        Style="{StaticResource AddButtonStyle}"
                                                        Click="btnCountryAdd_Click"
                                                        ToolTip="إضافة دولة">
                                                    <TextBlock Text="➕" FontSize="12"/>
                                                </Button>
                                                <ComboBox x:Name="cmbCountry"
                                                          Grid.Column="2"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          SelectionChanged="cmbCountry_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- المدينة -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="🏙️ المدينة:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnCityAdd"
                                                        Grid.Column="0"
                                                        Style="{StaticResource AddButtonStyle}"
                                                        Click="btnCityAdd_Click"
                                                        ToolTip="إضافة مدينة">
                                                    <TextBlock Text="➕" FontSize="12"/>
                                                </Button>
                                                <ComboBox x:Name="cmbCity"
                                                          Grid.Column="2"
                                                          Style="{StaticResource ModernComboBoxStyle}"
                                                          SelectionChanged="cmbCity_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- الإيميل -->
                                        <StackPanel>
                                            <TextBlock Text="📧 الإيميل:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtEmail"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     FlowDirection="LeftToRight"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- زر مسح ضوئي -->
                            <Button x:Name="btnScan"
                                    HorizontalAlignment="Right"
                                    Width="200"
                                    Height="36"
                                    Background="#ECEFF1"
                                    BorderBrush="#B0BEC5"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="btnScan_Click"
                                    Margin="0,0,0,4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖨️" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="مسح ضوئي"
                                               FontFamily="Tahoma"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══════════════════════════════════════════ -->
                <!--          تاب البيانات الإضافية            -->
                <!-- ══════════════════════════════════════════ -->
                <TabItem Header="📋  بيانات إضافية  "
                         Style="{StaticResource ModernTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="4,6">
                        <StackPanel>

                            <!-- نوع الحساب -->
                            <Border Background="{StaticResource SectionBrush}"
                                    BorderBrush="#C5CAE9"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Margin="0,0,0,8"
                                    Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="نوع الحساب"
                                               FontFamily="Tahoma"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#1A237E"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <RadioButton x:Name="rbOwner"
                                                     Style="{StaticResource ModernRadioStyle}"
                                                     Content="🏢 مالك"
                                                     Checked="rbOwner_CheckedChanged"/>
                                        <RadioButton x:Name="rdSupplier"
                                                     Style="{StaticResource ModernRadioStyle}"
                                                     Content="🏭 مورد"
                                                     Checked="rdSupplier_CheckedChanged"/>
                                        <RadioButton x:Name="rdClient"
                                                     Style="{StaticResource ModernRadioStyle}"
                                                     Content="👤 عميل"
                                                     IsChecked="True"
                                                     Checked="rdClient_CheckedChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- الحساب والرصيد -->
                            <Border Background="{StaticResource SectionBrush}"
                                    BorderBrush="#C5CAE9"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Margin="0,0,0,8"
                                    Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- رقم الحساب -->
                                    <StackPanel Grid.Column="0" Visibility="Collapsed">
                                        <TextBlock Text="🔢 رقم الحساب:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="Button1"
                                                    Grid.Column="0"
                                                    Width="30" Height="32"
                                                    Content="..."
                                                    Background="White"
                                                    BorderBrush="#C5CAE9"
                                                    BorderThickness="1"
                                                    FontFamily="Tahoma"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"
                                                    Click="Button1_Click"/>
                                            <TextBox x:Name="txtAccCode"
                                                     Grid.Column="2"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     TextAlignment="Center"
                                                     TextChanged="txtAccCode_TextChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- الرصيد الافتتاحي -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="💰 الرصيد الافتتاحي:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="IValue"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 TextAlignment="Center"/>
                                    </StackPanel>

                                    <!-- الرقم الضريبي -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="🧾 الرقم الضريبي:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtTaxNo"
                                                 Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>

                                    <!-- طبيعة الرصيد -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="📊 طبيعة الرصيد:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,6,0,0">
                                            <RadioButton x:Name="credit"
                                                         Style="{StaticResource ModernRadioStyle}"
                                                         Content="دائن"/>
                                            <RadioButton x:Name="debt"
                                                         Style="{StaticResource ModernRadioStyle}"
                                                         Content="مدين"
                                                         IsChecked="True"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- بيانات إضافية -->
                            <Border Background="{StaticResource SectionBrush}"
                                    BorderBrush="#C5CAE9"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Margin="0,0,0,8"
                                    Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- رقم الهاتف -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📞 رقم الهاتف:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtTel"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>

                                    <!-- فاكس -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="📠 فاكس:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtFax"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>

                                    <!-- المنطقة -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="📍 المنطقة:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnAreaAdd"
                                                    Grid.Column="0"
                                                    Style="{StaticResource AddButtonStyle}"
                                                    Click="btnAreaAdd_Click"
                                                    ToolTip="إضافة منطقة">
                                                <TextBlock Text="➕" FontSize="12"/>
                                            </Button>
                                            <ComboBox x:Name="cmbArea"
                                                      Grid.Column="2"
                                                      Style="{StaticResource ModernComboBoxStyle}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- مجال العمل والملاحظات -->
                            <Border Background="{StaticResource SectionBrush}"
                                    BorderBrush="#C5CAE9"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- مجال العمل -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="💼 مجال العمل:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnActAdd"
                                                    Grid.Column="0"
                                                    Style="{StaticResource AddButtonStyle}"
                                                    Click="btnActAdd_Click"
                                                    ToolTip="إضافة مجال">
                                                <TextBlock Text="➕" FontSize="12"/>
                                            </Button>
                                            <ComboBox x:Name="cmbActs"
                                                      Grid.Column="2"
                                                      Style="{StaticResource ModernComboBoxStyle}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- ملاحظات -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="📝 ملاحظات:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtNotes"
                                                 Style="{StaticResource MultiLineTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══════════════════════════════════════════ -->
                <!--              تاب البحث                    -->
                <!-- ══════════════════════════════════════════ -->
                <TabItem Header="🔍  البحث  "
                         Style="{StaticResource ModernTabItemStyle}">
                    <Grid Margin="4,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- فلاتر البحث -->
                        <Border Grid.Row="0"
                                Background="{StaticResource SectionBrush}"
                                BorderBrush="#C5CAE9"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Margin="0,0,0,8"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        x:Name="btnSearch"
                                        Style="{StaticResource SearchButtonStyle}"
                                        Click="btnSearch_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="18"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="بحث"
                                                   FontFamily="Tahoma"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#3949AB"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBox x:Name="txtNameSrch"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         TextChanged="txtNameSrch_TextChanged"
                                         PreviewKeyDown="txtNameSrch_PreviewKeyDown"/>

                                <TextBlock Grid.Column="4"
                                           Text="🏷️ الإسم:"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0"/>
                            </Grid>
                        </Border>

                        <!-- جدول النتائج -->
                        <Border Grid.Row="1"
                                BorderBrush="#C5CAE9"
                                BorderThickness="1"
                                CornerRadius="12"
                                ClipToBounds="True"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="#3949AB" Padding="12,8">
                                    <TextBlock Text="📊 النتائج"
                                               Foreground="White"
                                               FontFamily="Tahoma"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                </Border>

                                <DataGrid x:Name="dgvCustomers"
                                          Style="{StaticResource ModernDataGridStyle}"
                                          SelectionChanged="dgvCustomers_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="🏷️ الإسم"
                                                            Binding="{Binding CustomerName}"
                                                            Width="180">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="🪪 رقم الهوية"
                                                            Binding="{Binding NationalId}"
                                                            Width="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="📞 الهاتف"
                                                            Binding="{Binding Tel}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="📱 الجوال"
                                                            Binding="{Binding Mobile}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="🌍 الدولة"
                                                            Binding="{Binding CountryName}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="🏙️ المدينة"
                                                            Binding="{Binding CityName}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="📍 المنطقة"
                                                            Binding="{Binding AreaName}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </TabItem>

            </TabControl>

            <!-- ─── TOOLBAR ─── -->
            <Border Grid.Row="2"
                    Background="{StaticResource ToolbarBrush}"
                    CornerRadius="0,0,16,16"
                    Effect="{StaticResource CardShadow}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="btnClose"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="btnClose_Click"
                            ToolTip="إغلاق">
                        <TextBlock Text="✖" FontSize="16"/>
                    </Button>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="btnFirst"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnFirst_Click"
                                ToolTip="الأول">
                            <TextBlock Text="⏮" FontSize="16"/>
                        </Button>

                        <Button x:Name="btnPrevious"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnPrevious_Click"
                                ToolTip="السابق">
                            <TextBlock Text="◀" FontSize="16"/>
                        </Button>

                        <Border Background="#22FFFFFF"
                                CornerRadius="8"
                                Padding="12,0"
                                Margin="4,0">
                            <TextBlock x:Name="txtRecordIndicator"
                                       Text="📍 سجل جديد"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button x:Name="btnNext"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnNext_Click"
                                ToolTip="التالي">
                            <TextBlock Text="▶" FontSize="16"/>
                        </Button>

                        <Button x:Name="btnLast"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnLast_Click"
                                ToolTip="الأخير">
                            <TextBlock Text="⏭" FontSize="16"/>
                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="btnNew"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="3,0"
                                Click="btnNew_Click"
                                ToolTip="جديد">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="جديد"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnDelete"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#E53935"
                                Margin="3,0"
                                Click="btnDelete_Click"
                                ToolTip="حذف">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="حذف"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnPrint"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#5C6BC0"
                                Margin="3,0"
                                Click="btnPrint_Click"
                                ToolTip="طباعة">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="طباعة"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnSave"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2E7D32"
                                Margin="3,0"
                                Click="btnSave_Click"
                                ToolTip="حفظ">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="حفظ"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>