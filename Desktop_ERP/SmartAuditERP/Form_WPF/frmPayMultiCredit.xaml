<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmPayMultiCredit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="طريقة الدفع"
    Width="560" Height="520"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AmountBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#F0F2F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EBF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PayBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="16,14">
            <TextBlock Text="💳 اختر طريقة الدفع"
                       Foreground="White"
                       FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ═══ Content ═══ -->
        <Border Grid.Row="1"
                Background="White"
                Margin="14,10,14,6"
                CornerRadius="12"
                Effect="{StaticResource CardShadow}"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- صافي الفاتورة -->
                <TextBox x:Name="lblNetInvoice"
                         Grid.Row="0" Grid.Column="0"
                         Style="{StaticResource AmountBox}"
                         IsReadOnly="True"
                         Text="0"
                         Foreground="#2E4E9E"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="📄 صافي الفاتورة"
                           Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Right"/>

                <!-- نقداً -->
                <TextBox x:Name="txtCash"
                         Grid.Row="2" Grid.Column="0"
                         Style="{StaticResource AmountBox}"
                         Text="0"
                         TextChanged="txtCash_TextChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="💵 نقداً"
                           Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Right"/>

                <!-- شبكة / فيزا -->
                <TextBox x:Name="txtVisa"
                         Grid.Row="4" Grid.Column="0"
                         Style="{StaticResource AmountBox}"
                         Text="0"
                         TextChanged="txtVisa_TextChanged"/>
                <TextBlock Grid.Row="4" Grid.Column="2"
                           Text="💳 شبكة / فيزا"
                           Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Right"/>

                <!-- العميل -->
                <Grid Grid.Row="6" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbClient"
                              Grid.Column="0"
                              Height="36"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Background="White"
                              DisplayMemberPath="name"
                              SelectedValuePath="id"/>
                    <Button x:Name="btnSelectCust"
                            Grid.Column="2"
                            Content="🔍"
                            Height="36" FontSize="14"
                            Background="#E8EBF5"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderLight}"
                            Cursor="Hand"
                            Click="btnSelectCust_Click"/>
                </Grid>
                <TextBlock Grid.Row="6" Grid.Column="2"
                           Text="👤 العميل"
                           Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Right"/>

                <!-- أجل -->
                <TextBox x:Name="txtCredit"
                         Grid.Row="8" Grid.Column="0"
                         Style="{StaticResource AmountBox}"
                         IsReadOnly="True"
                         Text="0"
                         Foreground="#C0392B"/>
                <TextBlock Grid.Row="8" Grid.Column="2"
                           Text="📋 أجل"
                           Style="{StaticResource FieldLabel}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ═══ Buttons ═══ -->
        <Grid Grid.Row="2" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancel"
                    Grid.Column="0"
                    Content="✖ إغلاق"
                    Style="{StaticResource CancelBtn}"
                    Click="btnCancel_Click"/>

            <Button x:Name="btnPay"
                    Grid.Column="2"
                    Content="✔ دفع"
                    Style="{StaticResource PayBtn}"
                    Click="btnPay_Click"/>
        </Grid>
    </Grid>
</dx:ThemedWindow>