<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSecurityPnl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="تسجيل الدخول"
    Width="320" Height="370"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F1EBF5"
    FontFamily="Cairo, Tahoma, Arial"
    WindowStyle="None"
    AllowsTransparency="True"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- الألوان الأساسية -->
        <SolidColorBrush x:Key="PurpleDark"  Color="#471F5B"/>
        <SolidColorBrush x:Key="PurpleLight" Color="#F1EBF5"/>

        <Style x:Key="NumBtn" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource PurpleLight}"/>
            <Setter Property="Foreground" Value="{StaticResource PurpleDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C5B8D5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#D8C8E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#B8A0CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource NumBtn}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Border Background="{StaticResource PurpleLight}"
            CornerRadius="12"
            BorderBrush="#471F5B" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ Header ══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource PurpleDark}"
                    CornerRadius="10,10,0,0"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- زر الإغلاق -->
                    <Button x:Name="btnClose" Grid.Column="0"
                            Content="✕"
                            Width="40" Height="36"
                            Background="#C00000"
                            Foreground="White"
                            FontSize="14" FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="#FF3333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- عنوان -->
                    <TextBlock Grid.Column="1"
                               Text="🔐 تسجيل الدخول"
                               Foreground="White"
                               FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- تسجيل دخول متقدم -->
                    <TextBlock Grid.Column="2"
                               x:Name="LinkLabel1"
                               Text="تسجيل دخول متقدم"
                               Foreground="#D0C0E0"
                               FontSize="10"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               VerticalAlignment="Center"
                               MouseLeftButtonDown="LinkLabel1_Click"/>
                </Grid>
            </Border>

            <!-- ══ Body ══ -->
            <StackPanel Grid.Row="1" Margin="10,10,10,10">

                <!-- حقل كلمة المرور -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="txtPass"
                                 Grid.Column="0"
                                 Height="32" FontSize="14"
                                 Background="White"
                                 BorderBrush="#C5B8D5"
                                 BorderThickness="1"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="txtPass_KeyDown"/>

                    <TextBlock Grid.Column="1"
                               Text="كلمة المرور"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource PurpleDark}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>

                <!-- الصف 6,7,8 -->
                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,4">
                    <Button x:Name="cmd6" Content="6" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <Button x:Name="cmd7" Content="7" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <Button x:Name="cmd8" Content="8" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                </UniformGrid>

                <!-- الصف 2,3,4 -->
                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,4">
                    <Button x:Name="cmd2" Content="2" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <Button x:Name="cmd3" Content="3" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <Button x:Name="cmd4" Content="4" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                </UniformGrid>

                <!-- الصف 9,5 -->
                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,4">
                    <Button x:Name="cmd9" Content="9" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <Button x:Name="cmd5" Content="5" Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <!-- فراغ -->
                    <Border Margin="2"/>
                </UniformGrid>

                <!-- الصف 0,1,C,Login -->
                <UniformGrid Columns="4" Rows="1" Margin="0,0,0,0">
                    <Button x:Name="cmd0"    Content="0"  Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <Button x:Name="cmd135"  Content="1"  Style="{StaticResource NumBtn}"
                            Margin="2" Click="NumBtn_Click"/>
                    <Button x:Name="cmdClearAll" Content="C" Style="{StaticResource ActionBtn}"
                            Margin="2" Click="cmdClearAll_Click"/>
                    <Button x:Name="btnLogin" Content="➡️" Style="{StaticResource ActionBtn}"
                            Margin="2" ToolTip="دخول"
                            Click="btnLogin_Click"/>
                </UniformGrid>

            </StackPanel>
        </Grid>
    </Border>
</dx:ThemedWindow>