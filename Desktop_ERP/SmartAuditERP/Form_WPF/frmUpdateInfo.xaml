<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmUpdateInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="معلومات التحديث"
    Width="420" Height="360"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="5"  ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="InfoBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Border Background="White" CornerRadius="12" Margin="8"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <!-- بيانات النسخة -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- الوصف -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <!-- الأزرار الرئيسية -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- منطقة التحديث اليدوي (مخفية) -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- أزرار التحديث اليدوي (مخفية) -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="8" Padding="10,6">
                <TextBlock Text="🔄 معلومات التحديث"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           FontFamily="Cairo, Tahoma, Arial"/>
            </Border>

            <!-- بيانات النسخة -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📌 النسخة الحالية:"
                           FontSize="11" FontWeight="Bold" Foreground="#555"
                           VerticalAlignment="Center"
                           FontFamily="Cairo, Tahoma, Arial"/>
                <TextBlock Grid.Column="1" x:Name="lblCurrentVer"
                           Text="none"
                           FontSize="11" FontWeight="Bold" Foreground="#213A7A"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           FontFamily="Cairo, Tahoma, Arial"/>

                <TextBlock Grid.Column="3" Text="📅 تاريخ الإصدار:"
                           FontSize="11" FontWeight="Bold" Foreground="#555"
                           VerticalAlignment="Center"
                           FontFamily="Cairo, Tahoma, Arial"/>
                <TextBlock Grid.Column="4" x:Name="lblDate"
                           Text="none"
                           FontSize="11" FontWeight="Bold" Foreground="#213A7A"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           FontFamily="Cairo, Tahoma, Arial"/>
            </Grid>

            <!-- الوصف -->
            <Border Grid.Row="4"
                    Background="#F0F4FF"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1" CornerRadius="7"
                    Padding="10,8">
                <StackPanel>
                    <TextBlock Text="📋 معلومات عن النسخة:"
                               FontSize="11" FontWeight="Bold" Foreground="#555"
                               FontFamily="Cairo, Tahoma, Arial"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblDesc"
                               Text="none"
                               FontSize="11" Foreground="#1B2642"
                               FontFamily="Cairo, Tahoma, Arial"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- الأزرار الرئيسية -->
            <StackPanel Grid.Row="6" Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="btnChekUpdate"
                        Content="🔍 التحقق من التحديثات"
                        Background="{StaticResource HeaderBrush}"
                        Style="{StaticResource InfoBtn}"
                        Width="148" Margin="0,0,8,0"
                        Click="btnChekUpdate_Click"/>
                <Button x:Name="btnManualUpdate"
                        Content="📁 تحديث يدوي"
                        Background="#708090"
                        Style="{StaticResource InfoBtn}"
                        Width="120"
                        Click="btnManualUpdate_Click"/>
            </StackPanel>

            <!-- منطقة التحديث اليدوي (مخفية) -->
            <Grid Grid.Row="8" x:Name="pnlManual" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="txtPath"
                         Height="28" FontSize="11"
                         Background="White"
                         BorderBrush="{StaticResource BorderLight}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Padding="6,0"
                         IsReadOnly="True"/>
                <Button Grid.Column="2"
                        x:Name="btnPath"
                        Content="📁 المسار"
                        Background="{StaticResource HeaderBrush}"
                        Style="{StaticResource InfoBtn}"
                        Height="28"
                        Click="btnPath_Click"/>
            </Grid>

            <!-- أزرار بدء/إلغاء (مخفية) -->
            <StackPanel Grid.Row="10" x:Name="pnlActions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Button x:Name="btnStart"
                        Content="▶ ابدأ"
                        Background="{StaticResource SaveBrush}"
                        Style="{StaticResource InfoBtn}"
                        Width="90" Margin="0,0,8,0"
                        Click="btnStart_Click"/>
                <Button x:Name="btnCancel"
                        Content="✖ خروج"
                        Background="{StaticResource DangerBrush}"
                        Style="{StaticResource InfoBtn}"
                        Width="90"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</dx:ThemedWindow>