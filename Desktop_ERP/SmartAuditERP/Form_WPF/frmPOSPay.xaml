<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmPOSPay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="دفع الفاتورة"
    Width="900" Height="760"
    MinWidth="870" MinHeight="726"
    MaxWidth="900" MaxHeight="760"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5"
    FontFamily="Cairo, Tahoma, Arial"
    ShowInTaskbar="False"
    WindowStyle="None"
    ResizeMode="NoResize"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <SolidColorBrush x:Key="ActiveGreen"  Color="#2ECC71"/>
        <SolidColorBrush x:Key="InactiveGray" Color="#BDC3C7"/>
        <SolidColorBrush x:Key="DangerRed"    Color="#E74C3C"/>
        <SolidColorBrush x:Key="LightBg"      Color="#ECF0F1"/>
        <SolidColorBrush x:Key="BorderLight"  Color="#D0D7E8"/>
        <SolidColorBrush x:Key="BlueVal"      Color="#2980B9"/>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.13" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <!-- NumpadBtn -->
        <Style x:Key="NumpadBtn" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource LightBg}"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D5DBDB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A9B1B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CoinBtn -->
        <Style x:Key="CoinBtn" TargetType="Button">
            <Setter Property="Width" Value="205"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource LightBg}"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D5DBDB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A9B1B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OptionBtn -->
        <Style x:Key="OptionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource InactiveGray}"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PayBtn -->
        <Style x:Key="PayBtn" TargetType="Button">
            <Setter Property="Height" Value="62"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ActiveGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelPayBtn" TargetType="Button" BasedOn="{StaticResource PayBtn}">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
        </Style>

        <Style x:Key="SameBtn" TargetType="Button" BasedOn="{StaticResource PayBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00BCD4" Offset="0"/>
                        <GradientStop Color="#0097A7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BigInputBox -->
        <Style x:Key="BigInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource LightBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadonlyBox" TargetType="TextBox" BasedOn="{StaticResource BigInputBox}">
            <Setter Property="Background" Value="#D5DBDB"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="SmallInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#D5DBDB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="3,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="coinColumn" Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--           المنطقة الرئيسية                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- الشريط العلوي -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    FlowDirection="RightToLeft"
                    BorderThickness="0,0,0,1"
                    Padding="8,6"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>

                    <!-- طرق الدفع -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="btnCash"
                                Content="💵 كاش"
                                Style="{StaticResource OptionBtn}"
                                Background="{StaticResource ActiveGreen}"
                                Foreground="White"
                                Width="110" Click="btnCash_Click"/>
                        <Button x:Name="btnNetwork"
                                Content="🖧 شبكة"
                                Style="{StaticResource OptionBtn}"
                                Width="100" Click="btnNetwork_Click"/>
                        <Button x:Name="btnATM"
                                Content="🏧 ATM"
                                Style="{StaticResource OptionBtn}"
                                Width="100" Click="btnATM_Click"/>
                        <Button x:Name="btnVisa"
                                Content="💳 فيزا"
                                Style="{StaticResource OptionBtn}"
                                Width="90" Click="btnVisa_Click"/>
                        <Button x:Name="btnMulti"
                                Content="🔀 متعدد"
                                Style="{StaticResource OptionBtn}"
                                Width="90" Click="btnMulti_Click"/>
                        <Button x:Name="btnHosting"
                                Content="🍽️ ضيافة"
                                Style="{StaticResource OptionBtn}"
                                Width="90" Click="btnHosting_Click"/>
                        <Button x:Name="btnPayPostpone"
                                Content="⏳ آجل"
                                Style="{StaticResource OptionBtn}"
                                Width="80"
                                Visibility="Collapsed"
                                Click="btnPayPostpone_Click"/>
                        <Button x:Name="btnPayCash"
                                Content="💵 نقدي"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Visibility="Collapsed"
                                Background="{StaticResource ActiveGreen}"
                                Foreground="White"
                                Click="btnPayCash_Click"/>
                    </WrapPanel>

                    <!-- أنواع الطلب -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="btnlocal"
                                Content="🏠 محلي"
                                Style="{StaticResource OptionBtn}"
                                Width="100" Click="btnlocal_Click"/>
                        <Button x:Name="btnAway"
                                Content="🛵 سفري"
                                Style="{StaticResource OptionBtn}"
                                Width="100" Click="btnAway_Click"/>
                        <Button x:Name="btnTable"
                                Content="🪑 طاولة"
                                Style="{StaticResource OptionBtn}"
                                Width="100" Click="btnTable_Click"/>
                        <Button x:Name="btnCar"
                                Content="🚗 سيارة"
                                Style="{StaticResource OptionBtn}"
                                Width="100" Click="btnCar_Click"/>
                        <Button x:Name="btnFamily"
                                Content="👨‍👩‍👧 عوائل"
                                Style="{StaticResource OptionBtn}"
                                Width="100" Click="btnFamily_Click"/>
                    </WrapPanel>

                    <!-- الإضافات والخصومات -->
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="btnDelv"
                                Content="🛵 توصيل"
                                Style="{StaticResource OptionBtn}"
                                Width="90" Click="btnDelv_Click"/>
                        <TextBox x:Name="txtDevM"
                                 Style="{StaticResource SmallInputBox}"
                                 Width="80" Margin="2,2"
                                 Text="0"
                                 TextChanged="txtDevM_TextChanged"/>

                        <Button x:Name="btnRahn"
                                Content="🔒 تأمين"
                                Style="{StaticResource OptionBtn}"
                                Width="90" Click="btnRahn_Click"/>
                        <TextBox x:Name="txtRahn"
                                 Style="{StaticResource SmallInputBox}"
                                 Width="80" Margin="2,2"
                                 Text="0"
                                 TextChanged="txtRahn_TextChanged"/>

                        <Button x:Name="btnDiscount"
                                Content="🏷️ خصم"
                                Style="{StaticResource OptionBtn}"
                                Width="90" Click="btnDiscount_Click"/>
                        <TextBox x:Name="txtInvDiscount"
                                 Style="{StaticResource SmallInputBox}"
                                 Width="80" Margin="2,2"
                                 Text="0"
                                 TextChanged="txtDiscount_TextChanged"/>

                        <Button x:Name="btnDiscoPerc"
                                Content="% خصم"
                                Style="{StaticResource OptionBtn}"
                                Width="90" Click="btnDiscoPerc_Click"/>
                        <TextBox x:Name="txtDiscoPerc"
                                 Style="{StaticResource SmallInputBox}"
                                 Width="80" Margin="2,2"
                                 Text="0"
                                 KeyDown="txtDiscoPerc_KeyDown"
                                 LostFocus="txtDiscoPerc_Leave"/>
                    </WrapPanel>

                </StackPanel>
            </Border>

            <!-- صافي الفاتورة -->
            <Border Grid.Row="1"
                    Background="White"
                    Margin="6,6,6,0"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="lblNetVal"
                                   Text="0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BlueVal}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="📄 صافي الفاتورة"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Separator Grid.Column="1"
                               Width="1"
                               Background="{StaticResource BorderLight}"
                               Margin="10,0"/>

                    <StackPanel x:Name="Panel3"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="txtTotDiscounts"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#27AE60"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="🏷️ خصومات"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- حقول الدفع -->
            <StackPanel Grid.Row="2" Margin="6,6,6,0">

                <!-- الباقي -->
                <Border Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtrecrem1"
                                 Grid.Column="0"
                                 Style="{StaticResource ReadonlyBox}"
                                 Text="0"/>
                        <TextBlock Grid.Column="1"
                                   Text="💰 الباقي"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- نقداً -->
                <Border Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCashpay"
                                 Grid.Column="0"
                                 Style="{StaticResource BigInputBox}"
                                 Text="0"
                                 TextChanged="txtCashpay_TextChanged"/>
                        <TextBlock Grid.Column="1"
                                   Text="💵 نقداً"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- شبكة / فيزا -->
                <Border Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtNetwork"
                                 Grid.Column="0"
                                 Style="{StaticResource BigInputBox}"
                                 IsReadOnly="True"
                                 Text="0"
                                 TextChanged="txtNetwork_TextChanged"/>
                        <TextBlock Grid.Column="1"
                                   Text="🖧 شبكة / فيزا"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- المجموع (مخفي) -->
                <Border x:Name="Panel7"
                        Background="White" CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6" Margin="0,0,0,4"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtInvSum"
                                   Grid.Column="0"
                                   Text="0"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#27AE60"/>
                        <TextBlock Grid.Column="1"
                                   Text="📊 المجموع"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- لوحة الأرقام + أزرار الدفع -->
            <Grid Grid.Row="3" Margin="6,6,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار الدفع -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,0">
                    <Button x:Name="btnSame"
                            Content="⚖️ F6 مطابقة"
                            Style="{StaticResource SameBtn}"
                            Margin="0,0,0,6"
                            Click="btnSame_Click"/>
                    <Button x:Name="save"
                            Content="✔ دفع"
                            Style="{StaticResource PayBtn}"
                            Margin="0,0,0,6"
                            Click="save_Click"/>
                    <Button x:Name="btnCancel"
                            Content="✖ إغلاق"
                            Style="{StaticResource CancelPayBtn}"
                            Click="btnCancel_Click"/>
                </StackPanel>

                <!-- لوحة المفاتيح -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}"
                        Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="cmd1" Content="1" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd2" Content="2" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd3" Content="3" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="cmd4" Content="4" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd5" Content="5" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd6" Content="6" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="cmd7" Content="7" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd8" Content="8" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd9" Content="9" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="cmd0"       Content="0" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmdDot"     Content="." Style="{StaticResource NumpadBtn}" Click="NumpadDot_Click"/>
                            <Button x:Name="cmdClearAll"
                                    Content="⌫"
                                    Style="{StaticResource NumpadBtn}"
                                    Background="{StaticResource DangerRed}"
                                    Foreground="White"
                                    Click="cmdClearAll_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- الفئات النقدية -->
        <Border x:Name="FpnlCoin"
                Grid.Column="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1,0,0,0"
                Padding="8,10">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="💵 الفئات"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <Button x:Name="btnOne"     Content="1"          Style="{StaticResource CoinBtn}" Click="btnOne_Click"/>
                <Button x:Name="btnFive"    Content="5"          Style="{StaticResource CoinBtn}" Click="btnFive_Click"/>
                <Button x:Name="btnTen"     Content="10"         Style="{StaticResource CoinBtn}" Click="btnTen_Click"/>
                <Button x:Name="btnTwe"     Content="50"         Style="{StaticResource CoinBtn}" Click="btnTwe_Click"/>
                <Button x:Name="btnOneHan"  Content="100"        Style="{StaticResource CoinBtn}" Click="btnOneHan_Click"/>
                <Button x:Name="btnFiveHand" Content="500"       Style="{StaticResource CoinBtn}" Click="btnFiveHand_Click"/>
                <Button x:Name="btnTwoHan"  Content="مئتان ريال" Style="{StaticResource CoinBtn}" Margin="0,3" Click="btnTwoHan_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>