<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmDebtNote"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="إشعار مدين"
    Width="980" Height="620"
    MinWidth="920" MinHeight="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial">

    <dx:ThemedWindow.Resources>

        <!-- Brushes -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF9E57" Offset="0"/>
            <GradientStop Color="#E67817" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5A8DFF" Offset="0"/>
            <GradientStop Color="#3D66D6" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- Effects -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.20"
                          Color="#000000"/>

        <!-- Labels -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- TextEdit Style -->
        <Style x:Key="ModernEditor" TargetType="{x:Type dxe:TextEdit}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ReadOnlyEditor" TargetType="{x:Type dxe:TextEdit}" BasedOn="{StaticResource ModernEditor}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F7F9FC"/>
        </Style>

        <Style x:Key="ModernCombo" TargetType="{x:Type dxe:ComboBoxEdit}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernDate" TargetType="{x:Type dxe:DateEdit}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernMemo" TargetType="{x:Type dxe:MemoEdit}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
        </Style>

        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinWidth" Value="46"/>
        </Style>

        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════ -->
        <!-- Main Card -->
        <!-- ═══════════════════════════════ -->
        <Border Grid.Row="0"
                Margin="10,10,10,6"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Effect="{StaticResource CardShadow}">

            <StackPanel x:Name="pnlMain">

                <!-- Title -->
                <Border Background="{StaticResource HeaderBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,14">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="🧾"
                                   FontSize="18"
                                   Foreground="White"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWindowTitle"
                                   Text="إدخال بيانات إشعار مدين"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Row 1 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Note Type -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblNoteType"
                                   Text="📌 نوع الإشعار"
                                   Style="{StaticResource FieldLabel}"/>
                        <Border BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#F8FAFF"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rdInvNote"
                                             Content="إشعار فاتورة"
                                             IsChecked="True"
                                             Style="{StaticResource ModernRadioButton}"/>
                                <RadioButton x:Name="rdMainNote"
                                             Content="إشعار عام"
                                             Style="{StaticResource ModernRadioButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- No -->
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lblNo"
                                   Text="🔢 رقم السند"
                                   Style="{StaticResource FieldLabel}"/>
                        <Border BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#F7F9FC"
                                Height="34"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="txtNo"
                                       Text="0"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#1B2642"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Date -->
                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="lblDate"
                                   Text="📅 التاريخ"
                                   Style="{StaticResource FieldLabel}"/>
                        <dxe:DateEdit x:Name="txtDate"
                                      Style="{StaticResource ModernDate}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Client -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblClients"
                                   Text="👤 اسم العميل"
                                   Style="{StaticResource FieldLabel}"/>
                        <dxe:ComboBoxEdit x:Name="cmbClients"
                                          Style="{StaticResource ModernCombo}"
                                          AutoComplete="True"
                                          NullText="اختر العميل..."/>
                    </StackPanel>

                    <!-- Invoice No -->
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lblInvNo"
                                   Text="📄 رقم الفاتورة"
                                   Style="{StaticResource FieldLabel}"/>
                        <dxe:TextEdit x:Name="txtInvNo"
                                      Style="{StaticResource ModernEditor}"/>
                    </StackPanel>

                    <!-- Search -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button x:Name="btnSearch"
                                Content="🔍 بحث"
                                Style="{StaticResource InfoBtn}"
                                Width="78"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Invoice Value -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblInvVal"
                                   Text="💵 قيمة الفاتورة"
                                   Style="{StaticResource FieldLabel}"/>
                        <dxe:TextEdit x:Name="txtInvVal"
                                      Style="{StaticResource ReadOnlyEditor}"
                                      EditValue="0"/>
                    </StackPanel>

                    <!-- Previous Discounts -->
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lblPreviousDiscVal"
                                   Text="📉 خصومات سابقة"
                                   Style="{StaticResource FieldLabel}"/>
                        <dxe:TextEdit x:Name="txtPreviousDiscVal"
                                      Style="{StaticResource ReadOnlyEditor}"
                                      EditValue="0"/>
                    </StackPanel>

                    <!-- Discount Percent -->
                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="lblDiscountPerc"
                                   Text="🏷️ نسبة الخصم"
                                   Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <dxe:TextEdit x:Name="txtDiscountPerc"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernEditor}"
                                          EditValue="0"/>
                            <Border Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Background="#F1F4FB"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock x:Name="Label1"
                                           Text="%"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#50607A"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Discount Value -->
                    <StackPanel Grid.Column="6">
                        <TextBlock x:Name="lblDiscountVal"
                                   Text="✂️ قيمة الخصم"
                                   Style="{StaticResource FieldLabel}"/>
                        <dxe:TextEdit x:Name="txtDiscountVal"
                                      Style="{StaticResource ModernEditor}"
                                      EditValue="0"/>
                    </StackPanel>
                </Grid>

                <!-- Summary Row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tax -->
                    <Border Grid.Column="0"
                            Background="#FFF7ED"
                            BorderBrush="#F6C98C"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="lblTAX"
                                       Text="🧾 ضريبة الخصم"
                                       Style="{StaticResource FieldLabel}"/>
                            <dxe:TextEdit x:Name="txtTax"
                                          Style="{StaticResource ReadOnlyEditor}"
                                          EditValue="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Net -->
                    <Border Grid.Column="2"
                            Background="#EEF7FF"
                            BorderBrush="#B8D4FF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="lblNet"
                                       Grid.Column="0"
                                       Text="💰 الصافي"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1B2642"
                                       VerticalAlignment="Center"/>

                            <dxe:TextEdit x:Name="txtNet"
                                          Grid.Column="2"
                                          Style="{StaticResource ReadOnlyEditor}"
                                          FontSize="16"
                                          EditValue="0"/>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════ -->
        <!-- Notes Card -->
        <!-- ═══════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="10,0,10,6"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="8"
                        Padding="12,7"
                        Margin="0,0,0,12">
                    <TextBlock Text="📝 البيان والتفاصيل"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="lblNote"
                               Text="📌 البيان"
                               Style="{StaticResource FieldLabel}"/>
                    <dxe:MemoEdit x:Name="txtNotes"
                                  Style="{StaticResource ModernMemo}"
                                  Height="170"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Background="#F7F9FC"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                    <TextBlock x:Name="txtStatusBar"
                               Text="جاهز"
                               FontSize="11"
                               Foreground="#5C6E8A"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════ -->
        <!-- Footer Buttons -->
        <!-- ═══════════════════════════════ -->
        <Border Grid.Row="2"
                x:Name="panel2"
                Background="{StaticResource FooterBrush}"
                Padding="12,8"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="86"
                            Margin="0,0,6,0"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="86"
                            Margin="0,0,6,0"/>
                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource InfoBtn}"
                            Width="86"
                            Margin="0,0,6,0"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="86"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="86"
                            Margin="0,0,6,0"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="86"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>