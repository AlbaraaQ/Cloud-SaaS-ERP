                                        <Image x:Name="g6" Style="{StaticResource MarineImg}"/>
                                        <TextBlock x:Name="gL6" Text="l1"
                                                   FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MarineCard_g7"
                                        Grid.Row="1" Grid.Column="3"
                                        Style="{StaticResource MarineCard}"
                                        MouseLeftButtonDown="MarineCard_Click" Tag="6">
                                    <StackPanel>
                                        <Image x:Name="g7" Style="{StaticResource MarineImg}"/>
                                        <TextBlock x:Name="gl7" Text="l1"
                                                   FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MarineCard_g8"
                                        Grid.Row="1" Grid.Column="4"
                                        Style="{StaticResource MarineCard}"
                                        MouseLeftButtonDown="MarineCard_Click" Tag="7">
                                    <StackPanel>
                                        <Image x:Name="g8" Style="{StaticResource MarineImg}"/>
                                        <TextBlock x:Name="gl8" Text="l1"
                                                   FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- أزرار التنقل -->
                                <StackPanel Grid.Row="2" Grid.Column="1"
                                            Grid.ColumnSpan="4"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,4,0,0">
                                    <Button x:Name="btnUpItems"
                                            Content="▲"
                                            Style="{StaticResource ActionBtn}"
