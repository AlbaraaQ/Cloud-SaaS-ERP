                                        Style="{StaticResource MarineCard}"
                                        MouseLeftButtonDown="MarineCard_Click" Tag="3">
                                    <StackPanel>
                                        <Image x:Name="g4" Style="{StaticResource MarineImg}"/>
                                        <TextBlock x:Name="gL4" Text="l1"
                                                   FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
