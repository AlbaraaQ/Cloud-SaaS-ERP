                                    <Button x:Name="btnDownItem"
                                            Content="▼"
                                            Style="{StaticResource ActionBtn}"
                                            Width="60" Height="30"
                                            Click="btnDownItem_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ══════════ Body ══════════ -->
                    <Grid Grid.Row="1">
