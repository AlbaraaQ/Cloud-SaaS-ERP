<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frminvoice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="فاتورة التأجير"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    MinWidth="1022" MinHeight="726"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════ Brushes ═══════════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DarkBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A3A3A" Offset="0"/>
            <GradientStop Color="#404040" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F9AA33" Offset="0"/>
            <GradientStop Color="#E08B10" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══════════════ Styles ═══════════════ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WhiteLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadonlyTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00FF7F"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Button Base -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="DarkBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DarkBrush}"/>
        </Style>

        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
        </Style>

        <!-- لوحة الأرقام -->
        <Style x:Key="NumBtn" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر عملية كبير -->
        <Style x:Key="BigOpBtn" TargetType="Button" BasedOn="{StaticResource DarkBtn}">
            <Setter Property="Height" Value="70"/>
            <Setter Property="Width" Value="107"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="GreenColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#C0FFC0"/>
            <Setter Property="Foreground" Value="#000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C0FFC0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SrchDgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- صورة مركب -->
        <Style x:Key="MarineImg" TargetType="Image">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Stretch" Value="Fill"/>
        </Style>

        <Style x:Key="MarineCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabControl1"
                    Background="#F3F5F9"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold">

            <!-- ════════════════════════════════════════════
                 TabPage1 - الفاتورة
            ════════════════════════════════════════════ -->
            <TabItem x:Name="TabPage1" Header="    📄 الفاتورة    ">
                <Grid Background="#404040">
                    <Grid.RowDefinitions>
                        <!-- Header: بيانات الفاتورة + المركبات -->
                        <RowDefinition Height="Auto"/>
                        <!-- Body: جدول الخدمات + لوحة التحكم -->
                        <RowDefinition Height="*"/>
                        <!-- Footer: أزرار العمليات -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══════════ Header ══════════ -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!-- بيانات الفاتورة -->
                            <ColumnDefinition Width="*"/>
                            <!-- معرض المركبات -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel18: بيانات الفاتورة -->
                        <!-- ═══════════════════════════════════════════════════════
     Panel18: بيانات الفاتورة - محدث بجميع العناصر
═══════════════════════════════════════════════════════ -->
                        <Border Grid.Column="0"
        Background="#404040"
        Padding="8,6">
                            <StackPanel>

                                <!-- الصف الأول: الرقم، التاريخ، الوقت، رقم الطلب، رقم المرجع -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- رقم الفاتورة -->
                                    <TextBox x:Name="txtNo"
                     Grid.Column="0"
                     Style="{StaticResource ReadonlyTextBox}"
                     TextAlignment="Center"
                     FontSize="13" FontWeight="Bold"
                     Background="#D3D3D3"/>

                                    <TextBlock Grid.Column="2"
                       Text="الرقم"
                       Style="{StaticResource WhiteLabel}"
                       Margin="0,0,4,0"/>

                                    <!-- التاريخ -->
                                    <dxe:DateEdit x:Name="txtDate"
                          Grid.Column="3"
                          Height="28" FontSize="11"
                          IsReadOnly="True"/>

                                    <TextBlock Grid.Column="5"
                       Text="التاريخ"
                       Style="{StaticResource WhiteLabel}"
                       Margin="0,0,4,0"/>

                                    <!-- وقت الفاتورة -->
                                    <TextBox x:Name="txtInvTime1"
                     Grid.Column="6"
                     Style="{StaticResource ReadonlyTextBox}"
                     TextAlignment="Center"
                     Text="00:00 AM"/>

                                    <TextBlock Grid.Column="8"
                       Text="الوقت"
                       Style="{StaticResource WhiteLabel}"
                       Margin="0,0,4,0"/>

                                    <!-- رقم الطلب -->
                                    <TextBox x:Name="txtOrderNo"
                     Grid.Column="9"
                     Style="{StaticResource ReadonlyTextBox}"
                     TextAlignment="Center"/>

                                    <TextBlock Grid.Column="11"
                       Text="رقم الطلب"
                       Style="{StaticResource WhiteLabel}"
                       Margin="0,0,4,0"/>

                                    <!-- رقم المرجع -->
                                    <TextBox x:Name="txtReffNo"
                     Grid.Column="12"
                     Style="{StaticResource ReadonlyTextBox}"
                     TextAlignment="Center"
                     IsReadOnly="True"
                     Visibility="Collapsed"/>

                                    <TextBlock Grid.Column="14"
                       Text="رقم المرجع"
                       Style="{StaticResource WhiteLabel}"
                       Margin="0,0,4,0"
                       Visibility="Collapsed"/>
                                </Grid>

                                <!-- الصف الثاني: العميل + الملخص -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- اسم العميل -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                           Text="الـعميـل"
                           Style="{StaticResource WhiteLabel}"
                           Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtClient"
                         Grid.Column="1"
                         Height="28"
                         FontSize="12" FontWeight="Bold"
                         Background="#404040"
                         Foreground="DodgerBlue"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"/>
                                        <!-- رصيد العميل - مخفي لكن موجود -->
                                        <TextBox x:Name="txtBalance"
                         Grid.Column="2"
                         Style="{StaticResource ReadonlyTextBox}"
                         TextAlignment="Center"
                         Width="100"
                         Margin="4,0,0,0"
                         Visibility="Collapsed"/>
                                    </Grid>

                                    <!-- ملخص المبالغ -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                                        <!-- المجموع -->
                                        <Border Background="#303030"
                        CornerRadius="6" Padding="8,4" Margin="2,0">
                                            <StackPanel>
                                                <TextBlock x:Name="Label7"
                                   Text="المجموع"
                                   Style="{StaticResource WhiteLabel}"/>
                                                <TextBox x:Name="txtTotRent"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="110" IsReadOnly="True" Text="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- الخصم -->
                                        <Border Background="#303030"
                        CornerRadius="6" Padding="8,4" Margin="2,0">
                                            <StackPanel>
                                                <TextBlock Text="الخصـم"
                                   Style="{StaticResource WhiteLabel}"/>
                                                <TextBox x:Name="txtDiscountVal"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="100" IsReadOnly="True" Text="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- الضريبة -->
                                        <Border Background="#303030"
                        CornerRadius="6" Padding="8,4" Margin="2,0">
                                            <StackPanel>
                                                <TextBlock x:Name="lblTaxValue"
                                   Text="ضريبة"
                                   Style="{StaticResource WhiteLabel}"/>
                                                <TextBox x:Name="txtTaxValue"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="100" Text="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- الإضافات -->
                                        <Border Background="#303030"
                        CornerRadius="6" Padding="8,4" Margin="2,0">
                                            <StackPanel>
                                                <TextBlock Text="الإضافات"
                                   Style="{StaticResource WhiteLabel}"/>
                                                <TextBox x:Name="txtAdditionVal"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="100" IsReadOnly="True" Text="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- الصافي -->
                                        <Border Background="#1A3A1A"
                        CornerRadius="6" Padding="8,4" Margin="2,0"
                        MinWidth="130">
                                            <StackPanel>
                                                <TextBlock Text="الصافي"
                                   Style="{StaticResource WhiteLabel}"/>
                                                <TextBlock x:Name="txtNet"
                                   Style="{StaticResource SummaryValue}"
                                   Text="0"
                                   FontSize="16"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- المدفوع / الباقي -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Border Background="#303030"
                        CornerRadius="6" Padding="8,4" Margin="2,0">
                                            <StackPanel>
                                                <TextBlock Text="المدفوع"
                                   Style="{StaticResource WhiteLabel}"/>
                                                <TextBox x:Name="txtrec1"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="100" Text="0"
                                 TextChanged="txtrec1_TextChanged"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#303030"
                        CornerRadius="6" Padding="8,4" Margin="2,0">
                                            <StackPanel>
                                                <TextBlock Text="الباقي"
                                   Style="{StaticResource WhiteLabel}"/>
                                                <TextBox x:Name="txtrecrem1"
                                 Style="{StaticResource DarkTextBox}"
                                 Width="100" Text="0" IsReadOnly="True"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- العناصر المخفية الضرورية للكود الخلفي -->
                                <StackPanel Visibility="Collapsed">
                                    <!-- txtTotPurch -->
                                    <TextBox x:Name="txtTotPurch" Text="0"/>
                                    <!-- txtTotQuant -->
                                    <TextBox x:Name="txtTotQuant" Text="0"/>
                                    <!-- txtMinusVal -->
                                    <TextBox x:Name="txtMinusVal" Text="0"
                     TextChanged="txtMinusVal_TextChanged"/>
                                    <!-- txtMinusPerc -->
                                    <TextBox x:Name="txtMinusPerc" Text="0"
                     TextChanged="txtMinusPerc_TextChanged"/>
                                </StackPanel>

                                <!-- تفاصيل المركب -->
                                <Border x:Name="PnDetails"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6"
                Margin="0,4,0,0"
                Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                           x:Name="Label14"
                           Text="تفاصيل المركب"
                           FontWeight="Bold" FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock x:Name="Label18" Text="رقم المركب:"
                               Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtMarineCode"
                             Style="{StaticResource ReadonlyTextBox}"
                             TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock x:Name="Label16" Text="اسم المركب:"
                               Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtMarineName"
                             Style="{StaticResource ReadonlyTextBox}"
                             TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock x:Name="Label17" Text="الرقم التسلسلي:"
                               Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtMarineID"
                             Style="{StaticResource ReadonlyTextBox}"
                             TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="4"
                            Margin="0,4,0,0">
                                            <TextBlock x:Name="Label19" Text="تفاصيل أخرى:"
                               Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtMarineDetails"
                             Style="{StaticResource ModernTextBox}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                        <!-- groupP: معرض المركبات -->
                        <Border Grid.Column="1"
                                Background="White"
                                FlowDirection="RightToLeft"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1,0,0,0"
                                Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- أزرار ضمن/خارج الخطة -->
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Grid.RowSpan="3">
                                    <Button x:Name="btnInPlan"
                                            Content="ضمن الخطة"
                                            Style="{StaticResource SaveBtn}"
                                            Width="70" Height="80"
                                            Margin="0,0,4,4"
                                            Click="btnInPlan_Click"/>
                                    <Button x:Name="btnOutPlan"
                                            Content="خارج الخطة"
                                            Style="{StaticResource DarkBtn}"
                                            Width="70" Height="80"
                                            Click="btnOutPlan_Click"/>
                                </StackPanel>

                                <!-- الصف الأول من المركبات -->
                                <Border x:Name="MarineCard_g1"
                                        Grid.Row="0" Grid.Column="1"
                                        Style="{StaticResource MarineCard}"
                                        MouseLeftButtonDown="MarineCard_Click" Tag="0">
                                    <StackPanel>
                                        <Image x:Name="g1" Style="{StaticResource MarineImg}"/>
                                        <TextBlock x:Name="gL1" Text="l1"
                                                   FontSize="10" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="MarineCard_g2"
                                        Grid.Row="0" Grid.Column="2"
                                        Style="{StaticResource MarineCard}"
                                        MouseLeftButtonDown="MarineCard_Click" Tag="1">
                                    <StackPanel>
                                        <Image x:Name="g2" Style="{StaticResource MarineImg}"/>
                                        <TextBlock x:Name="gL2" Text="l1"
