                        <!-- Panel10: لوحة الأرقام وأزرار التحكم -->
                        <Border Grid.Column="0"
                                Background="#404040"
                                Padding="4"
                                Width="230">
                            <StackPanel>
                                <!-- لوحة الأرقام GroupBox5 -->
                                <Border x:Name="GroupBox5"
                                        Background="#333"
                                        CornerRadius="8"
                                        Padding="4"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="72"/>
                                            <RowDefinition Height="2"/>
                                            <RowDefinition Height="72"/>
                                            <RowDefinition Height="2"/>
                                            <RowDefinition Height="72"/>
                                            <RowDefinition Height="2"/>
                                            <RowDefinition Height="72"/>
                                        </Grid.RowDefinitions>

                                        <Button x:Name="cmd7"  Grid.Row="0" Grid.Column="0"
                                                Content="7" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="7"/>
                                        <Button x:Name="cmd8"  Grid.Row="0" Grid.Column="2"
                                                Content="8" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="8"/>
                                        <Button x:Name="cmd9"  Grid.Row="0" Grid.Column="4"
                                                Content="9" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="9"/>

                                        <Button x:Name="cmd4"  Grid.Row="2" Grid.Column="0"
                                                Content="4" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="4"/>
                                        <Button x:Name="cmd5"  Grid.Row="2" Grid.Column="2"
                                                Content="5" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="5"/>
                                        <Button x:Name="cmd6"  Grid.Row="2" Grid.Column="4"
                                                Content="6" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="6"/>

                                        <Button x:Name="cmd135" Grid.Row="4" Grid.Column="0"
                                                Content="1" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="1"/>
                                        <Button x:Name="cmd2"  Grid.Row="4" Grid.Column="2"
                                                Content="2" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="2"/>
                                        <Button x:Name="cmd3"  Grid.Row="4" Grid.Column="4"
                                                Content="3" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="3"/>

                                        <Button x:Name="cmdClearAll" Grid.Row="6" Grid.Column="0"
                                                Content="C"
                                                Style="{StaticResource DangerBtn}"
                                                Width="70" Height="70"
                                                Click="cmdClearAll_Click"/>
                                        <Button x:Name="cmd0"  Grid.Row="6" Grid.Column="2"
                                                Content="0" Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="0"/>
                                        <Button x:Name="Button1" Grid.Row="6" Grid.Column="4"
                                                Content="."
                                                Style="{StaticResource NumBtn}"
                                                Click="NumPad_Click" Tag="."/>
                                    </Grid>
                                </Border>

                                <!-- أزرار: المادة / الكمية / السعر -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="btnAddItem"
                                            Content="المادة F1"
                                            Style="{StaticResource DarkBtn}"
                                            Width="72" Height="70"
                                            Margin="0,0,2,0"
                                            Click="btnAddItem_Click"/>
                                    <Button x:Name="btnQuantity"
                                            Content="الكمية F2"
                                            Style="{StaticResource DarkBtn}"
                                            Width="72" Height="70"
                                            Margin="0,0,2,0"
                                            Click="btnQuantity_Click"/>
                                    <Button x:Name="btnPrice"
                                            Content="السعر F3"
                                            Style="{StaticResource DarkBtn}"
                                            Width="72" Height="70"
                                            Click="btnPrice_Click"/>
                                </StackPanel>

                                <!-- حفظ -->
                                <Button x:Name="btnSave"
                                        Content="💾 حفظ F6"
                                        Style="{StaticResource SaveBtn}"
                                        Height="70"
                                        Margin="0,0,0,4"
                                        Click="btnSave_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Panel4: جدول الخدمات + أزرار أسفل -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- dgvItems: جدول الخدمات -->
                            <Border Grid.Row="0"
                                    Background="White"
                                    Margin="4,4,4,0"
                                    CornerRadius="8"
                                    Effect="{StaticResource CardShadow}">
                                <DataGrid x:Name="dgvItems"
                                          AutoGenerateColumns="False"
                                          ColumnHeaderStyle="{StaticResource GreenColHeader}"
                                          RowStyle="{StaticResource DgvRow}"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          FlowDirection="RightToLeft"
                                          Background="White"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E8EBF5"
                                          AlternatingRowBackground="#F0FFF0"
                                          SelectionChanged="dgvItems_SelectionChanged"
                                          MouseDoubleClick="dgvItems_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <!-- رقم الفاتورة (مخفي) -->
                                        <DataGridTextColumn x:Name="DataGridViewTextBoxColumn3"
                                                            Header="رقم الفاتورة"
                                                            Binding="{Binding InvNo}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- نوع العملية (مخفي) -->
                                        <DataGridTextColumn x:Name="Column20"
                                                            Header="نوع العملية"
                                                            Binding="{Binding ProcType}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- الخدمة -->
                                        <DataGridTextColumn x:Name="Column4"
                                                            Header="الخدمة"
                                                            Binding="{Binding ServiceName}"
                                                            Width="*" MinWidth="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <!-- كود المركب (مخفي) -->
                                        <DataGridTextColumn x:Name="Column8"
                                                            Header="كود المركب"
                                                            Binding="{Binding MarineCode}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- المدة -->
                                        <DataGridTextColumn x:Name="Column12"
                                                            Header="المدة"
                                                            Binding="{Binding Duration}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <!-- الكمية (مخفي) -->
                                        <DataGridTextColumn x:Name="Column9"
                                                            Header="الكمية"
                                                            Binding="{Binding Quantity}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- الكمية الإجمالية (مخفي) -->
                                        <DataGridTextColumn x:Name="Column5"
                                                            Header="الكمية الإجمالية"
                                                            Binding="{Binding TotalQuantity}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- نسبة الوحدة (مخفي) -->
                                        <DataGridTextColumn x:Name="Column13"
                                                            Header="نسبة الوحدة"
                                                            Binding="{Binding UnitRatio}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- السعر (مخفي) -->
                                        <DataGridTextColumn x:Name="Column6"
                                                            Header="السعر"
                                                            Binding="{Binding Price, StringFormat=N2}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- الإجمالي -->
                                        <DataGridTextColumn x:Name="ColtotWithoutTax1"
                                                            Header="الإجمالي"
                                                            Binding="{Binding Total, StringFormat=N2}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <!-- رقم المركب (مخفي) -->
                                        <DataGridTextColumn x:Name="Column2"
                                                            Header="رقم المركب"
                                                            Binding="{Binding MarineNo}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- تاريخ انتهاء الصلاحية (مخفي) -->
                                        <DataGridTextColumn x:Name="Column7"
                                                            Header="تاريخ انتهاء الصلاحية"
                                                            Binding="{Binding ExpireDate, StringFormat=d}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- حذف -->
                                        <DataGridTemplateColumn x:Name="Column11"
                                                                Header="حذف"
                                                                Width="0"
                                                                Visibility="Collapsed">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️ حذف"
                                                            Style="{StaticResource DangerBtn}"
                                                            Height="24"
                                                            Tag="{Binding}"
                                                            Click="DeleteRowBtn_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- ملاحظات (مخفي) -->
                                        <DataGridTextColumn x:Name="notes"
                                                            Header="ملاحظات"
                                                            Binding="{Binding Notes}"
                                                            Width="0" Visibility="Collapsed"/>
                                        <!-- الضريبة (مخفي) -->
                                        <DataGridTextColumn x:Name="Column29"
                                                            Header="الضريبة"
                                                            Binding="{Binding TaxValue}"
                                                            Width="0" Visibility="Collapsed"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Panel5: أزرار العمليات الرئيسية -->
                            <Border Grid.Row="1"
                                    Background="#404040"
                                    FlowDirection="RightToLeft"
                                    Padding="4,4">
                                <WrapPanel>
                                    <!-- الصف الأول -->
                                    <Button x:Name="btnAddbook"
                                            Content="📚 حجوزات"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnAddbook_Click"/>
                                    <Button x:Name="btnExpection"
                                            Content="⚡ استثناء F10"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnExpection_Click"/>
                                    <Button x:Name="btnPay"
                                            Content="💰 ادفع الآن F6"
                                            Style="{StaticResource SaveBtn}"
                                            Width="320" Height="70"
                                            Margin="2"
                                            FontSize="18"
                                            Click="btnPay_Click"/>
                                    <Button x:Name="RetSales"
                                            Content="↩️ مرتجع F11"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="RetSales_Click"/>
                                    <!-- cmbSalesMen - مخفي لكن ضروري للكود الخلفي -->
                                    <ComboBox x:Name="cmbSalesMen"
          Visibility="Collapsed"
          IsEditable="True"
          Height="28"/>
                                    <Button x:Name="btnHoldOrd"
                                            Content="⏸️ تعليق F7"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            IsEnabled="False"
                                            Click="btnHoldOrd_Click"/>

                                    <!-- الصف الثاني -->
                                    <Button x:Name="btnCloseDay"
                                            Content="🔒 إغلاق F9"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnCloseDay_Click"/>
                                    <Button x:Name="btnAddUnit"
                                            Content="⏱️ المدة F4"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnAddUnit_Click"/>
                                    <Button x:Name="btnDeleteRow"
                                            Content="🗑️ استبعاد F5"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnDeleteRow_Click"/>
                                    <Button x:Name="btnNew"
                                            Content="➕ جديد F12"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnNew_Click"/>
                                    <Button x:Name="btnPrint"
                                            Content="🖨️ طباعة F10"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnPrint_Click"/>
                                    <Button x:Name="btnReplace"
                                            Content="🔄 استبدال F8"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnReplace_Click"/>
                                    <Button x:Name="btnsrch"
                                            Content="🔍"
                                            Style="{StaticResource DarkBtn}"
                                            Width="105" Height="70"
                                            FontSize="36"
                                            Margin="2"
                                            Click="btnsrch_Click"/>
                                    <Button x:Name="btnClose"
                                            Content="✖ خروج"
                                            Style="{StaticResource DangerBtn}"
                                            Width="105" Height="70"
                                            Margin="2"
                                            Click="btnClose_Click"/>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════
                 TabPage2 - البحث
            ════════════════════════════════════════════ -->
            <TabItem x:Name="TabPage2" Header="    🔍 البحث    ">
                <Grid Background="#F5F5F5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- GroupBox6: فلاتر البحث -->
                    <Border Grid.Row="0"
                            Background="LightSteelBlue"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="6,6,6,4"
                            Padding="10,8"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <!-- عنوان -->
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                <TextBlock Text="🔍 البحث عن الفواتير"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- صف 1: نوع العملية، رقم الفاتورة، المستخدم -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <!-- زر بحث -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label10" Grid.Column="0"
                                           Text="نوع العملية"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbProcTypeSrch"
                                          Grid.Column="2"
                                          Height="28" FontSize="11">
                                    <ComboBoxItem Content="فاتورة تأجير"/>
                                    <ComboBoxItem Content="مرتجع فاتورة"/>
                                    <ComboBoxItem Content="فواتير معلقة"/>
                                    <ComboBoxItem Content="حجوزات"/>
                                </ComboBox>

                                <TextBlock x:Name="Label11" Grid.Column="4"
                                           Text="رقم الفاتورة"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSrchNo"
                                         Grid.Column="6"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label21" Grid.Column="8"
                                           Text="المستخدم"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbUsers"
                                          Grid.Column="10"
                                          Height="28" FontSize="11"
                                          IsEditable="True"/>

                                <Button x:Name="btnSearch"
                                        Grid.Column="12"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="100" Height="34"
                                        Click="btnSearch_Click"/>
                            </Grid>

                            <!-- صف 2: من تاريخ، الى تاريخ، اسم العميل، جوال -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label1" Grid.Column="0"
                                           Text="من تاريخ"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtFromDate"
                                              Grid.Column="2"
                                              Height="28" FontSize="11"/>

                                <TextBlock x:Name="Label2" Grid.Column="4"
                                           Text="إلى تاريخ"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtToDate"
                                              Grid.Column="6"
                                              Height="28" FontSize="11"/>

                                <TextBlock x:Name="Label5" Grid.Column="8"
                                           Text="اسم العميل"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtClientName"
                                         Grid.Column="10"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label20" Grid.Column="12"
                                           Text="رقم الجوال"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCustPhone"
                                         Grid.Column="14"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GroupBox4: نتائج البحث -->
                    <Border Grid.Row="1"
                            Background="LightSteelBlue"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="6,0,6,6"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="12,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource SrchDgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseDoubleClick="dgvSrch_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <!-- رقم الحركة (مخفي) -->
                                    <DataGridTextColumn x:Name="Column10"
                                                        Header="رقم الحركة"
                                                        Binding="{Binding ProcId}"
                                                        Width="0" Visibility="Collapsed"/>
                                    <!-- الرقم -->
                                    <DataGridTextColumn x:Name="DataGridViewTextBoxColumn1"
                                                        Header="الرقم"
                                                        Binding="{Binding InvId}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- التاريخ -->
                                    <DataGridTextColumn x:Name="Column3"
                                                        Header="التاريخ"
                                                        Binding="{Binding InvDate}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
