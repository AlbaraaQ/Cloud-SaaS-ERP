<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmNewProjectPM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="بطاقة مشروع"
    Width="1000"
    Height="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmNewProjectPM_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F7CF7" Offset="0"/>
            <GradientStop Color="#305EDB" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.13" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F0F4FF"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8FFCC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0FFF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Window Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="14,10">
            <TextBlock Text="🏗️ بطاقة مشروع" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Top Info Row -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="12,6" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Label14" Grid.Column="0" Text="رقم المشروع" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                <TextBox x:Name="txtNo" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>

                <TextBlock x:Name="Label13" Grid.Column="3" Text="📅 التاريخ" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                <DatePicker x:Name="txtDate" Grid.Column="4" Style="{StaticResource ModernDatePicker}" SelectedDateFormat="Short"/>

                <TextBlock x:Name="Label1" Grid.Column="6" Text="الوقت" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" Visibility="Collapsed"/>
                <DatePicker x:Name="DateTimePicker1" Grid.Column="7" Style="{StaticResource ModernDatePicker}" SelectedDateFormat="Short" Visibility="Collapsed"/>

                <TextBlock x:Name="Label5" Grid.Column="9" Text="البند" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                <TextBox x:Name="TextBox4" Grid.Column="10" Style="{StaticResource ReadOnlyBox}"/>

            </Grid>
        </Border>

        <!-- Navigation Buttons -->
        <Border Grid.Row="2" Background="{StaticResource FooterBrush}" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnClose" Content="✖" Style="{StaticResource DangerBtn}" Width="40" Margin="0,0,4,0" ToolTip="خروج" Click="btnClose_Click"/>
                <Button x:Name="btnFirst" Content="⏮" Style="{StaticResource NavBtn}" Margin="0,0,4,0" ToolTip="الأول" Click="btnFirst_Click"/>
                <Button x:Name="btnPrevious" Content="◀" Style="{StaticResource NavBtn}" Margin="0,0,4,0" ToolTip="السابق" Click="btnPrevious_Click"/>
                <Button x:Name="btnNext" Content="▶" Style="{StaticResource NavBtn}" Margin="0,0,4,0" ToolTip="التالي" Click="btnNext_Click"/>
                <Button x:Name="btnLast" Content="⏭" Style="{StaticResource NavBtn}" Margin="0,0,8,0" ToolTip="الأخير" Click="btnLast_Click"/>
                <Button x:Name="btnDelete" Content="🗑️" Style="{StaticResource DangerBtn}" Width="40" Margin="0,0,4,0" ToolTip="حذف" Click="btnDelete_Click"/>
                <Button x:Name="btnPrint" Content="🖨️" Style="{StaticResource ActionBtn}" Width="40" Margin="0,0,4,0" ToolTip="طباعة" Click="btnPrint_Click"/>
                <Button x:Name="btnSave" Content="💾" Style="{StaticResource SaveBtn}" Width="40" Margin="0,0,4,0" ToolTip="حفظ" Click="btnSave_Click"/>
                <Button x:Name="btnNew" Content="➕" Style="{StaticResource ActionBtn}" Width="40" Margin="0,0,0,0" ToolTip="جديد" Click="btnNew_Click"/>
            </StackPanel>
        </Border>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1" Grid.Row="3" Background="White">

            <!-- ═══ تاب بيانات المشروع ═══ -->
            <TabItem Header="📋 بيانات المشروع">
                <Grid Background="#F5F7FA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- صورة المشروع -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0" Padding="10">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Background="#F8FAFD" Height="150" Margin="0,0,0,8">
                                <Image x:Name="PictureBox1" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock x:Name="lnkImgAdd" Text="📁 رفع صورة" Foreground="#3A63C3" FontWeight="Bold" Cursor="Hand" TextDecorations="Underline" Margin="0,0,14,0" MouseLeftButtonDown="lnkImgAdd_Click"/>
                                <TextBlock x:Name="lnkImgClr" Text="🗑️ حذف" Foreground="#E35656" FontWeight="Bold" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="lnkImgClr_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- حقول البيانات -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- اسم المشروع -->
                            <TextBlock x:Name="Label2" Grid.Row="0" Grid.Column="0" Text="🏗️ اسم المشروع" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TextBox1" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource ReadOnlyBox}"/>

                            <!-- تاريخ البدء -->
                            <TextBlock x:Name="Label9" Grid.Row="2" Grid.Column="0" Text="📅 تاريخ البدء" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="txtStartDate" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernDatePicker}" SelectedDateFormat="Short"/>

                            <TextBlock x:Name="Label10" Grid.Row="2" Grid.Column="3" Text="📅 تاريخ الانتهاء" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="txtEndDate" Grid.Row="2" Grid.Column="4" Style="{StaticResource ModernDatePicker}" SelectedDateFormat="Short"/>

                            <!-- نوع المشروع -->
                            <TextBlock x:Name="Label8" Grid.Row="4" Grid.Column="0" Text="🏷️ نوع المشروع" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="comProjectType" Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernComboBox}"/>

                            <TextBlock x:Name="Label12" Grid.Row="4" Grid.Column="3" Text="⚙️ الحالة" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ComboBox1" Grid.Row="4" Grid.Column="4" Style="{StaticResource ModernComboBox}"/>

                            <!-- الموقع -->
                            <TextBlock x:Name="Label4" Grid.Row="6" Grid.Column="0" Text="📍 الموقع" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtLocation" Grid.Row="6" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>

                            <TextBlock x:Name="Label16" Grid.Row="6" Grid.Column="3" Text="🌍 البلد" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbCountry" Grid.Row="6" Grid.Column="4" Style="{StaticResource ModernComboBox}"/>

                            <!-- المقاول -->
                            <TextBlock x:Name="lblClient" Grid.Row="8" Grid.Column="0" Text="👷 المقاول" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbClient" Grid.Row="8" Grid.Column="1" Style="{StaticResource ModernComboBox}"/>

                            <!-- مدة التنفيذ -->
                            <TextBlock x:Name="Label11" Grid.Row="10" Grid.Column="0" Text="⏱️ مدة التنفيذ" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TextBox2" Grid.Row="10" Grid.Column="1" Style="{StaticResource ReadOnlyBox}"/>

                            <!-- تكلفة المشروع -->
                            <TextBlock x:Name="Label3" Grid.Row="12" Grid.Column="0" Text="💰 تكلفة المشروع" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Row="12" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TextBox3" Grid.Column="0" Style="{StaticResource ReadOnlyBox}"/>
                                <Button x:Name="Button2" Grid.Column="2" Content="🔍" Style="{StaticResource ActionBtn}" Width="36" Height="30" FontSize="14" Click="Button2_Click"/>
                            </Grid>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══ تاب البحث ═══ -->
            <TabItem Header="🔍 البحث">
                <Grid Background="#F5F7FA">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- DataGrid -->
                    <Border Grid.Column="0" Margin="6,6,4,6" Background="White" CornerRadius="10" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <DataGrid x:Name="dgvItems"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      RowStyle="{StaticResource SearchGridRowStyle}"
                                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                      AlternatingRowBackground="#F5FFF5"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E7ECF5"
                                      Background="White"
                                      MouseDoubleClick="dgvItems_MouseDoubleClick">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم البند" Binding="{Binding DataGridViewTextBoxColumn3}" Width="80" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="رقم المشروع" Binding="{Binding Column20}" Width="110" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="اسم المشروع" Binding="{Binding Column4}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding Column13}" Width="90" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="التكلفة" Binding="{Binding Column6}" Width="90" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="المجموع" Binding="{Binding Column8}" Width="90" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="الضريبة" Binding="{Binding Column14}" Width="80" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="الصافي" Binding="{Binding Column17}" Width="80" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding ItemStock}" Width="90" ElementStyle="{StaticResource GridCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Search Panel -->
                    <Border Grid.Column="1" Margin="4,6,6,6" Background="#3A3A3A" CornerRadius="10" Padding="12" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="🔍 البحث" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                            <TextBlock x:Name="Label17" Text="رقم المشروع" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtSrchNo" Height="30" FontSize="13" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>

                            <TextBlock x:Name="Label19" Text="من تاريخ" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker x:Name="txtFromDate" Style="{StaticResource ModernDatePicker}" SelectedDateFormat="Short" Margin="0,0,0,10"/>

                            <TextBlock x:Name="Label6" Text="إلى تاريخ" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker x:Name="txtToDate" Style="{StaticResource ModernDatePicker}" SelectedDateFormat="Short" Margin="0,0,0,10"/>

                            <TextBlock x:Name="lblClientSrch" Text="المقاول" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbClientSrch" Grid.Column="0" Style="{StaticResource ModernComboBox}" IsEnabled="False"/>
                                <CheckBox x:Name="chkAll" Grid.Column="1" Content="الكل" IsChecked="True" Style="{StaticResource ModernCheckBox}" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0" Checked="chkAll_CheckedChanged" Unchecked="chkAll_CheckedChanged"/>
                            </Grid>

                            <Button x:Name="btnSearch" Content="🔍 بحث" Style="{StaticResource ActionBtn}" Height="42" FontSize="14" Click="btnSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</dx:ThemedWindow>