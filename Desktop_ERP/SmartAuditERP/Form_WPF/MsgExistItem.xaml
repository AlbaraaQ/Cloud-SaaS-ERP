<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.MsgExistItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="الصنف موجود"
    Width="530" Height="230"
    WindowStartupLocation="CenterOwner"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    WindowStyle="None"
    ResizeMode="NoResize"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="3"
                          Direction="270" Opacity="0.25"
                          Color="#000000"/>
    </dx:ThemedWindow.Resources>

    <Border Background="White"
            CornerRadius="14"
            Effect="{StaticResource CardShadow}"
            Margin="6">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Icon + Message -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                <TextBlock Text="⚠️"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="lbltext"
                           Text="الصنف مدرج سابقاً !"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#1B2642"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Divider -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="#E8EBF5"
                    Margin="0,0,0,16"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- إضافة الكمية -->
                <Button x:Name="btnAddquantity"
                        Content="➕ إضافة الكمية"
                        Height="40" Width="130"
                        Margin="0,0,8,0"
                        Foreground="White"
                        FontSize="12" FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnAddquantity_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#76B496"/>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- إدراج في بند جديد -->
                <Button x:Name="btnNewTirm"
                        Content="📄 إدراج في بند جديد"
                        Height="40" Width="150"
                        Margin="0,0,8,0"
                        Foreground="White"
                        FontSize="12" FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnNewTirm_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5B9BD5"/>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- عدم إدراج -->
                <Button x:Name="btnNon"
                        Content="🚫 عدم إدراج"
                        Height="40" Width="130"
                        Foreground="White"
                        FontSize="12" FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnNon_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#A0522D"/>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="10,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</dx:ThemedWindow>