<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmMeasurements"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="إدارة قياسات العملاء"
    Width="700"
    Height="590"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmMeasurements_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F7CF7" Offset="0"/>
            <GradientStop Color="#305EDB" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="SoftText" Color="#9AA8C0"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.13"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10">
            <TextBlock Text="📏 إدارة قياسات العملاء"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Search Panel -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="12,10"
                Effect="{StaticResource CardShadow}">
            <StackPanel>

                <!-- Search Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="lblSearch"
                               Grid.Column="0"
                               Text="البحث برقم الجوال أو الاسم:"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#1B2642"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                    <Grid Grid.Column="2" Width="260" Height="34">
                        <TextBox x:Name="txtSearch"
                                 Height="34"
                                 FontSize="12"
                                 Background="White"
                                 BorderBrush="#AFC2F2"
                                 BorderThickness="1"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="txtSearch_KeyDown"
                                 GotFocus="txtSearch_GotFocus"
                                 LostFocus="txtSearch_LostFocus"
                                 TextChanged="txtSearch_TextChanged"/>
                        <TextBlock x:Name="txtSearchWatermark"
                                   Text="🔍 الجوال أو الاسم..."
                                   Foreground="{StaticResource SoftText}"
                                   FontSize="12"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Button x:Name="btnSearch"
                            Grid.Column="4"
                            Content="🔍 بحث"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            Height="34"
                            Click="btnSearch_Click"/>
                </Grid>

                <!-- Customer Info Row -->
                <Border x:Name="pnlCustomerInfo"
                        Background="#F0F4FF"
                        CornerRadius="8"
                        Padding="10,8"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 "
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblCustomerName"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#1B2642"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>
                        <TextBlock Text="📞 "
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblCustomerPhone"
                                   FontSize="13"
                                   Foreground="#1B2642"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Measurements Grid -->
        <Border Grid.Row="2"
                Margin="8,6,8,4"
                Background="White"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="📋 قياسات العميل"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <DataGrid x:Name="gridMeasurements"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowStyle="{StaticResource GridRowStyle}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          AlternatingRowBackground="#F8F9FD"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E7ECF5"
                          Background="White"
                          MouseDoubleClick="gridViewMeasurements_DoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="الرقم"
                                            Binding="{Binding MeasurementID}"
                                            Width="70"
                                            Visibility="Collapsed"/>

                        <DataGridTextColumn Header="👤 اسم صاحب القياس"
                                            Binding="{Binding MeasurementName}"
                                            Width="*"
                                            ElementStyle="{StaticResource GridCellText}"/>

                        <DataGridTextColumn Header="📅 التاريخ"
                                            Binding="{Binding MeasurementDate}"
                                            Width="110"
                                            ElementStyle="{StaticResource GridCellText}"/>

                        <DataGridTextColumn Header="📝 الملاحظات"
                                            Binding="{Binding Notes}"
                                            Width="180"
                                            ElementStyle="{StaticResource GridCellText}"/>

                        <DataGridTextColumn Header="📐 عدد المقاسات"
                                            Binding="{Binding MeasurementCount}"
                                            Width="100"
                                            ElementStyle="{StaticResource GridCellText}"/>

                        <DataGridTextColumn Header="العميل"
                                            Binding="{Binding CustomerName}"
                                            Width="120"
                                            ElementStyle="{StaticResource GridCellText}"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{StaticResource FooterBrush}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button x:Name="btnAddMeasurement"
                            Content="➕ إضافة قياس جديد"
                            Style="{StaticResource SaveBtn}"
                            Width="140"
                            Click="btnAddMeasurement_Click"/>

                    <Button x:Name="btnEditMeasurement"
                            Content="✏️ تعديل القياس"
                            Style="{StaticResource ActionBtn}"
                            Width="120"
                            Click="btnEditMeasurement_Click"/>

                    <Button x:Name="btnDeleteMeasurement"
                            Content="🗑️ حذف القياس"
                            Style="{StaticResource DangerBtn}"
                            Width="120"
                            Click="btnDeleteMeasurement_Click"/>
                </StackPanel>

                <Button x:Name="btnClose"
                        Grid.Column="1"
                        Content="✖ إغلاق"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Click="btnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>