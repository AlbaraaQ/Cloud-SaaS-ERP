<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmReceiptsSyncStatus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="مزامنة السندات"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExcelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27AE60" Offset="0"/>
            <GradientStop Color="#1E8449" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SyncBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8E44AD" Offset="0"/>
            <GradientStop Color="#6C3483" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.13" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="5" ShadowDepth="1"
                          Direction="270" Opacity="0.17" Color="#000000"/>

        <!-- FieldLabel -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ModernComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ActionBtn -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="ExcelBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExcelBrush}"/>
        </Style>
        <Style x:Key="SyncBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SyncBrush}"/>
        </Style>
        <Style x:Key="ShowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- الجدول الرئيسي -->
            <ColumnDefinition Width="*"/>
            <!-- لوحة خيارات البحث -->
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!--           منطقة الجدول الرئيسية               -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- جدول السندات -->
            <Border Grid.Row="0"
                    Background="White"
                    Margin="6,6,3,4"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- عنوان الجدول -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="🧾 السندات"
                                   Foreground="White"
                                   FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="GridControl1"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              LoadingRow="GridControl1_LoadingRow">
                        <DataGrid.Columns>

                            <!-- CheckBox للتحديد -->
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="chkSelectAll"
                                                  HorizontalAlignment="Center"
                                                  Click="SelectAll_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="م"
                                                Binding="{Binding DgvNo}"
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding DgvGlobalID}"
                                                Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الفرع"
                                                Binding="{Binding DgvReceiptBranch}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="نوع السند"
                                                Binding="{Binding DgvType}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="رقم السند"
                                                Binding="{Binding DgvReceiptNo}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="رقم المرجع"
                                                Binding="{Binding DgvRefNo}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="التاريخ"
                                                Binding="{Binding DgvDate, StringFormat=d}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="المستخدم"
                                                Binding="{Binding DgvUser}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="قيمة السند"
                                                Binding="{Binding DgvSum, StringFormat=N2}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="حالة المزامنة"
                                                Binding="{Binding DgvSyncStatusText}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="محذوف"
                                                Binding="{Binding DgvISDeletedText}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- زر تفاصيل -->
                            <DataGridTemplateColumn Header="تفاصيل" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="👁️ عرض"
                                                Tag="{Binding DgvGlobalID}"
                                                FontSize="10"
                                                Height="22"
                                                Background="{StaticResource HeaderBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="2"
                                                Click="BtnDetails_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- شريط المجاميع -->
            <Border Grid.Row="1"
                    Background="White"
                    Margin="6,0,3,4"
                    CornerRadius="8"
                    Effect="{StaticResource CardShadow}"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="إجمالي السندات:"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#1B2642"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="lblTotal"
                               Text="0"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#2E4E9E"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

                    <TextBlock Text="عدد السجلات:"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#1B2642"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="lblCount"
                               Text="0"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#2E4E9E"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- شريط الأدوات السفلي -->
            <Border Grid.Row="2"
                    Background="{StaticResource FooterBrush}"
                    Margin="6,0,3,6"
                    CornerRadius="8"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="90"
                            Margin="0,0,8,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="100"
                            Margin="0,0,8,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="100"
                            Margin="0,0,8,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnExportExcel"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExcelBtn}"
                            Width="120"
                            Click="btnExportExcel_Click"/>
                </StackPanel>
            </Border>

            <!-- ProgressBar -->
            <ProgressBar x:Name="ProgressBar1"
                         Grid.Row="2"
                         Height="6"
                         Margin="6,0,3,0"
                         VerticalAlignment="Bottom"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="#2E4E9E"
                         Background="#E8EBF5"/>
        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!--           لوحة خيارات البحث (يسار)            -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="White"
                Margin="3,6,6,6"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- عنوان -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="🔍 خيارات البحث"
                               Foreground="White"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- الخيارات -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              FlowDirection="RightToLeft"
                              Padding="12,10">
                    <StackPanel>

                        <!-- ─────────────────────────── -->
                        <!-- فرع السند                   -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🏢 فرع السند:"
                                           Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="CheckBox1"
                                          Content="الكل"
                                          IsChecked="True"
                                          FontWeight="Bold"
                                          Margin="0,4,0,4"
                                          Checked="CheckBox1_Changed"
                                          Unchecked="CheckBox1_Changed"/>
                                <ComboBox x:Name="cmbBranches"
                                          Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- حالة المزامنة               -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🔄 حالة المزامنة:"
                                           Style="{StaticResource FieldLabel}"/>
                                <RadioButton x:Name="rbAllSync"
                                             Content="الكل"
                                             IsChecked="True"
                                             FontWeight="Bold"
                                             Margin="0,4,0,2"/>
                                <RadioButton x:Name="rbSynced"
                                             Content="مزامنة"
                                             FontWeight="Bold"
                                             Margin="0,0,0,2"/>
                                <RadioButton x:Name="rbNotSynced"
                                             Content="غير متزامنة"
                                             FontWeight="Bold"
                                             Margin="0,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- نوع السند                   -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📄 نوع السند:"
                                           Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="ckAllInvs"
                                          Content="الكل"
                                          IsChecked="True"
                                          FontWeight="Bold"
                                          Margin="0,4,0,4"
                                          Checked="ckAllInvs_Changed"
                                          Unchecked="ckAllInvs_Changed"/>
                                <ComboBox x:Name="cmbReceiptType"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="سند قبض من عميل"/>
                                    <ComboBoxItem Content="سند صرف لمورد"/>
                                    <ComboBoxItem Content="سند قبض"/>
                                    <ComboBoxItem Content="سند صرف"/>
                                    <ComboBoxItem Content="سند صرف ضريبة"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- نوع الدفع                   -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="💳 نوع الدفع:"
                                           Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="ckAllType"
                                          Content="الكل"
                                          IsChecked="True"
                                          FontWeight="Bold"
                                          Margin="0,4,0,4"
                                          Checked="ckAllType_Changed"
                                          Unchecked="ckAllType_Changed"/>
                                <ComboBox x:Name="cmbType"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="نقدي"/>
                                    <ComboBoxItem Content="بنكي"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- المستخدم                    -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="👤 المستخدم:"
                                           Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="ckAllUsers"
                                          Content="الكل"
                                          IsChecked="True"
                                          FontWeight="Bold"
                                          Margin="0,4,0,4"
                                          Checked="ckAllUsers_Changed"
                                          Unchecked="ckAllUsers_Changed"/>
                                <ComboBox x:Name="cmbusers"
                                          Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- الفترة الزمنية              -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📅 الفترة:"
                                           Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="ckTotalPeriod"
                                          Content="كل الفترة"
                                          IsChecked="True"
                                          FontWeight="Bold"
                                          Margin="0,4,0,6"
                                          Checked="ckTotalPeriod_Changed"
                                          Unchecked="ckTotalPeriod_Changed"/>

                                <TextBlock Text="من:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtFromDate"
                                              Height="28"
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              IsEnabled="False"
                                              Margin="0,0,0,6"/>

                                <TextBlock Text="إلى:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtToDate"
                                              Height="28"
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- المحذوفات                   -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <CheckBox x:Name="ckDeleted"
                                      Content="🗑️ عرض المحذوفات"
                                      FontWeight="Bold"
                                      Foreground="#E35656"/>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- إرسال إلى                   -->
                        <!-- ─────────────────────────── -->
                        <Border Background="#F8F9FD"
                                CornerRadius="7" Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="📤 إرسال إلى:"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbMainBranch"
                                          Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"/>
                            </StackPanel>
                        </Border>

                        <!-- ─────────────────────────── -->
                        <!-- أزرار العرض والمزامنة        -->
                        <!-- ─────────────────────────── -->
                        <Button x:Name="btnShow"
                                Content="🔍 عرض"
                                Style="{StaticResource ShowBtn}"
                                Margin="0,0,0,8"
                                Click="btnShow_Click"/>

                        <Button x:Name="btnSync"
                                Content="🔄 مزامنة السندات المحددة"
                                Style="{StaticResource SyncBtn}"
                                Height="36"
                                Click="btnSync_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>