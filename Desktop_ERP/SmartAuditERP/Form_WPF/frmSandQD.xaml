<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSandQD"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="سندات قبض"
    Width="800" Height="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3FA8D5" Offset="0"/>
            <GradientStop Color="#1E7AA8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B5EA7" Offset="0"/>
            <GradientStop Color="#4D3278" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Styles ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxMulti" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>
        <Style x:Key="PurpleBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- ✅ StatusBar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TabControl ═══ -->
        <TabControl x:Name="TabControl1" Grid.Row="0"
                    Margin="4,4,4,2"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="11" FontWeight="Bold">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="14,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                </Style>
            </TabControl.Resources>

            <!-- ══════════════════════════════════ -->
            <!--      TabPage1: سندات قبض           -->
            <!-- ══════════════════════════════════ -->
            <TabItem Header="📄 سندات قبض">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Background="#F3F5F9">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ─── بيانات السند ─── -->
                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="10,8" Margin="4,4,4,3"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource HeaderBrush}"
                                        CornerRadius="7" Padding="10,4"
                                        Margin="0,0,0,7">
                                    <TextBlock Text="📄 بيانات السند"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="🔢 رقم السند"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtNo"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="📅 التاريخ"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <dxe:DateEdit x:Name="txtDate"
                                                      Height="27" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="⏰ الوقت"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtTime"
                                                 Style="{StaticResource ModernTextBox}"
                                                 GotFocus="txtTime_GotFocus"
                                                 LostFocus="txtTime_LostFocus"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="6">
                                        <TextBlock Text="🏢 الفرع"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbBranches"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEnabled="False"/>
                                    </StackPanel>

                                    <!-- Row 2: حساب + قيمة + رصيد -->
                                    <Grid Grid.Row="2" Grid.Column="0"
                                          Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🏦 دفعة من حساب"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbAccounts"
                                                      Style="{StaticResource ModernComboBox}"
                                                      IsEditable="True"
                                                      SelectionChanged="cmbAccounts_SelectionChanged"
                                                      KeyDown="cmbAccounts_KeyDown"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                x:Name="IconButton1"
                                                Content="🔍"
                                                Style="{StaticResource ActionBtn}"
                                                Width="26" Height="24"
                                                FontSize="11" Padding="0"
                                                VerticalAlignment="Bottom"
                                                ToolTip="بحث عن حساب"
                                                Click="IconButton1_Click"/>
                                    </Grid>

                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="💰 قيمة السند"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtVal"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextChanged="txtVal_TextChanged"
                                                 GotFocus="txtVal_GotFocus"/>
                                    </StackPanel>

                                    <Grid Grid.Row="2" Grid.Column="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📊 الرصيد"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtBalance"
                                                     Style="{StaticResource ModernTextBox}"
                                                     IsReadOnly="True"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   x:Name="txtBalanceType"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#1B2642"
                                                   VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>
                                    </Grid>

                                    <!-- Row 4 -->
                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <TextBlock Text="📎 رقم المرجع"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtRef"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <TextBlock Text="📅 تاريخ المرجع"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <dxe:DateEdit x:Name="txtRefDate"
                                                      Height="27" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="4">
                                        <TextBlock Text="📊 مركز التكلفة"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbCostCenter"
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="6">
                                        <TextBlock Text="👤 محرر السند"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="Editereciept"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="Red"
                                                   VerticalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ─── تفاصيل الدفع ─── -->
                        <Border Grid.Row="1"
                                Background="White"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="10,8" Margin="4,0,4,4"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <!-- ✅ Panel1: شيك -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- ✅ Panel2: موظف/جهة -->
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource HeaderBrush}"
                                        CornerRadius="7" Padding="10,4"
                                        Margin="0,0,0,7">
                                    <TextBlock Text="💼 تفاصيل الدفع"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- نوع الدفع -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal"
                                            Margin="0,0,0,7">
                                    <TextBlock Text="💳 نوع الدفع:"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,10,0"/>
                                    <RadioButton x:Name="rdCash"
                                                 Content="💵 نقدي"
                                                 Style="{StaticResource ModernRadio}"
                                                 IsChecked="True"
                                                 Checked="rdCash_Checked"/>
                                    <RadioButton x:Name="rdCheck"
                                                 Content="🏦 تحويل بنكي"
                                                 Style="{StaticResource ModernRadio}"
                                                 Checked="rdCheck_Checked"/>
                                </StackPanel>

                                <!-- حقول الدفع الأساسية -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <!-- ✅ قيمة الدولار -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🏧 يودع في حساب"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbDepositTO"
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="👔 المندوب"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbSalesMan"
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="📝 البيان"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtNotes"
                                                 Style="{StaticResource ModernTextBoxMulti}"/>
                                    </StackPanel>

                                    <!-- ✅ إضافة txtValD المفقود -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="💲 قيمة بالدولار"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtValD"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextChanged="txtValD_TextChanged"
                                                 GotFocus="txtValD_GotFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ✅ Panel1: بيانات الشيك -->
                                <Border Grid.Row="3"
                                        x:Name="Panel1"
                                        Background="#F0F4FF"
                                        BorderBrush="#B0BFFF"
                                        BorderThickness="1" CornerRadius="7"
                                        Padding="8,6" Margin="0,7,0,0"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🔢 رقم الشيك"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtCheckNo"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="📅 تاريخ الاستحقاق"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <dxe:DateEdit x:Name="txtCheckDate"
                                                          Height="27" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="📋 حالة الشيك"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbCheckType"
                                                      Style="{StaticResource ModernComboBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="🏦 مسحوب على بنك"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtBankCheck"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- ✅ إضافة قسم الموظف/جهة المفقود -->
                                <Border Grid.Row="4"
                                        Background="#FFF8E1"
                                        BorderBrush="#E0D49C"
                                        BorderThickness="1" CornerRadius="7"
                                        Padding="8,6" Margin="0,7,0,0"
                                        Visibility="Collapsed"
                                        x:Name="PanelEmpDeal">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal">
                                            <RadioButton x:Name="rdEmp"
                                                         Content="👤 موظف"
                                                         Style="{StaticResource ModernRadio}"
                                                         IsChecked="True"
                                                         Checked="rdPDeal_CheckedChanged"/>
                                            <RadioButton x:Name="rdPDeal"
                                                         Content="🏢 جهة"
                                                         Style="{StaticResource ModernRadio}"
                                                         Checked="rdPDeal_CheckedChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="👤 استلمت أنا السيد"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbEmployee"
                                                      Style="{StaticResource ModernComboBox}"
                                                      IsEditable="True"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════ -->
            <!--         TabPage2: البحث            -->
            <!-- ══════════════════════════════════ -->
            <TabItem Header="🔍 البحث">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- معايير البحث -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="10,8" Margin="4,4,4,3"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7" Padding="10,4"
                                    Margin="0,0,0,7">
                                <TextBlock Text="🔍 معايير البحث"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔢 رقم السند"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchNo"
                                             Style="{StaticResource ModernTextBox}"
                                             PreviewTextInput="txtSrchNo_PreviewTextInput"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📎 رقم المرجع"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchRef"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <Button Grid.Column="4"
                                        x:Name="btnSearch"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80" VerticalAlignment="Bottom"
                                        Click="btnSearch_Click"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📅 من تاريخ"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtFromDate"
                                                  Height="27" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📅 إلى تاريخ"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtToDate"
                                                  Height="27" FontSize="11"/>
                                </StackPanel>

                                <CheckBox Grid.Column="4"
                                          x:Name="chkall"
                                          Content="📋 كل الفترة"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Checked="chkall_CheckedChanged"
                                          Unchecked="chkall_CheckedChanged"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- نتائج البحث -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1" CornerRadius="10"
                            Margin="4,0,4,4"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0"
                                    Padding="10,4">
                                <TextBlock Text="📊 نتائج البحث"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      BorderThickness="0"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Header="GlobalId"
                                        Binding="{Binding GlobalId}"
                                        Width="0" Visibility="Collapsed"/>
                                    <DataGridTextColumn
                                        Header="🔢 الرقم"
                                        Binding="{Binding ReceiptNo}"
                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Header="📅 التاريخ"
                                        Binding="{Binding ReceiptDate}"
                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Header="💰 المبلغ"
                                        Binding="{Binding Payment}"
                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Header="👤 الموظف"
                                        Binding="{Binding EmployeeName}"
                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Center"/>
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"  Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="36" ToolTip="إغلاق"
                            Margin="0,0,3,0" Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"  Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول" Margin="0,0,2,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق" Margin="0,0,2,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"   Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي" Margin="0,0,2,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"   Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير" Click="btnLast_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnImportDocument"
                            Content="📂 إرفاق"
                            Style="{StaticResource PurpleBtn}"
                            Width="76" Margin="0,0,3,0"
                            Click="BtnImportDocument_Click"/>
                    <Button x:Name="Btnshowdocument"
                            Content="👁️ مستندات"
                            Style="{StaticResource InfoBtn}"
                            Width="86" Margin="0,0,3,0"
                            Click="Btnshowdocument_Click"/>
                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="76" Margin="0,0,3,0"
                            Click="btnView_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="76" Margin="0,0,3,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="68" Margin="0,0,3,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="68" Margin="0,0,3,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="68" Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ✅ إضافة StatusBar المفقود -->
        <Border Grid.Row="2"
                Background="#1A2D5A"
                Padding="8,3">
            <TextBlock x:Name="lblStatus"
                       Text="جاهز"
                       Foreground="#B0C4FF"
                       FontSize="10" FontWeight="SemiBold"/>
        </Border>

    </Grid>
</dx:ThemedWindow>