<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmItemCategory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="مجموعات الأصناف"
    Width="820"
    Height="620"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmActs_Load"
    KeyDown="frmUnits_KeyDown">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#304B8F"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabNote"
                    Grid.Row="0"
                    Background="White">

            <!-- تاب عام -->
            <TabItem Header="⚙️ عـام">
                <Grid Background="White" Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="8"
                            Padding="12,7"
                            Margin="0,0,0,10">
                        <TextBlock Text="📂 بيانات مجموعة الأصناف"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- صورة المجموعة -->
                            <StackPanel Grid.Column="0"
                                        Margin="8">

                                <TextBlock x:Name="Label16"
                                           Text="🖼️ صورة المجموعة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,6"/>

                                <Border BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Width="130"
                                        Height="100"
                                        Background="#F5F7FA">
                                    <Image x:Name="picImage"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,6,0,0">
                                    <TextBlock x:Name="lnkImgAdd"
                                               Text="📂 اختر"
                                               Foreground="#3A63C3"
                                               FontWeight="Bold"
                                               Cursor="Hand"
                                               TextDecorations="Underline"
                                               Margin="0,0,10,0"
                                               MouseLeftButtonDown="lnkImgAdd_Click"/>
                                    <TextBlock x:Name="lnkImgClr"
                                               Text="🗑️ مسح"
                                               Foreground="#E35656"
                                               FontWeight="Bold"
                                               Cursor="Hand"
                                               TextDecorations="Underline"
                                               MouseLeftButtonDown="lnkImgClr_Click"/>
                                </StackPanel>

                                <!-- زر الترتيب -->
                                <Button x:Name="btnOrderGrp"
                                        Content="🔢 ترتيب الظهور"
                                        Style="{StaticResource ActionBtn}"
                                        Height="36"
                                        Margin="0,12,0,4"
                                        Click="btnOrderGrp_Click"/>

                                <Button x:Name="btnSaveOrder"
                                        Content="💾 حفظ الترتيب"
                                        Style="{StaticResource SaveBtn}"
                                        Height="36"
                                        Visibility="Collapsed"
                                        Click="btnSaveOrder_Click"/>

                                <!-- أزرار الترتيب -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center">
                                    <Button x:Name="btnUp"
                                            Content="⬆"
                                            Style="{StaticResource ActionBtn}"
                                            Width="42" Height="36"
                                            Margin="0,0,4,0"
                                            Visibility="Collapsed"
                                            Click="btn_Up_Click"/>
                                    <Button x:Name="btnDown"
                                            Content="⬇"
                                            Style="{StaticResource ActionBtn}"
                                            Width="42" Height="36"
                                            Visibility="Collapsed"
                                            Click="btn_Down_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- حقول البيانات -->
                            <Grid Grid.Column="1"
                                  Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- الرمز -->
                                <TextBlock x:Name="Label4"
                                           Grid.Row="0" Grid.Column="0"
                                           Text="🔑 الرمز"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtCode"
                                         Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,8"
                                         TextAlignment="Center"/>

                                <!-- الاسم -->
                                <TextBlock x:Name="Label1"
                                           Grid.Row="1" Grid.Column="0"
                                           Text="📝 الاسم"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtName"
                                         Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,8"
                                         KeyDown="txtName_KeyDown"/>

                                <!-- الاسم EN -->
                                <TextBlock x:Name="Label3"
                                           Grid.Row="2" Grid.Column="0"
                                           Text="📝 الاسم (EN)"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="txtNameEN"
                                         Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,8"
                                         FlowDirection="LeftToRight"/>

                                <!-- الرئيسي -->
                                <TextBlock x:Name="Label5"
                                           Grid.Row="3" Grid.Column="0"
                                           Text="🏷️ الرئيسي"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="cmbMainCat"
                                          Grid.Row="3" Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,8"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="code"
                                          SelectionChanged="cmbMainCat_SelectedIndexChanged"/>

                                <!-- الطابعة -->
                                <TextBlock x:Name="Label2"
                                           Grid.Row="4" Grid.Column="0"
                                           Text="🖨️ الطابعة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <ComboBox x:Name="cmbPrinters"
                                          Grid.Row="4" Grid.Column="1"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,8"/>

                                <!-- الفرع -->
                                <TextBlock x:Name="lblBranch"
                                           Grid.Row="5" Grid.Column="0"
                                           Text="🏢 الفرع"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <Grid Grid.Row="5" Grid.Column="1"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbBranches"
                                              Grid.Column="0"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="name"
                                              SelectedValuePath="id"
                                              Margin="0,0,8,0"/>
                                    <CheckBox x:Name="chkAllBranch"
                                              Grid.Column="1"
                                              Content="كل الفروع"
                                              IsChecked="True"
                                              Style="{StaticResource ModernCheckBox}"
                                              VerticalAlignment="Center"
                                              Checked="chkAllBranch_CheckedChanged"
                                              Unchecked="chkAllBranch_CheckedChanged"/>
                                </Grid>

                                <!-- خيارات -->
                                <StackPanel Grid.Row="6" Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,10">

                                    <CheckBox x:Name="clkShowInPOS"
                                              Content="📺 الظهور في نقطة البيع"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,0,16,0"/>

                                    <CheckBox x:Name="chkPrintALLItems"
                                              Content="🖨️ طباعة كل الأصناف"
                                              Visibility="Collapsed"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,0,16,0"
                                              Checked="chkPrintALLItems_CheckedChanged"/>

                                    <CheckBox x:Name="chkPrintItemsSeparately"
                                              Content="📄 طباعة إنفرادي"
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>

                                <!-- رقم داخلي (مخفي) -->
                                <TextBox x:Name="txtNo"
                                         Grid.Row="7" Grid.Column="1"
                                         Visibility="Collapsed"
                                         IsReadOnly="True"
                                         Style="{StaticResource ModernTextBox}"/>

                                <!-- DataGrid الفئات -->
                                <Border Grid.Row="8" Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <DataGrid x:Name="dgvData"
                                              AutoGenerateColumns="False"
                                              HeadersVisibility="Column"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              RowStyle="{StaticResource GridRowStyle}"
                                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                              Background="White"
                                              AlternatingRowBackground="#F8F9FD"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#E7ECF5"
                                              MouseLeftButtonUp="dgvData_CellClick">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الرقم"
                                                                Binding="{Binding Column2Id}"
                                                                Width="0"
                                                                Visibility="Collapsed"/>

                                            <DataGridTextColumn Header="رمز المجموعة"
                                                                Binding="{Binding Column5Code}"
                                                                Width="110"
                                                                ElementStyle="{StaticResource GridCellText}"/>

                                            <DataGridTextColumn Header="مجموعة الصنف"
                                                                Binding="{Binding Column1Name}"
                                                                Width="*"
                                                                ElementStyle="{StaticResource GridCellText}"/>

                                            <DataGridTextColumn Header="ترتيب الظهور"
                                                                Binding="{Binding Column4Order}"
                                                                Width="100"
                                                                ElementStyle="{StaticResource GridCellText}"/>

                                            <DataGridCheckBoxColumn Header="الظهور في نقطة البيع"
                                                                    Binding="{Binding Column3ShowPOS}"
                                                                    Width="130"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- تاب ملاحظات -->
            <TabItem Header="📝 ملاحظات">
                <Grid Background="White" Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="8"
                            Padding="12,7"
                            Margin="0,0,0,10">
                        <TextBlock Text="📝 ملاحظات المجموعة"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="4">
                        <DataGrid x:Name="GridControl1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  RowStyle="{StaticResource GridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E7ECF5">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding DgvNo}"
                                                    Width="50"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTextColumn Header="الملاحظة"
                                                    Binding="{Binding DgvNoteCol}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="إضافة في السعر"
                                                    Binding="{Binding DgvAddPrice}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource GridCellText}"/>

                                <DataGridTemplateColumn Header="🗑️ حذف" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️"
                                                    Tag="{Binding}"
                                                    Height="26"
                                                    Padding="4,0"
                                                    Cursor="Hand"
                                                    Foreground="White"
                                                    Background="#E35656"
                                                    BorderThickness="0"
                                                    Click="btnDeleteRowDgv_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="5"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر الخروج -->
                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖"
                        Style="{StaticResource DangerBtn}"
                        Width="44"
                        ToolTip="خروج"
                        Margin="0,0,6,0"
                        Click="btnClose_Click"/>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Margin="0,0,8,0"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal">
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>