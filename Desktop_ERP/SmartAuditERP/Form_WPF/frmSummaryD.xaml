<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSummaryD"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="عرض سندات القبض والصرف"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3FA8D5" Offset="0"/>
            <GradientStop Color="#1E7AA8" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="6"  ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══ Main Layout ═══ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- لوحة الخيارات -->
                <ColumnDefinition Width="190"/>
                <!-- منطقة الجدول -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ GroupBox1: خيارات العرض ═══ -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,1,0"
                    Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,6,8,10">

                        <!-- عنوان -->
                        <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="8,5"
                                Margin="0,0,0,8">
                            <TextBlock Text="⚙️ خيارات العرض"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       FontFamily="Cairo, Tahoma, Arial"/>
                        </Border>

                        <!-- نوع السند -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📋 نوع السند" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox x:Name="chkAll"
                                              Content="الكل"
                                              Style="{StaticResource ModernCheckBox}"
                                              IsChecked="True"
                                              Margin="0,0,8,0"
                                              Checked="chkAll_CheckedChanged"
                                              Unchecked="chkAll_CheckedChanged"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbType"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,4,0,0">
                                    <ComboBoxItem Content="سندات قبض"/>
                                    <ComboBoxItem Content="سندات صرف"/>
                                    <ComboBoxItem Content="سند صرف ضريبي"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- الفرع -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🏢 الفرع" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox x:Name="chkAllBranches"
                                              Content="الكل"
                                              Style="{StaticResource ModernCheckBox}"
                                              IsChecked="True"
                                              Margin="0,0,8,0"
                                              Checked="chkAllBranches_CheckedChanged"
                                              Unchecked="chkAllBranches_CheckedChanged"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbBranches"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"
                                          Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- الحساب -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🏦 الحساب" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox x:Name="chkAllAcc"
                                              Content="الكل"
                                              Style="{StaticResource ModernCheckBox}"
                                              IsChecked="True"
                                              Margin="0,0,8,0"
                                              Checked="chkAllAcc_CheckedChanged"
                                              Unchecked="chkAllAcc_CheckedChanged"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbAccounts"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"
                                          Margin="0,4,0,0"
                                          KeyDown="cmbAccounts_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- الفترة الزمنية -->
                        <Border Background="#F0F4FF" CornerRadius="6" Padding="7,5"
                                Margin="0,0,0,6" BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📅 الفترة الزمنية" Style="{StaticResource FieldLabel}"/>
                                <CheckBox x:Name="ckTotalPeriod"
                                          Content="فترة كاملة"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"
                                          Margin="0,4,0,4"
                                          Checked="ckTotalPeriod_CheckedChanged"
                                          Unchecked="ckTotalPeriod_CheckedChanged"/>

                                <TextBlock Text="من" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,2"/>
                                <dxe:DateEdit x:Name="txtDateFrom"
                                              Height="26" FontSize="11"
                                              IsEnabled="False"/>

                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"
                                           Margin="0,4,0,2"/>
                                <dxe:DateEdit x:Name="txtDateTo"
                                              Height="26" FontSize="11"
                                              IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- زر عرض -->
                        <Button x:Name="btnShow"
                                Content="👁️ عرض"
                                Style="{StaticResource ActionBtn}"
                                Height="36"
                                Margin="0,4,0,0"
                                Click="btnShow_Click"/>

                        <!-- ProgressBar -->
                        <ProgressBar x:Name="ProgressBar1"
                                     Height="6"
                                     Margin="0,8,0,0"
                                     Background="#E0E6F5"
                                     Foreground="{StaticResource HeaderBrush}"
                                     Minimum="0" Maximum="100" Value="0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══ GroupBox2: جدول النتائج ═══ -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    Margin="6,6,6,4"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0" Padding="10,5">
                        <TextBlock Text="📊 بيانات السندات"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cairo, Tahoma, Arial"/>
                    </Border>

                    <!-- الجدول -->
                    <DataGrid x:Name="GridControl1"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              HorizontalScrollBarVisibility="Auto"
                              BorderThickness="0"
                              MouseDoubleClick="GridControl1_MouseDoubleClick">
                        <DataGrid.Columns>

                            <!-- الترتيب -->
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Rank}"
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- رقم السند -->
                            <DataGridTextColumn Header="🔢 الرقم"
                                                Binding="{Binding ReceiptNo}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- التاريخ -->
                            <DataGridTextColumn Header="📅 التاريخ"
                                                Binding="{Binding OperDate}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- قيمة السند -->
                            <DataGridTextColumn Header="💰 قيمة السند"
                                                Binding="{Binding Payment, StringFormat=N2}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الضريبة -->
                            <DataGridTextColumn Header="💹 الضريبة"
                                                Binding="{Binding VAT, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الصافي -->
                            <DataGridTextColumn Header="🧾 الصافي"
                                                Binding="{Binding DgvNet, StringFormat=N2}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الفرع -->
                            <DataGridTextColumn Header="🏢 الفرع"
                                                Binding="{Binding BranchName}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- البيان -->
                            <DataGridTextColumn Header="📝 البيان"
                                                Binding="{Binding ReceiptNote}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- نوع السند -->
                            <DataGridTextColumn Header="📋 نوع السند"
                                                Binding="{Binding DgvreceiptType}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- تفاصيل -->
                            <DataGridTemplateColumn Header="🔍 تفاصيل" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🔍"
                                                Height="20" FontSize="12"
                                                Background="{StaticResource InfoBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="BtnDetail_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="4,2">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- GlobalID (مخفي) -->
                            <DataGridTextColumn Header="GlobalID"
                                                Binding="{Binding GlobalID}"
                                                Width="0" Visibility="Collapsed"/>

                            <!-- receiptType (مخفي) -->
                            <DataGridTextColumn Header="receiptType"
                                                Binding="{Binding ReceiptType}"
                                                Width="0" Visibility="Collapsed"/>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- بطاقات المجاميع -->
                    <Border Grid.Row="2"
                            Background="#F0F4FF"
                            CornerRadius="0,0,10,10"
                            Padding="10,6"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="📊 إجمالي القيمة"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                                <TextBlock x:Name="lblTotalPayment"
                                           Text="0.00"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#213A7A"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="💹 إجمالي الضريبة"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                                <TextBlock x:Name="lblTotalVAT"
                                           Text="0.00"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#C47D0A"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="🧾 إجمالي الصافي"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                                <TextBlock x:Name="lblTotalNet"
                                           Text="0.00"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#1B8E4A"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnClose"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource InfoBtn}"
                            Width="110" Margin="0,0,6,0"
                            Click="btnExport_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="88" Margin="0,0,6,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="88"
                            Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>