<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSrchClient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="بحث عن عميل"
    Width="940" Height="590"
    MinWidth="840" MinHeight="560"
    WindowStartupLocation="CenterOwner"
    FlowDirection="RightToLeft"
    Background="#3F3F3F"
    FontFamily="Cairo, Tahoma, Arial"
    ShowInTaskbar="False"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="TopPanelBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F4F8F" Offset="0"/>
            <GradientStop Color="#3D6BB5" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="5"  ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TopBtn}">
            <Setter Property="Background" Value="#808080"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="AddBtn" TargetType="Button" BasedOn="{StaticResource TopBtn}">
            <Setter Property="Background" Value="#D3D3D3"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2F4F8F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#6EC5FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- الشريط العلوي -->
            <RowDefinition Height="*"/>
            <!-- الجدول -->
            <RowDefinition Height="12"/>
            <!-- شريط سفلي -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13"/>
            <!-- شريط جانبي أيسر -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15"/>
            <!-- شريط جانبي أيمن -->
        </Grid.ColumnDefinitions>

        <!-- الشريط الجانبي الأيسر -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                Background="#2F4F8F"/>

        <!-- الشريط الجانبي الأيمن -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                Background="#2F4F8F"/>

        <!-- ═══ الشريط العلوي ═══ -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{StaticResource TopPanelBrush}"
                Padding="10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر إغلاق -->
                <Button Grid.Column="0"
                        x:Name="btnClose"
                        Content="✖ إغلاق"
                        Style="{StaticResource CloseBtn}"
                        Width="100"
                        Click="btnClose_Click"/>

                <!-- اسم العميل -->
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="lblName"
                               Text="👤 اسم العميل"
                               Foreground="White"
                               FontSize="11" FontWeight="Bold"
                               Margin="0,0,0,3"
                               FontFamily="Cairo, Tahoma, Arial"/>
                    <TextBox x:Name="txtClientName"
                             Style="{StaticResource SearchBox}"
                             TextChanged="txtClientName_TextChanged"
                             KeyDown="txtClientName_KeyDown"/>
                </StackPanel>

                <!-- رقم الجوال -->
                <StackPanel Grid.Column="4">
                    <TextBlock x:Name="lblMobile"
                               Text="📱 رقم الجوال"
                               Foreground="White"
                               FontSize="11" FontWeight="Bold"
                               Margin="0,0,0,3"
                               FontFamily="Cairo, Tahoma, Arial"/>
                    <TextBox x:Name="txtCustPhone"
                             Style="{StaticResource SearchBox}"
                             TextChanged="txtCustPhone_TextChanged"/>
                </StackPanel>

                <!-- زر إضافة -->
                <Button Grid.Column="6"
                        x:Name="btnAddClient"
                        Content="➕"
                        Style="{StaticResource AddBtn}"
                        Height="34"
                        VerticalAlignment="Bottom"
                        ToolTip="إضافة جديد"
                        Click="btnAddClient_Click"/>

            </Grid>
        </Border>

        <!-- ═══ جدول النتائج ═══ -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="White"
                Margin="0,4,0,0">
            <DataGrid x:Name="DataGridView1"
                      AutoGenerateColumns="False"
                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                      RowStyle="{StaticResource DgvRow}"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FlowDirection="RightToLeft"
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8EBF5"
                      AlternatingRowBackground="#F8F9FD"
                      BorderThickness="0"
                      MouseDoubleClick="DataGridView1_MouseDoubleClick"
                      KeyDown="DataGridView1_KeyDown">
                <DataGrid.Columns>

                    <!-- id (مخفي) -->
                    <DataGridTextColumn Header="id"
                                        Binding="{Binding Id}"
                                        Width="0" Visibility="Collapsed"/>

                    <!-- الاسم -->
                    <DataGridTextColumn x:Name="colName"
                                        Header="👤 الاسم"
                                        Binding="{Binding Name}"
                                        Width="300">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الجوال -->
                    <DataGridTextColumn x:Name="colMobile"
                                        Header="📱 الجوال"
                                        Binding="{Binding Mobile}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الشريط السفلي -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="#2F4F8F"/>
    </Grid>
</dx:ThemedWindow>