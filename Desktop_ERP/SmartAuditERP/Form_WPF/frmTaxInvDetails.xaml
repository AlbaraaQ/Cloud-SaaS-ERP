<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmTaxInvDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تفاصيل الفواتير"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="SideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ الشريط الجانبي (Filters) ═══ -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0"
                Padding="12,10"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Header -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8"
                            Padding="10,7"
                            Margin="0,0,0,12">
                        <TextBlock Text="🔍 فضلاً أدخل البيانات"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- النوع -->
                    <TextBlock Text="النوع:" Style="{StaticResource SideLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  x:Name="chkAll"
                                  Content="الكل"
                                  IsChecked="True"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Checked="chkAll_CheckedChanged"
                                  Unchecked="chkAll_CheckedChanged"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="cmbProcType"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"
                                  SelectionChanged="cmbProcType_SelectionChanged"/>
                    </Grid>

                    <!-- الفترة الزمنية -->
                    <Border Background="#F0F4FF"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📅 الفترة الزمنية"
                                       Style="{StaticResource SideLabel}"
                                       Margin="0,0,0,6"/>
                            <CheckBox x:Name="ckTotalPeriod"
                                      Content="كل الفترة"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      Margin="0,0,0,6"
                                      Checked="ckTotalPeriod_CheckedChanged"
                                      Unchecked="ckTotalPeriod_CheckedChanged"/>
                            <TextBlock Text="من:" Style="{StaticResource SideLabel}"/>
                            <dxe:DateEdit x:Name="txtDateFrom"
                                          Height="30"
                                          IsEnabled="False"
                                          Margin="0,0,0,6"/>
                            <TextBlock Text="إلى:" Style="{StaticResource SideLabel}"/>
                            <dxe:DateEdit x:Name="txtDateTo"
                                          Height="30"
                                          IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- خيارات الضريبة -->
                    <Border Background="#F0F4FF"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🧾 خيارات الضريبة"
                                       Style="{StaticResource SideLabel}"
                                       Margin="0,0,0,6"/>
                            <RadioButton x:Name="rbAllVat"
                                         Content="الكل"
                                         IsChecked="True"
                                         FontWeight="Bold"
                                         Margin="0,0,0,4"/>
                            <RadioButton x:Name="rbWithVAT"
                                         Content="مع الضريبة"
                                         FontWeight="Bold"
                                         Margin="0,0,0,4"/>
                            <RadioButton x:Name="rbNoVAT"
                                         Content="بدون ضريبة"
                                         FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- الفرع -->
                    <Border Background="#F0F4FF"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏢 الفرع"
                                       Style="{StaticResource SideLabel}"
                                       Margin="0,0,0,6"/>
                            <CheckBox x:Name="chkAllBranches"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      Margin="0,0,0,6"
                                      Checked="chkAllBranches_CheckedChanged"
                                      Unchecked="chkAllBranches_CheckedChanged"/>
                            <ComboBox x:Name="cmbBranches"
                                      Style="{StaticResource ModernCombo}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- زر العرض -->
                    <Button x:Name="btnShow"
                            Content="🔍 عرض"
                            Style="{StaticResource ActionBtn}"
                            Height="40"
                            FontSize="14"
                            Click="btnShow_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ منطقة الجدول الرئيسي ═══ -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="White"
                Margin="6,6,6,0"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header الجدول -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0"
                        Height="40">
                    <TextBlock Text="🧾 الفواتير"
                               Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <!-- شريط التقدم -->
                <ProgressBar Grid.Row="1"
                             x:Name="ProgressBar1"
                             Height="6"
                             Background="#E8EBF5"
                             Foreground="#3A63C3"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0"/>

                <!-- DataGrid -->
                <DataGrid x:Name="GridControl1"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                          RowStyle="{StaticResource DgvRow}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          AlternatingRowBackground="#F8F9FD"
                          SelectionChanged="GridControl1_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="م"
                                            Binding="{Binding DgvNo}"
                                            Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="نوع الفاتورة"
                                            Binding="{Binding DgvInvType}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="رقم الفاتورة"
                                            Binding="{Binding DgvInvNo}"
                                            Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="colSupplierInvNo"
                                            Header="رقم فاتورة المورد"
                                            Binding="{Binding DgvSuplierInvNo}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="التاريخ"
                                            Binding="{Binding DgvDate}"
                                            Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="colClient"
                                            Header="المورد/العميل"
                                            Binding="{Binding DgvClient}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الرقم الضريبي"
                                            Binding="{Binding DgvVATNo}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="المجموع"
                                            Binding="{Binding DgvSum2, StringFormat=N2}"
                                            Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الخصم"
                                            Binding="{Binding DgvDiscount, StringFormat=N2}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الصافي قبل الضريبة"
                                            Binding="{Binding DgvNetBeforVat, StringFormat=N2}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الضريبة"
                                            Binding="{Binding DgvVAT, StringFormat=N2}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الصافي"
                                            Binding="{Binding DgvNet, StringFormat=N2}"
                                            Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- أعمدة مخفية للمنطق الداخلي -->
                        <DataGridTextColumn Header="InvType1"
                                            Binding="{Binding DgvInvType1}"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn Header="OperType"
                                            Binding="{Binding DgvOperType}"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn Header="InvGlobalID"
                                            Binding="{Binding DgvInvGlobalID}"
                                            Visibility="Collapsed"/>
                        <!-- زر التفاصيل -->
                        <DataGridTemplateColumn Header="👁️ تفاصيل" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁️ عرض"
                                            Tag="{Binding}"
                                            Padding="4,2"
                                            FontSize="11"
                                            Cursor="Hand"
                                            Click="BtnDetails_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ بطاقات المجاميع ═══ -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource FooterBrush}"
                Padding="10,8"
                Margin="6,4,6,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊 المجموع" FontSize="11"
                                   FontWeight="Bold" Foreground="#2E4E9E"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblSumTotal"
                                   Text="0.00"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#213A7A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔖 الخصم" FontSize="11"
                                   FontWeight="Bold" Foreground="#2E4E9E"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblSumDiscount"
                                   Text="0.00"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#213A7A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📋 الصافي قبل الضريبة" FontSize="11"
                                   FontWeight="Bold" Foreground="#2E4E9E"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblSumNetBeforVat"
                                   Text="0.00"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#213A7A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🧾 الضريبة" FontSize="11"
                                   FontWeight="Bold" Foreground="#2E4E9E"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblSumVAT"
                                   Text="0.00"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#213A7A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SummaryCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💰 الصافي الإجمالي" FontSize="11"
                                   FontWeight="Bold" Foreground="#2E4E9E"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblSumNet"
                                   Text="0.00"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#1B8E4A"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="btnClose"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="btnClose_Click"/>
                <Button x:Name="btnExportExcel"
                        Content="📊 تصدير Excel"
                        Style="{StaticResource GreenBtn}"
                        Width="120"
                        Margin="0,0,8,0"
                        Click="btnExportExcel_Click"/>
                <Button x:Name="btnPreview"
                        Content="👁️ معاينة"
                        Style="{StaticResource ActionBtn}"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="btnPreview_Click"/>
                <Button x:Name="btnPrint"
                        Content="🖨️ طباعة"
                        Style="{StaticResource ActionBtn}"
                        Width="100"
                        Click="btnPrint_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</dx:ThemedWindow>