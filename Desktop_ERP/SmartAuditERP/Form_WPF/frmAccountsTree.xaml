<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmAccountsTree"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="بطاقة حساب"
    Width="520" Height="580"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Styles ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══ Main Layout ═══ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Content ═══ -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="8">
            <StackPanel>

                <!-- ─── GroupBox1: بيانات الحساب ─── -->
                <Border Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="12,10" Margin="0,0,0,8"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- نوع الحساب -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <!-- كود + اسم -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <!-- الحساب الأب -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <!-- الفرع -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <!-- مركز التكلفة -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="10,5"
                                Margin="0,0,0,10">
                            <TextBlock Text="📋 بيانات الحساب"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- ✅ نوع الحساب: Checked → AccountTypeChanged -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="🔖 نوع الحساب"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton x:Name="main"
                                             Content="🏛️ رئيسي"
                                             Style="{StaticResource ModernRadio}"
                                             IsChecked="True"
                                             Checked="AccountTypeChanged"/>
                                <RadioButton x:Name="sub1"
                                             Content="🔀 فرعي"
                                             Style="{StaticResource ModernRadio}"
                                             Checked="AccountTypeChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- كود + اسم الحساب -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🔢 كود الحساب"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="Code"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="📝 اسم الحساب"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AName"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- ✅ الحساب الأب: MouseDoubleClick + KeyDown + Search -->
                        <StackPanel Grid.Row="5">
                            <TextBlock Text="🏦 الحساب الأب"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ParentCode"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True"
                                          SelectionChanged="ParentCode_SelectionChanged"
                                          KeyDown="ParentCode_KeyDown"
                                          MouseDoubleClick="ParentCode_MouseDoubleClick" Margin="0,0,48,0"/>

                                <Button
                                        Content="🔍"
                                        Style="{StaticResource ActionBtn}"
                                        Width="32" Height="28"
                                        FontSize="12" Padding="0"
                                        VerticalAlignment="Center"
                                        ToolTip="بحث عن حساب أب"
                                        Click="ParentCode_SearchClick" Grid.ColumnSpan="3" Margin="406,0,2,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- الفرع -->
                        <StackPanel Grid.Row="7">
                            <TextBlock Text="🏢 الفرع"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbBranches"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <!-- مركز التكلفة -->
                        <StackPanel Grid.Row="9">
                            <TextBlock Text="📊 مركز التكلفة"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbCostCenter"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─── GBbranchAcc: بيانات حساب فرعي ─── -->
                <Border x:Name="GBbranchAcc"
                        Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="12,10"
                        Effect="{StaticResource CardShadow}"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- طبيعة الحساب -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <!-- تاريخ + مستخدم -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <!-- الرصيد الافتتاحي -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="10,5"
                                Margin="0,0,0,10">
                            <TextBlock Text="💼 بيانات حساب فرعي"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- طبيعة الحساب -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="⚖️ طبيعة الحساب"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton x:Name="debt"
                                             Content="📈 مدين"
                                             Style="{StaticResource ModernRadio}"
                                             IsChecked="True"/>
                                <RadioButton x:Name="credit"
                                             Content="📉 دائن"
                                             Style="{StaticResource ModernRadio}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- تاريخ فتح الحساب + المستخدم -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📅 تاريخ فتح الحساب"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtDate"
                                              Height="28" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="👤 المستخدم"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="User"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- الرصيد الافتتاحي -->
                        <StackPanel Grid.Row="5">
                            <TextBlock Text="💰 الرصيد الافتتاحي"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="IValue"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- إغلاق -->
                <Button Grid.Column="0"
                        x:Name="btnClose"
                        Content="✖ إغلاق"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Click="btnClose_Click"/>

                <!-- العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80" Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80" Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>