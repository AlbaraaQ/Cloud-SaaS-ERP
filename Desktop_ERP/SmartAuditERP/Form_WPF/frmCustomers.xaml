<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCustomers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Title="👥 تعريف العملاء / الموردين"
    Height="700" Width="950"
    MinHeight="600" MinWidth="850"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    FontFamily="Tahoma"
    FontSize="13">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Gradient Brushes               -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#283593" Offset="0.5"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolbarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#283593" Offset="0"/>
            <GradientStop Color="#1A237E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SectionGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8F9FA" Offset="0"/>
            <GradientStop Color="#ECEFF1" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Drop Shadows                   -->
        <!-- ═══════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#AAAAAA" Direction="270"
                          ShadowDepth="3" BlurRadius="8" Opacity="0.4"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          Color="#333333" Direction="270"
                          ShadowDepth="2" BlurRadius="5" Opacity="0.35"/>

        <!-- ═══════════════════════════════════════════ -->
        <!--           Toolbar Button Style              -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#283593"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="IconText"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="Tahoma"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerToolbarButton" TargetType="Button"
               BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#C62828"/>
        </Style>

        <Style x:Key="SuccessToolbarButton" TargetType="Button"
               BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#2E7D32"/>
        </Style>

        <Style x:Key="WarnToolbarButton" TargetType="Button"
               BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#E65100"/>
        </Style>

        <Style x:Key="NavToolbarButton" TargetType="Button"
               BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="Width" Value="46"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           GroupBox Style                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2"
                                    Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderGradient}"
                                    CornerRadius="10,10,0,0"
                                    Padding="12,5">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="White"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.FontSize="12"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           Label Style                       -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           Add Button Style                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="SmallAddButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#43A047"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="إضافة جديد"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           RadioButton Style                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           CheckBox Style                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--        Action Button Style (Search Tab)     -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--                  Root Layout                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="55"/>
            <!-- Toolbar -->
            <RowDefinition Height="62"/>
            <!-- Tab Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--                  Header Bar                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="👥" FontSize="22"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtWindowTitle"
                               Text="تعريف العملاء / الموردين"
                               Foreground="White" FontFamily="Tahoma"
                               FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="txtHeaderDate"
                           Foreground="#B3E5FC" FontFamily="Tahoma"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,20,0"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--                  Toolbar                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource ToolbarGradient}"
                BorderBrush="#1A237E"
                BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0">

                <!-- Close -->
                <Button x:Name="btnClose"
                        Content="خروج" Tag="❌"
                        Style="{StaticResource DangerToolbarButton}"
                        ToolTip="إغلاق النافذة"/>

                <Separator Background="#455A64" Width="1" Margin="8,5"/>

                <!-- Navigation -->
                <Button x:Name="btnFirst"
                        Content="أول" Tag="⏮"
                        Style="{StaticResource NavToolbarButton}"
                        ToolTip="السجل الأول"/>

                <Button x:Name="btnPrevious"
                        Content="سابق" Tag="◀"
                        Style="{StaticResource NavToolbarButton}"
                        ToolTip="السجل السابق"/>

                <Button x:Name="btnNext"
                        Content="تالي" Tag="▶"
                        Style="{StaticResource NavToolbarButton}"
                        ToolTip="السجل التالي"/>

                <Button x:Name="btnLast"
                        Content="أخير" Tag="⏭"
                        Style="{StaticResource NavToolbarButton}"
                        ToolTip="السجل الأخير"/>

                <Separator Background="#455A64" Width="1" Margin="8,5"/>

                <!-- CRUD -->
                <Button x:Name="btnSave"
                        Content="حفظ" Tag="💾"
                        Style="{StaticResource SuccessToolbarButton}"
                        ToolTip="حفظ البيانات"/>

                <Button x:Name="btnNew"
                        Content="جديد" Tag="➕"
                        Style="{StaticResource SuccessToolbarButton}"
                        ToolTip="إضافة سجل جديد"/>

                <Button x:Name="btnDelete"
                        Content="حذف" Tag="🗑️"
                        Style="{StaticResource WarnToolbarButton}"
                        ToolTip="حذف السجل الحالي"/>

                <Button x:Name="btnPrint"
                        Content="طباعة" Tag="🖨️"
                        Style="{StaticResource ToolbarButton}"
                        Visibility="Collapsed"
                        ToolTip="طباعة"/>

                <Separator Background="#455A64" Width="1" Margin="8,5"/>

                <!-- Record Counter -->
                <Border Background="#1565C0"
                        CornerRadius="8" Padding="12,5"
                        VerticalAlignment="Center" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📌 السجل: "
                                   Foreground="#B3E5FC"
                                   FontFamily="Tahoma" FontSize="11"/>
                        <TextBlock x:Name="txtCurrentRecord"
                                   Text="0"
                                   Foreground="White"
                                   FontFamily="Tahoma" FontSize="11"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" / "
                                   Foreground="#B3E5FC"
                                   FontFamily="Tahoma" FontSize="11"/>
                        <TextBlock x:Name="txtTotalRecords"
                                   Text="0"
                                   Foreground="White"
                                   FontFamily="Tahoma" FontSize="11"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--               Tab Control                   -->
        <!-- ═══════════════════════════════════════════ -->
        <dx:DXTabControl Grid.Row="2"
                         x:Name="TabControl1"
                         Margin="5">

            <!-- ──────────────────────────────── -->
            <!--   Tab 1: General Info            -->
            <!-- ──────────────────────────────── -->
            <dx:DXTabItem Header="🏷️ عـام">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10" Background="#F8F9FA">

                        <!-- Basic Info Group -->
                        <GroupBox Style="{StaticResource ModernGroupBox}"
                                  Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="👤 البيانات الأساسية"/>
                            </GroupBox.Header>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Branch + No -->
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock Text="الفرع:" Style="{StaticResource FieldLabel}"/>
                                    <dxe:ComboBoxEdit x:Name="cmbBranch"
                                                      Width="180" Height="30"
                                                      AutoComplete="True"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock Text="الرقم:" Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtNo"
                                                  Width="100" Height="30"
                                                  IsReadOnly="True"
                                                  HorizontalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Row 1: Name -->
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock x:Name="lblname"
                                               Text="الاسم:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtName"
                                                  Width="220" Height="30"/>
                                </StackPanel>

                                <!-- Row 2: Mobile -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock Text="الجوال:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtMobile"
                                                  Width="200" Height="30"/>
                                </StackPanel>

                                <!-- Row 3: Country -->
                                <StackPanel Grid.Row="3" Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock x:Name="lblCountry"
                                               Text="الدولة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:ComboBoxEdit x:Name="cmbCountry"
                                                      Width="180" Height="30"
                                                      AutoComplete="True"/>
                                    <Button x:Name="btnCountryAdd"
                                            Content="➕"
                                            Style="{StaticResource SmallAddButton}"
                                            Margin="5,0"/>
                                </StackPanel>

                                <!-- Row 4: Tax No -->
                                <StackPanel Grid.Row="4" Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock x:Name="lblTaxNo"
                                               Text="الرقم الضريبي:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtTaxNo"
                                                  Width="200" Height="30"/>
                                </StackPanel>

                                <!-- Row 5: National ID + CR No -->
                                <StackPanel Grid.Row="5" Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock Text="رقم الهوية:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtNationalID"
                                                  Width="180" Height="30"/>
                                </StackPanel>

                                <StackPanel Grid.Row="5" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="5,5">
                                    <TextBlock x:Name="lblCrNo"
                                               Text="السجل التجاري:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtCrNo"
                                                  Width="180" Height="30"/>
                                </StackPanel>

                                <!-- ID Scan Image -->
                                <Border Grid.Row="0" Grid.RowSpan="5"
                                        Grid.Column="2"
                                        Background="White"
                                        BorderBrush="#B0BEC5"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Margin="10,5">
                                    <Image x:Name="IDscan"
                                           Stretch="Uniform"
                                           Margin="5"/>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <!-- Address Group (ZATCA) -->
                        <GroupBox Style="{StaticResource ModernGroupBox}"
                                  Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="📍 بيانات العنوان (هيئة الزكاة)"/>
                            </GroupBox.Header>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Street -->
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblStreet"
                                               Text="الشارع:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtStreetName"
                                                  Width="160" Height="28"/>
                                </StackPanel>

                                <!-- Building Number -->
                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblBuildingNumber"
                                               Text="رقم المبنى:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtBuildingNumber"
                                                  Width="140" Height="28"/>
                                </StackPanel>

                                <!-- Plot Identification -->
                                <StackPanel Grid.Row="0" Grid.Column="2"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblPlotIdentification"
                                               Text="الرقم الفرعي:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtPlotIdentification"
                                                  Width="140" Height="28"/>
                                </StackPanel>

                                <!-- District -->
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblDistrict"
                                               Text="الحي:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtDistrict"
                                                  Width="160" Height="28"/>
                                </StackPanel>

                                <!-- Additional Street -->
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblAdditionalStreetName"
                                               Text="شارع آخر:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtAdditionalStreetName"
                                                  Width="140" Height="28"/>
                                </StackPanel>

                                <!-- Postal Zone -->
                                <StackPanel Grid.Row="1" Grid.Column="2"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblPostalZone"
                                               Text="الرمز البريدي:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtPostalZone"
                                                  Width="130" Height="28"/>
                                </StackPanel>

                                <!-- City2 -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock Text="المدينة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtcity2"
                                                  Width="160" Height="28"/>
                                </StackPanel>

                                <!-- Area2 -->
                                <StackPanel Grid.Row="2" Grid.Column="1"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock Text="المنطقة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtarea2"
                                                  Width="160" Height="28"/>
                                </StackPanel>

                            </Grid>
                        </GroupBox>

                        <!-- Account & Type Group -->
                        <GroupBox Style="{StaticResource ModernGroupBox}"
                                  Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="💳 بيانات الحساب"/>
                            </GroupBox.Header>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Account Code -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="5">
                                    <TextBlock Text="رقم الحساب:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtAccCode"
                                                  Width="160" Height="30"
                                                  IsReadOnly="True"
                                                  HorizontalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Type: Cash / Postpone -->
                                <GroupBox Grid.Column="1"
                                          Style="{StaticResource ModernGroupBox}"
                                          Margin="5">
                                    <GroupBox.Header>
                                        <TextBlock Text="النوع"/>
                                    </GroupBox.Header>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="5">
                                        <RadioButton x:Name="rbCash"
                                                     Content="فردي"
                                                     IsChecked="True"
                                                     Style="{StaticResource ModernRadioButton}"/>
                                        <RadioButton x:Name="rbPostPone"
                                                     Content="تجاري"
                                                     Style="{StaticResource ModernRadioButton}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Deal As Supplier -->
                                <CheckBox x:Name="ckDealAsSupp"
                                          Grid.Column="2"
                                          Content="🔄 يعامل كمورد"
                                          Style="{StaticResource ModernCheckBox}"
                                          VerticalAlignment="Center"
                                          Margin="10"/>

                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </dx:DXTabItem>

            <!-- ──────────────────────────────── -->
            <!--   Tab 2: Additional Data         -->
            <!-- ──────────────────────────────── -->
            <dx:DXTabItem Header="📋 بيانات إضافية">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">

                        <!-- Contact Group -->
                        <GroupBox Style="{StaticResource ModernGroupBox}"
                                  Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="📞 بيانات التواصل"/>
                            </GroupBox.Header>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Activity -->
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblActs"
                                               Text="مجال العمل:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:ComboBoxEdit x:Name="cmbActs"
                                                      Width="170" Height="30"
                                                      AutoComplete="True"/>
                                    <Button x:Name="btnActAdd"
                                            Content="➕"
                                            Style="{StaticResource SmallAddButton}"
                                            Margin="5,0"/>
                                </StackPanel>

                                <!-- Tel -->
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblTel"
                                               Text="رقم الهاتف:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtTel"
                                                  Width="180" Height="30"/>
                                </StackPanel>

                                <!-- Fax -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblFax"
                                               Text="فاكس:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtFax"
                                                  Width="180" Height="30"/>
                                </StackPanel>

                                <!-- Email -->
                                <StackPanel Grid.Row="3" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblEmail"
                                               Text="البريد الإلكتروني:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="txtEmail"
                                                  Width="200" Height="30"/>
                                </StackPanel>

                                <!-- City -->
                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblCity"
                                               Text="المدينة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:ComboBoxEdit x:Name="cmbCity"
                                                      Width="170" Height="30"
                                                      AutoComplete="True"/>
                                    <Button x:Name="btnCityAdd"
                                            Content="➕"
                                            Style="{StaticResource SmallAddButton}"
                                            Margin="5,0"/>
                                </StackPanel>

                                <!-- Area -->
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblArea"
                                               Text="المنطقة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:ComboBoxEdit x:Name="cmbArea"
                                                      Width="170" Height="30"
                                                      AutoComplete="True"/>
                                    <Button x:Name="btnAreaAdd"
                                            Content="➕"
                                            Style="{StaticResource SmallAddButton}"
                                            Margin="5,0"/>
                                </StackPanel>

                            </Grid>
                        </GroupBox>

                        <!-- Financial Settings Group -->
                        <GroupBox Style="{StaticResource ModernGroupBox}"
                                  Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="💰 الإعدادات المالية"/>
                            </GroupBox.Header>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cost Center -->
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblCostCenter"
                                               Text="مركز التكلفة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:ComboBoxEdit x:Name="cmbCostCenter"
                                                      Width="180" Height="30"
                                                      AutoComplete="True"/>
                                </StackPanel>

                                <!-- Price List -->
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblPrice"
                                               Text="التسعيرة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:ComboBoxEdit x:Name="cmbPrice"
                  IsTextEditable="False">
                                        <dxe:ComboBoxEdit.Items>
                                            <dxe:ComboBoxEditItem Content="لا يوجد"/>
                                            <dxe:ComboBoxEditItem Content="سعر البيع"/>
                                            <dxe:ComboBoxEditItem Content="سعر الشراء"/>
                                            <dxe:ComboBoxEditItem Content="سعر آخر شراء"/>
                                            <dxe:ComboBoxEditItem Content="سعر التكلفة"/>
                                            <dxe:ComboBoxEditItem Content="سعر المنافس"/>
                                            <dxe:ComboBoxEditItem Content="سعر الجملة"/>
                                            <dxe:ComboBoxEditItem Content="سعر المستهلك"/>
                                        </dxe:ComboBoxEdit.Items>
                                    </dxe:ComboBoxEdit>
                                </StackPanel>

                                <!-- Opening Balance -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal" Margin="5,5">
                                    <TextBlock x:Name="lblivalue"
                                               Text="الرصيد الافتتاحي:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:TextEdit x:Name="IValue"
                                                  Width="160" Height="30"
                                                  HorizontalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Debit / Credit -->
                                <Border Grid.Row="3" Grid.Column="0"
                                        Background="#E3F2FD"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        Margin="5,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="طبيعة الرصيد:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <RadioButton x:Name="debt"
                                                     Content="مدين"
                                                     IsChecked="True"
                                                     Style="{StaticResource ModernRadioButton}"/>
                                        <RadioButton x:Name="credit"
                                                     Content="دائن"
                                                     Style="{StaticResource ModernRadioButton}"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </GroupBox>

                        <!-- Notes -->
                        <GroupBox Style="{StaticResource ModernGroupBox}"
                                  Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="📝 ملاحظات"/>
                            </GroupBox.Header>
                            <dxe:MemoEdit x:Name="txtNotes"
                                          Height="80"
                                          Margin="5"/>
                        </GroupBox>

                        <!-- Documents -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,5">
                            <Button x:Name="btnScan"
                                    Content="📎 إرفاق الوثائق"
                                    Background="#546E7A"
                                    Foreground="White"
                                    FontFamily="Tahoma"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Height="38"
                                    MinWidth="160"
                                    Margin="10,0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="15,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="Button2"
                                    Content="🗂️ عرض الوثائق"
                                    Background="#455A64"
                                    Foreground="White"
                                    FontFamily="Tahoma"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Height="38"
                                    MinWidth="160"
                                    Margin="10,0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="15,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </dx:DXTabItem>

            <!-- ──────────────────────────────── -->
            <!--   Tab 3: Search                  -->
            <!-- ──────────────────────────────── -->
            <dx:DXTabItem Header="🔍 البحث">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Filters -->
                    <GroupBox Grid.Row="0"
                              Style="{StaticResource ModernGroupBox}"
                              Margin="0,0,0,8">
                        <GroupBox.Header>
                            <TextBlock Text="🔍 معايير البحث"/>
                        </GroupBox.Header>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Name Search -->
                            <StackPanel Grid.Row="0" Grid.Column="0"
                                        Orientation="Horizontal" Margin="5,5">
                                <TextBlock Text="الاسم:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtNameSrch"
                                              Width="200" Height="30"
                                              NullText="ابحث بالاسم..."/>
                            </StackPanel>

                            <!-- Mobile Search -->
                            <StackPanel Grid.Row="0" Grid.Column="1"
                                        Orientation="Horizontal" Margin="5,5">
                                <TextBlock x:Name="lblMobileSrch"
                                           Text="الجوال:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtMobileSrch"
                                              Width="180" Height="30"
                                              NullText="ابحث بالجوال..."/>
                            </StackPanel>

                            <!-- VAT Search -->
                            <StackPanel Grid.Row="0" Grid.Column="2"
                                        Orientation="Horizontal" Margin="5,5">
                                <TextBlock x:Name="lblVATSrch"
                                           Text="الرقم الضريبي:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtVATSrch"
                                              Width="180" Height="30"
                                              NullText="ابحث بالرقم الضريبي..."/>
                            </StackPanel>

                            <!-- Branch Filter -->
                            <StackPanel Grid.Row="1" Grid.Column="0"
                                        Orientation="Horizontal" Margin="5,5">
                                <TextBlock x:Name="lblBranch"
                                           Text="الفرع:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:ComboBoxEdit x:Name="cmbBranches"
                                                  Width="170" Height="30"
                                                  AutoComplete="True"/>
                                <CheckBox x:Name="chkAllBranches"
                                          Content="الكل"
                                          IsChecked="True"
                                          Style="{StaticResource ModernCheckBox}"
                                          Margin="8,0"/>
                            </StackPanel>

                            <!-- Customer Count -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="#E8F5E9"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    Margin="5,5"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="lblCustCountNo"
                                               Text="عدد العملاء: "
                                               FontFamily="Tahoma"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#2E7D32"/>
                                    <TextBlock x:Name="lblCustCount"
                                               Text="0"
                                               FontFamily="Tahoma"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#1B5E20"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="2" Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal"
                                        Margin="5,8">
                                <Button x:Name="btnSearch"
                                        Content="🔍 بحث"
                                        Background="#1565C0"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,0,10,0"/>
                                <Button x:Name="btnExport"
                                        Content="📊 تصدير Excel"
                                        Background="#E65100"
                                        Style="{StaticResource ActionButton}"
                                        Margin="0,0,10,0"/>
                            </StackPanel>

                        </Grid>
                    </GroupBox>

                    <!-- Search Results Grid -->
                    <GroupBox Grid.Row="1"
                              Style="{StaticResource ModernGroupBox}"
                              Margin="0">
                        <GroupBox.Header>
                            <TextBlock Text="📊 نتائج البحث"/>
                        </GroupBox.Header>
                        <dxg:GridControl x:Name="dgvCustomers"
                                         Margin="0">
                            <dxg:GridControl.Columns>

                                <dxg:GridColumn x:Name="ColId"
                                                Header="الرقم"
                                                FieldName="Id"
                                                Visible="False"/>

                                <dxg:GridColumn x:Name="ColName"
                                                Header="الاسم"
                                                FieldName="Name"
                                                Width="180"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColNationalId"
                                                Header="رقم الهوية"
                                                FieldName="NationalId"
                                                Width="130"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColPhone"
                                                Header="رقم الهاتف"
                                                FieldName="Phone"
                                                Width="110"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColMobile"
                                                Header="رقم الجوال"
                                                FieldName="Mobile"
                                                Width="110"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColCountry"
                                                Header="الدولة"
                                                FieldName="Country"
                                                Width="90"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColCity"
                                                Header="المدينة"
                                                FieldName="City"
                                                Width="90"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColArea"
                                                Header="المنطقة"
                                                FieldName="Area"
                                                Width="90"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColTaxNo"
                                                Header="الرقم الضريبي"
                                                FieldName="TaxNo"
                                                Width="120"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColAccountCode"
                                                Header="رقم الحساب"
                                                FieldName="AccountCode"
                                                Width="100"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColBranch"
                                                Header="الفرع"
                                                FieldName="Branch"
                                                Width="90"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="GridView1"
                                               AllowGrouping="False"
                                               ShowGroupPanel="False"
                                               AutoWidth="False"
                                               NavigationStyle="Row"
                                               AllowPerPixelScrolling="True"
                                               SearchPanelNullText="🔍 ابحث هنا..."
                                               ShowSearchPanelCloseButton="True"
                                               RowDoubleClickCommand="{Binding}"
                                               EnableImmediatePosting="True"/>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </GroupBox>

                </Grid>
            </dx:DXTabItem>

            <!-- ──────────────────────────────── -->
            <!--   Tab 4: Measurements            -->
            <!-- ──────────────────────────────── -->
            <dx:DXTabItem Header="📐 المقاسات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Style="{StaticResource ModernGroupBox}"
                              Margin="10">
                        <GroupBox.Header>
                            <TextBlock Text="📐 جدول المقاسات"/>
                        </GroupBox.Header>
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Page No -->
                            <StackPanel Grid.Row="0" Grid.Column="0"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="رقم الصفحة:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtpageno"
                                              Width="140" Height="30"/>
                            </StackPanel>

                            <!-- Neck -->
                            <StackPanel Grid.Row="1" Grid.Column="0"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="الرقبة:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtNeck"
                                              Width="140" Height="30"/>
                            </StackPanel>

                            <!-- Arm Width -->
                            <StackPanel Grid.Row="2" Grid.Column="0"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="وسع اليد:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtArmWidth"
                                              Width="140" Height="30"/>
                            </StackPanel>

                            <!-- Step Width -->
                            <StackPanel Grid.Row="3" Grid.Column="0"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="وسع الخطوة:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtStepWidth"
                                              Width="140" Height="30"/>
                            </StackPanel>

                            <!-- Note -->
                            <StackPanel Grid.Row="4" Grid.Column="0"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="ملاحظات:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="MeasurementNote"
                                              Width="140" Height="30"/>
                            </StackPanel>

                            <!-- Length -->
                            <StackPanel Grid.Row="0" Grid.Column="1"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="الطول:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtLength"
                                              Width="150" Height="30"/>
                            </StackPanel>

                            <!-- Shoulder -->
                            <StackPanel Grid.Row="1" Grid.Column="1"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="كتف:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtShoulder"
                                              Width="150" Height="30"/>
                            </StackPanel>

                            <!-- Sleeve -->
                            <StackPanel Grid.Row="2" Grid.Column="1"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="طول اليد:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtSleeve"
                                              Width="150" Height="30"/>
                            </StackPanel>

                            <!-- Chest -->
                            <StackPanel Grid.Row="3" Grid.Column="1"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="الصدر:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtChest"
                                              Width="150" Height="30"/>
                            </StackPanel>

                            <!-- Waist -->
                            <StackPanel Grid.Row="4" Grid.Column="1"
                                        Orientation="Horizontal" Margin="5,6">
                                <TextBlock Text="الوسع:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:TextEdit x:Name="txtWaist"
                                              Width="150" Height="30"/>
                            </StackPanel>

                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </dx:DXTabItem>

        </dx:DXTabControl>

    </Grid>
</dx:ThemedWindow>