<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvPOS"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="نقطة البيع"
    Width="1200" Height="780"
    MinWidth="1022" MinHeight="726"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#3D3D3D"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ══════════════ Brushes ══════════════ -->
        <SolidColorBrush x:Key="DarkPurple"   Color="#390065"/>
        <SolidColorBrush x:Key="DarkGray"     Color="#404040"/>
        <SolidColorBrush x:Key="MedGray"      Color="#808080"/>
        <SolidColorBrush x:Key="LightGrayBg"  Color="#D3D3D3"/>
        <SolidColorBrush x:Key="GreenBrush"   Color="#008000"/>
        <SolidColorBrush x:Key="BrownBrush"   Color="#A52A2A"/>
        <SolidColorBrush x:Key="OrangeBrush"  Color="#FF8000"/>
        <SolidColorBrush x:Key="BorderLight"  Color="#555555"/>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#390065" Offset="0"/>
            <GradientStop Color="#5A0099" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.3"
                          Color="#000000"/>

        <!-- ══════════════ Styles ══════════════ -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"             Value="{StaticResource DarkPurple}"/>
            <Setter Property="Foreground"             Value="White"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Height"                 Value="24"/>
            <Setter Property="FontSize"               Value="12"/>
            <Setter Property="FontWeight"             Value="Bold"/>
            <Setter Property="TextAlignment"          Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"             Value="True"/>
        </Style>

        <Style x:Key="DarkLargeTextBox" TargetType="TextBox"
               BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="FontSize"               Value="15"/>
            <Setter Property="Height"                 Value="43"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize"               Value="11"/>
            <Setter Property="FontWeight"             Value="Bold"/>
            <Setter Property="Foreground"             Value="White"/>
            <Setter Property="Background"             Value="{StaticResource DarkPurple}"/>
            <Setter Property="TextAlignment"          Value="Center"/>
            <Setter Property="VerticalAlignment"      Value="Center"/>
            <Setter Property="Padding"                Value="2,0"/>
        </Style>

        <Style x:Key="POSBtn" TargetType="Button">
            <Setter Property="Background"             Value="{StaticResource DarkPurple}"/>
            <Setter Property="Foreground"             Value="White"/>
            <Setter Property="FontSize"               Value="11"/>
            <Setter Property="FontWeight"             Value="Bold"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="BorderBrush"            Value="White"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Width"                  Value="62"/>
            <Setter Property="Height"                 Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumPadBtn" TargetType="Button"
               BasedOn="{StaticResource POSBtn}">
            <Setter Property="FontSize"               Value="18"/>
            <Setter Property="FontWeight"             Value="Bold"/>
            <Setter Property="Width"                  Value="42"/>
            <Setter Property="Height"                 Value="40"/>
        </Style>

        <Style x:Key="HoldBtn" TargetType="Button"
               BasedOn="{StaticResource POSBtn}">
            <Setter Property="Width"                  Value="40"/>
            <Setter Property="Height"                 Value="40"/>
            <Setter Property="FontSize"               Value="14"/>
            <Setter Property="FontWeight"             Value="Bold"/>
        </Style>

        <Style x:Key="NavItemBtn" TargetType="Button"
               BasedOn="{StaticResource POSBtn}">
            <Setter Property="FontSize"               Value="18"/>
            <Setter Property="Width"                  Value="42"/>
            <Setter Property="Height"                 Value="38"/>
            <Setter Property="Background"             Value="{StaticResource DarkPurple}"/>
        </Style>

        <Style x:Key="PayNowBtn" TargetType="Button">
            <Setter Property="Background"             Value="{StaticResource GreenBrush}"/>
            <Setter Property="Foreground"             Value="White"/>
            <Setter Property="FontSize"               Value="16"/>
            <Setter Property="FontWeight"             Value="Bold"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"             Value="{StaticResource DarkPurple}"/>
            <Setter Property="Foreground"             Value="White"/>
            <Setter Property="FontWeight"             Value="Bold"/>
            <Setter Property="FontSize"               Value="11"/>
            <Setter Property="Height"                 Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                Value="2,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height"                 Value="26"/>
            <Setter Property="FontSize"               Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5A0099"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A0080"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <!-- Item Tile Card Style -->
        <Style x:Key="ItemTileBtn" TargetType="Button">
            <Setter Property="Background"    Value="{StaticResource DarkPurple}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderBrush"   Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Width"         Value="100"/>
            <Setter Property="Height"        Value="110"/>
            <Setter Property="Margin"        Value="3"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group Category Button Style -->
        <Style x:Key="GroupBtn" TargetType="Button">
            <Setter Property="Background"    Value="{StaticResource DarkPurple}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderBrush"   Value="#888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Width"         Value="130"/>
            <Setter Property="Height"        Value="60"/>
            <Setter Property="Margin"        Value="0,3,0,0"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#5A0099"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ══════════════════════════════════════════════════════════
         Root Grid: 3 أعمدة
         Col 0: GrpPanel (فئات)
         Col 1: المنطقة الوسطى (فاتورة + ملخص + شريط)
         Col 2: الأزرار اليمنى + لوحة الأرقام
         ══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145"/>  <!-- GrpPanel -->
            <ColumnDefinition Width="*"/>    <!-- Middle -->
            <ColumnDefinition Width="140"/>  <!-- Right Buttons -->
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════
             Col 0: GrpPanel - فئات الأصناف
             ════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="WhiteSmoke">
            <Grid.RowDefinitions>
                <RowDefinition Height="49"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط التنقل بين الفئات -->
            <Grid Grid.Row="0"
                  Background="{StaticResource DarkPurple}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="btnGrpRight"
                            Content="▶"
                            Style="{StaticResource POSBtn}"
                            Width="49" Height="43"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="btnGrpRight_Click"/>
                    <Button x:Name="btnGrpLeft"
                            Content="◀"
                            Style="{StaticResource POSBtn}"
                            Width="54" Height="43"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="btnGrpLeft_Click"/>
                </StackPanel>
            </Grid>

            <!-- قائمة الفئات -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="FlowGrpPnl"
                           Orientation="Vertical"
                           Background="WhiteSmoke"/>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════════════════════════════════
             Col 1: المنطقة الوسطى
             ════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- أصناف الفاتورة + ملخص -->
                <RowDefinition Height="Auto"/> <!-- شريط البيان والباركود -->
                <RowDefinition Height="Auto"/> <!-- أزرار التعليق (Hold) + الدفع -->
            </Grid.RowDefinitions>

            <!-- ════ Row 0: أصناف الفاتورة + ملخص يمين + أصناف يسار ════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>   <!-- Invoice + Summary -->
                    <ColumnDefinition Width="330"/> <!-- Items Panel -->
                </Grid.ColumnDefinitions>

                <!-- ═══ Invoice Left Side ═══ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- ملخص الفاتورة -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- ═══ ملخص الفاتورة (LayoutControl1 equivalent) ═══ -->
                    <Border Grid.Row="0"
                            Background="{StaticResource LightGrayBg}"
                            Height="170">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="43"/> <!-- العميل -->
                                <RowDefinition Height="25"/> <!-- المندوب -->
                                <RowDefinition Height="*"/>  <!-- الجدول -->
                            </Grid.RowDefinitions>

                            <!-- العميل -->
                            <Grid Grid.Row="0"
                                  Background="{StaticResource DarkPurple}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="العميل"
                                           Style="{StaticResource SummaryLabel}"
                                           FontSize="12"/>
                                <TextBox Grid.Column="1"
                                         x:Name="txtClient"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="43" FontSize="13"
                                         VerticalContentAlignment="Center"
                                         KeyDown="txtClient_KeyDown"/>
                            </Grid>

                            <!-- المندوب -->
                            <Grid Grid.Row="1"
                                  Background="{StaticResource DarkPurple}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="المندوب"
                                           Style="{StaticResource SummaryLabel}"
                                           FontSize="11"/>
                                <TextBox Grid.Column="1"
                                         x:Name="txtSaleman"
                                         Style="{StaticResource DarkTextBox}"
                                         Height="25" FontSize="11"
                                         VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- جدول المجاميع -->
                            <Grid Grid.Row="2"
                                  Background="{StaticResource DarkPurple}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>

                                <!-- عدد البنود -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="عدد البنود"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         x:Name="txtItemsNo"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>

                                <!-- المجموع -->
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="المجموع"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="3"
                                         x:Name="txtSumVal"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>

                                <!-- إجمالي الكمية -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="إجمالي الكمية"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         x:Name="txtTotQuant"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>

                                <!-- الخصم -->
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="الخصم"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                         x:Name="txtDiscountVal"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>

                                <!-- المدفوع -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="المدفوع"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         x:Name="txtrec1"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>

                                <!-- إضافات -->
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="إضافات"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="2" Grid.Column="3"
                                         x:Name="txtAdditionVal"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>

                                <!-- الباقي -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="الباقي"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         x:Name="txtrecrem1"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>

                                <!-- الضريبة -->
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="الضريبة"
                                           Style="{StaticResource SummaryLabel}"/>
                                <TextBox Grid.Row="3" Grid.Column="3"
                                         x:Name="txtTotVAT"
                                         Text="0"
                                         Style="{StaticResource DarkTextBox}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ═══ DataGrid (GridControl1) ═══ -->
                    <Border Grid.Row="1"
                            Background="White">
                        <DataGrid x:Name="GridControl1"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                  RowStyle="{StaticResource DgvRow}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  FlowDirection="RightToLeft"
                                  Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#CCCCCC"
                                  AlternatingRowBackground="#F5F0FF"
                                  SelectionChanged="GridControl1_SelectionChanged"
                                  PreviewKeyDown="GridControl1_KeyDown"
                                  CellEditEnding="GridControl1_CellEditEnding"
                                  MouseDoubleClick="GridControl1_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu FlowDirection="RightToLeft"
                                             FontFamily="Cairo, Tahoma, Arial"
                                             FontSize="12">
                                    <MenuItem Header="📋 استعراض المادة"
                                              Click="CtxShowItemCard_Click"/>
                                    <MenuItem Header="➕ إضافة مادة"
                                              Click="CtxAddNewProduct_Click"/>
                                    <MenuItem Header="📏 الوحدات"
                                              Click="CtxShowItemUnits_Click"/>
                                    <MenuItem Header="🏬 مخزون الصنف"
                                              Click="CtxShowItemInvertory_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑️ حذف سجل"
                                              Click="CtxDeleteRow_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📊 حركة المادة"
                                              Click="CtxItemProcess_Click"/>
                                    <MenuItem Header="⏱ آخر حركة للمادة"
                                              Click="CtxItemLastActivity_Click"/>
                                    <MenuItem Header="⏱ آخر حركة للعميل"
                                              Click="CtxClientActivity_Click"/>
                                    <MenuItem Header="🔢 الرقم التسلسلي"
                                              Click="CtxItemSerialNo_Click"/>
                                    <MenuItem Header="💲 تكلفة المادة"
                                              Click="CtxItemCost_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📝 إضافة ملاحظة"
                                              Click="CtxAddNote_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding ItemRowIndex}"
                                                    Width="40" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- الصنف -->
                                <DataGridTextColumn Header="الصنف"
                                                    Binding="{Binding ItemName}"
                                                    Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- الوحدة -->
                                <DataGridTextColumn Header="الوحدة"
                                                    Binding="{Binding UnitName}"
                                                    Width="60" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- الكمية -->
                                <DataGridTextColumn Header="الكمية"
                                                    Binding="{Binding ItemQuantity, StringFormat=N2}"
                                                    Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- السعر -->
                                <DataGridTextColumn Header="السعر"
                                                    Binding="{Binding ItemPrice, StringFormat=N2}"
                                                    Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- الصافي -->
                                <DataGridTextColumn Header="الصافي"
                                                    Binding="{Binding ItemNetPrice, StringFormat=N2}"
                                                    Width="65" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- الضريبة -->
                                <DataGridTextColumn Header="الضريبة"
                                                    Binding="{Binding ItemVat, StringFormat=N2}"
                                                    Width="60" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- حذف -->
                                <DataGridTemplateColumn Header="🗑️"
                                                        Width="36" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️"
                                                    Tag="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="13"
                                                    Click="DeleteRowBtn_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- أعمدة مخفية -->
                                <DataGridTextColumn Binding="{Binding ItemId}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemCode}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemBarcode}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemRowIndex}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemSumPrice}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemDiscount}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemDiscountPerc}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemTotalPrice}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemVatPerc}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ValiableInvertory}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding InvertoryName}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding InvertoryId}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemCost}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding UnitEquality}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemPrimaryQnty}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemExpireDate}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemNotes}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding Description}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemPriceWithoutVAT}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemPriceDiscount}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemPriceAfterDiscount}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemAdditionalTaxPerc}"
                                                    Visibility="Collapsed"/>
                                <DataGridTextColumn Binding="{Binding ItemAdditionalTax}"
                                                    Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ═══ Items Panel (TileView بديل) ═══ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط التنقل بين الصفحات -->
                    <Grid Grid.Row="0"
                          Background="{StaticResource DarkPurple}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button x:Name="btnLast"
                                    Content="⏭"
                                    Style="{StaticResource NavItemBtn}"
                                    ToolTip="الأخير"
                                    Click="btnLast_Click"/>
                            <Button x:Name="btnNext"
                                    Content="▶"
                                    Style="{StaticResource NavItemBtn}"
                                    ToolTip="التالي"
                                    Margin="2,0"
                                    Click="btnNext_Click"/>
                            <Button x:Name="txtPageNo"
                                    Content="1"
                                    Style="{StaticResource NavItemBtn}"
                                    Width="65" FontSize="15"
                                    IsEnabled="False"/>
                            <Button x:Name="btnPrevious"
                                    Content="◀"
                                    Style="{StaticResource NavItemBtn}"
                                    ToolTip="السابق"
                                    Margin="2,0"
                                    Click="btnPrevious_Click"/>
                            <Button x:Name="btnFirst"
                                    Content="⏮"
                                    Style="{StaticResource NavItemBtn}"
                                    ToolTip="الأول"
                                    Click="btnFirst_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- عرض الأصناف كـ Tiles -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="WhiteSmoke">
                        <WrapPanel x:Name="ItemsPanel"
                                   Orientation="Horizontal"
                                   Margin="4"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ════ Row 1: البيان والباركود ════ -->
            <Border Grid.Row="1"
                    Background="{StaticResource LightGrayBg}"
                    Height="72">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="41"/>
                        <RowDefinition Height="31"/>
                    </Grid.RowDefinitions>

                    <!-- PnlInvNote: البيان + عميل نقدي -->
                    <Grid Grid.Row="0"
                          Background="{StaticResource LightGrayBg}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <!-- حقول العميل النقدي والبيان -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="21"/>
                            </Grid.RowDefinitions>

                            <!-- البيان -->
                            <TextBox Grid.Row="0"
                                     x:Name="txtNote"
                                     Background="{StaticResource LightGrayBg}"
                                     FontSize="11" FontWeight="Bold"
                                     TextAlignment="Center"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="txtNote_TextChanged"/>

                            <!-- عميل نقدي -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="BtnCashCust"
                                        Content="🔍"
                                        Background="#404040"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="11"
                                        Height="22"
                                        Cursor="Hand"
                                        Click="BtnCashCust_Click"/>
                                <TextBox Grid.Column="1"
                                         x:Name="TxtCashCustMobile"
                                         FontSize="11"
                                         BorderThickness="1"
                                         Height="21"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="جوال"
                                           FontSize="10" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <TextBox Grid.Column="3"
                                         x:Name="TxtCashCustName"
                                         FontSize="11"
                                         BorderThickness="1"
                                         Height="21"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Label عميل نقدي + البيان -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="البيان"
                                       FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="عميل نقدي"
                                       FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- PnlInvBarcode: الباركود -->
                    <Grid Grid.Row="1"
                          Background="{StaticResource LightGrayBg}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="btnMunalBarcode"
                                Content="\"
                                Background="{StaticResource MedGray}"
                                Foreground="White"
                                FontSize="14" FontWeight="Bold"
                                BorderThickness="0"
                                Height="31"
                                Cursor="Hand"
                                Click="btnMunalBarcode_Click"/>

                        <TextBox Grid.Column="1"
                                 x:Name="txtBarcode"
                                 Background="{StaticResource LightGrayBg}"
                                 FontSize="12"
                                 TextAlignment="Center"
                                 BorderThickness="0"
                                 Height="31"
                                 VerticalContentAlignment="Center"
                                 KeyDown="txtBarcode_KeyDown"
                                 GotFocus="txtBarcode_GotFocus"
                                 LostFocus="txtBarcode_LostFocus"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ════ Row 2: Hold Buttons + Pay Panel ════ -->
            <Grid Grid.Row="2"
                  Background="{StaticResource LightGrayBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="51"/>
                </Grid.RowDefinitions>

                <!-- أزرار التعليق (Hold) -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            FlowDirection="RightToLeft"
                            Background="{StaticResource LightGrayBg}">
                    <Button x:Name="Hold3Btn"
                            Content="3"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Margin="2"
                            Click="Hold3Btn_Click"/>
                    <Button x:Name="Hold1Btn"
                            Content="1"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Margin="2"
                            Click="Hold1Btn_Click"/>
                    <Button x:Name="Hold2Btn"
                            Content="2"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Margin="2"
                            Click="Hold2Btn_Click"/>
                    <Button x:Name="Hold4Btn"
                            Content="4"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Margin="2"
                            Click="Hold4Btn_Click"/>
                    <Button x:Name="Hold5Btn"
                            Content="5"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Margin="2"
                            Click="Hold5Btn_Click"/>
                    <Button x:Name="Hold6Btn"
                            Content="6"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Margin="2"/>
                    <Button x:Name="Hold7Btn"
                            Content="7"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Margin="2"/>
                    <Button x:Name="Hold8Btn"
                            Content="8"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Margin="2"/>
                    <Button x:Name="Hold9Btn"
                            Content="9"
                            Style="{StaticResource HoldBtn}"
                            Background="{StaticResource DarkGray}"
                            IsEnabled="False"
                            Visibility="Collapsed"
                            Margin="2"/>
                    <Button x:Name="btnHoldOrd"
                            Content="⏸ تعليق  F7"
                            Style="{StaticResource POSBtn}"
                            Background="{StaticResource OrangeBrush}"
                            Width="117" Height="40"
                            FontSize="11"
                            Margin="2"
                            Click="btnHoldOrd_Click"/>
                </StackPanel>

                <!-- حقل الصافي + زر الدفع -->
                <Grid Grid.Row="1"
                      Background="{StaticResource LightGrayBg}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <!-- الصافي -->
                    <Border Grid.Column="0"
                            Background="{StaticResource GreenBrush}">
                        <TextBlock x:Name="txtNet"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- زر الدفع -->
                    <Button Grid.Column="1"
                            x:Name="btnPay"
                            Content="💳 إدفع الآن  F6"
                            Style="{StaticResource PayNowBtn}"
                            Background="{StaticResource GreenBrush}"
                            Height="51"
                            Click="btnPay_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════
             Col 2: Right Panel
             ════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="49"/>   <!-- Panel2: رقم الفاتورة + تاريخ -->
                <RowDefinition Height="*"/>    <!-- أزرار العمليات + لوحة الأرقام -->
                <RowDefinition Height="69"/>   <!-- الخروج + قائمة -->
            </Grid.RowDefinitions>

            <!-- Panel2: رقم الفاتورة والوقت -->
            <Border Grid.Row="0"
                    Background="{StaticResource DarkPurple}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="27"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Name="lblTime"
                               Text="Time"
                               Foreground="White"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="lblDate"
                               Text="Date"
                               Foreground="White"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="txtOrderNo"
                             Background="{StaticResource LightGrayBg}"
                             Foreground="Black"
                             FontSize="11" FontWeight="Bold"
                             TextAlignment="Center"
                             IsReadOnly="True"
                             BorderThickness="1"
                             Height="25"
                             VerticalContentAlignment="Center"
                             Margin="3,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="txtNo"
                             Background="{StaticResource LightGrayBg}"
                             Foreground="Black"
                             FontSize="11" FontWeight="Bold"
                             TextAlignment="Center"
                             IsReadOnly="True"
                             BorderThickness="1"
                             Height="25"
                             VerticalContentAlignment="Center"
                             Margin="3,0"/>
                </Grid>
            </Border>

            <!-- أزرار العمليات + لوحة الأرقام -->
            <Grid Grid.Row="1"
                  Background="{StaticResource LightGrayBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="209"/> <!-- لوحة الأرقام + تنقل -->
                    <RowDefinition Height="*"/>   <!-- أزرار العمليات -->
                </Grid.RowDefinitions>

                <!-- لوحة التنقل بين الفواتير + الأرقام -->
                <Grid Grid.Row="0"
                      Background="{StaticResource LightGrayBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="39"/>  <!-- تنقل فواتير -->
                        <RowDefinition Height="*"/>   <!-- أرقام -->
                    </Grid.RowDefinitions>

                    <!-- تنقل بين الفواتير -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="btnPreviousInv"
                                Content="◀"
                                Style="{StaticResource POSBtn}"
                                Width="42" Height="37"
                                FontSize="16"
                                Background="{StaticResource DarkPurple}"
                                Margin="1"
                                Click="btnPreviousInv_Click"/>
                        <Button Grid.Column="1"
                                x:Name="btnInvSrch"
                                Content="🔍"
                                Style="{StaticResource POSBtn}"
                                Width="40" Height="37"
                                FontSize="16"
                                Background="{StaticResource DarkPurple}"
                                Margin="1"
                                Click="btnInvSrch_Click"/>
                        <Button Grid.Column="2"
                                x:Name="btnNextInv"
                                Content="▶"
                                Style="{StaticResource POSBtn}"
                                Width="46" Height="37"
                                FontSize="16"
                                Background="{StaticResource DarkPurple}"
                                Margin="1"
                                Click="btnNextInv_Click"/>
                    </Grid>

                    <!-- لوحة الأرقام -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0"
                                x:Name="cmd1"
                                Content="1"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd1_Click"/>
                        <Button Grid.Row="0" Grid.Column="1"
                                x:Name="cmd2"
                                Content="2"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd2_Click"/>
                        <Button Grid.Row="0" Grid.Column="2"
                                x:Name="cmd3"
                                Content="3"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd3_Click"/>

                        <Button Grid.Row="1" Grid.Column="0"
                                x:Name="cmd4"
                                Content="4"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd4_Click"/>
                        <Button Grid.Row="1" Grid.Column="1"
                                x:Name="cmd5"
                                Content="5"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd5_Click"/>
                        <Button Grid.Row="1" Grid.Column="2"
                                x:Name="cmd6"
                                Content="6"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd6_Click"/>

                        <Button Grid.Row="2" Grid.Column="0"
                                x:Name="cmd7"
                                Content="7"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd7_Click"/>
                        <Button Grid.Row="2" Grid.Column="1"
                                x:Name="cmd8"
                                Content="8"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd8_Click"/>
                        <Button Grid.Row="2" Grid.Column="2"
                                x:Name="cmd9"
                                Content="9"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd9_Click"/>

                        <Button Grid.Row="3" Grid.Column="0"
                                x:Name="cmdClearAll"
                                Content="C"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmdClearAll_Click"/>
                        <Button Grid.Row="3" Grid.Column="1"
                                x:Name="cmd0"
                                Content="0"
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmd0_Click"/>
                        <Button Grid.Row="3" Grid.Column="2"
                                x:Name="cmdDot"
                                Content="."
                                Style="{StaticResource NumPadBtn}"
                                Margin="1"
                                Click="cmdDot_Click"/>
                    </Grid>
                </Grid>

                <!-- أزرار العمليات الرئيسية -->
                <WrapPanel Grid.Row="1"
                           x:Name="BtnFlowPnl"
                           Orientation="Horizontal"
                           Background="{StaticResource LightGrayBg}">

                    <Button x:Name="btnPlus"
                            Content="＋"
                            Style="{StaticResource POSBtn}"
                            FontSize="26" FontWeight="Bold"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnPlus_Click"/>
                    <Button x:Name="btnUp"
                            Content="▲"
                            Style="{StaticResource POSBtn}"
                            FontSize="22"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnUp_Click"/>
                    <Button x:Name="btnMinus"
                            Content="－"
                            Style="{StaticResource POSBtn}"
                            FontSize="26" FontWeight="Bold"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnMinus_Click"/>
                    <Button x:Name="btnDown"
                            Content="▼"
                            Style="{StaticResource POSBtn}"
                            FontSize="22"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnDown_Click"/>

                    <Button x:Name="btnAddItem"
                            Content="الأصناف&#xA;F1"
                            Style="{StaticResource POSBtn}"
                            FontSize="10"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnAddItem_Click"/>
                    <Button x:Name="btnClient"
                            Content="العميل"
                            Style="{StaticResource POSBtn}"
                            FontSize="11"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnClient_Click"/>
                    <Button x:Name="btnQuantity"
                            Content="الكمية&#xA;F2"
                            Style="{StaticResource POSBtn}"
                            FontSize="10"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnQuantity_Click"/>
                    <Button x:Name="btnPostPon"
                            Content="آجل"
                            Style="{StaticResource POSBtn}"
                            FontSize="11"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnPostPon_Click"/>
                    <Button x:Name="btnPrice"
                            Content="السعر&#xA;F3"
                            Style="{StaticResource POSBtn}"
                            FontSize="10"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnPrice_Click"/>
                    <Button x:Name="btnAddUnit"
                            Content="الوحدة&#xA;F4"
                            Style="{StaticResource POSBtn}"
                            FontSize="10"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnAddUnit_Click"/>
                    <Button x:Name="RetSales"
                            Content="مرتجع&#xA;F11"
                            Style="{StaticResource POSBtn}"
                            FontSize="10"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="RetSales_Click"/>
                    <Button x:Name="btnDeleteRow"
                            Content="حذف سجل&#xA;F5"
                            Style="{StaticResource POSBtn}"
                            FontSize="10"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnDeleteRow_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️&#xA;طباعة"
                            Style="{StaticResource POSBtn}"
                            FontSize="11"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnCloseDay"
                            Content="إغلاق&#xA;اليومية F9"
                            Style="{StaticResource POSBtn}"
                            FontSize="9"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnCloseDay_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️&#xA;F8"
                            Style="{StaticResource POSBtn}"
                            FontSize="11"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnNew"
                            Content="جديد&#xA;F12"
                            Style="{StaticResource POSBtn}"
                            FontSize="10"
                            Background="{StaticResource DarkPurple}"
                            Margin="2"
                            Click="btnNew_Click"/>

                    <!-- حقل إدخال القيمة (txtVal1) -->
                    <TextBox x:Name="txtVal1"
                             Text="0"
                             Background="{StaticResource DarkPurple}"
                             Foreground="White"
                             BorderThickness="0"
                             Width="130" Height="20"
                             TextAlignment="Center"
                             FontSize="11" FontWeight="Bold"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed"/>
                </WrapPanel>
            </Grid>

            <!-- قائمة الخيارات + زر الخروج -->
            <Border Grid.Row="2"
                    Background="{StaticResource MedGray}">
                <StackPanel>
                    <!-- زر القائمة المنسدلة -->
                    <Button x:Name="btnMenuOptions"
                            Content="⚙️ خيارات"
                            Background="{StaticResource DarkPurple}"
                            Foreground="White"
                            BorderThickness="0"
                            Height="20"
                            FontSize="11" FontWeight="Bold"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            Width="52"
                            Click="btnMenuOptions_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ctxMenuOptions"
                                         FlowDirection="RightToLeft"
                                         FontFamily="Cairo, Tahoma, Arial"
                                         FontSize="12">
                                <MenuItem x:Name="stripImport"
                                          Header="📥 استيراد"
                                          Click="stripImport_Click"/>
                                <MenuItem x:Name="stripExport"
                                          Header="📤 تصدير"
                                          Click="stripExport_Click"/>
                                <Separator/>
                                <MenuItem x:Name="btnInvProfit"
                                          Header="💰 ربح الفاتورة"
                                          Click="btnInvProfit_Click"/>
                                <Separator/>
                                <MenuItem x:Name="BtnSaveDgvSettings"
                                          Header="💾 حفظ المظهر"
                                          Click="BtnSaveDgvSettings_Click"/>
                                <MenuItem x:Name="BtnRestoreDgvSettings"
                                          Header="🔄 إعادة الجدول الافتراضي"
                                          Click="BtnRestoreDgvSettings_Click"/>
                                <Separator/>
                                <MenuItem x:Name="StripImportInv"
                                          Header="📋 إدراج فاتورة"
                                          Click="StripImportInv_Click"/>
                                <MenuItem x:Name="BtnOpenReportDesgin"
                                          Header="🎨 تصميم التقرير"
                                          Click="BtnOpenReportDesgin_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- زر الخروج -->
                    <Button x:Name="btnClose"
                            Content="🚪 خروج"
                            Background="{StaticResource BrownBrush}"
                            Foreground="White"
                            BorderThickness="1"
                            BorderBrush="{StaticResource DarkGray}"
                            Height="38"
                            FontSize="13" FontWeight="Bold"
                            Cursor="Hand"
                            Margin="3,2,3,2"
                            Click="btnClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</dx:ThemedWindow>