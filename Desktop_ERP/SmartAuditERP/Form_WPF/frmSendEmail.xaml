<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSendEmail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="📧 البريد الإلكتروني"
    Width="420" Height="520"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="12,10" Margin="0,0,0,12">
            <TextBlock Text="📧 إرسال البريد الإلكتروني"
                       Foreground="White"
                       FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Fields -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0">
            <StackPanel>

                <!-- إلى -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📬 إلى:"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtTo" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"/>
                </Grid>

                <!-- الموضوع -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📌 الموضوع:"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSubject" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"/>
                </Grid>

                <!-- المحتوى -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📝 المحتوى:"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Top" Margin="0,6,6,0"/>
                    <TextBox x:Name="txtBody" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             Height="120" TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- المرفقات -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📎 المرفقات:"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="lnkAttachment" Grid.Column="1"
                               Text="إرفاق ملف"
                               Foreground="#3A63C3"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               MouseLeftButtonDown="lnkAttachment_Click"/>
                    <TextBlock x:Name="lblAttachments" Grid.Column="2"
                               Foreground="#555" FontSize="10"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- إيميل المرسل -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📨 إيميل المرسل:"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtEmail" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"/>
                </Grid>

                <!-- كلمة المرور -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔑 كلمة المرور:"
                               Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="txtPassword" Grid.Column="1"
                                 Style="{StaticResource ModernPasswordBox}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- زر الإرسال -->
        <Button x:Name="btnSend" Grid.Row="2"
                Content="📤 إرسال البريد"
                Height="44" Margin="16,8"
                FontSize="13" FontWeight="Bold"
                Foreground="White" Background="#2E4E9E"
                BorderThickness="0" Cursor="Hand"
                Click="btnSend_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A63C3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</dx:ThemedWindow>