<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSalesInvoice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="فاتورة مبيعات"
    WindowState="Maximized"
    MinWidth="1022" MinHeight="726"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DarkSlateBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B5998" Offset="0"/>
            <GradientStop Color="#2B4483" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Label Style ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- ═══ ModernTextBox ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ModernComboBox ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ ActionBtn ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource DarkSlateBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SmallAddBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <!-- ═══ DataGrid Column Header ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#4B7BFF"/>
        </Style>

        <!-- ═══ DataGrid Row ═══ -->
        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ DataGrid Cell Center ═══ -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- ═══ Summary Card ═══ -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5A6A8A"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════ -->
    <!--              MAIN LAYOUT                    -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- ═══════════════════════════════════════════════ -->
    <!--  TabControl1 يحتوي الفاتورة + البحث           -->
    <!-- ═══════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabControl1" Grid.Row="0"
                FontFamily="Cairo, Tahoma, Arial"
                FontSize="12" FontWeight="Bold"
                Background="#F3F5F9">

            <!-- ══════════════════════════════════════════ -->
            <!--  TabPage1: الفاتورة                        -->
            <!-- ══════════════════════════════════════════ -->
            <TabItem x:Name="TabPage1" Header="                  الفاتورة                   ">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ GroupBox3: Header Info ═══ -->
                    <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6"
                        Effect="{StaticResource CardShadow}">
                        <StackPanel>

                            <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="8" Padding="10,5" Margin="0,0,0,8">
                                <TextBlock Text="🧾 فاتورة مبيعات - بيانات الفاتورة"
                                       Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Row 1 -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="165"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="الرقم" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNo" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True" TextAlignment="Center"
                                     Background="#FFF0F0"/>

                                <TextBlock Grid.Column="3" Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtDate" Grid.Column="4"
                                          Height="30" FontSize="12" FontWeight="SemiBold"
                                          MaskType="DateTime" DisplayFormatString="d"/>

                                <TextBlock Grid.Column="6" Text="طريقة الدفع" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbPayType" Grid.Column="7"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectionChanged="cmbPayType_SelectionChanged">
                                    <ComboBoxItem Content="آجلة"/>
                                    <ComboBoxItem Content="نقدية"/>
                                    <ComboBoxItem Content="بنك"/>
                                </ComboBox>

                                <TextBlock Grid.Column="9" Text="البنك" Style="{StaticResource FieldLabel}"
                                       x:Name="lblBank"/>
                                <ComboBox x:Name="cmbBanks" Grid.Column="10"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>

                                <TextBlock Grid.Column="12" Text="الصندوق" Style="{StaticResource FieldLabel}"
                                       x:Name="lblSafe"/>
                                <ComboBox x:Name="cmbTreasury" Grid.Column="13"
                                      Style="{StaticResource ModernComboBox}"/>
                            </Grid>

                            <!-- Row 2 -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="رقم المرجع" Style="{StaticResource FieldLabel}"
                                       x:Name="lblRefNo"/>
                                <TextBox x:Name="txtRefNo" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="تاريخ المرجع" Style="{StaticResource FieldLabel}"
                                       x:Name="lblRefDate"/>
                                <dxe:DateEdit x:Name="txtRefDate" Grid.Column="4"
                                          Height="30" FontSize="12" FontWeight="SemiBold"
                                          IsEnabled="False"
                                          MaskType="DateTime" DisplayFormatString="d"/>

                                <TextBlock Grid.Column="6" Text="المستودع" Style="{StaticResource FieldLabel}"
                                       x:Name="lblStock"/>
                                <ComboBox x:Name="cmbStore" Grid.Column="7"
                                      Style="{StaticResource ModernComboBox}"/>

                                <TextBlock Grid.Column="9" Text="المندوب" Style="{StaticResource FieldLabel}"
                                       x:Name="lblSalesMen"/>
                                <ComboBox x:Name="cmbSalesMen" Grid.Column="10"
                                      Style="{StaticResource ModernComboBox}"/>
                                <Button x:Name="cmbAddSalesMen" Grid.Column="11"
                                    Content="➕" Style="{StaticResource SmallAddBtn}"
                                    ToolTip="إضافة مندوب" Click="cmbAddSalesMen_Click"/>

                                <TextBlock Grid.Column="13" Text="مركز التكلفة" Style="{StaticResource FieldLabel}"
                                       x:Name="lblCostCenter"/>
                                <ComboBox x:Name="cmbCostCenter" Grid.Column="14"
                                      Style="{StaticResource ModernComboBox}"/>
                                <Button x:Name="btnAddCostCenter" Grid.Column="15"
                                    Content="➕" Style="{StaticResource SmallAddBtn}"
                                    ToolTip="إضافة مركز تكلفة" Click="btnAddCostCenter_Click"/>
                            </Grid>

                            <!-- Row 3 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="310"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="اسم العميل" Style="{StaticResource FieldLabel}"
                                       x:Name="lblClient"/>
                                <ComboBox x:Name="cmbClient" Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      KeyDown="cmbClient_KeyDown"
                                      SelectionChanged="cmbClient_SelectionChanged"/>
                                <Button x:Name="btnCustAdd" Grid.Column="2"
                                    Content="➕" Style="{StaticResource SmallAddBtn}"
                                    ToolTip="إضافة عميل" Click="btnCustAdd_Click"/>

                                <TextBlock Grid.Column="4" Text="الرصيد" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtBalance" Grid.Column="5"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True" TextAlignment="Center"/>

                                <TextBlock Grid.Column="7" Text="البيان" Style="{StaticResource FieldLabel}"
                                       x:Name="lblNote"/>
                                <TextBox x:Name="txtNote" Grid.Column="8"
                                     Style="{StaticResource ModernTextBox}" TextAlignment="Center"/>

                                <Button x:Name="btnInsertLinkedInv" Grid.Column="10"
                                    Content="📥 إدراج" Style="{StaticResource ActionBtn}"
                                    Width="80" Click="btnInsertLinkedInv_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Panel4: Barcode + Radio ═══ -->
                    <Border Grid.Row="1"
                        Background="#EEF1FA"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="0,0,0,1"
                        Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="rdNormal" Grid.Column="0"
                                     Content="عادي" IsChecked="True"
                                     FontSize="12" FontWeight="Bold"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="rdAuto" Grid.Column="1"
                                     Content="تلقائي"
                                     FontSize="12" FontWeight="Bold"
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3" Text="الباركود"
                                   x:Name="lblBarcode" Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="txtBarcode" Grid.Column="7"
                                 Style="{StaticResource ModernTextBox}"
                                 TextAlignment="Center" KeyDown="txtBarcode_KeyDown"/>

                            <TextBlock Grid.Column="9" Text="🔍 بحث"
                                   Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSrchDgv" Grid.Column="10"
                                 Style="{StaticResource ModernTextBox}"
                                 KeyDown="txtSrchDgv_KeyDown"/>

                            <TextBlock Grid.Column="12" Text="➕ صنف" Style="{StaticResource FieldLabel}"/>
                            <Button x:Name="btnAddNewItem" Grid.Column="13"
                                Content="➕" Style="{StaticResource SmallAddBtn}"
                                ToolTip="إضافة صنف جديد" Click="btnAddNewItem_Click"/>
                        </Grid>
                    </Border>

                    <!-- ═══ Items DataGrid ═══ -->
                    <Border Grid.Row="2" Background="White"
                        Margin="4,4,4,0" CornerRadius="10"
                        Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📋 بنود الفاتورة"
                                           Style="{StaticResource GroupTitle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Content="🔍 بحث صنف"
                                            Style="{StaticResource ActionBtn}"
                                            Height="28" FontSize="10" Margin="2,0"
                                            Click="StripItemSearch_Click"/>
                                        <Button Content="🗑️ حذف بند"
                                            Style="{StaticResource DangerBtn}"
                                            Height="28" FontSize="10" Margin="2,0"
                                            Click="StripdeleteRow_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="dgvItems" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                  RowStyle="{StaticResource DgvRow}"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  FlowDirection="RightToLeft" Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8EBF5"
                                  AlternatingRowBackground="#F8F9FD"
                                  SelectionChanged="dgvItems_SelectionChanged"
                                  CellEditEnding="dgvItems_CellEditEnding"
                                  BeginningEdit="dgvItems_BeginningEdit">

                                <DataGrid.ContextMenu>
                                    <ContextMenu FlowDirection="RightToLeft">
                                        <MenuItem Header="🔍 بحث عن صنف" Click="StripItemSearch_Click"/>
                                        <MenuItem Header="📄 تفاصيل الصنف" Click="StripItemDetail_Click"/>
                                        <MenuItem Header="➕ إضافة صنف جديد" Click="StripAddNewItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="📦 وحدات الصنف" Click="StripItemUnits_Click"/>
                                        <MenuItem Header="🗂️ إضافة مجموعة" Click="StripAddGroup_Click"/>
                                        <MenuItem Header="🔢 الأرقام التسلسلية" Click="StripSerialNo_Click"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ حذف البند" Click="StripdeleteRow_Click"/>
                                        <Separator/>
                                        <MenuItem Header="📊 حركة الصنف" Click="StripItemProcess_Click"/>
                                        <MenuItem Header="🕐 آخر حركة للصنف" Click="StripLastItem_Click"/>
                                        <MenuItem Header="👤 آخر حركة للعميل" Click="StripClientLastItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="💰 متوسط تكلفة الصنف" Click="StripItemAvrgCost_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding RowNum}" Width="35" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="رمز الصنف" Binding="{Binding ItemCode}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="رقم الصنف" Binding="{Binding ItemId}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat='0.##'}" Width="65">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#1B4E9E"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التعادل" Binding="{Binding UnitEquality}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="إجمالي الكمية" Binding="{Binding PrimaryQnty}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="السعر" Binding="{Binding Price, StringFormat='0.00'}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المجموع" Binding="{Binding Total, StringFormat='0.00'}" Width="80" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#1B4E2A"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="متوسط التكلفة" Binding="{Binding AvgCost, StringFormat='0.00'}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الخصم" Binding="{Binding ItemDiscount, StringFormat='0.00'}" Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#B92F2F"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="نسبة الخصم" Binding="{Binding DiscPerc, StringFormat='0.##'}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding NetAfterDisc, StringFormat='0.00'}" Width="80" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#1B4E9E"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="نسبة الضريبة" Binding="{Binding VatPerc, StringFormat='0.##'}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الضريبة" Binding="{Binding VatVal, StringFormat='0.00'}" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الصافي" Binding="{Binding NetWithVat, StringFormat='0.00'}" Width="80" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#1B4E2A"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الكمية الحالية" Binding="{Binding CurrentStock}" IsReadOnly="True" Visibility="Collapsed"/>
                                    <DataGridComboBoxColumn Header="المستودع" SelectedValueBinding="{Binding StoreId}" Width="120"/>
                                    <DataGridTemplateColumn Header="حذف" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" Style="{StaticResource DangerBtn}"
                                                    Height="22" Width="36" FontSize="11"
                                                    Tag="{Binding}" Click="DeleteRowBtn_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ═══ GroupBox9: Summary Bottom ═══ -->
                    <Border Grid.Row="3" Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="0,1,0,0" Padding="8,6"
                        Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="460"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- Summary Cards -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="85">
                                        <StackPanel>
                                            <TextBlock Text="المجموع" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtSumVal" Style="{StaticResource SummaryValue}" Text="0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="85">
                                        <StackPanel>
                                            <TextBlock Text="الخصم" Style="{StaticResource SummaryLabel}" Foreground="#B92F2F"/>
                                            <TextBox x:Name="txtTotDiscount" Style="{StaticResource SummaryValue}" Text="0" Foreground="#B92F2F"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="85">
                                        <StackPanel>
                                            <TextBlock Text="الإجمالي" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtNetWithoutVAT" Style="{StaticResource SummaryValue}" Text="0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="85">
                                        <StackPanel>
                                            <TextBlock Text="الضريبة" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtTotVAT" Style="{StaticResource SummaryValue}" Text="0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="85">
                                        <StackPanel>
                                            <TextBlock Text="الصافي" Style="{StaticResource SummaryLabel}" Foreground="#1B4E2A" FontWeight="Bold"/>
                                            <TextBox x:Name="txtNet" Style="{StaticResource SummaryValue}" Text="0"
                                                 Foreground="#1B4E2A" FontWeight="Bold" FontSize="13"
                                                 MouseDoubleClick="txtNet_MouseDoubleClick"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="120">
                                        <StackPanel>
                                            <TextBlock Text="خصم الفاتورة" Style="{StaticResource SummaryLabel}" Foreground="#B92F2F"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="55"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtInvDiscPerc" Grid.Column="0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Height="26" FontSize="11" Text="0" Foreground="#B92F2F"
                                                     TextAlignment="Center"
                                                     LostFocus="txtInvDiscPerc_LostFocus"
                                                     KeyDown="txtInvDiscPerc_KeyDown"/>
                                                <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" Foreground="#B92F2F" FontWeight="Bold"/>
                                                <TextBox x:Name="txtInvDiscVal" Grid.Column="2"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Height="26" FontSize="11" Text="0" Foreground="#B92F2F"
                                                     TextAlignment="Center"
                                                     LostFocus="txtInvDiscVal_LostFocus"
                                                     KeyDown="txtInvDiscVal_KeyDown"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="85"
                                        x:Name="pnlInvProfit" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="lblInvProfit" Text="ربح الفاتورة" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtInvProfit" Style="{StaticResource SummaryValue}" Text="0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" MinWidth="85"
                                        x:Name="pnlSumCost" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="lblSumCostAvrg" Text="مجموع متوسط التكلفة" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtSumCostAvrg" Style="{StaticResource SummaryValue}" Text="0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="6,0,0,0" BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1" CornerRadius="4" Width="80" Height="60">
                                        <Image x:Name="PictureBox1" Stretch="Uniform"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Item Info -->
                            <Grid Grid.Column="1" Margin="8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="95"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="الباركود:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtItemBarcode" Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="آخر سعر بيع:" Style="{StaticResource FieldLabel}" Margin="0,4,4,0"/>
                                <TextBox x:Name="txtLastSalePrice" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="سعر آخر شراء:" Style="{StaticResource FieldLabel}" Margin="0,4,4,0"/>
                                <TextBox x:Name="txtRecentPurchPrice" Grid.Row="1" Grid.Column="4"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,4,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="سعر المنافس:" Style="{StaticResource FieldLabel}" Margin="0,4,4,0"/>
                                <TextBox x:Name="txtCompetitorPrice" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="متوسط التكلفة:" Style="{StaticResource FieldLabel}" Margin="0,4,4,0"/>
                                <TextBox x:Name="txtCostAvrg" Grid.Row="2" Grid.Column="4"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,4,0,0"/>
                            </Grid>

                            <!-- Qty Info -->
                            <Grid Grid.Column="2" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="عدد البنود:" x:Name="lblTirmsNo"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,4,3"/>
                                <TextBox x:Name="txtTirmsNo" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,0,0,3"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="إجمالي الكمية:" x:Name="lblTotQuan"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,4,3"/>
                                <TextBox x:Name="txtTotQuan" Grid.Row="1" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,0,0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="الكمية الحالية:" x:Name="lblCurrentqty"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,4,3"/>
                                <TextBox x:Name="txtStock" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,0,0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="التعادل:" x:Name="lblPerUnit"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,4,3"/>
                                <TextBox x:Name="txtPerUnit" Grid.Row="3" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,0,0,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="كمية و/س:" x:Name="lblTotUnitQuan"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,4,3"/>
                                <TextBox x:Name="txtTotUnitQuan" Grid.Row="4" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}" Height="24" FontSize="10"
                                     IsReadOnly="True" TextAlignment="Center" Margin="0,0,0,3"/>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════ -->
            <!--  TabPage2: البحث                           -->
            <!-- ══════════════════════════════════════════ -->
            <TabItem x:Name="TabPage2" Header="                   البحث                   ">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ GroupBox6: حقول البحث ═══ -->
                    <Border Grid.Row="0" Background="White"
                        CornerRadius="10" Margin="6,6,6,0"
                        Padding="12,10"
                        Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="8" Padding="10,5" Margin="0,0,0,10">
                                <TextBlock Text="🔍 البحث في الفواتير"
                                       Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Row 1: الرقم | من تاريخ | إلى تاريخ -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="الرقم"
                                       Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSrchNo" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     TextAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="من تاريخ"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="8,0,4,0"/>
                                <dxe:DateEdit x:Name="txtFromDate" Grid.Column="4"
                                          Height="30" FontSize="12" FontWeight="SemiBold"
                                          MaskType="DateTime" DisplayFormatString="d"/>

                                <TextBlock Grid.Column="5" Text="إلى تاريخ"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="8,0,4,0"/>
                                <dxe:DateEdit x:Name="txtToDate" Grid.Column="7"
                                          Height="30" FontSize="12" FontWeight="SemiBold"
                                          MaskType="DateTime" DisplayFormatString="d"/>
                            </Grid>

                            <!-- Row 2: رقم المرجع | العميل | الكل | بحث -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="رقم المرجع"
                                       Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSrchreffNo" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     TextAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="العميل"
                                       Style="{StaticResource FieldLabel}"
                                       x:Name="lblClientSrch"/>
                                <ComboBox x:Name="cmbClientSrch" Grid.Column="4"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>

                                <CheckBox x:Name="chkAll" Grid.Column="6"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontSize="12" FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Checked="chkAll_CheckedChanged"
                                      Unchecked="chkAll_CheckedChanged"/>

                                <Button Grid.Column="8"
                                    Content="🔍 بحث"
                                    Style="{StaticResource ActionBtn}"
                                    Width="100" Height="36"
                                    Click="btnSearch_Click"/>
                            </Grid>

                            <!-- نوع مخفي (cmbProcTypeSrch) -->
                            <ComboBox x:Name="cmbProcTypeSrch"
                                  Visibility="Collapsed"
                                  IsEnabled="False"/>
                            <ComboBox x:Name="cmbProcType"
                                  Visibility="Collapsed"
                                  IsEnabled="False"/>

                        </StackPanel>
                    </Border>

                    <!-- ═══ GroupBox4: نتائج البحث ═══ -->
                    <Border Grid.Row="1" Background="White"
                        CornerRadius="10" Margin="6,6,6,6"
                        Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                       Style="{StaticResource GroupTitle}"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                  RowStyle="{StaticResource DgvRow}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  FlowDirection="RightToLeft" Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8EBF5"
                                  AlternatingRowBackground="#F8F9FD"
                                  MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الحركة"
                                                    Binding="{Binding InvGlobalID}"
                                                    Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الرقم"
                                                    Binding="{Binding InvNo}"
                                                    Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="رقم المرجع"
                                                    Binding="{Binding ReffNo}"
                                                    Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التاريخ"
                                                    Binding="{Binding InvDate}"
                                                    Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="العميل"
                                                    Binding="{Binding ClientName}"
                                                    Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
            Background="{StaticResource FooterBrush}"
            Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose" Grid.Column="0"
                    Content="✖" Style="{StaticResource DangerBtn}"
                    Width="40" ToolTip="خروج" Margin="0,0,4,0"
                    Click="btnClose_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnFirst" Content="⏮" Style="{StaticResource NavBtn}"
                        ToolTip="الأول" Margin="0,0,3,0" Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀" Style="{StaticResource NavBtn}"
                        ToolTip="السابق" Margin="0,0,3,0" Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext" Content="▶" Style="{StaticResource NavBtn}"
                        ToolTip="التالي" Margin="0,0,3,0" Click="btnNext_Click"/>
                    <Button x:Name="btnLast" Content="⏭" Style="{StaticResource NavBtn}"
                        ToolTip="الأخير" Margin="0,0,6,0" Click="btnLast_Click"/>
                    <Button x:Name="btnInvSrch" Content="🔍" Style="{StaticResource NavBtn}"
                        ToolTip="بحث في الفواتير" Click="btnInvSrch_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#FFFFFF22" CornerRadius="6" Padding="4,2" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ أدوات:" Foreground="White" FontWeight="Bold" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="📥 استيراد" Style="{StaticResource ActionBtn}"
                                Height="32" FontSize="10" Margin="2,0" Click="stripImport_Click"/>
                            <Button Content="📤 تصدير" Style="{StaticResource ActionBtn}"
                                Height="32" FontSize="10" Margin="2,0" Click="stripExport_Click"/>
                            <Button Content="🎨 تخصيص" Style="{StaticResource ActionBtn}"
                                Height="32" FontSize="10" Margin="2,0" Click="btnCustomizeDisplay_Click"/>
                            <Button Content="💰 ربح" Style="{StaticResource ActionBtn}"
                                Height="32" FontSize="10" Margin="2,0" Click="StripProfit_Click"/>
                            <Button Content="📒 القيد" Style="{StaticResource ActionBtn}"
                                Height="32" FontSize="10" Margin="2,0" Click="BTnShowEntry_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- txtInvTax مخفي -->
                    <TextBox x:Name="txtInvTax" Visibility="Collapsed"
                         Width="80" Height="26" TextAlignment="Center"
                         IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BtnReceipts" Content="🧾 سند قبض"
                        Style="{StaticResource ActionBtn}" Height="40" FontSize="10"
                        Margin="0,0,4,0" Visibility="Collapsed" Click="BtnReceipts_Click"/>
                    <Button x:Name="btnView" Content="👁️" Style="{StaticResource NavBtn}"
                        ToolTip="معاينة" Margin="0,0,3,0" Click="btnView_Click"/>
                    <Button x:Name="btnPrint" Content="🖨️" Style="{StaticResource NavBtn}"
                        ToolTip="طباعة" Margin="0,0,3,0" Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete" Content="🗑️ حذف" Style="{StaticResource DangerBtn}"
                        Width="80" Margin="0,0,3,0" Click="btnDelete_Click"/>
                    <Button x:Name="btnSave" Content="💾 حفظ" Style="{StaticResource SaveBtn}"
                        Width="80" Margin="0,0,3,0" Click="btnSave_Click"/>
                    <Button x:Name="btnSavePrint" Content="💾🖨️ حفظ+طباعة"
                        Style="{StaticResource ActionBtn}" Width="110" Margin="0,0,3,0"
                        Click="btnSavePrint_Click"/>
                    <Button x:Name="btnNew" Content="➕ جديد" Style="{StaticResource ActionBtn}"
                        Width="80" Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
