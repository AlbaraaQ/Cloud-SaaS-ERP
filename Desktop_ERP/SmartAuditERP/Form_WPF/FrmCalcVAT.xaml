<Window x:Class="SmartAuditERP.Form_WPF.FrmCalcVAT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🧮 حاسبة الضريبة"
        Width="420"
        Height="310"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <!-- ═══════════════ GRADIENTS ═══════════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1565C0" Offset="0"/>
            <GradientStop Color="#1976D2" Offset="0.5"/>
            <GradientStop Color="#42A5F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F0F7FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InsertButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#283593" Offset="0"/>
            <GradientStop Color="#3949AB" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════ SHADOWS ═══════════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Direction="270" Opacity="0.3"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="FieldShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.12"
                          Color="#44000000"/>

        <!-- ═══════════════ TEXTBOX STYLE ═══════════════ -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Effect="{StaticResource FieldShadow}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#EEF5FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#BBDEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ READ-ONLY TEXTBOX ═══════════════ -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="Background" Value="#EEF5FF"/>
        </Style>

        <!-- ═══════════════ LABEL STYLE ═══════════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════ CLOSE BUTTON ═══════════════ -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ INSERT BUTTON ═══════════════ -->
        <Style x:Key="InsertButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource InsertButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{StaticResource WindowShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════ WINDOW BORDER ═══════════════ -->
    <Border CornerRadius="16"
            Background="{StaticResource CardBrush}"
            BorderBrush="#BBDEFB"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── HEADER ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="Window_Close_Click"
                            ToolTip="إغلاق">
                        <TextBlock Text="✖"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="🧮" FontSize="22" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="حاسبة الضريبة المضافة"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="15"
                                       FontWeight="Bold"/>
                            <TextBlock Text="احسب السعر بدون الضريبة تلقائياً"
                                       Foreground="#BBDEFB"
                                       FontFamily="Tahoma"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── CONTENT ─── -->
            <Grid Grid.Row="1" Margin="24,18,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- السعر مع الضريبة -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtPriceWithVAT"
                             Grid.Column="0"
                             Style="{StaticResource ModernTextBoxStyle}"
                             TextChanged="txtPriceWithVAT_TextChanged"
                             PreviewKeyDown="txtPriceWithVAT_PreviewKeyDown" Margin="122,0,2,0" Grid.ColumnSpan="2"/>

                    <TextBlock
                               Text="💰 السعر مع الضريبة"
                               Style="{StaticResource FieldLabelStyle}" Margin="-18,0,0,0" HorizontalAlignment="Left"/>
                </Grid>

                <!-- السعر بدون الضريبة -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtPriceWithOutVAT"
                             Grid.Column="0"
                             Style="{StaticResource ReadOnlyTextBoxStyle}" Margin="125,0,2,0" Grid.ColumnSpan="2"/>

                    <TextBlock
                               Text="🏷️ السعر بدون الضريبة"
                               Style="{StaticResource FieldLabelStyle}" Margin="-17,14,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                </Grid>

                <!-- الضريبة -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtVAT"
                             Grid.Column="0"
                             Style="{StaticResource ReadOnlyTextBoxStyle}" Margin="125,0,0,0" Grid.ColumnSpan="2"/>

                    <TextBlock
                               Text="📊 قيمة الضريبة"
                               Style="{StaticResource FieldLabelStyle}" Margin="-17,0,0,0" HorizontalAlignment="Left"/>
                </Grid>

                <!-- زر الإدراج -->
                <Button x:Name="btnOk"
                        Grid.Row="6"
                        Style="{StaticResource InsertButtonStyle}"
                        Click="btnOk_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅" FontSize="15" Margin="0,0,8,0"/>
                        <TextBlock Text="إدراج"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Grid>
    </Border>
</Window>