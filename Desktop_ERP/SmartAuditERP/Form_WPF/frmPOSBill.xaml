<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmPOSBill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="دفع الفاتورة"
    Width="960" Height="760"
    MinWidth="900" MinHeight="720"
    WindowStartupLocation="CenterScreen"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ShowInTaskbar="False"
    ResizeMode="NoResize"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ActiveGreen"   Color="#2ECC71"/>
        <SolidColorBrush x:Key="InactiveGray"  Color="#BDC3C7"/>
        <SolidColorBrush x:Key="DangerRed"     Color="#E74C3C"/>
        <SolidColorBrush x:Key="LightBg"       Color="#ECF0F1"/>
        <SolidColorBrush x:Key="BorderLight"   Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.14" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="5" ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <!-- ═══ Styles ═══ -->

        <!-- لوحة المفاتيح الرقمية -->
        <Style x:Key="NumpadBtn" TargetType="Button">
            <Setter Property="Width"  Value="80"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource LightBg}"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D5DBDB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A9B1B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار الفئات النقدية -->
        <Style x:Key="CoinBtn" TargetType="Button">
            <Setter Property="Width"  Value="205"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource LightBg}"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D5DBDB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A9B1B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار طرق الدفع / نوع الطلب -->
        <Style x:Key="OptionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource InactiveGray}"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر الدفع الكبير -->
        <Style x:Key="PayBtn" TargetType="Button">
            <Setter Property="Height" Value="62"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ActiveGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelPayBtn" TargetType="Button" BasedOn="{StaticResource PayBtn}">
            <Setter Property="Background" Value="{StaticResource DangerRed}"/>
        </Style>

        <Style x:Key="SameBtn" TargetType="Button" BasedOn="{StaticResource PayBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00BCD4" Offset="0"/>
                        <GradientStop Color="#0097A7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- حقل الإدخال الكبير -->
        <Style x:Key="BigInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource LightBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- حقل القراءة فقط -->
        <Style x:Key="ReadonlyBox" TargetType="TextBox" BasedOn="{StaticResource BigInputBox}">
            <Setter Property="Background" Value="#D5DBDB"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- علامة البيانات -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2980B9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DiscountLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══ تخطيط رئيسي ═══ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- المنطقة الرئيسية -->
            <ColumnDefinition Width="*"/>
            <!-- لوحة الفئات النقدية -->
            <ColumnDefinition x:Name="coinColumn" Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!--            المنطقة الرئيسية                    -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- شريط طرق الدفع وأنواع الطلب والإضافات -->
                <RowDefinition Height="Auto"/>
                <!-- صافي الفاتورة -->
                <RowDefinition Height="Auto"/>
                <!-- حقول الدفع -->
                <RowDefinition Height="Auto"/>
                <!-- لوحة الأرقام + أزرار الدفع -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════ -->
            <!--   الشريط العلوي: طرق الدفع + نوع الطلب   -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    FlowDirection="RightToLeft"
                    BorderThickness="0,0,0,1"
                    Padding="8,6"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>

                    <!-- صف 1: طرق الدفع -->
                    <WrapPanel Orientation="Horizontal"
                               Margin="0,0,0,4">

                        <Button x:Name="btnCash"
                                Content="💵 كاش"
                                Style="{StaticResource OptionBtn}"
                                Background="{StaticResource ActiveGreen}"
                                Foreground="White"
                                Width="110"
                                Click="btnCash_Click"/>

                        <Button x:Name="btnNetwork"
                                Content="🖧 شبكة"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Click="btnNetwork_Click"/>

                        <Button x:Name="btnATM"
                                Content="🏧 ATM"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Click="btnATM_Click"/>

                        <Button x:Name="btnVisa"
                                Content="💳 فيزا"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="btnVisa_Click"/>

                        <Button x:Name="btnMulti"
                                Content="🔀 متعدد"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="btnMulti_Click"/>

                        <Button x:Name="btnHosting"
                                Content="🍽️ ضيافة"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="btnHosting_Click"/>

                        <Button x:Name="BtnBank"
                                Content="🏦 تحويل"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="BtnBank_Click"/>

                        <Button x:Name="BtnMultiCredit"
                                Content="📋 متعدد آجل"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Visibility="Collapsed"
                                Click="BtnMultiCredit_Click"/>

                        <Button x:Name="btnPayPostpone"
                                Content="⏳ آجل"
                                Style="{StaticResource OptionBtn}"
                                Width="80"
                                Visibility="Collapsed"
                                Click="btnPayPostpone_Click"/>
                    </WrapPanel>

                    <!-- صف 2: نوع الطلب -->
                    <WrapPanel Orientation="Horizontal"
                               Margin="0,0,0,4">
                        <Button x:Name="btnlocal"
                                Content="🏠 محلي"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Click="btnlocal_Click"/>
                        <Button x:Name="btnAway"
                                Content="🛵 سفري"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Click="btnAway_Click"/>
                        <Button x:Name="btnTable"
                                Content="🪑 طاولة"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Click="btnTable_Click"/>
                        <Button x:Name="btnCar"
                                Content="🚗 سيارة"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Click="btnCar_Click"/>
                        <Button x:Name="btnFamily"
                                Content="👨‍👩‍👧 عوائل"
                                Style="{StaticResource OptionBtn}"
                                Width="100"
                                Click="btnFamily_Click"/>
                    </WrapPanel>

                    <!-- صف 3: الإضافات والخصومات -->
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="btnDelv"
                                Content="🛵 توصيل"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="btnDelv_Click"/>
                        <TextBox x:Name="txtDevM"
                                 Style="{StaticResource ReadonlyBox}"
                                 Width="80" Height="36"
                                 Text="0"
                                 Margin="2,2"/>

                        <Button x:Name="btnRahn"
                                Content="🔒 تأمين"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="btnRahn_Click"/>
                        <TextBox x:Name="txtRahn"
                                 Style="{StaticResource ReadonlyBox}"
                                 Width="80" Height="36"
                                 Text="0"
                                 Margin="2,2"
                                 LostFocus="txtRahn_LostFocus"
                                 KeyDown="txtRahn_KeyDown"/>

                        <Button x:Name="btnDiscount"
                                Content="🏷️ خصم"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="btnDiscount_Click"/>
                        <TextBox x:Name="txtInvDiscount"
                                 Style="{StaticResource ReadonlyBox}"
                                 Width="80" Height="36"
                                 Text="0"
                                 Margin="2,2"
                                 LostFocus="txtInvDiscVal_Leave"
                                 KeyDown="txtInvDiscVal_KeyDown"/>

                        <Button x:Name="btnDiscoPerc"
                                Content="% خصم"
                                Style="{StaticResource OptionBtn}"
                                Width="90"
                                Click="btnDiscoPerc_Click"/>
                        <TextBox x:Name="txtDiscoPerc"
                                 Style="{StaticResource ReadonlyBox}"
                                 Width="80" Height="36"
                                 Text="0"
                                 Margin="2,2"
                                 LostFocus="txtInvDiscPerc_Leave"
                                 KeyDown="txtInvDiscPerc_KeyDown"/>
                    </WrapPanel>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════ -->
            <!--          صافي الفاتورة والخصومات          -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="White"
                    Margin="6,6,6,0"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- صافي الفاتورة -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="lblNetVal"
                                   Text="0"
                                   Style="{StaticResource ValueLabel}"
                                   FontSize="26"
                                   Foreground="#2980B9"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="📄 صافي الفاتورة"
                                   Style="{StaticResource InfoLabel}"
                                   FontSize="16"/>
                    </StackPanel>

                    <Separator Grid.Column="1"
                               Width="1"
                               Background="{StaticResource BorderLight}"
                               Margin="10,0"/>

                    <!-- الخصومات -->
                    <StackPanel x:Name="Panel3"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="txtTotDiscounts"
                                   Text="0"
                                   Style="{StaticResource DiscountLabel}"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="🏷️ خصومات"
                                   Style="{StaticResource InfoLabel}"
                                   FontSize="15"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════ -->
            <!--            حقول قيم الدفع                 -->
            <!-- ══════════════════════════════════════════ -->
            <StackPanel Grid.Row="2"
                        Margin="6,6,6,0">

                <!-- الباقي -->
                <Border Background="White"
                        CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtrecrem1"
                                 Grid.Column="0"
                                 Style="{StaticResource ReadonlyBox}"
                                 Text="0"/>
                        <TextBlock Grid.Column="1"
                                   Text="💰 الباقي"
                                   Style="{StaticResource InfoLabel}"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- نقداً -->
                <Border Background="White"
                        CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtCashpay"
                                 Grid.Column="0"
                                 Style="{StaticResource BigInputBox}"
                                 Text="0"
                                 TextChanged="txtCashpay_TextChanged"/>
                        <TextBlock Grid.Column="1"
                                   Text="💵 نقداً"
                                   Style="{StaticResource InfoLabel}"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- شبكة / فيزا -->
                <Border Background="White"
                        CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtNetwork"
                                 Grid.Column="0"
                                 Style="{StaticResource BigInputBox}"
                                 IsReadOnly="True"
                                 Text="0"
                                 TextChanged="txtNetwork_TextChanged"/>
                        <TextBlock Grid.Column="1"
                                   Text="🖧 شبكة / فيزا"
                                   Style="{StaticResource InfoLabel}"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- مجموع الفاتورة (مخفي مبدئيًا) -->
                <Border x:Name="Panel7"
                        Background="White"
                        CornerRadius="8"
                        Effect="{StaticResource CardShadow}"
                        Padding="10,6"
                        Margin="0,0,0,4"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtInvSum"
                                   Grid.Column="0"
                                   Text="0"
                                   Style="{StaticResource DiscountLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="📊 المجموع"
                                   Style="{StaticResource InfoLabel}"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Border>

            </StackPanel>

            <!-- ══════════════════════════════════════════ -->
            <!--       لوحة الأرقام + أزرار الدفع          -->
            <!-- ══════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="6,6,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار الدفع الكبيرة -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,0">
                    <Button x:Name="btnSame"
                            Content="⚖️ F6 مطابقة"
                            Style="{StaticResource SameBtn}"
                            Margin="0,0,0,6"
                            Click="btnSame_Click"/>
                    <Button x:Name="save"
                            Content="✔ دفع"
                            Style="{StaticResource PayBtn}"
                            Margin="0,0,0,6"
                            Click="save_Click"/>
                    <Button x:Name="btnCancel"
                            Content="✖ إغلاق"
                            Style="{StaticResource CancelPayBtn}"
                            Click="btnCancel_Click"/>
                </StackPanel>

                <!-- لوحة المفاتيح الرقمية -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}"
                        Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- صف 7-8-9 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="cmd7" Content="7" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd8" Content="8" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd9" Content="9" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                        </StackPanel>

                        <!-- صف 4-5-6 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="cmd4" Content="4" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd5" Content="5" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd6" Content="6" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                        </StackPanel>

                        <!-- صف 1-2-3 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="cmd135" Content="1" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd2"   Content="2" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmd3"   Content="3" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                        </StackPanel>

                        <!-- صف 0 - . - C -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="cmd0"       Content="0" Style="{StaticResource NumpadBtn}" Click="NumpadDigit_Click"/>
                            <Button x:Name="cmdDot"     Content="." Style="{StaticResource NumpadBtn}" Click="NumpadDot_Click"/>
                            <Button x:Name="cmdClearAll"
                                    Content="⌫"
                                    Style="{StaticResource NumpadBtn}"
                                    Background="{StaticResource DangerRed}"
                                    Foreground="White"
                                    Click="cmdClearAll_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!--       لوحة الفئات النقدية (يمين)               -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border x:Name="FpnlCoin"
                Grid.Column="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1,0,0,0"
                Padding="8,10">
            <StackPanel VerticalAlignment="Top">

                <TextBlock Text="💵 الفئات النقدية"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <Button x:Name="btnOne"
                        Content="1"
                        Style="{StaticResource CoinBtn}"
                        Click="btnOne_Click"/>

                <Button x:Name="btnFive"
                        Content="5"
                        Style="{StaticResource CoinBtn}"
                        Click="btnFive_Click"/>

                <Button x:Name="btnTen"
                        Content="10"
                        Style="{StaticResource CoinBtn}"
