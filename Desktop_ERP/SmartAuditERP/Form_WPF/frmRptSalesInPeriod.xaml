<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptSalesInPeriod"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="حركة المبيعات"
    Width="1100" Height="680"
    MinWidth="1000" MinHeight="580"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F5F7FB"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1DB954" Offset="0"/>
            <GradientStop Color="#158A3E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A90D9" Offset="0"/>
            <GradientStop Color="#2E6DA8" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="ExportBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>
        <Style x:Key="PrintBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE6F8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1B3A6B"/>
        </Style>

        <Style x:Key="SummaryBar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FooterBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- المحتوى الرئيسي -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Sidebar يسار -->
                <ColumnDefinition Width="220"/>
                <!-- المحتوى الرئيسي -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════ SIDEBAR ════ -->
            <Border Grid.Column="0"
                    Background="#F0F3F8"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,10,10,10">

                        <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="8" Padding="8,7" Margin="0,0,0,10">
                            <TextBlock Text="⚙️ إدخال التاريخ"
                                       Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- نوع الفاتورة -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="🧾 نوع الفاتورة"
                                               Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <ComboBox x:Name="cmbInvType"
                                          Height="28" FontSize="11">
                                    <ComboBoxItem Content="مبيعات نقطة البيع"/>
                                    <ComboBoxItem Content="مبيعات عادية"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- التواريخ -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="📅 التواريخ"
                                               Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>

                                <TextBlock Text="من التاريخ" FontSize="10" FontWeight="Bold"
                                           Foreground="#555" Margin="0,0,0,2"/>
                                <dxe:DateEdit x:Name="date1"
                                              Height="28" FontSize="11" Margin="0,0,0,4"/>

                                <TextBlock Text="الوقت (HH:mm:ss)" FontSize="10" FontWeight="Bold"
                                           Foreground="#555" Margin="0,0,0,2"/>
                                <TextBox x:Name="time1"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="00:00:00" Margin="0,0,0,6"/>

                                <TextBlock Text="إلى التاريخ" FontSize="10" FontWeight="Bold"
                                           Foreground="#555" Margin="0,0,0,2"/>
                                <dxe:DateEdit x:Name="date2"
                                              Height="28" FontSize="11" Margin="0,0,0,4"/>

                                <TextBlock Text="الوقت (HH:mm:ss)" FontSize="10" FontWeight="Bold"
                                           Foreground="#555" Margin="0,0,0,2"/>
                                <TextBox x:Name="time2"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="23:59:59"/>
                            </StackPanel>
                        </Border>

                        <!-- أزرار العرض -->
                        <Button x:Name="btnShow"
                                Content="📊 إجمالي حركة المواد"
                                Style="{StaticResource ActionBtn}"
                                Height="38" Margin="0,0,0,6"
                                Click="btnShow_Click"/>

                        <Button x:Name="btnShowInvs"
                                Content="🧾 عرض الفواتير"
                                Style="{StaticResource PrintBtn}"
                                Height="38"
                                Click="btnShowInvs_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ════ المحتوى الرئيسي: TabControl ════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Progress -->
                </Grid.RowDefinitions>

                <TabControl x:Name="TabControl1"
                            Grid.Row="0"
                            FlowDirection="RightToLeft"
                            Margin="6,6,6,4">

                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="12,6"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- التبويب الأول: إجمالي المبيعات -->
                    <TabItem Header="📊 إجمالي المبيعات">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <!-- مجموع -->
                            </Grid.RowDefinitions>

                            <!-- جدول الأصناف -->
                            <Border Grid.Row="0" Background="White" CornerRadius="8"
                                    Effect="{StaticResource CardShadow}">
                                <DataGrid x:Name="dgvItems"
                                          AutoGenerateColumns="False"
                                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                          RowStyle="{StaticResource DgvRow}"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          FlowDirection="RightToLeft"
                                          Background="White"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E8EBF5"
                                          AlternatingRowBackground="#F8F9FD"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="رقم الصنف"
                                                            Binding="{Binding ItemId}"
                                                            Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الصنف"
                                                            Binding="{Binding ItemName}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الكمية"
                                                            Binding="{Binding Quantity, StringFormat=N2}"
                                                            Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الإجمالي"
                                                            Binding="{Binding Total, StringFormat=N2}"
                                                            Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- مجموع المبيعات - التبويب 1 -->
                            <Border Grid.Row="1" Background="{StaticResource FooterBrush}"
                                    Padding="10,6" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="💰 إجمالي المبيعات:"
                                               Foreground="White" FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txtSumSale"
                                               Text="0.00"
                                               Foreground="#FFE082" FontWeight="Bold" FontSize="16"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- التبويب الثاني: عرض الفواتير -->
                    <TabItem Header="🧾 عرض الفواتير">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- جدول الفواتير -->
                            <Border Grid.Row="0" Background="White" CornerRadius="8"
                                    Effect="{StaticResource CardShadow}">
                                <DataGrid x:Name="dgvSrch"
                                          AutoGenerateColumns="False"
                                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                          RowStyle="{StaticResource DgvRow}"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          FlowDirection="RightToLeft"
                                          Background="White"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E8EBF5"
                                          AlternatingRowBackground="#F8F9FD"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>

                                        <!-- رقم الحركة مخفي -->
                                        <DataGridTextColumn Header="رقم الحركة"
                                                            Binding="{Binding InvGlobalID}"
                                                            Width="0" Visibility="Collapsed"/>

                                        <DataGridTextColumn Header="رقم الفاتورة"
                                                            Binding="{Binding id}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="نوع الفاتورة"
                                                            Binding="{Binding ProcTypeName}"
                                                            Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="التاريخ"
                                                            Binding="{Binding InvDate}"
                                                            Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الوقت"
                                                            Binding="{Binding InvTime}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridCheckBoxColumn Header="آجل"
                                                                Binding="{Binding IsPostpone}"
                                                                Width="50"/>

                                        <DataGridTextColumn Header="نقدي"
                                                            Binding="{Binding Cash, StringFormat=N2}"
                                                            Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="شبكة"
                                                            Binding="{Binding Visa, StringFormat=N2}"
                                                            Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الإجمالي"
                                                            Binding="{Binding InvTotal, StringFormat=N2}"
                                                            Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الضريبة"
                                                            Binding="{Binding Tax, StringFormat=N2}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الخصم"
                                                            Binding="{Binding Minus, StringFormat=N2}"
                                                            Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="الصافي"
                                                            Binding="{Binding TotNet, StringFormat=N2}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- مجموع الفواتير - التبويب 2 -->
                            <Border Grid.Row="1" Background="{StaticResource FooterBrush}"
                                    Padding="10,6" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="💰 إجمالي المبيعات:"
                                               Foreground="White" FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txtSumSale2"
                                               Text="0.00"
                                               Foreground="#FFE082" FontWeight="Bold" FontSize="16"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>

                <!-- شريط التقدم -->
                <ProgressBar x:Name="ProgressBar1"
                             Grid.Row="1"
                             Height="12"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource HeaderBrush}"
                             Background="#E0E4EF"
                             Margin="6,0,6,4"/>
            </Grid>
        </Grid>

        <!-- ════ Footer ════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            MinWidth="120" Margin="0,0,6,0"
                            Click="btnExport_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource PrintBtn}"
                            MinWidth="85" Margin="0,0,6,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            MinWidth="85"
                            Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>