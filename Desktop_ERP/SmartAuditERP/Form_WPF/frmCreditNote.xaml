<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCreditNote"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="إشعار دائن"
    Width="980" Height="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════ Brushes ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1B2642"/>
        <SolidColorBrush x:Key="DangerText" Color="#C0392B"/>
        <SolidColorBrush x:Key="SuccessText" Color="#1B8E4A"/>

        <!-- ═══════════ Effects ═══════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══════════ TextBox Style ═══════════ -->
        <Style x:Key="ModernTxt" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F0F2F7"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyTxt" TargetType="TextBox"
               BasedOn="{StaticResource ModernTxt}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F7FA"/>
        </Style>

        <Style x:Key="NetTxt" TargetType="TextBox"
               BasedOn="{StaticResource ReadOnlyTxt}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessText}"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <!-- ═══════════ ComboBox Style ═══════════ -->
        <Style x:Key="ModernCmb" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════ Label Style ═══════════ -->
        <Style x:Key="FieldLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ═══════════ Button Style ═══════════ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- RadioButton Style -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--           pnlMain - Main Form Panel        -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="White"
                Padding="16,12"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Row 0: Header (رقم + تاريخ + نوع الإشعار) ── -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- رقم السند + تاريخ -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="🔢 رقم السند"
                                           Style="{StaticResource FieldLbl}"
                                           Foreground="White"/>
                                <TextBox x:Name="txtNo"
                                         Style="{StaticResource ReadOnlyTxt}"
                                         Width="110"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="📅 التاريخ"
                                           Style="{StaticResource FieldLbl}"
                                           Foreground="White"/>
                                <DatePicker x:Name="txtDate"
                                            Height="32"
                                            Width="130"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            FlowDirection="LeftToRight"
                                            Background="White"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- عنوان الصفحة -->
                        <TextBlock Grid.Column="1"
                                   Text="📄 إشعار دائن"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- نوع الإشعار -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📌 نوع الإشعار"
                                       Style="{StaticResource FieldLbl}"
                                       Foreground="White"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rdInvNote"
                                             Content="إشعار فاتورة"
                                             Style="{StaticResource ModernRadio}"
                                             IsChecked="True"
                                             Foreground="White"
                                             Checked="rdMainNote_CheckedChanged"
                                             Margin="0,0,12,0"/>
                                <RadioButton x:Name="rdMainNote"
                                             Content="إشعار عام"
                                             Style="{StaticResource ModernRadio}"
                                             Foreground="White"
                                             Checked="rdMainNote_CheckedChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Row 2: المورد + رقم الفاتورة + بحث ── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblClients"
                                   Text="🏭 اسم المورد"
                                   Style="{StaticResource FieldLbl}"/>
                        <ComboBox x:Name="cmbSupplies"
                                  Style="{StaticResource ModernCmb}"
                                  IsEditable="True"
                                  KeyDown="cmbSupplies_KeyDown"
                                  SelectionChanged="cmbSupplies_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                x:Name="pnlInvNo">
                        <TextBlock x:Name="lblInvNo"
                                   Text="📋 رقم الفاتورة"
                                   Style="{StaticResource FieldLbl}"/>
                        <TextBox x:Name="txtInvNo"
                                 Style="{StaticResource ModernTxt}"
                                 KeyDown="txtInvNo_KeyDown"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            x:Name="btnSearch"
                            Content="🔍"
                            Style="{StaticResource ActionBtn}"
                            Height="32"
                            Margin="0,18,0,0"
                            FontSize="18"
                            Click="btnSearch_Click"
                            ToolTip="بحث"/>
                </Grid>

                <!-- ── Row 4: قيمة الفاتورة + خصومات سابقة ── -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblInvVal"
                                   Text="💰 قيمة الفاتورة"
                                   Style="{StaticResource FieldLbl}"/>
                        <TextBox x:Name="txtInvVal"
                                 Style="{StaticResource ReadOnlyTxt}"
                                 IsEnabled="False"
                                 Text="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lblPreviousDiscVal"
                                   Text="📊 خصومات سابقة"
                                   Style="{StaticResource FieldLbl}"/>
                        <TextBox x:Name="txtPreviousDiscVal"
                                 Style="{StaticResource ReadOnlyTxt}"
                                 IsEnabled="False"
                                 IsReadOnly="True"
                                 Text="0"/>
                    </StackPanel>
                </Grid>

                <!-- ── Row 6: الخصم % + الخصم قيمة + الضريبة ── -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblDiscountPerc"
                                   Text="📉 نسبة الخصم"
                                   Style="{StaticResource FieldLbl}"/>
                        <TextBox x:Name="txtDiscountPerc"
                                 Style="{StaticResource ModernTxt}"
                                 Text="0"
                                 Foreground="{StaticResource DangerText}"
                                 KeyDown="txtDiscountPerc_KeyDown"
                                 LostFocus="txtDiscountPerc_Leave"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="%"
                               Foreground="{StaticResource DangerText}"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Bottom"
                               Margin="4,0,0,6"/>

                    <StackPanel Grid.Column="3">
                        <TextBlock x:Name="lblDiscountVal"
                                   Text="💲 قيمة الخصم"
                                   Style="{StaticResource FieldLbl}"/>
                        <TextBox x:Name="txtDiscountVal"
                                 Style="{StaticResource ModernTxt}"
                                 Text="0"
                                 Foreground="{StaticResource DangerText}"
                                 KeyDown="txtDiscountVal_KeyDown"
                                 LostFocus="txtDiscountVal_Leave"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5">
                        <TextBlock x:Name="lblTAX"
                                   Text="🧾 ضريبة الخصم"
                                   Style="{StaticResource FieldLbl}"/>
                        <TextBox x:Name="txtTax"
                                 Style="{StaticResource ReadOnlyTxt}"
                                 IsReadOnly="True"
                                 Text="0"
                                 Foreground="#E67E22"/>
                    </StackPanel>
                </Grid>

                <!-- ── Row 8: الصافي ── -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="lblNote"
                                   Text="📝 البيان"
                                   Style="{StaticResource FieldLbl}"/>
                        <TextBox x:Name="txtNotes"
                                 Style="{StaticResource ModernTxt}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="lblNet"
                                   Text="✅ الصـافي"
                                   Style="{StaticResource FieldLbl}"
                                   FontSize="14"
                                   Foreground="{StaticResource SuccessText}"/>
                        <TextBox x:Name="txtNet"
                                 Style="{StaticResource NetTxt}"
                                 Text="0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--           panel2 - Footer Buttons          -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="12,8"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="46"
                            ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Column="1"/>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnView_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>