<Window x:Class="SmartAuditERP.Form_WPF.frmAccountsDirectory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="دليل الحسابات" 
        Height="800" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- Gradients -->
        <LinearGradientBrush x:Key="ToolbarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E8EAF6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Level Button Style -->
        <Style x:Key="LevelButton" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarGradient}" BorderBrush="#D1D8E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main Buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,10">
                    <Button x:Name="btnAddAcc" Content="➕ إضافة حساب" Style="{StaticResource ToolbarButton}" Click="btnAddAcc_Click"/>
                    <Button x:Name="btnAddTreasury" Content="💰 بطاقة صندوق" Style="{StaticResource ToolbarButton}" Background="#27AE60" Click="btnAddTreasury_Click"/>
                    <Button x:Name="btnAddBank" Content="🏦 بطاقة بنك" Style="{StaticResource ToolbarButton}" Background="#8E44AD" Click="btnAddBank_Click"/>
                    <Button x:Name="btnAddSuplier" Content="📦 بطاقة مورد" Style="{StaticResource ToolbarButton}" Background="#E67E22" Click="btnAddSuplier_Click"/>
                    <Button x:Name="btnAddClint" Content="👤 بطاقة عميل" Style="{StaticResource ToolbarButton}" Background="#16A085" Click="btnAddClint_Click"/>
                    <Button x:Name="btnExportExcel" Content="📊 تصدير Excel" Style="{StaticResource ToolbarButton}" Background="#2ECC71" Click="btnExportExcel_Click"/>
                </StackPanel>

                <!-- Level Controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,5">
                    <TextBlock Text="مستويات التوسعة:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <Button x:Name="btnLoadAll" Content="الكل" Style="{StaticResource LevelButton}" Background="#34495E" Click="btnLoadAll_Click"/>
                    <Button x:Name="btnLvl1" Content="1" Style="{StaticResource LevelButton}" Click="btnLvl1_Click"/>
                    <Button x:Name="btnLvl2" Content="2" Style="{StaticResource LevelButton}" Click="btnLvl2_Click"/>
                    <Button x:Name="btnlvl3" Content="3" Style="{StaticResource LevelButton}" Click="btnlvl3_Click"/>
                    <Button x:Name="btnlvl4" Content="4" Style="{StaticResource LevelButton}" Click="btnlvl4_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Split Container -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView Panel -->
            <Border Grid.Column="0" Background="White" Margin="10" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#34495E" CornerRadius="10,10,0,0">
                        <TextBlock Text="📂 شجرة الحسابات" Foreground="White" FontSize="16" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TreeView x:Name="TreeView1" Grid.Row="1" BorderThickness="0" 
                              SelectedItemChanged="TreeView1_SelectedItemChanged"
                              MouseDoubleClick="TreeView1_MouseDoubleClick"
                              KeyDown="TreeView1_KeyDown">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding trAccount}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding trBalance, StringFormat=N2}" Foreground="#27AE60" FontWeight="Bold"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#BDC3C7"/>

            <!-- DataGrid Panel -->
            <Border Grid.Column="2" Background="White" Margin="10,10,10,10" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#34495E" CornerRadius="10,10,0,0">
                        <TextBlock Text="📋 تفاصيل الحسابات" Foreground="White" FontSize="16" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid x:Name="dgvAccounts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" AlternatingRowBackground="#F8F9FA"
                              RowHeight="38" CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الحساب الرئيسي" Binding="{Binding Parent_Acc}" Width="150"/>
                            <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="100"/>
                            <DataGridTextColumn Header="اسم الحساب" Binding="{Binding Account}" Width="*"/>
                            <DataGridTextColumn Header="الفرع" Binding="{Binding DgvBranch}" Width="120"/>
                            <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="كشف حساب" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📄" Background="Transparent" BorderThickness="0" 
                                                Cursor="Hand" Click="btnShowDetails_Click" Tag="{Binding AccountCode}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="تعديل" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✏️" Background="Transparent" BorderThickness="0" 
                                                Cursor="Hand" Click="btnEdit_Click" Tag="{Binding AccountCode}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>