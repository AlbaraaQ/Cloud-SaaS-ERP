<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptItemsActivity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="مادة باجمالي الحركات"
    WindowState="Maximized"
    MinWidth="1022" MinHeight="700"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SearchBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#D4891A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1DB954" Offset="0"/>
            <GradientStop Color="#158A3E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A90D9" Offset="0"/>
            <GradientStop Color="#2E6DA8" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="SidebarBg"  Color="#F0F3F8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6"  ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ TextBox Style ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ComboBox Style ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ FieldLabel Style ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ═══ SectionTitle Style ═══ -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ CheckBox Style ═══ -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- ═══ RadioButton Style ═══ -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- ═══ Action Button Base ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SearchBrush}"/>
        </Style>
        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>
        <Style x:Key="PrintBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- ═══ DataGrid Column Header ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#FFFFFF33"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- ═══ DataGrid Row ═══ -->
        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE6F8"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ DataGrid Cell ═══ -->
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1B3A6B"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ══════════════════════════════════════════
         الهيكل الرئيسي: شريط علوي + محتوى + Footer
    ══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ المحتوى الرئيسي: Sidebar + DataGrid ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Sidebar اليمين -->
                <ColumnDefinition Width="220"/>
                <!-- منطقة الجدول -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════
                 SIDEBAR - لوحة الفلاتر
            ════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,10,10,10">

                        <!-- ─── عنوان الفلاتر ─── -->
                        <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
                            <TextBlock Text="🔧 خيارات البحث"
                                       Style="{StaticResource SectionTitle}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- ─── الفرع ─── -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="🏢 الفرع" Style="{StaticResource SectionTitle}"/>
                                </Border>
                                <CheckBox x:Name="ChkAllBranch"
                                          Content="الكل"
                                          Style="{StaticResource ModernCheck}"
                                          IsChecked="True"
                                          Checked="ChkAllBranch_CheckedChanged"
                                          Unchecked="ChkAllBranch_CheckedChanged"/>
                                <ComboBox x:Name="cmbBranch"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,4,0,0"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── الصنف ─── -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="📦 الصنف" Style="{StaticResource SectionTitle}"/>
                                </Border>
                                <CheckBox x:Name="chkAll"
                                          Content="الكل"
                                          Style="{StaticResource ModernCheck}"
                                          IsChecked="True"
                                          Checked="chkAll_CheckedChanged"
                                          Unchecked="chkAll_CheckedChanged"/>
                                <TextBlock Text="رمز الصنف" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtItemCode"
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}"
                                             IsEnabled="False"
                                             KeyDown="txtItemCode_KeyDown"/>
                                    <Button Grid.Column="1"
                                            x:Name="btnSearchItem"
                                            Content="🔍"
                                            Style="{StaticResource ActionBtn}"
                                            Width="34" Height="32"
                                            Margin="4,0,0,0"
                                            ToolTip="بحث عن صنف"
                                            Click="btnSearchItem_Click"/>
                                </Grid>
                                <TextBlock Text="اسم الصنف" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"/>
                                <TextBox x:Name="txtItemName"
                                         Style="{StaticResource ModernTextBox}"
                                         IsEnabled="False"
                                         KeyDown="txtItemName_KeyDown"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── الفترة الزمنية ─── -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="📅 الفترة الزمنية" Style="{StaticResource SectionTitle}"/>
                                </Border>
                                <CheckBox x:Name="ckTotalPeriod"
                                          Content="كل الفترة"
                                          Style="{StaticResource ModernCheck}"
                                          IsChecked="True"
                                          Checked="ckTotalPeriod_CheckedChanged"
                                          Unchecked="ckTotalPeriod_CheckedChanged"/>
                                <TextBlock Text="من" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"/>
                                <dxe:DateEdit x:Name="txtDateFrom"
                                              Height="32"
                                              FontSize="12"
                                              IsEnabled="False"
                                              Margin="0,0,0,4"/>
                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}" Margin="0,4,0,2"/>
                                <dxe:DateEdit x:Name="txtDateTo"
                                              Height="32"
                                              FontSize="12"
                                              IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── المستودع ─── -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="🏪 المستودع" Style="{StaticResource SectionTitle}"/>
                                </Border>
                                <CheckBox x:Name="chlAllSafe"
                                          Content="الكل"
                                          Style="{StaticResource ModernCheck}"
                                          IsChecked="True"
                                          Checked="chlAllSafe_CheckedChanged"
                                          Unchecked="chlAllSafe_CheckedChanged"/>
                                <ComboBox x:Name="cmbSafes"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,4,0,0"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── العملاء / الموردون ─── -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="👥 العملاء / الموردون" Style="{StaticResource SectionTitle}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton x:Name="chkAllClients"
                                                 Content="الكل"
                                                 GroupName="ClientType"
                                                 Style="{StaticResource ModernRadio}"
                                                 IsChecked="True"
                                                 Margin="0,0,8,0"
                                                 Checked="chkAllClients_CheckedChanged"/>
                                    <RadioButton x:Name="chkClients"
                                                 Content="عملاء"
                                                 GroupName="ClientType"
                                                 Style="{StaticResource ModernRadio}"
                                                 Margin="0,0,8,0"
                                                 Checked="chkClients_CheckedChanged"/>
                                    <RadioButton x:Name="chkSuplier"
                                                 Content="موردون"
                                                 GroupName="ClientType"
                                                 Style="{StaticResource ModernRadio}"
                                                 Checked="chkSuplier_CheckedChanged"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbClients"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False">
                                    <ComboBoxItem>المشتريات</ComboBoxItem>
                                    <ComboBoxItem>المبيعات</ComboBoxItem>
                                    <ComboBoxItem>نقطة البيع</ComboBoxItem>
                                    <ComboBoxItem>فاتورة إدخال</ComboBoxItem>
                                    <ComboBoxItem>فاتورة إخراج</ComboBoxItem>
                                    <ComboBoxItem>فاتورة إنتاج</ComboBoxItem>
                                    <ComboBoxItem>تسوية جردية</ComboBoxItem>
                                    <ComboBoxItem>مناقلة</ComboBoxItem>
                                    <ComboBoxItem>بضاعة أول مدة</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- ─── المجموعة ─── -->
                        <Border Background="White" CornerRadius="8" Padding="8,8"
                                Margin="0,0,0,8"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="🗂️ المجموعة" Style="{StaticResource SectionTitle}"/>
                                </Border>
                                <CheckBox x:Name="chkAllGrp"
                                          Content="الكل"
                                          Style="{StaticResource ModernCheck}"
                                          IsChecked="True"
                                          Checked="chkAllGrp_CheckedChanged"
                                          Unchecked="chkAllGrp_CheckedChanged"/>
                                <ComboBox x:Name="cmbGrp"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,4,0,0"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── زر البحث ─── -->
                        <Button x:Name="btnShow"
                                Content="🔍 بحث وعرض النتائج"
                                Style="{StaticResource SearchBtn}"
                                Height="38"
                                Margin="0,4,0,0"
                                Click="btnShow_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ════════════════════════════════
                 منطقة الجدول والتقارير
            ════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ─── DataGrid ─── -->
                <Border Grid.Row="0"
                        Background="White"
                        Margin="8,8,8,4"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header الجدول -->
                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0">
                            <TextBlock Text="📊 إجمالي حركات الأصناف"
                                       Foreground="White"
                                       FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="14,0"/>
                        </Border>

                        <!-- الجدول الرئيسي -->
                        <DataGrid x:Name="GridControl1"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                  RowStyle="{StaticResource DgvRow}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  FlowDirection="RightToLeft"
                                  Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8EBF5"
                                  AlternatingRowBackground="#F8F9FD"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  SelectionChanged="GridControl1_SelectionChanged">
                            <DataGrid.Columns>

                                <!-- الرمز -->
                                <DataGridTextColumn Header="الرمز"
                                                    Binding="{Binding DgvItemCode}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- الصنف -->
                                <DataGridTextColumn Header="الصنف"
                                                    Binding="{Binding DgvItemName}"
                                                    Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- الرصيد -->
                                <DataGridTextColumn Header="الرصيد"
                                                    Binding="{Binding DgvBalnce, StringFormat=N2}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- متوسط التكلفة -->
                                <DataGridTextColumn Header="متوسط التكلفة"
                                                    Binding="{Binding DgvAvgCost, StringFormat=N2}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- إجمالي التكلفة -->
                                <DataGridTextColumn Header="إجمالي التكلفة"
                                                    Binding="{Binding DgvTotalCost, StringFormat=N2}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- بضاعة أول مدة -->
                                <DataGridTextColumn Header="أول مدة"
                                                    Binding="{Binding DgvFirstVal, StringFormat=N2}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- مشتريات -->
                                <DataGridTextColumn Header="مشتريات"
                                                    Binding="{Binding DgvPurch, StringFormat=N2}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- مرتجع مشتريات -->
                                <DataGridTextColumn Header="مرتجع مشتريات"
                                                    Binding="{Binding DgvRePurch, StringFormat=N2}"
                                                    Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- المبيعات -->
                                <DataGridTextColumn Header="المبيعات"
                                                    Binding="{Binding DgvSales, StringFormat=N2}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- مرتجع المبيعات -->
                                <DataGridTextColumn Header="مرتجع المبيعات"
                                                    Binding="{Binding DgvReSales, StringFormat=N2}"
                                                    Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- نقطة البيع -->
                                <DataGridTextColumn Header="نقطة البيع"
                                                    Binding="{Binding DgvPOS, StringFormat=N2}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- مرتجع نقطة البيع -->
                                <DataGridTextColumn Header="مرتجع POS"
                                                    Binding="{Binding DgvRePOS, StringFormat=N2}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- مناقلة مرسلة -->
                                <DataGridTextColumn Header="مناقلة مرسلة"
                                                    Binding="{Binding DgvTransTo, StringFormat=N2}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- مناقلة مستلمة -->
                                <DataGridTextColumn Header="مناقلة مستلمة"
                                                    Binding="{Binding DgvTransFrom, StringFormat=N2}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- فاتورة إدخال -->
                                <DataGridTextColumn Header="فاتورة إدخال"
                                                    Binding="{Binding DgvEntryInv, StringFormat=N2}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- فاتورة إخراج -->
                                <DataGridTextColumn Header="فاتورة إخراج"
                                                    Binding="{Binding DgvOutInv, StringFormat=N2}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- تسوية إدخال -->
                                <DataGridTextColumn Header="تسوية إدخال"
                                                    Binding="{Binding DgvSafeAdj, StringFormat=N2}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- تسوية إخراج -->
                                <DataGridTextColumn Header="تسوية إخراج"
                                                    Binding="{Binding DgvSafeAdjRet, StringFormat=N2}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ─── بطاقات المجاميع ─── -->
                <Border Grid.Row="1" Margin="8,0,8,4">
                    <WrapPanel Orientation="Horizontal">

                        <!-- مجموع الرصيد -->
                        <Border Background="White" CornerRadius="8" Padding="10,6"
                                Margin="0,0,6,0" MinWidth="130"
                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="📦 إجمالي الرصيد"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" Margin="0,0,0,2"/>
                                <TextBlock x:Name="lblSumBalance"
                                           Text="0.00"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#213A7A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- مجموع التكلفة -->
                        <Border Background="White" CornerRadius="8" Padding="10,6"
                                Margin="0,0,6,0" MinWidth="140"
                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="💰 إجمالي التكلفة"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" Margin="0,0,0,2"/>
                                <TextBlock x:Name="lblSumTotalCost"
                                           Text="0.00"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#1B8E4A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- عدد الأصناف -->
                        <Border Background="White" CornerRadius="8" Padding="10,6"
                                Margin="0,0,6,0" MinWidth="120"
                                BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="🔢 عدد الأصناف"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#555" Margin="0,0,0,2"/>
                                <TextBlock x:Name="lblCountItems"
                                           Text="0"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#D4891A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                </Border>

                <!-- ─── شريط التقدم ─── -->
                <Border Grid.Row="2" Margin="8,0,8,4">
                    <ProgressBar x:Name="ProgressBar1"
                                 Height="14"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource HeaderBrush}"
                                 Background="#E0E4EF"/>
                </Border>

            </Grid>
        </Grid>

        <!-- ════════════════════════════════
             Footer - شريط الأزرار السفلي
        ════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر الخروج -->
                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Click="btnClose_Click"/>

                <!-- أزرار التقارير -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Click="btnExport_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource PrintBtn}"
                            MinWidth="90"
                            Margin="0,0,6,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            MinWidth="90"
                            Click="btnPrint_Click"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>