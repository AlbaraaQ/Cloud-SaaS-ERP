<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptInvPurchaseDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تفاصيل فواتير المشتريات"
    WindowState="Maximized"
    MinWidth="1022" MinHeight="726"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F5F5F5"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════ -->
        <!-- GroupBox1 - خيارات البحث (يسار)   -->
        <!-- ══════════════════════════════════ -->
        <Border x:Name="GroupBox1"
                Grid.Column="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- عنوان -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        Padding="10,8">
                    <TextBlock Text="🔍 خيارات البحث"
                               Foreground="White"
                               FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- محتوى الفلاتر -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10,8">
                    <StackPanel>

                        <!-- نوع الدفع -->
                        <TextBlock x:Name="lblType"
                                   Text="💳 نوع الدفع"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ckAllType"
                                      Grid.Column="0"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Checked="ckAllType_Changed"
                                      Unchecked="ckAllType_Changed"/>
                            <ComboBox x:Name="cmbType"
                                      Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </Grid>

                        <!-- المستودع -->
                        <TextBlock x:Name="Label9"
                                   Text="🏪 المستودع"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ckAllStore"
                                      Grid.Column="0"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Checked="ckAllStore_Changed"
                                      Unchecked="ckAllStore_Changed"/>
                            <ComboBox x:Name="cmbStore"
                                      Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </Grid>

                        <!-- المندوب -->
                        <TextBlock x:Name="lblSaleman"
                                   Text="👤 المندوب"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="cbAllSalesmen"
                                      Grid.Column="0"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Checked="cbAllSalesmen_Changed"
                                      Unchecked="cbAllSalesmen_Changed"/>
                            <ComboBox x:Name="cmbSaleman"
                                      Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </Grid>

                        <!-- المستخدم -->
                        <TextBlock x:Name="lblUsers"
                                   Text="👤 المستخدم"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ckAllUsers"
                                      Grid.Column="0"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Checked="ckAllUsers_Changed"
                                      Unchecked="ckAllUsers_Changed"/>
                            <ComboBox x:Name="cmbusers"
                                      Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </Grid>

                        <!-- المورد -->
                        <TextBlock x:Name="lblClients"
                                   Text="🏢 المورد"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ckAllClients"
                                      Grid.Column="0"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Checked="ckAllClients_Changed"
                                      Unchecked="ckAllClients_Changed"/>
                            <ComboBox x:Name="cmbClients"
                                      Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"
                                      MouseLeftButtonDown="cmbClients_MouseLeftButtonDown"/>
                        </Grid>

                        <!-- الفرع -->
                        <TextBlock x:Name="lblBranch"
                                   Text="🏬 الفرع"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chkAllBranches"
                                      Grid.Column="0"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Checked="chkAllBranches_Changed"
                                      Unchecked="chkAllBranches_Changed"/>
                            <ComboBox x:Name="cmbBranches"
                                      Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </Grid>

                        <!-- الفترة -->
                        <TextBlock x:Name="lblTotalPeriod"
                                   Text="📅 الفترة"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <CheckBox x:Name="ckTotalPeriod"
                                  Content="كل الفترة"
                                  IsChecked="True"
                                  FontWeight="Bold"
                                  Margin="0,0,0,8"
                                  Checked="ckTotalPeriod_Changed"
                                  Unchecked="ckTotalPeriod_Changed"/>

                        <!-- من تاريخ -->
                        <TextBlock x:Name="lblFromDate"
                                   Text="من"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <dxe:DateEdit x:Name="txtFromDate"
                                      Height="28"
                                      IsEnabled="False"
                                      DisplayFormatString="d"
                                      Margin="0,0,0,4"/>

                        <!-- وقت البدء -->
                        <TextBox x:Name="txtStartTime"
                                 Height="28"
                                 IsEnabled="False"
                                 Text="00:00"
                                 Margin="0,0,0,8"
                                 FontWeight="Bold"
                                 ToolTip="وقت البداية (HH:mm)"/>

                        <!-- إلى تاريخ -->
                        <TextBlock x:Name="lblToDate"
                                   Text="إلى"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,4"/>
                        <dxe:DateEdit x:Name="txtToDate"
                                      Height="28"
                                      IsEnabled="False"
                                      DisplayFormatString="d"
                                      Margin="0,0,0,4"/>

                        <!-- وقت النهاية -->
                        <TextBox x:Name="txtEndTime"
                                 Height="28"
                                 IsEnabled="False"
                                 Text="23:59"
                                 Margin="0,0,0,12"
                                 FontWeight="Bold"
                                 ToolTip="وقت النهاية (HH:mm)"/>

                        <!-- GroupBox4 - الضريبة -->
                        <Border x:Name="GroupBox4"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="💰 الضريبة"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <RadioButton x:Name="rbAllProfit"
                                             Content="للكل"
                                             IsChecked="True"
                                             FontWeight="Bold"
                                             Margin="0,2"/>
                                <RadioButton x:Name="rbWithVat"
                                             Content="مع ضريبة"
                                             FontWeight="Bold"
                                             Margin="0,2"/>
                                <RadioButton x:Name="rbNoVAT"
                                             Content="بدون ضريبة"
                                             FontWeight="Bold"
                                             Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <!-- GroupBox3 - نوع العملية (مخفي) -->
                        <Border x:Name="GroupBox3"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🔄 نوع العملية"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <RadioButton x:Name="rbAllSales"
                                             Content="لكل"
                                             IsChecked="True"
                                             FontWeight="Bold"
                                             Margin="0,2"/>
                                <RadioButton x:Name="rbSales"
                                             Content="شراء"
                                             FontWeight="Bold"
                                             Margin="0,2"/>
                                <RadioButton x:Name="rbReturn"
                                             Content="مرتجع"
                                             FontWeight="Bold"
                                             Margin="0,2"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- زر عرض -->
                <Button x:Name="btnView"
                        Grid.Row="2"
                        Content="👁️ عرض"
                        Style="{StaticResource ActionBtn}"
                        Margin="10,8"
                        Height="36"
                        Click="btnView_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════ -->
        <!-- GroupBox2 - الجدول (يمين)          -->
        <!-- ══════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- عنوان الجدول -->
            <Border Grid.Row="0"
                    Background="White"
                    Margin="6,6,6,0"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="📋 الفواتير"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="GridControl2"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              MouseLeftButtonUp="GridControl2_MouseLeftButtonUp">
                        <DataGrid.Columns>

                            <DataGridTextColumn x:Name="AutoIncrementID"
                                                Header="#"
                                                Binding="{Binding AutoIncrementID}"
                                                Width="45">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="InvoiceType"
                                                Header="InvoiceType"
                                                Binding="{Binding InvoiceType}"
                                                Width="60"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="InvoiceTypeTxt"
                                                Header="📄 نوع الفاتورة"
                                                Binding="{Binding InvoiceTypeTxt}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="InvGlobalID"
                                                Header="InvGlobalID"
                                                Binding="{Binding InvGlobalID}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="InvoiceNo"
                                                Header="🔢 رقم الفاتورة"
                                                Binding="{Binding InvoiceNo}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="ReffNo"
                                                Header="🔗 رقم المرجع"
                                                Binding="{Binding ReffNo}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="InvDate"
                                                Header="📅 التاريخ"
                                                Binding="{Binding InvDate, StringFormat=d}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="PayType"
                                                Header="PayType"
                                                Binding="{Binding PayType}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="PaymentTxt"
                                                Header="💳 نوع الدفع"
                                                Binding="{Binding PaymentTxt}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Customer"
                                                Header="Customer"
                                                Binding="{Binding Customer}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="ClientTxt"
                                                Header="🏢 المورد"
                                                Binding="{Binding ClientTxt}"
                                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="SumPrice"
                                                Header="💰 المجموع"
                                                Binding="{Binding SumPrice, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="TotDiscount"
                                                Header="🏷️ الخصم"
                                                Binding="{Binding TotDiscount, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Total"
                                                Header="💵 الإجمالي"
                                                Binding="{Binding Total, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="VAT"
                                                Header="🧾 الضريبة"
                                                Binding="{Binding VAT, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="Net"
                                                Header="✅ الصافي"
                                                Binding="{Binding Net, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="InvertoryName"
                                                Header="🏪 المستودع"
                                                Binding="{Binding InvertoryName}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="BranchTxt"
                                                Header="🏬 الفرع"
                                                Binding="{Binding BranchTxt}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="InvoiceStatus"
                                                Header="InvoiceStatus"
                                                Binding="{Binding InvoiceStatus}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="Salesman"
                                                Header="👤 المندوب"
                                                Binding="{Binding SalesmanTxt}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="UserTxt"
                                                Header="👤 المستخدم"
                                                Binding="{Binding UserTxt}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="ProcType"
                                                Header="ProcType"
                                                Binding="{Binding ProcType}"
                                                Visibility="Collapsed"/>

                            <!-- details - زر التفاصيل -->
                            <DataGridTemplateColumn x:Name="details"
                                                    Header="📋 التفاصيل"
                                                    Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📋 تفاصيل"
                                                Tag="{Binding}"
                                                Height="22"
                                                Margin="2,1"
                                                Cursor="Hand"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Background="#3A63C3"
                                                BorderThickness="0"
                                                Click="RepositoryItemBtnDetails_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="4,2">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- showInv - زر العرض -->
                            <DataGridTemplateColumn x:Name="showInv"
                                                    Header="👁️ عرض"
                                                    Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="👁️ عرض"
                                                Tag="{Binding}"
                                                Height="22"
                                                Margin="2,1"
                                                Cursor="Hand"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Background="#1B8E4A"
                                                BorderThickness="0"
                                                Click="RepositoryItemBtnShowInv_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="4,2">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="Paycash"
                                                Header="النقدية"
                                                Binding="{Binding Paycash}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="PayATM"
                                                Header="PayATM"
                                                Binding="{Binding PayATM}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="ExtraVAT"
                                                Header="ExtraVAT"
                                                Binding="{Binding ExtraVATPerc}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="TotalTax"
                                                Header="TotalTax"
                                                Binding="{Binding TotalTax}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="Paid"
                                                Header="المدفوع"
                                                Binding="{Binding Paid, StringFormat=N2}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="Remainder"
                                                Header="المتبقي"
                                                Binding="{Binding Remainder, StringFormat=N2}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn x:Name="InvoiceTime"
                                                Header="الوقت"
                                                Binding="{Binding InvoiceTime}"
                                                Visibility="Collapsed"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ProgressBar -->
            <ProgressBar x:Name="ProgressBar1"
                         Grid.Row="1"
                         Height="8"
                         Margin="6,2"
                         Value="0"
                         Maximum="100"
                         Background="#E8EBF5"
                         Foreground="#3A63C3"/>

            <!-- Summary Row -->
            <Border Grid.Row="2"
                    Background="#EEF1FA"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,1,0,0"
                    Padding="8,4"
                    Margin="6,0">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="المجموع: " FontWeight="Bold" FontSize="11"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblSumTotal"
                               Text="0.00" FontWeight="Bold" FontSize="11"
                               Foreground="#213A7A" Margin="0,0,16,0"/>
                    <TextBlock Text="الخصم: " FontWeight="Bold" FontSize="11"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblSumDiscount"
                               Text="0.00" FontWeight="Bold" FontSize="11"
                               Foreground="#B92F2F" Margin="0,0,16,0"/>
                    <TextBlock Text="الإجمالي: " FontWeight="Bold" FontSize="11"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblSumNet"
                               Text="0.00" FontWeight="Bold" FontSize="11"
                               Foreground="#1B8E4A" Margin="0,0,16,0"/>
                    <TextBlock Text="الضريبة: " FontWeight="Bold" FontSize="11"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblSumVAT"
                               Text="0.00" FontWeight="Bold" FontSize="11"
                               Foreground="#E35656" Margin="0,0,16,0"/>
                    <TextBlock Text="الصافي: " FontWeight="Bold" FontSize="11"
                               Margin="0,0,4,0"/>
                    <TextBlock x:Name="lblSumNetFinal"
                               Text="0.00" FontWeight="Bold" FontSize="11"
                               Foreground="#1B8E4A"/>
                </WrapPanel>
            </Border>

            <!-- GroupBox5 - أزرار التحكم (Footer) -->
            <Border x:Name="GroupBox5"
                    Grid.Row="3"
                    Background="{StaticResource FooterBrush}"
                    FlowDirection="LeftToRight"
                    Padding="10,8"
                    Margin="6,4,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- أزرار اليسار -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="btnClose"
                                Content="✖ خروج"
                                Style="{StaticResource DangerBtn}"
                                Width="80"
                                Margin="0,0,6,0"
                                Click="btnClose_Click"/>

                        <!-- زر الإعدادات (بديل ToolStrip) -->
                        <Button x:Name="BtnSaveDgvSettings"
                                Content="💾 حفظ المظهر"
                                Style="{StaticResource ActionBtn}"
                                Width="110"
                                Margin="0,0,4,0"
                                Click="BtnSaveDgvSettings_Click"/>

                        <Button x:Name="BtnDefaultSetting"
                                Content="🔄 إعادة الافتراضي"
                                Style="{StaticResource ActionBtn}"
                                Width="130"
                                Margin="0,0,4,0"
                                Click="BtnDefaultSetting_Click"/>

                        <!-- تكبير/تصغير -->
                        <Button x:Name="btnZoomOut"
                                Content="🔍−"
                                Style="{StaticResource ActionBtn}"
                                Width="40"
                                FontSize="14"
                                Margin="0,0,2,0"
                                ToolTip="تصغير"
                                Click="btnZoomOut_Click"/>
                        <Button x:Name="btnZoom"
                                Content="🔍+"
                                Style="{StaticResource ActionBtn}"
                                Width="40"
                                FontSize="14"
                                ToolTip="تكبير"
                                Click="btnZoom_Click"/>
                    </StackPanel>

                    <!-- أزرار اليمين -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnExportExcel"
                                Content="📊 تصدير Excel"
                                Style="{StaticResource GreenBtn}"
                                Width="120"
                                Margin="0,0,6,0"
                                Click="btnExportExcel_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90"
                                Margin="0,0,6,0"
                                Click="btnPrint_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource ActionBtn}"
                                Width="90"
                                Click="btnPreview_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</dx:ThemedWindow>