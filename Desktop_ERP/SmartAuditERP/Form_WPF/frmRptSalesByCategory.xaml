<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptSalesByCategory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تقرير مبيعات الأصناف حسب المجموعة"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#17A2B8" Offset="0"/>
            <GradientStop Color="#117A8B" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="SidebarBg"  Color="#F0F2F8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E4E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <!-- ══ TreeView Styles (Master-Detail) ══ -->

        <!-- رأس المجموعة (Master Row) -->
        <Style x:Key="CategoryHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- رأس أعمدة الأصناف -->
        <Style x:Key="ItemRowStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EBF5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- TreeViewItem بدون تأثيرات افتراضية -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header"/>
                            <ItemsPresenter Margin="20,0,0,0"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">

                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="10,6"
                            Margin="0,0,0,10">
                        <TextBlock Text="📊 خيارات البحث"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- ══ نوع الفاتورة ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📄 نوع الفاتورة"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="cmbInvType"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ المستخدم ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="👤 المستخدم"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="Che_user"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="Che_user_CheckedChanged"
                                      Unchecked="Che_user_CheckedChanged"/>
                            <ComboBox x:Name="cmbUser"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ الفترة ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📅 الفترة"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,6"/>
                            <CheckBox x:Name="Che_time"
                                      Content="كل الفترة" IsChecked="False"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,8"
                                      Checked="Che_time_CheckedChanged"
                                      Unchecked="Che_time_CheckedChanged"/>
                            <TextBlock Text="من تاريخ:" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtStartDate"
                                          Height="30" FontSize="12"
                                          Margin="0,0,0,6"/>
                            <TextBlock Text="إلى تاريخ:" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtEndDate"
                                          Height="30" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ المجموعة ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📂 المجموعة"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="CheckBoxgroup"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="CheckBoxgroup_CheckedChanged"
                                      Unchecked="CheckBoxgroup_CheckedChanged"/>
                            <ComboBox x:Name="cmbCategry"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ الفرع ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏬 الفرع"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="chk_branch"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="chk_branch_CheckedChanged"
                                      Unchecked="chk_branch_CheckedChanged"/>
                            <ComboBox x:Name="cmbBranch"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ المندوب ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🧑‍💼 المندوب"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="chkSalesman"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="chkSalesman_CheckedChanged"
                                      Unchecked="chkSalesman_CheckedChanged"/>
                            <ComboBox x:Name="cmbSalesman"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ زر العرض ══ -->
                    <Button x:Name="btnShow"
                            Content="📊 عرض النتائج"
                            Style="{StaticResource SaveBtn}"
                            Height="40" FontSize="13"
                            Margin="0,4,0,0"
                            Click="btnShow_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════ MAIN CONTENT ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ TreeView (Master-Detail) ══ -->
            <Border Grid.Row="0"
                    Background="White"
                    Margin="8,8,8,0" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="📊 تقرير مبيعات الأصناف حسب المجموعة"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <!-- رأس الأعمدة -->
                    <Border Grid.Row="1"
                            Background="#E8EBF5"
                            Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اسم المجموعة / الصنف"
                                       FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Padding="8,6"/>
                            <TextBlock Grid.Column="1" Text="الرمز"
                                       FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Padding="8,6"/>
                            <TextBlock Grid.Column="2" Text="إجمالي الكمية"
                                       FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Padding="8,6"/>
                            <TextBlock Grid.Column="3" Text="الإجمالي"
                                       FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Padding="8,6"/>
                            <TextBlock Grid.Column="4" Text="الضريبة"
                                       FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Padding="8,6"/>
                            <TextBlock Grid.Column="5" Text="الصافي"
                                       FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Padding="8,6"/>
                            <TextBlock Grid.Column="6" Text="الخصم"
                                       FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Padding="8,6"/>
                        </Grid>
                    </Border>

                    <!-- TreeView -->
                    <TreeView x:Name="trvCategories"
                              Grid.Row="2"
                              Background="White"
                              BorderThickness="0"
                              FlowDirection="RightToLeft"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Stretch"/>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate
                                ItemsSource="{Binding ItemDetails}">

                                <!-- صف المجموعة (Master) -->
                                <Border Background="{StaticResource HeaderBrush}"
                                        Padding="0" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Padding="10,6"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Code}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="6"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalQty, StringFormat=N2}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="6"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ItemTotal, StringFormat=N2}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="6"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ItemVat, StringFormat=N2}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="6"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding ItemNet, StringFormat=N2}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="6"/>
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding InvDiscount, StringFormat=N2}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="6"/>
                                    </Grid>
                                </Border>

                                <!-- قالب صفوف الأصناف (Detail) -->
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E8EBF5"
                                                BorderThickness="0,0,0,1"
                                                Padding="0">
                                            <Grid Background="White">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ItemName}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Padding="20,5,8,5"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ItemCode}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Padding="6,5"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Qty, StringFormat=N2}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Padding="6,5"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Total, StringFormat=N2}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Padding="6,5"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding ItemVat, StringFormat=N2}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Padding="6,5"/>
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding ItemNet, StringFormat=N2}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Padding="6,5"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding InvDiscount, StringFormat=N2}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Padding="6,5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>

                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                </Grid>
            </Border>

            <!-- ══ Summary Cards ══ -->
            <Border Grid.Row="1"
                    Background="White"
                    Margin="8,6,8,0" CornerRadius="10"
                    Effect="{StaticResource CardShadow}"
                    Padding="10,8">
                <WrapPanel HorizontalAlignment="Center">

                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="14,8" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي الكمية"
                                       Foreground="White" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTotQty"
                                       Text="0.00" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SaveBrush}"
                            CornerRadius="8" Padding="14,8" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="الإجمالي"
                                       Foreground="White" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTotTotal"
                                       Text="0.00" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#B8860B"
                            CornerRadius="8" Padding="14,8" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="الضريبة"
                                       Foreground="White" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTotVat"
                                       Text="0.00" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource InfoBrush}"
                            CornerRadius="8" Padding="14,8" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="الصافي"
                                       Foreground="White" FontSize="10"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="lblTotNet"
                                       Text="0.00" Foreground="White"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </Border>

            <!-- ══ Footer ══ -->
            <Border Grid.Row="2"
                    Background="{StaticResource FooterBrush}"
                    FlowDirection="LeftToRight"
                    Padding="10,8" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnClose"
                            Grid.Column="0"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Click="btnClose_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnExportExcel"
                                Content="📊 تصدير Excel"
                                Style="{StaticResource SaveBtn}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="btnExportExcel_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource InfoBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPreview_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90"
                                Click="btnPrint_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</dx:ThemedWindow>