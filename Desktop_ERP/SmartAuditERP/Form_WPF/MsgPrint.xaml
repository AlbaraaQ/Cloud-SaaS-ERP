<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.MsgPrint"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="خيار الطباعة"
    Width="510" Height="185"
    WindowStartupLocation="CenterScreen"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    WindowStyle="None"
    ResizeMode="NoResize"
    FlowDirection="RightToLeft">

    <dx:ThemedWindow.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="3"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>
    </dx:ThemedWindow.Resources>

    <Border Background="White"
            CornerRadius="14"
            Margin="6"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnNon"
                        Content="✖"
                        Width="34" Height="26"
                        Background="#A0522D"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnNon_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Grid.Column="1"
                           x:Name="lblMsg"
                           Text="🖨️ خيار الطباعة"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#1B2642"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="#E8EBF5"
                    Margin="0,0,0,14"/>

            <!-- Print Buttons -->
            <WrapPanel Grid.Row="2"
                       HorizontalAlignment="Center">

                <!-- طباعة POS -->
                <Button x:Name="btnPrintPos"
                        Content="🧾 طباعة POS"
                        Height="40" Width="110"
                        Margin="4,0"
                        Foreground="White"
                        FontSize="11" FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnPrintPos_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5B9BD5"/>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="6,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- طباعة A4 -->
                <Button x:Name="btnPrintA4"
                        Content="📄 طباعة A4"
                        Height="40" Width="110"
                        Margin="4,0"
                        Foreground="White"
                        FontSize="11" FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnPrintA4_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5B9BD5"/>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="6,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- طباعة PDF -->
                <Button x:Name="btnPrintPDF"
                        Content="📕 طباعة PDF"
                        Height="40" Width="110"
                        Margin="4,0"
                        Foreground="White"
                        FontSize="11" FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnPrintPDF_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5B9BD5"/>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="6,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- معاينة -->
                <Button x:Name="btnPerview"
                        Content="👁️ معاينة"
                        Height="40" Width="100"
                        Margin="4,0"
                        Foreground="White"
                        FontSize="11" FontWeight="Bold"
                        Cursor="Hand"
                        Click="btnPerview_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5B9BD5"/>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="6,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </WrapPanel>
        </Grid>
    </Border>
</dx:ThemedWindow>