<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmBookingM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="الحجوزات"
    Width="980" Height="610"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════ Brushes ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══════════ FieldLabel ═══════════ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RedLabel" TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ═══════════ TextBox ═══════════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ Button Styles ═══════════ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <!-- ═══════════ RadioButton ═══════════ -->
        <Style x:Key="RedRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#B22222"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <!-- ═══════════ DataGrid ═══════════ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════ Search Button Style ═══════════ -->
        <Style x:Key="SearchBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="50"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  TabControl                                        -->
        <!-- ══════════════════════════════════════════════════ -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FlowDirection="RightToLeft"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0">

            <!-- ══════════════════════════════════════════════ -->
            <!--  TabPage1: بيانات الحجوزات                    -->
            <!-- ══════════════════════════════════════════════ -->
            <TabItem x:Name="TabPage1" Header="📋 بيانات الحجوزات">
                <Border x:Name="GroupBox1"
                        Background="#F7F8FC"
                        Padding="10,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- الصف الأول: الرقم + التاريخ -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label1"
                                           Grid.Column="0"
                                           Text="🔢 الرقم"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="txtNo"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label3"
                                           Grid.Column="3"
                                           Text="📅 التاريخ"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <dxe:DateEdit x:Name="txtDate"
                                              Grid.Column="4"
                                              Height="30"
                                              FontSize="12"
                                              DisplayFormatString="d"/>

                                <TextBlock x:Name="Label20"
                                           Grid.Column="6"
                                           Text="📋 الفئة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <ComboBox x:Name="cmbGroup"
                                          Grid.Column="7"
                                          Height="30"
                                          FontSize="12"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="cmbGroup_SelectionChanged"/>
                            </Grid>

                            <!-- الصف الثاني: حالة الحجز + نوع الحجز -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label14"
                                           Grid.Column="0"
                                           Text="🔖 حالة الحجز"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"
                                           MouseLeftButtonDown="Label14_Click"/>

                                <ComboBox x:Name="cmbBookingStatu"
                                          Grid.Column="1"
                                          Height="30"
                                          FontSize="12"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="cmbBookingStatu_SelectionChanged">
                                    <ComboBoxItem Content="مؤكد"/>
                                    <ComboBoxItem Content="غير مؤكد"/>
                                </ComboBox>

                                <TextBlock x:Name="Label8"
                                           Grid.Column="3"
                                           Text="🚢 نوع الحجز"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton x:Name="rbNormal"
                                                 Content="حجز عادي"
                                                 Style="{StaticResource RedRadio}"
                                                 IsChecked="True"
                                                 GroupName="BookingType"/>

                                    <RadioButton x:Name="rbOpenSea"
                                                 Content="بحر مفتوح"
                                                 Style="{StaticResource RedRadio}"
                                                 GroupName="BookingType"
                                                 Margin="16,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- الصف الثالث: وقت الحجز + تاريخ الحجز + العميل -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="195"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label6"
                                           Grid.Column="0"
                                           Text="🕐 وقت الحجز"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <!-- txtTime: بديل DateTimePicker (Time) → TextBox HH:mm -->
                                <TextBox x:Name="txtTime"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         ToolTip="أدخل الوقت بصيغة HH:mm"/>

                                <TextBlock x:Name="Label7"
                                           Grid.Column="3"
                                           Text="📅 تاريخ الحجز"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <dxe:DateEdit x:Name="cmbBookingDate"
                                              Grid.Column="4"
                                              Height="30"
                                              FontSize="12"
                                              DisplayFormatString="d"/>

                                <TextBlock x:Name="Label5"
                                           Grid.Column="6"
                                           Text="👤 العميل"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,4,0"/>

                                <!-- btnAddClient: إضافة عميل -->
                                <Button x:Name="btnAddClient"
                                        Grid.Column="7"
                                        Content="➕"
                                        Style="{StaticResource SmallBtn}"
                                        ToolTip="إضافة عميل جديد"
                                        Margin="0,0,6,0"
                                        Click="btnAddClient_Click"/>

                                <ComboBox x:Name="cmbClients"
                                          Grid.Column="8"
                                          Height="30"
                                          FontSize="12"
                                          VerticalContentAlignment="Center"/>
                            </Grid>

                            <!-- الصف الرابع: المركب + القيمة + المدة -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label2"
                                           Grid.Column="0"
                                           Text="⚓ المركب"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <ComboBox x:Name="cmbMarine"
                                          Grid.Column="1"
                                          Height="30"
                                          FontSize="12"
                                          VerticalContentAlignment="Center"/>

                                <TextBlock x:Name="Label10"
                                           Grid.Column="3"
                                           Text="💰 القيمة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="txtPrice"
                                         Grid.Column="4"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"
                                         TextAlignment="Center"
                                         TextChanged="txtPrice_TextChanged"
                                         PreviewKeyDown="txtPrice_PreviewKeyDown"/>

                                <TextBlock x:Name="Label9"
                                           Grid.Column="6"
                                           Text="⏱️ المدة ساعة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <!-- hour: NumericUpDown → WPF TextBox -->
                                <TextBox x:Name="hour"
                                         Grid.Column="7"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label23"
                                           Grid.Column="8"
                                           Text="دقيقة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="8,0,8,0"/>

                                <!-- minute: NumericUpDown → WPF TextBox -->
                                <TextBox x:Name="minute"
                                         Grid.Column="9"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"
                                         TextAlignment="Center"/>
                            </Grid>

                            <!-- الصف الخامس: الإضافات -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label18"
                                           Grid.Column="0"
                                           Text="🎁 الإضافات"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <ComboBox x:Name="cmbAdditions"
                                          Grid.Column="1"
                                          Height="30"
                                          FontSize="12"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="cmbAdditions_SelectionChanged"/>

                                <!-- btnAddObj -->
                                <Button x:Name="btnAddObj"
                                        Grid.Column="2"
                                        Content="➕"
                                        Style="{StaticResource SmallBtn}"
                                        ToolTip="إضافة صنف جديد"
                                        Margin="4,0,0,0"
                                        Click="btnAddObj_Click"/>

                                <TextBlock x:Name="Label21"
                                           Grid.Column="4"
                                           Text="الكمية"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>

                                <TextBox x:Name="txtQuant"
                                         Grid.Column="5"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"
                                         TextAlignment="Center"
                                         TextChanged="txtQuant_TextChanged"
                                         PreviewKeyDown="txtQuant_PreviewKeyDown"/>

                                <TextBlock x:Name="price"
                                           Grid.Column="7"
                                           Text="السعر"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>

                                <TextBox x:Name="txtAdditPrice"
                                         Grid.Column="8"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         TextChanged="txtAdditPrice_TextChanged"/>

                                <TextBlock x:Name="Label22"
                                           Grid.Column="10"
                                           Text="الإجمالي"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>

                                <TextBox x:Name="txtAdditiTot"
                                         Grid.Column="11"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         IsReadOnly="True"/>

                                <!-- btnSave2DG -->
                                <Button x:Name="btnSave2DG"
                                        Grid.Column="12"
                                        Content="✔"
                                        Style="{StaticResource SaveBtn}"
                                        Width="40"
                                        Height="30"
                                        Margin="4,0,0,0"
                                        ToolTip="إضافة للجدول"
                                        Click="btnSave2DG_Click"/>
                            </Grid>

                            <!-- ══════════════════════════════ -->
                            <!--  dgvData: جدول الإضافات       -->
                            <!-- ══════════════════════════════ -->
                            <Border Background="White"
                                    CornerRadius="10"
                                    Effect="{StaticResource CardShadow}"
                                    Margin="0,0,0,8"
                                    Height="168">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="{StaticResource HeaderBrush}"
                                            CornerRadius="10,10,0,0">
                                        <TextBlock Text="🎁 الإضافات"
                                                   Foreground="White"
                                                   FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"/>
                                    </Border>

                                    <DataGrid x:Name="dgvData"
                                              Grid.Row="1"
                                              AutoGenerateColumns="False"
                                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                              RowStyle="{StaticResource DgvRow}"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              HeadersVisibility="Column"
                                              FlowDirection="RightToLeft"
                                              Background="White"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#E8EBF5"
                                              AlternatingRowBackground="#F8F9FD"
                                              SelectionChanged="dgvData_SelectionChanged"
                                              MouseLeftButtonUp="dgvData_CellClick">
                                        <DataGrid.Columns>

                                            <!-- Column5: id (مخفي) -->
                                            <DataGridTextColumn x:Name="Column5"
                                                                Header="id"
                                                                Binding="{Binding Id}"
                                                                Width="50"
                                                                Visibility="Collapsed"/>

                                            <!-- Column3: الوصف -->
                                            <DataGridTextColumn x:Name="Column3"
                                                                Header="الوصف"
                                                                Binding="{Binding Description}"
                                                                Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Column1: العدد -->
                                            <DataGridTextColumn x:Name="Column1"
                                                                Header="العدد"
                                                                Binding="{Binding Quantity}"
                                                                Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Column2: السعر -->
                                            <DataGridTextColumn x:Name="Column2"
                                                                Header="السعر"
                                                                Binding="{Binding UnitPrice}"
                                                                Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Column4: الإجمالي -->
                                            <DataGridTextColumn x:Name="Column4"
                                                                Header="الإجمالي"
                                                                Binding="{Binding TotalPrice}"
                                                                Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- Column6: حذف (Button) -->
                                            <DataGridTemplateColumn x:Name="Column6"
                                                                     Header=""
                                                                     Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="🗑️ حذف"
                                                                Tag="{Binding}"
                                                                Background="#E35656"
                                                                Foreground="White"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Padding="4,2"
                                                                Click="dgvData_DeleteClick">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd"
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="6"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- الصف السادس: الملاحظات + المجاميع -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- المجاميع -->
                                <Border Grid.Column="0"
                                        Background="White"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Effect="{StaticResource CardShadow}">
                                    <StackPanel>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txttotAdditions"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     IsReadOnly="True"
                                                     TextAlignment="Center"/>
                                            <TextBlock x:Name="Label19"
                                                       Grid.Column="1"
                                                       Text="إجمالي الإضافات"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="6,0,0,0"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtTotal"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     IsReadOnly="True"
                                                     TextAlignment="Center"/>
                                            <TextBlock x:Name="Label12"
                                                       Grid.Column="1"
                                                       Text="الإجمالي"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="6,0,0,0"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtTotTax"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     IsReadOnly="True"
                                                     TextAlignment="Center"/>
                                            <TextBlock x:Name="Label13"
                                                       Grid.Column="1"
                                                       Text="ضريبة 15%"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="6,0,0,0"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtTotNet"
                                                     Grid.Column="0"
                                                     Style="{StaticResource ModernTextBox}"
                                                     IsReadOnly="True"
                                                     TextAlignment="Center"/>
                                            <TextBlock x:Name="Label11"
                                                       Grid.Column="1"
                                                       Text="الصافي"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="6,0,0,0"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- ملاحظات -->
                                <Border Grid.Column="2"
                                        Background="White"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Effect="{StaticResource CardShadow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="Label4"
                                                   Grid.Row="0"
                                                   Text="📝 ملاحظات"
                                                   Style="{StaticResource RedLabel}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtNotes"
                                                 Grid.Row="1"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Background="White"
                                                 BorderBrush="{StaticResource BorderLight}"
                                                 BorderThickness="1"
                                                 Padding="8"
                                                 FontSize="12"
                                                 MinHeight="80"/>
                                    </Grid>
                                </Border>

                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ══════════════════════════════════════════════ -->
            <!--  TabPage2: البحث                              -->
            <!-- ══════════════════════════════════════════════ -->
            <TabItem x:Name="TabPage2" Header="🔍 البحث">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- GroupBox6: بحث -->
                    <Border x:Name="GroupBox6"
                            Grid.Row="0"
                            Background="White"
                            Margin="6,6,6,4"
                            CornerRadius="10"
                            Padding="12,10"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>

                            <!-- عنوان البحث -->
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8"
                                    Padding="12,6"
                                    Margin="0,0,0,10">
                                <TextBlock Text="🔍 بحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- صف بحث 1: رقم الحجز + اسم العميل + جوال -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label15"
                                           Grid.Column="0"
                                           Text="رقم الحجز"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="txtSrchNo"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label24"
                                           Grid.Column="3"
                                           Text="اسم العميل"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="txtClientName"
                                         Grid.Column="4"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label25"
                                           Grid.Column="6"
                                           Text="رقم الجوال"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <TextBox x:Name="txtCustPhone"
                                         Grid.Column="7"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <!-- btnSearch -->
                                <Button x:Name="btnSearch"
                                        Grid.Column="9"
                                        Content="🔍 بحث"
                                        Style="{StaticResource SearchBtn}"
                                        Click="btnSearch_Click"/>
                            </Grid>

                            <!-- صف بحث 2: من تاريخ + إلى تاريخ -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label27"
                                           Grid.Column="0"
                                           Text="من تاريخ"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <dxe:DateEdit x:Name="txtFromDate"
                                              Grid.Column="1"
                                              Height="30"
                                              FontSize="12"
                                              DisplayFormatString="d"/>

                                <TextBlock x:Name="Label26"
                                           Grid.Column="3"
                                           Text="إلى تاريخ"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,8,0"/>

                                <dxe:DateEdit x:Name="txtToDate"
                                              Grid.Column="4"
                                              Height="30"
                                              FontSize="12"
                                              DisplayFormatString="d"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- GroupBox4: نتائج البحث -->
                    <Border x:Name="GroupBox4"
                            Grid.Row="1"
                            Background="White"
                            Margin="6,0,6,6"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <!-- dgvSrch: جدول نتائج البحث -->
                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseLeftButtonUp="dgvSrch_CellClick">

                                <DataGrid.Columns>

                                    <!-- Column10: رقم الحركة (مخفي) -->
                                    <DataGridTextColumn x:Name="Column10"
                                                        Header="رقم الحركة"
                                                        Binding="{Binding ProcId}"
                                                        Width="100"
                                                        Visibility="Collapsed"/>

                                    <!-- DataGridViewTextBoxColumn1: الرقم -->
                                    <DataGridTextColumn x:Name="DataGridViewTextBoxColumn1"
                                                        Header="الرقم"
                                                        Binding="{Binding InvoiceId}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- DataGridViewTextBoxColumn2: التاريخ -->
                                    <DataGridTextColumn x:Name="DataGridViewTextBoxColumn2"
                                                        Header="التاريخ"
                                                        Binding="{Binding BookDate}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- DataGridViewTextBoxColumn3: العميل -->
                                    <DataGridTextColumn x:Name="DataGridViewTextBoxColumn3"
                                                        Header="العميل"
                                                        Binding="{Binding CustomerName}"
                                                        Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- mobile: الجوال (مخفي) -->
                                    <DataGridTextColumn x:Name="mobile"
                                                        Header="الجوال"
                                                        Binding="{Binding Mobile}"
                                                        Width="120"
                                                        Visibility="Collapsed"/>

                                    <!-- Column14: رقم العميل (مخفي) -->
                                    <DataGridTextColumn x:Name="Column14"
                                                        Header="رقم العميل"
                                                        Binding="{Binding CustomerId}"
                                                        Width="80"
                                                        Visibility="Collapsed"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════════════ -->
        <!--  panel2 - Footer: شريط الأزرار                   -->
        <!-- ══════════════════════════════════════════════════ -->
        <Border x:Name="panel2"
                Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- btnClose -->
                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖"
                        Style="{StaticResource DangerBtn}"
                        Width="44"
                        ToolTip="خروج"
                        Click="btnClose_Click"/>

                <!-- btnFirst -->
                <Button x:Name="btnFirst"
                        Grid.Column="2"
                        Content="⏮"
                        Style="{StaticResource NavBtn}"
                        ToolTip="الأول"
                        Click="btnFirst_Click"/>

                <!-- btnPrevious -->
                <Button x:Name="btnPrevious"
                        Grid.Column="4"
                        Content="◀"
                        Style="{StaticResource NavBtn}"
                        ToolTip="السابق"
                        Click="btnPrevious_Click"/>

                <!-- btnNext -->
                <Button x:Name="btnNext"
                        Grid.Column="6"
                        Content="▶"
                        Style="{StaticResource NavBtn}"
                        ToolTip="التالي"
                        Click="btnNext_Click"/>

                <!-- btnLast -->
                <Button x:Name="btnLast"
                        Grid.Column="8"
                        Content="⏭"
                        Style="{StaticResource NavBtn}"
                        ToolTip="الأخير"
                        Click="btnLast_Click"/>

                <!-- btnDelete -->
                <Button x:Name="btnDelete"
                        Grid.Column="10"
                        Content="🗑️"
                        Style="{StaticResource DangerBtn}"
                        Width="44"
                        ToolTip="حذف"
                        Click="btnDelete_Click"/>

                <!-- btnPrint -->
                <Button x:Name="btnPrint"
                        Grid.Column="12"
                        Content="🖨️"
                        Style="{StaticResource ActionBtn}"
                        Width="44"
                        ToolTip="طباعة"
                        Click="btnPrint_Click"/>

                <!-- btnSave -->
                <Button x:Name="btnSave"
                        Grid.Column="14"
                        Content="💾"
                        Style="{StaticResource SaveBtn}"
                        Width="44"
                        ToolTip="حفظ"
                        Click="btnSave_Click"/>

                <!-- btnNew -->
                <Button x:Name="btnNew"
                        Grid.Column="16"
                        Content="➕"
                        Style="{StaticResource ActionBtn}"
                        Width="44"
                        ToolTip="جديد"
                        Click="btnNew_Click"/>

            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>