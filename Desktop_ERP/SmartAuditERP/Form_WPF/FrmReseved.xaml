<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.FrmReseved"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="إستحقاق راتب"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E67E22" Offset="0"/>
            <GradientStop Color="#CA6F1E" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
        </Style>

        <Style x:Key="ShowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8E44AD" Offset="0"/>
                        <GradientStop Color="#6C3483" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold"
                    Background="#F3F5F9">

            <!-- ═══ تبويب إستحقاق ═══ -->
            <TabItem Header="   💰 إستحقاق   ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- بطاقة البيانات العلوية -->
                    <Border Grid.Row="0"
                            Background="White"
                            Margin="6,6,6,4"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- رقم السند -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رقم السند:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNo"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         TextAlignment="Center"
                                         Width="80"/>
                            </StackPanel>

                            <!-- الشهر -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="📅 الشهر:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbMonth"
                                          Style="{StaticResource ModernComboBox}"
                                          Width="70"
                                          SelectionChanged="cmbMonth_SelectionChanged">
                                    <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/><ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- السنة -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="📅 السنة:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbYear"
                                          Style="{StaticResource ModernComboBox}"
                                          Width="80"
                                          SelectionChanged="cmbYear_SelectionChanged"/>
                            </StackPanel>

                            <!-- التاريخ -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="📅 التاريخ:" Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtDate"
                                              Height="28" FontSize="11"
                                              FontWeight="SemiBold"
                                              Width="110"/>
                            </StackPanel>

                            <!-- الوقت -->
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="⏰ الوقت:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTime"
                                         Style="{StaticResource ModernTextBox}"
                                         Width="100"
                                         Text="00:00"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <!-- GlobalID (مخفي) -->
                            <TextBox x:Name="TxtGlobalID"
                                     Grid.Column="10"
                                     Visibility="Collapsed"/>
                            <TextBox x:Name="txtEntryGlobalId"
                                     Grid.Column="10"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- جدول الموظفين -->
                    <Border Grid.Row="1"
                            Background="White"
                            Margin="6,0,6,4"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="👔 رواتب الموظفين"
                                               Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="12,0"/>
                                    <Button x:Name="btnSelectAll"
                                            Grid.Column="1"
                                            Content="☑ اختيار الكل"
                                            Style="{StaticResource ActionBtn}"
                                            Width="120"
                                            Margin="0,3,8,3"
                                            Click="btnSelectAll_Click"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="GridControl1"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      CellEditEnding="GridControl1_CellEditEnding">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          Click="SelectAllRows_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="م"
                                                        Binding="{Binding DgvNo}"
                                                        Width="50" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="اسم الموظف"
                                                        Binding="{Binding Empnam}"
                                                        Width="150" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="كود الموظف"
                                                        Binding="{Binding AccCode}"
                                                        Width="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الراتب الأساسي"
                                                        Binding="{Binding BasicSal, StringFormat=N2}"
                                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="بدل سكن"
                                                        Binding="{Binding HousSal, StringFormat=N2}"
                                                        Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="بدل مواصلات"
                                                        Binding="{Binding TravelSal, StringFormat=N2}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="المكافآت"
                                                        Binding="{Binding Sal_add, StringFormat=N2}"
                                                        Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الإجمالي"
                                                        Binding="{Binding Total, StringFormat=N2}"
                                                        Width="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الخصومات"
                                                        Binding="{Binding Sal_Sub, StringFormat=N2}"
                                                        Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الصافي"
                                                        Binding="{Binding Net_Sal, StringFormat=N2}"
                                                        Width="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="ملاحظات"
                                                        Binding="{Binding Notes}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="رقم الموظف"
                                                        Binding="{Binding Emp}"
                                                        Visibility="Collapsed"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- الخروج -->
                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖"
                        Style="{StaticResource DangerBtn}"
                        Width="36"
                        Click="btnClose_Click"/>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnAll"
                            Content="🔍 عـرض"
                            Style="{StaticResource ShowBtn}"
                            Width="100"
                            Margin="0,0,5,0"
                            Click="BtnAll_Click"/>
                    <Button x:Name="btnviewEntry"
                            Content="📋 عرض القيد"
                            Style="{StaticResource ActionBtn}"
                            Width="110"
                            Margin="0,0,5,0"
                            Visibility="Collapsed"
                            Click="btnviewEntry_Click"/>
                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            Margin="0,0,5,0"
                            Click="btnView_Click"/>
                    <Button x:Name="IconButton6"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,5,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="IconButton7"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="78"
                            Margin="0,0,5,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="IconButton5"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="78"
                            Margin="0,0,5,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="IconButton3"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="78"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>