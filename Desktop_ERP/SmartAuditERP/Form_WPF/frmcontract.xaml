<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmcontract"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="فاتورة مقاولات"
    Width="1400"
    Height="850"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <dx:ThemedWindow.Resources>

        <!-- ============================= -->
        <!-- Brushes -->
        <!-- ============================= -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3E66C9" Offset="0"/>
            <GradientStop Color="#244A9A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FAFBFE" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#D7DEEE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2642"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6D91"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#1E9A51"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D87900"/>

        <!-- ============================= -->
        <!-- Effects -->
        <!-- ============================= -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="14"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.18"
                          Color="#000000"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.20"
                          Color="#000000"/>

        <!-- ============================= -->
        <!-- TextBox Style -->
        <!-- ============================= -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="#F5F7FB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F0F2F7"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================= -->
        <!-- ComboBox Style -->
        <!-- ============================= -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <!-- ============================= -->
        <!-- Label Style -->
        <!-- ============================= -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================= -->
        <!-- Button Style -->
        <!-- ============================= -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessButtonBrush}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerButtonBrush}"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#244A9A"/>
            <Setter Property="Background" Value="#EEF3FF"/>
            <Setter Property="BorderBrush" Value="#C7D5F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A63C3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================= -->
        <!-- Card Border Style -->
        <!-- ============================= -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- Header / GroupBox3                                    -->
        <!-- ===================================================== -->
        <Border x:Name="GroupBox3"
                Grid.Row="0"
                Margin="10,10,10,6"
                CornerRadius="18"
                Background="{StaticResource HeaderBrush}"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== Title Row ===== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="txtInvCode"
                                 Width="60"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"/>
                        <TextBox x:Name="txtNo"
                                 Width="100"
                                 Margin="6,0,0,0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"/>
                        <TextBlock x:Name="lblNO"
                                   Text="🔢 الرقم"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="lblReturn"
                               Grid.Column="1"
                               Text="📋 فاتورة المقــــاولات"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="ExtraBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                        <TextBlock x:Name="lblCurrentTime"
                                   Text="🕐 الوقت"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtInvoStatus"
                                   Text="📌 حالة الفاتورة"
                                   Foreground="#DDE6FF"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Row 1 ===== -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="lblPaymentMethod" Text="💳 طريقة الدفع" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbPayType" Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="آجلة"/>
                            <ComboBoxItem Content="نقدية"/>
                            <ComboBoxItem Content="بنك"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock x:Name="lblSafe" Text="🏦 الصندوق" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbTreasury" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock x:Name="lblBank" Text="🏛️ البنك" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbBanks" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock x:Name="lblStock" Text="🏗️ المستودع" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbStore" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" HorizontalAlignment="Left">
                        <TextBlock x:Name="lblDate" Text="📅 تاريخ الفاتورة" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="145"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker x:Name="txtDate"
                                        Grid.Column="0"
                                        Height="34"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="White"/>

                            <TextBox x:Name="txtInvTime"
                                     Grid.Column="2"
                                     Height="34"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     Style="{StaticResource ModernTextBoxStyle}"/>

                            <TextBlock x:Name="Label5"
                                       Grid.Column="2"
                                       Text="🕑 وقت الفاتورة"
                                       Foreground="Transparent"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ===== Row 2 ===== -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="lblClient" Text="👤 اسم العميل" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbClient"
                                  IsEditable="True"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button x:Name="btnZoom"
                            Grid.Column="1"
                            Margin="0,22,4,0"
                            Style="{StaticResource MiniButtonStyle}"
                            Content="🔍"/>

                    <Button x:Name="btnCustAdd"
                            Grid.Column="2"
                            Margin="0,22,8,0"
                            Style="{StaticResource MiniButtonStyle}"
                            Content="➕"/>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock x:Name="lblSalesMen" Text="🤝 المندوب" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbSalesMen" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button x:Name="cmbAddSalesMen"
                            Grid.Column="4"
                            Margin="0,22,8,0"
                            Style="{StaticResource MiniButtonStyle}"
                            Content="➕"/>

                    <StackPanel Grid.Column="5" Margin="0,0,8,0">
                        <TextBlock x:Name="lblCostCenter" Text="🏢 مركز التكلفة" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbCostCenter" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>

                    <Button x:Name="btnAddCostCenter"
                            Grid.Column="6"
                            Margin="0,22,8,0"
                            Height="34"
                            Style="{StaticResource MiniButtonStyle}"
                            Content="➕"/>

                    <StackPanel Grid.Column="7">
                        <TextBlock x:Name="Label7" Text="💰 الرصيد السابق" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtBalancePreviews"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"
                                 Text="0"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Row 3 ===== -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="lblCashCust" Text="💵 عميل نقدي" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtCashCust" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock x:Name="lblCashCustMobile" Text="📱 رقم الجوال" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtCashCustMobile" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock x:Name="lblRefNo" Text="🔖 رقم المرجع" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtRefNo" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock x:Name="lblRefDate" Text="📅 تاريخ المرجع" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="txtRefDate"
                                    Height="34"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Background="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="lblNote" Text="📝 البيان" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtNote"
                                 Height="34"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Row 4 ===== -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="Label8" Text="🏷️ الخصم" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtInvDiscVal"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Foreground="{StaticResource DangerBrush}"
                                 Text="0"/>
                    </StackPanel>

                    <TextBlock x:Name="Label42"
                               Grid.Column="1"
                               Text="="
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="18"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock x:Name="Label39" Text="📉 نسبة الخصم %" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtInvDiscPerc"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Foreground="{StaticResource DangerBrush}"
                                 Text="0"/>
                    </StackPanel>

                    <TextBlock x:Name="Label44"
                               Grid.Column="3"
                               Text="%"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="18"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock x:Name="Label15" Text="🔧 ضمان الأعمال %" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtWorkdiscPerc"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Foreground="{StaticResource DangerBrush}"
                                 Text="0"/>
                    </StackPanel>

                    <Grid Grid.Column="5"/>

                    <Button x:Name="btnInsertLinkedInv"
                            Grid.Column="6"
                            Style="{StaticResource ActionButtonStyle}"
                            Content="📎 إدراج"
                            Margin="0,18,8,0"/>

                    <TextBox x:Name="txtBalance"
                             Grid.Column="7"
                             Margin="0,18,0,0"
                             Style="{StaticResource ModernTextBoxStyle}"
                             IsReadOnly="True"/>
                </Grid>

                <!-- Hidden / Compatibility Controls -->
                <ComboBox x:Name="cmbInvoiceStatus" Visibility="Collapsed"/>
                <ComboBox x:Name="cmbClientSrch" Visibility="Collapsed"/>
                <ComboBox x:Name="cmbProcType" Visibility="Collapsed"/>
                <ComboBox x:Name="CmbYearPreviews" Visibility="Collapsed"/>
                <TextBlock x:Name="lblYearPreviews" Visibility="Collapsed" Text="سنوات سابقة"/>
                <TextBlock x:Name="lblClientSrch" Visibility="Collapsed" Text=""/>
                <TextBlock x:Name="lblPaidStatus" Visibility="Collapsed" Text=""/>
                <Button x:Name="BtnEgyPrint" Visibility="Collapsed" Content="طباعة كم البورتال"/>
                <Button x:Name="BtnSendToEta" Visibility="Collapsed" Content="إرسال"/>
                <Button x:Name="Button4" Visibility="Collapsed" Content="⬇"/>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- Main Grid Area                                        -->
        <!-- ===================================================== -->
        <Grid Grid.Row="1" Margin="10,0,10,6">

            <!-- Invoice Items Grid -->
            <Border CornerRadius="18"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    Effect="{StaticResource CardShadow}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            CornerRadius="18,18,0,0"
                            Background="{StaticResource HeaderBrush}">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="📦 بنود الفاتورة"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="إدخال / تعديل البنود"
                                       Foreground="#DDE6FF"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <dxg:GridControl x:Name="GridControl1"
                                     Grid.Row="1"
                                     Margin="8"
                                     AutoGenerateColumns="None">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="GridView1"
                                           ShowGroupPanel="False"
                                           NewItemRowPosition="Bottom"
                                           AutoWidth="False"
                                           NavigationStyle="Cell"
                                           AllowPerPixelScrolling="True"
                                           ShowIndicator="True"
                                           IndicatorWidth="40"/>
                        </dxg:GridControl.View>

                        <dxg:GridControl.Columns>
                            <dxg:GridColumn x:Name="ItemRowIndex" FieldName="ItemRowIndex" Header="#" Width="50" AllowEditing="False"/>
                            <dxg:GridColumn x:Name="ItemCode" FieldName="ItemCode" Header="🏷️ رمز الصنف" Width="100"/>
                            <dxg:GridColumn x:Name="ItemId" FieldName="ItemId" Header="رقم الصنف" Width="80" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemName" FieldName="ItemName" Header="📦 الصنف" Width="170"/>
                            <dxg:GridColumn x:Name="Description" FieldName="Description" Header="📄 الوصف" Width="160"/>
                            <dxg:GridColumn x:Name="ItemBarcode" FieldName="ItemBarcode" Header="الباركود" Width="120" Visible="False"/>
                            <dxg:GridColumn x:Name="UnitName" FieldName="UnitName" Header="📏 الوحدة" Width="100" AllowEditing="False"/>
                            <dxg:GridColumn x:Name="ItemQuantity" FieldName="ItemQuantity" Header="🔢 الكمية" Width="90"/>
                            <dxg:GridColumn x:Name="UnitEquality" FieldName="UnitEquality" Header="التعادل" Width="90" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemPrimaryQnty" FieldName="ItemPrimaryQnty" Header="إجمالي الكمية" Width="110" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemPrice" FieldName="ItemPrice" Header="💰 السعر" Width="90"/>
                            <dxg:GridColumn x:Name="ItemSumPrice" FieldName="ItemSumPrice" Header="📊 المجموع" Width="100"/>
                            <dxg:GridColumn x:Name="ItemCost" FieldName="ItemCost" Header="التكلفة" Width="90" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemDiscount" FieldName="ItemDiscount" Header="🏷️ الخصم" Width="90"/>
                            <dxg:GridColumn x:Name="ItemDiscountPerc" FieldName="ItemDiscountPerc" Header="نسبة الخصم" Width="95"/>
                            <dxg:GridColumn x:Name="ItemTotalPrice" FieldName="ItemTotalPrice" Header="الإجمالي" Width="100" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemVatPerc" FieldName="ItemVatPerc" Header="نسبة الضريبة" Width="95" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemVat" FieldName="ItemVat" Header="🧾 الضريبة" Width="90"/>
                            <dxg:GridColumn x:Name="ItemNetPrice" FieldName="ItemNetPrice" Header="✅ الصافي" Width="100"/>
                            <dxg:GridColumn x:Name="ValiableInvertory" FieldName="ValiableInvertory" Header="الكمية الحالية" Width="110" Visible="False"/>
                            <dxg:GridColumn x:Name="InvertoryName" FieldName="InvertoryName" Header="🏭 المستودع" Width="120"/>
                            <dxg:GridColumn x:Name="ItemExpireDate" FieldName="ItemExpireDate" Header="تاريخ الانتهاء" Width="120" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemNotes" FieldName="ItemNotes" Header="ملاحظة" Width="120" Visible="False"/>
                            <dxg:GridColumn x:Name="InvertoryId" FieldName="InvertoryId" Header="رقم المستودع" Width="100" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemPriceWithoutVAT" FieldName="ItemPriceWithoutVAT" Header="السعر الإفرادي" Width="110" Visible="False"/>
                            <dxg:GridColumn x:Name="WithholdingTax" FieldName="WithholdingTax" Header="الخصم من المنبع" Width="110" Visible="False"/>
                            <dxg:GridColumn x:Name="WithholdingTaxPerc" FieldName="WithholdingTaxPerc" Header="نسبة الخصم من المنبع" Width="130" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemPriceDiscount" FieldName="ItemPriceDiscount" Header="خصم الإفرادي" Width="110" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemPriceAfterDiscount" FieldName="ItemPriceAfterDiscount" Header="السعر بعد الخصم" Width="110" Visible="False"/>
                            <dxg:GridColumn x:Name="ItemCostCenter" FieldName="ItemCostCenter" Header="مركز التكلفة" Width="120" Visible="False"/>
                            <dxg:GridColumn x:Name="Additionsitem" FieldName="Additionsitem" Header="➕ الإضافات" Width="100"/>
                        </dxg:GridControl.Columns>
                    </dxg:GridControl>
                </Grid>
            </Border>

            <!-- Search Grid Overlay -->
            <Border x:Name="SearchOverlay"
                    Visibility="Collapsed"
                    Background="#CCFFFFFF"
                    CornerRadius="18"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    Panel.ZIndex="5"
                    Margin="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="18,18,0,0">
                        <TextBlock Text="🔍 نتائج البحث"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="16,0"/>
                    </Border>

                    <dxg:GridControl x:Name="dgvSrch"
                                     Grid.Row="1"
                                     Margin="10"
                                     AutoGenerateColumns="None">
                        <dxg:GridControl.View>
                            <dxg:TableView ShowGroupPanel="False"
                                           AutoWidth="False"
                                           NavigationStyle="Row"/>
                        </dxg:GridControl.View>

                        <dxg:GridControl.Columns>
                            <dxg:GridColumn x:Name="Column10" FieldName="Column10" Header="رقم الحركة" Width="100" Visible="False"/>
                            <dxg:GridColumn x:Name="DataGridViewTextBoxColumn1" FieldName="DataGridViewTextBoxColumn1" Header="الرقم" Width="100"/>
                            <dxg:GridColumn x:Name="Column2" FieldName="Column2" Header="رقم المرجع" Width="120"/>
                            <dxg:GridColumn x:Name="Column3" FieldName="Column3" Header="التاريخ" Width="120"/>
                            <dxg:GridColumn x:Name="Column1" FieldName="Column1" Header="العميل" Width="220"/>
                        </dxg:GridControl.Columns>
                    </dxg:GridControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================== -->
        <!-- Summary / GroupBox9                                   -->
        <!-- ===================================================== -->
        <Border x:Name="GroupBox9"
                Grid.Row="2"
                Margin="10,0,10,6"
                CornerRadius="18"
                Background="#F7F9FD"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= Panel1 ================= -->
                <Border x:Name="Panel1"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="📊 ملخص الفاتورة"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblTotSale" Text="💵 المجموع" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtSumVal" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label22" Text="🏷️ الخصم" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource DangerBrush}"/>
                            <TextBox x:Name="txtTotDiscount" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Foreground="{StaticResource DangerBrush}" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label4" Text="📄 الإجمالي" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtNetWithoutVAT" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label30" Text="🧾 الضريبة" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource WarningBrush}"/>
                            <TextBox x:Name="txtTotVAT" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Foreground="{StaticResource WarningBrush}" Text="0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label20" Text="✅ الصافي" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBox x:Name="txtNet" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Foreground="{StaticResource SuccessBrush}" Text="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= Panel2 ================= -->
                <Border x:Name="Panel2"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="📑 قيم العقد"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label12" Text="📜 قيمة العقد الإجمالية" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtcontract_total_value" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label6" Text="🔒 ضمان الأعمال" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource DangerBrush}"/>
                            <TextBox x:Name="txtwork_guarantee" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Foreground="{StaticResource DangerBrush}" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label1" Text="💸 الصافي المستحق لهذه الدفعة" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtnet_due_this_payment" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label9" Text="✅ المبلغ المسدد مسبقًا" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBox x:Name="txtpreviously_paid_amount" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Foreground="{StaticResource SuccessBrush}" Text="0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label2" Text="⚖️ الرصيد المتبقي من قيمة العقد" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtremaining_contract_balance" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Text="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= Panel3 ================= -->
                <Border x:Name="Panel3"
                        Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="🏗️ تفاصيل قيمة الأعمال"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label13" Text="🏗️ المبلغ الأصلي للأعمال" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtoriginal_work_amount" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label10" Text="🔴 خصم خاص" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource DangerBrush}"/>
                            <TextBox x:Name="txtspecial_discount" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Foreground="{StaticResource DangerBrush}" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label14" Text="📉 قيمة الفاتورة بعد الخصم" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtamount_after_discount" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Text="0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label11" Text="🧾 ضريبة القيمة المضافة بعد الخصم" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource WarningBrush}"/>
                            <TextBox x:Name="txtvat_amount" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Foreground="{StaticResource WarningBrush}" Text="0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Label3" Text="✅ الإجمالي مع الضريبة" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBox x:Name="txttotal_with_vat" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" Foreground="{StaticResource SuccessBrush}" Text="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Summary mini fields -->
                <Border Grid.ColumnSpan="3"
                        Margin="0,200,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock x:Name="lblTirmsNo" Text="📋 عدد البنود" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtTirmsNo" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock x:Name="lblTotQuan" Text="📦 إجمالي الكمية" Style="{StaticResource SummaryLabelStyle}"/>
                            <TextBox x:Name="txtTotQuan" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock x:Name="lblPaid" Text="💳 المدفوع" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBox x:Name="txtInvPaid" Style="{StaticResource ModernTextBoxStyle}" Foreground="{StaticResource SuccessBrush}" Text="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock x:Name="lblRemainder" Text="⚖️ الباقي" Style="{StaticResource SummaryLabelStyle}" Foreground="{StaticResource DangerBrush}"/>
                            <TextBox x:Name="txtInvRemainder" Style="{StaticResource ModernTextBoxStyle}" Foreground="{StaticResource DangerBrush}" Text="0"/>
                        </StackPanel>

                        <TextBlock x:Name="lblInvTaxEqual"
                                   Grid.Column="4"
                                   Text=""
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===================================================== -->
        <!-- Footer Buttons / pnlOperBtns                          -->
        <!-- ===================================================== -->
        <Border x:Name="pnlOperBtns"
                Grid.Row="3"
                Margin="10,0,10,10"
                CornerRadius="18"
                Background="{StaticResource FooterBrush}"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Menu Button -->
                <Button x:Name="ToolStripDropDownButton1"
                        Grid.Column="0"
                        Style="{StaticResource NavButtonStyle}"
                        Content="☰"
                        ToolTip="خيارات إضافية">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ToolStrip2" FlowDirection="RightToLeft">
                            <MenuItem x:Name="stripImport" Header="📥 استيراد"/>
                            <MenuItem x:Name="stripExport" Header="📤 تصدير"/>
                            <MenuItem x:Name="StripProfit" Header="💹 ربح الفاتورة"/>
                            <MenuItem x:Name="BTnShowEntry" Header="📖 عرض القيد"/>
                            <MenuItem x:Name="BtnSaveDgvSettings" Header="💾 حفظ المظهر"/>
                            <MenuItem x:Name="BtnDefaultSetting" Header="🔄 إعادة الجدول الافتراضي"/>
                            <MenuItem x:Name="StripImportInv" Header="📋 إدراج فاتورة"/>
                            <MenuItem x:Name="OpenReportDesgin" Header="🎨 تصميم الفاتورة"/>
                            <MenuItem x:Name="BtnImportDocument" Header="📎 إرفاق مستند"/>
                            <MenuItem x:Name="BtnShowDocument" Header="📂 عرض المستندات"/>
                            <MenuItem x:Name="ExportPDF" Header="📄 طباعة PDF"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Rectangle Grid.Column="1" Width="1" Fill="#5677C6" Margin="2,4"/>

                <Button x:Name="btnClose"
                        Grid.Column="2"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="48"
                        Content="✖"/>

                <Button x:Name="btnFirst"
                        Grid.Column="3"
                        Style="{StaticResource NavButtonStyle}"
                        Content="⏮"/>

                <Button x:Name="btnPrevious"
                        Grid.Column="4"
                        Style="{StaticResource NavButtonStyle}"
                        Content="◀"/>

                <Button x:Name="btnInvSrch"
                        Grid.Column="5"
                        Style="{StaticResource NavButtonStyle}"
                        Content="🔍"/>

                <Button x:Name="btnNext"
                        Grid.Column="6"
                        Style="{StaticResource NavButtonStyle}"
                        Content="▶"/>

                <Button x:Name="btnLast"
                        Grid.Column="7"
                        HorizontalAlignment="Left"
                        Width="48"
                        Style="{StaticResource NavButtonStyle}"
                        Content="⏭"
                        Margin="0,0,12,0"/>

                <Button x:Name="BtnReceipts"
                        Grid.Column="8"
                        Style="{StaticResource ActionButtonStyle}"
                        Content="🧾 سند قبض"
                        Margin="4,0"/>

                <Button x:Name="btnView"
                        Grid.Column="9"
                        Style="{StaticResource ActionButtonStyle}"
                        Content="👁️ معاينة F8"
                        Margin="4,0"/>

                <Button x:Name="btnSavePrint"
                        Grid.Column="10"
                        Style="{StaticResource SuccessButtonStyle}"
                        Content="🖨️ حفظ مع طباعة"
                        Margin="4,0"/>

                <Button x:Name="btnPrint"
                        Grid.Column="11"
                        Style="{StaticResource ActionButtonStyle}"
                        Content="🖨️ طباعة F7"
                        Margin="4,0"/>

                <Button x:Name="btnSave"
                        Grid.Column="12"
                        Style="{StaticResource SuccessButtonStyle}"
                        Content="💾 حفظ F6"
                        Margin="4,0"/>

                <Button x:Name="btnNew"
                        Grid.Column="13"
                        Style="{StaticResource ActionButtonStyle}"
                        Content="➕ جديد F5"
                        Margin="4,0"/>

                <Button x:Name="btnDelete"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="🗑️ حذف F9"/>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>