<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptItemsActivityDetailed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="حركة صنف تفصيلي"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#17A2B8" Offset="0"/>
            <GradientStop Color="#117A8B" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="SidebarBg"  Color="#F0F2F8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E4E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernRadioBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#3A63C3"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF3FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SummaryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7A99"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#213A7A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════
             SIDEBAR
        ══════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">

                    <!-- عنوان -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="10,6"
                            Margin="0,0,0,10">
                        <TextBlock Text="📦 حركة صنف تفصيلي"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- ══ الفرع ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏬 الفرع"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="chkAllBranches"
                                      Content="الكل" IsChecked="False"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="chkAllBranches_CheckedChanged"
                                      Unchecked="chkAllBranches_CheckedChanged"/>
                            <ComboBox x:Name="cmbBranches"
                                      Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ المستودع ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏭 المستودع"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="chkAll"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="chkAll_CheckedChanged"
                                      Unchecked="chkAll_CheckedChanged"/>
                            <ComboBox x:Name="cmbSafes"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ الصنف ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📦 الصنف"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChekAllItems"
                                      Content="الكل (جميع الأصناف)"
                                      IsChecked="False"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,6"
                                      Checked="ChekAllItems_CheckedChanged"
                                      Unchecked="ChekAllItems_CheckedChanged"/>

                            <TextBlock Text="اسم الصنف:" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtItemName"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         KeyDown="txtItemName_KeyDown"/>
                                <Button Grid.Column="1"
                                        Content="🔍"
                                        Style="{StaticResource ActionBtn}"
                                        Height="30" Width="34"
                                        FontSize="14"
                                        Margin="2,0,0,0"
                                        Click="btnSearch_Click"
                                        ToolTip="بحث عن صنف"/>
                            </Grid>

                            <TextBlock Text="رمز الصنف:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtItemCode"
                                     Style="{StaticResource ModernTextBox}"
                                     TextAlignment="Center"
                                     KeyDown="txtItemCode_KeyDown"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ الفترة ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📅 الفترة"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,6"/>

                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="ckTotalPeriod"
                                          Content="فترة كاملة" IsChecked="True"
                                          Style="{StaticResource ModernCheckBox}"
                                          Margin="0,0,10,0"
                                          Checked="ckTotalPeriod_CheckedChanged"
                                          Unchecked="ckTotalPeriod_CheckedChanged"/>
                                <CheckBox x:Name="cbLastProcess"
                                          Content="آخر حركة"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="cbLastProcess_CheckedChanged"
                                          Unchecked="cbLastProcess_CheckedChanged"/>
                            </WrapPanel>

                            <TextBlock Text="من تاريخ:" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtDateFrom"
                                          Height="30" FontSize="12"
                                          IsEnabled="False" Margin="0,0,0,6"/>

                            <TextBlock Text="إلى تاريخ:" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtDateTo"
                                          Height="30" FontSize="12"
                                          IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ عميل / مورد ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="👥 عميل / مورد"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="chkAllClients"
                                             Content="الكل" IsChecked="True"
                                             GroupName="ClientGroup"
                                             Style="{StaticResource ModernRadioBtn}"
                                             Margin="0,0,10,0"
                                             Checked="chkAllClients_CheckedChanged"/>
                                <RadioButton x:Name="chkClients"
                                             Content="عميل"
                                             GroupName="ClientGroup"
                                             Style="{StaticResource ModernRadioBtn}"
                                             Margin="0,0,10,0"
                                             Checked="chkClients_CheckedChanged"/>
                                <RadioButton x:Name="chkSuplier"
                                             Content="مورد"
                                             GroupName="ClientGroup"
                                             Style="{StaticResource ModernRadioBtn}"
                                             Checked="chkSuplier_CheckedChanged"/>
                            </WrapPanel>
                            <ComboBox x:Name="cmbClients"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ نوع العملية ══ -->
                    <Border Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🔄 نوع العملية"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="chkAllProcType"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="chkAllProcType_CheckedChanged"
                                      Unchecked="chkAllProcType_CheckedChanged"/>
                            <ComboBox x:Name="cmbProcType"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"
                                      SelectionChanged="cmbProcType_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ أنماط الفواتير (يظهر/يختفي حسب الاختيار) ══ -->
                    <Border x:Name="pnlInvType"
                            Background="White" CornerRadius="8"
                            Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="📋 أنماط الفواتير"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,6"/>
                            <RadioButton x:Name="rdAllInv"
                                         Content="الكل" IsChecked="True"
                                         GroupName="InvTypeGroup"
                                         Style="{StaticResource ModernRadioBtn}"/>
                            <RadioButton x:Name="rdInvType1"
                                         Content="مشتريات"
                                         GroupName="InvTypeGroup"
                                         Style="{StaticResource ModernRadioBtn}"/>
                            <RadioButton x:Name="rdInvType2"
                                         Content="مرتجع مشتريات"
                                         GroupName="InvTypeGroup"
                                         Style="{StaticResource ModernRadioBtn}"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ زر العرض ══ -->
                    <Button x:Name="bntShow"
                            Content="🔍 عرض النتائج"
                            Style="{StaticResource SaveBtn}"
                            Height="38" FontSize="13"
                            Margin="0,4,0,0"
                            Click="bntShow_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════
             MAIN CONTENT
        ══════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ DataGrid Card ══ -->
            <Border Grid.Row="0"
                    Background="White"
                    Margin="8,8,8,0" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="📋 بيانات الحركة التفصيلية"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <DataGrid x:Name="GridControl1"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <!-- م -->
                            <DataGridTextColumn Header="م"
                                                Binding="{Binding DgvNo}"
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- نوع الفاتورة -->
                            <DataGridTextColumn Header="نوع الفاتورة"
                                                Binding="{Binding DgvInvType}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- المستودع -->
                            <DataGridTextColumn Header="🏭 المستودع"
                                                Binding="{Binding DgvStore}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- رمز الصنف -->
                            <DataGridTextColumn Header="رمز الصنف"
                                                Binding="{Binding DgvItemCode}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الصنف -->
                            <DataGridTextColumn Header="📦 الصنف"
                                                Binding="{Binding DgvItemName}"
                                                Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- رقم الفاتورة -->
                            <DataGridTextColumn Header="رقم الفاتورة"
                                                Binding="{Binding DgvInvNo}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- رقم المرجع -->
                            <DataGridTextColumn Header="رقم المرجع"
                                                Binding="{Binding DgvRefNo}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- التاريخ -->
                            <DataGridTextColumn Header="📅 التاريخ"
                                                Binding="{Binding DgvDate}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الحساب -->
                            <DataGridTextColumn Header="👥 الحساب"
                                                Binding="{Binding DgvClient}"
                                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الوحدة -->
                            <DataGridTextColumn Header="الوحدة"
                                                Binding="{Binding DgvUnit}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الكمية في الفاتورة -->
                            <DataGridTextColumn Header="الكمية في الفاتورة"
                                                Binding="{Binding DgvQtyInv, StringFormat=N2}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- السعر في الفاتورة -->
                            <DataGridTextColumn Header="السعر في الفاتورة"
                                                Binding="{Binding DgvPriceInv, StringFormat=N2}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الإجمالي في الفاتورة -->
                            <DataGridTextColumn Header="الإجمالي في الفاتورة"
                                                Binding="{Binding DgvTotInv, StringFormat=N2}"
                                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الكمية الداخلة -->
                            <DataGridTextColumn Header="📥 الكمية الداخلة"
                                                Binding="{Binding DgvIncomeQty, StringFormat=N2}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الكمية الخارجة -->
                            <DataGridTextColumn Header="📤 الكمية الخارجة"
                                                Binding="{Binding DgvOutcomeQty, StringFormat=N2}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الرصيد -->
                            <DataGridTextColumn Header="⚖️ الرصيد"
                                                Binding="{Binding DgvBlc, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- السعر -->
                            <DataGridTextColumn Header="السعر"
                                                Binding="{Binding DgvPrice, StringFormat=N2}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الإجمالي -->
                            <DataGridTextColumn Header="💰 الإجمالي"
                                                Binding="{Binding DgvTot, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- تفاصيل الفاتورة - زر -->
                            <DataGridTemplateColumn Header="📄 الفاتورة" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📄 فتح"
                                                Tag="{Binding}"
                                                Height="22" FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Background="#2E4E9E"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="btnOpenInvoice_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="4,2">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══ ProgressBar ══ -->
            <ProgressBar x:Name="ProgressBar1"
                         Grid.Row="1"
                         Height="8" Margin="8,4,8,0"
                         Value="0" Maximum="100"
                         Foreground="#3A63C3"
                         Background="#E8EBF5"/>

            <!-- ══ إجمالي الرصيد ══ -->
            <Border Grid.Row="2"
                    Background="White"
                    Margin="8,6,8,0" CornerRadius="10"
                    Effect="{StaticResource CardShadow}"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="ملاحظة: الرصيد = مجموع الكميات الداخلة - الكميات الخارجة"
                               FontSize="11" Foreground="#6B7A99"
                               FontStyle="Italic"
                               VerticalAlignment="Center"/>

                    <Border Grid.Column="1" Style="{StaticResource SummaryCard}"
                            MinWidth="220" Margin="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚖️ إجمالي الرصيد:"
                                       Style="{StaticResource SummaryTitle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       FontSize="12"/>
                            <TextBlock x:Name="txtTotStock"
                                       Text="0.00"
                                       Style="{StaticResource SummaryValue}"
                                       FontSize="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ Footer ══ -->
            <Border Grid.Row="3"
                    Background="{StaticResource FooterBrush}"
                    FlowDirection="LeftToRight"
                    Padding="10,8" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="btnClose"
                                Content="✖ خروج"
                                Style="{StaticResource DangerBtn}"
                                Width="80" Margin="0,0,6,0"
                                Click="btnClose_Click"/>
                        <Button x:Name="btnDgvSettings"
                                Content="⚙️ الجدول"
                                Style="{StaticResource ActionBtn}"
                                Width="80" Margin="0,0,6,0"
                                Click="btnDgvSettings_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnExport"
                                Content="📊 تصدير Excel"
                                Style="{StaticResource SaveBtn}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="btnExport_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource InfoBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPreview_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90"
                                Click="btnPrint_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</dx:ThemedWindow>