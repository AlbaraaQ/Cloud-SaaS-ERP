<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSandQAndroid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="سند قبض أندرويد"
    Width="1000" Height="620"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A5276" Offset="0"/>
            <GradientStop Color="#2874A6" Offset="0.6"/>
            <GradientStop Color="#3498DB" Offset="1"/>
        </LinearGradientBrush>
        <!-- أخضر للقبض (عكس الصرف) -->
        <LinearGradientBrush x:Key="ReceiptBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A7A4A" Offset="0"/>
            <GradientStop Color="#27AE60" Offset="0.6"/>
            <GradientStop Color="#2ECC71" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A5276" Offset="0"/>
            <GradientStop Color="#2874A6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#17A2B8" Offset="0"/>
            <GradientStop Color="#117A8B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarningBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0A500" Offset="0"/>
            <GradientStop Color="#C47D00" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernRadioBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>
        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>
        <Style x:Key="ReceiptBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ReceiptBrush}"/>
        </Style>
        <Style x:Key="NavBtn"     TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="BalanceTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#FFE5E5"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ReceiptBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D5F5E3"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAFAF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TabControl ══ -->
        <TabControl x:Name="TabControl1" Grid.Row="0"
                    FlowDirection="RightToLeft">

            <!-- ══ TabPage1 — سند قبض أندرويد ══ -->
            <TabItem Header="🤖 سند قبض أندرويد">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="#F5F6FA">
                    <StackPanel Margin="8">

                        <!-- ══ GroupBox3 — بيانات السند ══ -->
                        <Border Background="White" CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>

                                <Border Background="{StaticResource ReceiptBrush}"
                                        CornerRadius="7" Padding="10,5"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="🤖 سند قبض أندرويد"
                                               Foreground="White"
                                               FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- الصف 1: رقم السند + الوقت + التاريخ + المرجع -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="رقم السند:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNo" Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True" TextAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="الوقت:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtTime" Grid.Column="4"
                                                  Height="28" FontSize="11"
                                                  MaskType="DateTime" Mask="HH:mm"/>

                                    <TextBlock Grid.Column="6" Text="📅 التاريخ:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtDate" Grid.Column="7"
                                                  Height="28" FontSize="11"/>

                                    <TextBlock Grid.Column="9" Text="رقم المرجع:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtRef" Grid.Column="10"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <TextBlock Grid.Column="12" Text="تاريخ المرجع:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtRefDate" Grid.Column="13"
                                                  Height="28" FontSize="11"/>
                                </Grid>

                                <!-- الصف 2: الفرع + قيمة السند + حساب العميل -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🏬 الفرع:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbBranches" Grid.Column="1"
                                              Style="{StaticResource ModernComboBox}"
                                              IsEnabled="False"/>

                                    <TextBlock Grid.Column="3" Text="💰 قيمة السند:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtVal" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"/>

                                    <TextBlock Grid.Column="6" Text="👤 حساب العميل:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbClients" Grid.Column="7"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="cmbClients_SelectionChanged"
                                              KeyDown="cmbClients_KeyDown"/>
                                    <Button Grid.Column="8"
                                            Content="+"
                                            Style="{StaticResource ReceiptBtn}"
                                            Width="34" Height="28" FontSize="14"
                                            ToolTip="إضافة عميل"
                                            Click="btnClient_Click"/>
                                    <Button Grid.Column="9"
                                            Content="🔍"
                                            Style="{StaticResource ActionBtn}"
                                            Width="34" Height="28" FontSize="12"
                                            ToolTip="بحث عن عميل"
                                            Click="btnSearchAcc_Click"/>

                                    <!-- رصيد العميل -->
                                    <TextBox x:Name="txtBalanceType" Grid.Column="11"
                                             Style="{StaticResource BalanceTextBox}"
                                             Width="70" TextAlignment="Center"/>
                                    <TextBox x:Name="txtBalance" Grid.Column="13"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True" TextAlignment="Center"/>
                                </Grid>

                                <!-- الصف 3: مركز التكلفة -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="مركز التكلفة:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbCostCenter" Grid.Column="1"
                                              Style="{StaticResource ModernComboBox}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══ GroupBox5 — تفاصيل الدفع ══ -->
                        <Border Background="White" CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>

                                <Border Background="{StaticResource InfoBrush}"
                                        CornerRadius="7" Padding="10,5"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="💳 تفاصيل الاستلام"
                                               Foreground="White"
                                               FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- طريقة الدفع -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton x:Name="rdCash" Grid.Column="0"
                                                 Content="نقدي" IsChecked="True"
                                                 GroupName="PayGroup"
                                                 Style="{StaticResource ModernRadioBtn}"
                                                 Checked="rdCash_CheckedChanged"/>
                                    <RadioButton x:Name="rdCheck" Grid.Column="1"
                                                 Content="بنكي"
                                                 GroupName="PayGroup"
                                                 Style="{StaticResource ModernRadioBtn}"
                                                 Checked="rdCash_CheckedChanged"/>
                                    <RadioButton x:Name="rdCheckAll" Grid.Column="2"
                                                 Content="الكل"
                                                 GroupName="PayGroup"
                                                 Style="{StaticResource ModernRadioBtn}"
                                                 Click="rdCheckAll_Click"/>

                                    <TextBlock Grid.Column="4" Text="يودع في حساب:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbDepositTO" Grid.Column="5"
                                              Style="{StaticResource ModernComboBox}"
                                              KeyDown="cmbDepositTO_KeyDown"/>
                                </Grid>

                                <!-- بيانات الشيك (تظهر عند اختيار بنكي) -->
                                <Border x:Name="pnlCheck"
                                        Background="#EBF5FB"
                                        CornerRadius="8" Padding="10,8"
                                        Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="رقم الشيك:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtCheckNo" Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"/>

                                        <TextBlock Grid.Column="3" Text="تاريخ الاستحقاق:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <dxe:DateEdit x:Name="txtCheckDate" Grid.Column="4"
                                                      Height="28" FontSize="11"/>

                                        <TextBlock Grid.Column="6" Text="حالة الشيك:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbCheckType" Grid.Column="7"
                                                  Style="{StaticResource ModernComboBox}"/>

                                        <TextBlock Grid.Column="9" Text="البنك:"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtBankCheck" Grid.Column="10"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </Grid>
                                </Border>

                                <!-- حقول إضافية (رصيد الطلب / قيمة دولار) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="رصيد الطلب:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtRequest" Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <TextBlock Grid.Column="3" Text="قيمة بالدولار:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtValD" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"/>
                                </Grid>

                                <!-- المندوب + البيان -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="المندوب:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbSalesMan" Grid.Column="1"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <TextBlock Grid.Column="3" Text="📝 البيان:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNotes" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="50" TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Grid>

                                <!-- محرر السند -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="محرر السند:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="Editereciept" Grid.Column="1"
                                               Foreground="Red"
                                               FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══ أزرار المستندات ══ -->
                        <WrapPanel HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Button x:Name="BtnImportDocument"
                                    Content="📎 إرفاق مستند"
                                    Style="{StaticResource WarningBtn}"
                                    MinWidth="120" Margin="0,0,8,0"
                                    Click="BtnImportDocument_Click"/>
                            <Button x:Name="Btnshowdocument"
                                    Content="👁️ عرض مستند"
                                    Style="{StaticResource InfoBtn}"
                                    MinWidth="120"
                                    Click="Btnshowdocument_Click"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ TabPage2 — البحث ══ -->
            <TabItem Header="🔍 البحث">
                <Grid Background="#F5F6FA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- فلاتر البحث -->
                    <Border Grid.Row="0" Background="White"
                            Margin="8,8,8,0" CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="رقم السند:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSrchNo" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     TextAlignment="Center"/>

                            <TextBlock Grid.Column="3" Text="رقم المرجع:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSrchRef" Grid.Column="4"
                                     Style="{StaticResource ModernTextBox}"
                                     TextAlignment="Center"/>

                            <TextBlock Grid.Column="6" Text="من تاريخ:"
                                       Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtFromDate" Grid.Column="7"
                                          Height="28" FontSize="11"
                                          IsEnabled="False"/>

                            <TextBlock Grid.Column="9" Text="إلى تاريخ:"
                                       Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtToDate" Grid.Column="10"
                                          Height="28" FontSize="11"
                                          IsEnabled="False"/>

                            <CheckBox x:Name="chkall" Grid.Column="12"
                                      Content="كل الفترة" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,10,0"
                                      Checked="chkall_CheckedChanged"
                                      Unchecked="chkall_CheckedChanged"/>

                            <Button x:Name="btnSearch" Grid.Column="13"
                                    Content="🔍 بحث"
                                    Style="{StaticResource ReceiptBtn}"
                                    Width="90" Height="30"
                                    Click="btnSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- جدول النتائج -->
                    <Border Grid.Row="1" Background="White"
                            Margin="8,6,8,0" CornerRadius="10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource ReceiptBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث عن سندات القبض"
                                           Foreground="White"
                                           FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch" Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F0FFF0"
                                      MouseDoubleClick="dgvSrch_MouseDoubleClick">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GID"
                                                        Binding="{Binding GlobalId}"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الرقم"
                                                        Binding="{Binding ReceiptNo}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="📅 التاريخ"
                                                        Binding="{Binding ReceiptDate}"
                                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="💰 المبلغ"
                                                        Binding="{Binding Payment, StringFormat=N2}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="👤 العميل"
                                                        Binding="{Binding ClientName}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══ Footer Buttons ══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖" Style="{StaticResource DangerBtn}"
                        Width="36" Margin="0,0,8,0"
                        ToolTip="خروج" Click="btnClose_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnFirst" Content="⏮"
                            Style="{StaticResource NavBtn}"
                            Margin="0,0,2,0"
                            ToolTip="الأول" Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀"
                            Style="{StaticResource NavBtn}"
                            Margin="0,0,2,0"
                            ToolTip="السابق" Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext" Content="▶"
                            Style="{StaticResource NavBtn}"
                            Margin="0,0,2,0"
                            ToolTip="التالي" Click="btnNext_Click"/>
                    <Button x:Name="btnLast" Content="⏭"
                            Style="{StaticResource NavBtn}"
                            Margin="0,0,8,0"
                            ToolTip="الأخير" Click="btnLast_Click"/>

                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            MinWidth="70" Margin="0,0,4,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource InfoBtn}"
                            MinWidth="80" Margin="0,0,4,0"
                            Click="btnView_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            MinWidth="80" Margin="0,0,4,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource ReceiptBtn}"
                            MinWidth="70" Margin="0,0,4,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            MinWidth="70"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>