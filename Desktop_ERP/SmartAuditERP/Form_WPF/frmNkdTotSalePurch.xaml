<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmNkdTotSalePurch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="إجمالي المبيعات والمشتريات"
    Width="980"
    Height="720"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmNkdTotSalePurch_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#28A745" Offset="0"/>
            <GradientStop Color="#1C7C31" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F7CF7" Offset="0"/>
            <GradientStop Color="#305EDB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ViewBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#D98B10" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.13" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>
        <Style x:Key="ViewBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ViewBrush}"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCE7FF"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F4FF"/></Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="14,10">
            <TextBlock Text="📊 إجمالي المبيعات والمشتريات" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>

                        <Border Background="{StaticResource HeaderBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <TextBlock Text="⚙️ خيارات البحث" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- الفترة الزمنية -->
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📅 الفترة الزمنية" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox x:Name="ckTotalPeriod" Grid.Column="1" Content="كل الفترة" IsChecked="True" Style="{StaticResource ModernCheckBox}" Checked="ckTotalPeriod_CheckedChanged" Unchecked="ckTotalPeriod_CheckedChanged"/>
                                </Grid>

                                <TextBlock x:Name="lblDateFrom" Text="من" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="txtDateFrom" Style="{StaticResource ModernDatePicker}" IsEnabled="False" SelectedDateFormat="Short" Margin="0,0,0,6"/>

                                <TextBlock x:Name="lblDateTo" Text="إلى" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="txtDateTo" Style="{StaticResource ModernDatePicker}" IsEnabled="False" SelectedDateFormat="Short"/>
                            </StackPanel>
                        </Border>

                        <!-- زر العرض -->
                        <Button x:Name="btnShow" Content="🔎 عرض" Style="{StaticResource ViewBtn}" Height="42" FontSize="14" Click="Button1_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DataGrid -->
            <Border Grid.Column="1" Margin="6,6,6,4" Background="White" CornerRadius="10" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Headers -->
                    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="10,10,0,0" Padding="0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم الصنف" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="الصنف" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="📦 الكمية (مشتريات)" Foreground="#CCE5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="💰 الإجمالي (مشتريات)" Foreground="#CCE5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="📦 الكمية (مبيعات)" Foreground="#CCFFCC" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="💰 الإجمالي (مبيعات)" Foreground="#CCFFCC" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Sub Header Labels -->
                    <Grid Grid.Row="1" Background="#2E4E9E">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="إجمالي المشتريات" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="إجمالي المبيعات" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="dgvItems"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              HeadersVisibility="None"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource GridRowStyle}"
                              AlternatingRowBackground="#F5F8FF"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E7ECF5"
                              Background="White">

                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Column1}" Width="80" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Binding="{Binding Column2}" Width="120" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Binding="{Binding Column3}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Binding="{Binding Column4}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Binding="{Binding Column6}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Binding="{Binding Column5}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Summary Bar -->
        <Border Grid.Row="2" Background="#2D2D2D" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Label9" Grid.Column="0" Text="إجمالي المشتريات:" Style="{StaticResource SummaryLabel}" Margin="0,0,8,0"/>
                <TextBlock x:Name="txtSumPurch" Grid.Column="1" Text="0.00" Style="{StaticResource SummaryValue}" MinWidth="120"/>

                <TextBlock x:Name="Label6" Grid.Column="3" Text="إجمالي المبيعات:" Style="{StaticResource SummaryLabel}" Margin="0,0,8,0"/>
                <TextBlock x:Name="txtSumSale" Grid.Column="4" Text="0.00" Style="{StaticResource SummaryValue}" MinWidth="120"/>
            </Grid>
        </Border>

        <!-- Footer: Buttons + ProgressBar -->
        <Border Grid.Row="3" Background="{StaticResource FooterBrush}" Padding="10,8" FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar x:Name="ProgressBar1" Grid.Row="0" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Foreground="#2CC36B" Background="#1D3268" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button x:Name="btnClose" Content="✖ خروج" Style="{StaticResource DangerBtn}" Width="100" Click="Button4_Click"/>
                    <Button x:Name="btnExport" Content="📊 تصدير Excel" Style="{StaticResource ExportBtn}" Width="130" Click="btnExport_Click"/>
                    <Button x:Name="btnPrint" Content="🖨️ طباعة" Style="{StaticResource ActionBtn}" Width="100" Click="btnPrint_Click"/>
                    <Button x:Name="btnPreview" Content="👁️ معاينة" Style="{StaticResource ActionBtn}" Width="100" Click="btnPreview_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>