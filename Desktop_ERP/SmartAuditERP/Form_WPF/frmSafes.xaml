<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSafes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تعريف المخازن"
    Width="800" Height="530"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Styles ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxMulti" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="NavBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════ -->
    <!--                 Main Layout                 -->
    <!-- ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Row="0" Margin="8,6,8,4">
            <Grid.RowDefinitions>
                <!-- GroupBox2: بيانات المخزن -->
                <RowDefinition Height="Auto"/>
                <!-- GroupBox4: قائمة المخازن -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ GroupBox2: بيانات المخزن ═══ -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,0,0,6"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="7"
                            Padding="10,5"
                            Margin="0,0,0,10">
                        <TextBlock Text="🏪 بيانات المخزن"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Fields -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- مسئولي المخزن -->
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="12"/>
                            <!-- بيانات التعريف -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ─── GroupBox3: مسئولي المخزن ─── -->
                        <Border Grid.Column="0"
                                Background="#F5F8FF"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{StaticResource HeaderBrush}"
                                        CornerRadius="5"
                                        Padding="6,3"
                                        Margin="0,0,0,6">
                                    <TextBlock Text="👤 مسئولي المخزن"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <DataGrid x:Name="dgvSafeEmps"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                          RowStyle="{StaticResource DgvRow}"
                                          CanUserAddRows="True"
                                          CanUserDeleteRows="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          FlowDirection="RightToLeft"
                                          Background="White"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E8EBF5"
                                          MinHeight="120"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridComboBoxColumn
                                            x:Name="colEmpId"
                                            Header="👤 الموظف المسئول"
                                            Width="*"
                                            SelectedValueBinding="{Binding EmpId, UpdateSourceTrigger=PropertyChanged}"
                                            DisplayMemberPath="name"
                                            SelectedValuePath="id"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- ─── بيانات التعريف ─── -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- اسم المخزن -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="🏪 اسم المخزن" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtName"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- الفرع + حالة المخزن -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="🏢 الفرع" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbBranches"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="📋 حالة المخزن" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbStatus"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>

                            <!-- المخزن الافتراضي + الملاحظات -->
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <CheckBox x:Name="chkDefault"
                                          Content="⭐ المخزن الافتراضي"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Foreground="#213A7A"
                                          VerticalAlignment="Center"
                                          Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="📝 ملاحظات" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNotes"
                                         Style="{StaticResource ModernTextBoxMulti}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ GroupBox4: قائمة المخازن ═══ -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0"
                            Padding="10,5">
                        <TextBlock Text="📋 بيانات المخازن"
                                   Foreground="White"
                                   FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <DataGrid x:Name="dgvSafes"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              BorderThickness="0"
                              MouseLeftButtonUp="dgvSafes_MouseLeftButtonUp">
                        <DataGrid.Columns>

                            <!-- الرقم (مخفي) -->
                            <DataGridTextColumn Header="الرقم"
                                                Binding="{Binding SafeId}"
                                                Width="0"
                                                Visibility="Collapsed"/>

                            <!-- اسم المخزن -->
                            <DataGridTextColumn Header="🏪 اسم المخزن"
                                                Binding="{Binding SafeName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الفرع -->
                            <DataGridTextColumn Header="🏢 الفرع"
                                                Binding="{Binding BranchName}"
                                                Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="38"
                            ToolTip="إغلاق"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,3,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,3,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,3,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="74"
                            Margin="0,0,4,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="74"
                            Margin="0,0,4,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="74"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>