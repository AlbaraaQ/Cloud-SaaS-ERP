<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmUserLogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تسجيل الدخول"
    Width="920" Height="520"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="LoginPurpleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#47085B" Offset="0"/>
            <GradientStop Color="#2D0040" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3D0060" Offset="0"/>
            <GradientStop Color="#250040" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LoginBtnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2ECC71" Offset="0"/>
            <GradientStop Color="#1A8A4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CloseBtnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C0392B" Offset="0"/>
            <GradientStop Color="#7B241C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="QuickBtnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6B8E23" Offset="0"/>
            <GradientStop Color="#4A6218" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SettingsBtnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#555566" Offset="0"/>
            <GradientStop Color="#333344" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20" ShadowDepth="5"
                          Direction="270" Opacity="0.5"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.3"
                          Color="#000000"/>

        <DropShadowEffect x:Key="FieldShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.2"
                          Color="#000000"/>

        <!-- ═══ Field Label Style ═══ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E0D0F0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ═══ Login TextBox Style ═══ -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2A1040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Effect" Value="{StaticResource FieldShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="#6A3090"
                                BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CC88FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Login PasswordBox Style ═══ -->
        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2A1040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="Effect" Value="{StaticResource FieldShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="#6A3090"
                                BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CC88FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ComboBox Style ═══ -->
        <Style x:Key="LoginComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2A1040"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6A3090"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect" Value="{StaticResource FieldShadow}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#2A1040"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#5A2080"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3D1060"/>
                                <Setter Property="Foreground" Value="#CC88FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- الحاوية الرئيسية -->
                            <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- سهم القائمة -->
                                    <Border Grid.Column="0"
                                    CornerRadius="0,10,10,0">
                                        <TextBlock Text="▾"
                                           Foreground="#CC88FF"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- منطقة عرض العنصر المحدد -->
                                    <ContentPresenter 
                                Grid.Column="1"
                                x:Name="ContentSite"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="4,0,8,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- زر مخفي لفتح القائمة -->
                            <ToggleButton 
                        x:Name="ToggleButton"
                        Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, 
                                    Mode=TwoWay, 
                                    RelativeSource={RelativeSource TemplatedParent}}"
                        ClickMode="Press"
                        Background="Transparent"
                        BorderThickness="0"
                        Opacity="0"/>

                            <!-- القائمة المنسدلة -->
                            <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade"
                           Placement="Bottom">
                                <Border x:Name="DropDownBorder"
                                Background="#2A1040"
                                BorderBrush="#6A3090"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Effect="{StaticResource FieldShadow}">
                                    <ScrollViewer x:Name="DropDownScrollViewer"
                                          MaxHeight="200"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CC88FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CC88FF"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="10,10,0,0"/>
                                <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0,0,8,8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Action Button Style ═══ -->
        <Style x:Key="LoginBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══ الحاوية الخارجية الرئيسية ═══ -->
    <Border CornerRadius="16"
            Effect="{StaticResource WindowShadow}"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- اللوحة اليسرى - الخلفية والمعلومات -->
                <ColumnDefinition Width="*"/>
                <!-- اللوحة اليمنى - نموذج تسجيل الدخول -->
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════
                 اللوحة اليسرى (pnlMain) - الخلفية
            ════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    x:Name="pnlMain"
                    Background="{StaticResource LoginPurpleBrush}"
                    ClipToBounds="True">

                <!-- طبقة التأثيرات البصرية -->
                <Grid>
                    <!-- دوائر زخرفية -->
                    <Ellipse Width="300" Height="300"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-100,-100,0,0"
                             Fill="#20FFFFFF"/>
                    <Ellipse Width="200" Height="200"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-60,-60"
                             Fill="#15FFFFFF"/>
                    <Ellipse Width="150" Height="150"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="#10FFFFFF"/>

                    <!-- المحتوى -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="40,0">

                        <!-- الشعار / الأيقونة -->
                        <Border Width="90" Height="90"
                                CornerRadius="45"
                                Background="#30FFFFFF"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20">
                            <TextBlock Text="🏢" FontSize="44"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- عنوان البرنامج -->
                        <TextBlock x:Name="lblWelcomeAr"
                                   Text="مرحباً بكم"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <TextBlock x:Name="lblWelcome"
                                   Text="Welcome"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#C0A0E0"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="تطبيقات المدقق الذكي"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#E8D0FF"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="برنامج الفوترة الإلكترونية"
                                   FontSize="12"
                                   Foreground="#B090D0"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,30"/>

                        <!-- معلومات الإصدار -->
                        <Border Background="#20FFFFFF"
                                CornerRadius="10"
                                FlowDirection="RightToLeft"
                                Padding="16,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,4">
                                    <TextBlock Text="الإصدار: "
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#C0A0E0"/>
                                    <TextBlock x:Name="lblVersion"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="White"/>
                                    <TextBlock x:Name="lblVersionTxt"
                                               FontSize="11"
                                               Foreground="#C0A0E0"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="تاريخ الإصدار: "
                                               FontSize="11"
                                               Foreground="#C0A0E0"/>
                                    <TextBlock x:Name="lblPublishDate"
                                               FontSize="11"
                                               Foreground="White"/>
                                    <TextBlock x:Name="lblPublishDateTxt"
                                               FontSize="11"
                                               Foreground="#C0A0E0"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TextBox مخفي لاسم قاعدة البيانات -->
                        <TextBox x:Name="txtdatabaseName"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"/>

                        <!-- Label7 مخفي -->
                        <TextBlock x:Name="Label7"
                                   Text="قاعدة البيانات:"
                                   Visibility="Collapsed"/>

                        <!-- LinkLabel1 مخفي -->
                        <TextBlock x:Name="LinkLabel1"
                                   Text="إعدادات السيرفر و قاعدة البيانات"
                                   Visibility="Collapsed"
                                   Foreground="#C8A0B8"
                                   Cursor="Hand"
                                   FontSize="11"
                                   MouseLeftButtonUp="LinkLabel1_Click"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════
                 اللوحة اليمنى (Panel2) - نموذج الدخول
            ════════════════════════════════════════════ -->
            <Border Grid.Column="1"
                    x:Name="Panel2"
                    Background="{StaticResource PanelBrush}"
                    FlowDirection="RightToLeft"
                    ClipToBounds="True">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- شريط الأدوات العلوي -->
                        <RowDefinition Height="Auto"/>
                        <!-- اللغة -->
                        <RowDefinition Height="Auto"/>
                        <!-- قاعدة البيانات -->
                        <RowDefinition Height="Auto"/>
                        <!-- الفرع -->
                        <RowDefinition Height="Auto"/>
                        <!-- اسم المستخدم -->
                        <RowDefinition Height="Auto"/>
                        <!-- كلمة المرور -->
                        <RowDefinition Height="Auto"/>
                        <!-- تذكرني -->
                        <RowDefinition Height="Auto"/>
                        <!-- أزرار الدخول/الخروج -->
                        <RowDefinition Height="Auto"/>
                        <!-- دخول سريع -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ شريط الأدوات العلوي ═══ -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- زر إعدادات السيرفر -->
                        <Button x:Name="btnServerSetting"
                                Grid.Column="0"
                                Width="32" Height="32"
                                Style="{StaticResource LoginBtnStyle}"
                                Background="{StaticResource SettingsBtnBrush}"
                                ToolTip="إعدادات السيرفر"
                                Click="btnServerSetting_Click">
                            <TextBlock Text="⚙️" FontSize="16"/>
                        </Button>
                    </Grid>

                    <!-- ═══ اللغة ═══ -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8" >
                        <TextBlock x:Name="lblLang"
                                   Text="🌐 اللغة"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmblanguages"
                                  Style="{StaticResource LoginComboBoxStyle}"

                                  SelectionChanged="cmblanguages_SelectionChangeCommitted" FlowDirection="LeftToRight">
                            <ComboBoxItem Content="عربي" IsSelected="True"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- ═══ قاعدة البيانات ═══ -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <TextBlock x:Name="lblDatabase"
               Text="🗄️ الملف"
               Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbDatabases"
              Style="{StaticResource LoginComboBoxStyle}"
              SelectionChanged="cmbDatabases_SelectionChangeCommitted" FlowDirection="LeftToRight"/>
                    </StackPanel>

                    <!-- ═══ الفرع ═══ -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock x:Name="lblBranch"
               Text="🏢 الفرع"
               Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbBranches" FlowDirection="LeftToRight"
              Style="{StaticResource LoginComboBoxStyle}"/>
                    </StackPanel>

                    <!-- ═══ اسم المستخدم ═══ -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,8">
                        <TextBlock x:Name="lblUserName"
                                   Text="👤 اسم المستخدم"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtUser"
                                 Style="{StaticResource LoginTextBoxStyle}"
                                 KeyDown="txtUser_KeyDown"/>
                    </StackPanel>

                    <!-- ═══ كلمة المرور ═══ -->
                    <StackPanel Grid.Row="5" Margin="0,0,0,8">
                        <TextBlock x:Name="lblPassword"
                                   Text="🔑 كلمة المرور"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox x:Name="txtPwd"
                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                     KeyDown="txtPwd_KeyDown"/>
                    </StackPanel>

                    <!-- ═══ تذكرني ═══ -->
                    <CheckBox x:Name="chkRemember"
                              Grid.Row="6"
                              Content="🔖 تذكرني"
                              Foreground="#D0B0F0"
                              FontFamily="Cairo, Tahoma, Arial"
                              FontSize="11" FontWeight="Bold"
                              Background="Transparent"
                              Margin="0,0,0,10"
                              FlowDirection="RightToLeft"/>

                    <!-- ═══ أزرار الدخول والخروج ═══ -->
                    <Grid Grid.Row="7" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnLogin"
                                Grid.Column="0"
                                Height="38"
                                Content="✅ الدخول"
                                Background="{StaticResource LoginBtnBrush}"
                                Style="{StaticResource LoginBtnStyle}"
                                Click="btnLogin_Click"/>

                        <Button x:Name="btnClose"
                                Grid.Column="2"
                                Height="38"
                                Content="❌ الخروج"
                                Background="{StaticResource CloseBtnBrush}"
                                Style="{StaticResource LoginBtnStyle}"
                                Click="btnClose_Click"/>
                    </Grid>

                    <!-- ═══ دخول سريع ═══ -->
                    <Button x:Name="btnQuick"
                            Grid.Row="8"
                            Height="44"
                            Content="⚡ دخول سريع"
                            Background="{StaticResource QuickBtnBrush}"
                            Style="{StaticResource LoginBtnStyle}"
                            IsEnabled="False"
                            Click="btnQuick_Click"/>

                </Grid>
            </Border>

        </Grid>
    </Border>

</dx:ThemedWindow>