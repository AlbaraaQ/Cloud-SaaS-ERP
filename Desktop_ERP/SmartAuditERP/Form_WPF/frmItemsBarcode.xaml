<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmItemsBarcode"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="طباعة الباركود"
    Width="940"
    Height="480"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FlowDirection="RightToLeft"
    Background="White"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmItemsBarcode_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DarkBlueBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B5998" Offset="0"/>
            <GradientStop Color="#2B4275" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.13"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource DarkBlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10">
            <TextBlock Text="🔖 طباعة الباركود"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: الحقول الرئيسية -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- الصنف -->
                    <TextBlock x:Name="lblItems"
                               Grid.Row="0" Grid.Column="0"
                               Text="🏷️ الصنف"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbItems"
                              Grid.Row="0" Grid.Column="1"
                              Grid.ColumnSpan="5"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="name"
                              SelectedValuePath="id"
                              SelectionChanged="cmbItems_SelectedIndexChanged"/>

                    <!-- الوحدة -->
                    <TextBlock x:Name="lblUnit"
                               Grid.Row="2" Grid.Column="0"
                               Text="📦 الوحدة"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbItemUnits"
                              Grid.Row="2" Grid.Column="1"
                              Grid.ColumnSpan="5"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="name"
                              SelectedValuePath="barcode"
                              SelectionChanged="cmbItemUnits_SelectedIndexChanged"/>

                    <!-- الباركود -->
                    <TextBlock x:Name="lblBarcode"
                               Grid.Row="4" Grid.Column="0"
                               Text="🔖 الباركود"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtBarcode"
                             Grid.Row="4" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock x:Name="lblItemCode"
                               Grid.Row="4" Grid.Column="3"
                               Text="🔑 الرمز"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtItemCode"
                             Grid.Row="4" Grid.Column="4"
                             Style="{StaticResource ModernTextBox}"/>

                    <!-- السعر بالضريبة -->
                    <TextBlock x:Name="lblPrice"
                               Grid.Row="6" Grid.Column="0"
                               Text="💰 السعر بالضريبة"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Row="6" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkPrice"
                                  Grid.Column="0"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheckBox}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <TextBox x:Name="txtPrice"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"/>
                    </Grid>

                    <!-- السعر بدون ضريبة -->
                    <TextBlock x:Name="lblPrice2"
                               Grid.Row="6" Grid.Column="3"
                               Text="💵 السعر بدون ضريبة"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Row="6" Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckPrice2"
                                  Grid.Column="0"
                                  Style="{StaticResource ModernCheckBox}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                        <TextBox x:Name="txtPrice2"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"/>
                    </Grid>

                    <!-- الكمية -->
                    <TextBlock x:Name="lblQty"
                               Grid.Row="8" Grid.Column="0"
                               Text="🔢 الكمية"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtQuat"
                             Grid.Row="8" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             Text="1"
                             KeyDown="txtQuat_KeyDown"/>

                    <!-- الاسم الإنجليزي -->
                    <TextBlock x:Name="lblNameEn"
                               Grid.Row="8" Grid.Column="3"
                               Text="📝 الاسم (EN)"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtNameEn"
                             Grid.Row="8" Grid.Column="4"
                             Style="{StaticResource ModernTextBox}"
                             FlowDirection="LeftToRight"/>

                    <!-- Checkboxes -->
                    <StackPanel Grid.Row="10" Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                        <CheckBox x:Name="ckItemNam"
                                  Content="✅ إضافة اسم المادة"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheckBox}"
                                  Margin="0,0,16,0"/>
                        <CheckBox x:Name="ckboxFoundName"
                                  Content="🏢 إضافة اسم المؤسسة"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheckBox}"/>
                    </StackPanel>

                    <!-- تاريخ الانتاج والانتهاء -->
                    <Grid Grid.Row="12" Grid.Column="0"
                          Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkPrintExpir"
                                  Grid.Column="0"
                                  Content="📅 طباعة تاريخ الانتاج والانتهاء"
                                  Style="{StaticResource ModernCheckBox}"
                                  Margin="0,0,12,0"
                                  Click="ChkPrintExpir_Click"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    x:Name="pnlDates"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="LpDate"
                                       Text="تاريخ الانتاج"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,6,0"/>
                            <DatePicker x:Name="ProDate"
                                        Style="{StaticResource ModernDatePicker}"
                                        Width="130"
                                        Margin="0,0,12,0"/>

                            <TextBlock x:Name="LExDate"
                                       Text="تاريخ الانتهاء"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,6,0"/>
                            <DatePicker x:Name="ExpDate"
                                        Style="{StaticResource ModernDatePicker}"
                                        Width="130"/>
                        </StackPanel>
                    </Grid>

                    <!-- أزرار الطباعة الرئيسية -->
                    <StackPanel Grid.Row="14" Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Orientation="Horizontal">
                        <Button x:Name="btnView"
                                Content="👁️ معاينة"
                                Style="{StaticResource ActionBtn}"
                                Width="110"
                                Margin="0,0,8,0"
                                Click="btnView_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="110"
                                Margin="0,0,8,0"
                                Click="btnPrint_Click"/>
                        <Button x:Name="btnDesgin"
                                Content="🎨 تصميم الباركود"
                                Style="{StaticResource ActionBtn}"
                                Width="140"
                                Margin="0,0,8,0"
                                Click="btnDesgin_Click"/>
                        <Button x:Name="Button4"
                                Content="✖ خروج"
                                Style="{StaticResource DangerBtn}"
                                Width="100"
                                Click="Button4_Click"/>
                    </StackPanel>

                    <!-- أزرار الباركود الثاني -->
                    <StackPanel Grid.Row="16" Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Orientation="Horizontal">
                        <TextBlock Text="باركود 2:"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,10,0"/>
                        <Button x:Name="btnView2"
                                Content="👁️ معاينة 2"
                                Style="{StaticResource ActionBtn}"
                                Width="100"
                                Margin="0,0,8,0"
                                Click="btnView2_Click"/>
                        <Button x:Name="btnPrint2"
                                Content="🖨️ طباعة 2"
                                Style="{StaticResource ActionBtn}"
                                Width="100"
                                Margin="0,0,8,0"
                                Click="btnPrint2_Click"/>
                        <Button x:Name="btnDesgin2"
                                Content="🎨 تصميم 2"
                                Style="{StaticResource ActionBtn}"
                                Width="100"
                                Click="btnDesgin2_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: إعدادات الطابعة -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,0,14">
                        <TextBlock Text="⚙️ إعدادات الطباعة"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="lblPrinters"
                               Text="🖨️ الطابعة"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="cmbPrinters"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,14"
                              SelectionChanged="cmbPrinters_SelectedIndexChanged"/>

                    <Button x:Name="btnSaveSetting"
                            Content="💾 حفظ الإعدادات"
                            Style="{StaticResource SaveBtn}"
                            Height="44"
                            FontSize="14"
                            Margin="0,0,0,16"
                            Click="btnSaveSetting_Click"/>

                    <Separator Margin="0,0,0,10"/>

                    <TextBlock Text="⚙️ خيارات الطباعة"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,8"/>

                    <CheckBox x:Name="ckboxFoundNameSettings"
                              Content="🏢 إضافة اسم المؤسسة"
                              IsChecked="True"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,6"/>

                    <CheckBox x:Name="ckItemNamSettings"
                              Content="📝 إضافة اسم المادة"
                              IsChecked="True"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,6"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#F8FAFD"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <TextBlock Text="📌 تأكد من اختيار الطابعة وحفظ الإعدادات قبل الطباعة"
                       Foreground="#4B5B8A"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</dx:ThemedWindow>