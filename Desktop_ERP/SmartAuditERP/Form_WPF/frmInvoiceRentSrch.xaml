<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvoiceRentSrch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="بحث الفواتير"
    Width="1050" Height="600"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NeutralBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#607D8B" Offset="0"/>
            <GradientStop Color="#455A64" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight"  Color="#D0D7E8"/>
        <SolidColorBrush x:Key="PanelBg"      Color="#F7F9FC"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="6"  ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NeutralBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource NeutralBrush}"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="GridColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8F9FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Filter Panel -->
            <ColumnDefinition Width="210"/>
            <!-- DataGrid -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Filter Panel ═══ -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnClose"
                                Grid.Column="0"
                                Content="✖"
                                Style="{StaticResource DangerBtn}"
                                Width="34" Height="30"
                                ToolTip="إغلاق"
                                Margin="0,0,8,0"
                                Click="btnClose_Click"/>

                        <TextBlock Grid.Column="1"
                                   Text="🔍 خيارات البحث"
                                   Foreground="White"
                                   FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Filter Fields -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10,6">
                    <StackPanel>

                        <TextBlock Text="نوع العملية" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="cmbProcType"
                                  Style="{StaticResource FilterCombo}"
                                  SelectionChanged="cmbProcType_SelectionChanged"/>

                        <TextBlock Text="رقم الفاتورة" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="txtInvNo"
                                 Style="{StaticResource FilterTextBox}"
                                 TextChanged="txtInvNo_TextChanged"
                                 KeyDown="txtFilter_KeyDown"/>

                        <TextBlock Text="التاريخ من" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="txtFromDate"
                                    Height="30"
                                    Margin="0,0,0,4"
                                    SelectedDateChanged="txtFromDate_SelectedDateChanged"/>

                        <TextBlock Text="إلى" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="txtToDate"
                                    Height="30"
                                    Margin="0,0,0,4"
                                    SelectedDateChanged="txtToDate_SelectedDateChanged"/>

                        <TextBlock Text="المستخدم" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="cmbUsers"
                                  Style="{StaticResource FilterCombo}"
                                  SelectionChanged="cmbUsers_SelectionChanged"/>

                        <TextBlock Text="العميل" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="txtClientName"
                                 Style="{StaticResource FilterTextBox}"
                                 TextChanged="txtClientName_TextChanged"
                                 KeyDown="txtFilter_KeyDown"/>

                        <TextBlock Text="جوال العميل" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="txtClientMobile"
                                 Style="{StaticResource FilterTextBox}"
                                 TextChanged="txtClientMobile_TextChanged"
                                 KeyDown="txtFilter_KeyDown"/>

                        <TextBlock Text="الصافي من" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="txtMinPrice"
                                 Style="{StaticResource FilterTextBox}"
                                 TextChanged="txtMinPrice_TextChanged"
                                 KeyDown="txtFilter_KeyDown"/>

                        <TextBlock Text="إلى" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="txtMaxPrice"
                                 Style="{StaticResource FilterTextBox}"
                                 TextChanged="txtMaxPrice_TextChanged"
                                 KeyDown="txtFilter_KeyDown"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Clear Button -->
                <Button x:Name="btnClear"
                        Grid.Row="2"
                        Content="🗑️ تصفية الحقول"
                        Style="{StaticResource NeutralBtn}"
                        Height="36"
                        Margin="10,6"
                        Click="btnClear_Click"/>
            </Grid>
        </Border>

        <!-- ═══ DataGrid ═══ -->
        <Border Grid.Column="1"
                Background="White"
                Margin="8,8,8,8"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="🧾 قائمة الفواتير"
                               Foreground="White"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <DataGrid x:Name="dgvItems"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource GridColHeader}"
                          RowStyle="{StaticResource GridRow}"
                          AlternationCount="2"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionChanged="dgvItems_SelectionChanged"
                          MouseDoubleClick="dgvItems_MouseDoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="الرقم"
                                            Binding="{Binding Id}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📅 التاريخ"
                                            Binding="{Binding InvDate, StringFormat=\{0:yyyy-MM-dd\}}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="👤 العميل"
                                            Binding="{Binding CustomerName}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="💰 الصافي"
                                            Binding="{Binding Net, StringFormat=N2}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="👤 المستخدم"
                                            Binding="{Binding EmpName}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📱 الجوال"
                                            Binding="{Binding Mobile}"
                                            Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Status -->
                <Border Grid.Row="2"
                        Background="#F0F4FF"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="0,1,0,0"
                        Padding="10,6">
                    <TextBlock x:Name="lblStatus"
                               Text=""
                               FontSize="11" FontWeight="Bold"
                               Foreground="#213A7A"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>