                                            <TextBox x:Name="save1" 
                                                    Grid.Column="0"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Text="0"
                                                    PreviewMouseDown="save1_Click"/>
                                            <Label Grid.Column="1" Content="x" 
                                                   Style="{StaticResource ModernLabel}"
                                                   Margin="3,0"/>
                                            <TextBox x:Name="save2" 
                                                    Grid.Column="2"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Text="0"
