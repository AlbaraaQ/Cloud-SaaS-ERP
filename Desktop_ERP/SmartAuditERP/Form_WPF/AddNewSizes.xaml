<Window x:Class="SmartAuditERP.Form_WPF.AddNewSizes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="إضافة مقاس جديد" 
        Height="900" 
        Width="1400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CloseButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#eb3349" Offset="0"/>
            <GradientStop Color="#f45c43" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3498db" Offset="0"/>
            <GradientStop Color="#2980b9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F9AA33"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="5,0"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#667eea"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#667eea"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F9AA33"/>
        </Style>

        <!-- Modern Label Style -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- GroupBox Style -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="#33FFFFFF" 
                                BorderBrush="#667eea"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource HeaderGradient}"
                                        CornerRadius="6"
                                        Padding="10,5"
                                        Margin="0,0,0,10">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                BorderThickness="2"
                                BorderBrush="DarkOrange">
                            <Border.Effect>
                                <DropShadowEffect Color="#667eea" 
                                                BlurRadius="10" 
                                                ShadowDepth="0" 
                                                Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0"
                                       Source="{TemplateBinding Tag}"
                                       Width="40"
                                       Height="40"
                                       Margin="0,5"/>
                                <TextBlock Grid.Row="1"
                                          Text="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pocket Button Style -->
        <Style x:Key="PocketButton" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#667eea"
                                BorderThickness="3"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" 
                                                BlurRadius="8" 
                                                ShadowDepth="2" 
                                                Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Image Source="{TemplateBinding Tag}"
                                       Stretch="Uniform"
                                       Margin="5"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          FontWeight="Bold"
                                          Foreground="Green"
                                          FontSize="12"
                                          Margin="0,0,0,5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close/Minimize Button Style -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#99FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Background="White" 
            CornerRadius="20"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" 
                            BlurRadius="30" 
                            ShadowDepth="0" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="20,20,0,0"
                    Height="80"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo and Title -->
                    <StackPanel Grid.Column="1" 
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Text="📏" 
                                   FontSize="32"
                                   Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="إضافة مقاس جديد"
                                       FontFamily="Segoe UI"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="الرقم: "
                                          FontSize="14"
                                          Foreground="#E0E0E0"/>
                                <TextBlock x:Name="lblCode"
                                          Text="0"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="Red"/>
                                <TextBlock Text=" | التاريخ: "
                                          FontSize="14"
                                          Foreground="#E0E0E0"
                                          Margin="20,0,0,0"/>
                                <TextBlock x:Name="lbDate"
                                          Text="12-12-2024"
                                          FontSize="14"
                                          Foreground="Red"
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button x:Name="Button12"
                                Style="{StaticResource WindowButton}"
                                Content="—"
                                Click="Button12_Click"
                                ToolTip="تصغير"/>
                        <Button x:Name="Button11"
                                Style="{StaticResource WindowButton}"
                                Content="✕"
                                Click="Button11_Click"
                                ToolTip="إغلاق"
                                Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Background="#233037">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- البيانات الأساسية -->
                    <GroupBox Grid.Row="0" 
                              Header="📋 البيانات الأساسية"
                              Style="{StaticResource ModernGroupBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Column 1 -->
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <Label Content="👤 اسم العميل" Style="{StaticResource ModernLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="txtName" 
                                             Grid.Column="0"
                                             Style="{StaticResource ModernComboBox}"
                                             IsEditable="True"
                                             SelectionChanged="txtName_SelectionChanged"/>
                                    <Button x:Name="Button1"
                                           Grid.Column="1"
                                           Content="+"
                                           Height="35"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Background="{StaticResource SaveButtonGradient}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Cursor="Hand"
                                           Margin="5,0,0,0"
                                           Click="Button1_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0">
                                <Label Content="📞 رقم الجوال" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtPhoneNum" 
                                        Style="{StaticResource ModernTextBox}"
                                        IsReadOnly="True"
                                        Text="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <Label Content="👔 نوع الثوب" Style="{StaticResource ModernLabel}"/>
                                <ComboBox x:Name="typeCB" 
                                         Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="سعودي"/>
                                    <ComboBoxItem Content="بحريني"/>
                                    <ComboBoxItem Content="اماراتي"/>
                                    <ComboBoxItem Content="كويتي"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Column 1 Row 2 -->
                            <StackPanel Grid.Column="0" Grid.Row="2">
                                <Label Content="🔢 العدد" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtQuantity" 
                                        Style="{StaticResource ModernTextBox}"
                                        Text="1"
                                        TextChanged="txtQuantity_TextChanged"
                                        PreviewMouseDown="txtQuantity_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="2" Margin="10,0">
                                <Label Content="💰 السعر" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtPrice" 
                                        Style="{StaticResource ModernTextBox}"
                                        Text="0"
                                        TextChanged="txtPrice_TextChanged"
                                        PreviewMouseDown="txtPrice_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="2">
                                <Label Content="💵 الإجمالي" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtPrice_sale" 
                                        Style="{StaticResource ModernTextBox}"
                                        Text="0"
                                        IsReadOnly="True"/>
                            </StackPanel>

                            <!-- Row 3 -->
                            <StackPanel Grid.Column="0" Grid.Row="4">
                                <Label Content="✅ الحالة" Style="{StaticResource ModernLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="stateCB" 
                                             Grid.Column="0"
                                             Style="{StaticResource ModernComboBox}">
                                        <ComboBoxItem Content="مستلم"/>
                                        <ComboBoxItem Content="في الخياطة"/>
                                        <ComboBoxItem Content="جاهز"/>
                                        <ComboBoxItem Content="تم التسليم"/>
                                    </ComboBox>
                                    <Button x:Name="stateSaveBtN"
                                           Grid.Column="1"
                                           Content="تعديل"
                                           Width="70"
                                           Height="35"
                                           Background="{StaticResource PrimaryButtonGradient}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Margin="5,0,0,0"
                                           Visibility="Collapsed"
                                           Click="stateSaveBtN_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="4" Margin="10,0">
                                <Label Content="💳 الصافي (مع الضريبة)" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtPriceWithTax" 
                                        Style="{StaticResource ModernTextBox}"
                                        Text="0"/>
                            </StackPanel>

                            <Grid Grid.Column="2" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <Label Content="💵 المدفوع" Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtPaid" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <Label Content="💰 الباقي" Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtRest" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            IsReadOnly="True"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <!-- المقاسات -->
                    <GroupBox x:Name="المقاسات"
                              Grid.Row="1" 
                              Header="📐 المقاسات"
                              Style="{StaticResource ModernGroupBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- الطول -->
                            <GroupBox Grid.Column="0" 
                                     x:Name="GroupBox8"
                                     Header="الطول"
                                     Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <Label Content="س" Style="{StaticResource ModernLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="txtheight1" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            PreviewMouseDown="txtheight1_Click"/>
                                    <Label Content="______" 
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Margin="0,5"/>
                                    <Label Content="ك" Style="{StaticResource ModernLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="txtheight2" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            PreviewMouseDown="txtheight2_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- الكتف -->
                            <GroupBox Grid.Column="1" 
                                     x:Name="GroupBox7"
                                     Header="الكتف"
                                     Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <TextBox x:Name="txtshoulder" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            Margin="0,10"
                                            PreviewMouseDown="txtshoulder_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- اليد -->
                            <GroupBox Grid.Column="2" 
                                     x:Name="GroupBox6"
                                     Header="اليد"
                                     Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="س" Style="{StaticResource ModernLabel}" HorizontalAlignment="Center"/>
                                            <TextBox x:Name="txthand1" 
                                                    Style="{StaticResource ModernTextBox}"
                                                    Text="0"
                                                    PreviewMouseDown="txthand1_Click"/>
                                        </StackPanel>
                                        <Label Grid.Column="1" 
                                               Content="/" 
                                               Style="{StaticResource ModernLabel}"
                                               FontSize="20"
                                               VerticalAlignment="Bottom"
                                               Margin="5,0"/>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="ص" Style="{StaticResource ModernLabel}" HorizontalAlignment="Center"/>
                                            <TextBox x:Name="txthand2" 
                                                    Style="{StaticResource ModernTextBox}"
                                                    Text="0"
                                                    PreviewMouseDown="txthand2_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- الرقبة -->
                            <GroupBox Grid.Column="3" 
                                     x:Name="GroupBox5"
                                     Header="الرقبه"
                                     Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="س" Style="{StaticResource ModernLabel}" HorizontalAlignment="Center"/>
                                            <TextBox x:Name="txtneck1" 
                                                    Style="{StaticResource ModernTextBox}"
                                                    Text="0"
                                                    PreviewMouseDown="txtneck1_Click"/>
                                        </StackPanel>
                                        <Label Grid.Column="1" 
                                               Content="/" 
                                               Style="{StaticResource ModernLabel}"
                                               FontSize="20"
                                               VerticalAlignment="Bottom"
                                               Margin="5,0"/>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="ص" Style="{StaticResource ModernLabel}" HorizontalAlignment="Center"/>
                                            <TextBox x:Name="txtneck2" 
                                                    Style="{StaticResource ModernTextBox}"
                                                    Text="0"
                                                    PreviewMouseDown="txtneck2_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- الوسع -->
                            <GroupBox Grid.Column="4" 
                                     x:Name="GroupBox4"
                                     Header="الوسع"
                                     Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <TextBox x:Name="txtexpand1" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            PreviewMouseDown="txtexpand1_Click"/>
                                    <Label Content="______" 
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Margin="0,5"/>
                                    <TextBox x:Name="txtexpand2" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            Margin="0,0,0,5"
                                            PreviewMouseDown="txtexpand2_Click"/>
                                    <Label Content="______" 
                                           Foreground="White" 
                                           FontWeight="Bold"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Margin="0,5"/>
                                    <TextBox x:Name="txtexpand3" 
                                            Style="{StaticResource ModernTextBox}"
                                            Text="0"
                                            PreviewMouseDown="txtexpand3_Click"/>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </GroupBox>

                    <!-- وسع الكم -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" 
                                 x:Name="GroupBox3"
                                 Header="وسع الكم"
                                 Style="{StaticResource ModernGroupBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtexpandHand1" 
                                        Grid.Column="0"
                                        Style="{StaticResource ModernTextBox}"
                                        Text="0"
                                        PreviewMouseDown="txtexpandHand1_Click"/>
                                <Label Grid.Column="1" 
                                       Content="/" 
                                       Style="{StaticResource ModernLabel}"
                                       FontSize="20"
                                       Margin="5,0"/>
                                <TextBox x:Name="txtexpandHand2" 
                                        Grid.Column="2"
                                        Style="{StaticResource ModernTextBox}"
                                        Text="0"
                                        PreviewMouseDown="txtexpandHand2_Click"/>
                            </Grid>
                        </GroupBox>

                        <!-- نوع الجيب -->
                        <GroupBox Grid.Column="1" 
                                 x:Name="GroupBox1"
                                 Header="🔍 نوع الجيب"
                                 Style="{StaticResource ModernGroupBox}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <UniformGrid Grid.Row="0" 
                                           Rows="2" 
                                           Columns="3"
                                           Margin="0,0,0,10">
                                    <Button x:Name="btnPocket1" 
                                           Style="{StaticResource PocketButton}"
                                           Click="btnPocket1_Click"/>
                                    <Button x:Name="btnPocket2" 
                                           Style="{StaticResource PocketButton}"
                                           Click="btnPocket2_Click"/>
                                    <Button x:Name="btnPocket3" 
