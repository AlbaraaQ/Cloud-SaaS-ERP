<Window x:Class="SmartAuditERP.Form_WPF.FormCreateTicket"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام الدعم الفني"
        Width="1200"
        Height="900"
        MinWidth="1000"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- Colors -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#667EEA" Offset="0"/>
            <GradientStop Color="#764BA2" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#667EEA"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#5A67D8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="NeutralBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="NeutralTextBrush" Color="#374151"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5EAF3"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#6B7280"/>

        <!-- Header close button -->
        <Style x:Key="WindowActionButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Labels -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E0EE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0,10,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#667EEA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E0EE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- GroupBox -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <Border Background="#F8FAFF"
                                        CornerRadius="16,16,0,0"
                                        Padding="16,12"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      TextElement.FontSize="15"
                                                      TextElement.FontWeight="Bold"
                                                      TextElement.Foreground="#22324D"/>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="#F3F5FA"
                                BorderBrush="#E6EAF2"
                                BorderThickness="1"
                                CornerRadius="12,12,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DDE3F1"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2F7"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFF"/>
            <Setter Property="Foreground" Value="#22324D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#E5EAF3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

    </Window.Resources>

    <Border Background="White"
            CornerRadius="22"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="0"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>

        <Grid Background="{StaticResource PageBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="84"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="22,22,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Close -->
                    <Button Grid.Column="0"
                            Content="✕"
                            Style="{StaticResource WindowActionButton}"
                            Click="Close_Click"/>

                    <!-- Title -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="نظام الدعم الفني"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="فتح تذكرة جديدة ومتابعة التذاكر السابقة"
                                   FontSize="12"
                                   Foreground="#EDE9FE"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Icon -->
                    <Border Grid.Column="2"
                            Width="44"
                            Height="44"
                            Background="#22FFFFFF"
                            CornerRadius="12"
                            VerticalAlignment="Center">
                        <TextBlock Text="🎫"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Body -->
            <TabControl Grid.Row="1"
                        Margin="20,18,20,12"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- Tab 1 -->
                <TabItem Header="فتح تذكرة">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- تفاصيل المشكلة -->
                            <GroupBox Grid.Column="0"
                                      Header="تفاصيل المشكلة"
                                      Style="{StaticResource ModernGroupBox}"
                                      Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- الموضوع -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="الموضوع" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBoxSubject"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- الأولوية + الفئة -->
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="الفئة" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox x:Name="ComboBoxCategory"
                                                      Style="{StaticResource ModernCombo}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="الأولوية" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox x:Name="ComboBoxPriority"
                                                      Style="{StaticResource ModernCombo}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- الوصف -->
                                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                        <TextBlock Text="وصف المشكلة" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBoxDescription"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Height="170"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 Padding="10"/>
                                    </StackPanel>

                                    <!-- Attachments -->
                                    <Border Grid.Row="3"
                                            Margin="0,16,0,0"
                                            Padding="14"
                                            Background="#F8FAFF"
                                            BorderBrush="#DCE4F2"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="إرفاق الصور أو الملفات"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#22324D"/>
                                                <TextBlock Text="يمكنك إرفاق صور توضيحية للمشكلة قبل إرسال التذكرة."
                                                           FontSize="12"
                                                           Foreground="{StaticResource SubTextBrush}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Button x:Name="btnScan"
                                                    Grid.Column="1"
                                                    Content="📎 اختيار المرفقات"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Width="160"
                                                    Click="btnScan_Click"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <!-- معلومات العميل -->
                            <GroupBox Grid.Column="1"
                                      Header="معلومات العميل"
                                      Style="{StaticResource ModernGroupBox}"
                                      Margin="10,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="الاسم" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBoxName"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <TextBlock Text="البريد الإلكتروني" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBoxEmail"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                        <TextBlock Text="رقم الهاتف" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TextBoxPhone"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2 -->
                <TabItem Header="البحث">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="التذاكر المسجلة"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#22324D"/>
                                <TextBlock Text="يمكنك استعراض التذاكر ومتابعة حالتها من الجدول التالي."
                                           FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="8">
                            <DataGrid x:Name="GridTickets"
                                      Margin="2"
                                      IsReadOnly="True"/>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#FCFDFF"
                    BorderBrush="#EEF2F7"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,22,22">
                <WrapPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16"
                           ItemHeight="46"
                           ItemWidth="165">

                    <Button x:Name="ButtonSubmit"
                            Content="📤 إرسال التذكرة"
                            Style="{StaticResource PrimaryButton}"
                            Click="ButtonSubmit_Click"/>

                    <Button x:Name="ButtonClear"
                            Content="🧹 مسح الحقول"
                            Style="{StaticResource NeutralButton}"
                            Click="ButtonClear_Click"/>

                    <Button x:Name="ButtonViewTicket"
                            Content="🔍 عرض تذكرة"
                            Style="{StaticResource SecondaryButton}"
                            Click="ButtonViewTicket_Click"/>

                    <Button x:Name="ButtonMyTickets"
                            Content="📋 تذاكري"
                            Style="{StaticResource AccentButton}"
                            Click="ButtonMyTickets_Click"/>

                </WrapPanel>
            </Border>

        </Grid>
    </Border>
</Window>