<dx:DXWindow
    x:Class="SmartAuditERP.Form_WPF.frmEtaSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="⚙ إعدادات الربط مع مصلحة الضرائب المصرية"
    FlowDirection="RightToLeft"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ShowIcon="False"
    Width="860"
    Height="560"
    FontFamily="Tahoma"
    FontSize="13"
    Background="#FAFDE8">

    <dx:DXWindow.Resources>

        <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#253951" Offset="0"/>
            <GradientStop Color="#3a5068" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10"
                          ShadowDepth="2"
                          Opacity="0.12"
                          Color="#000000"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="5"
                          ShadowDepth="2"
                          Opacity="0.2"
                          Color="#000000"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#253951"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="dxe:TextEdit">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="dxe:ComboBoxEdit">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="IsTextEditable" Value="False"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#253951"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#253951"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#253951"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </dx:DXWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="⚙"
                           FontSize="20"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="إعدادات الربط مع مصلحة الضرائب المصرية"
                           FontFamily="Tahoma"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="4">
            <StackPanel>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="🔧  الإعدادات العامة"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                <CheckBox x:Name="chkActivate"
                                          Content="تفعيل"
                                          Style="{StaticResource CheckBoxStyle}"
                                          Margin="0,0,0,8"/>
                                <CheckBox x:Name="chkReceipt"
                                          Content="Receipt"
                                          Style="{StaticResource CheckBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="تسلسل الجهاز"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <dxe:TextEdit x:Name="txtPosEtaSerial"
                                              Style="{StaticResource TextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Branch Code"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <dxe:TextEdit x:Name="txtBranchCode"
                                              Style="{StaticResource TextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="📄  إعدادات نوع الفاتورة"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="نوع الفاتورة الإلكترونية"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <dxe:ComboBoxEdit x:Name="cmbEinvoieType"
                                                  Style="{StaticResource ComboStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="نوع الختم الالكتروني"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <dxe:ComboBoxEdit x:Name="cmbSignType"
                                                  Style="{StaticResource ComboStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Document Type Version"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>
                                <dxe:ComboBoxEdit x:Name="cmbDocumentTypeVersion"
                                                  Style="{StaticResource ComboStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="🔑  بيانات الاعتماد (Credentials)"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Activity Code"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <dxe:TextEdit x:Name="txtActivityCode"
                                          Grid.Column="1"
                                          Style="{StaticResource TextBoxStyle}"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Pin Pass"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <dxe:TextEdit x:Name="txtPinPass"
                                          Grid.Column="1"
                                          Style="{StaticResource TextBoxStyle}"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Eta Code"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <dxe:TextEdit x:Name="txtEtaCode"
                                          Grid.Column="1"
                                          Style="{StaticResource TextBoxStyle}"/>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Eta Client Id"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <dxe:TextEdit x:Name="txtEtaClientId"
                                          Grid.Column="1"
                                          Style="{StaticResource TextBoxStyle}"/>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Eta Client Secret 1"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <dxe:TextEdit x:Name="txtEtaClientSecret1"
                                          Grid.Column="1"
                                          Style="{StaticResource TextBoxStyle}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Eta Client Secret 2"
                                       Style="{StaticResource FieldLabelStyle}"/>
                            <dxe:TextEdit x:Name="txtEtaClientSecret2"
                                          Grid.Column="1"
                                          Style="{StaticResource TextBoxStyle}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Margin="8,0,8,16" Background="Transparent">
                    <Button x:Name="BtnSave"
                            Content="💾  حفظ"
                            Style="{StaticResource SaveButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="BtnSave_Click"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</dx:DXWindow>