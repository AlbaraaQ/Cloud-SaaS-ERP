<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCustAccountGet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    Title="📋 كشف حساب عميل"
    Height="700" Width="1100"
    MinHeight="600" MinWidth="900"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    FlowDirection="RightToLeft"
    FontFamily="Tahoma"
    FontSize="13">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Gradient Brushes               -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1a237e" Offset="0"/>
            <GradientStop Color="#283593" Offset="0.5"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8F9FA" Offset="0"/>
            <GradientStop Color="#ECEFF1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonShowGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1976D2" Offset="0"/>
            <GradientStop Color="#0D47A1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonPrintGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#388E3C" Offset="0"/>
            <GradientStop Color="#1B5E20" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonExportGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F57C00" Offset="0"/>
            <GradientStop Color="#E65100" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonCloseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D32F2F" Offset="0"/>
            <GradientStop Color="#B71C1C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SummaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Drop Shadows                   -->
        <!-- ═══════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#AAAAAA"
                          Direction="270"
                          ShadowDepth="3"
                          BlurRadius="8"
                          Opacity="0.4"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          Color="#333333"
                          Direction="270"
                          ShadowDepth="2"
                          BlurRadius="5"
                          Opacity="0.35"/>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Button Styles                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="BaseActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonShowGradient}"/>
        </Style>

        <Style x:Key="PrintButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonPrintGradient}"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonExportGradient}"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonCloseGradient}"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--              GroupBox Style                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1a237e"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderGradient}"
                                    CornerRadius="10,10,0,0"
                                    Padding="12,6">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="White"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           Summary TextBox Style             -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="SummaryValueBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1a237e"/>
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryLabelBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           RadioButton Style                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           CheckBox Style                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--                  Main Layout                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="55"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--                  Header Bar                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0">
                    <TextBlock Text="📋"
                               FontSize="22"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="كشف حساب عميل / مورد"
                               Foreground="White"
                               FontFamily="Tahoma"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0">
                    <TextBlock x:Name="txtHeaderDate"
                               Foreground="#B3E5FC"
                               FontFamily="Tahoma"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Content Area                   -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Right Sidebar (Filters) -->
                <ColumnDefinition Width="240"/>
                <!-- Main Grid Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────── -->
            <!--         Right Sidebar               -->
            <!-- ─────────────────────────────────── -->
            <Border Grid.Column="0"
        Background="{StaticResource SidebarGradient}"
        BorderBrush="#CFD8DC"
        BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">

                        <!-- ❯ GroupBox1 - العنوان الرئيسي للشريط الجانبي -->
                        <GroupBox x:Name="GroupBox1"
                      x:FieldModifier="public"
                      Style="{StaticResource ModernGroupBox}"
                      Margin="0,0,0,6">
                            <GroupBox.Header>
                                <TextBlock x:Name="GroupBox1Header"
                               x:FieldModifier="public"
                               Text="👥 بيانات حساب عميل"/>
                            </GroupBox.Header>

                            <StackPanel>

                                <!-- ❯ Account Type -->
                                <GroupBox Style="{StaticResource ModernGroupBox}"
                              Margin="0,8,0,6">
                                    <GroupBox.Header>
                                        <TextBlock Text="🏷️ نوع الحساب"/>
                                    </GroupBox.Header>
                                    <StackPanel Margin="5">
                                        <RadioButton x:Name="rdAll"
                                         Content="🔵 الكل"
                                         Style="{StaticResource ModernRadioButton}"/>
                                        <RadioButton x:Name="rdAllClients"
                                         Content="👤 عملاء"
                                         Style="{StaticResource ModernRadioButton}"/>
                                        <RadioButton x:Name="rdAllSuppliers"
                                         Content="🏭 موردين"
                                         Style="{StaticResource ModernRadioButton}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- ❯ Client Selection -->
                                <GroupBox Style="{StaticResource ModernGroupBox}"
                              Margin="0,0,0,6">
                                    <GroupBox.Header>
                                        <TextBlock Text="👥 اختيار العميل"/>
                                    </GroupBox.Header>
                                    <StackPanel Margin="5">
                                        <TextBlock x:Name="LblSupplierName"
                                       Text="اسم العميل / المورد"
                                       FontFamily="Tahoma"
                                       FontSize="11"
                                       Foreground="#546E7A"
                                       Margin="0,0,0,5"/>
                                        <CheckBox x:Name="chkAll"
                                      Content="الكل"
                                      IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,5"/>
                                        <dxe:ComboBoxEdit x:Name="cmbClients"
                                              Height="32"
                                              AutoComplete="True"
                                              IsTextEditable="True"
                                              NullText="🔍 ابحث عن عميل..."
                                              Margin="0,3"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- ❯ Branch Selection -->
                                <GroupBox Style="{StaticResource ModernGroupBox}"
                              Margin="0,0,0,6">
                                    <GroupBox.Header>
                                        <TextBlock Text="🏢 الفرع"/>
                                    </GroupBox.Header>
                                    <StackPanel Margin="5">
                                        <CheckBox x:Name="chkAllBranches"
                                      Content="كل الفروع"
                                      IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,5"/>
                                        <dxe:ComboBoxEdit x:Name="cmbBranches"
                                              Height="32"
                                              AutoComplete="True"
                                              IsTextEditable="False"
                                              NullText="اختر الفرع..."
                                              Margin="0,3"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- ❯ Date Period -->
                                <GroupBox Style="{StaticResource ModernGroupBox}"
                              Margin="0,0,0,6">
                                    <GroupBox.Header>
                                        <TextBlock Text="📅 الفترة الزمنية"/>
                                    </GroupBox.Header>
                                    <StackPanel Margin="5">
                                        <CheckBox x:Name="ckTotalPeriod"
                                      Content="فترة كاملة"
                                      IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,8"/>

                                        <TextBlock Text="📆 من تاريخ"
                                       FontFamily="Tahoma"
                                       FontSize="11"
                                       Foreground="#546E7A"
                                       Margin="0,0,0,3"/>
                                        <dxe:DateEdit x:Name="txtDateFrom"
                                          Height="32"
                                          Margin="0,0,0,8"
                                          IsEnabled="False"/>

                                        <TextBlock Text="📆 إلى تاريخ"
                                       FontFamily="Tahoma"
                                       FontSize="11"
                                       Foreground="#546E7A"
                                       Margin="0,0,0,3"/>
                                        <dxe:DateEdit x:Name="txtDateTo"
                                          Height="32"
                                          Margin="0,0,0,5"
                                          IsEnabled="False"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- ❯ Show Button -->
                                <Button x:Name="btnShow"
                            Content="🔍 عرض كشف الحساب"
                            Style="{StaticResource ShowButtonStyle}"
                            Height="45"
                            Margin="5,8,5,5"
                            FontSize="14"/>

                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─────────────────────────────────── -->
            <!--         Main Grid Area              -->
            <!-- ─────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Progress -->
                    <RowDefinition Height="Auto"/>
                    <!-- Grid Header Label -->
                    <RowDefinition Height="Auto"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="*"/>
                    <!-- Summary Panel -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Progress Bar -->
                <dxe:ProgressBarEdit x:Name="ProgressBar1"
                                     Grid.Row="0"
                                     Height="8"
                                     Margin="10,8,10,0"
                                     Minimum="0" Maximum="100"/>

                <!-- Grid Title -->
                <Border Grid.Row="1"
                        Background="#E8EAF6"
                        Margin="10,8,10,0"
                        CornerRadius="8,8,0,0"
                        Padding="15,8">
                    <TextBlock Text="📊 كشف الحساب التفصيلي"
                               FontFamily="Tahoma"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#1a237e"/>
                </Border>

                <!-- DevExpress Grid -->
                <!-- DevExpress Grid -->
                <dxg:GridControl x:Name="GridControl1"
                 Grid.Row="2"
                 Margin="10,0,10,0"
                 AutoExpandAllGroups="True">
                    <dxg:GridControl.Columns>

                        <dxg:GridColumn x:Name="DgvNo"
                        Header="م"
                        FieldName="DgvNo"
                        Width="60"
                        AllowEditing="False"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="DgvDept"
                        Header="مدين"
                        FieldName="DgvDept"
                        Width="95"
                        AllowEditing="False"
                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="DgvCredit"
                        Header="دائن"
                        FieldName="DgvCredit"
                        Width="95"
                        AllowEditing="False"
                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="DgvClient"
                        Header="العميل / المورد"
                        FieldName="DgvClient"
                        Width="130"
                        AllowEditing="False"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="DgvEntryNo"
                        Header="رقم القيد"
                        FieldName="DgvEntryNo"
                        Width="90"
                        AllowEditing="False"
                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="DgvDate"
                        Header="تاريخ القيد"
                        FieldName="DgvDate"
                        Width="100"
                        AllowEditing="False"
                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="DgvNote"
                        Header="البيان"
                        FieldName="DgvNote"
                        Width="220"
                        AllowEditing="False"
                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="BtnDetail"
                        Header="تفاصيل"
                        FieldName="BtnDetail"
                        Width="70"
                        AllowEditing="True"
                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔎"
                            FontSize="16"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnDetail_CellClick"
                            ToolTip="عرض تفاصيل القيد"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                    </dxg:GridControl.Columns>

                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="GridView1"
                       AllowGrouping="False"
                       ShowGroupPanel="False"
                       AutoWidth="False"
                       NavigationStyle="Row"
                       AllowPerPixelScrolling="True"
                       ShowSearchPanelCloseButton="True"
                       SearchPanelNullText="🔍 ابحث هنا...">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition FieldName="DgvNo"
                                     Expression="GetRowIndex() % 2 == 1"
                                     ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#F5F7FF"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>

                </dxg:GridControl>
                <!-- ─────────────────────────────────── -->
                <!--         Summary Panel               -->
                <!-- ─────────────────────────────────── -->
                <Border Grid.Row="3"
                        Background="{StaticResource SummaryGradient}"
                        BorderBrush="#90CAF9"
                        BorderThickness="1"
                        CornerRadius="0,0,8,8"
                        Margin="10,0,10,8"
                        Padding="10,8"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Labels Row -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="💳 إجمالي المدين"
                                   FontFamily="Tahoma" FontSize="11"
                                   FontWeight="Bold" Foreground="#1565C0"
                                   HorizontalAlignment="Center"
                                   Margin="5,0,5,4"/>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="💵 إجمالي الدائن"
                                   FontFamily="Tahoma" FontSize="11"
                                   FontWeight="Bold" Foreground="#2E7D32"
                                   HorizontalAlignment="Center"
                                   Margin="5,0,5,4"/>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="⚖️ الرصيد المدين"
                                   FontFamily="Tahoma" FontSize="11"
                                   FontWeight="Bold" Foreground="#E65100"
                                   HorizontalAlignment="Center"
                                   Margin="5,0,5,4"/>

                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="⚖️ الرصيد الدائن"
                                   FontFamily="Tahoma" FontSize="11"
                                   FontWeight="Bold" Foreground="#6A1B9A"
                                   HorizontalAlignment="Center"
                                   Margin="5,0,5,4"/>

                        <!-- Values Row -->
                        <TextBox x:Name="txtTotDept"
                                 Grid.Row="1" Grid.Column="0"
                                 Style="{StaticResource SummaryValueBox}"
                                 Foreground="#1565C0"
                                 Margin="5,0"/>

                        <TextBox x:Name="txtTotCredit"
                                 Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource SummaryValueBox}"
                                 Foreground="#2E7D32"
                                 Margin="5,0"/>

                        <TextBox x:Name="txtBalance1"
                                 Grid.Row="1" Grid.Column="2"
                                 Style="{StaticResource SummaryValueBox}"
                                 Foreground="#E65100"
                                 Margin="5,0"/>

                        <TextBox x:Name="txtBalance2"
                                 Grid.Row="1" Grid.Column="3"
                                 Style="{StaticResource SummaryValueBox}"
                                 Foreground="#6A1B9A"
                                 Margin="5,0"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Footer Toolbar                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterGradient}"
                BorderBrush="#B0BEC5"
                BorderThickness="0,1,0,0"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Record Count -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="📌 عدد السجلات: "
                               FontFamily="Tahoma"
                               FontSize="12"
                               Foreground="#546E7A"/>
                    <TextBlock x:Name="txtRecordCount"
                               Text="0"
                               FontFamily="Tahoma"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#1a237e"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ShowButtonStyle}"
                            Margin="5,0"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintButtonStyle}"
                            Margin="5,0"/>

                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportButtonStyle}"
                            Margin="5,0"/>

                    <Button x:Name="btnClose"
                            Content="❌ خروج"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="5,0"/>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>