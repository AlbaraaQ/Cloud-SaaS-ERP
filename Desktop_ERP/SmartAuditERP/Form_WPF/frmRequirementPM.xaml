<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRequirementPM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="عـــــروض"
    Width="820" Height="440"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="11" FontWeight="Bold"
                    Background="#F3F5F9">

            <!-- ═══ تبويب 1: بيانات العرض ═══ -->
            <TabItem Header="   📋 بيانات العرض   ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- بطاقة البيانات الأساسية -->
                    <Border Grid.Row="0"
                            Background="White"
                            Margin="6,6,6,4"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}"
                            Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- رقم العرض -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="رقم العرض:"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNo"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <!-- التاريخ -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="📅 التاريخ:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtDate"
                                              Height="28"
                                              FontSize="11"
                                              FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- البلد -->
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="🌍 البلد:"
                                           Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbCountry"
                                              Grid.Column="0"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="name"
                                              SelectedValuePath="id"/>
                                    <Button x:Name="btnAddCountry"
                                            Grid.Column="2"
                                            Content="➕"
                                            Style="{StaticResource ActionBtn}"
                                            Width="26" Height="26"
                                            FontSize="12" Padding="0"
                                            ToolTip="إضافة دولة"
                                            Click="btnAddCountry_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- المدينة -->
                            <StackPanel Grid.Row="0" Grid.Column="6">
                                <TextBlock Text="🏙️ المدينة:"
                                           Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbCities"
                                              Grid.Column="0"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="name"
                                              SelectedValuePath="id"/>
                                    <Button x:Name="btnAddCity"
                                            Grid.Column="2"
                                            Content="➕"
                                            Style="{StaticResource ActionBtn}"
                                            Width="26" Height="26"
                                            FontSize="12" Padding="0"
                                            ToolTip="إضافة مدينة"
                                            Click="btnAddCity_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- العنوان -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="📍 العنوان:"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtLocation"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <!-- عدد السكان -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="👥 عدد السكان:"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPopulation"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <!-- زر إدراج في العقد -->
                            <Button x:Name="btnAddContract"
                                    Grid.Row="2" Grid.Column="8"
                                    Content="📄 إدراج في العقد"
                                    Style="{StaticResource ActionBtn}"
                                    Width="120"
                                    VerticalAlignment="Bottom"
                                    Click="btnAddContract_Click"/>
                        </Grid>
                    </Border>

                    <!-- جدول البنود -->
                    <Border Grid.Row="1"
                            Background="White"
                            Margin="6,0,6,4"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <!-- عنوان الجدول -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <TextBlock Text="🧾 بنود العرض"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="12,0"/>
                            </Border>

                            <!-- جدول البنود -->
                            <DataGrid x:Name="dgvterms"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD">
                                <DataGrid.Columns>

                                    <DataGridComboBoxColumn Header="البند"
                                                            SelectedValueBinding="{Binding TermCode, UpdateSourceTrigger=PropertyChanged}"
                                                            DisplayMemberPath="name"
                                                            SelectedValuePath="Code"
                                                            Width="*"/>

                                    <DataGridTextColumn Header="الكمية"
                                                        Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="السعر"
                                                        Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="المجموع"
                                                        Binding="{Binding Total}"
                                                        Width="100"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn Header="رقم المرجع"
                                                        Binding="{Binding RefNo, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridCheckBoxColumn Header="الحالة"
                                                            Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="70"/>

                                    <!-- زر الحذف -->
                                    <DataGridTemplateColumn Header="حذف" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️"
                                                        Tag="{Binding}"
                                                        FontSize="13"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="DeleteTermRow_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- شريط الإجمالي -->
                            <Border Grid.Row="2"
                                    Background="#F8F9FD"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰 الإجمالي:"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#1B2642"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBox x:Name="txtTotPrice"
                                             Width="130" Height="26"
                                             FontSize="13" FontWeight="Bold"
                                             Foreground="#27AE60"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Text="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ تبويب 2: البحث ═══ -->
            <TabItem Header="   🔍 البحث   ">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>

                    <!-- جدول نتائج البحث -->
                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}"
                            Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="12,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseDoubleClick="dgvSrch_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="id"
                                                        Binding="{Binding id}"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="رقم العرض"
                                                        Binding="{Binding requireNo}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="البلد"
                                                        Binding="{Binding country}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التاريخ"
                                                        Binding="{Binding vDate}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- لوحة البحث -->
                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}"
                            Padding="12,10">
                        <StackPanel>
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="6" Padding="8,5"
                                    Margin="0,0,0,10">
                                <TextBlock Text="🔍 البحث"
                                           Foreground="White"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="رقم العرض:"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSrchNo"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="📅 من تاريخ:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtFromDate"
                                              Height="28" FontSize="11"
                                              FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="📅 إلى تاريخ:"
                                           Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtToDate"
                                              Height="28" FontSize="11"
                                              FontWeight="SemiBold"/>
                            </StackPanel>

                            <Button x:Name="btnSearch"
                                    Content="🔍 بحث"
                                    Style="{StaticResource ActionBtn}"
                                    Click="btnSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="34" ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="74" Margin="0,0,5,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="74" Margin="0,0,5,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="74" Margin="0,0,5,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="74"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>