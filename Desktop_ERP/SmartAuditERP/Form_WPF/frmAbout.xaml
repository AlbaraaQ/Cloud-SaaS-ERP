<Window x:Class="SmartAuditERP.Form_WPF.frmAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="عن النظام" 
        Height="550" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- التدرجات اللونية -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2c3e50" Offset="0"/>
            <GradientStop Color="#3498db" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#ecf0f1" Offset="0"/>
            <GradientStop Color="#bdc3c7" Offset="1"/>
        </LinearGradientBrush>

        <!-- تنسيق نصوص العناوين -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- تنسيق نصوص القيم -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- تنسيق زر الإغلاق -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="17.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#99FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="20" Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.2" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180"/>
                <!-- Header with Logo -->
                <RowDefinition Height="Auto"/>
                <!-- Description -->
                <RowDefinition Height="*"/>
                <!-- Contact Info -->
                <RowDefinition Height="Auto"/>
                <!-- Version Footer -->
            </Grid.RowDefinitions>

            <!-- ==================== HEADER SECTION ==================== -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderGradient}" 
                    CornerRadius="20,20,0,0" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <!-- Logo Image -->
                    <Image x:Name="imgLogo" 
                           Stretch="Uniform" 
                           Margin="20"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                    <!-- Close Button -->
                    <Button x:Name="btnClose"
                            Style="{StaticResource CloseButton}"
                            Content="✕"
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" 
                            Margin="15,10"
                            Click="btnClose_Click"/>
                </Grid>
            </Border>

            <!-- ==================== DESCRIPTION SECTION ==================== -->
            <Border Grid.Row="1" 
                    Margin="20,15,20,5" 
                    Padding="15" 
                    Background="#F8F9FA" 
                    CornerRadius="10">
                <TextBlock x:Name="txtDescription" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           FontFamily="Segoe UI"
                           FontSize="14" 
                           LineHeight="22"
                           Foreground="#34495E"
                           Text="نظام المدقق للفوترة الإلكترونية و المحاسبة العامة و إدارة المستودعات و نقاط البيع"/>
            </Border>

            <!-- ==================== CONTACT INFO SECTION ==================== -->
            <StackPanel Grid.Row="2" Margin="30,10">

                <!-- Address -->
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <TextBlock Text="📍" FontSize="18" Width="30"/>
                    <TextBlock Text="العنوان:" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="txtAddress" 
                               Text="المملكة العربية السعودية - مدينة جدة" 
                               Style="{StaticResource ValueText}"/>
                </StackPanel>

                <!-- Mobile -->
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <TextBlock Text="📞" FontSize="18" Width="30"/>
                    <TextBlock Text="رقم التواصل:" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="txtMobile" 
                               Text="920009656" 
                               Style="{StaticResource ValueText}"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <TextBlock Text="📧" FontSize="18" Width="30"/>
                    <TextBlock Text="البريد الإلكتروني:" Style="{StaticResource InfoLabel}"/>
                    <TextBlock x:Name="txtEmail" 
                               Text="Info@dhit.com.sa" 
                               Style="{StaticResource ValueText}"/>
                </StackPanel>

                <!-- Website -->
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <TextBlock Text="🌐" FontSize="18" Width="30"/>
                    <TextBlock Text="الموقع الإلكتروني:" Style="{StaticResource InfoLabel}"/>
                    <TextBlock Cursor="Hand" MouseLeftButtonDown="Website_Click">
                        <Hyperlink x:Name="lnkWebsite" 
                                   TextDecorations="{x:Null}" 
                                   Foreground="#2980B9"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   FontWeight="Bold">
                            <Run x:Name="runWebsite" Text="www.dhit.com.sa"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- ==================== VERSION FOOTER ==================== -->
            <Border Grid.Row="3" 
                    Background="{StaticResource FooterGradient}" 
                    CornerRadius="0,0,20,20" 
                    Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📌" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="النسخة الحالية:" 
                               FontFamily="Segoe UI"
                               FontWeight="Bold" 
                               Foreground="#7F8C8D"/>
                    <TextBlock x:Name="txtVersion" 
                               Text="1.0.0.0" 
                               Margin="10,0" 
                               FontFamily="Segoe UI"
                               FontWeight="Bold" 
                               Foreground="#E74C3C"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>