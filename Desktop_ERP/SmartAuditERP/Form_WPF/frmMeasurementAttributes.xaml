<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmMeasurementAttributes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="إدارة خصائص القياسات"
    Width="640"
    Height="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmMeasurementAttributes_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F7CF7" Offset="0"/>
            <GradientStop Color="#305EDB" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.13"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavArrowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10">
            <TextBlock Text="📏 إدارة خصائص القياسات"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="1"
                Margin="8,8,8,4"
                Background="White"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="gridControl"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowStyle="{StaticResource GridRowStyle}"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      AlternatingRowBackground="#F8F9FD"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E7ECF5"
                      Background="White">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="الرقم"
                                        Binding="{Binding AttributeID}"
                                        Width="70"
                                        Visibility="Collapsed"/>

                    <DataGridTextColumn Header="📝 اسم الخاصية"
                                        Binding="{Binding AttributeName}"
                                        Width="*"
                                        ElementStyle="{StaticResource GridCellText}"/>

                    <DataGridTextColumn Header="🔢 الترتيب"
                                        Binding="{Binding DisplayOrder}"
                                        Width="90"
                                        ElementStyle="{StaticResource GridCellText}"/>

                    <DataGridTextColumn Header="⚙️ الحالة"
                                        Binding="{Binding StatusText}"
                                        Width="100"
                                        ElementStyle="{StaticResource GridCellText}"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="10,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button x:Name="btnAdd"
                        Content="➕ إضافة"
                        Style="{StaticResource SaveBtn}"
                        Width="90"
                        Click="btnAdd_Click"/>

                <Button x:Name="btnEdit"
                        Content="✏️ تعديل"
                        Style="{StaticResource ActionBtn}"
                        Width="90"
                        Click="btnEdit_Click"/>

                <Button x:Name="btnDelete"
                        Content="🔕 تعطيل"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Click="btnDelete_Click"/>

                <Button x:Name="btnMoveUp"
                        Content="▲"
                        Style="{StaticResource NavArrowBtn}"
                        ToolTip="تحريك للأعلى"
                        Click="btnMoveUp_Click"/>

                <Button x:Name="btnMoveDown"
                        Content="▼"
                        Style="{StaticResource NavArrowBtn}"
                        ToolTip="تحريك للأسفل"
                        Click="btnMoveDown_Click"/>

                <Button x:Name="btnClose"
                        Content="✖ إغلاق"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Margin="12,0,0,0"
                        Click="btnClose_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>