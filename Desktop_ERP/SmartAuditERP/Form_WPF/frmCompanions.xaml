<Window x:Class="SmartAuditERP.Form_WPF.frmCompanions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="المرافقين"
        Width="500"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FlowDirection="LeftToRight"
        Loaded="Frm_Calculator_Load"
        PreviewKeyDown="Frm_Calculator_KeyDown"
        MouseDown="Frm_Calculator_Click">

    <Window.Resources>

        <!-- ═══════════ BRUSHES ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5D4037" Offset="0"/>
            <GradientStop Color="#6D4C41" Offset="0.5"/>
            <GradientStop Color="#8D6E63" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBF7F5" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.30"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="6"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.20"
                          Color="#44000000"/>

        <!-- ═══════════ TEXTBOX STYLE ═══════════ -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MaxLength" Value="2"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BCAAA4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6D4C41"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ KEYPAD BUTTON STYLE ═══════════ -->
        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="BorderBrush" Value="#D7CCC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CFD8DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#F57C00"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ClosePadButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#8E0000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="18"
            Background="{StaticResource CardBrush}"
            BorderBrush="#D7CCC8"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}" Margin="0,0,0,-58">
        <Grid Margin="0,0,0,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="22" Margin="0,0,8,0"/>
                        <TextBlock Text="عدد المرافقين"
                                   Foreground="White"
                                   FontFamily="Tahoma"
                                   FontSize="16"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WinCloseStyle}"
                            Click="Button2_Click">
                        <TextBlock Text="✖"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="16,16,16,31">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Input -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtCompanionsNo"
                             Grid.Column="0"
                             Style="{StaticResource InputTextBoxStyle}"
                             PreviewKeyDown="TextBox1_KeyDown"
                             PreviewTextInput="TextBox1_KeyPress" Grid.ColumnSpan="3" Margin="76,0,229,0"/>

                    <TextBlock x:Name="Label1"
                               Grid.Column="2"
                               Text="عدد المرافقين"
                               FontFamily="Tahoma"
                               FontSize="16"
                               Foreground="#4E342E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Confirm -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="btnDone"
                            Style="{StaticResource ConfirmButtonStyle}"
                            Click="btnDone_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" Margin="0,0,6,0"/>
                            <TextBlock Text="تأكيد"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Keypad -->
                <UniformGrid Grid.Row="3"
                             Rows="2"
                             Columns="5"
                             Margin="0,10,0,12" Grid.RowSpan="2">
                    <Button x:Name="cmd135" Content="1" Style="{StaticResource NumberButtonStyle}" Click="cmd135_Click" Margin="4"/>
                    <Button x:Name="cmd2" Content="2" Style="{StaticResource NumberButtonStyle}" Click="cmd2_Click" Margin="4"/>
                    <Button x:Name="cmd3" Content="3" Style="{StaticResource NumberButtonStyle}" Click="cmd3_Click" Margin="4"/>
                    <Button x:Name="cmd4" Content="4" Style="{StaticResource NumberButtonStyle}" Click="cmd4_Click" Margin="4"/>
                    <Button x:Name="cmd5" Content="5" Style="{StaticResource NumberButtonStyle}" Click="cmd5_Click" Margin="4"/>

                    <Button x:Name="cmd6" Content="6" Style="{StaticResource NumberButtonStyle}" Click="cmd6_Click" Margin="4"/>
                    <Button x:Name="cmd7" Content="7" Style="{StaticResource NumberButtonStyle}" Click="cmd7_Click" Margin="4"/>
                    <Button x:Name="cmd8" Content="8" Style="{StaticResource NumberButtonStyle}" Click="cmd8_Click" Margin="4"/>
                    <Button x:Name="cmd9" Content="9" Style="{StaticResource NumberButtonStyle}" Click="cmd9_Click" Margin="4"/>
                    <Button x:Name="cmd0" Content="0" Style="{StaticResource NumberButtonStyle}" Click="cmd0_Click" Margin="4"/>

                    <Button x:Name="cmdClearAll" Content="C" Style="{StaticResource ClearButtonStyle}" Click="cmdClearAll_Click" Margin="4"/>
                    <Button x:Name="Button2" Content="✖" Style="{StaticResource ClosePadButtonStyle}" Click="Button2_Click" Margin="4"/>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>