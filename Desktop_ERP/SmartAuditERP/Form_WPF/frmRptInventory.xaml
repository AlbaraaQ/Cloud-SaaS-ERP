<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptInventory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تفاصيل فواتير المشتريات"
    WindowState="Maximized"
    MinWidth="1022" MinHeight="726"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ExcelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27AE60" Offset="0"/>
            <GradientStop Color="#1E8449" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="ExcelBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExcelBrush}"/>
        </Style>
        <Style x:Key="ShowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E4E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════ -->
        <!--         لوحة خيارات البحث             -->
        <!-- ════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0"
                Padding="10,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="8,6"
                            Margin="0,0,0,12">
                        <TextBlock Text="🔍 خيارات البحث"
                                   Foreground="White"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- نوع الدفع -->
                    <Border Background="#F8F9FD" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="📄 نوع العملية:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbType"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectionChanged="cmbType_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- المستودع -->
                    <Border Background="#F8F9FD" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="ckAllStore"
                                      Content="كل المستودعات"
                                      IsChecked="True"
                                      FontSize="11" FontWeight="Bold"
                                      Margin="0,0,0,4"
                                      Checked="ckAllStore_Changed"
                                      Unchecked="ckAllStore_Changed"/>
                            <TextBlock Text="🏭 المستودع:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbStore"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- المستخدم -->
                    <Border Background="#F8F9FD" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="ckAllUsers"
                                      Content="كل المستخدمين"
                                      IsChecked="True"
                                      FontSize="11" FontWeight="Bold"
                                      Margin="0,0,0,4"
                                      Checked="ckAllUsers_Changed"
                                      Unchecked="ckAllUsers_Changed"/>
                            <TextBlock Text="👤 المستخدم:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbusers"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- المورد -->
                    <Border Background="#F8F9FD" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="ckAllClients"
                                      Content="كل الموردين"
                                      IsChecked="True"
                                      FontSize="11" FontWeight="Bold"
                                      Margin="0,0,0,4"
                                      Checked="ckAllClients_Changed"
                                      Unchecked="ckAllClients_Changed"/>
                            <TextBlock Text="🏢 المورد:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbClients"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- الفروع -->
                    <Border Background="#F8F9FD" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="chkAllBranches"
                                      Content="كل الفروع"
                                      IsChecked="True"
                                      FontSize="11" FontWeight="Bold"
                                      Margin="0,0,0,4"
                                      Checked="chkAllBranches_Changed"
                                      Unchecked="chkAllBranches_Changed"/>
                            <TextBlock Text="🏢 الفرع:" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbBranches"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- الفترة -->
                    <Border Background="#F8F9FD" CornerRadius="7" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <CheckBox x:Name="ckTotalPeriod"
                                      Content="كل الفترة"
                                      IsChecked="True"
                                      FontSize="11" FontWeight="Bold"
                                      Margin="0,0,0,8"
                                      Checked="ckTotalPeriod_Changed"
                                      Unchecked="ckTotalPeriod_Changed"/>

                            <TextBlock Text="📅 من:" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtFromDate"
                                          Height="28" FontSize="11"
                                          IsEnabled="False"
                                          Margin="0,0,0,4"/>

                            <TextBlock Text="⏰ وقت البداية:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtStartTime"
                                     Height="26" Text="00:00"
                                     IsEnabled="False" FontSize="11"
                                     BorderBrush="{StaticResource BorderLight}"
                                     BorderThickness="1"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,4"/>

                            <TextBlock Text="📅 إلى:" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtToDate"
                                          Height="28" FontSize="11"
                                          IsEnabled="False"
                                          Margin="0,0,0,4"/>

                            <TextBlock Text="⏰ وقت النهاية:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtEndTime"
                                     Height="26" Text="23:59"
                                     IsEnabled="False" FontSize="11"
                                     BorderBrush="{StaticResource BorderLight}"
                                     BorderThickness="1"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- زر العرض -->
                    <Button x:Name="btnView"
                            Content="🔍 عرض"
                            Style="{StaticResource ShowBtn}"
                            Height="40"
                            Click="btnView_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ════════════════════════════════════ -->
        <!--          الجدول الرئيسي              -->
        <!-- ════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- جدول الفواتير -->
            <Border Grid.Row="0"
                    Background="White"
                    Margin="6,6,6,4"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="📋 الفواتير"
                                   Foreground="White"
                                   FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <DataGrid x:Name="GridControl2"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="رقم الفاتورة"
                                                Binding="{Binding InvNo}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="التاريخ"
                                                Binding="{Binding InvDate, StringFormat=d}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="العميل/المورد"
                                                Binding="{Binding Customer}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="المستخدم"
                                                Binding="{Binding User}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الفرع"
                                                Binding="{Binding Branch}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="المجموع"
                                                Binding="{Binding SumPrice, StringFormat=N2}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الخصم"
                                                Binding="{Binding TotDiscount, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الإجمالي"
                                                Binding="{Binding Total, StringFormat=N2}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الضريبة"
                                                Binding="{Binding VAT, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الصافي"
                                                Binding="{Binding Net, StringFormat=N2}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="InvGlobalID"
                                                Binding="{Binding InvGlobalID}"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn Header="ProcType"
                                                Binding="{Binding ProcType}"
                                                Visibility="Collapsed"/>

                            <!-- زر تفاصيل -->
                            <DataGridTemplateColumn Header="تفاصيل" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="👁️"
                                                Tag="{Binding InvGlobalID}"
                                                FontSize="13"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="BtnDetails_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- زر عرض الفاتورة -->
                            <DataGridTemplateColumn Header="عرض" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📄"
                                                Tag="{Binding}"
                                                FontSize="13"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="BtnShowInv_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- شريط المجاميع -->
            <Border Grid.Row="1"
                    Background="White"
                    Margin="6,0,6,4"
                    CornerRadius="8"
                    Effect="{StaticResource CardShadow}"
                    Padding="10,5">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                        <TextBlock Text="المجموع:" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="lblSumPrice" Text="0.00" Style="{StaticResource SummaryValue}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                        <TextBlock Text="الخصم:" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="lblDiscount" Text="0.00" Style="{StaticResource SummaryValue}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                        <TextBlock Text="الإجمالي:" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="lblTotal" Text="0.00" Style="{StaticResource SummaryValue}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                        <TextBlock Text="الضريبة:" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="lblVAT" Text="0.00" Style="{StaticResource SummaryValue}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                        <TextBlock Text="الصافي:" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="lblNet" Text="0.00"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#27AE60"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="عدد الفواتير:" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="lblCount" Text="0" Style="{StaticResource SummaryValue}"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- شريط الأدوات -->
            <Border Grid.Row="2"
                    Background="{StaticResource FooterBrush}"
                    FlowDirection="LeftToRight"
                    Margin="6,0,6,6"
                    CornerRadius="8"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ProgressBar x:Name="ProgressBar1"
                                 Grid.Column="0"
                                 Height="6"
                                 Margin="0,0,10,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="White"
                                 Background="#3A63C3"
                                 VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnClose"
                                Content="✖ خروج"
                                Style="{StaticResource DangerBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnClose_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPrint_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource ActionBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPreview_Click"/>
                        <Button x:Name="btnExportExcel"
                                Content="📊 Excel"
                                Style="{StaticResource ExcelBtn}"
                                Width="90"
                                Click="btnExportExcel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</dx:ThemedWindow>