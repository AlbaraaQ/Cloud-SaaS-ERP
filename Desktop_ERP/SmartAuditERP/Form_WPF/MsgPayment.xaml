<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.MsgPayment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="خيارات الدفع"
    Width="660" Height="195"
    WindowStartupLocation="CenterScreen"
    Background="#390065"
    FontFamily="Cairo, Tahoma, Arial"
    WindowStyle="None"
    ResizeMode="NoResize"
    FlowDirection="RightToLeft"
    KeyDown="Window_KeyDown">

    <Grid Margin="10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="btnNon"
                    Content="✖"
                    Width="36" Height="26"
                    Background="#A0522D"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnNon_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Column="1"
                       x:Name="lblMsg"
                       Text="💳 خيارات الدفع"
                       Foreground="White"
                       FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <!-- Payment Buttons -->
        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <!-- دفع كلي -->
            <Button x:Name="btnPaid"
                    Content="✅ دفع كلي"
                    Height="44" Width="140"
                    Margin="4,0"
                    Foreground="White"
                    FontSize="12" FontWeight="Bold"
                    Cursor="Hand"
                    Click="btnPaid_Click">
                <Button.Background>
                    <SolidColorBrush Color="#228B22"/>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- دفع جزئي -->
            <Button x:Name="btnPaidPartially"
                    Content="💱 دفع جزئي"
                    Height="44" Width="140"
                    Margin="4,0"
                    Foreground="White"
                    FontSize="12" FontWeight="Bold"
                    Cursor="Hand"
                    Click="btnPaidPartially_Click">
                <Button.Background>
                    <SolidColorBrush Color="#008080"/>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- دفع عند الاستلام -->
            <Button x:Name="btnNotPaid"
                    Content="🚚 دفع عند الاستلام"
                    Height="44" Width="150"
                    Margin="4,0"
                    Foreground="White"
                    FontSize="12" FontWeight="Bold"
                    Cursor="Hand"
                    Click="btnNotPaid_Click">
                <Button.Background>
                    <SolidColorBrush Color="#A0522D"/>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- آجل -->
            <Button x:Name="btnPostPaid"
                    Content="📋 آجل"
                    Height="44" Width="110"
                    Margin="4,0"
                    Foreground="White"
                    FontSize="12" FontWeight="Bold"
                    Cursor="Hand"
                    Click="btnPostPaid_Click">
                <Button.Background>
                    <SolidColorBrush Color="#DAA520"/>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- تسديد (مخفي) -->
            <Button x:Name="btnRepaid"
                    Content="💰 تسديد"
                    Height="44" Width="110"
                    Margin="4,0"
                    Foreground="#1B2642"
                    FontSize="12" FontWeight="Bold"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="btnRepaid_Click">
                <Button.Background>
                    <SolidColorBrush Color="White"/>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="8,0"
                                BorderBrush="#D0D7E8" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </WrapPanel>
    </Grid>
</dx:ThemedWindow>