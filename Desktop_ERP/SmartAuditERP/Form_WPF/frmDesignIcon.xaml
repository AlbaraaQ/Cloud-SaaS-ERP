<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmDesignIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="إعدادات الأيقونات"
    Width="460" Height="300"
    MinWidth="420" MinHeight="260"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ShowIcon="False">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"/>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10">
            <TextBlock Text="🎨 إعدادات الأيقونات والتصميم"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Checkboxes Card -->
        <Border Grid.Row="1"
                Margin="10,8,10,6"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Sales -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📤 المبيعات"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#1B2642"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="CheckBox1"
                              Content="فاتورة بيع"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox2"
                              Content="عرض سعر"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox3"
                              Content="مرتجع مبيعات"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox4"
                              Content="نقطة بيع"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox5"
                              Content="تقرير فواتير المبيعات"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox11"
                              Content="تقرير مبيعات الأصناف تجميعي"
                              Style="{StaticResource ModernCheckBox}"/>
                </StackPanel>

                <!-- Column 2: Purchases -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="📥 المشتريات"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#1B2642"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="CheckBox6"
                              Content="فاتورة مشتريات"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox7"
                              Content="مرتجع مشتريات"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox8"
                              Content="تقرير فواتير المشتريات"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox9"
                              Content="تقرير مشتريات الأصناف تجميعي"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox10"
                              Content="تقرير مشتريات الأصناف تفصيلي"
                              Style="{StaticResource ModernCheckBox}"/>
                    <CheckBox x:Name="CheckBox12"
                              Content="تقرير مشتريات مورد"
                              Style="{StaticResource ModernCheckBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="Button1"
                        Content="✅ تطبيق">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="Button2"
                        Content="✖ إلغاء"
                        Margin="10,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</dx:ThemedWindow>