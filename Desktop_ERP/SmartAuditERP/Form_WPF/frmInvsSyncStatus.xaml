<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvsSyncStatus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    Title="مزامنة الفواتير"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarningBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#C47D0A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SyncBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00B4D8" Offset="0"/>
            <GradientStop Color="#0077B6" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,3"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="MinWidth"        Value="60"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Background"      Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Effect"          Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed"   Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"    TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn"  TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="WarningBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>
        <Style x:Key="SyncBtn"    TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SyncBrush}"/>
        </Style>

        <Style x:Key="InCellBtn"  TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgress" TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="Foreground"      Value="#3A63C3"/>
            <Setter Property="Background"      Value="#E0E6F5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ══════════════════ ROOT GRID ══════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--  COLUMN 0 : Grid + Footer                 -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Header ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    Padding="12,8">
                <TextBlock Text="🔄 مزامنة الفواتير"
                           Style="{StaticResource SectionTitle}"
                           FontSize="16"/>
            </Border>

            <!-- ─── GridControl ─── -->
            <Border Grid.Row="1"
                    Background="White"
                    Margin="6,6,6,0"
                    CornerRadius="10"
                    FlowDirection="RightToLeft"
                    Effect="{StaticResource CardShadow}">
                <dxg:GridControl x:Name="GridControl1"
                                 SelectionMode="MultipleRow">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="GridView1"
                                       ShowGroupPanel="False"
                                       ShowTotalSummary="True"
                                       NavigationStyle="Row"
                                       MultiSelectMode="Row"
                                       AllowPerPixelScrolling="True"
                                       AllowColumnMoving="True"
                                       AllowSorting="True"/>
                    </dxg:GridControl.View>

                    <dxg:GridControl.Columns>

                        <dxg:GridColumn FieldName="DgvNo"
                                        Header="م"
                                        Width="50"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvInvGlobalID"
                                        Header="ID"
                                        Width="80"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvInvBranch"
                                        Header="الفرع"
                                        Width="120"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvInvType"
                                        Header="نوع الفاتورة"
                                        Width="120"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvInvNo"
                                        Header="رقم الفاتورة"
                                        Width="90"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvRefNo"
                                        Header="رقم المرجع"
                                        Width="90"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvDate"
                                        Header="التاريخ"
                                        Width="140"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvPayType"
                                        Header="نوع الدفع"
                                        Width="90"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvClient"
                                        Header="العميل"
                                        Width="130"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvUser"
                                        Header="المستخدم"
                                        Width="110"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvStore"
                                        Header="المستودع"
                                        Width="120"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvNet"
                                        Header="الصافي"
                                        Width="100"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvCloudID"
                                        Header="CloudID"
                                        Width="80"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <!-- حالة المزامنة بتلوين ذكي -->
                        <dxg:GridColumn FieldName="DgvSyncStatus"
                                        Header="حالة المزامنة"
                                        Width="110"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="syncBorder"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="2">
                                        <TextBlock x:Name="syncText"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="11"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RowData.Row[DgvSyncStatus]}"
                                                     Value="True">
                                            <Setter TargetName="syncBorder"
                                                    Property="Background"
                                                    Value="Green"/>
                                            <Setter TargetName="syncText"
                                                    Property="Text"
                                                    Value="✅ متزامن"/>
                                            <Setter TargetName="syncText"
                                                    Property="Foreground"
                                                    Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RowData.Row[DgvSyncStatus]}"
                                                     Value="False">
                                            <Setter TargetName="syncBorder"
                                                    Property="Background"
                                                    Value="OrangeRed"/>
                                            <Setter TargetName="syncText"
                                                    Property="Text"
                                                    Value="❌ غير متزامن"/>
                                            <Setter TargetName="syncText"
                                                    Property="Foreground"
                                                    Value="White"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- محذوف -->
                        <dxg:GridColumn FieldName="DgvISDeleted"
                                        Header="محذوف"
                                        Width="80"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="delBorder"
                                            CornerRadius="4"
                                            Padding="4,2"
                                            Margin="2"
                                            Background="Transparent">
                                        <TextBlock x:Name="delText"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Text="—"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RowData.Row[DgvISDeleted]}"
                                                     Value="True">
                                            <Setter TargetName="delBorder"
                                                    Property="Background"
                                                    Value="SlateGray"/>
                                            <Setter TargetName="delText"
                                                    Property="Text"
                                                    Value="🗑️ محذوف"/>
                                            <Setter TargetName="delText"
                                                    Property="Foreground"
                                                    Value="White"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- زر تفاصيل -->
                        <dxg:GridColumn FieldName="BtnDetails"
                                        Header="تفاصيل"
                                        Width="95"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔍 تفاصيل"
                                            Style="{StaticResource InCellBtn}"
                                            Background="{StaticResource HeaderBrush}"
                                            Tag="{Binding Path=RowData.Row}"
                                            Click="BtnDetails_Click"/>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- زر تغيير الحالة -->
                        <dxg:GridColumn FieldName="BtnChangeStatus"
                                        Header="تغيير الحالة"
                                        Width="110"
                                        AllowEditing="False"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔄 تغيير"
                                            Style="{StaticResource InCellBtn}"
                                            Background="{StaticResource SyncBrush}"
                                            Tag="{Binding Path=RowData.Row}"
                                            Click="BtnChangeStatus_Click"/>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- مخفية -->
                        <dxg:GridColumn FieldName="DgvOperType"  Visible="False"/>
                        <dxg:GridColumn FieldName="DgvProcType"  Visible="False"/>

                    </dxg:GridControl.Columns>

                    <!-- ملخص الصافي -->
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem FieldName="DgvNet"
                                             SummaryType="Custom"
                                             ShowInColumn="DgvNet"
                                             DisplayFormat="{}{0:0.##}"/>
                    </dxg:GridControl.TotalSummary>

                </dxg:GridControl>
            </Border>

            <!-- ─── Progress Bar ─── -->
            <ProgressBar x:Name="ProgressBar1"
                         Grid.Row="2"
                         Style="{StaticResource ModernProgress}"
                         Value="0" Maximum="100"
                         Margin="6,4"/>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="3"
                    Background="{StaticResource FooterBrush}"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- خروج -->
                    <Button Grid.Column="0"
                            x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="80" Margin="0,0,6,0"
                            Click="btnClose_Click"/>

                    <!-- وسط: تصدير + طباعة + معاينة -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="btnExportExcel"
                                Content="📊 تصدير Excel"
                                Style="{StaticResource SaveBtn}"
                                Width="120" Margin="0,0,6,0"
                                Click="btnExportExcel_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPrint_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource WarningBtn}"
                                Width="90"
                                Click="btnPreview_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--  COLUMN 1 : Search Panel                  -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1,0,0,0"
                FlowDirection="RightToLeft"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,10">

                    <!-- عنوان -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="10,6"
                            Margin="0,0,0,12">
                        <TextBlock Text="🔍 خيارات البحث"
                                   Style="{StaticResource SectionTitle}"/>
                    </Border>

                    <!-- ─── فرع الفاتورة ─── -->
                    <TextBlock Text="🏬 فرع الفاتورة"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckBranches"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckBranches_CheckedChanged"
                                  Unchecked="ckBranches_CheckedChanged"/>
                        <ComboBox x:Name="cmbBranches"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── حالة المزامنة ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6" Padding="6,4"
                            Margin="0,0,0,8">
                        <TextBlock Text="🔄 حالة المزامنة"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="12"/>
                    </Border>
                    <StackPanel Margin="4,0,0,10">
                        <RadioButton x:Name="rbAllSync"
                                     Content="🔵 الكل"
                                     IsChecked="True"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="SyncStatus"/>
                        <RadioButton x:Name="rbSynced"
                                     Content="✅ متزامنة"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="SyncStatus"/>
                        <RadioButton x:Name="rbNotSynced"
                                     Content="❌ غير متزامنة"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="SyncStatus"/>
                    </StackPanel>

                    <!-- ─── نوع الفاتورة ─── -->
                    <TextBlock Text="📋 نوع الفاتورة"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllInvs"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllInvs_CheckedChanged"
                                  Unchecked="ckAllInvs_CheckedChanged"/>
                        <ComboBox x:Name="cmbInvType"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── المستودع ─── -->
                    <TextBlock Text="🏭 المستودع"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllStore"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllStore_CheckedChanged"
                                  Unchecked="ckAllStore_CheckedChanged"/>
                        <ComboBox x:Name="cmbStore"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── نوع الدفع ─── -->
                    <TextBlock Text="💳 نوع الدفع"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllType"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllType_CheckedChanged"
                                  Unchecked="ckAllType_CheckedChanged"/>
                        <ComboBox x:Name="cmbType"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── العميل ─── -->
                    <TextBlock Text="🏢 العميل"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllClients"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllClients_CheckedChanged"
                                  Unchecked="ckAllClients_CheckedChanged"/>
                        <ComboBox x:Name="cmbClients"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── الفترة الزمنية ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6" Padding="6,4"
                            Margin="0,4,0,8">
                        <TextBlock Text="📅 الفترة الزمنية"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="12"/>
                    </Border>

                    <CheckBox x:Name="ckTotalPeriod"
                              Content="📌 كل الفترة"
                              IsChecked="True"
                              Style="{StaticResource ModernCheck}"
                              Margin="0,0,0,8"
                              Checked="ckTotalPeriod_CheckedChanged"
                              Unchecked="ckTotalPeriod_CheckedChanged"/>

                    <TextBlock Text="من" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="txtFromDate"
                                Style="{StaticResource ModernDatePicker}"
                                IsEnabled="False"
                                Margin="0,0,0,8"/>

                    <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="txtToDate"
                                Style="{StaticResource ModernDatePicker}"
                                IsEnabled="False"
                                Margin="0,0,0,10"/>

                    <!-- ─── المحذوفات ─── -->
                    <CheckBox x:Name="ckDeleted"
                              Content="🗑️ عرض المحذوفات"
                              Style="{StaticResource ModernCheck}"
                              Margin="0,0,0,10"/>

                    <!-- ─── إرسال إلى ─── -->
                    <TextBlock Text="📤 إرسال إلى (فرع رئيسي)"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbMainBranch"
                              Style="{StaticResource ModernCombo}"
                              Margin="0,0,0,10"/>

                    <!-- ─── زر عرض ─── -->
                    <Button x:Name="btnShow"
                            Content="🔍 عرض النتائج"
                            Style="{StaticResource ActionBtn}"
                            Height="42" FontSize="14"
                            Margin="0,4,0,4"
                            Click="btnShow_Click"/>

                    <!-- ─── زر مزامنة ─── -->
                    <Button x:Name="btnSync"
                            Content="🔄 مزامنة الفواتير المحددة"
                            Style="{StaticResource SyncBtn}"
                            Height="42" FontSize="13"
                            Margin="0,4,0,4"
                            Click="btnSync_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</dx:ThemedWindow>