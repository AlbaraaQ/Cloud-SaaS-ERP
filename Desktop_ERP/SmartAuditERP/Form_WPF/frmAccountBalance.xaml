<Window x:Class="SmartAuditERP.Form_WPF.frmAccountBalance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="كشف حساب تفصيلي" 
        Height="750" Width="1250"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#F4F6F7">

    <Window.Resources>
        <!-- Gradients -->
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4e54c8" Offset="0"/>
            <GradientStop Color="#8f94fb" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styles -->
        <Style x:Key="FilterLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القائمة الجانبية -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="#E0E6ED" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,15">
                    <!-- Header -->
                    <Border Background="{StaticResource HeaderGradient}" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🔍" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="فلاتر البحث المتقدم" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Account Selection -->
                    <Label Content="اسم الحساب" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="cmbAccounts" Style="{StaticResource ModernComboBox}" IsEditable="True" 
                              SelectionChanged="cmbAccounts_SelectionChanged" MouseDoubleClick="cmbAccounts_MouseDoubleClick"/>

                    <Label Content="رقم الحساب" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="txtCode" Style="{StaticResource ModernTextBox}" KeyDown="txtCode_KeyDown" TextAlignment="Center"/>

                    <!-- Balance Type -->
                    <GroupBox Header="⚖️ نوع الرصيد" Margin="0,15,0,0" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="rdAll" Content="الكل" IsChecked="True" Margin="0,3"/>
                            <RadioButton x:Name="rdDebt" Content="مدين" Margin="0,3"/>
                            <RadioButton x:Name="rdCredit" Content="دائن" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Display Options -->
                    <GroupBox Header="📊 طريقة العرض" Margin="0,10,0,0" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="btnAggre" Content="تجميعي (ملخص)" IsChecked="True" Margin="0,3"/>
                            <RadioButton x:Name="btnDetails" Content="تفصيلي (كامل)" Margin="0,3"/>
                            <Separator Margin="0,8"/>
                            <CheckBox x:Name="chkPrevbalance" Content="عدم إظهار الرصيد السابق" Margin="0,3"/>
                            <CheckBox x:Name="ckTotalPeriod" Content="فترة كاملة (من البداية)" IsChecked="True" 
                                      Checked="ckTotalPeriod_Toggle" Unchecked="ckTotalPeriod_Toggle" Margin="0,3"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Branch Filter -->
                    <Label Content="الفرع" Style="{StaticResource FilterLabel}"/>
                    <CheckBox x:Name="chkAllBranches" Content="كل الفروع" IsChecked="True" Checked="chkAllBranches_Toggle" Unchecked="chkAllBranches_Toggle"/>
                    <ComboBox x:Name="cmbBranches" Style="{StaticResource ModernComboBox}" Margin="0,5" IsEnabled="False"/>

                    <!-- Entry Type Filter -->
                    <Label Content="نوع القيد" Style="{StaticResource FilterLabel}"/>
                    <CheckBox x:Name="chkEntryType" Content="كل الأنواع" IsChecked="True" Checked="chkEntryType_Toggle" Unchecked="chkEntryType_Toggle"/>
                    <ComboBox x:Name="cmbEntryType" Style="{StaticResource ModernComboBox}" Margin="0,5" IsEnabled="False" SelectionChanged="cmbEntryType_SelectionChanged"/>

                    <!-- Date Range -->
                    <Label Content="من تاريخ" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="txtDateFrom" Style="{StaticResource ModernDatePicker}"/>
                    <Label Content="من وقت" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="txtStartTime" Style="{StaticResource ModernTextBox}" Text="00:00" IsEnabled="False"/>

                    <Label Content="إلى تاريخ" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="txtDateTo" Style="{StaticResource ModernDatePicker}"/>
                    <Label Content="إلى وقت" Style="{StaticResource FilterLabel}"/>
                    <TextBox x:Name="txtEndTime" Style="{StaticResource ModernTextBox}" Text="23:59" IsEnabled="False"/>

                    <!-- Main Action Button -->
                    <Button x:Name="btnShow" Content="🚀 عرض البيانات" Background="#3498DB" 
                            Style="{StaticResource ActionButton}" Margin="0,25,0,0" Height="50" FontSize="15"
                            Click="btnShow_Click"/>

                    <!-- Year Previews -->
                    <Label Content="سنوات سابقة" Style="{StaticResource FilterLabel}" Margin="0,20,0,0"/>
                    <ComboBox x:Name="CmbYearPreviews" Style="{StaticResource ModernComboBox}" 
                              DropDownOpened="CmbYearPreviews_DropDown" SelectionChanged="CmbYearPreviews_SelectionChanged"/>

                    <!-- Zoom Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                        <Button x:Name="btnZoom" Content="🔍+" Width="40" Height="40" Margin="3" Background="#34495E" 
                                Foreground="White" Click="btnZoom_Click"/>
                        <Button x:Name="btnZoomOut" Content="🔍-" Width="40" Height="40" Margin="3" Background="#34495E" 
                                Foreground="White" Click="btnZoomOut_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <!-- DataGrid -->
            <Border Grid.Row="0" Margin="15" Background="White" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.08" ShadowDepth="0"/>
                </Border.Effect>
                <DataGrid x:Name="dgvMain" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          AlternatingRowBackground="#F9FBFD" 
                          RowHeight="40"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2C3E50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="م" Binding="{Binding DgvRank}" Width="50"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding DgvDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="100"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding DgvEntryType}" Width="110"/>
                        <DataGridTextColumn Header="رقم السند" Binding="{Binding DgvEntryNo}" Width="90"/>
                        <DataGridTextColumn Header="الرقم العام" Binding="{Binding DgvGenralNo}" Width="90"/>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding DgvBranch}" Width="100"/>
                        <DataGridTextColumn Header="البيان" Binding="{Binding DgvNote}" Width="*"/>
                        <DataGridTextColumn Header="مدين" Binding="{Binding DgvDept, StringFormat=N2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="دائن" Binding="{Binding DgvCredit, StringFormat=N2}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding DgvBalance, StringFormat=N2}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding DgvBalanceStatus}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="تفاصيل" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁️" Background="Transparent" BorderThickness="0" 
                                            Cursor="Hand" FontSize="16" Click="BtnShowDetail_Click" Tag="{Binding DgvGenralNo}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Totals Summary -->
            <Border Grid.Row="1" Margin="15,0" Background="#2C3E50" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="إجمالي مدين" Foreground="#BDC3C7" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotDept" Text="0.00" Foreground="#55E6C1" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="إجمالي دائن" Foreground="#BDC3C7" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotCredit" Text="0.00" Foreground="#FEA47F" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="رصيد الفترة (مدين)" Foreground="#BDC3C7" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtBalance1" Text="0.00" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="رصيد الفترة (دائن)" Foreground="#BDC3C7" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtBalance2" Text="0.00" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Buttons Footer -->
            <Border Grid.Row="2" Padding="15">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="btnPreview" Content="👁️ معاينة التقرير" Width="140" Background="#9B59B6" 
                                Style="{StaticResource ActionButton}" Click="btnPreview_Click"/>
                        <Button x:Name="btnPrint" Content="🖨️ طباعة" Width="110" Background="#2F3640" 
                                Style="{StaticResource ActionButton}" Click="btnPrint_Click"/>
                        <Button x:Name="btnExportExcel" Content="📊 تصدير Excel" Width="130" Background="#27AE60" 
                                Style="{StaticResource ActionButton}" Click="btnExportExcel_Click"/>
                    </StackPanel>
                    <Button x:Name="btnClose" Content="🚪 خروج" HorizontalAlignment="Right" Width="110" 
                            Background="#C0392B" Style="{StaticResource ActionButton}" Click="btnClose_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>