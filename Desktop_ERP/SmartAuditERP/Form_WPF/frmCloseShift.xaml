<Window x:Class="SmartAuditERP.Form_WPF.frmCloseShift"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📊 إغلاقات اليومية"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="1100"
        MinHeight="700"
        Background="#F0F2F5"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ═══════════ GRADIENTS ═══════════ -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#283593" Offset="0.5"/>
            <GradientStop Color="#3949AB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolbarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F7FF" Offset="0"/>
            <GradientStop Color="#ECEEFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════ SHADOWS ═══════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="FieldShadow"
                          BlurRadius="5" ShadowDepth="1"
                          Direction="270" Opacity="0.08"
                          Color="#44000000"/>

        <!-- ═══════════ LABEL ═══════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A237E"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ═══════════ TEXTBOX ═══════════ -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3949AB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ COMBOBOX ═══════════ -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- ═══════════ DATEPICKER ═══════════ -->
        <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <!-- ═══════════ CHECKBOX ═══════════ -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#283593"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ═══════════ SIDEBAR BUTTONS ═══════════ -->
        <Style x:Key="SideButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{StaticResource FieldShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ TOOLBAR BUTTON ═══════════ -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SideButtonStyle}">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="DangerToolbarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#C62828"/>
        </Style>

        <Style x:Key="SuccessToolbarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#2E7D32"/>
        </Style>

        <Style x:Key="InfoToolbarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#00695C"/>
        </Style>

        <!-- ═══════════ DATAGRID ═══════════ -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EAF6"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#283593"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C5CAE9"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self},
                             Path=AlternationIndex}" Value="1">
                    <Setter Property="Background" Value="#F8F9FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!--                    HEADER                       -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource HeaderBrush}"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="22" Margin="8,0,0,0"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="إغلاقات اليومية"
                                   Foreground="White"
                                   FontFamily="Tahoma"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                        <TextBlock Text="عرض وإدارة إغلاقات وردية الموظفين"
                                   Foreground="#9FA8DA"
                                   FontFamily="Tahoma"
                                   FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!--                 MAIN CONTENT                    -->
        <!-- ═══════════════════════════════════════════════ -->

        <!-- DataGrid -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress Bar -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#C5CAE9"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <StackPanel>
                    <TextBlock x:Name="txtProgressLabel"
                               Text="جاهز"
                               FontFamily="Tahoma"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#283593"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,4"/>
                    <ProgressBar x:Name="ProgressBar1"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#E8EAF6"
                                 Foreground="#3949AB">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        BorderBrush="#C5CAE9"
                                        BorderThickness="1">
                                    <Border x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator"
                                                Background="{TemplateBinding Foreground}"
                                                CornerRadius="4"
                                                HorizontalAlignment="Right"/>
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- Grid -->
            <Border Grid.Row="1"
                    Margin="8"
                    CornerRadius="10"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Effect="{StaticResource CardShadow}">
                <DataGrid x:Name="GridControl1"
                          Style="{StaticResource ModernDataGridStyle}"
                          SelectionChanged="GridControl1_SelectionChanged">
                    <DataGrid.Columns>

                        <!-- الرقم -->
                        <DataGridTextColumn Header="🔢 الرقم"
                                            Binding="{Binding CloseNoDgv}"
                                            Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الموظف -->
                        <DataGridTextColumn Header="👤 الموظف"
                                            Binding="{Binding EmpNameDgv}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- إغلاق من -->
                        <DataGridTextColumn Header="📅 إغلاق من"
                                            Binding="{Binding CloseFrom, StringFormat=\{0:MM/dd/yyyy hh:mm tt\}}"
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- إغلاق إلى -->
                        <DataGridTextColumn Header="📅 إغلاق إلى"
                                            Binding="{Binding CloseTo, StringFormat=\{0:MM/dd/yyyy hh:mm tt\}}"
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- آجل -->
                        <DataGridTextColumn Header="📋 آجل"
                                            Binding="{Binding ForwardSaleDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الشبكة -->
                        <DataGridTextColumn Header="🌐 الشبكة"
                                            Binding="{Binding NetworkSumDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- النقدي -->
                        <DataGridTextColumn Header="💵 النقدي"
                                            Binding="{Binding CashSumDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- مجموع -->
                        <DataGridTextColumn Header="💰 مجموع الشبكة والنقدي"
                                            Binding="{Binding SumCashAndCredit}"
                                            Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- المصاريف -->
                        <DataGridTextColumn Header="📤 المصاريف"
                                            Binding="{Binding ExpensesDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- المشتريات -->
                        <DataGridTextColumn Header="🛒 المشتريات"
                                            Binding="{Binding PurchasesDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- توصيل -->
                        <DataGridTextColumn Header="🚗 توصيل"
                                            Binding="{Binding AdditionValDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- تأمين -->
                        <DataGridTextColumn Header="🛡️ تأمين"
                                            Binding="{Binding InsurValDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الخصم -->
                        <DataGridTextColumn Header="🏷️ الخصم"
                                            Binding="{Binding DiscountDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الضريبة -->
                        <DataGridTextColumn Header="🧾 الضريبة"
                                            Binding="{Binding AllVATDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الضيافة -->
                        <DataGridTextColumn Header="☕ الضيافة"
                                            Binding="{Binding HostingDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الصافي -->
                        <DataGridTextColumn Header="💹 الصافي"
                                            Binding="{Binding NetDgv}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- رصيد الصندوق -->
                        <DataGridTextColumn Header="🏦 رصيد الصندوق"
                                            Binding="{Binding TreasuryBlc}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- الفرق -->
                        <DataGridTextColumn Header="📉 الفرق"
                                            Binding="{Binding Differ}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- طباعة -->
                        <DataGridTemplateColumn Header="🖨️ طباعة" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🖨️"
                                            FontSize="16"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Click="BtnPrintRow_Click"
                                            HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- إرسال -->
                        <DataGridTemplateColumn Header="📧 إرسال" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="📧"
                                            FontSize="16"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Click="BtnSendRow_Click"
                                            HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- إعادة إغلاق -->
                        <DataGridTemplateColumn x:Name="colBtnReClose"
                                                Header="🔄 إعادة" Width="80"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔄"
                                            FontSize="16"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Click="BtnReClose_Click"
                                            HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!--                   SIDEBAR                       -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#C5CAE9"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="12,14">
                <StackPanel>

                    <!-- عنوان القسم -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,14">
                        <TextBlock Text="🔍" FontSize="15" Margin="6,0,0,0"/>
                        <TextBlock Text="بيانات البحث"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0"/>
                    </StackPanel>

                    <!-- تاريخ السجل (مخفي تفعيله عند الحاجة) -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="📅 التاريخ:"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="txtDate"
                                    Style="{StaticResource ModernDatePickerStyle}"
                                    IsEnabled="False"/>
                    </StackPanel>

                    <!-- كل الفترة -->
                    <CheckBox x:Name="chkAllperiod"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Content="📆 كل الفترة"
                              Margin="0,0,0,12"
                              Checked="chkAllperiod_CheckedChanged"
                              Unchecked="chkAllperiod_CheckedChanged"/>

                    <!-- Separator -->
                    <Separator Background="#E8EAF6" Margin="0,0,0,12"/>

                    <!-- من تاريخ -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="📅 التاريخ من:"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="txtDateFrom"
                                    Style="{StaticResource ModernDatePickerStyle}"/>
                    </StackPanel>

                    <!-- إلى تاريخ -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="📅 إلى:"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="txtDateTo"
                                    Style="{StaticResource ModernDatePickerStyle}"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator Background="#E8EAF6" Margin="0,0,0,12"/>

                    <!-- الموظف -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="👤 الموظف:"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbEmps"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  IsEnabled="False"
                                  IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <!-- الكل -->
                    <CheckBox x:Name="chkAll"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Content="📋 الكل"
                              IsChecked="True"
                              Margin="0,0,0,16"
                              Checked="chkAll_CheckedChanged"
                              Unchecked="chkAll_CheckedChanged"/>

                    <!-- زر العرض -->
                    <Button x:Name="btnShow"
                            Style="{StaticResource SideButtonStyle}"
                            Margin="0,0,0,10"
                            Click="btnShow_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="عرض"/>
                        </StackPanel>
                    </Button>

                    <!-- زر إعادة إغلاق دفعة -->
                    <Button x:Name="BtnRecloseBatch"
                            Style="{StaticResource SideButtonStyle}"
                            Background="#E65100"
                            Visibility="Collapsed"
                            Click="BtnRecloseBatch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="إعادة إغلاق"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!--                   TOOLBAR                       -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="#C5CAE9"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار يمين -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <Button x:Name="btnClose"
                            Style="{StaticResource DangerToolbarButtonStyle}"
                            Margin="0,0,8,0"
                            Click="btnClose_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="خروج"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- أزرار وسط -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left">

                    <Button x:Name="btnExportExcel"
                            Style="{StaticResource InfoToolbarButtonStyle}"
                            Margin="0,0,8,0"
                            Click="btnExportExcel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="تصدير Excel"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnPreview"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Background="#5C6BC0"
                            Margin="0,0,8,0"
                            Click="btnPreview_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁️" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="معاينة"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnPrint"
                            Style="{StaticResource SuccessToolbarButtonStyle}"
                            Click="btnPrint_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="طباعة"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>