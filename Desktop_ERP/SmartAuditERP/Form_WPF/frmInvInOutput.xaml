<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvInOutput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="فاتورة إدخال"
    WindowState="Maximized"
    MinWidth="1190" MinHeight="726"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B9BD5" Offset="0"/>
            <GradientStop Color="#2E75B6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B68EE" Offset="0"/>
            <GradientStop Color="#483D8B" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Label Style ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ TextBox Style ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F0F4FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SummaryTextBox" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Background" Value="#EEF3FF"/>
        </Style>

        <!-- ═══ ComboBox Style ═══ -->
        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Button Styles ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
        </Style>

        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ═══ DataGrid Styles ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#1D3268"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF3FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DgvSrchColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabControl1"
                    FlowDirection="RightToLeft"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12"
                    Background="#F3F5F9">

            <!-- ══════════════════════════════════════════════ -->
            <!--              TAB 1: الفاتورة                   -->
            <!-- ══════════════════════════════════════════════ -->
            <TabItem x:Name="TabPage1" Header="  📄 الفاتورة  ">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- GroupBox3: رأس الفاتورة -->
                        <RowDefinition Height="*"/>
                        <!-- GroupBox7: بنود الفاتورة -->
                        <RowDefinition Height="Auto"/>
                        <!-- GroupBox9: ملخص -->
                        <RowDefinition Height="Auto"/>
                        <!-- pnlNewBtns: أزرار -->
                    </Grid.RowDefinitions>

                    <!-- ═══ GroupBox3: رأس الفاتورة ═══ -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="6,6,6,3"
                            Padding="10,8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7"
                                    Padding="10,5">
                                <TextBlock Text="📋 بيانات الفاتورة"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Row1: رقم + تاريخ + مرجع + تاريخ مرجع -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔢 الرقم"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtNo" Grid.Column="1"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="📅 التاريخ"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <dxe:DateEdit x:Name="txtDate" Grid.Column="4"
                                              Height="30" FontSize="12"/>

                                <TextBlock Grid.Column="6" Text="📎 رقم المرجع"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtRefNo" Grid.Column="7"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock Grid.Column="9" Text="📅 تاريخ المرجع"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <dxe:DateEdit x:Name="txtRefDate" Grid.Column="10"
                                              Height="30" FontSize="12"/>

                                <TextBlock Grid.Column="12" Text="📝 البيان"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtNote" Grid.Column="13"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="30" FontSize="13" FontWeight="Bold"
                                         TextAlignment="Center"/>
                            </Grid>

                            <!-- Row2: مستودع + عميل/مورد + رصيد + اضافة -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- نوع الحركة مخفي -->
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🏪 المستودع"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbStore" Grid.Column="1"
                                          Style="{StaticResource ModernCombo}"/>

                                <TextBlock x:Name="lblClient" Grid.Column="3"
                                           Text="👤 اسم المورد"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbClient" Grid.Column="4"
                                          Style="{StaticResource ModernCombo}"
                                          IsEditable="True"
                                          KeyDown="cmbClient_KeyDown"/>

                                <Button x:Name="btnCustAdd" Grid.Column="6"
                                        Content="➕"
                                        Style="{StaticResource SmallBtn}"
                                        Background="{StaticResource SaveBrush}"
                                        Visibility="Collapsed"
                                        ToolTip="إضافة عميل"
                                        Click="btnCustAdd_Click"/>

                                <TextBlock Grid.Column="8" Text="💰 الرصيد"
                                           Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtBalance" Grid.Column="9"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         TextAlignment="Center"/>

                                <!-- نوع الحركة - مخفي -->
                                <ComboBox x:Name="cmbProcType" Grid.Column="11"
                                          Style="{StaticResource ModernCombo}"
                                          Visibility="Collapsed">
                                    <ComboBoxItem Content="فاتورة"/>
                                    <ComboBoxItem Content="مرتجع فاتورة"/>
                                </ComboBox>
                            </Grid>

                            <!-- Row3: زر إدراج مرتبط -->
                            <StackPanel Grid.Row="6" Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <Button x:Name="btnInsertLinkedInv"
                                        Content="📥 إدراج"
                                        Style="{StaticResource InfoBtn}"
                                        Width="110" Height="32"
                                        Click="btnInsertLinkedInv_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ GroupBox7: بنود الفاتورة ═══ -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="6,3,6,3"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Panel4: شريط الباركود -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- RadioButtons -->
                                    <RadioButton x:Name="rdNormal" Grid.Column="0"
                                                 Content="عادي"
                                                 IsChecked="True"
                                                 Foreground="White"
                                                 FontSize="12" FontWeight="Bold"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton x:Name="rdAuto" Grid.Column="1"
                                                 Content="تلقائي"
                                                 Foreground="White"
                                                 FontSize="12" FontWeight="Bold"
                                                 Margin="0,0,20,0"
                                                 VerticalAlignment="Center"/>

                                    <!-- Barcode Label -->
                                    <TextBlock Grid.Column="2"
                                               Text="🔖 الباركود"
                                               Foreground="White"
                                               FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <!-- Barcode TextBox -->
                                    <TextBox x:Name="txtBarcode" Grid.Column="3"
                                             Width="400" Height="28"
                                             FontSize="12" FontWeight="Bold"
                                             TextAlignment="Center"
                                             Background="White"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,8,0"
                                             KeyDown="txtBarcode_KeyDown"/>

                                    <!-- Spacer -->
                                    <StackPanel Grid.Column="5"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="🏷️ بنود الفاتورة"
                                                   Foreground="White"
                                                   FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Add New Item Button -->
                                    <Button x:Name="btnAddNewItem" Grid.Column="6"
                                            Content="➕"
                                            Style="{StaticResource SmallBtn}"
                                            Background="{StaticResource SaveBrush}"
                                            ToolTip="إضافة صنف جديد"
                                            Click="btnAddNewItem_Click"/>
                                </Grid>
                            </Border>

                            <!-- Panel5: DataGrid البنود -->
                            <DataGrid x:Name="dgvItems"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      BorderThickness="0"
                                      SelectionChanged="dgvItems_SelectionChanged"
                                      CellEditEnding="dgvItems_CellEditEnding"
                                      PreviewKeyDown="dgvItems_PreviewKeyDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu x:Name="ContextMenuStrip1"
                                                 FlowDirection="RightToLeft">
                                        <MenuItem x:Name="StripItemSearch"
                                                  Header="🔍 بحث مادة"
                                                  Click="StripItemSearch_Click"/>
                                        <MenuItem x:Name="StripItemDetail"
                                                  Header="📋 استعراض المادة"
                                                  Click="StripItemDetail_Click"/>
                                        <MenuItem x:Name="StripAddNewItem"
                                                  Header="➕ إضافة مادة"
                                                  Click="StripAddNewItem_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="StripItemUnits"
                                                  Header="📦 الوحدات"
                                                  Click="StripItemUnits_Click"/>
                                        <MenuItem x:Name="StripAddGroup"
                                                  Header="🗂️ إضافة مجموعة"
                                                  Click="StripAddGroup_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="StripdeleteRow"
                                                  Header="🗑️ حذف السجل"
                                                  Click="StripdeleteRow_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="StripItemProcess"
                                                  Header="🔄 حركة المادة"
                                                  Click="StripItemProcess_Click"/>
                                        <MenuItem x:Name="StripClientLastItem"
                                                  Header="📊 آخر حركة للمادة"
                                                  Click="StripClientLastItem_Click"/>
                                        <MenuItem x:Name="StripLastItem"
                                                  Header="📊 آخر حركة للعميل"
                                                  Click="StripLastItem_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="StripItemAvrgCost"
                                                  Header="💲 تكلفة المادة"
                                                  Click="StripItemAvrgCost_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <!-- Col 0: # -->
                                    <DataGridTextColumn x:Name="Nodgv"
                                                        Header="#"
                                                        Binding="{Binding RowNo}"
                                                        Width="35"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 1: رمز الصنف -->
                                    <DataGridTextColumn x:Name="InvNo"
                                                        Header="رمز الصنف"
                                                        Binding="{Binding ItemCode}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 2: رقم الصنف (مخفي) -->
                                    <DataGridTextColumn x:Name="ItemId"
                                                        Header="رقم الصنف"
                                                        Binding="{Binding ItemId}"
                                                        Width="60"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 3: اسم الصنف -->
                                    <DataGridTextColumn x:Name="ItemName"
                                                        Header="🏷️ الصنف"
                                                        Binding="{Binding ItemName}"
                                                        Width="*"
                                                        MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 4: الوصف (مخفي) -->
                                    <DataGridTextColumn x:Name="Column1"
                                                        Header="الوصف"
                                                        Binding="{Binding Description}"
                                                        Width="80"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 5: الباركود (مخفي) -->
                                    <DataGridTextColumn x:Name="barcodeDgv"
                                                        Header="الباركود"
                                                        Binding="{Binding Barcode}"
                                                        Width="80"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 6: الوحدة -->
                                    <DataGridTextColumn x:Name="cmbUnitDgv"
                                                        Header="الوحدة"
                                                        Binding="{Binding UnitName}"
                                                        Width="80"
                                                        MinWidth="60">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 7: الكمية -->
                                    <DataGridTextColumn x:Name="QuantDgv"
                                                        Header="الكمية"
                                                        Binding="{Binding Quantity}"
                                                        Width="65"
                                                        MinWidth="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 8: التعادل (مخفي) -->
                                    <DataGridTextColumn x:Name="PercentUnitDgv"
                                                        Header="التعادل"
                                                        Binding="{Binding UnitEquality}"
                                                        Width="55"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 9: إجمالي الكمية (مخفي) -->
                                    <DataGridTextColumn x:Name="totQuantDgv"
                                                        Header="إجمالي الكمية"
                                                        Binding="{Binding TotalQuantity}"
                                                        Width="70"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 10: السعر -->
                                    <DataGridTextColumn x:Name="priceDgv"
                                                        Header="💲 السعر"
                                                        Binding="{Binding Price}"
                                                        Width="70"
                                                        MinWidth="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 11: المجموع -->
                                    <DataGridTextColumn x:Name="SumPriceDgv"
                                                        Header="المجموع"
                                                        Binding="{Binding SumPrice}"
                                                        Width="80"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 12: تكلفة متوسط (مخفي داخلي) -->
                                    <DataGridTextColumn Header="التكلفة"
                                                        Binding="{Binding AvgCost}"
                                                        Width="70"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 13: الخصم -->
                                    <DataGridTextColumn x:Name="discountValDgv"
                                                        Header="الخصم"
                                                        Binding="{Binding DiscountVal}"
                                                        Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 14: نسبة الخصم (مخفي) -->
                                    <DataGridTextColumn x:Name="discountPerDgv"
                                                        Header="نسبة الخصم"
                                                        Binding="{Binding DiscountPer}"
                                                        Width="75"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 15: الإجمالي -->
                                    <DataGridTextColumn x:Name="totPriceDgv"
                                                        Header="الإجمالي"
                                                        Binding="{Binding TotalPrice}"
                                                        Width="80"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 16: نسبة الضريبة (مخفي) -->
                                    <DataGridTextColumn x:Name="VatPerDgv"
                                                        Header="نسبة الضريبة"
                                                        Binding="{Binding VatPer}"
                                                        Width="60"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 17: الضريبة (مخفي) -->
                                    <DataGridTextColumn x:Name="VATValDgv"
                                                        Header="الضريبة"
                                                        Binding="{Binding VatVal}"
                                                        Width="60"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 18: الصافي -->
                                    <DataGridTextColumn x:Name="NetValDgv"
                                                        Header="الصافي"
                                                        Binding="{Binding NetVal}"
                                                        Width="80"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 19: الكمية الحالية (مخفي) -->
                                    <DataGridTextColumn x:Name="StockDgv"
                                                        Header="الكمية الحالية"
                                                        Binding="{Binding Stock}"
                                                        Width="70"
                                                        Visibility="Collapsed"/>

                                    <!-- Col 20: المستودع -->
                                    <DataGridTextColumn x:Name="StoreDgv"
                                                        Header="المستودع"
                                                        Binding="{Binding StoreName}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Col 21: حذف البند -->
                                    <DataGridTemplateColumn x:Name="DeleteRowDgv"
                                                            Header="🗑️"
                                                            Width="45"
                                                            IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        FontSize="14"
                                                        ToolTip="حذف البند"
                                                        Tag="{Binding}"
                                                        Click="DeleteRowBtn_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ═══ GroupBox9: ملخص الفاتورة ═══ -->
                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="6,3,6,3"
                            Padding="10,6"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Panel1: مجاميع -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <!-- بيانات الصنف المحدد -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <!-- عدد البنود -->
                            </Grid.ColumnDefinitions>

                            <!-- Panel1: المجاميع المالية -->
                            <Border Grid.Column="0"
                                    Background="#F5F8FF"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- المجموع -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock x:Name="lblTotSale"
                                                   Text="📊 المجموع"
                                                   Style="{StaticResource InfoLabel}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtSumVal"
                                                 Style="{StaticResource SummaryTextBox}"/>
                                    </StackPanel>

                                    <Border Grid.Row="0" Grid.Column="1" Width="1" Background="{StaticResource BorderLight}" Margin="6,0"/>

                                    <!-- إجمالي الخصم -->
                                    <StackPanel Grid.Row="0" Grid.Column="2"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="Label22col"
                                                   Text="✂️ إجمالي الخصم"
                                                   Style="{StaticResource InfoLabel}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="Red"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtTotDiscount"
                                                 Text="0"
                                                 Style="{StaticResource SummaryTextBox}"
                                                 Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- إجمالي الضريبة -->
                                    <StackPanel Grid.Row="0" Grid.Column="4"
                                                Visibility="Collapsed">
                                        <TextBlock Text="🧾 إجمالي الضريبة"
                                                   Style="{StaticResource InfoLabel}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtTotVAT"
                                                 Text="0"
                                                 Style="{StaticResource SummaryTextBox}"
                                                 Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- الصافي -->
                                    <StackPanel Grid.Row="0" Grid.Column="6"
                                                Visibility="Collapsed">
                                        <TextBlock Text="💰 الصافي"
                                                   Style="{StaticResource InfoLabel}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtNet"
                                                 Style="{StaticResource SummaryTextBox}"
                                                 Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- بيانات الصنف المحدد -->
                            <Border Grid.Column="2"
                                    Background="#FFF8F0"
                                    BorderBrush="#FFD0A0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    MinWidth="480">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row0: باركود -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="🔖 الباركود"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtItemBarcode"
                                             Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                               Text="📦 الكمية الحالية"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtStock"
                                             Grid.Row="0" Grid.Column="4"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <TextBlock Grid.Row="0" Grid.Column="6"
                                               Text="⚖️ التعادل"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtPerUnit"
                                             Grid.Row="0" Grid.Column="7"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <!-- Row2 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="💰 آخر سعر شراء"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtRecentPurchPrice"
                                             Grid.Row="2" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <TextBlock Grid.Row="2" Grid.Column="3"
                                               Text="🏷️ آخر سعر بيع"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtLastSalePrice"
                                             Grid.Row="2" Grid.Column="4"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <TextBlock Grid.Row="2" Grid.Column="6"
                                               Text="🏪 سعر المنافس"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtCompetitorPrice"
                                             Grid.Row="2" Grid.Column="7"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <!-- Row4 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Text="📊 متوسط التكلفة"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtCostAvrg"
                                             Grid.Row="4" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <TextBlock Grid.Row="4" Grid.Column="3"
                                               Text="📦 كمية و/س"
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtTotUnitQuan"
                                             Grid.Row="4" Grid.Column="4"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             TextAlignment="Center" Height="26"/>

                                    <TextBlock x:Name="lblPerUnit"
                                               Grid.Row="4" Grid.Column="6"
                                               Text=""
                                               Style="{StaticResource InfoLabel}"
                                               Margin="0,0,4,0"/>
                                </Grid>
                            </Border>

                            <!-- عدد البنود + الكمية -->
                            <Border Grid.Column="4"
                                    Background="#F0FFF4"
                                    BorderBrush="#A0D8B0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    MinWidth="200">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,6">
                                        <TextBlock Text="🔢 عدد البنود"
                                                   Style="{StaticResource InfoLabel}"
                                                   Margin="0,0,8,0"/>
                                        <TextBox x:Name="txtTirmsNo"
                                                 Style="{StaticResource ReadOnlyTextBox}"
                                                 Width="80" Height="28"
                                                 TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="📦 إجمالي الكمية"
                                                   Style="{StaticResource InfoLabel}"
                                                   Margin="0,0,8,0"/>
                                        <TextBox x:Name="txtTotQuan"
                                                 Style="{StaticResource ReadOnlyTextBox}"
                                                 Width="80" Height="28"
                                                 TextAlignment="Center"/>
                                    </StackPanel>

                                    <!-- حقول إضافية مخفية -->
                                    <TextBox x:Name="txtInvDisc"
                                             Visibility="Collapsed" Width="60" Height="26"
                                             TextAlignment="Center"/>
                                    <TextBox x:Name="txtInvDiscVal"
                                             Visibility="Collapsed" Width="80" Height="26"
                                             TextAlignment="Center"/>
                                    <TextBox x:Name="txtInvTaxPer"
                                             Visibility="Collapsed" Width="100" Height="26"
                                             IsReadOnly="True" TextAlignment="Center"/>
                                    <TextBox x:Name="txtInvTax"
                                             Visibility="Collapsed" Width="100" Height="26"
                                             IsReadOnly="True" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ═══ pnlNewBtns: شريط الأزرار ═══ -->
                    <Border x:Name="pnlNewBtns"
                            Grid.Row="3"
                            Background="{StaticResource FooterBrush}"
                            FlowDirection="LeftToRight"
                            Padding="10,6"
                            Margin="0,3,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- أزرار التنقل -->
                                <ColumnDefinition Width="*"/>
                                <!-- وسط -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- أزرار العمليات -->
                            </Grid.ColumnDefinitions>

                            <!-- أزرار التنقل -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="btnClose"
                                        Content="✖"
                                        Style="{StaticResource DangerBtn}"
                                        Width="42" ToolTip="خروج"
                                        Margin="0,0,4,0"
                                        Click="btnClose_Click"/>
                                <Button x:Name="btnFirst"
                                        Content="⏮"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="الأول"
                                        Margin="0,0,4,0"
                                        Click="btnFirst_Click"/>
                                <Button x:Name="btnPrevious"
                                        Content="◀"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="السابق"
                                        Margin="0,0,4,0"
                                        Click="btnPrevious_Click"/>
                                <Button x:Name="btnNext"
                                        Content="▶"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="التالي"
                                        Margin="0,0,4,0"
                                        Click="btnNext_Click"/>
                                <Button x:Name="btnLast"
                                        Content="⏭"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="الأخير"
                                        Click="btnLast_Click"/>
                            </StackPanel>

                            <!-- أزرار العمليات -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="btnDelete"
                                        Content="🗑️ حذف"
                                        Style="{StaticResource DangerBtn}"
                                        Width="84" Margin="0,0,5,0"
                                        ToolTip="حذف الفاتورة"
                                        Click="btnDelete_Click"/>
                                <Button x:Name="btnView"
                                        Content="👁️ معاينة"
                                        Style="{StaticResource InfoBtn}"
                                        Width="84" Margin="0,0,5,0"
                                        ToolTip="معاينة الطباعة"
                                        Click="btnView_Click"/>
                                <Button x:Name="btnPrint"
                                        Content="🖨️ طباعة"
                                        Style="{StaticResource PurpleBtn}"
                                        Width="84" Margin="0,0,5,0"
                                        ToolTip="طباعة"
                                        Click="btnPrint_Click"/>
                                <Button x:Name="btnSave"
                                        Content="💾 حفظ"
                                        Style="{StaticResource SaveBtn}"
                                        Width="84" Margin="0,0,5,0"
                                        ToolTip="حفظ"
                                        Click="btnSave_Click"/>
                                <Button x:Name="btnSavePrint"
                                        Content="🖨️ حفظ مع طباعة"
                                        Style="{StaticResource SaveBtn}"
                                        Width="130" Margin="0,0,5,0"
                                        ToolTip="حفظ مع طباعة"
                                        Click="btnSavePrint_Click"/>
                                <Button x:Name="btnNew"
                                        Content="➕ جديد"
                                        Style="{StaticResource ActionBtn}"
                                        Width="84"
                                        ToolTip="فاتورة جديدة"
                                        Click="btnNew_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════ -->
            <!--              TAB 2: البحث                      -->
            <!-- ══════════════════════════════════════════════ -->
            <TabItem x:Name="TabPage2" Header="  🔍 البحث  ">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- GroupBox6: فلتر البحث -->
                        <RowDefinition Height="*"/>
                        <!-- GroupBox4: نتائج البحث -->
                    </Grid.RowDefinitions>

                    <!-- ═══ GroupBox6: فلتر البحث ═══ -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="6,6,6,3"
                            Padding="12,10"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <!-- Header -->
                            <Border Background="{StaticResource InfoBrush}"
                                    CornerRadius="7" Padding="10,5" Margin="0,0,0,10">
                                <TextBlock Text="🔍 البحث في الفواتير"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <!-- نوع الحركة -->
                                <TextBlock Grid.Column="0"
                                           Text="📋 نوع الحركة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="cmbProcTypeSrch"
                                          Grid.Column="1"
                                          Style="{StaticResource ModernCombo}"
                                          Visibility="Collapsed">
                                    <ComboBoxItem Content="فاتورة"/>
                                    <ComboBoxItem Content="مرتجع فاتورة"/>
                                </ComboBox>

                                <!-- رقم الفاتورة -->
                                <TextBlock Grid.Column="3"
                                           Text="🔢 رقم الفاتورة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtSrchNo"
                                         Grid.Column="4"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <!-- من تاريخ -->
                                <TextBlock Grid.Column="6"
                                           Text="📅 من تاريخ"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <dxe:DateEdit x:Name="txtFromDate"
                                              Grid.Column="7"
                                              Height="30" FontSize="12"/>

                                <!-- الى تاريخ -->
                                <TextBlock Grid.Column="9"
                                           Text="📅 الى تاريخ"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <dxe:DateEdit x:Name="txtToDate"
                                              Grid.Column="10"
                                              Height="30" FontSize="12"/>

                                <!-- زر البحث -->
                                <Button x:Name="btnSearch"
                                        Grid.Column="12"
                                        Content="🔍 بحث"
                                        Style="{StaticResource InfoBtn}"
                                        Height="38"
                                        Click="btnSearch_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ GroupBox4: نتائج البحث ═══ -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="6,3,6,6"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource InfoBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvSrchColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F0F5FF"
                                      BorderThickness="0"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <!-- Col 0: InvGlobalID (مخفي) -->
                                    <DataGridTextColumn x:Name="Column10"
                                                        Header="رقم الحركة"
                                                        Binding="{Binding InvGlobalID}"
                                                        Width="80"
                                                        Visibility="Collapsed"/>
                                    <!-- Col 1: الرقم -->
                                    <DataGridTextColumn x:Name="DataGridViewTextBoxColumn1"
                                                        Header="🔢 الرقم"
                                                        Binding="{Binding InvoiceNo}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Col 2: التاريخ -->
                                    <DataGridTextColumn x:Name="Column3"
                                                        Header="📅 التاريخ"
                                                        Binding="{Binding InvoiceDate}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</dx:ThemedWindow>