<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmFonudation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="🏢 تعريف المنشأة"
    Width="780" Height="620"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    ShowIcon="False"
    Loaded="frmFonudation_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#4338CA" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="RequiredStar" TargetType="TextBlock">
            <Setter Property="Text" Value="*"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LinkTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A63C3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,8,10,4">

                <!-- ═══ القسم 1: البيانات الأساسية + الشعار ═══ -->
                <Border Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}"
                        Padding="0"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0"
                                Padding="12,7">
                            <TextBlock Text="🏢 البيانات الأساسية للمنشأة"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>

                        <Grid Grid.Row="1" Margin="14,10,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <!-- الحقول -->
                            <StackPanel Grid.Column="0">
                                <!-- اسم المنشأة عربي -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="🏷️ اسم المنشأة (عربي)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtNameAr"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,8"/>

                                <!-- اسم المنشأة انجليزي -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="🏷️ اسم المنشأة (EN)"
                                               Style="{StaticResource FieldLabel}"/>
                                </StackPanel>
                                <TextBox x:Name="txtNameEn"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"
                                         Margin="0,0,0,8"/>

                                <!-- النشاط عربي -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="📋 النشاط التجاري"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtField"
                                         Style="{StaticResource ModernTextBox}"
                                         Margin="0,0,0,8"/>

                                <!-- النشاط انجليزي -->
                                <TextBlock Text="📋 النشاط (EN)"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtFieldEn"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"
                                         Margin="0,0,0,4"/>
                            </StackPanel>

                            <!-- الشعار -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="🖼️ شعار المنشأة"
                                           Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Center"/>

                                <Border BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Width="140" Height="110"
                                        Background="#F5F7FA"
                                        Margin="0,4,0,6">
                                    <Image x:Name="picLogo"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,4">
                                    <TextBlock x:Name="lnkOpenFile"
                                               Text="📂 اختيار"
                                               Style="{StaticResource LinkTextStyle}"
                                               Margin="0,0,12,0"
                                               MouseLeftButtonDown="btnOpenFile_Click"/>
                                    <TextBlock x:Name="lnkDeleteLogo"
                                               Text="🗑️ حذف"
                                               Style="{StaticResource LinkTextStyle}"
                                               MouseLeftButtonDown="BtnDeleteLogo_Click"/>
                                </StackPanel>

                                <TextBox x:Name="txtLogoPath"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         FontSize="9"
                                         Height="24"
                                         Background="#F0F0F0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ القسم 2: بيانات الاتصال ═══ -->
                <Border Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}"
                        Padding="0"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0"
                                Padding="12,7">
                            <TextBlock Text="📞 بيانات الاتصال"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>

                        <Grid Grid.Row="1" Margin="14,10,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- هاتف -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="📞 الهاتف"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTel"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- جوال -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📱 الجوال"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtMobile"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- بريد -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📧 البريد الإلكتروني"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtEmail"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- موقع -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="🌐 الموقع الإلكتروني"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtWebsite"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- رقم السجل -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="📝 رقم السجل التجاري"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtBusnNo"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- الرقم الضريبي -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔢 الرقم الضريبي"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtTaxNo"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <!-- نوع السجل -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 نوع السجل"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbCrtype"
                                          Style="{StaticResource ModernCombo}"
                                          FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ القسم 3: العنوان التفصيلي ═══ -->
                <Border Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}"
                        Padding="0"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0"
                                Padding="12,7">
                            <TextBlock Text="📍 العنوان التفصيلي"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>

                        <Grid Grid.Row="1" Margin="14,10,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- الدولة -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌍 الدولة"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtcountry"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- المدينة -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏙️ المدينة"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtcity"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- المنطقة -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="📌 المنطقة (Area)"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtArea"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- الحي -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="🏘️ الحي (District)"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtDistrict"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- اسم الشارع -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="🛣️ اسم الشارع"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtStreetName"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- شارع إضافي -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="🛤️ شارع إضافي"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAdditionalStreetName"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- رقم المبنى -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="🏠 رقم المبنى"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtBuildingNumber"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- رقم القطعة -->
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="📐 رقم القطعة"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPlotIdentification"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- الرمز البريدي -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="📮 الرمز البريدي"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtPostalZone"
                                         Style="{StaticResource ModernTextBox}"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <!-- العنوان الكامل -->
                            <StackPanel Grid.Row="5" Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,0,0,4">
                                <TextBlock Text="🏠 العنوان الكامل"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAddress"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="50"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ القسم 4: إعدادات الفوترة ═══ -->
                <Border Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}"
                        Padding="0"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0"
                                Padding="12,7">
                            <TextBlock Text="⚡ إعدادات الفوترة الإلكترونية"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="14,10,14,14"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="chkEInvoice"
                                      Content="✅ تفعيل الفوترة الإلكترونية"
                                      IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,30,0"
                                      Checked="chkEInvoice_CheckedChanged"
                                      Unchecked="chkEInvoice_CheckedChanged"/>

                            <CheckBox x:Name="chkEgyEInvoice"
                                      Content="🇪🇬 فوترة مصرية"
                                      Style="{StaticResource ModernCheckBox}"
                                      Checked="chkEgyEInvoice_CheckedChanged"
                                      Unchecked="chkEgyEInvoice_CheckedChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource InfoBtn}"
                            Width="90"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="110"
                            Click="btnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>