<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmServerSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="إعدادات الاتصال"
    Width="660" Height="540"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernRadioBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF3FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TabControl ══ -->
        <TabControl x:Name="TabControl1" Grid.Row="0"
                    FlowDirection="RightToLeft">

            <!-- ══ TabPage1 — إعدادات الاتصال ══ -->
            <TabItem Header="⚙️ إعدادات الاتصال">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F6FA">
                    <StackPanel Margin="12">

                        <!-- عنوان السيرفر -->
                        <Border Background="White" CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="7" Padding="10,5"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="🖥️ إعدادات الاتصال بالسيرفر"
                                               Foreground="White" FontSize="12"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- نوع الاتصال -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="rdLocal"
                                                 Content="جهاز محلي" IsChecked="True"
                                                 GroupName="ConnType"
                                                 Style="{StaticResource ModernRadioBtn}"
                                                 Checked="rdLocal_CheckedChanged"/>
                                    <RadioButton x:Name="rdNetwork"
                                                 Content="شبكة"
                                                 GroupName="ConnType"
                                                 Style="{StaticResource ModernRadioBtn}"
                                                 Checked="rdNetwork_CheckedChanged"/>
                                    <CheckBox x:Name="chkServerAuth"
                                              Content="SQL Server Authentication"
                                              Style="{StaticResource ModernCheckBox}"
                                              Checked="chkServerAuth_CheckedChanged"
                                              Unchecked="chkServerAuth_CheckedChanged"/>
                                </StackPanel>

                                <!-- عنوان السيرفر -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="عنوان السيرفر:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtServer" Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"
                                             Text=".\sqlexpress"
                                             FlowDirection="LeftToRight"/>
                                </Grid>

                                <!-- بيانات الاتصال (SQL Auth) -->
                                <Border x:Name="pnlAuth"
                                        Background="#F0F4FF"
                                        CornerRadius="8" Padding="10,8"
                                        Margin="0,0,0,8"
                                        IsEnabled="False"
                                        Opacity="0.5">
                                    <StackPanel>
                                        <TextBlock Text="🔐 بيانات اتصال قاعدة البيانات"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#213A7A" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="المستخدم:"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtUser" Grid.Column="1"
                                                     Style="{StaticResource ModernTextBox}"
                                                     FlowDirection="LeftToRight"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="كلمة المرور:"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <PasswordBox x:Name="txtPWD" Grid.Column="1"
                                                         Style="{StaticResource ModernPasswordBox}"
                                                         KeyDown="txtPWD_KeyDown"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- الحالة + ربط قاعدة البيانات -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="lblIsOk" Grid.Column="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="DarkGreen"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <ComboBox x:Name="cmbDatabases" Grid.Column="2"
                                              Style="{StaticResource ModernComboBox}"
                                              Width="200"
                                              ToolTip="اختر قاعدة البيانات"/>

                                    <Button Grid.Column="4"
                                            x:Name="btnSubmit"
                                            Content="✅ تأكيد الاتصال"
                                            Style="{StaticResource SaveBtn}"
                                            MinWidth="120"
                                            Click="btnSubmit_Click"/>
                                </Grid>

                                <TextBlock x:Name="lblCurrDatabase"
                                           Text="لا يوجد قاعدة بيانات مرتبطة حالياً"
                                           FontSize="10" Foreground="#888"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ TabPage3 — الملفات ══ -->
            <TabItem Header="📂 الملفات">
                <Grid Background="#F5F6FA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- فلاتر -->
                    <Border Grid.Row="0" Background="White"
                            Margin="8,8,8,0" CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbActiveDbs"
                                         Content="ملفات نشطة" IsChecked="True"
                                         GroupName="DbFilter"
                                         Style="{StaticResource ModernRadioBtn}"
                                         Checked="rbActiveDbs_CheckedChanged"/>
                            <RadioButton x:Name="rbInactiveDbs"
                                         Content="ملفات غير نشطة"
                                         GroupName="DbFilter"
                                         Style="{StaticResource ModernRadioBtn}"
                                         Checked="rbInactiveDbs_CheckedChanged"/>
                            <RadioButton x:Name="rbAllDBs"
                                         Content="الكل"
                                         GroupName="DbFilter"
                                         Style="{StaticResource ModernRadioBtn}"
                                         Checked="rbAllDBs_CheckedChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="DgvDBs" Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              Margin="8,6,8,0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              MouseRightButtonDown="DgvDBs_MouseRightButtonDown"
                              MouseDoubleClick="DgvDBs_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DbId"
                                                Binding="{Binding DbId}"
                                                Visibility="Collapsed"/>
                            <DataGridTextColumn Header="AutoName"
                                                Binding="{Binding AutoName}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="اسم الملف"
                                                Binding="{Binding DbName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="تاريخ الإنشاء"
                                                Binding="{Binding CreateDate}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="نشطة"
                                                    Binding="{Binding IsActive}"
                                                    Width="50" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="تحديث" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🔄"
                                                Tag="{Binding}"
                                                Height="20" FontSize="12"
                                                Foreground="White"
                                                Background="#2E4E9E"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="btnRefresh_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="2,1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="صيانة" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🔧"
                                                Tag="{Binding}"
                                                Height="20" FontSize="12"
                                                Foreground="White"
                                                Background="#1B7A4A"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="btnScript_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="2,1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══ TabPage4 — إنشاء ملف جديد ══ -->
            <TabItem Header="➕ إنشاء ملف جديد">
                <Border Background="White" Margin="8" CornerRadius="10"
                        Effect="{StaticResource CardShadow}" Padding="16">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="10,5"
                                Margin="0,0,0,12">
                            <TextBlock Text="📦 قاعدة بيانات جديدة"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اسم قاعدة البيانات:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtDbName" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="مسار الملف:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtPath" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="2" Content="..."
                                    Style="{StaticResource ActionBtn}"
                                    Width="36" Click="btnPath_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الفترة المحاسبية:"
                                       Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtStartdate" Grid.Column="1"
                                          Height="28" FontSize="11"/>
                            <dxe:DateEdit x:Name="txtEnddate" Grid.Column="3"
                                          Height="28" FontSize="11"/>
                        </Grid>

                        <Button x:Name="btnCreateDatabase"
                                Content="🗄️ إنشاء قاعدة بيانات"
                                Style="{StaticResource SaveBtn}"
                                HorizontalAlignment="Center"
                                MinWidth="200" Margin="0,10,0,0"
                                Click="btnCreateDatabase_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ══ TabPage2 — استعادة ملف ══ -->
            <TabItem Header="🔄 استعادة ملف">
                <Border Background="White" Margin="8" CornerRadius="10"
                        Effect="{StaticResource CardShadow}" Padding="16">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="10,5"
                                Margin="0,0,0,12">
                            <TextBlock Text="🔄 استعادة ملف البيانات من نسخة احتياطية"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اسم قاعدة البيانات:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtDbNameDis" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اسم ملف السابق:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSrcDb" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="مسار النسخة:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtRestore" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" Content="..."
                                    Style="{StaticResource ActionBtn}"
                                    Width="36" Click="Button3_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
                            <Button x:Name="Button5"
                                    Content="✖ خروج"
                                    Style="{StaticResource DangerBtn}"
                                    MinWidth="120" Margin="0,0,8,0"
                                    Click="Button5_Click"/>
                            <Button x:Name="btnDoRestore"
                                    Content="▶ تنفيذ"
                                    Style="{StaticResource SaveBtn}"
                                    MinWidth="120" Margin="0,0,8,0"
                                    Click="btnDoRestore_Click"/>
                            <Button x:Name="btnRestoreFromScript"
                                    Content="📄 Restore from Script"
                                    Style="{StaticResource ActionBtn}"
                                    MinWidth="160"
                                    Click="btnRestoreFromScript_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ══ TabPage5 — إعدادات الموزع ══ -->
            <TabItem Header="👤 إعدادات الموزع">
                <Border Background="White" Margin="8" CornerRadius="10"
                        Effect="{StaticResource CardShadow}" Padding="16">
                    <StackPanel>
                        <Border Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="10,5"
                                Margin="0,0,0,12">
                            <TextBlock Text="👤 إعدادات الموزع"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- الرمز -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="أدخل الرمز:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSalesmanCode" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <!-- رقم الجوال -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم الجوال:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSalesmaneMobile" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <!-- البريد -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="البريد الإلكتروني:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSalemaneEmail" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <!-- الموقع -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الموقع الإلكتروني:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSalesmanWebsite" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <!-- العنوان -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="العنوان:"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Top" Margin="0,6,6,0"/>
                            <TextBox x:Name="txtSalesmanAddress" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="60" TextWrapping="Wrap"
                                     AcceptsReturn="True" FlowDirection="RightToLeft"/>
                        </Grid>

                        <Button x:Name="btnSaveSalesmaneSetting"
                                Content="💾 حفظ إعدادات الموزع"
                                Style="{StaticResource SaveBtn}"
                                HorizontalAlignment="Center"
                                MinWidth="180"
                                Click="btnSaveSalesmaneSetting_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>

        <!-- ══ Footer ══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="Button2" Grid.Column="0"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="80" Click="Button2_Click"/>

                <Button x:Name="btnConnectServer" Grid.Column="2"
                        Content="🔌 اتصال بالسيرفر"
                        Style="{StaticResource SaveBtn}"
                        MinWidth="130"
                        Click="btnConnectServer_Click"/>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>