<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvsProfit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    Title="أرباح الفواتير"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarningBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#C47D0A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8E44AD" Offset="0"/>
            <GradientStop Color="#6C3483" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,3"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="MinWidth"        Value="60"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Background"      Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Effect"          Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"    TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn"  TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="WarningBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>
        <Style x:Key="PurpleBtn"  TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
        </Style>

        <Style x:Key="InCellBtn"  TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgress" TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="Foreground"      Value="#3A63C3"/>
            <Setter Property="Background"      Value="#E0E6F5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ══════════════════ ROOT GRID ══════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--  COLUMN 0 : Grid + Footer                 -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Header Title ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    Padding="12,8">
                <TextBlock Text="📊 أرباح الفواتير"
                           Style="{StaticResource SectionTitle}"
                           FontSize="16"/>
            </Border>

            <!-- ─── GridControl ─── -->
            <Border Grid.Row="1"
        Background="White"
        Margin="6,6,6,0"
        CornerRadius="10"
                    FlowDirection="RightToLeft"
        Effect="{StaticResource CardShadow}">
                <dxg:GridControl x:Name="GridControl1"
                     SelectionMode="MultipleRow">

                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="GridView1"
                           ShowGroupPanel="False"
                           ShowTotalSummary="True"
                           NavigationStyle="Row"
                           MultiSelectMode="Row"
                           ShowCheckBoxSelectorColumn="True"
                           AllowPerPixelScrolling="True"
                           AllowColumnMoving="True"
                           AllowSorting="True"/>
                    </dxg:GridControl.View>

                    <dxg:GridControl.Columns>

                        <dxg:GridColumn FieldName="DgvNo"
                            Header="م"
                            Width="50"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvInvType"
                            Header="نوع الفاتورة"
                            Width="120"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvInvNo"
                            Header="رقم الفاتورة"
                            Width="90"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvRefNo"
                            Header="رقم المرجع"
                            Width="90"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvDate"
                            Header="التاريخ"
                            Width="100"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvPayType"
                            Header="نوع الدفع"
                            Width="90"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvClient"
                            Header="العميل"
                            Width="130"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvTotal"
                            Header="المجموع"
                            Width="100"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvDiscount"
                            Header="الخصم"
                            Width="90"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvSum"
                            Header="الإجمالي"
                            Width="100"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="colDgvCost"
                            FieldName="DgvCost"
                            Header="التكلفة"
                            Width="100"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvUser"
                            Header="المستخدم"
                            Width="110"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvProfit"
                Header="الربح"
                Width="100"
                AllowEditing="False"
                HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="profitBorder"
                    Background="Transparent"
                    CornerRadius="4"
                    Padding="4,2"
                    Margin="2">
                                        <TextBlock x:Name="profitText"
                           Text="{Binding Value, StringFormat={}{0:0.##}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RowData.Row[DgvProfitState]}"
                             Value="Zero">
                                            <Setter TargetName="profitBorder"
                            Property="Background"
                            Value="Orange"/>
                                            <Setter TargetName="profitText"
                            Property="Foreground"
                            Value="Black"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding RowData.Row[DgvProfitState]}"
                             Value="Negative">
                                            <Setter TargetName="profitBorder"
                            Property="Background"
                            Value="OrangeRed"/>
                                            <Setter TargetName="profitText"
                            Property="Foreground"
                            Value="White"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding RowData.Row[DgvProfitState]}"
                             Value="Positive">
                                            <Setter TargetName="profitBorder"
                            Property="Background"
                            Value="#EAF8EE"/>
                                            <Setter TargetName="profitText"
                            Property="Foreground"
                            Value="#1B8E4A"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvStore"
                            Header="المستودع"
                            Width="120"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvProfitRatio"
                            Header="نسبة الربح"
                            Width="100"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn FieldName="DgvBranch"
                            Header="الفرع"
                            Width="130"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center"/>

                        <!-- زر تفاصيل -->
                        <dxg:GridColumn FieldName="BtnDetails"
                            Header="تفاصيل"
                            Width="95"
                            AllowEditing="False"
                            HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔍 تفاصيل"
                                Style="{StaticResource InCellBtn}"
                                Background="{StaticResource HeaderBrush}"
                                Tag="{Binding Path=RowData.Row}"
                                Click="BtnDetails_Click"/>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                        <!-- مخفية -->
                        <dxg:GridColumn FieldName="DgvInvGlobalID" Visible="False"/>
                        <dxg:GridColumn FieldName="DgvOperType" Visible="False"/>
                        <dxg:GridColumn FieldName="DgvProcType" Visible="False"/>

                    </dxg:GridControl.Columns>

                    <!-- الملخصات تكون هنا فقط -->
                    <dxg:GridControl.TotalSummary>
                        <dxg:GridSummaryItem FieldName="DgvTotal"
                                 SummaryType="Custom"
                                 ShowInColumn="DgvTotal"
                                 DisplayFormat="{}{0:0.##}"/>

                        <dxg:GridSummaryItem FieldName="DgvDiscount"
                                 SummaryType="Custom"
                                 ShowInColumn="DgvDiscount"
                                 DisplayFormat="{}{0:0.##}"/>

                        <dxg:GridSummaryItem FieldName="DgvSum"
                                 SummaryType="Custom"
                                 ShowInColumn="DgvSum"
                                 DisplayFormat="{}{0:0.##}"/>

                        <dxg:GridSummaryItem FieldName="DgvCost"
                                 SummaryType="Custom"
                                 ShowInColumn="DgvCost"
                                 DisplayFormat="{}{0:0.##}"/>

                        <dxg:GridSummaryItem FieldName="DgvProfit"
                                 SummaryType="Custom"
                                 ShowInColumn="DgvProfit"
                                 DisplayFormat="{}{0:0.##}"/>
                    </dxg:GridControl.TotalSummary>

                </dxg:GridControl>
            </Border>
            <!-- ─── Progress Bar ─── -->
            <ProgressBar x:Name="ProgressBar1"
                         Grid.Row="2"
                         Style="{StaticResource ModernProgress}"
                         Value="0" Maximum="100"
                         Margin="6,4"/>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="3"
                    Background="{StaticResource FooterBrush}"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- يسار: خروج -->
                    <Button Grid.Column="0"
                            x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="80" Margin="0,0,6,0"
                            Click="btnClose_Click"/>

                    <!-- وسط: تصدير + طباعة + معاينة -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="btnExportExcel"
                                Content="📊 تصدير Excel"
                                Style="{StaticResource SaveBtn}"
                                Width="120" Margin="0,0,6,0"
                                Click="btnExportExcel_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPrint_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource WarningBtn}"
                                Width="90"
                                Click="btnPreview_Click"/>
                    </StackPanel>

                    <!-- يمين: إعادة احتساب التكلفة (مخفي افتراضياً) -->
                    <Button Grid.Column="2"
                            x:Name="btnRecalculateCost"
                            Content="🔄 إعادة احتساب التكلفة"
                            Style="{StaticResource PurpleBtn}"
                            Width="175"
                            Visibility="Collapsed"
                            Click="btnRecalculateCost_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--  COLUMN 1 : Search Panel                  -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1,0,0,0"
                FlowDirection="RightToLeft"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,10">

                    <!-- عنوان -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="10,6"
                            Margin="0,0,0,12">
                        <TextBlock Text="🔍 خيارات البحث"
                                   Style="{StaticResource SectionTitle}"/>
                    </Border>

                    <!-- ─── نوع العملية ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6" Padding="6,4"
                            Margin="0,0,0,6">
                        <TextBlock Text="⚙️ نوع العملية"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="12"/>
                    </Border>
                    <StackPanel Margin="4,0,0,10">
                        <RadioButton x:Name="rbAllSales"
                                     Content="🔵 الكل"
                                     IsChecked="True"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="OperType"/>
                        <RadioButton x:Name="rbSales"
                                     Content="💼 مبيعات"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="OperType"/>
                        <RadioButton x:Name="rbReturn"
                                     Content="↩️ مرتجع"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="OperType"/>
                    </StackPanel>

                    <!-- ─── نوع الفاتورة ─── -->
                    <TextBlock Text="📋 نوع الفاتورة"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllInvs"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllInvs_CheckedChanged"
                                  Unchecked="ckAllInvs_CheckedChanged"/>
                        <ComboBox x:Name="cmbInvType"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── المستودع ─── -->
                    <TextBlock Text="🏭 المستودع"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllStore"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllStore_CheckedChanged"
                                  Unchecked="ckAllStore_CheckedChanged"/>
                        <ComboBox x:Name="cmbStore"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── نوع الدفع ─── -->
                    <TextBlock Text="💳 نوع الدفع"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllType"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllType_CheckedChanged"
                                  Unchecked="ckAllType_CheckedChanged"/>
                        <ComboBox x:Name="cmbType"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── الفرع ─── -->
                    <TextBlock Text="🏬 الفرع"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkAllBranches"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="chkAllBranches_CheckedChanged"
                                  Unchecked="chkAllBranches_CheckedChanged"/>
                        <ComboBox x:Name="cmbBranches"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"/>
                    </Grid>

                    <!-- ─── المستخدم ─── -->
                    <TextBlock Text="🧑‍💼 المستخدم"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllUsers"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllUsers_CheckedChanged"
                                  Unchecked="ckAllUsers_CheckedChanged"/>
                        <ComboBox x:Name="cmbusers"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── العميل ─── -->
                    <TextBlock Text="🏢 العميل"
                               Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllClients"
                                  Grid.Column="0"
                                  Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllClients_CheckedChanged"
                                  Unchecked="ckAllClients_CheckedChanged"/>
                        <ComboBox x:Name="cmbClients"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"
                                  IsEnabled="False"/>
                    </Grid>

                    <!-- ─── الفترة الزمنية ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6" Padding="6,4"
                            Margin="0,4,0,8">
                        <TextBlock Text="📅 الفترة الزمنية"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="12"/>
                    </Border>

                    <CheckBox x:Name="ckTotalPeriod"
                              Content="📌 كل الفترة"
                              IsChecked="True"
                              Style="{StaticResource ModernCheck}"
                              Margin="0,0,0,8"
                              Checked="ckTotalPeriod_CheckedChanged"
                              Unchecked="ckTotalPeriod_CheckedChanged"/>

                    <TextBlock Text="من" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="txtFromDate"
                                Style="{StaticResource ModernDatePicker}"
                                IsEnabled="False"
                                Margin="0,0,0,8"/>

                    <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="txtToDate"
                                Style="{StaticResource ModernDatePicker}"
                                IsEnabled="False"
                                Margin="0,0,0,10"/>

                    <!-- ─── الأرباح ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6" Padding="6,4"
                            Margin="0,4,0,8">
                        <TextBlock Text="💹 تصفية الأرباح"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="12"/>
                    </Border>
                    <StackPanel Margin="4,0,0,8">
                        <RadioButton x:Name="rbAllProfit"
                                     Content="🔵 الكل"
                                     IsChecked="True"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="ProfitFilter"/>
                        <RadioButton x:Name="rbPositiveProfit"
                                     Content="✅ أكبر من الصفر"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="ProfitFilter"/>
                        <RadioButton x:Name="rbNegativeProfit"
                                     Content="❌ أقل من الصفر"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="ProfitFilter"/>
                        <RadioButton x:Name="rbZeroProfit"
                                     Content="⭕ صفر"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="ProfitFilter"/>
                        <CheckBox x:Name="ckNonProcessed"
                                  Content="⚠️ فواتير غير معالجة"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,6,0,0"
                                  Checked="ckNonProcessed_CheckedChanged"
                                  Unchecked="ckNonProcessed_CheckedChanged"/>
                    </StackPanel>

                    <!-- ─── سعر التكلفة ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6" Padding="6,4"
                            Margin="0,4,0,8">
                        <TextBlock Text="💰 سعر التكلفة"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="12"/>
                    </Border>
                    <StackPanel Margin="4,0,0,12">
                        <RadioButton x:Name="rbAvgCost"
                                     Content="📊 متوسط سعر التكلفة"
                                     IsChecked="True"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="CostType"/>
                        <RadioButton x:Name="rbPurchPrice"
                                     Content="🛒 سعر الشراء"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="CostType"/>
                        <RadioButton x:Name="rbLastPurchPrice"
                                     Content="🔖 آخر سعر شراء"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="CostType"/>
                    </StackPanel>

                    <!-- ─── زر عرض ─── -->
                    <Button x:Name="btnShow"
                            Content="🔍 عرض النتائج"
                            Style="{StaticResource ActionBtn}"
                            Height="44" FontSize="14"
                            Margin="0,6,0,4"
                            Click="btnShow_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</dx:ThemedWindow>