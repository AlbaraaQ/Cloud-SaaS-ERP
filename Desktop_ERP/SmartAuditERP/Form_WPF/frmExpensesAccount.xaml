<dx:DXWindow
    x:Class="SmartAuditERP.Form_WPF.frmExpensesAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    Title="📒 بطاقة حساب المصاريف"
    FlowDirection="RightToLeft"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    ShowIcon="False"
    Width="520"
    Height="500"
    FontFamily="Tahoma"
    FontSize="13"
    Background="#F5F6FA">

    <dx:DXWindow.Resources>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#253951" Offset="0"/>
            <GradientStop Color="#3a5068" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BtnNewGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3F51B5" Offset="0"/>
            <GradientStop Color="#283593" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BtnSaveGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#43A047" Offset="0"/>
            <GradientStop Color="#2E7D32" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BtnDeleteGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E53935" Offset="0"/>
            <GradientStop Color="#B71C1C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BtnCloseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#757575" Offset="0"/>
            <GradientStop Color="#424242" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BtnSearchGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0288D1" Offset="0"/>
            <GradientStop Color="#01579B" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Opacity="0.1"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4"
                          ShadowDepth="2"
                          Opacity="0.2"
                          Color="#000000"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#253951"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputTextStyle" TargetType="dxe:TextEdit">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="dxe:ComboBoxEdit">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#253951"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="Tahoma"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:DXWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0">
                <TextBlock Text="📒"
                           FontSize="18"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="بطاقة حساب المصاريف"
                           FontFamily="Tahoma"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="XtraTabControl1"
                    Grid.Row="1"
                    Margin="4"
                    Background="White"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1">

            <TabItem x:Name="XtraTabPage1"
                     Header="📋  عام"
                     Style="{StaticResource TabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#EEF0FB"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,14">
                        <TextBlock Text="📝  بيانات الحساب"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#253951"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="كود الحساب :"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <dxe:TextEdit x:Name="txtCode"
                                      Grid.Column="1"
                                      IsEnabled="False"
                                      Style="{StaticResource InputTextStyle}"
                                      Background="#F5F5F5"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="اسم الحساب :"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <dxe:TextEdit x:Name="txtAccName"
                                      Grid.Column="1"
                                      Style="{StaticResource InputTextStyle}"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="مركز التكلفة :"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <dxe:ComboBoxEdit x:Name="cmbCostCenter"
                                          Grid.Column="1"
                                          Style="{StaticResource ComboStyle}"
                                          NullText="-- اختر مركز التكلفة --"/>
                    </Grid>

                    <Border Grid.Row="4" Background="Transparent"/>

                    <Border Grid.Row="5"
                            Background="#F8F9FF"
                            CornerRadius="8"
                            Padding="8,10"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnNew"
                                    Content="جديد"
                                    Tag="➕"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="{StaticResource BtnNewGradient}"
                                    Margin="4,0"
                                    Click="btnNew_Click"
                                    ToolTip="إنشاء حساب جديد"/>

                            <Button x:Name="btnSave"
                                    Content="حفظ"
                                    Tag="💾"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="{StaticResource BtnSaveGradient}"
                                    Margin="4,0"
                                    Click="btnSave_Click"
                                    ToolTip="حفظ البيانات"/>

                            <Button x:Name="btnDelete"
                                    Content="حذف"
                                    Tag="🗑"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="{StaticResource BtnDeleteGradient}"
                                    Margin="4,0"
                                    Click="btnDelete_Click"
                                    ToolTip="حذف الحساب"/>

                            <Button x:Name="btnClose"
                                    Content="خروج"
                                    Tag="✖"
                                    Style="{StaticResource IconButtonStyle}"
                                    Background="{StaticResource BtnCloseGradient}"
                                    Margin="4,0"
                                    Click="btnClose_Click"
                                    ToolTip="إغلاق النافذة"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="XtraTabPage2"
                     Header="🔍  بحث"
                     Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F0F4FF"
                            Padding="12,0"
                            BorderBrush="#C5CAE9"
                            BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       x:Name="lblSeachName"
                                       Text="الاسم :"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,10,0"/>

                            <dxe:TextEdit x:Name="txtSeachName"
                                          Grid.Column="1"
                                          Style="{StaticResource InputTextStyle}"
                                          Margin="0,0,10,0"/>

                            <Button x:Name="btnSearch"
                                    Grid.Column="2"
                                    Content="🔍  بحث"
                                    FontFamily="Tahoma"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="{StaticResource BtnSearchGradient}"
                                    BorderThickness="0"
                                    Height="32"
                                    Padding="12,0"
                                    Cursor="Hand"
                                    Click="btnSearch_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <dxg:GridControl x:Name="GridControl1"
                                     Grid.Row="1"
                                     AutoGenerateColumns="None"
                                     FlowDirection="RightToLeft">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="GridView1"
                                           ShowGroupPanel="False"
                                           AutoWidth="False"/>
                        </dxg:GridControl.View>

                        <dxg:GridControl.Columns>

                            <dxg:GridColumn x:Name="ColRowNumber"
                                            Header="#"
                                            FieldName="RowNumber"
                                            Width="50"
                                            AllowEditing="False"/>

                            <dxg:GridColumn x:Name="Acc_Code"
                                            Header="كود الحساب"
                                            FieldName="Acc_Code"
                                            Width="110"
                                            AllowEditing="False"/>

                            <dxg:GridColumn x:Name="Acc_Name"
                                            Header="اسم الحساب"
                                            FieldName="Acc_Name"
                                            Width="220"
                                            AllowEditing="False"/>

                            <dxg:GridColumn x:Name="ColSelect"
                                            Header="عرض"
                                            FieldName="ColSelect"
                                            Width="80"
                                            AllowEditing="False">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📂 عرض"
                                                FontFamily="Tahoma"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Background="#3949AB"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Height="24"
                                                Padding="6,0"
                                                Tag="{Binding RowData.Row}"
                                                Click="RepositoryItemButtonEdit1_ButtonClick">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>

                        </dxg:GridControl.Columns>
                    </dxg:GridControl>

                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</dx:DXWindow>