<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.FrmSyncMQtt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="مزامنة البيانات"
    Width="620" Height="510"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#FFF8F0"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="UploadBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A63C3" Offset="0"/>
            <GradientStop Color="#213A7A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DownloadBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="SyncCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="BigBtn" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,12"
                Effect="{StaticResource CardShadow}">
            <TextBlock Text="🔄 إعدادات مزامنة البيانات"
                       Foreground="White"
                       FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ═══ Checkboxes Grid ═══ -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="16,12"
                Effect="{StaticResource CardShadow}"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="ckInventories"
                          Grid.Column="0" Grid.Row="0"
                          Content="🏪 مزامنة المستودعات"
                          Style="{StaticResource SyncCheckBox}"/>
                <CheckBox x:Name="ckBranches"
                          Grid.Column="1" Grid.Row="0"
                          Content="🏢 مزامنة الفروع"
                          Style="{StaticResource SyncCheckBox}"/>

                <CheckBox x:Name="ckgroups"
                          Grid.Column="0" Grid.Row="1"
                          Content="📂 مزامنة المجموعات"
                          Style="{StaticResource SyncCheckBox}"/>
                <CheckBox x:Name="ckunits"
                          Grid.Column="1" Grid.Row="1"
                          Content="📐 مزامنة الوحدات"
                          Style="{StaticResource SyncCheckBox}"/>

                <CheckBox x:Name="ckbanks"
                          Grid.Column="0" Grid.Row="2"
                          Content="🏦 مزامنة البنوك"
                          Style="{StaticResource SyncCheckBox}"/>
                <CheckBox x:Name="ckitems"
                          Grid.Column="1" Grid.Row="2"
                          Content="📦 مزامنة الأصناف"
                          Style="{StaticResource SyncCheckBox}"/>

                <CheckBox x:Name="ckboxes"
                          Grid.Column="0" Grid.Row="3"
                          Content="💰 مزامنة الصناديق"
                          Style="{StaticResource SyncCheckBox}"/>
                <CheckBox x:Name="ckEmp"
                          Grid.Column="1" Grid.Row="3"
                          Content="👨‍💼 مزامنة الموظفين"
                          Style="{StaticResource SyncCheckBox}"/>

                <CheckBox x:Name="ckclients"
                          Grid.Column="0" Grid.Row="4"
                          Content="👥 مزامنة العملاء والموردين"
                          Style="{StaticResource SyncCheckBox}"/>
                <CheckBox x:Name="ckaccounts"
                          Grid.Column="1" Grid.Row="4"
                          Content="📊 مزامنة الحسابات"
                          Style="{StaticResource SyncCheckBox}"/>

                <CheckBox x:Name="chkUser"
                          Grid.Column="0" Grid.Row="5"
                          Content="👤 مزامنة المستخدمين"
                          Style="{StaticResource SyncCheckBox}"/>
                <CheckBox x:Name="chkOffers"
                          Grid.Column="1" Grid.Row="5"
                          Content="🎁 مزامنة عروض"
                          Style="{StaticResource SyncCheckBox}"/>

                <CheckBox x:Name="chkPriceType"
                          Grid.Column="0" Grid.Row="6"
                          Content="💲 مزامنة الأسعار"
                          Style="{StaticResource SyncCheckBox}"
                          Visibility="Collapsed"/>
                <CheckBox x:Name="chkPaymentTypes"
                          Grid.Column="1" Grid.Row="6"
                          Content="💳 مزامنة طرق الدفع"
                          Style="{StaticResource SyncCheckBox}"
                          Visibility="Collapsed"/>

                <CheckBox x:Name="ChkAllsend"
                          Grid.Column="0" Grid.Row="7"
                          Content="📤 ترحيل العمليات"
                          Style="{StaticResource SyncCheckBox}"
                          Checked="ChkAllsend_CheckedChanged"
                          Unchecked="ChkAllsend_CheckedChanged"/>
            </Grid>
        </Border>

        <!-- ═══ Date Range (hidden by default) ═══ -->
        <Border Grid.Row="2"
                x:Name="pnlDateRange"
                Background="White"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,10"
                Visibility="Collapsed"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="Label1"
                           Text="من:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <dxe:DateEdit Grid.Column="1"
                              x:Name="txtFromDate"
                              Margin="0,0,16,0"
                              Height="30"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"/>
                <TextBlock Grid.Column="2"
                           x:Name="Label2"
                           Text="إلى:"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <dxe:DateEdit Grid.Column="3"
                              x:Name="txtToDate"
                              Height="30"
                              xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"/>
            </Grid>
        </Border>

        <!-- ═══ Action Buttons ═══ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button x:Name="btnDownloadData"
                    Content="☁️ تحميل البيانات"
                    Style="{StaticResource BigBtn}"
                    Background="{StaticResource DownloadBrush}"
                    Margin="0,0,20,0"
                    Click="btnDownloadData_Click"/>
            <Button x:Name="btnUploadData"
                    Content="📤 مشاركة البيانات"
                    Style="{StaticResource BigBtn}"
                    Background="{StaticResource UploadBrush}"
                    Click="btnUploadData_Click"/>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>