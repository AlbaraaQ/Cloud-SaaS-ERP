<Window x:Class="SmartAuditERP.Form_WPF.frmAccountSrchParent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="البحث عن حساب رئيسي" 
        Height="550" Width="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Gradients -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8E44AD" Offset="0"/>
            <GradientStop Color="#9B59B6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4F6F7" Offset="0"/>
            <GradientStop Color="#D7DBDD" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styles -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.2" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="15,15,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="📂" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="دليل الحسابات الرئيسية" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="btnClose" Content="✕" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="40" Height="40" Background="#E74C3C" Foreground="White" 
                            BorderThickness="0" FontSize="20" FontWeight="Bold" Margin="10,0"
                            Cursor="Hand" Click="btnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Filters) -->
                <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" BorderBrush="#BDC3C7" BorderThickness="0,0,1,0">
                    <StackPanel Margin="15">
                        <Label Content="تصفية المجموعة" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cmbMainAccount" Height="35" FontSize="13" Margin="0,0,0,20"
                                  SelectionChanged="cmbMainAccount_SelectionChanged"/>

                        <Label Content="كود الحساب" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtSrchCode" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"
                                 TextChanged="txtSrchCode_TextChanged" KeyDown="txtSrchCode_KeyDown"/>

                        <!-- Info Box -->
                        <Border Background="White" BorderBrush="#3498DB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ️ معلومات" FontWeight="Bold" Foreground="#2980B9" Margin="0,0,0,5"/>
                                <TextBlock Text="هذه القائمة تعرض الحسابات الرئيسية (الشجرة) فقط." 
                                           FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Add New Button -->
                        <Button x:Name="btnAddNewAccount" Content="➕ إضافة جديد" 
                                Background="#27AE60" Foreground="White" Height="45" Margin="0,0,0,20"
                                FontWeight="Bold" FontSize="13" Cursor="Hand"
                                Click="btnAddNewAccount_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Main Grid Area -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Row="0" Margin="15,15,15,10" Padding="10" Background="#ECF0F1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="🔎 اسم الحساب:" Style="{StaticResource ModernLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="txtSrchNm" Style="{StaticResource ModernTextBox}" 
                                     Margin="10,0,0,0" TextChanged="txtSrchNm_TextChanged" KeyDown="txtSrchNm_KeyDown"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <Border Grid.Row="1" Margin="15,0,15,15" Background="White" CornerRadius="8">
                        <DataGrid x:Name="dgvAccounts" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" AlternatingRowBackground="#F8F9FA"
                                  RowHeight="45" SelectionMode="Single"
                                  SelectionChanged="dgvAccounts_SelectionChanged"
                                  MouseDoubleClick="dgvAccounts_MouseDoubleClick"
                                  KeyDown="dgvAccounts_KeyDown">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#8E44AD"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Height" Value="45"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الكود" Binding="{Binding Code}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#8E44AD"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="اسم الحساب الرئيسي" Binding="{Binding AName}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- عمود مخفي للبرمجة -->
                                <DataGridTextColumn Header="ParentCode" Binding="{Binding ParentCode}" Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>