<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.FrmIntialRestraiction"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="الرصيد الإفتتاحي"
    Width="1400" Height="680"
    MinWidth="1100" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B68EE" Offset="0"/>
            <GradientStop Color="#4B3DBF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ImportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0A500" Offset="0"/>
            <GradientStop Color="#C07800" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══ FieldLabel ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ═══ ModernTextBox ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox للرقم العام (لون مميز) -->
        <Style x:Key="GIDTextBox" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="#B22222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ═══ ModernComboBox ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ ModernDatePicker ═══ -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ ActionBtn ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="PrintBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>
        <Style x:Key="ImportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ImportBrush}"/>
        </Style>
        <Style x:Key="NavBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ═══ TabItem Style ═══ -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#D8E0F4"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Margin="2,0,2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{StaticResource HeaderBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ DataGrid (Search) ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ══════════════════════════════════════════════════════ -->
    <!--                   Main Layout                        -->
    <!-- ══════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--              TabControl                   -->
        <!-- ══════════════════════════════════════════ -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    Background="Transparent"
                    BorderThickness="0"
                    FlowDirection="RightToLeft"
                    SelectionChanged="TabControl1_SelectionChanged">

            <!-- ══ Tab 1: إضافة رصيد افتتاحي ══ -->
            <TabItem Header="📒 إضافة رصيد افتتاحي"
                     Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header Info -->
                        <RowDefinition Height="*"/>
                        <!-- Grid -->
                    </Grid.RowDefinitions>

                    <!-- ── معلومات القيد ── -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- الرقم العام -->
                            <TextBlock Grid.Column="0" Text="🔑 الرقم العام"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtEntryGID"
                                     Grid.Column="2"
                                     Style="{StaticResource GIDTextBox}"
                                     IsReadOnly="True"/>

                            <!-- الرقم -->
                            <TextBlock Grid.Column="4" Text="🔢 الرقم"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNo"
                                     Grid.Column="6"
                                     Style="{StaticResource GIDTextBox}"
                                     IsReadOnly="True"/>

                            <!-- التاريخ -->
                            <TextBlock Grid.Column="8" Text="📅 التاريخ"
                                       Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="txtDate"
                                        Grid.Column="10"
                                        Style="{StaticResource ModernDatePicker}"/>

                            <!-- البيان -->
                            <TextBlock Grid.Column="12" Text="📝 البيان"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNotes"
                                     Grid.Column="14"
                                     Grid.ColumnSpan="3"
                                     Height="32"
                                     Style="{StaticResource ModernTextBox}"
                                     AcceptsReturn="True"/>
                        </Grid>
                    </Border>

                    <!-- ── جدول القيود (DevExpress GridControl) ── -->
                    <Border Grid.Row="1"
                            Background="White"
                            Margin="6,4,6,4"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- عنوان الجدول -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 بنود القيد المحاسبي"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <!-- DevExpress GridControl -->
                            <dxg:GridControl x:Name="GridControl1"
                 Grid.Row="1"
                 FlowDirection="RightToLeft"
                 AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="GridView1"
                       AllowEditing="True"
                       ShowTotalSummary="False"
                       NewItemRowPosition="Bottom"
                       NavigationStyle="Row"
                       KeyDown="GridView1_KeyDown"
                       CellValueChanged="GridView1_CellValueChanged">
                                        <dxg:TableView.FormatConditions>
                                        </dxg:TableView.FormatConditions>
                                    </dxg:TableView>
                                </dxg:GridControl.View>

                                <dxg:GridControl.Columns>

                                    <dxg:GridColumn Header="#"
                        FieldName="AccRowIndex"
                        Width="52"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                    <dxg:GridColumn Header="رمز الحساب"
                        FieldName="AccCode"
                        Width="110"
                        HorizontalHeaderContentAlignment="Center"/>

                                    <dxg:GridColumn Header="اسم الحساب"
                        FieldName="AccName"
                        Width="300"
                        HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <dxe:TextEdit Grid.Column="0"
                                      EditValue="{Binding RowData.Row.AccName, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="1"
                                Content="🔍"
                                FontSize="11"
                                Background="{StaticResource HeaderBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="AccSearchBtn_Click"
                                Tag="{Binding RowData.Row}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>

                                    <dxg:GridColumn Header="مدين"
                        FieldName="AccDebit"
                        Width="110"
                        HorizontalHeaderContentAlignment="Center"/>

                                    <dxg:GridColumn Header="دائن"
                        FieldName="AccCredit"
                        Width="110"
                        HorizontalHeaderContentAlignment="Center"/>

                                    <dxg:GridColumn Header="مركز تكلفة"
                        FieldName="AccCostCenter"
                        Width="160"
                        HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:ComboBoxEdit
                        x:Name="cmbCostCenter"
                        EditValue="{Binding RowData.Row.AccCostCenter, UpdateSourceTrigger=PropertyChanged}"
                        DisplayMember="name"
                        ValueMember="code"
                        IsTextEditable="False"/>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>

                                    <dxg:GridColumn Header="المندوب"
                        FieldName="salesman"
                        Width="130"
                        HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <dxe:ComboBoxEdit
                        x:Name="cmbSalesman"
                        EditValue="{Binding RowData.Row.salesman, UpdateSourceTrigger=PropertyChanged}"
                        DisplayMember="name"
                        ValueMember="id"
                        IsTextEditable="False"/>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>

                                    <dxg:GridColumn Header="الشرح"
                        FieldName="AccDescription"
                        Width="280"
                        HorizontalHeaderContentAlignment="Center"/>

                                    <dxg:GridColumn Header="🗑️ حذف"
                        FieldName="DGVDelete"
                        Width="80"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️"
                            FontSize="14"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Tag="{Binding RowData.Row}"
                            Click="DeleteRowBtn_Click"/>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>

                                </dxg:GridControl.Columns>
                            </dxg:GridControl>
                            <!-- شريط الأرصدة -->
                            <Border Grid.Row="2"
                                    Background="#F0F4FF"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,6"
                                    CornerRadius="0,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="إجمالي المدين:"
                                               FontWeight="Bold"
                                               Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblDebitSum"
                                               Grid.Column="2"
                                               Text="0.00"
                                               FontWeight="Bold"
                                               Foreground="#1B8E4A"
                                               MinWidth="100"/>

                                    <TextBlock Grid.Column="4"
                                               Text="إجمالي الدائن:"
                                               FontWeight="Bold"
                                               Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblCreditSum"
                                               Grid.Column="6"
                                               Text="0.00"
                                               FontWeight="Bold"
                                               Foreground="#B92F2F"
                                               MinWidth="100"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ Tab 2: البحث ══ -->
            <TabItem Header="🔍 البحث"
                     Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط البحث -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- من تاريخ -->
                            <TextBlock Grid.Column="0" Text="📅 من"
                                       Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="txtFromDate"
                                        Grid.Column="2"
                                        Style="{StaticResource ModernDatePicker}"/>

                            <!-- إلى تاريخ -->
                            <TextBlock Grid.Column="4" Text="📅 إلى"
                                       Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="txtToDate"
                                        Grid.Column="6"
                                        Style="{StaticResource ModernDatePicker}"/>

                            <!-- رقم القيد -->
                            <TextBlock Grid.Column="8" Text="🔢 رقم القيد"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNoSrch"
                                     Grid.Column="10"
                                     Style="{StaticResource ModernTextBox}"
                                     TextAlignment="Center"/>

                            <!-- زر البحث -->
                            <Button x:Name="btnSearch"
                                    Grid.Column="12"
                                    Content="🔍 بحث"
                                    Style="{StaticResource ActionBtn}"
                                    Width="90"
                                    Click="btnSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- نتائج البحث -->
                    <Border Grid.Row="1"
                            Background="White"
                            Margin="6,4,6,4"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📄 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      BorderThickness="0"
                                      FlowDirection="RightToLeft"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="GlobalID"
                                                        Binding="{Binding GlobalID}"
                                                        Visibility="Collapsed"
                                                        Width="0"/>

                                    <DataGridTextColumn Header="🔢 رقم"
                                                        Binding="{Binding EntryNo}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="📅 تاريخ"
                                                        Binding="{Binding EntryDate}"
                                                        Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="📝 الملاحظة"
                                                        Binding="{Binding Notes}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════ -->
        <!--            Footer Buttons                 -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل + إغلاق -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">

                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="46"
                            ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>

                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>

                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>

                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>

                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <!-- استيراد / تصدير -->
                    <Button x:Name="btnExportData"
                            Content="📤 استيراد"
                            Style="{StaticResource ImportBtn}"
                            Width="90"
                            Margin="0,0,6,0"
                            ToolTip="استيراد بيانات من Excel"
                            Click="btnExportData_Click"/>

                    <Button x:Name="btnImportData"
                            Content="📥 تصدير"
                            Style="{StaticResource ImportBtn}"
                            Width="90"
                            Margin="0,0,6,0"
                            ToolTip="تصدير البيانات إلى Excel"
                            Click="btnImportData_Click"/>

                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            ToolTip="حذف القيد (F8)"
                            Click="btnDelete_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintBtn}"
                            Width="88"
                            Margin="0,0,6,0"
                            ToolTip="طباعة (F10)"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource PrintBtn}"
                            Width="90"
                            Margin="0,0,6,0"
                            Click="btnView_Click"/>

                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            ToolTip="حفظ (F6)"
                            Click="btnSave_Click"/>

                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            ToolTip="جديد (F12)"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>