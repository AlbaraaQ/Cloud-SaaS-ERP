<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvRptType"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="افتراضي الطباعة"
    Width="420" Height="190"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    FlowDirection="RightToLeft"
    Background="White"
    FontFamily="Cairo, Tahoma, Arial">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Border Background="White" Padding="24,20">
        <StackPanel>

            <!-- Title -->
            <TextBlock x:Name="Label1"
                       Text="🖨️ افتراضي طباعة الفواتير"
                       FontSize="13" FontWeight="Bold"
                       Foreground="#1B2642"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- Radio Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                <RadioButton x:Name="RadioButton1"
                             Content="📄 ورقة A4"
                             IsChecked="True"
                             FontSize="12" FontWeight="Bold"
                             Foreground="#213A7A"
                             Margin="0,0,30,0"
                             GroupName="PrintSize"/>

                <RadioButton x:Name="RadioButton2"
                             Content="🧾 ورق صغير"
                             FontSize="12" FontWeight="Bold"
                             Foreground="#213A7A"
                             GroupName="PrintSize"/>

            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button x:Name="Button1"
                        Content="💾 حفظ"
                        Style="{StaticResource SaveBtn}"
                        Margin="0,0,12,0"
                        Click="Button1_Click"/>

                <Button x:Name="Button2"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Click="Button2_Click"/>

            </StackPanel>

        </StackPanel>
    </Border>

</dx:ThemedWindow>