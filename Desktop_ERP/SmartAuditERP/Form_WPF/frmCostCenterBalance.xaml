<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCostCenterBalance"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v25.2"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تقرير مركز كلفة"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════ Brushes ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidePanelBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F8F9FD" Offset="0"/>
            <GradientStop Color="#EEF1F8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ShowButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3E66C9" Offset="0"/>
            <GradientStop Color="#244A9A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderBrushLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2642"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6D91"/>

        <!-- ═══════════ Effects ═══════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══════════ TextBox Style ═══════════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ ReadOnly TextBox ═══════════ -->
        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ═══════════ ComboBox Style ═══════════ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════ Label Style ═══════════ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════ Action Button ═══════════ -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowButton" TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource ShowButtonBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource DangerButtonBrush}"/>
        </Style>

        <!-- ═══════════ CheckBox Style ═══════════ -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════ RadioButton Style ═══════════ -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════ Section Header ═══════════ -->
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════ -->
    <!--              Main Layout Grid              -->
    <!-- ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Panel1 - Filter Side -->
            <ColumnDefinition Width="230"/>
            <!-- Splitter -->
            <ColumnDefinition Width="6"/>
            <!-- Panel2 - Grid Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--       LEFT PANEL (Panel1) - Filters        -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="0" Grid.Row="0"
                Background="{StaticResource SidePanelBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">

                    <!-- Title -->
                    <Border Style="{StaticResource SectionHeader}">
                        <TextBlock Text="🔍 خيارات البحث"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- ── مركز الكلفة ── -->
                    <TextBlock Text="🏢 مركز الكلفة"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbCostCenter"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,10"/>

                    <!-- ── نوع الرصيد ── -->
                    <Border Background="#EEF3FF"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📊 نوع الرصيد"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <RadioButton x:Name="rdAll"
                                             Content="الكل"
                                             Style="{StaticResource ModernRadioButton}"
                                             IsChecked="True"
                                             Margin="0,0,10,0"/>
                                <RadioButton x:Name="rdDebt"
                                             Content="مدين"
                                             Style="{StaticResource ModernRadioButton}"
                                             Margin="0,0,10,0"/>
                                <RadioButton x:Name="rdCredit"
                                             Content="دائن"
                                             Style="{StaticResource ModernRadioButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── الحساب ── -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkAll"
                                  Grid.Column="0"
                                  Content="الكل"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="True"
                                  Checked="chkAll_CheckedChanged"
                                  Unchecked="chkAll_CheckedChanged"
                                  Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="اسم الحساب"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ComboBox x:Name="cmbAccounts"
                              Style="{StaticResource ModernComboBox}"
                              IsEnabled="False"
                              IsEditable="True"
                              KeyDown="cmbAccounts_KeyDown"
                              PreviewMouseLeftButtonDown="cmbAccounts_Click"
                              Margin="0,0,0,10"/>

                    <!-- ── الفرع ── -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkAllBranches"
                                  Grid.Column="0"
                                  Content="الكل"
                                  Style="{StaticResource ModernCheckBox}"
                                  Checked="chkAllBranches_CheckedChanged"
                                  Unchecked="chkAllBranches_CheckedChanged"
                                  Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="🌿 الفرع"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ComboBox x:Name="cmbBranches"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,10"/>

                    <!-- ── نوع القيد ── -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkEntryType"
                                  Grid.Column="0"
                                  Content="الكل"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="True"
                                  Checked="chkEntryType_CheckedChanged"
                                  Unchecked="chkEntryType_CheckedChanged"
                                  Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="📋 نوع القيد"
                                   Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ComboBox x:Name="cmbEntryType"
                              Style="{StaticResource ModernComboBox}"
                              IsEnabled="False"
                              SelectionChanged="cmbEntryType_SelectionChanged"
                              Margin="0,0,0,10"/>

                    <!-- ── نوع التقرير ── -->
                    <Border Background="#EEF3FF"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📑 نوع التقرير"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <RadioButton x:Name="btnAggre"
                                             Content="تجميعي"
                                             Style="{StaticResource ModernRadioButton}"
                                             IsChecked="True"
                                             Margin="0,0,12,0"/>
                                <RadioButton x:Name="btnDetails"
                                             Content="تفصيلي"
                                             Style="{StaticResource ModernRadioButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── عدم إظهار الرصيد السابق ── -->
                    <CheckBox x:Name="chkPrevbalance"
                              Content="عدم إظهار الرصيد السابق"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,10"/>

                    <!-- ── الفترة ── -->
                    <Border Background="#FFF8EE"
                            CornerRadius="8"
                            BorderBrush="#FFD080"
                            BorderThickness="1"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ckTotalPeriod"
                                          Grid.Column="0"
                                          Content="فترة كاملة"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"
                                          Checked="ckTotalPeriod_CheckedChanged"
                                          Unchecked="ckTotalPeriod_CheckedChanged"
                                          Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="📅 الفترة"
                                           Style="{StaticResource FieldLabel}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="من" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,3"/>
                            <DatePicker x:Name="txtDateFrom"
                                        Height="32"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        FlowDirection="LeftToRight"
                                        IsEnabled="False"
                                        Margin="0,0,0,6"/>

                            <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,3"/>
                            <DatePicker x:Name="txtDateTo"
                                        Height="32"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        FlowDirection="LeftToRight"
                                        IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ── زر العرض ── -->
                    <Button x:Name="btnShow"
                            Content="🔍 عرض"
                            Style="{StaticResource ShowButton}"
                            Height="42"
                            FontSize="14"
                            Margin="0,4,0,8"
                            Click="btnShow_Click"/>

                    <!-- ── أزرار تكبير/تصغير الخط ── -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnZoom"
                                Grid.Column="0"
                                Content="🔍➕"
                                Style="{StaticResource ActionButton}"
                                Height="32"
                                Click="btnZoom_Click"
                                ToolTip="تكبير الخط"/>
                        <Button x:Name="btnZoomOut"
                                Grid.Column="2"
                                Content="🔍➖"
                                Style="{StaticResource ActionButton}"
                                Height="32"
                                Click="btnZoomOut_Click"
                                ToolTip="تصغير الخط"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════ Splitter ═══════════ -->
        <GridSplitter Grid.Column="1" Grid.Row="0"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrushLight}"
                      ShowsPreview="True"/>

        <!-- ═══════════════════════════════════════════ -->
        <!--       RIGHT PANEL (Panel2) - Data Grid     -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="2" Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="0"
                Margin="0,8,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Grid Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0"
                        Padding="14,8">
                    <TextBlock Text="📊 كشف مركز الكلفة"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"/>
                </Border>

                <!-- DevExpress Grid -->
                <dxg:GridControl x:Name="GridControl1"
                                 Grid.Row="1"
                                 AutoGenerateColumns="None">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="GridView1"
                                       ShowGroupPanel="False"
                                       AutoWidth="False"
                                       AllowEditing="False"
                                       NavigationStyle="Row"
                                       AllowPerPixelScrolling="True"
                                       RowMinHeight="28"                                     
                                       EnableImmediatePosting="True"/>
                    </dxg:GridControl.View>

                    <dxg:GridControl.Columns>

                        <dxg:GridColumn FieldName="DgvRank"
                                        Header="م"
                                        Width="50"
                                        AllowEditing="False"
                                        AllowSorting="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn x:Name="DgvDept"
                                        FieldName="DgvDept"
                                        Header="💸 مدين"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                      DisplayFormat="n2"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn x:Name="DgvCredit"
                                        FieldName="DgvCredit"
                                        Header="💰 دائن"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                      DisplayFormat="n2"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvBalance"
                                        Header="⚖️ الرصيد"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                                      DisplayFormat="n2"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvBalanceStatus"
                                        Header="📌 الحالة"
                                        Width="80"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvGenralNo"
                                        Header="🔢 الرقم العام"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvEntryNo"
                                        Header="📄 رقم السند"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvBranch"
                                        Header="🌿 الفرع"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvEntryType"
                                        Header="📋 النوع"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvDate"
                                        Header="📅 التاريخ"
                                        Width="100"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <dxg:GridColumn FieldName="DgvNote"
                                        Header="📝 البيان"
                                        Width="250"
                                        AllowEditing="False">
                            <dxg:GridColumn.EditSettings>
                                <dxe:MemoEditSettings/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>

                        <!-- زر التفاصيل -->
                        <dxg:GridColumn FieldName="BtnDetail"
                                        Header="تفاصيل"
                                        Width="80"
                                        AllowEditing="False">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔍"
                                            Height="26"
                                            Margin="2"
                                            Cursor="Hand"
                                            Click="BtnDetailCell_Click"
                                            Tag="{Binding Path=RowData.Row.DgvGenralNo}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#EEF3FF"/>
                                                <Setter Property="BorderBrush" Value="#C7D5F3"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#3A63C3"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                    </dxg:GridControl.Columns>
                </dxg:GridControl>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--       FOOTER PANEL (Panel3)                -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="0" Grid.Row="1"
                Grid.ColumnSpan="3"
                Background="{StaticResource FooterBrush}"
                Padding="12,8"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Buttons Right -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <!-- Menu Button -->
                    <Button x:Name="ToolStripDropDownButton1"
                            Width="36" Height="36"
                            Content="☰"
                            Foreground="White"
                            FontSize="16"
                            Margin="0,0,4,0"
                            ToolTip="خيارات">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource ActionButton}">
                                <Setter Property="Width" Value="36"/>
                            </Style>
                        </Button.Style>
                        <Button.ContextMenu>
                            <ContextMenu FlowDirection="RightToLeft">
                                <MenuItem x:Name="BtnSaveDgvSettings"
                                          Header="💾 حفظ المظهر"
                                          Click="BtnSaveDgvSettings_Click"/>
                                <MenuItem x:Name="BtnDefaultSetting"
                                          Header="🔄 إعادة الجدول الافتراضي"
                                          Click="BtnDefaultSetting_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerButton}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnClose_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionButton}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionButton}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnPreview_Click"/>

                    <Button x:Name="btnExportExcel"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ShowButton}"
                            Width="110"
                            Margin="0,0,6,0"
                            Click="btnExportExcel_Click"/>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Column="1"/>

                <!-- Totals Right -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">

                    <!-- إجمالي الفترة -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="📊 إجمالي الفترة المحددة"
                                   Style="{StaticResource HeaderLabel}"
                                   FontSize="10"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtTotDept"
                                     Grid.Column="0"
                                     Style="{StaticResource ReadOnlyTextBox}"
                                     ToolTip="إجمالي المدين"/>
                            <TextBox x:Name="txtTotCredit"
                                     Grid.Column="2"
                                     Style="{StaticResource ReadOnlyTextBox}"
                                     ToolTip="إجمالي الدائن"/>
                        </Grid>
                    </StackPanel>

                    <!-- رصيد الفترة -->
                    <StackPanel>
                        <TextBlock x:Name="lblBalance2"
                                   Text="⚖️ رصيد الفترة المحددة"
                                   Style="{StaticResource HeaderLabel}"
                                   FontSize="10"
                                   Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtBalance1"
                                     Grid.Column="0"
                                     Style="{StaticResource ReadOnlyTextBox}"
                                     ToolTip="رصيد مدين"/>
                            <TextBox x:Name="txtBalance2"
                                     Grid.Column="2"
                                     Style="{StaticResource ReadOnlyTextBox}"
                                     ToolTip="رصيد دائن"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>