<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSandSD"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="سندات صرف"
    Width="950" Height="650"
    MinWidth="860" MinHeight="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3FA8D5" Offset="0"/>
            <GradientStop Color="#1E7AA8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B5EA7" Offset="0"/>
            <GradientStop Color="#4D3278" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══ Label Style ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#213A7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ TextBox Style ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxMulti" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- ═══ ComboBox Style ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Button Styles ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
        </Style>

        <!-- ═══ DataGrid Styles ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#3A63C3"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ RadioButton Style ═══ -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- ═══ CheckBox Style ═══ -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ GroupBox-like Border ═══ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════ -->
    <!--                 Main Layout                 -->
    <!-- ═══════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    Margin="6,6,6,4"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12"
                    FontWeight="Bold">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,6"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </TabControl.Resources>

            <!-- ══════════════════════════════════════ -->
            <!--           TabPage1: سند صرف           -->
            <!-- ══════════════════════════════════════ -->
            <TabItem Header="📄 سند صرف">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ GroupBox3: بيانات السند الرئيسية ═══ -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardBorder}"
                            Margin="4,4,4,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7"
                                    Padding="10,5"
                                    Margin="0,0,0,8">
                                <TextBlock Text="📋 بيانات السند"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Fields Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: رقم السند + التاريخ + الوقت + الفرع -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="🔢 رقم السند" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNo"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="📅 التاريخ" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtDate"
                                                  Height="30"
                                                  FontSize="12"
                                                  DateTime="{Binding Path=SelectedDate, RelativeSource={RelativeSource Self}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="⏰ الوقت" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtTime"
                                             Style="{StaticResource ModernTextBox}"
                                             Text=""
                                             GotFocus="txtTime_GotFocus"
                                             LostFocus="txtTime_LostFocus"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="🏢 الفرع" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbBranches"
                                              Style="{StaticResource ModernComboBox}"
                                              IsEnabled="False"/>
                                </StackPanel>

                                <!-- Row 2: قيمة السند + الحساب + بحث + مركز التكلفة -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="💰 قيمة السند" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtVal"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🏦 دفعة لحساب" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbAccounts"
                                                  Style="{StaticResource ModernComboBox}"
                                                  KeyDown="cmbAccounts_KeyDown"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            x:Name="btnSearchAcc"
                                            Content="🔍"
                                            Style="{StaticResource ActionBtn}"
                                            Width="36"
                                            VerticalAlignment="Bottom"
                                            ToolTip="بحث عن حساب"
                                            Click="btnSearchAcc_Click"/>
                                </Grid>

                                <StackPanel Grid.Row="2" Grid.Column="6">
                                    <TextBlock Text="📊 مركز التكلفة" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbCostCenter"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <!-- Row 4: رقم المرجع + تاريخ المرجع + المحرر -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="📎 رقم المرجع" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtRef"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="📅 تاريخ المرجع" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtRefDate"
                                                  Height="30"
                                                  FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="4">
                                    <TextBlock Text="👤 المحرر" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="Editereciept"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="Red"
                                               VerticalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="6">
                                    <TextBlock Text="💵 المستلم" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtRecived"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <!-- Row 6: نوع الدفع -->
                                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7"
                                            Orientation="Horizontal">
                                    <TextBlock Text="💳 نوع الدفع:" Style="{StaticResource SectionLabel}"
                                               Margin="0,0,16,0"/>
                                    <RadioButton x:Name="rdCash"
                                                 Content="💵 نقدي"
                                                 Style="{StaticResource ModernRadio}"
                                                 IsChecked="True"
                                                 Checked="rdCash_Checked"/>
                                    <RadioButton x:Name="rdCheck"
                                                 Content="🏦 تحويل بنكي"
                                                 Style="{StaticResource ModernRadio}"
                                                 Checked="rdCheck_Checked"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ═══ GroupBox5: تفاصيل الدفع ═══ -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorder}"
                            Margin="4,0,4,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7"
                                    Padding="10,5"
                                    Margin="0,0,0,8">
                                <TextBlock Text="💼 تفاصيل الدفع"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- يصرف من حساب + الموظف + البيان -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="🏧 يصرف من حساب" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbPayFrom"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="👔 الموظف / المندوب" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbSalesMan"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="📝 البيان" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNotes"
                                             Style="{StaticResource ModernTextBoxMulti}"/>
                                </StackPanel>

                                <!-- Panel1: بيانات الشيك/التحويل البنكي -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                        x:Name="Panel1"
                                        Background="#F0F4FF"
                                        BorderBrush="#B0BFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🔢 رقم الشيك" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtCheckNo"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="📅 تاريخ الاستحقاق" Style="{StaticResource FieldLabel}"/>
                                            <dxe:DateEdit x:Name="txtCheckDate"
                                                          Height="30"
                                                          FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="🏦 مسحوب على بنك" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtBankCheck"
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="📋 حالة الشيك" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbCheckType"
                                                      Style="{StaticResource ModernComboBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- قيمة الدولار -->
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="💵 قيمة السند (دولار)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtValD"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ═══ شريط الأزرار (TabPage1) ═══ -->
                    <Border Grid.Row="2"
                            Background="{StaticResource FooterBrush}"
                            FlowDirection="LeftToRight"
                            Padding="10,7"
                            CornerRadius="0,0,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- أزرار التنقل + الإغلاق -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="btnClose"
                                        Content="✖"
                                        Style="{StaticResource DangerBtn}"
                                        Width="38"
                                        ToolTip="إغلاق"
                                        Margin="0,0,4,0"
                                        Click="btnClose_Click"/>
                                <Button x:Name="btnFirst"
                                        Content="⏮"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="الأول"
                                        Margin="0,0,3,0"
                                        Click="btnFirst_Click"/>
                                <Button x:Name="btnPrevious"
                                        Content="◀"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="السابق"
                                        Margin="0,0,3,0"
                                        Click="btnPrevious_Click"/>
                                <Button x:Name="btnNext"
                                        Content="▶"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="التالي"
                                        Margin="0,0,3,0"
                                        Click="btnNext_Click"/>
                                <Button x:Name="btnLast"
                                        Content="⏭"
                                        Style="{StaticResource NavBtn}"
                                        ToolTip="الأخير"
                                        Margin="0,0,4,0"
                                        Click="btnLast_Click"/>
                            </StackPanel>

                            <!-- أزرار العمليات -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnImportDocument"
                                        Content="📂 إرفاق"
                                        Style="{StaticResource PurpleBtn}"
                                        Width="80"
                                        Margin="0,0,4,0"
                                        ToolTip="إرفاق مستند"
                                        Click="BtnImportDocument_Click"/>
                                <Button x:Name="Btnshowdocument"
                                        Content="👁️ مستندات"
                                        Style="{StaticResource InfoBtn}"
                                        Width="90"
                                        Margin="0,0,4,0"
                                        ToolTip="عرض المستندات"
                                        Click="Btnshowdocument_Click"/>
                                <Button x:Name="btnView"
                                        Content="👁️ معاينة"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80"
                                        Margin="0,0,4,0"
                                        Click="btnView_Click"/>
                                <Button x:Name="btnPrint"
                                        Content="🖨️ طباعة"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80"
                                        Margin="0,0,4,0"
                                        Click="btnPrint_Click"/>
                                <Button x:Name="btnDelete"
                                        Content="🗑️ حذف"
                                        Style="{StaticResource DangerBtn}"
                                        Width="74"
                                        Margin="0,0,4,0"
                                        Click="btnDelete_Click"/>
                                <Button x:Name="btnSave"
                                        Content="💾 حفظ"
                                        Style="{StaticResource SaveBtn}"
                                        Width="74"
                                        Margin="0,0,4,0"
                                        Click="btnSave_Click"/>
                                <Button x:Name="btnNew"
                                        Content="➕ جديد"
                                        Style="{StaticResource ActionBtn}"
                                        Width="74"
                                        Click="btnNew_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════ -->
            <!--           TabPage2: البحث             -->
            <!-- ══════════════════════════════════════ -->
            <TabItem Header="🔍 البحث">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ GroupBox6: معايير البحث ═══ -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardBorder}"
                            Margin="4,4,4,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7"
                                    Padding="10,5"
                                    Margin="0,0,0,8">
                                <TextBlock Text="🔍 معايير البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: رقم السند + رقم المرجع -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="🔢 رقم السند" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchNo"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"
                                             PreviewTextInput="txtSrchNo_PreviewTextInput"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="📎 رقم المرجع" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchRef"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <!-- كل التواريخ -->
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="📅 من تاريخ" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtFromDate"
                                                  Height="30"
                                                  FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="📅 إلى تاريخ" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtToDate"
                                                  Height="30"
                                                  FontSize="12"/>
                                </StackPanel>

                                <!-- زر البحث -->
                                <Button Grid.Row="0" Grid.Column="8"
                                        x:Name="btnSearch"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80"
                                        VerticalAlignment="Bottom"
                                        Click="btnSearch_Click"/>

                                <!-- Row 2: عرض الكل -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal">
                                    <CheckBox x:Name="chkall"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="📋 عرض الكل"
                                              IsChecked="True"
                                              Checked="chkall_CheckedChanged"
                                              Unchecked="chkall_CheckedChanged"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ═══ GroupBox4: نتائج البحث ═══ -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardBorder}"
                            Margin="4,0,4,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="7,7,0,0"
                                    Padding="10,5"
                                    Margin="0,0,0,0">
                                <TextBlock Text="📊 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp"
                                      BorderThickness="0">
                                <DataGrid.Columns>

                                    <!-- GlobalId - مخفي -->
                                    <DataGridTextColumn Header="GlobalId"
                                                        Binding="{Binding GlobalId}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <!-- الرقم -->
                                    <DataGridTextColumn Header="🔢 الرقم"
                                                        Binding="{Binding ReceiptNo}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- التاريخ -->
                                    <DataGridTextColumn Header="📅 التاريخ"
                                                        Binding="{Binding ReceiptDate}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- المبلغ -->
                                    <DataGridTextColumn Header="💰 المبلغ"
                                                        Binding="{Binding Payment}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- مندوب المبيعات -->
                                    <DataGridTextColumn Header="👔 مندوب المبيعات"
                                                        Binding="{Binding SalesManName}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Status Bar ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="14,5">
            <TextBlock x:Name="lblStatus"
                       Text="جاهز"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

    </Grid>
</dx:ThemedWindow>