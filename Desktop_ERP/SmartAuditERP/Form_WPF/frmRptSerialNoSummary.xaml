<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptSerialNoSummary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="أرصدة الأرقام التسلسلية"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#17A2B8" Offset="0"/>
            <GradientStop Color="#117A8B" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="SidebarBg"  Color="#F0F2F8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E4E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="InfoBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#3A63C3"/>
        </Style>
        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF3FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ══ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,1,0"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">

                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                        <TextBlock Text="🔢 أرصدة الأرقام التسلسلية"
                                   Foreground="White" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- الفرع -->
                    <Border Background="White" CornerRadius="8" Padding="8"
                            Margin="0,0,0,8" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🏬 الفرع"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="chkAllBranch"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="chkAllBranch_CheckedChanged"
                                      Unchecked="chkAllBranch_CheckedChanged"/>
                            <ComboBox x:Name="cmbBranches"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- الصنف -->
                    <Border Background="White" CornerRadius="8" Padding="8"
                            Margin="0,0,0,8" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📦 الصنف"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="ckAllItems"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,6"
                                      Checked="ckAllItems_CheckedChanged"
                                      Unchecked="ckAllItems_CheckedChanged"/>
                            <TextBlock Text="اسم الصنف:"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtItemName"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         IsEnabled="False"/>
                                <Button Grid.Column="1" Content="🔍"
                                        Style="{StaticResource ActionBtn}"
                                        Height="30" Width="34" FontSize="14"
                                        Margin="2,0,0,0" IsEnabled="False"
                                        Click="btnSearch_Click"/>
                            </Grid>
                            <TextBlock Text="رمز الصنف:"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtItemCode"
                                     Style="{StaticResource ModernTextBox}"
                                     IsEnabled="False" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- الرقم التسلسلي -->
                    <Border Background="White" CornerRadius="8" Padding="8"
                            Margin="0,0,0,8" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🔢 الرقم التسلسلي"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,5"/>
                            <CheckBox x:Name="chkAllSeialNo"
                                      Content="الكل" IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0,0,0,4"
                                      Checked="chkAllSeialNo_CheckedChanged"
                                      Unchecked="chkAllSeialNo_CheckedChanged"/>
                            <TextBox x:Name="txtSeialNo"
                                     Style="{StaticResource ModernTextBox}"
                                     IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- خيار إظهار الموجود فقط -->
                    <Border Background="White" CornerRadius="8" Padding="10"
                            Margin="0,0,0,8" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1">
                        <CheckBox x:Name="chkShowOnlyExisting"
                                  Content="🔍 إظهار التسلسلات الموجودة فقط"
                                  Style="{StaticResource ModernCheckBox}"/>
                    </Border>

                    <Button x:Name="BtnShow"
                            Content="🔍 عرض الأرصدة"
                            Style="{StaticResource SaveBtn}"
                            Height="40" FontSize="13"
                            Margin="0,4,0,0"
                            Click="BtnShow_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ MAIN ══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    Margin="8,8,8,0" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="🔢 أرصدة الأرقام التسلسلية"
                                   Foreground="White" FontSize="13"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <DataGrid x:Name="GridControl1"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="م"
                                                Binding="{Binding DgvNo}"
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="📦 الصنف"
                                                Binding="{Binding ItemName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="رمز الصنف"
                                                Binding="{Binding ItemCode}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="🔢 التسلسل"
                                                Binding="{Binding ItemSerialNo}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="العدد"
                                                Binding="{Binding SerialQty, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="1"
                    Background="{StaticResource FooterBrush}"
                    FlowDirection="LeftToRight"
                    Padding="10,8" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnClose" Grid.Column="0"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="80" Click="btnClose_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnExportExcel"
                                Content="📊 تصدير Excel"
                                Style="{StaticResource SaveBtn}"
                                MinWidth="110" Margin="0,0,6,0"
                                Click="btnExportExcel_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource InfoBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPreview_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90" Click="btnPrint_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</dx:ThemedWindow>