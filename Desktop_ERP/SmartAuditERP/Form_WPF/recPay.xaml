<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.recPay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="طريقة الدفع"
    Width="500" Height="540"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize">

    <dx:ThemedWindow.Resources>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>

        <Style x:Key="PayBtn" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </dx:ThemedWindow.Resources>

    <Border Background="White" CornerRadius="12" Margin="8"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <!-- Visa -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- أجل لعميل (مخفي) -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- أجل للصالة (مخفي) -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- العميل (مخفي) -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- الصالة (مخفي) -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <!-- المطلوب + زر حفظ -->
            </Grid.RowDefinitions>

            <!-- العنوان -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="8" Padding="10,6">
                <TextBlock Text="💳 برجاء اختيار طريقة الدفع"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           FontFamily="Cairo, Tahoma, Arial"/>
            </Border>

            <!-- Visa -->
            <Button Grid.Row="2"
                    x:Name="Button1"
                    Content="💳 Visa"
                    Background="#1A3A7A"
                    Foreground="White"
                    Style="{StaticResource PayBtn}"
                    Click="Button1_Click"/>

            <!-- أجل لعميل (مخفي) -->
            <Button Grid.Row="4"
                    x:Name="Button2"
                    Content="👤 أجل لعميل"
                    Background="#2E7D32"
                    Foreground="White"
                    Style="{StaticResource PayBtn}"
                    Visibility="Collapsed"
                    Click="Button2_Click"/>

            <!-- أجل للصالة (مخفي) -->
            <Button Grid.Row="6"
                    x:Name="Button3"
                    Content="🏪 أجل للصالة"
                    Background="#E65100"
                    Foreground="White"
                    Style="{StaticResource PayBtn}"
                    Visibility="Collapsed"
                    Click="Button3_Click"/>

            <!-- اسم العميل (مخفي) -->
            <Grid Grid.Row="8" x:Name="pnlCustomer" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CustCB"
                          Grid.Column="0"
                          Height="30"
                          FontSize="12"
                          VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           x:Name="CustNameLB"
                           Text="👤 اسم العميل"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#1B2642"
                           VerticalAlignment="Center"
                           FontFamily="Cairo, Tahoma, Arial"/>
            </Grid>

            <!-- الصالة (مخفي) -->
            <Grid Grid.Row="10" x:Name="pnlTable" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TableCB"
                          Grid.Column="0"
                          Height="30"
                          FontSize="12"
                          VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           x:Name="TableNameLB"
                           Text="🏪 اختار الصالة"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#1B2642"
                           VerticalAlignment="Center"
                           FontFamily="Cairo, Tahoma, Arial"/>
            </Grid>

            <!-- المطلوب + زر الحفظ -->
            <Grid Grid.Row="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text=" : المطلوب "
                               FontSize="13" FontWeight="Bold"
                               Foreground="#213A7A"
                               VerticalAlignment="Center"
                               FontFamily="Cairo, Tahoma, Arial"/>
                    <TextBlock x:Name="MessageLB"
                               Text="اختار الصالة"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#B92F2F"
                               VerticalAlignment="Center"
                               FontFamily="Cairo, Tahoma, Arial"/>
                </StackPanel>

                <Button Grid.Row="2"
                        x:Name="Button4"
                        Content="💾 حفظ"
                        Background="#1B8E4A"
                        Foreground="White"
                        Style="{StaticResource PayBtn}"
                        Click="Button4_Click"/>
            </Grid>

        </Grid>
    </Border>
</dx:ThemedWindow>