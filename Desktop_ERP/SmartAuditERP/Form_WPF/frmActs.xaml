<Window x:Class="SmartAuditERP.Form_WPF.frmActs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تعريف مجالات العمل" 
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F6F7"
        WindowState="Maximized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Gradients -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4e54c8" Offset="0"/>
            <GradientStop Color="#8f94fb" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styles -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          VerticalAlignment="Center" 
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط الأدوات العلوي -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="0" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="15,0">

                <!-- زر جديد -->
                <Button x:Name="btnNew" Content="➕" Background="#4e54c8" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnNew_Click" ToolTip="جديد (Ctrl+N)"/>

                <!-- زر حفظ -->
                <Button x:Name="btnSave" Content="💾" Background="#27AE60" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnSave_Click" ToolTip="حفظ (Ctrl+S)"/>

                <!-- زر حذف -->
                <Button x:Name="btnDelete" Content="🗑️" Background="#E74C3C" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnDelete_Click" ToolTip="حذف (Delete)"/>

                <!-- زر طباعة -->
                <Button x:Name="btnPrint" Content="🖨️" Background="#9B59B6" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnPrint_Click" ToolTip="طباعة (Ctrl+P)"/>

                <!-- فاصل -->
                <Separator Width="2" Background="#D1D8E0" Margin="10,10"/>

                <!-- أزرار التنقل -->
                <Button x:Name="btnLast" Content="⏮️" Background="#34495E" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnLast_Click" ToolTip="الأخير"/>

                <Button x:Name="btnNext" Content="▶️" Background="#34495E" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnNext_Click" ToolTip="التالي"/>

                <Button x:Name="btnPrevious" Content="◀️" Background="#34495E" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnPrevious_Click" ToolTip="السابق"/>

                <Button x:Name="btnFirst" Content="⏭️" Background="#34495E" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnFirst_Click" ToolTip="الأول"/>

                <!-- فاصل -->
                <Separator Width="2" Background="#D1D8E0" Margin="10,10"/>

                <!-- زر إغلاق -->
                <Button x:Name="btnClose" Content="✖️" Background="#C0392B" 
                        Foreground="White" Style="{StaticResource IconButton}" 
                        Click="btnClose_Click" ToolTip="إغلاق (Esc)"/>

            </StackPanel>
        </Border>

        <!-- المحتوى الرئيسي -->
        <Border Grid.Row="1" Background="{StaticResource PanelGradient}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- منطقة الإدخال -->
                <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- العنوان مع أيقونة -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Label Content="مجال العمل" Style="{StaticResource ModernLabel}" FontSize="14"/>
                        </StackPanel>

                        <!-- حقل الإدخال -->
                        <TextBox x:Name="txtName" Grid.Column="1" 
                                 Style="{StaticResource ModernTextBox}" 
                                 KeyDown="txtName_KeyDown"
                                 MaxLength="200"/>
                    </Grid>
                </Border>

                <!-- جدول البيانات -->
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- عنوان الجدول -->
                        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" 
                                CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <TextBlock Text="📊 قائمة مجالات العمل المسجلة" 
                                       Foreground="White" FontSize="15" FontWeight="Bold" 
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- الجدول -->
                        <DataGrid x:Name="dgvActs" Grid.Row="1"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  Background="Transparent" 
                                  BorderThickness="0" 
                                  AlternatingRowBackground="#F9FBFD" 
                                  RowHeight="45"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="dgvActs_SelectionChanged"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2C3E50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="15,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <!-- الرقم - مخفي -->
                                <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="0" Visibility="Collapsed"/>

                                <!-- مجال العمل -->
                                <DataGridTextColumn Header="مجال العمل" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>