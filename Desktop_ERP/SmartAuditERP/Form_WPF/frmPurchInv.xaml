<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmPurchInv"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="فاتورة المشتريات"
    Width="1060" Height="760"
    MinWidth="1022" MinHeight="726"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="WhiteSmoke"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DarkSlateBrush" Color="#483D8B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══ Button Styles ═══ -->
        <Style x:Key="DarkSlateBtn" TargetType="Button">
            <Setter Property="Background"     Value="{StaticResource DarkSlateBrush}"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="FontFamily"     Value="Cairo, Tahoma"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Height"         Value="44"/>
            <Setter Property="Width"          Value="40"/>
            <Setter Property="Effect"         Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SavePrintBtn" TargetType="Button"
               BasedOn="{StaticResource DarkSlateBtn}">
            <Setter Property="Width"      Value="132"/>
            <Setter Property="Background" Value="{StaticResource DarkSlateBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource DarkSlateBtn}">
            <Setter Property="Background" Value="#C00000"/>
        </Style>

        <Style x:Key="GreenAddBtn" TargetType="Button">
            <Setter Property="Background"     Value="#C0FFC0"/>
            <Setter Property="Foreground"     Value="Green"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Width"          Value="25"/>
            <Setter Property="Height"         Value="25"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ TextBox Styles ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height"                 Value="24"/>
            <Setter Property="FontSize"               Value="11"/>
            <Setter Property="FontWeight"             Value="SemiBold"/>
            <Setter Property="Background"             Value="White"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment"          Value="Center"/>
        </Style>

        <Style x:Key="ReadOnlyTxt" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style x:Key="SummaryTxt" TargetType="TextBox"
               BasedOn="{StaticResource ReadOnlyTxt}">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height"     Value="26"/>
        </Style>

        <Style x:Key="RedTxt" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Foreground" Value="Firebrick"/>
        </Style>

        <!-- ═══ Label Style ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Foreground"       Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Foreground"       Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ ComboBox Style ═══ -->
        <Style x:Key="ModernCmb" TargetType="ComboBox">
            <Setter Property="Height"                 Value="24"/>
            <Setter Property="FontSize"               Value="11"/>
            <Setter Property="FontWeight"             Value="Bold"/>
            <Setter Property="Background"             Value="White"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BorderLight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ DataGrid Styles ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"              Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground"              Value="White"/>
            <Setter Property="FontWeight"              Value="Bold"/>
            <Setter Property="FontSize"                Value="10"/>
            <Setter Property="Height"                  Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                 Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F5F7FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontSize"            Value="10"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Tab Control -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--                  TabControl                         -->
        <!-- ═══════════════════════════════════════════════════ -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FlowDirection="RightToLeft"
                    FontSize="11">

            <!-- ════════════ Tab 1: الفاتورة ════════════ -->
            <TabItem Header="                الفاتورة                ">
                <Grid Background="WhiteSmoke">
                    <Grid.RowDefinitions>
                        <!-- GroupBox3: بيانات الفاتورة الرأسية -->
                        <RowDefinition Height="Auto"/>
                        <!-- GroupBox7: الجدول + شريط أدوات -->
                        <RowDefinition Height="*"/>
                        <!-- GroupBox9: ملخص + تفاصيل الصنف -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══════ GroupBox3 - بيانات الفاتورة ══════ -->
                    <Border Grid.Row="0"
                            Background="WhiteSmoke"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="4,4,4,2"
                            Padding="8,6"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- عمود 1: رقم + التاريخ + المرجع -->
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="8"/>
                                <!-- عمود 2: المستودع + المندوب + مركز التكلفة -->
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="8"/>
                                <!-- عمود 3: طريقة الدفع + الصندوق + البنك -->
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="8"/>
                                <!-- عمود 4: المورد + الرصيد -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <!-- بحث فاتورة -->
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>

                            <!-- ══ الصف 0: الرقم ══ -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="الرقم" Style="{StaticResource FieldLabel}" Width="50"/>
                                <TextBox x:Name="txtNo"
                                         Style="{StaticResource ReadOnlyTxt}"
                                         Width="80"
                                         Text="12"
                                         Background="Firebrick"
                                         Foreground="White"/>
                            </StackPanel>

                            <!-- ══ الصف 0: طريقة الدفع ══ -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="طريقة الدفع" Style="{StaticResource FieldLabel}" Width="70"/>
                                <ComboBox x:Name="cmbPayType"
                                          Style="{StaticResource ModernCmb}"
                                          Width="140"
                                          SelectionChanged="cmbPayType_SelectionChanged">
                                    <ComboBoxItem Content="آجلة"/>
                                    <ComboBoxItem Content="نقدية"/>
                                    <ComboBoxItem Content="بنك"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- ══ الصف 2: التاريخ ══ -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}" Width="50"/>
                                <DatePicker x:Name="txtDate"
                                            Height="24"
                                            Width="118"
                                            FontSize="11" FontWeight="Bold"
                                            SelectedDateFormat="Short"/>
                            </StackPanel>

                            <!-- ══ الصف 2: المستودع ══ -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="المستودع" Style="{StaticResource FieldLabel}" Width="70"/>
                                <ComboBox x:Name="cmbStore"
                                          Style="{StaticResource ModernCmb}"
                                          Width="140"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"/>
                            </StackPanel>

                            <!-- ══ الصف 2: الصندوق ══ -->
                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal">
                                <TextBlock Text="الصندوق" Style="{StaticResource FieldLabel}" Width="60"/>
                                <ComboBox x:Name="cmbTreasury"
                                          Style="{StaticResource ModernCmb}"
                                          Width="160"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"/>
                            </StackPanel>

                            <!-- ══ الصف 2: المورد ══ -->
                            <Grid Grid.Row="2" Grid.Column="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblClient"
                                           Grid.Column="0"
                                           Text="المورد"
                                           Style="{StaticResource FieldLabel}"
                                           Width="55"/>
                                <ComboBox x:Name="cmbClient"
                                          Grid.Column="1"
                                          Style="{StaticResource ModernCmb}"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"
                                          IsEditable="True"
                                          KeyDown="cmbClient_KeyDown"
                                          SelectionChanged="cmbClient_SelectionChanged"/>
                                <Button x:Name="btnCustAdd"
                                        Grid.Column="2"
                                        Content="➕"
                                        Style="{StaticResource GreenAddBtn}"
                                        Margin="4,0,0,0"
                                        ToolTip="إضافة مورد"
                                        Click="btnCustAdd_Click"/>
                                <TextBox x:Name="txtBalance"
                                         Grid.Column="3"
                                         Style="{StaticResource ReadOnlyTxt}"
                                         Margin="4,0,0,0"
                                         ToolTip="رصيد المورد"/>
                            </Grid>

                            <!-- ══ بحث فاتورة ══ -->
                            <Button x:Name="btnInvSrch"
                                    Grid.Row="0" Grid.RowSpan="3"
                                    Grid.Column="8"
                                    Content="🔍"
                                    Style="{StaticResource DarkSlateBtn}"
                                    Width="36" Height="44"
                                    Background="Transparent"
                                    Foreground="#404040"
                                    ToolTip="بحث فاتورة"
                                    Click="btnInvSrch_Click"/>

                            <!-- ══ الصف 4: رقم المرجع ══ -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="رقم المرجع" Style="{StaticResource FieldLabel}" Width="70"/>
                                <TextBox x:Name="txtRefNo"
                                         Style="{StaticResource ModernTextBox}"
                                         Width="94"/>
                            </StackPanel>

                            <!-- ══ الصف 4: المندوب ══ -->
                            <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="المندوب" Style="{StaticResource FieldLabel}" Width="52"/>
                                <ComboBox x:Name="cmbSalesMen"
                                          Style="{StaticResource ModernCmb}"
                                          Width="140"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"/>
                                <Button x:Name="cmbAddSalesMen"
                                        Content="➕"
                                        Style="{StaticResource GreenAddBtn}"
                                        Margin="4,0,0,0"
                                        ToolTip="إضافة مندوب"
                                        Click="cmbAddSalesMen_Click"/>
                            </StackPanel>

                            <!-- ══ الصف 4: البنك ══ -->
                            <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal">
                                <TextBlock x:Name="lblBank"
                                           Text="البنك"
                                           Style="{StaticResource FieldLabel}"
                                           Width="40"/>
                                <ComboBox x:Name="cmbBanks"
                                          Style="{StaticResource ModernCmb}"
                                          Width="180"
                                          IsEnabled="False"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"/>
                            </StackPanel>

                            <!-- ══ الصف 6: تاريخ المرجع ══ -->
                            <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="تاريخ المرجع" Style="{StaticResource FieldLabel}" Width="70"/>
                                <DatePicker x:Name="txtRefDate"
                                            Height="24"
                                            Width="110"
                                            FontSize="11" FontWeight="Bold"
                                            SelectedDateFormat="Short"
                                            IsEnabled="False"/>
                            </StackPanel>

                            <!-- ══ الصف 6: مركز التكلفة ══ -->
                            <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal">
                                <TextBlock x:Name="lblCostCenter"
                                           Text="مركز التكلفة"
                                           Style="{StaticResource FieldLabel}"
                                           Width="70"/>
                                <ComboBox x:Name="cmbCostCenter"
                                          Style="{StaticResource ModernCmb}"
                                          Width="100"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="code"/>
                                <Button x:Name="addCostCenter"
                                        Content="➕"
                                        Style="{StaticResource GreenAddBtn}"
                                        Margin="4,0,0,0"
                                        ToolTip="إضافة مركز تكلفة"
                                        Click="addCostCenter_Click"/>
                            </StackPanel>

                            <!-- ══ الصف 6: البيان ══ -->
                            <StackPanel Grid.Row="6" Grid.Column="4"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal">
                                <TextBlock Text="البيان" Style="{StaticResource FieldLabel}" Width="40"/>
                                <TextBox x:Name="txtNote"
                                         Style="{StaticResource ModernTextBox}"
                                         Width="350"
                                         FontSize="13" FontWeight="Bold"
                                         TextAlignment="Center"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- ══════ GroupBox7 - الجدول ══════ -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="4,2,4,2"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- شريط أدوات الجدول -->
                                <RowDefinition Height="Auto"/>
                                <!-- الجدول -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- شريط أدوات الجدول -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="6,6,0,0"
                                    Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- نوع الإدخال -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="White" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="rdNormal"
                                                             Content="عادي"
                                                             IsChecked="True"
                                                             FontSize="11" FontWeight="Bold"
                                                             Foreground="#1B2642"
                                                             Margin="0,0,8,0"/>
                                                <RadioButton x:Name="rdAuto"
                                                             Content="تلقائي"
                                                             FontSize="11" FontWeight="Bold"
                                                             Foreground="#1B2642"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- بدون ضريبة -->
                                        <Border Background="White" CornerRadius="4" Padding="6,2">
                                            <CheckBox x:Name="ckZeroVAT"
                                                      Content="بدون ضريبة"
                                                      FontSize="11" FontWeight="Bold"
                                                      Foreground="#1B2642"
                                                      Checked="ckZeroVAT_CheckedChanged"
                                                      Unchecked="ckZeroVAT_CheckedChanged"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- الباركود -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0">
                                        <TextBlock Text="باركود:"
                                                   Foreground="White"
                                                   FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtBarcode"
                                                 Width="300"
                                                 Height="24"
                                                 FontSize="11" FontWeight="Bold"
                                                 TextAlignment="Center"
                                                 Background="LightGray"
                                                 KeyDown="txtBarcode_KeyDown"/>
                                    </StackPanel>

                                    <!-- بحث نصي -->
                                    <TextBox x:Name="txtSrchDgv"
                                             Grid.Column="3"
                                             Width="100" Height="24"
                                             FontSize="11"
                                             VerticalContentAlignment="Center"
                                             Margin="6,0"
                                             TextChanged="txtSrchDgv_TextChanged"/>

                                    <!-- إضافة صنف -->
                                    <Button x:Name="btnAddNewItem"
                                            Grid.Column="4"
                                            Content="➕ صنف"
                                            Style="{StaticResource GreenAddBtn}"
                                            Width="60" Height="26"
                                            FontSize="11"
                                            Margin="4,0"
                                            Click="btnAddNewItem_Click"/>

                                    <!-- إضافة صف -->
                                    <Button Grid.Column="5"
                                            Content="➕ سطر"
                                            Style="{StaticResource GreenAddBtn}"
                                            Width="60" Height="26"
                                            FontSize="11"
                                            Margin="4,0"
                                            Click="btnAddRow_Click"/>
                                </Grid>
                            </Border>

                            <!-- الجدول الرئيسي -->
                            <DataGrid x:Name="GridControl1"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      CanUserReorderColumns="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      AlternationCount="2"
                                      SelectionChanged="GridControl1_SelectionChanged"
                                      CellEditEnding="GridControl1_CellEditEnding">
                                <DataGrid.Columns>

                                    <DataGridTextColumn x:Name="ColNo"
                                                        Header="#"
                                                        Binding="{Binding No}"
                                                        Width="40" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColItemCode"
                                                        Header="رمز الصنف"
                                                        Binding="{Binding ItemCodeDgv, UpdateSourceTrigger=LostFocus}"
                                                        Width="83">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColItemId"
                                                        Header="رقم الصنف"
                                                        Binding="{Binding ItemIdDgv}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColItemName"
                                                        Header="الصنف"
                                                        Binding="{Binding ItemNameDgv, UpdateSourceTrigger=LostFocus}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColDesc"
                                                        Header="الوصف"
                                                        Binding="{Binding DescriptionDgv}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColBarcode"
                                                        Header="الباركود"
                                                        Binding="{Binding barcodeDgv1}"
                                                        Width="43"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColUnit"
                                                        Header="الوحدة"
                                                        Binding="{Binding UnitDgv}"
                                                        Width="77"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColQuant"
                                                        Header="الكمية"
                                                        Binding="{Binding QuantDgv, UpdateSourceTrigger=LostFocus}"
                                                        Width="77">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColPercentUnit"
                                                        Header="التعادل"
                                                        Binding="{Binding PercentUnitDgv}"
                                                        Width="43"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColTotQuant"
                                                        Header="إجمالي الكمية"
                                                        Binding="{Binding totQuantDgv}"
                                                        Width="43"
                                                        IsReadOnly="True"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColPrice"
                                                        Header="السعر"
                                                        Binding="{Binding priceDgv, UpdateSourceTrigger=LostFocus}"
                                                        Width="77">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColSumPrice"
                                                        Header="المجموع"
                                                        Binding="{Binding SumPriceDgv}"
                                                        Width="77"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColAvgCost"
                                                        Header="متوسط التكلفة"
                                                        Binding="{Binding AvgCostDgv}"
                                                        Width="43"
                                                        IsReadOnly="True"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColDiscountVal"
                                                        Header="الخصم"
                                                        Binding="{Binding discountValDgv, UpdateSourceTrigger=LostFocus}"
                                                        Width="77">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColDiscountPer"
                                                        Header="نسبة الخصم"
                                                        Binding="{Binding discountPerDgv}"
                                                        Width="43"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColTotPrice"
                                                        Header="الإجمالي"
                                                        Binding="{Binding totPriceDgv}"
                                                        Width="43"
                                                        IsReadOnly="True"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColVatPer"
                                                        Header="نسبة الضريبة"
                                                        Binding="{Binding VatPerDgv}"
                                                        Width="43"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColVATVal"
                                                        Header="الضريبة"
                                                        Binding="{Binding VATValDgv}"
                                                        Width="77"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColNetVal"
                                                        Header="الصافي"
                                                        Binding="{Binding NetValDgv}"
                                                        Width="77"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColStock"
                                                        Header="الكمية الحالية"
                                                        Binding="{Binding StockDgv}"
                                                        Width="43"
                                                        IsReadOnly="True"
                                                        Visibility="Collapsed"/>

                                    <DataGridTextColumn x:Name="ColStore"
                                                        Header="المستودع"
                                                        Binding="{Binding StoreDgv}"
                                                        Width="98">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- زر حذف الصف -->
                                    <DataGridTemplateColumn Header="🗑️" Width="35">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️"
                                                        Tag="{Binding}"
                                                        Width="28" Height="22"
                                                        FontSize="11"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="BtnDeleteRow_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                                <!-- Context Menu -->
                                <DataGrid.ContextMenu>
                                    <ContextMenu FlowDirection="RightToLeft">
                                        <MenuItem Header="🔍 بحث مادة"      Click="StripItemSearch_Click"/>
                                        <MenuItem Header="📋 إستعراض المادة" Click="StripItemDetail_Click"/>
                                        <MenuItem Header="➕ إضافة مادة"     Click="StripAddNewItem_Click"/>
                                        <Separator/>
                                        <MenuItem Header="📦 الوحدات"        Click="StripItemUnits_Click"/>
                                        <MenuItem Header="🗂️ إضافة مجموعة"  Click="StripAddGroup_Click"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ حذف السجل"     Click="StripdeleteRow_Click"/>
                                        <Separator/>
                                        <MenuItem Header="🔄 حركة المادة"    Click="StripItemProcess_Click"/>
                                        <MenuItem Header="📊 اخر حركة للمادة" Click="StripItemLastActivity_Click"/>
                                        <MenuItem Header="👤 اخر حركة للعميل" Click="StripClientLastActivity_Click"/>
                                        <Separator/>
                                        <MenuItem Header="💲 تكلفة المادة"   Click="StripItemCost_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ══════ GroupBox9 - ملخص الفاتورة + تفاصيل الصنف ══════ -->
                    <Border Grid.Row="2"
                            Background="WhiteSmoke"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="4,2,4,2"
                            Padding="6,4"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- ملخص المبالغ -->
                                <ColumnDefinition Width="310"/>
                                <ColumnDefinition Width="8"/>
                                <!-- الخصم + نوع الإدخال -->
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="8"/>
                                <!-- تفاصيل الصنف الحالي -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <!-- إحصائيات -->
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <!-- ══ ملخص المبالغ ══ -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="المجموع :"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSumVal"
                                         Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource SummaryTxt}"
                                         Text="0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="الخصم :"
                                           Style="{StaticResource FieldLabel}"
                                           Foreground="Firebrick"/>
                                <TextBox x:Name="txtTotDiscount"
                                         Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource SummaryTxt}"
                                         Foreground="Firebrick"
                                         Text="0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="الضريبة :"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTotVAT"
                                         Grid.Row="4" Grid.Column="1"
                                         Style="{StaticResource SummaryTxt}"
                                         Text="0"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="الإجمالي :"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNetWithoutVAT"
                                         Grid.Row="6" Grid.Column="1"
                                         Style="{StaticResource SummaryTxt}"
                                         Text="0"/>
                            </Grid>

                            <!-- ══ الخصم + الصافي ══ -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="%" Foreground="Firebrick"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtInvDisc"
                                         Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource RedTxt}"
                                         Text="0"
                                         TextChanged="txtInvDisc_TextChanged"
                                         LostFocus="txtInvDiscVal_Leave"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="=" Foreground="Firebrick"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtInvDiscVal"
                                         Grid.Row="0" Grid.Column="3"
                                         Style="{StaticResource RedTxt}"
                                         Text="0"
                                         TextChanged="txtInvDiscVal_TextChanged"
                                         LostFocus="txtInvDiscVal_Leave"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="نسبة ض. الفاتورة"
                                           Style="{StaticResource SmallLabel}"/>
                                <TextBox x:Name="txtInvTaxPer"
                                         Grid.Row="2" Grid.Column="3"
                                         Style="{StaticResource ReadOnlyTxt}"
                                         Text="0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="الصافي"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="13"/>
                                <TextBox x:Name="txtNet"
                                         Grid.Row="4" Grid.Column="2"
                                         Grid.ColumnSpan="2"
                                         Style="{StaticResource SummaryTxt}"
                                         Text="0"
                                         FontSize="14"
                                         Background="#EEF7EE"/>

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="إدراج فاتورة"
                                           Style="{StaticResource SmallLabel}"
                                           Visibility="Collapsed"/>
                                <Button x:Name="btnInsertLinkedInv"
                                        Grid.Row="6" Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Content="إدراج"
                                        Style="{StaticResource DarkSlateBtn}"
                                        Width="80" Height="24"
                                        Visibility="Collapsed"
                                        Click="btnInsertLinkedInv_Click"/>
                            </Grid>

                            <!-- ══ تفاصيل الصنف الحالي ══ -->
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- آخر سعر شراء -->
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="آخر سعر شراء:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="80"/>
                                    <TextBox x:Name="txtRecentPurchPrice"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="90"/>
                                </StackPanel>

                                <!-- آخر سعر بيع -->
                                <StackPanel Grid.Row="0" Grid.Column="2"
                                            Orientation="Horizontal">
                                    <TextBlock Text="آخر سعر بيع:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="70"/>
                                    <TextBox x:Name="txtLastSalePrice"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="90"/>
                                </StackPanel>

                                <!-- متوسط التكلفة -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            Orientation="Horizontal">
                                    <TextBlock Text="متوسط التكلفة:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="80"/>
                                    <TextBox x:Name="txtCostAvrg"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="90"/>
                                </StackPanel>

                                <!-- سعر المنافس -->
                                <StackPanel Grid.Row="2" Grid.Column="2"
                                            Orientation="Horizontal">
                                    <TextBlock Text="سعر المنافس:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="70"/>
                                    <TextBox x:Name="txtCompetitorPrice"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="90"/>
                                </StackPanel>

                                <!-- الكمية الحالية -->
                                <StackPanel Grid.Row="4" Grid.Column="0"
                                            Orientation="Horizontal">
                                    <TextBlock x:Name="lblCurrentqty"
                                               Text="الكمية الحالية:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="80"/>
                                    <TextBox x:Name="txtStock"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="90"/>
                                </StackPanel>

                                <!-- الباركود -->
                                <StackPanel Grid.Row="4" Grid.Column="2"
                                            Orientation="Horizontal">
                                    <TextBlock Text="الباركود:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="70"/>
                                    <TextBox x:Name="txtItemBarcode"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="170"/>
                                </StackPanel>

                                <!-- التعادل -->
                                <StackPanel Grid.Row="6" Grid.Column="0"
                                            Orientation="Horizontal">
                                    <TextBlock x:Name="lblEqlUnit"
                                               Text="التعادل:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="80"/>
                                    <TextBox x:Name="txtPerUnit"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="90"/>
                                </StackPanel>

                                <!-- إجمالي الكمية × الوحدة -->
                                <StackPanel Grid.Row="6" Grid.Column="2"
                                            Orientation="Horizontal">
                                    <TextBlock x:Name="lblQtyPrice"
                                               Text="كمية و/س:"
                                               Style="{StaticResource SmallLabel}"
                                               Width="70"/>
                                    <TextBox x:Name="txtTotUnitQuan"
                                             Style="{StaticResource ReadOnlyTxt}"
                                             Width="90"/>
                                </StackPanel>
                            </Grid>

                            <!-- ══ إحصائيات ══ -->
                            <Grid Grid.Column="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="عدد البنود:"
                                           Style="{StaticResource SmallLabel}"/>
                                <TextBox x:Name="txtTirmsNo"
                                         Grid.Row="2"
                                         Style="{StaticResource ReadOnlyTxt}"
                                         Text="0"/>

                                <TextBlock x:Name="lblTotQty"
                                           Grid.Row="4"
                                           Text="إجمالي الكمية:"
                                           Style="{StaticResource SmallLabel}"/>
                                <TextBox x:Name="txtTotQuan"
                                         Grid.Row="6"
                                         Style="{StaticResource ReadOnlyTxt}"
                                         Text="0"/>
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- لوحة الأرقام (GroupBox5) - مخفية -->
                    <StackPanel Grid.Row="2" Visibility="Collapsed">
                        <TextBox x:Name="txtInvTax"    IsReadOnly="True" Text="0"/>
                        <TextBox x:Name="txtInvTaxPer2" IsReadOnly="True" Text="0" Visibility="Collapsed"/>
                    </StackPanel>

                </Grid>
            </TabItem>

            <!-- ════════════ Tab 2: البحث ════════════ -->
            <TabItem Header="                 البحث                  ">
                <Grid Background="WhiteSmoke">
                    <Grid.RowDefinitions>
                        <!-- GroupBox6: شروط البحث -->
                        <RowDefinition Height="Auto"/>
                        <!-- GroupBox4: نتائج البحث -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ══ GroupBox6: شروط البحث ══ -->
                    <Border Grid.Row="0"
                            Background="WhiteSmoke"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="4,4,4,2"
                            Padding="8,8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- من تاريخ -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="من تاريخ:" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,6,0"/>
                            <DatePicker x:Name="txtFromDate"
                                        Grid.Row="0" Grid.Column="1"
                                        Height="24" FontSize="11" FontWeight="Bold"
                                        SelectedDateFormat="Short"/>

                            <!-- الى تاريخ -->
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="الى تاريخ:" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,6,0"/>
                            <DatePicker x:Name="txtToDate"
                                        Grid.Row="0" Grid.Column="4"
                                        Height="24" FontSize="11" FontWeight="Bold"
                                        SelectedDateFormat="Short"/>

                            <!-- رقم الفاتورة -->
                            <TextBlock Grid.Row="0" Grid.Column="6"
                                       Text="رقم الفاتورة:" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtSrchNo"
                                     Grid.Row="0" Grid.Column="7"
                                     Style="{StaticResource ModernTextBox}"
                                     FontSize="12" FontWeight="Bold"
                                     Height="26"/>

                            <!-- رقم المرجع -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="رقم المرجع:" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtSrchreffNo"
                                     Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="24"/>

                            <!-- العميل -->
                            <TextBlock x:Name="lblClientSrch"
                                       Grid.Row="2" Grid.Column="3"
                                       Text="المورد:" Style="{StaticResource FieldLabel}"
                                       Margin="0,0,6,0"/>
                            <Grid Grid.Row="2" Grid.Column="4"
                                  Grid.ColumnSpan="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkAll"
                                          Grid.Column="0"
                                          Content="الكل"
                                          IsChecked="True"
                                          FontWeight="Bold" FontSize="11"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Checked="chkAll_CheckedChanged"
                                          Unchecked="chkAll_CheckedChanged"/>
                                <ComboBox x:Name="cmbClientSrch"
                                          Grid.Column="1"
                                          Style="{StaticResource ModernCmb}"
                                          IsEnabled="False"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"/>
                                <ComboBox x:Name="cmbProcTypeSrch" Visibility="Collapsed"/>
                            </Grid>

                            <!-- زر البحث -->
                            <Button x:Name="btnSearch"
                                    Grid.Row="0" Grid.RowSpan="3"
                                    Grid.Column="11"
                                    Content="🔍 البحث"
                                    Style="{StaticResource DarkSlateBtn}"
                                    Width="110" Height="71"
                                    Background="White"
                                    Foreground="Black"
                                    FontSize="12"
                                    Click="btnSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- ══ GroupBox4: نتائج البحث ══ -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="4,2,4,4"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="6,6,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>
                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#DDDDDD"
                                      AlternatingRowBackground="#F8F9FD"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      RowHeaderWidth="0"
                                      AlternationCount="2"
                                      MouseDoubleClick="dgvSrch_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="Column10"
                                                        Header="رقم الحركة"
                                                        Binding="{Binding ProcId}"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn x:Name="DataGridViewTextBoxColumn1"
                                                        Header="الرقم"
                                                        Binding="{Binding InvNo}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn x:Name="Column4"
                                                        Header="رقم المرجع"
                                                        Binding="{Binding ReffNo}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn x:Name="Column3"
                                                        Header="التاريخ"
                                                        Binding="{Binding InvDate}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn x:Name="Column1"
                                                        Header="المورد"
                                                        Binding="{Binding ClientName}"
                                                        Width="200">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--                  Footer Buttons                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <!-- قائمة الخيارات -->
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <!-- زر الخروج -->
                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖"
                        Style="{StaticResource DangerBtn}"
                        ToolTip="خروج"
                        Click="btnClose_Click"/>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="btnView"
                            Content="👁️"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="معاينة"
                            Margin="0,0,4,0"
                            Click="btnView_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="حذف"
                            Margin="0,0,4,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="طباعة"
                            Margin="0,0,4,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="حفظ"
                            Margin="0,0,4,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕"
                            Style="{StaticResource DarkSlateBtn}"
                            ToolTip="جديد"
                            Margin="0,0,4,0"
                            Click="btnNew_Click"/>
                    <Button x:Name="btnSavePrint"
                            Content="💾🖨️ حفظ مع طباعة"
                            Style="{StaticResource SavePrintBtn}"
                            ToolTip="حفظ مع طباعة"
                            Click="btnSavePrint_Click"/>
                </StackPanel>

                <!-- قائمة الخيارات -->
                <Button Grid.Column="6"
                        Content="⚙️"
                        Style="{StaticResource DarkSlateBtn}"
                        Width="30" Height="44"
                        FontSize="14"
                        ToolTip="خيارات"
                        Click="BtnSettings_Click">
                    <Button.ContextMenu>
                        <ContextMenu FlowDirection="RightToLeft">
                            <MenuItem x:Name="stripImport"
                                      Header="📥 استيراد"
                                      Click="stripImport_Click"/>
                            <MenuItem x:Name="stripExport"
                                      Header="📤 تصدير"
                                      Click="stripExport_Click"/>
                            <MenuItem x:Name="btnCustomizeDisplay"
                                      Header="🎨 تخصيص المظهر"
                                      Click="btnCustomizeDisplay_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>