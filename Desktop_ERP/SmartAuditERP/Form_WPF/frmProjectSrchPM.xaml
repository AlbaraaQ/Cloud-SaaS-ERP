<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmProjectSrchPM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="اختر مشروع"
    Width="680" Height="640"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    WindowStyle="None"
    ResizeMode="NoResize"
    Loaded="Window_Loaded"
    Deactivated="Window_Deactivated">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E35656"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖"
                        Style="{StaticResource CloseBtn}"
                        Click="btnClose_Click"/>

                <TextBlock Grid.Column="1"
                           Text="🔍 اختر مشروع"
                           Foreground="White"
                           FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- فلاتر البحث -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="12,10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- نوع المشروع -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="نوع المشروع:"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbgroups"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="name"
                              SelectedValuePath="id"
                              SelectionChanged="cmbgroups_SelectionChanged"/>
                </StackPanel>

                <!-- رقم المشروع -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="رقم المشروع:"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSrchCode"
                             Style="{StaticResource ModernTextBox}"
                             TextChanged="txtSrchCode_TextChanged"/>
                </StackPanel>

                <!-- اسم المشروع -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="اسم المشروع:"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSrchNm"
                             Style="{StaticResource ModernTextBox}"
                             TextChanged="txtSrchNm_TextChanged"/>
                </StackPanel>

                <!-- المقاول -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="المقاول:"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbContractor"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="name"
                              SelectedValuePath="id"
                              SelectionChanged="cmbContractor_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- جدول المشاريع -->
        <Border Grid.Row="2"
                Background="White"
                Margin="0">
            <DataGrid x:Name="dgvItems"
                      AutoGenerateColumns="False"
                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                      RowStyle="{StaticResource DgvRow}"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FlowDirection="RightToLeft"
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8EBF5"
                      AlternatingRowBackground="#F8F9FD"
                      MouseDoubleClick="dgvItems_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم"
                                        Binding="{Binding id}"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="اسم المشروع"
                                        Binding="{Binding name}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="النوع"
                                        Binding="{Binding Type}"
                                        Visibility="Collapsed"/>
                    <DataGridTextColumn Header="ContractorPk"
                                        Binding="{Binding ContractorPk}"
                                        Visibility="Collapsed"/>
                    <DataGridTextColumn Header="statusPk"
                                        Binding="{Binding statusPk}"
                                        Visibility="Collapsed"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</dx:ThemedWindow>