<Window x:Class="SmartAuditERP.Form_WPF.frmCloseShiftDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📊 تفاصيل الإغلاق اليومية"
        Width="1060"
        Height="660"
        MinWidth="860"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ═══════════ GRADIENTS ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#283593" Offset="0.5"/>
            <GradientStop Color="#3949AB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F5F7FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════ SHADOWS ═══════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Direction="270" Opacity="0.28"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="FieldShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.08"
                          Color="#44000000"/>

        <!-- ═══════════ READONLY TEXTBOX ═══════════ -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#EEF0FF"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Effect="{StaticResource FieldShadow}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ HIGHLIGHT TEXTBOX (قيم مهمة) ═══════════ -->
        <Style x:Key="HighlightTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ReadOnlyTextBoxStyle}">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="BorderBrush" Value="#A5D6A7"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
        </Style>

        <!-- ═══════════ WARNING TEXTBOX (الفرق) ═══════════ -->
        <Style x:Key="WarningTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ReadOnlyTextBoxStyle}">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="BorderBrush" Value="#FFCC80"/>
            <Setter Property="Foreground" Value="#E65100"/>
        </Style>

        <!-- ═══════════ LABEL ═══════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ═══════════ SECTION TITLE ═══════════ -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A237E"/>
        </Style>

        <!-- ═══════════ ACTION BUTTON ═══════════ -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="14,0"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#C62828"/>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#1565C0"/>
        </Style>

        <!-- ═══════════ WIN CLOSE ═══════════ -->
        <Style x:Key="WinCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ DATAGRID ═══════════ -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EAF6"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#283593"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C5CAE9"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self},
                             Path=AlternationIndex}" Value="1">
                    <Setter Property="Background" Value="#F8F9FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════ -->
    <!--               WINDOW BORDER                     -->
    <!-- ═══════════════════════════════════════════════ -->
    <Border CornerRadius="0"
            Background="{StaticResource CardBrush}"
            BorderBrush="#C5CAE9"
            BorderThickness="0"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── HEADER ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="22" Margin="8,0,0,0"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="تفاصيل الإغلاق اليومية"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="مراجعة وتأكيد بيانات إغلاق الوردية"
                                       Foreground="#9FA8DA"
                                       FontFamily="Tahoma"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WinCloseStyle}"
                            Click="BtnCancel_Click">
                        <TextBlock Text="✖"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ─── CONTENT ─── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════ -->
                <!--             SIDEBAR (يسار)             -->
                <!-- ══════════════════════════════════════ -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="#C5CAE9"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- معلومات المستخدم والوقت -->
                        <Border Grid.Row="0"
                                Background="#E8EAF6"
                                BorderBrush="#C5CAE9"
                                BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <StackPanel>

                                <!-- رقم الإغلاق / المستخدم -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="👤 المستخدم:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtUser"
                                                 Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="🔢 رقم الإغلاق:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtCloseNo"
                                                 Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- من / إلى -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📅 إلى:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtTo"
                                                 Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="📅 من:"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtFrom"
                                                 Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                 FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>

                        <!-- تفاصيل الإغلاق -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="14,10">
                            <StackPanel>

                                <!-- ─── قسم الصندوق ─── -->
                                <Border Background="#F5F7FF"
                                        BorderBrush="#C5CAE9"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,0,0,10"
                                        Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="🏦" FontSize="14" Margin="6,0,0,0"/>
                                            <TextBlock Text="بيانات الصندوق"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                        </StackPanel>

                                        <!-- صافي الصندوق -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="💰 صافي الصندوق:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtNetTreasury"
                                                     Style="{StaticResource HighlightTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- القيمة المدخلة -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="💵 القيمة المدخلة:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtCasherValue"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- فرق الصندوق -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="📉 فرق الصندوق:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtDiffVal"
                                                     Style="{StaticResource WarningTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- المصاريف -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="📤 المصاريف:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtExpenses"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- المشتريات -->
                                        <StackPanel>
                                            <TextBlock Text="🛒 المشتريات:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtPurch"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ─── قسم المبيعات ─── -->
                                <Border Background="#F5F7FF"
                                        BorderBrush="#C5CAE9"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,0,0,10"
                                        Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="📈" FontSize="14" Margin="6,0,0,0"/>
                                            <TextBlock Text="بيانات المبيعات"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                        </StackPanel>

                                        <!-- مبيعات النقدية -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="💵 مبيعات النقدية:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtCashSales"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- مرتجع مبيعات النقدية -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="↩️ مرتجع مبيعات النقدية:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtCashReSales"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- مبيعات الشبكة -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="🌐 مبيعات الشبكة:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtVisaSales"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- مبيعات الأجلة -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="📋 مبيعات الأجلة:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtCreditSales"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- مرتجع مبيعات الأجلة -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="↩️ مرتجع مبيعات الأجلة:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtCreditReSales"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- صافي المبيعات -->
                                        <StackPanel>
                                            <TextBlock Text="💹 صافي المبيعات:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtNetSales"
                                                     Style="{StaticResource HighlightTextBoxStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ─── قسم الضريبة والخصومات ─── -->
                                <Border Background="#F5F7FF"
                                        BorderBrush="#C5CAE9"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="🧾" FontSize="14" Margin="6,0,0,0"/>
                                            <TextBlock Text="الضريبة والخصومات"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                        </StackPanel>

                                        <!-- إجمالي الخصومات -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="🏷️ إجمالي الخصومات:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtDisc"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- صافي الصندوق بدون ضريبة -->
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="🏦 صافي الصندوق بدون ضريبة:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtNetTreasuryWithoutTax"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>

                                        <!-- إجمالي الضريبة -->
                                        <StackPanel>
                                            <TextBlock Text="📊 إجمالي الضريبة:"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtNetTax"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- أزرار الإجراءات -->
                        <Border Grid.Row="2"
                                Background="#E8EAF6"
                                BorderBrush="#C5CAE9"
                                BorderThickness="0,1,0,0"
                                Padding="14,12">
                            <StackPanel>

                                <!-- زر جلب البيانات (يظهر عند الاتصال) -->
                                <Button x:Name="Button1"
                                        Style="{StaticResource InfoButtonStyle}"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed"
                                        Click="Button1_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="جلب بيانات الإغلاق من الأندرويد"/>
                                    </StackPanel>
                                </Button>

                                <!-- إستمرار / إلغاء -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnSave"
                                            Grid.Column="0"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="btnSave_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✅" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="إستمرار"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnCancel"
                                            Grid.Column="2"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="BtnCancel_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="❌" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="إلغاء"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════ -->
                <!--        MAIN CONTENT (بيانات أندرويد)  -->
                <!-- ══════════════════════════════════════ -->
                <Grid Grid.Column="1" x:Name="androidPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Margin="8"
                            CornerRadius="10"
                            BorderBrush="#C5CAE9"
                            BorderThickness="1"
                            ClipToBounds="True"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>

                            <!-- Header -->
                            <Border Background="#3949AB" Padding="14,8">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="📱" FontSize="14" Margin="6,0,0,0"/>
                                    <TextBlock Text="بيانات الإغلاق من الأندرويد"
                                               Foreground="White"
                                               FontFamily="Tahoma"
                                               FontSize="13"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- DataGrid -->
                            <DataGrid x:Name="GridControl2"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      SelectionChanged="GridControl2_SelectionChanged">
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="م"
                                                        Binding="{Binding RowNum}"
                                                        Width="40">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="رقم الإغلاق"
                                                        Binding="{Binding CloseId}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="👤 المستخدم"
                                                        Binding="{Binding EmployeeName}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="📅 من تاريخ"
                                                        Binding="{Binding StartDate}"
                                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="📅 إلى تاريخ"
                                                        Binding="{Binding EndDate}"
                                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FlowDirection" Value="LeftToRight"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="💵 نقدي"
                                                        Binding="{Binding Cash}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#1B5E20"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="🌐 شبكة"
                                                        Binding="{Binding Visa}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="↩️ مرتجع"
                                                        Binding="{Binding ReturnCash}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#B71C1C"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="💹 صافي المبيعات"
                                                        Binding="{Binding NetTotal}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#1B5E20"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="🧾 عدد الفواتير"
                                                        Binding="{Binding CountInv}"
                                                        Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="عدد المرتجع"
                                                        Binding="{Binding CountInvReturn}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="القيمة المدخلة"
                                                        Binding="{Binding CashValue}"
                                                        Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="📉 الفرق"
                                                        Binding="{Binding Diff}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- زر تمت المطابقة -->
                                    <DataGridTemplateColumn Header="✔ تمت المطابقة"
                                                            Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✔ تمت المطابقة"
                                                        Height="26"
                                                        Padding="8,0"
                                                        Background="#00695C"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Click="BtnDon_Click"
                                                        HorizontalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#004D40"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>