<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.FrmSyncInv"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="المزامنة"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="50"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="14,0"
                Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="btnImportInv"
                        Content="📥 استيراد فواتير"
                        Style="{StaticResource TopBtn}"
                        Margin="0,0,10,0"
                        Click="btnImportInv_Click"/>
                <Button x:Name="btnAddAcc"
                        Content="🔄 مزامنة الفواتير"
                        Style="{StaticResource TopBtn}"
                        Click="btnAddAcc_Click"/>
            </StackPanel>
        </Border>

        <!-- ═══ Main Grid Area ═══ -->
        <Border Grid.Row="1"
                Background="White"
                Margin="8,6,8,8"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header الجدول الرئيسي -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="📋 الفواتير"
                               Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <!-- الجدول الرئيسي (Invoices) -->
                <DataGrid x:Name="GridControl1"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                          RowStyle="{StaticResource DgvRow}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          AlternatingRowBackground="#F8F9FD"
                          SelectionChanged="GridControl1_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الفاتورة"
                                            Binding="{Binding InvGlobalID}"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn Header="نوع الفاتورة"
                                            Binding="{Binding InvoiceName}"
                                            Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="التاريخ"
                                            Binding="{Binding Date}"
                                            Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الفرع"
                                            Binding="{Binding BranchId}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="نوع العملية"
                                            Binding="{Binding ProcType}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="👁️ تفاصيل" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁️ عرض"
                                            Tag="{Binding}"
                                            Padding="4,2"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Click="btnDetails_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="✏️ تعديل" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✏️ تعديل"
                                            Tag="{Binding}"
                                            Padding="4,2"
                                            Cursor="Hand"
                                            FontSize="11"
                                            Click="btnEdit_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Divider -->
                <Border Grid.Row="2"
                        Background="{StaticResource HeaderBrush}"
                        Height="34"
                        Margin="0,4,0,0">
                    <TextBlock Text="📦 تفاصيل الأصناف"
                               Foreground="White"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <!-- جدول التفاصيل (Items) -->
                <DataGrid x:Name="GridView2"
                          Grid.Row="3"
                          Height="200"
                          AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          AlternatingRowBackground="#F8F9FD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم الصنف"
                                            Binding="{Binding ProductName}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الكمية"
                                            Binding="{Binding Quantity}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="السعر"
                                            Binding="{Binding Price}"
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding Sum}"
                                            Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>