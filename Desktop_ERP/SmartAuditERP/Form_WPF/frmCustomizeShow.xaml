<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCustomizeShow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="🎨 تخصيص المظهر"
    Height="470" Width="700"
    MinHeight="430" MinWidth="650"
    MaxHeight="770" MaxWidth="1024"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    FontFamily="Tahoma"
    FontSize="13"
    ResizeMode="CanResizeWithGrip">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Gradient Brushes               -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Drop Shadows                   -->
        <!-- ═══════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#AAAAAA" Direction="270"
                          ShadowDepth="3" BlurRadius="8" Opacity="0.4"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          Color="#333333" Direction="270"
                          ShadowDepth="2" BlurRadius="5" Opacity="0.35"/>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Button Styles                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1976D2" Offset="0"/>
                        <GradientStop Color="#0D47A1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DefaultButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#546E7A" Offset="0"/>
                        <GradientStop Color="#37474F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--                  Root Layout                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--                  Header                     -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="15,0">
                <TextBlock Text="🎨" FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="تخصيص مظهر الجداول"
                           Foreground="White"
                           FontFamily="Tahoma"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Filter Panel                   -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#F5F7FA"
                BorderBrush="#D0D7DE"
                BorderThickness="0,0,0,1"
                Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Items Panel Option (مخفي افتراضياً) -->
                <Border Grid.Column="0"
                        x:Name="GpItemsGp"
                        Background="White"
                        BorderBrush="#B0BEC5"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Effect="{StaticResource CardShadow}">
                    <CheckBox x:Name="ckHideItemsPanel"
                              Content="🔲 إخفاء لوحة الأصناف والمجموعات"
                              FontFamily="Tahoma"
                              FontSize="12"
                              Foreground="#37474F"
                              Cursor="Hand"/>
                </Border>

                <!-- Table Selector -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock Text="📋 اختر الجدول:"
                               FontFamily="Tahoma"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#1A237E"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <dxe:ComboBoxEdit x:Name="cmbInv"
                                      Width="200"
                                      Height="32"
                                      IsTextEditable="False"
                                      NullText="اختر نوع الجدول...">
                        <dxe:ComboBoxEdit.Items>
                            <dxe:ComboBoxEditItem Content="فاتورة مشتريات"/>
                            <dxe:ComboBoxEditItem Content="فاتورة مبيعات"/>
                            <dxe:ComboBoxEditItem Content="نقطة البيع"/>
                            <dxe:ComboBoxEditItem Content="فاتورة بضاعة أول المدة"/>
                            <dxe:ComboBoxEditItem Content="فاتورة الإدخال والإخراج"/>
                        </dxe:ComboBoxEdit.Items>
                    </dxe:ComboBoxEdit>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Columns Grid                   -->
        <!-- ═══════════════════════════════════════════ -->
        <dxg:GridControl x:Name="dgvColumns"
                         Grid.Row="2"
                         Margin="10,8,10,0"
                         Effect="{StaticResource CardShadow}">
            <dxg:GridControl.Columns>

                <dxg:GridColumn x:Name="ColVisible"
                                Header="ظهور"
                                FieldName="IsVisible"
                                Width="70"
                                HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dxe:CheckEdit IsChecked="{Binding Value,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

                <dxg:GridColumn x:Name="ColNameAr"
                                Header="اسم العمود (عربي)"
                                FieldName="ColNameAr"
                                Width="200"
                                HorizontalHeaderContentAlignment="Center"/>

                <dxg:GridColumn x:Name="ColNameEn"
                                Header="اسم العمود (En)"
                                FieldName="ColNameEn"
                                Width="200"
                                AllowSorting="False"
                                HorizontalHeaderContentAlignment="Center"/>

                <dxg:GridColumn x:Name="ColWidth"
                                Header="عرض العمود"
                                FieldName="ColWidth"
                                Width="100"
                                AllowSorting="False"
                                HorizontalHeaderContentAlignment="Center"/>

                <dxg:GridColumn x:Name="ColFilled"
                                Header="إمتلاء"
                                FieldName="IsFilled"
                                Width="80"
                                HorizontalHeaderContentAlignment="Center">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <dxe:CheckEdit IsChecked="{Binding Value,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView x:Name="GridView1"
                               ShowGroupPanel="False"
                               AllowGrouping="False"
                               AutoWidth="False"
                               NavigationStyle="Row"
                               AllowPerPixelScrolling="True"/>
            </dxg:GridControl.View>
        </dxg:GridControl>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Footer Buttons                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource FooterGradient}"
                BorderBrush="#B0BEC5"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button x:Name="btnSave"
                        Content="✅ تنفيذ"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0"/>

                <Button x:Name="btnDefault"
                        Content="🔄 إعادة الافتراضي"
                        Style="{StaticResource DefaultButton}"
                        Margin="10,0"/>

            </StackPanel>
        </Border>

    </Grid>
</dx:ThemedWindow>