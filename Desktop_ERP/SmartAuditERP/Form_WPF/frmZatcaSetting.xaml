<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmZatcaSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="إعدادات الربط الضريبي"
    Width="820" Height="760"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="CanMinimize"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8A838" Offset="0"/>
            <GradientStop Color="#C07820" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Effect="{StaticResource CardShadow}">
                <TextBlock Text="⚙️ إعدادات الربط الضريبي - زاتكا ZATCA"
                           Foreground="White"
                           FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- ═══ Card 1: OTP + Activate + Mode ═══ -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- التاريخ -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="📅 التاريخ" Style="{StaticResource FieldLabel}"/>
                        <dxe:DateEdit x:Name="txtDate" Height="30"/>
                    </StackPanel>

                    <!-- OTP -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="🔑 OTP" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtOTP"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </StackPanel>

                    <!-- تفعيل + وضع الاتصال -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="chkActivate"
                                  Content="✅ تمكين Activate"
                                  IsChecked="True"
                                  FontWeight="Bold"
                                  Foreground="Red"
                                  Margin="0,0,0,6"/>
                        <CheckBox x:Name="chkSimulation"
                                  Content="🧪 Simulation تجريبي"
                                  FontWeight="Bold"
                                  Visibility="Collapsed"/>
                        <CheckBox x:Name="chkSyncManual"
                                  Content="Sync manual"
                                  Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- نوع الربط -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <RadioButton x:Name="rdProduction"
                                     Content="🔴 Production ربط فعلي"
                                     IsChecked="True"
                                     FontWeight="Bold"
                                     Foreground="Red"
                                     Margin="0,0,0,6"
                                     Checked="rdProduction_Checked"/>
                        <RadioButton x:Name="rdCompliance"
                                     Content="🔵 Compliance تجريبي"
                                     FontWeight="Bold"
                                     Checked="rdCompliance_Checked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Card 2: CSR Properties ═══ -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="6" Padding="10,6"
                            Margin="0,0,0,10">
                        <TextBlock Text="📋 خصائص شهادة CSR"
                                   Foreground="White" FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- زر تعبئة تلقائية -->
                    <Button x:Name="btngetData"
                            Content="🔄 تعبئة تلقائي"
                            Style="{StaticResource WarnBtn}"
                            Height="32" Width="160"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Click="btngetData_Click"/>

                    <!-- سريال الجهاز -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🖥️ Serial Number (سريال الجهاز)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtSerialNumber"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Country -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🌍 Country Name (الدولة)"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="txtCountryName"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True"
                                 Text="SA"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Common Name -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏢 Common Name (اسم المنشأة)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtCommonName"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Organization Identifier -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔢 Organization Identifier (الرقم الضريبي)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtOrganizationIdentifier"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Organization Name -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏭 Organization Name (اسم المنشأة)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtOrganizationName"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Invoice Type -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📄 Invoice Type (نوع الفواتير)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtInvoiceType"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True"
                                 Text="1100"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Industry -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏗️ Industry (النشاط التجاري)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtIndustry"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Organization Unit Name -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏬 Organization Unit (اسم الفرع)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtOrganizationUnitName"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Address -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📍 Address (العنوان المختصر)"
                                   Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="txtAddress"
                                 Style="{StaticResource ModernTextBox}"
                                 FlowDirection="LeftToRight"/>
                    </Grid>

                    <!-- Hidden fields for CSR/Private Key -->
                    <TextBox x:Name="txtCSR" Visibility="Collapsed"
                             IsReadOnly="True" AcceptsReturn="True"/>
                    <TextBox x:Name="txtPrivateKey" Visibility="Collapsed"
                             IsReadOnly="True" AcceptsReturn="True"/>
                    <TextBox x:Name="txtPath" Visibility="Collapsed"/>

                </StackPanel>
            </Border>

            <!-- ═══ Card 3: Action Buttons ═══ -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,10"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>

                    <!-- حفظ الإعدادات -->
                    <Button x:Name="btnSavePath"
                            Content="💾 حفظ الإعدادات — Save Settings"
                            Style="{StaticResource SaveBtn}"
                            Height="50"
                            FontSize="14"
                            Margin="0,0,0,8"
                            Click="btnSavePath_Click"/>

                    <!-- اختبار الربط -->
                    <Button x:Name="BtnComplianceInvoiceDebitNote"
                            Content="🧪 اختبار الربط — Test Compliance"
                            Style="{StaticResource WarnBtn}"
                            Height="40"
                            Margin="0,0,0,8"
                            Click="BtnComplianceInvoiceDebitNote_Click"/>

                    <!-- PCSID -->
                    <Button x:Name="btnPCSID"
                            Content="🔐 حفظ مفتاح التشفير — Get PCSID"
                            Style="{StaticResource ActionBtn}"
                            Height="44"
                            Margin="0,0,0,8"
                            Click="btnPCSID_Click"/>

                    <!-- تجديد الشهادة -->
                    <Button x:Name="BtnRenewsCSID"
                            Content="🔄 Renews CSID — تجديد الشهادة بعد 5 سنوات"
                            Style="{StaticResource ActionBtn}"
                            Height="40"
                            Margin="0,0,0,8"
                            Click="BtnRenewsCSID_Click"/>

                    <!-- توليد (مخفي بشكل افتراضي) -->
                    <Button x:Name="BtnGenerate"
                            Content="⚡ توليد — Generate"
                            Style="{StaticResource ActionBtn}"
                            Height="40"
                            Visibility="Collapsed"
                            Margin="0,0,0,8"
                            Click="BtnGenerate_Click"/>

                    <!-- الصف الأخير: Load Data + OnOff -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                x:Name="btnLoadData"
                                Content="☁️ Load Data"
                                Style="{StaticResource ActionBtn}"
                                Height="36"
                                Click="btnLoadData_Click"/>

                        <Button Grid.Column="2"
                                x:Name="BtnOnOff"
                                Content="⏸ إيقاف الربط"
                                Style="{StaticResource DangerBtn}"
                                Width="150" Height="36"
                                Visibility="Collapsed"
                                Click="BtnOnOff_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</dx:ThemedWindow>