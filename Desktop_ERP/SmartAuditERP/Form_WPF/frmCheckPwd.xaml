<Window x:Class="SmartAuditERP.Form_WPF.frmCheckPwd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🔒 صلاحيات"
        Width="340"
        Height="410"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <!-- ═══════════ GRADIENTS ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#212121" Offset="0"/>
            <GradientStop Color="#424242" Offset="0.5"/>
            <GradientStop Color="#616161" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FAFAFA" Offset="0"/>
            <GradientStop Color="#F5F5F5" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════ SHADOWS ═══════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Direction="270" Opacity="0.35"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="6" ShadowDepth="2"
                          Direction="270" Opacity="0.2"
                          Color="#44000000"/>

        <!-- ═══════════ PASSWORD BOX ═══════════ -->
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#424242"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ NUMPAD BUTTON ═══════════ -->
        <Style x:Key="NumPadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#616161"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#757575"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#424242"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ CLEAR BUTTON ═══════════ -->
        <Style x:Key="ClearButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NumPadButtonStyle}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Setter Property="FontSize" Value="18"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════ CHECK BUTTON ═══════════ -->
        <Style x:Key="CheckButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NumPadButtonStyle}">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════ WIN CLOSE ═══════════ -->
        <Style x:Key="WinCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════ WINDOW BORDER ═══════════ -->
    <Border CornerRadius="16"
            Background="{StaticResource CardBrush}"
            BorderBrush="#BDBDBD"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── HEADER ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="22" Margin="8,0,0,0"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="التحقق من الصلاحيات"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="15"
                                       FontWeight="Bold"/>
                            <TextBlock Text="أدخل كلمة المرور للمتابعة"
                                       Foreground="#BDBDBD"
                                       FontFamily="Tahoma"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WinCloseStyle}"
                            Click="btnClose_Click">
                        <TextBlock Text="✖"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ─── CONTENT ─── -->
            <Grid Grid.Row="1" Margin="16,14,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- حقل كلمة المرور -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="🔑 كلمة المرور"
                               FontFamily="Tahoma"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#424242"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtPass"
                                 Style="{StaticResource PasswordBoxStyle}"
                                 PreviewKeyDown="txtPass_PreviewKeyDown"/>
                </StackPanel>

                <!-- لوحة الأرقام -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- صف 7 8 9 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
            HorizontalAlignment="Center">
                        <Button x:Name="cmd7" Style="{StaticResource NumPadButtonStyle}"
            Content="7" Margin="2,0" Click="cmd7_Click"/>
                        <Button x:Name="cmd8" Style="{StaticResource NumPadButtonStyle}"
            Content="8" Margin="2,0" Click="cmd8_Click"/>
                        <Button x:Name="cmd9" Style="{StaticResource NumPadButtonStyle}"
            Content="9" Margin="2,0" Click="cmd9_Click"/>
                    </StackPanel>

                    <!-- صف 4 5 6 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
            HorizontalAlignment="Center">
                        <Button x:Name="cmd4" Style="{StaticResource NumPadButtonStyle}"
            Content="4" Margin="2,0" Click="cmd4_Click"/>
                        <Button x:Name="cmd5" Style="{StaticResource NumPadButtonStyle}"
            Content="5" Margin="2,0" Click="cmd5_Click"/>
                        <Button x:Name="cmd6" Style="{StaticResource NumPadButtonStyle}"
            Content="6" Margin="2,0" Click="cmd6_Click"/>
                    </StackPanel>

                    <!-- صف 1 2 3 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal"
            HorizontalAlignment="Center">
                        <Button x:Name="cmd135" Style="{StaticResource NumPadButtonStyle}"
            Content="1" Margin="2,0" Click="cmd135_Click"/>
                        <Button x:Name="cmd2"   Style="{StaticResource NumPadButtonStyle}"
            Content="2" Margin="2,0" Click="cmd2_Click"/>
                        <Button x:Name="cmd3"   Style="{StaticResource NumPadButtonStyle}"
            Content="3" Margin="2,0" Click="cmd3_Click"/>
                    </StackPanel>

                </Grid>

                <!-- صف 0 C تحقق -->
                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,187,0,-67" Grid.Row="2">
                    <Button x:Name="cmd0"       Style="{StaticResource NumPadButtonStyle}"
            Content="0" Margin="2,0" Click="cmd0_Click"/>
                    <Button x:Name="cmdClearAll" Style="{StaticResource ClearButtonStyle}"
            Margin="2,0" Click="cmdClearAll_Click">
                        <TextBlock Text="⌫" FontSize="20"/>
                    </Button>
                    <Button x:Name="CheckPwd" Style="{StaticResource CheckButtonStyle}"
            Margin="2,0" Click="CheckPwd_Click">
                        <TextBlock Text="✔ تحقق" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>