<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSentEinvoice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="الفواتير المرفوعة على موقع الضرائب"
    Width="1200" Height="700"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E67E22" Offset="0"/>
            <GradientStop Color="#CA6F1E" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8D8F8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="56"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Effect="{StaticResource CardShadow}">
            <TextBlock Text="🧾 الفواتير المرفوعة على موقع الضرائب"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       FontFamily="Cairo, Tahoma, Arial"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار العمليات - يسار -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <Button x:Name="SimpleButton5"
                            Content="🚫 إلغاء الفاتورة"
                            Style="{StaticResource DangerBtn}"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="SimpleButton5_Click"/>

                    <Button x:Name="SimpleButton4"
                            Content="❌ رفض الفاتورة"
                            Style="{StaticResource WarningBtn}"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="SimpleButton4_Click"/>

                    <Button x:Name="SimpleButton3"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            Margin="0,0,6,0"
                            Click="SimpleButton3_Click"/>

                    <Button x:Name="SimpleButton2"
                            Content="📄 بيانات الفاتورة"
                            Style="{StaticResource ActionBtn}"
                            Width="120"
                            Margin="0,0,6,0"
                            Click="SimpleButton2_Click"/>

                </StackPanel>

                <!-- UUID + publicUrl - وسط -->
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="UUID:"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="txt_UUID"
                             Grid.Row="1" Grid.Column="0"
                             Grid.ColumnSpan="2"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Grid.Row="0" Grid.Column="3"
                               Text="Public URL:"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="publicUrl"
                             Grid.Row="1" Grid.Column="3"
                             Grid.ColumnSpan="2"
                             Style="{StaticResource ModernTextBox}"/>
                </Grid>

                <!-- رقم الصفحة + حجم الصفحة + زر عرض - يمين -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="حجم الصفحة:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="pageSize"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="20"
                                 Width="80"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="رقم الصفحة:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="pageNo"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="1"
                                 Width="80"/>
                    </StackPanel>

                    <Button x:Name="SimpleButton1"
                            Content="🔍 عرض"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            VerticalAlignment="Bottom"
                            Click="SimpleButton1_Click"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ═══ DataGrid Card ═══ -->
        <Border Grid.Row="2"
                Background="White"
                Margin="8,6,8,6"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="📋 قائمة الفواتير المرفوعة"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"
                               FontFamily="Cairo, Tahoma, Arial"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <DataGrid x:Name="GridControl1"
                          Grid.Row="1"
                          AutoGenerateColumns="True"
                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                          RowStyle="{StaticResource DgvRow}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          AlternatingRowBackground="#F8F9FD"
                          BorderThickness="0"
                          RowHeaderWidth="0"
                          SelectionChanged="GridControl1_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="3"
                Background="{StaticResource FooterBrush}"
                Padding="14,0">
            <Grid>
                <TextBlock Text="📌 انقر على صف لتحديد UUID والرابط العام"
                           Foreground="White"
                           FontSize="11"
                           FontFamily="Cairo, Tahoma, Arial"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>