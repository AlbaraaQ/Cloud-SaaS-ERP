<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmMezanyaArba7"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="أرباح وخسائر حسابات رئيسية"
    Width="900"
    Height="730"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmMezanyaArba7_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#28A745" Offset="0"/>
            <GradientStop Color="#1C7C31" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F7CF7" Offset="0"/>
            <GradientStop Color="#305EDB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ViewBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#D98B10" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.13" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SummaryBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>

        <Style x:Key="ViewBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ViewBrush}"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCE7FF"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F4FF"/></Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="14,10">
            <TextBlock x:Name="lblHeader" Text="📊 أرباح وخسائر حسابات رئيسية" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="195"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>

                        <Border Background="{StaticResource HeaderBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <TextBlock Text="⚙️ خيارات البحث" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- الفترة الزمنية -->
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📅 الفترة" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox x:Name="ckTotalPeriod" Grid.Column="1" Content="كل الفترة" IsChecked="True" Style="{StaticResource ModernCheckBox}" Checked="ckTotalPeriod_CheckedChanged" Unchecked="ckTotalPeriod_CheckedChanged"/>
                                </Grid>
                                <TextBlock Text="من" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="txtFromDate" Style="{StaticResource ModernDatePicker}" IsEnabled="False" SelectedDateFormat="Short" Margin="0,0,0,6"/>
                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="txtToDate" Style="{StaticResource ModernDatePicker}" IsEnabled="False" SelectedDateFormat="Short" Margin="0,0,0,6"/>

                                <TextBlock Text="⏰ وقت البداية" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtStartTime" Height="30" FontSize="12" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center" IsEnabled="False" Text="00:00" FlowDirection="LeftToRight" Margin="0,0,0,6"/>
                                <TextBlock Text="⏰ وقت النهاية" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtEndTime" Height="30" FontSize="12" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" Padding="6,0" VerticalContentAlignment="Center" IsEnabled="False" Text="23:59" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>

                        <!-- الفرع -->
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="lblBranch" Text="🏢 الفرع" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox x:Name="ckAllBranches" Grid.Column="1" Content="الكل" IsChecked="True" Style="{StaticResource ModernCheckBox}" Checked="ckAllBranches_CheckedChanged" Unchecked="ckAllBranches_CheckedChanged"/>
                                </Grid>
                                <ComboBox x:Name="cmbBranches" Style="{StaticResource ModernComboBox}" DisplayMemberPath="name" SelectedValuePath="id" IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- زر المخزون -->
                        <Button x:Name="BtnStock" Content="📦 تحديد المخزون" Style="{StaticResource ActionBtn}" Height="36" Margin="0,0,0,10" Click="BtnStock_Click"/>

                        <!-- زر العرض -->
                        <Button x:Name="btnShow" Content="🔎 عرض" Style="{StaticResource ViewBtn}" Height="42" FontSize="14" Click="btnShow_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DataGrid -->
            <Border Grid.Column="1" Margin="6" Background="White" CornerRadius="10" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="10,10,0,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📋 أرباح وخسائر الحسابات الرئيسية" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="lblRowCount" Grid.Column="1" Text="عدد السجلات: 0" Foreground="#DCE7FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgvSrch"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource GridRowStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              AlternatingRowBackground="#F5F8FF"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E7ECF5"
                              Background="White">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="🔑 الحساب" Binding="{Binding Column1}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="📝 إسم الحساب" Binding="{Binding Column2}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="💰 رصيد مدين" Binding="{Binding Column5}" Width="130" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="💵 رصيد دائن" Binding="{Binding Column6}" Width="130" ElementStyle="{StaticResource GridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Summary Bar -->
        <Border Grid.Row="2" Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="0,1,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="إجمالي مدين:" FontWeight="Bold" Foreground="#1B2642" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtDeptDiff" Grid.Column="1" Style="{StaticResource SummaryBox}"/>

                <TextBlock Grid.Column="3" Text="إجمالي دائن:" FontWeight="Bold" Foreground="#1B2642" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtCreditDiff" Grid.Column="4" Style="{StaticResource SummaryBox}"/>

                <TextBox x:Name="txtIsBalanced" Grid.Column="6" Width="250" Style="{StaticResource SummaryBox}" Foreground="Red" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Footer: Buttons + ProgressBar -->
        <Border Grid.Row="3" Background="{StaticResource FooterBrush}" Padding="10,8" FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar x:Name="ProgressBar1" Grid.Row="0" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Foreground="#2CC36B" Background="#1D3268" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button x:Name="btnClose" Content="✖ خروج" Style="{StaticResource DangerBtn}" Width="90" Click="btnClose_Click"/>
                    <Button x:Name="btnExport" Content="📊 تصدير Excel" Style="{StaticResource ExportBtn}" Width="130" Click="btnExport_Click"/>
                    <Button x:Name="btnPrint" Content="🖨️ طباعة" Style="{StaticResource ActionBtn}" Width="90" Click="btnPrint_Click"/>
                    <Button x:Name="btnPreview" Content="👁️ معاينة" Style="{StaticResource ActionBtn}" Width="90" Click="btnPreview_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>