<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تقرير مشتريات تفصيلي"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0A500" Offset="0"/>
            <GradientStop Color="#C07800" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B68EE" Offset="0"/>
            <GradientStop Color="#4B3DBF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══ FieldLabel ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ═══ ModernTextBox ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ModernComboBox ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ ModernDatePicker ═══ -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ═══ ActionBtn ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
            <Setter Property="Height" Value="42"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>
        <Style x:Key="PrintBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ════════════════════════════════════════════════ -->
    <!--                  Main Layout                   -->
    <!-- ════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════ -->
            <!--          لوحة الفلتر (يمين)           -->
            <!-- ══════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{StaticResource FooterBrush}"
                    Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="12,14">
                    <StackPanel>

                        <!-- عنوان -->
                        <TextBlock Text="🔍 بيانات البحث"
                                   Foreground="White"
                                   FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14"/>

                        <!-- نوع العملية -->
                        <TextBlock Text="📋 نوع العملية"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbProcType"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="مشتريات"/>
                            <ComboBoxItem Content="مبيعات"/>
                            <ComboBoxItem Content="نقطة بيع"/>
                        </ComboBox>

                        <!-- المستودع -->
                        <TextBlock Text="🏪 المستودع"
                                   Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="chkAllSafes"
                                      Content="الكل"
                                      IsChecked="True"
                                      Foreground="White"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Checked="chkAllSafes_CheckedChanged"
                                      Unchecked="chkAllSafes_CheckedChanged"/>
                            <ComboBox x:Name="cmbSafes"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"
                                      Width="150"/>
                        </StackPanel>

                        <!-- المادة -->
                        <TextBlock Text="📦 المادة"
                                   Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox x:Name="chkAll"
                                      Content="الكل"
                                      IsChecked="True"
                                      Foreground="White"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Checked="chkAll_CheckedChanged"
                                      Unchecked="chkAll_CheckedChanged"/>
                        </StackPanel>

                        <TextBox x:Name="txtItemName"
                                 Style="{StaticResource ModernTextBox}"
                                 IsEnabled="False"
                                 Margin="0,0,0,4"
                                 KeyDown="txtItemName_KeyDown"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtItemCode"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     IsEnabled="False"
                                     KeyDown="txtItemCode_KeyDown"/>
                            <Button Grid.Column="2"
                                    Content="🔍"
                                    FontSize="14"
                                    Style="{StaticResource ActionBtn}"
                                    Padding="0"
                                    Click="btnSearch_Click"/>
                        </Grid>

                        <!-- المجموعة -->
                        <TextBlock Text="📁 المجموعة"
                                   Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkAllGroup"
                                      Content="الكل"
                                      IsChecked="True"
                                      Foreground="White"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Checked="ChkAllGroup_CheckedChanged"
                                      Unchecked="ChkAllGroup_CheckedChanged"/>
                            <ComboBox x:Name="CmbGroup"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"
                                      Width="150"
                                      DropDownOpened="CmbGroup_DropDownOpened"/>
                        </StackPanel>

                        <!-- الضريبة الإضافية فقط -->
                        <CheckBox x:Name="chkOnlyItemAdditionalTax"
          IsChecked="False"
          Foreground="White"
          FontSize="11"
          Margin="0,0,0,10"
          Checked="chkOnlyItemAdditionalTax_Changed"
          Unchecked="chkOnlyItemAdditionalTax_Changed">
                            <TextBlock Text="العناصر الخاضعة للضريبة الإضافية فقط"
               TextWrapping="Wrap"
               Foreground="White"/>
                        </CheckBox>

                        <!-- الفرع -->
                        <TextBlock Text="🏢 الفرع"
                                   Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="chkAllBranches"
                                      Content="الكل"
                                      IsChecked="True"
                                      Foreground="White"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Checked="chkAllBranches_CheckedChanged"
                                      Unchecked="chkAllBranches_CheckedChanged"/>
                            <ComboBox x:Name="cmbBranches"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"
                                      Width="150"/>
                        </StackPanel>

                        <!-- الفترة الزمنية -->
                        <Border Background="#1A2F70"
        CornerRadius="8"
        Padding="10,10"
        Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📅 الفترة الزمنية"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="12"
                   Margin="0,0,0,8"/>

                                <CheckBox x:Name="ckTotalPeriod"
                  Content="كل الفترة"
                  IsChecked="True"
                  Foreground="White"
                  FontSize="11"
                  Margin="0,0,0,8"
                  Checked="ckTotalPeriod_CheckedChanged"
                  Unchecked="ckTotalPeriod_CheckedChanged"/>

                                <TextBlock Text="من" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="txtDateFrom"
                    Style="{StaticResource ModernDatePicker}"
                    IsEnabled="False"
                    Margin="0,0,0,6"/>

                                <TextBox x:Name="txtStartTime"
                 Style="{StaticResource ModernTextBox}"
                 IsEnabled="False"
                 Margin="0,0,0,8"
                 Text="00:00"
                 HorizontalContentAlignment="Center"/>

                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="txtDateTo"
                    Style="{StaticResource ModernDatePicker}"
                    IsEnabled="False"
                    Margin="0,0,0,6"/>

                                <TextBox x:Name="txtEndTime"
                 Style="{StaticResource ModernTextBox}"
                 IsEnabled="False"
                 Margin="0,0,0,0"
                 Text="23:59"
                 HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- زر العرض -->
                        <Button x:Name="btnShow"
                                Content="📊 عرض"
                                Style="{StaticResource ShowBtn}"
                                Click="btnShow_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ══════════════════════════════════════ -->
            <!--          منطقة البيانات               -->
            <!-- ══════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- شريط التقدم -->
                <ProgressBar x:Name="ProgressBar1"
                             Grid.Row="0"
                             Height="8"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#2CC36B"
                             Background="#E8EBF5"
                             BorderThickness="0"
                             Margin="6,6,6,0"/>

                <!-- جدول الفواتير -->
                <Border Grid.Row="1"
                        Background="White"
                        Margin="6,4,6,4"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- عنوان الجدول -->
                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="10,10,0,0">
                            <TextBlock Text="📋 تفاصيل الفواتير"
                                       Foreground="White"
                                       FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="14,0"/>
                        </Border>

                        <!-- DevExpress GridControl -->
                        <dxg:GridControl x:Name="GridControl1"
                 Grid.Row="1"
                 FlowDirection="RightToLeft"
                 AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="GridView1"
                       AllowEditing="False"
                       ShowTotalSummary="False"
                       NavigationStyle="Row"
                       ShowGroupPanel="False"
                       AllowColumnFiltering="True">
                                </dxg:TableView>
                            </dxg:GridControl.View>

                            <dxg:GridControl.Columns>

                                <dxg:GridColumn Header="م"
                        FieldName="DgvNo"
                        Width="50"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="المستودع"
                        FieldName="DgvStore"
                        Width="90"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="نوع العملية"
                        FieldName="DgvInvType"
                        Width="120"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="المورد / العميل"
                        FieldName="DgvClient"
                        Width="130"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="📅 التاريخ"
                        FieldName="DgvDate"
                        Width="100"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="الرقم"
                        FieldName="DgvInvNo"
                        Width="80"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="المادة"
                        FieldName="DgvItem"
                        Width="150"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="الوحدة"
                        FieldName="DgvUnit"
                        Width="80"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="الكمية"
                        FieldName="DgvQty"
                        Width="80"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="كمية أساسية"
                        FieldName="DgvPrimaryQnty"
                        Width="95"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="السعر"
                        FieldName="DgvPrice"
                        Width="80"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="المجموع"
                        FieldName="DgvItemSum"
                        Width="90"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="الخصم"
                        FieldName="DgvItemDiscount"
                        Width="90"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="الإجمالي قبل الضريبة"
                        FieldName="DgvTotalBeforeTax"
                        Width="130"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="الضريبة"
                        FieldName="DgvVAT"
                        Width="80"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="ضريبة إضافية"
                        FieldName="DgvItemAdditionalTax"
                        Width="110"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="الإجمالي"
                        FieldName="DgvTotal"
                        Width="90"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="المستخدم"
                        FieldName="DgvUser"
                        Width="100"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn Header="ID"
                        FieldName="DgvInvGlobalID"
                        Visible="False"
                        Width="0"/>

                                <dxg:GridColumn Header="IsPlus"
                        FieldName="DgvIsPlus"
                        Visible="False"
                        Width="0"/>

                                <dxg:GridColumn Header="📄 تفاصيل"
                        FieldName="BtnDetails"
                        Width="80"
                        ReadOnly="True"
                        HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📄"
                            FontSize="14"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Tag="{Binding RowData.Row}"
                            Click="BtnDetails_Click"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                            </dxg:GridControl.Columns>
                        </dxg:GridControl>
                        <!-- شريط الإجماليات -->
                        <Border Grid.Row="2"
                                Background="#F0F4FF"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="0,1,0,0"
                                Padding="12,6"
                                CornerRadius="0,0,10,10">
                            <WrapPanel Orientation="Horizontal">

                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="الكمية: "
                                               FontWeight="Bold" Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblSumQty"
                                               Text="0.00"
                                               FontWeight="Bold" Foreground="#1B8E4A"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="المجموع: "
                                               FontWeight="Bold" Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblSumItemSum"
                                               Text="0.00"
                                               FontWeight="Bold" Foreground="#1B8E4A"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="الخصم: "
                                               FontWeight="Bold" Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblSumDiscount"
                                               Text="0.00"
                                               FontWeight="Bold" Foreground="#CC2222"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="قبل الضريبة: "
                                               FontWeight="Bold" Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblSumBeforeTax"
                                               Text="0.00"
                                               FontWeight="Bold" Foreground="#1B8E4A"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="الضريبة: "
                                               FontWeight="Bold" Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblSumVAT"
                                               Text="0.00"
                                               FontWeight="Bold" Foreground="#CC8800"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="ض.إضافية: "
                                               FontWeight="Bold" Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblSumAddTax"
                                               Text="0.00"
                                               FontWeight="Bold" Foreground="#CC8800"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="الإجمالي: "
                                               FontWeight="Bold" Foreground="#1B2642"/>
                                    <TextBlock x:Name="lblSumTotal"
                                               Text="0.00"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#213A7A"/>
                                </StackPanel>

                            </WrapPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--              Footer Buttons               -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            Width="120"
                            Margin="0,0,8,0"
                            Click="btnExport_Click"/>

                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource PrintBtn}"
                            Width="90"
                            Margin="0,0,8,0"
                            Click="btnPreview_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintBtn}"
                            Width="90"
                            Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>