<Window x:Class="SmartAuditERP.Form_WPF.frmBackupRstore"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💾 النسخ الاحتياطي واستعادة البيانات" 
        Height="300" Width="650"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2193b0" Offset="0"/>
            <GradientStop Color="#6dd5ed" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1e7e34" Offset="0"/>
            <GradientStop Color="#28a745" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#bd2130" Offset="0"/>
            <GradientStop Color="#dc3545" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#117a8b" Offset="0"/>
            <GradientStop Color="#17a2b8" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="White" 
                                BorderBrush="#2193b0" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="5,5,0,0"
                                Padding="15,8"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource HeaderGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="TabControl1" Margin="10">
        <!-- Tab 1: Backup -->
        <TabItem x:Name="TabPage1" Header="💾 النسخ الاحتياطي">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DatePicker x:Name="DtbTest" 
                           Grid.Row="0"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="0,10,0,20"/>

                <StackPanel Grid.Row="1" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Button x:Name="btnDoBkUp" 
                           Content="▶️ تنفيــــــذ"
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource SuccessGradient}"
                           Width="166" Height="36"
                           Margin="10,0"
                           Click="backup_button_Click"/>

                    <Button x:Name="btnclose" 
                           Content="🚪 خروج"
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource DangerGradient}"
                           Width="149" Height="36"
                           Margin="10,0"
                           Click="close_Click"/>
                </StackPanel>

                <ProgressBar x:Name="ProgressBar1" 
                            Grid.Row="3"
                            Height="25"
                            Margin="0,20,0,0"
                            Foreground="{StaticResource SuccessGradient}"/>
            </Grid>
        </TabItem>

        <!-- Tab 2: Restore -->
        <TabItem x:Name="TabPage2" Header="♻️ استعادة البيانات">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="Label2" 
                          Grid.Row="0"
                          Text="📂 اختر مسار النسخة الاحتياطية"
                          FontSize="13"
                          FontWeight="Bold"
                          Margin="0,10"/>

                <Grid Grid.Row="1" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtRestore" 
                            Grid.Column="0"
                            IsReadOnly="True"
                            Padding="8"
                            VerticalContentAlignment="Center"
                            Height="30"
                            Margin="0,0,10,0"/>

                    <Button x:Name="Button3" 
                           Grid.Column="1"
                           Content="📁 ..."
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource InfoGradient}"
                           Width="48" Height="30"
                           Click="Button3_Click"/>
                </Grid>

                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           Margin="0,20">
                    <Button x:Name="btnDoRestore" 
                           Content="▶️ تنفيــــــذ"
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource SuccessGradient}"
                           Width="161" Height="34"
                           Margin="10,0"
                           Click="restore_button_Click"/>

                    <Button x:Name="Button2" 
                           Content="🚪 خروج"
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource DangerGradient}"
                           Width="161" Height="34"
                           Margin="10,0"
                           Click="Button2_Click"/>
                </StackPanel>

                <ProgressBar x:Name="ProgressBar2" 
                            Grid.Row="4"
                            Height="25"
                            Margin="0,20,0,0"
                            Foreground="{StaticResource InfoGradient}"/>
            </Grid>
        </TabItem>

        <!-- Tab 3: Auto Backup Settings -->
        <TabItem x:Name="TabPage3" Header="⚙️ النسخ الإحتياطي التلقائي">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Activation Checkbox -->
                <CheckBox x:Name="chkActiveAutBackUp" 
                         Grid.Row="0"
                         Content="✅ تفعيل النسخ الإحتياطي التلقائي"
                         FontWeight="Bold"
                         FontSize="12"
                         IsChecked="True"
                         Margin="0,10"/>

                <!-- Last Backup Info -->
                <TextBox x:Name="txtlastBackup" 
                        Grid.Row="1"
                        Text="📅 اخر نسخ إحتياطي:"
                        IsReadOnly="True"
                        BorderThickness="0"
                        Background="Transparent"
                        FontWeight="Bold"
                        FontSize="12"
                        Margin="0,5"/>

                <!-- Backup Period Selection -->
                <Grid Grid.Row="2" Margin="0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="Label3" 
                                  Text="⏰ اختر الفترة الزمنية للنسخ الإحتياطي التلقائي"
                                  FontWeight="Bold"
                                  Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbBackupPeriods" 
                                 SelectedIndex="0"
                                 Height="30"
                                 SelectionChanged="cmbBackupPeriods_SelectedIndexChanged">
                            <ComboBoxItem Content="غير محدد"/>
                            <ComboBoxItem Content="عند إغلاق البرنامج"/>
                            <ComboBoxItem Content="يومي"/>
                            <ComboBoxItem Content="إسبوعي"/>
                            <ComboBoxItem Content="شهري"/>
                        </ComboBox>
                    </StackPanel>

                    <DatePicker x:Name="TimBackup" 
                               Grid.Column="1"
                               Visibility="Collapsed"
                               Margin="10,20,10,0"
                               Height="30"/>

                    <StackPanel x:Name="pnlOptions1" 
                               Grid.Column="2"
                               Orientation="Horizontal"
                               Visibility="Collapsed"
                               Margin="10,20,0,0">
                        <RadioButton x:Name="rbcomplsery" 
                                    Content="إجباري"
                                    IsChecked="True"
                                    Margin="5"/>
                        <RadioButton x:Name="rbOptional" 
                                    Content="إختياري"
                                    Margin="5"/>
                    </StackPanel>
                </Grid>

                <!-- Path Selection -->
                <Grid Grid.Row="3" Margin="0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="Label4" 
                              Grid.Row="0"
                              Text="📁 اختر المسار الإفتراضي للنسخة الاحتياطية"
                              FontWeight="Bold"
                              Margin="0,0,0,5"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="bkuppath" 
                                Grid.Column="0"
                                IsReadOnly="True"
                                Padding="8"
                                Height="30"
                                Margin="0,0,10,0"/>

                        <Button x:Name="btnSelectPath" 
                               Grid.Column="1"
                               Content="📁 ..."
                               Style="{StaticResource ModernButton}"
                               Background="{StaticResource InfoGradient}"
                               Width="47" Height="30"
                               Click="btnSelectPath_Click"/>
                    </Grid>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="6" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           Margin="0,20">
                    <Button x:Name="btnSure" 
                           Content="✅ تأكيد"
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource SuccessGradient}"
                           Width="156" Height="34"
                           Margin="10,0"
                           Click="btnSure_Click"/>

                    <Button x:Name="btnExit" 
                           Content="🚪 خروج"
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource DangerGradient}"
                           Width="156" Height="34"
                           Margin="10,0"
                           Click="btnExit_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>