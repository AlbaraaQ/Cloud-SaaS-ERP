<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmNkdFoundRpt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="تقارير مؤسسة النقد"
    Width="420"
    Height="160"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="ReportBtn" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="14,10">
            <TextBlock Text="💰 تقارير مؤسسة النقد" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="1" Background="White" Padding="16,12">
            <UniformGrid Columns="2" Margin="0">
                <Button x:Name="Button1"
                        Content="📊 الإجمالي جهات مختلفة"
                        Background="#2E4E9E"
                        Margin="0,0,8,0"
                        Style="{StaticResource ReportBtn}"
                        Click="Button1_Click"/>

                <Button x:Name="Button2"
                        Content="📊 إجمالي المبيعات والمشتريات"
                        Background="#1B8E4A"
                        Margin="8,0,0,0"
                        Style="{StaticResource ReportBtn}"
                        Click="Button2_Click"/>
            </UniformGrid>
        </Border>
    </Grid>
</dx:ThemedWindow>