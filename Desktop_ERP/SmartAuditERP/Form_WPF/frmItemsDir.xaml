<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmItemsDir"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="دليل الأصناف"
        Width="1550"
    Height="620"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmGroupDir_Load">

    <dx:ThemedWindow.Resources>

        <!-- Brushes -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#28A745" Offset="0"/>
            <GradientStop Color="#1C7C31" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F7CF7" Offset="0"/>
            <GradientStop Color="#305EDB" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="SoftText" Color="#7A869A"/>

        <!-- Effects -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.14"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.18"
                          Color="#000000"/>

        <!-- Buttons -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>

        <!-- Grid -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#304B8F"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tree -->
        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Search Box -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AFC2F2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10">
            <TextBlock Text="📦 دليل الأصناف"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="10,10,10,12"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- الصف الأول -->
                <WrapPanel Grid.Row="0">
                    <Button x:Name="btnAddGroup"
                            Content="➕ إضافة مجموعة"
                            Style="{StaticResource ActionBtn}"
                            Click="btnAddGroup_Click"/>

                    <Button x:Name="btnAddProduct"
                            Content="➕ إضافة صنف"
                            Style="{StaticResource ActionBtn}"
                            Click="btnAddProduct_Click"/>

                    <Button x:Name="btnRecode"
                            Content="🔑 إعادة ترميز"
                            Style="{StaticResource ActionBtn}"
                            Click="btnRecode_Click"/>

                    <Button x:Name="BtnEditItem"
                            Content="✏️ عمليات الأصناف"
                            Style="{StaticResource ActionBtn}"
                            Click="BtnEditItem_Click"/>

                    <Button x:Name="BtnDeleteItems"
                            Content="🗑️ حذف الأصناف"
                            Style="{StaticResource DangerBtn}"
                            Click="BtnDeleteItems_Click"/>

                    <Button x:Name="ButtonExportToExcel"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            Click="ButtonExportToExcel_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Click="btnPreview_Click"/>
                </WrapPanel>

                <!-- الصف الثاني -->
                <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                    <Button x:Name="BtnShowNonActiveItems"
                            Content="📋 الأصناف بدون عمليات"
                            Style="{StaticResource ActionBtn}"
                            Click="BtnShowNonActiveItems_Click"/>

                    <Button x:Name="btnLoadAll"
                            Content="🔄 تحديث الكل"
                            Style="{StaticResource ActionBtn}"
                            Click="btnLoadAll_Click"/>

                    <Button x:Name="btnSyncItems"
                            Content="🔃 إرسال الأصناف"
                            Style="{StaticResource ActionBtn}"
                            Visibility="Collapsed"
                            Click="btnSyncItems_Click"/>

                    <Button x:Name="btnsyncCategories"
                            Content="🔃 مزامنة المجموعات"
                            Style="{StaticResource ActionBtn}"
                            Visibility="Collapsed"
                            Click="btnsyncCategories_Click"/>

                    <Button x:Name="btnUnits"
                            Content="🔃 مزامنة الوحدات"
                            Style="{StaticResource ActionBtn}"
                            Visibility="Collapsed"
                            Click="btnUnits_Click"/>

                    <Button x:Name="btnItemQuantity"
                            Content="🔃 مزامنة الكميات"
                            Style="{StaticResource ActionBtn}"
                            Visibility="Collapsed"
                            Click="btnItemQuantity_Click"/>

                    <Button x:Name="BtnRecieveditem"
                            Content="📥 استلام الأصناف"
                            Style="{StaticResource ActionBtn}"
                            Visibility="Collapsed"
                            Click="BtnRecieveditem_Click"/>
                </WrapPanel>

                <ProgressBar x:Name="ProgressBar1"
                             Grid.Row="3"
                             Height="6"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed"
                             Foreground="#3A63C3"
                             Background="#E8EBF5"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الشجرة -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,1,0"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}">
                        <TextBlock Text="📂 مجموعات الأصناف"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TreeView x:Name="TreeList1"
                              Grid.Row="1"
                              Background="White"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                              SelectedItemChanged="TreeList1_SelectedItemChanged"
                              Padding="8">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁"
                                               FontSize="12"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#1B2642"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- الفاصل -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="#E3E8F3"/>

            <!-- الجدول -->
            <Border Grid.Column="2"
                    Margin="6,6,6,6"
                    Background="White"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🏷️ قائمة الأصناف"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>

                            <TextBlock x:Name="lblRowCount"
                                       Grid.Column="1"
                                       Text="عدد السجلات: 0"
                                       Foreground="#DCE7FF"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       FlowDirection="LeftToRight"/>

                            <!-- Search Box بدون Placeholder unsupported -->
                            <Grid Grid.Column="3"
                                  Width="190"
                                  Height="30"
                                  VerticalAlignment="Center">
                                <TextBox x:Name="txtSearch"
                                         Style="{StaticResource SearchTextBox}"
                                         TextChanged="txtSearch_TextChanged"
                                         GotFocus="txtSearch_GotFocus"
                                         LostFocus="txtSearch_LostFocus"/>
                                <TextBlock x:Name="txtSearchWatermark"
                                           Text="🔍 ابحث هنا..."
                                           Foreground="{StaticResource SoftText}"
                                           FontSize="12"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridControl1"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource GridRowStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              AlternatingRowBackground="#F8F9FD"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E7ECF5"
                              Background="White">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="م"
                                                Binding="{Binding DgvNo}"
                                                Width="55"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="ItemId"
                                                Binding="{Binding DgvItemId}"
                                                Width="80"
                                                Visibility="Collapsed"/>

                            <DataGridTextColumn Header="🔑 الرمز"
                                                Binding="{Binding DgvItemCode}"
                                                Width="100"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="🏷️ الصنف"
                                                Binding="{Binding DgvItemName}"
                                                Width="220"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="📝 الصنف EN"
                                                Binding="{Binding DgvItemNameEn}"
                                                Width="160"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="🔖 الباركود"
                                                Binding="{Binding DgvBarcode}"
                                                Width="130"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="📂 المجموعة"
                                                Binding="{Binding DgvItemCategory}"
                                                Width="120"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="📦 الوحدة"
                                                Binding="{Binding DgvUnit}"
                                                Width="80"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="💵 سعر البيع"
                                                Binding="{Binding DgvSalePrice, StringFormat=N2}"
                                                Width="90"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="💰 سعر الشراء"
                                                Binding="{Binding DgvPurchPrice, StringFormat=N2}"
                                                Width="90"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTemplateColumn Header="✏️ تعديل" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✏️"
                                                Tag="{Binding}"
                                                Height="26"
                                                Padding="8,0"
                                                Cursor="Hand"
                                                Foreground="White"
                                                Background="#2E4E9E"
                                                BorderThickness="0"
                                                Click="DgvBtnEdit_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="5"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="🗑️ حذف" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️"
                                                Tag="{Binding}"
                                                Height="26"
                                                Padding="8,0"
                                                Cursor="Hand"
                                                Foreground="White"
                                                Background="#E35656"
                                                BorderThickness="0"
                                                Click="BtnDelete_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="5"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</dx:ThemedWindow>