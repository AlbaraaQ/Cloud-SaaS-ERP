<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="الإعدادات"
    Width="1100"
    Height="750"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial">

    <!-- ==================== Resources ==================== -->
    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.15"/>

        <!-- Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ==================== Main Layout ==================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource HeaderBrush}"
                Padding="15"
                Grid.Row="0">
            <TextBlock Text="⚙️ إعدادات النظام"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"/>
        </Border>

        <!-- ==================== TabControl1 ==================== -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="1"
                    Margin="10"
                    Background="White">

            <!-- ==================== TabPage1 ==================== -->
            <TabItem x:Name="TabPage1" Header="عـــــام">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="10">
                        <GroupBox x:Name="GroupBox7"
                      Header="🧾 إعدادات الفواتير"
                      Background="White"
                      BorderBrush="#D9E2F2"
                      BorderThickness="1"
                      Padding="12">

                            <GroupBox.Resources>

                                <Style x:Key="FieldLabelStyle" TargetType="Label">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1B2642"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>

                                <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="BorderBrush" Value="#CCD6EA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="BorderBrush" Value="#CCD6EA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                </Style>

                                <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
                                    <Setter Property="Margin" Value="0,4,14,4"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#1F2D4D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>

                                <Style x:Key="ModernRadioButtonStyle" TargetType="RadioButton">
                                    <Setter Property="Margin" Value="0,5,0,5"/>
                                    <Setter Property="Foreground" Value="#1F2D4D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>

                                <Style x:Key="CardBorderStyle" TargetType="Border">
                                    <Setter Property="Background" Value="#FAFBFE"/>
                                    <Setter Property="BorderBrush" Value="#D9E2F2"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="CornerRadius" Value="12"/>
                                    <Setter Property="Padding" Value="12"/>
                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                    <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
                                </Style>

                            </GroupBox.Resources>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>

                                <!-- ======================== Main Content ======================== -->
                                <StackPanel Grid.Column="0">

                                    <!-- Card 1 : Basic Info -->
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,12">
                                                <TextBlock Text="📋 البيانات الأساسية"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                            </Border>

                                            <WrapPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblVatPer" Content="نسبة الضريبة" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtVatPer" Text="0" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblAdditionalVAT" Content="ضريبة إضافية" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtAdditionalVAT" Text="0" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220">
                                                    <Label x:Name="lblInsure" Content="قيمة التأمين" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtInsure" Text="0" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblDevM" Content="قيمة التوصيل" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtDevM" Text="0" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblUnit" Content="الوحدة الافتراضية" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbUnits" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220">
                                                    <Label x:Name="lblTreasury" Content="الخزينة" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbTreasury" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblnvCode" Content="كود الفاتورة" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtInvCode" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblDigitsNo" Content="عدد الكسور" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtDigitsNo" Text="2" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220">
                                                    <Label x:Name="lblPrefixe" Content="البادئة" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtPrefixe" Text="1" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblDefaultCust" Content="العميل الافتراضي" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="CmbDefaultCust" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblCloudSerial" Content="Cloud Serial" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtCloudSerial" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220">
                                                    <Label x:Name="lblReInvCloudSerial" Content="Re-Inv Cloud Serial" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtReInvCloudSerial" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="Label25" Content="طريقة الدفع الافتراضية" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbPayTypeDefault" Style="{StaticResource ModernComboBoxStyle}">
                                                        <ComboBoxItem Content="اجل"/>
                                                        <ComboBoxItem Content="نقدي"/>
                                                        <ComboBoxItem Content="بنك"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblCurrency" Content="العملة" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbCurrency" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220">
                                                    <Label x:Name="Label60" Content="" Style="{StaticResource FieldLabelStyle}" Visibility="Collapsed"/>
                                                    <Button x:Name="AddColumnAdd"
                                                Content="➕ إضافة عمود إضافي"
                                                Style="{StaticResource ActionBtn}"
                                                Background="{StaticResource HeaderBrush}"
                                                Margin="0,24,0,10"/>
                                                </StackPanel>

                                            </WrapPanel>

                                            <WrapPanel Margin="0,8,0,0">
                                                <CheckBox x:Name="chkValueHaveTax" Content="السعر شامل الضريبة" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="AutoCheck" Content="الباركود اتوماتك" Style="{StaticResource ModernCheckBoxStyle}" Visibility="Collapsed"/>
                                                <CheckBox x:Name="cksaleByMinus" Content="البيع بالسالب" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="CkHasEntry" Content="توليد قيد" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True"/>
                                                <CheckBox x:Name="ckShowPayForm" Content="إظهار شاشة الدفع" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="ckSyncInv" Content="مزامنة الفواتير" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="ckSyncEntry" Content="مزامنة القيود" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="ckLinkedReturn" Content="مرتجع مرتبط" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True"/>
                                                <CheckBox x:Name="ckUnlinkedReturn" Content="مرتجع غير مرتبط" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True"/>
                                                <CheckBox x:Name="ckShowPayfrmReturn" Content="إظهار الدفع في المرتجع" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="ckProcessFlow" Content="تدفق العمليات" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="ckPaymentStatus" Content="حالة الدفع" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="ckCashCustRequire" Content="المطالبة بالعميل النقدي" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="chkDetailedItemEntry" Content="قيد تفصيلي للمواد" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="CheckOperSale" Content="تشغيل عملية البيع" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="chkSalesmanRequired" Content="إلزام المندوب" Style="{StaticResource ModernCheckBoxStyle}"/>
                                                <CheckBox x:Name="chkAtiveCustMeasur" Content="تفعيل مقياس عميل مخصص" Style="{StaticResource ModernCheckBoxStyle}" Visibility="Collapsed"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2 : Accounts -->
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,12">
                                                <TextBlock Text="🏦 الحسابات والربط المحاسبي"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                            </Border>

                                            <WrapPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblAccDiscount" Content="حساب الخصم" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbAccDiscount" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblAccAdditions" Content="حساب الإضافات" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbAccAdditions" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220">
                                                    <Label x:Name="lblAccInsurance" Content="حساب التأمين" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbAccInsurance" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblAccStore" Content="حساب المخزون" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbAccStore" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblAccItems" Content="حساب الأصناف" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbAccItems" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220">
                                                    <Label x:Name="lblAccVAT" Content="حساب الضريبة" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbAccVAT" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <StackPanel Width="220" Margin="0,0,12,0">
                                                    <Label x:Name="lblAccReturnItems" Content="حساب أصناف المرتجع" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbAccReturnItems" Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3 : Pricing -->
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,12">
                                                <TextBlock Text="💰 التسعير والتكلفة"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="14"/>
                                            </Border>

                                            <WrapPanel>
                                                <StackPanel Width="320" Margin="0,0,12,0">
                                                    <Label x:Name="lblCosts" Content="التكلفة" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbCosts" Style="{StaticResource ModernComboBoxStyle}">
                                                        <ComboBoxItem Content="لا يوجد"/>
                                                        <ComboBoxItem Content="متوسط التكلفة"/>
                                                        <ComboBoxItem Content="سعر الشراء"/>
                                                        <ComboBoxItem Content="اخر سعر شراء"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Width="320">
                                                    <Label x:Name="lblPricing" Content="التسعير" Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbPricing" Style="{StaticResource ModernComboBoxStyle}">
                                                        <ComboBoxItem Content="لا يوجد"/>
                                                        <ComboBoxItem Content="سعر البيع"/>
                                                        <ComboBoxItem Content="سعر الشراء"/>
                                                        <ComboBoxItem Content="سعر اخر شراء"/>
                                                        <ComboBoxItem Content="سعر التكلفة"/>
                                                        <ComboBoxItem Content="السعر المنافس"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Footer Buttons -->
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0">
                                        <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                            <Button x:Name="btnSaveGen"
                                        Content="💾 حفظ الإعدادات"
                                        Width="240"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource ActionBtn}"
                                        Background="{StaticResource SaveBrush}"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

                                <!-- ======================== Invoice Types ======================== -->
                                <GroupBox x:Name="GrpInvGen"
                              Grid.Column="2"
                              Header="📄 الفواتير"
                              Background="#FAFBFE"
                              BorderBrush="#D9E2F2"
                              BorderThickness="1"
                              Padding="10">

                                    <StackPanel>

                                        <RadioButton x:Name="cbPurchInv"
                                         Content="مشتريات"
                                         IsChecked="True"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="cbSalesInv"
                                         Content="مبيعات"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="cbPOS"
                                         Content="نقطة بيع"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="cbRentInv"
                                         Content="تأجير"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="ckProjcMng"
                                         Content="عقود المشاريع"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbProduction"
                                         Content="إنتاج"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbPricingInv"
                                         Content="تسعير"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbTransfarInvertory"
                                         Content="تحويل مخزني"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbInvertoryCorrection"
                                         Content="تصحيح مخزني"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbInvertoryOut"
                                         Content="صرف مخزني"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbInvertoryIn"
                                         Content="استلام مخزني"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbFirstInvrtory"
                                         Content="جرد افتتاحي"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rbRecieptVAT"
                                         Content="فاتورة ضريبة"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="btnInventoryOrder"
                                         Content="أمر مخزني"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="rdsalcontract"
                                         Content="عقد بيع"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <RadioButton x:Name="ckAllInvs"
                                         Content="الكل"
                                         Visibility="Collapsed"
                                         Style="{StaticResource ModernRadioButtonStyle}"/>

                                        <CheckBox x:Name="chkTouch"
                                      Content="الشاشة تدعم التاتش اسكرين"
                                      Visibility="Collapsed"
                                      Style="{StaticResource ModernCheckBoxStyle}"/>

                                        <Label x:Name="Label59"
                                   Content=""
                                   Style="{StaticResource FieldLabelStyle}"
                                   Visibility="Collapsed"/>

                                    </StackPanel>
                                </GroupBox>

                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TabPage2 ==================== -->
            <TabItem x:Name="TabPage2" Header="نقطة البيع">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="Panel1" Margin="10" Background="Transparent">

                        <Grid.Resources>

                            <Style x:Key="FieldLabelStyle" TargetType="Label">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#1B2642"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="BorderBrush" Value="#CCD6EA"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="BorderBrush" Value="#CCD6EA"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>

                            <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,4,18,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#1F2D4D"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>

                            <Style x:Key="ModernRadioButtonStyle" TargetType="RadioButton">
                                <Setter Property="Margin" Value="0,4,18,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#1F2D4D"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>

                            <Style x:Key="CardBorderStyle" TargetType="Border">
                                <Setter Property="Background" Value="#FAFBFE"/>
                                <Setter Property="BorderBrush" Value="#D9E2F2"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Padding" Value="12"/>
                                <Setter Property="Margin" Value="0,0,0,12"/>
                                <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
                            </Style>

                        </Grid.Resources>

                        <StackPanel>

                            <!-- ======================== Global Option ======================== -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="🛒 إعدادات نقطة البيع"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#203864"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"/>
                                    <CheckBox x:Name="ckDefaultSettings"
                                  Content="الإعدادات الإفتراضية"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Center"
                                  DockPanel.Dock="Left"/>
                                </DockPanel>
                            </Border>

                            <!-- ======================== GroupBox5 ======================== -->
                            <GroupBox x:Name="GroupBox5"
                          Header="عام"
                          Background="White"
                          BorderBrush="#D9E2F2"
                          BorderThickness="1"
                          Padding="12">
                                <WrapPanel>

                                    <CheckBox x:Name="ckShowDelivery"
                                  Content="عرض خدمة التوصيل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>

                                    <CheckBox x:Name="ckEditDelivery"
                                  Content="قيمة التوصيل قابلة التعديل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>

                                    <CheckBox x:Name="ckShowInsure"
                                  Content="عرض حقل التأمين"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>

                                    <CheckBox x:Name="ckEditInsure"
                                  Content="قيمة التأمين قابلة التعديل"
                                  IsChecked="True"
