                                                            Background="{StaticResource SaveBrush}"
                                                            Style="{StaticResource GridActionBtn_Tab6}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>

                                        <!-- Placeholder للحفاظ على الاسم -->
                                        <Button x:Name="RepositoryItemButtonEdit2"
