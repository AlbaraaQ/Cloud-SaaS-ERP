<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.ReplaceMsg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="اختر نوع الاستبدال"
    Width="460" Height="180"
    WindowStartupLocation="CenterOwner"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <dx:ThemedWindow.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="5"  ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="ChoiceBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </dx:ThemedWindow.Resources>

    <Border Background="White" CornerRadius="12" Margin="8"
            Effect="{StaticResource CardShadow}">
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- العنوان -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <!-- الأزرار -->
            </Grid.RowDefinitions>

            <!-- العنوان -->
            <TextBlock Grid.Row="0"
                       Text="🔄 إختر نوع الاستبدال"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#1B2642"
                       HorizontalAlignment="Center"
                       FontFamily="Cairo, Tahoma, Arial"/>

            <!-- الأزرار -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <!-- ضمن خطة الدور -->
                <Button Grid.Column="0"
                        x:Name="btnLinked"
                        Content="✅ ضمن خطة الدور"
                        Background="#191970"
                        Style="{StaticResource ChoiceBtn}"
                        Click="btnLinked_Click"/>

                <!-- خارج خطة الدور -->
                <Button Grid.Column="2"
                        x:Name="btnNotLinked"
                        Content="📋 خارج خطة الدور"
                        Background="#1565C0"
                        Style="{StaticResource ChoiceBtn}"
                        Click="btnNotLinked_Click"/>

                <!-- إلغاء -->
                <Button Grid.Column="4"
                        x:Name="btnClose"
                        Content="✖ إلغاء"
                        Background="#7B1010"
                        Style="{StaticResource ChoiceBtn}"
                        Click="btnClose_Click"/>
            </Grid>
        </Grid>
    </Border>
</dx:ThemedWindow>