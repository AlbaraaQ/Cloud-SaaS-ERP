<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCustLastPay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="📋 حركة آخر سداد للعملاء"
    Height="700" Width="1100"
    MinHeight="600" MinWidth="900"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    FlowDirection="RightToLeft"
    FontFamily="Tahoma"
    FontSize="13">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Gradient Brushes               -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0D47A1" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="0.5"/>
            <GradientStop Color="#1976D2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8F9FA" Offset="0"/>
            <GradientStop Color="#ECEFF1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonShowGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1976D2" Offset="0"/>
            <GradientStop Color="#0D47A1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonPrintGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#388E3C" Offset="0"/>
            <GradientStop Color="#1B5E20" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonExportGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F57C00" Offset="0"/>
            <GradientStop Color="#E65100" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonCloseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D32F2F" Offset="0"/>
            <GradientStop Color="#B71C1C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SummaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Drop Shadows                   -->
        <!-- ═══════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#AAAAAA"
                          Direction="270"
                          ShadowDepth="3"
                          BlurRadius="8"
                          Opacity="0.4"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          Color="#333333"
                          Direction="270"
                          ShadowDepth="2"
                          BlurRadius="5"
                          Opacity="0.35"/>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Button Styles                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="BaseActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonShowGradient}"/>
        </Style>

        <Style x:Key="PrintButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonPrintGradient}"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonExportGradient}"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseActionButton}">
            <Setter Property="Background" Value="{StaticResource ButtonCloseGradient}"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--              GroupBox Style                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0D47A1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderGradient}"
                                    CornerRadius="10,10,0,0"
                                    Padding="12,6">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="White"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           CheckBox Style                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--           Summary Value Style               -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="SummaryValueText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--                  Main Layout                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--                  Header Bar                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0">
                    <TextBlock Text="💰"
                               FontSize="22"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtHeaderTitle"
                               Text="حركة آخر سداد للعملاء"
                               Foreground="White"
                               FontFamily="Tahoma"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0">
                    <TextBlock x:Name="txtHeaderDate"
                               Foreground="#B3E5FC"
                               FontFamily="Tahoma"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Content Area                   -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────── -->
            <!--         Right Sidebar               -->
            <!-- ─────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarGradient}"
                    BorderBrush="#CFD8DC"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">

                        <!-- ❯ Client Selection -->
                        <GroupBox Style="{StaticResource ModernGroupBox}"
                                  Margin="0,8,0,6">
                            <GroupBox.Header>
                                <TextBlock Text="👤 اختيار العميل / المورد"/>
                            </GroupBox.Header>
                            <StackPanel Margin="5">

                                <TextBlock x:Name="LblAccName"
                                           Text="العميل / المورد"
                                           FontFamily="Tahoma"
                                           FontSize="11"
                                           Foreground="#546E7A"
                                           Margin="0,0,0,5"/>

                                <CheckBox x:Name="chkAll"
                                          Content="✅ الكل"
                                          IsChecked="True"
                                          Style="{StaticResource ModernCheckBox}"
                                          Margin="0,0,0,8"/>

                                <dxe:ComboBoxEdit x:Name="cmbClients"
                                                  Height="32"
                                                  AutoComplete="True"
                                                  IsTextEditable="True"
                                                  NullText="🔍 ابحث عن عميل..."
                                                  IsEnabled="False"
                                                  Margin="0,3"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ❯ Info Card -->
                        <Border Background="White"
                                BorderBrush="#B0BEC5"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="12"
                                Margin="5,10,5,10"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Text="📌 معلومات"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#0D47A1"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="• اختر عميل أو حدد الكل"
                                           FontFamily="Tahoma"
                                           FontSize="11"
                                           Foreground="#546E7A"
                                           TextWrapping="Wrap"
                                           Margin="0,2"/>
                                <TextBlock Text="• اضغط عرض لمشاهدة البيانات"
                                           FontFamily="Tahoma"
                                           FontSize="11"
                                           Foreground="#546E7A"
                                           TextWrapping="Wrap"
                                           Margin="0,2"/>
                                <TextBlock Text="• اضغط 🔎 لعرض تفاصيل القيد"
                                           FontFamily="Tahoma"
                                           FontSize="11"
                                           Foreground="#546E7A"
                                           TextWrapping="Wrap"
                                           Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <!-- ❯ Show Button -->
                        <Button x:Name="btnShow"
                                Content="🔍 عرض البيانات"
                                Style="{StaticResource ShowButtonStyle}"
                                Height="48"
                                Margin="5,8,5,5"
                                FontSize="14"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─────────────────────────────────── -->
            <!--         Main Grid Area              -->
            <!-- ─────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Progress Bar -->
                <dxe:ProgressBarEdit x:Name="ProgressBar1"
                                     Grid.Row="0"
                                     Height="8"
                                     Margin="10,8,10,0"
                                     Minimum="0"
                                     Maximum="100"/>

                <!-- Grid Title -->
                <Border Grid.Row="1"
                        Background="#E3F2FD"
                        Margin="10,8,10,0"
                        CornerRadius="8,8,0,0"
                        Padding="15,8">
                    <TextBlock Text="📊 آخر سداد للعملاء / الموردين"
                               FontFamily="Tahoma"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#0D47A1"/>
                </Border>

                <!-- DevExpress Grid -->
                <dxg:GridControl x:Name="dgvItems"
                                 Grid.Row="2"
                                 Margin="10,0,10,0"
                                 AutoExpandAllGroups="True">
                    <dxg:GridControl.Columns>

                        <dxg:GridColumn x:Name="ColAccountCode"
                                        Header="رقم الحساب"
                                        FieldName="AccountCode"
                                        Width="90"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColClientName"
                                        Header="اسم العميل"
                                        FieldName="ClientName"
                                        Width="150"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColPhone"
                                        Header="الهاتف"
                                        FieldName="Phone"
                                        Width="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColMobile"
                                        Header="الجوال"
                                        FieldName="Mobile"
                                        Width="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColLastPayAmount"
                                        Header="قيمة آخر سداد"
                                        FieldName="LastPayAmount"
                                        Width="110"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColLastPayDate"
                                        Header="تاريخ آخر سداد"
                                        FieldName="LastPayDate"
                                        Width="110"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColEntryType"
                                        Header="نوع السند"
                                        FieldName="EntryType"
                                        Width="130"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColBalance"
                                        Header="الرصيد"
                                        FieldName="Balance"
                                        Width="100"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColStatus"
                                        Header="الحالة"
                                        FieldName="Status"
                                        Width="80"
                                        AllowEditing="False"
                                        ReadOnly="True"
                                        HorizontalHeaderContentAlignment="Center"/>

                        <dxg:GridColumn x:Name="ColEntryNo"
                                        Header="رقم القيد"
                                        FieldName="EntryNo"
                                        Visible="False"/>

                        <dxg:GridColumn x:Name="ColViewDetail"
                                        Header="عرض"
                                        FieldName="ViewDetail"
                                        Width="70"
                                        AllowEditing="True"
                                        HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔎"
                                            FontSize="16"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="BtnViewDetail_Click"
                                            ToolTip="عرض تفاصيل السند"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>

                    </dxg:GridControl.Columns>

                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="GridView1"
                                       AllowGrouping="False"
                                       ShowGroupPanel="False"
                                       AutoWidth="False"
                                       NavigationStyle="Row"
                                       AllowPerPixelScrolling="True"
                                       ShowSearchPanelCloseButton="True"
                                       SearchPanelNullText="🔍 ابحث هنا...">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <!-- ─────────────────────────────────── -->
                <!--         Summary Panel               -->
                <!-- ─────────────────────────────────── -->
                <Border Grid.Row="3"
                        Background="{StaticResource SummaryGradient}"
                        BorderBrush="#90CAF9"
                        BorderThickness="1"
                        CornerRadius="0,0,8,8"
                        Margin="10,0,10,8"
                        Padding="15,10"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Pay -->
                        <TextBlock Grid.Column="0"
                                   Text="💳 الإجمالي"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#1565C0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="Label6"
                                   Grid.Column="2"
                                   Text="0"
                                   Style="{StaticResource SummaryValueText}"
                                   Foreground="#0D47A1"/>

                        <!-- Separator -->
                        <Border Grid.Column="3"
                                Width="2"
                                Background="#B0BEC5"
                                Margin="10,0"/>

                        <!-- Total Balance -->
                        <TextBlock Grid.Column="4"
                                   Text="⚖️ الرصيد"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#E65100"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="Label3"
                                   Grid.Column="6"
                                   Text="0"
                                   Style="{StaticResource SummaryValueText}"
                                   Foreground="#D32F2F"/>

                        <!-- Separator -->
                        <Border Grid.Column="7"
                                Width="2"
                                Background="#B0BEC5"
                                Margin="10,0"/>

                        <!-- Record Count -->
                        <TextBlock Grid.Column="8"
                                   Text="📌 السجلات"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtRecordCount"
                                   Grid.Column="10"
                                   Text="0"
                                   Style="{StaticResource SummaryValueText}"
                                   Foreground="#1B5E20"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Footer Toolbar                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterGradient}"
                BorderBrush="#B0BEC5"
                BorderThickness="0,1,0,0"
                Padding="15,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="btnPreview"
                        Content="👁️ معاينة"
                        Style="{StaticResource ShowButtonStyle}"
                        Margin="5,0"/>

                <Button x:Name="btnPrint"
                        Content="🖨️ طباعة"
                        Style="{StaticResource PrintButtonStyle}"
                        Margin="5,0"/>

                <Button x:Name="btnExport"
                        Content="📊 تصدير Excel"
                        Style="{StaticResource ExportButtonStyle}"
                        Margin="5,0"/>

                <Button x:Name="btnClose"
                        Content="❌ خروج"
                        Style="{StaticResource CloseButtonStyle}"
                        Margin="5,0"/>

            </StackPanel>
        </Border>

    </Grid>
</dx:ThemedWindow>