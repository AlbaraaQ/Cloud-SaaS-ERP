<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmVATvoucher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="سند قبض الضريبة"
    Width="1180" Height="640"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabControl1"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- ═══ تبويب: سند قبض ═══ -->
            <TabItem Header="📄 سند قبض الضريبة">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ Card 1: بيانات السند الأساسية ═══ -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="8,8,8,4"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="6" Padding="10,6"
                                    Margin="0,0,0,10">
                                <TextBlock Text="📋 بيانات السند"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Row 1: رقم السند + التاريخ + رقم المرجع + تاريخ المرجع -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔢 رقم السند" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BondNo"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"
                                             TextAlignment="Center"
                                             Text="1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📅 التاريخ" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtDate" Height="30"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="🔢 رقم المرجع" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RefNo"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="📅 تاريخ المرجع" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtRefDate" Height="30"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: العميل + مركز التكلفة -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="👤 العميل:"
                                           Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="cmbClient"
                                          Style="{StaticResource ModernCombo}"
                                          SelectionChanged="cmbClient_SelectionChanged"/>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="🔢 الرقم الضريبي" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtTaxNo"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- ═══ Card 2: القيم المالية + طريقة الدفع ═══ -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="8,0,8,4"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- يسار: القيم + الحساب -->
                            <StackPanel Grid.Column="0">
                                <!-- نوع الحساب -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="rbMsarif"
                                                 Content="مصاريف"
                                                 IsChecked="True"
                                                 FontWeight="Bold"
                                                 Margin="0,0,16,0"
                                                 Checked="rbMsarif_Checked"/>
                                    <RadioButton x:Name="rbAssess"
                                                 Content="أصول ثابتة"
                                                 FontWeight="Bold"
                                                 Checked="rbAssess_Checked"/>
                                </StackPanel>

                                <!-- الحساب -->
                                <TextBlock Text="💰 دفعة من حساب" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbPay"
                                          Style="{StaticResource ModernCombo}"
                                          Margin="0,0,0,8"/>

                                <!-- العميل المورد -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🏢 المورد" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbClients"
                                                  Style="{StaticResource ModernCombo}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            x:Name="btnAddClient"
                                            Content="➕"
                                            Width="30" Height="30"
                                            Background="#76B496"
                                            Foreground="White"
                                            VerticalAlignment="Bottom"
                                            Margin="4,0,0,0"
                                            Cursor="Hand"
                                            Click="btnAddClient_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- مركز التكلفة -->
                                <TextBlock Text="📊 مركز التكلفة" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbCostCenter"
                                          Style="{StaticResource ModernCombo}"
                                          Margin="0,0,0,8"/>

                                <!-- الحساب المدفوع إليه -->
                                <TextBlock Text="🏦 الحساب (خزينة/بنك)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0"
                                                 x:Name="rdCash"
                                                 Content="💵 نقدي"
                                                 IsChecked="True"
                                                 FontWeight="Bold"
                                                 Checked="rdCheck_CheckedChanged"/>
                                    <RadioButton Grid.Column="2"
                                                 x:Name="rdCheck"
                                                 Content="🏦 تحويل بنكي"
                                                 FontWeight="Bold"
                                                 Checked="rdCheck_CheckedChanged"/>
                                </Grid>
                                <ComboBox x:Name="cmbToAcc"
                                          Style="{StaticResource ModernCombo}"
                                          Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- يمين: القيم + الملاحظات -->
                            <StackPanel Grid.Column="2">

                                <!-- قيمة السند + ضريبة + صافي -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="💲 قيمة السند" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtVal"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 TextChanged="txtVal_TextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="lblVat"
                                                   Text="🧾 الضريبة"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtVAT"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="💰 الصافي" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtNetVal"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- الحسابات -->
                                <TextBlock Text="📊 الحسابات" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbAccounts"
                                          Style="{StaticResource ModernCombo}"
                                          Margin="0,0,0,8"/>

                                <!-- مركز التكلفة (cmbCost) -->
                                <TextBlock Text="📊 مركز التكلفة 2" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbCost"
                                          Style="{StaticResource ModernCombo}"
                                          Margin="0,0,0,8"/>

                                <!-- الموظف -->
                                <TextBlock Text="👤 الموظف" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSalesMan"
                                          Style="{StaticResource ModernCombo}"
                                          Margin="0,0,0,8"/>

                                <!-- البيان -->
                                <TextBlock Text="📝 البيان" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNotes"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="54"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ Card 3: بيانات الشيك (مخفية افتراضياً) ═══ -->
                    <Border Grid.Row="2"
                            x:Name="Panel1"
                            Background="White"
                            CornerRadius="10"
                            Padding="14,8"
                            Margin="8,0,8,4"
                            Visibility="Collapsed"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🔢 رقم الشيك" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCheckNo" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="📅 تاريخ الاستحقاق" Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtCheckDate" Height="30"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="🏦 حالة الشيك" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbCheckType" Style="{StaticResource ModernCombo}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="6">
                                <TextBlock Text="🏦 مسحوب على بنك" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtBankCheck" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ Toolbar ═══ -->
                    <Border Grid.Row="3"
                            Background="{StaticResource FooterBrush}"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="btnClose"
                                        Content="✖"
                                        Style="{StaticResource DangerBtn}"
                                        Width="40" Margin="0,0,4,0"
                                        Click="btnClose_Click"/>
                                <Button x:Name="btnFirst"
                                        Content="⏮"
                                        Style="{StaticResource NavBtn}"
                                        Margin="0,0,4,0"
                                        Click="btnFirst_Click"/>
                                <Button x:Name="btnPrevious"
                                        Content="◀"
                                        Style="{StaticResource NavBtn}"
                                        Margin="0,0,4,0"
                                        Click="btnPrevious_Click"/>
                                <Button x:Name="btnNext"
                                        Content="▶"
                                        Style="{StaticResource NavBtn}"
                                        Margin="0,0,4,0"
                                        Click="btnNext_Click"/>
                                <Button x:Name="btnLast"
                                        Content="⏭"
                                        Style="{StaticResource NavBtn}"
                                        Click="btnLast_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="btnPrint"
                                        Content="🖨️ طباعة"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80" Margin="0,0,6,0"
                                        Click="btnPrint_Click"/>
                                <Button x:Name="btnDelete"
                                        Content="🗑️ حذف"
                                        Style="{StaticResource DangerBtn}"
                                        Width="80" Margin="0,0,6,0"
                                        Click="btnDelete_Click"/>
                                <Button x:Name="btnSave"
                                        Content="💾 حفظ"
                                        Style="{StaticResource SaveBtn}"
                                        Width="80" Margin="0,0,6,0"
                                        Click="btnSave_Click"/>
                                <Button x:Name="btnNew"
                                        Content="➕ جديد"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80"
                                        Click="btnNew_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ═══ تبويب: البحث ═══ -->
            <TabItem Header="🔍 البحث">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="8,8,8,4"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📅 من تاريخ" Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtFromDate" Height="30"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="📅 إلى تاريخ" Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtToDate" Height="30"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="🔢 رقم السند" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtSrchNo"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="6"
                                    x:Name="btnSearch"
                                    Content="🔍 بحث"
                                    Style="{StaticResource ActionBtn}"
                                    Width="100"
                                    VerticalAlignment="Bottom"
                                    Click="btnSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- Search Results Grid -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="10"
                            Padding="0"
                            Margin="8,0,8,8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم"
                                                        Binding="{Binding id}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="📅 التاريخ"
                                                        Binding="{Binding date}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="💲 المبلغ"
                                                        Binding="{Binding val, StringFormat=N2}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="👤 الموظف"
                                                        Binding="{Binding empName}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
