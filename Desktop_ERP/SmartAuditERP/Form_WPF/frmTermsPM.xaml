<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmTermsPM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="بنـــد"
    Width="1160" Height="660"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#DAA520" Offset="0"/>
            <GradientStop Color="#B8860B" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="5"  ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
        </Style>
        <Style x:Key="BlueBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- شجرة البنود -->
                <ColumnDefinition Width="500"/>
                <!-- منطقة البيانات -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ شجرة البنود ═══ -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="6,6,3,4"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0" Padding="10,5">
                        <TextBlock Text="🌲 شجرة البنود"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cairo, Tahoma, Arial"/>
                    </Border>

                    <TreeView x:Name="treeView1"
                              Grid.Row="1"
                              Background="White"
                              BorderThickness="0"
                              FontFamily="Tahoma, Cairo"
                              FontSize="12" FontWeight="Bold"
                              FlowDirection="RightToLeft"
                              SelectedItemChanged="treeView1_SelectedItemChanged"
                              KeyDown="treeView1_KeyDown">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayText}"
                                           Padding="2"
                                           FontFamily="Tahoma, Cairo"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ═══ منطقة البيانات ═══ -->
            <Grid Grid.Column="1" Margin="3,6,6,4">
                <Grid.RowDefinitions>
                    <!-- GroupBox1: بيانات البند -->
                    <RowDefinition Height="Auto"/>
                    <!-- GBbranchAcc: بيانات البند الفرعي -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ─── GroupBox1: بيانات البند ─── -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="12,8"
                        Margin="0,0,0,4"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="7" Padding="10,4"
                                Margin="0,0,0,8">
                            <TextBlock Text="📋 بيانات البند"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       FontFamily="Cairo, Tahoma, Arial"/>
                        </Border>

                        <!-- Fields -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- الرقم -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="🔢 الرقم" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="Code"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <!-- الرئيسي -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="📑 نوع البند" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <RadioButton x:Name="main"
                                                 Content="رئيسي"
                                                 Style="{StaticResource ModernRadio}"
                                                 IsChecked="True"
                                                 Checked="main_Checked"/>
                                    <RadioButton x:Name="sub1"
                                                 Content="فرعي"
                                                 Style="{StaticResource ModernRadio}"
                                                 Checked="sub1_Checked"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- الاسم العربي -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="📝 الاسم:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AName"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- الاسم الإنجليزي -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="🔤 الاسم En:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNameEn"
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- الرئيسي -->
                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="🔗 الرئيسي:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ParentCode"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="ParentCode_SelectionChanged"/>
                            </StackPanel>

                        </Grid>
                    </Grid>
                </Border>

                <!-- ─── GBbranchAcc: بيانات البند الفرعي ─── -->
                <Border x:Name="GBbranchAcc"
                        Grid.Row="1"
                        Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="12,8"
                        Visibility="Collapsed"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource OrangeBrush}"
                                CornerRadius="7" Padding="10,4"
                                Margin="0,0,0,8">
                            <TextBlock Text="💼 بيانات البند الفرعي"
                                       Foreground="White" FontSize="12"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       FontFamily="Cairo, Tahoma, Arial"/>
                        </Border>

                        <!-- Fields -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- مدة التنفيذ -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="⏱ مدة التنفيذ (يوم)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAprxPeriod"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"/>
                            </StackPanel>

                            <!-- سعر البيع -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="💰 سعر البيع" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtprice"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"
                                         TextChanged="txtprice_TextChanged"/>
                            </StackPanel>

                            <!-- أقل سعر -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="💵 أقل سعر" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtLastPrice"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"/>
                            </StackPanel>

                            <!-- التكلفة -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="💲 التكلفة" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAprxCost"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="0"/>
                            </StackPanel>

                            <!-- معفي من الضريبة -->
                            <CheckBox Grid.Row="4" Grid.Column="0"
                                      x:Name="ckNoTax"
                                      Content="معفي من الضريبة"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="True"/>

                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnClose"
                        Content="✖ إغلاق"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource OrangeBtn}"
                            Width="80" Margin="0,0,4,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80" Margin="0,0,4,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource BlueBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>