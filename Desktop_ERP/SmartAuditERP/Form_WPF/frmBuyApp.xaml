<Window x:Class="SmartAuditERP.Form_WPF.frmBuyApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="شراء البرنامج"
        Width="560"
        Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Loaded="frmBuyApp_Load"
        Closed="Window_Closed">

    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00695C" Offset="0"/>
            <GradientStop Color="#00897B" Offset="0.5"/>
            <GradientStop Color="#26A69A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MainBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F4FFFD" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="22"
                          ShadowDepth="4"
                          Direction="270"
                          Opacity="0.32"
                          Color="#55000000"/>

        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00695C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="White"
                                    BorderBrush="#B2DFDB"
                                    BorderThickness="1.5"
                                    CornerRadius="14"
                                    Padding="14"
                                    Margin="0,12,0,0">
                                <ContentPresenter/>
                            </Border>

                            <Border Background="#E0F2F1"
                                    BorderBrush="#80CBC4"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,20,0"
                                    Padding="12,4">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyInfoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FAFFFE"/>
            <Setter Property="BorderBrush" Value="#CDEEE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#00ACC1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Effect="{StaticResource WindowShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource MainBrush}"
            BorderBrush="#B2DFDB"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource TopButtonStyle}"
                            Click="btnWindowClose_Click"
                            ToolTip="إغلاق">
                        <TextBlock Text="✖"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="💳" FontSize="24" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="شراء البرنامج"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="توليد كود التفعيل وتصدير ملف الترخيص"
                                       Foreground="#D7FFFA"
                                       FontFamily="Tahoma"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="18">
                <GroupBox x:Name="groupBox3"
                          Header="🛒 شراء البرنامج"
                          Style="{StaticResource ModernGroupBoxStyle}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="240"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#E8F5E9"
                                BorderBrush="#C8E6C9"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Text="ℹ️ بعد ظهور كود التفعيل يمكنك تصدير ملف الترخيص وإرساله للدعم الفني."
                                       Foreground="#1B5E20"
                                       FontFamily="Tahoma"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBox x:Name="textBox2"
                                 Grid.Row="1"
                                 Style="{StaticResource ReadOnlyInfoTextBoxStyle}"
                                 Text="⏳ انتظر جاري التحميل"/>

                        <Border x:Name="activationCodePanel"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Background="#E1F5FE"
                                BorderBrush="#81D4FA"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="🔐 كود التفعيل"
                                           Foreground="#01579B"
                                           FontFamily="Tahoma"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="textBox1"
                                         Style="{StaticResource CodeTextBoxStyle}"
                                         Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnExportdata"
                                Grid.Row="4"
                                Style="{StaticResource ExportButtonStyle}"
                                Click="btnExportdata_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="تصدير بيانات الترخيص"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Border>
</Window>