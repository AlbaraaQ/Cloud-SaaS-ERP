<Window x:Class="SmartAuditERP.Form_WPF.frmCashVoucherPM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🧾 سند قبض من عميل"
        Width="860"
        Height="530"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ═══════════════ GRADIENTS ═══════════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#283593" Offset="0.5"/>
            <GradientStop Color="#3949AB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolbarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#283593" Offset="0"/>
            <GradientStop Color="#1A237E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SectionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F7FF" Offset="0"/>
            <GradientStop Color="#EEF0FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════ SHADOWS ═══════════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="22" ShadowDepth="4"
                          Direction="270" Opacity="0.3"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="FieldShadow"
                          BlurRadius="5" ShadowDepth="1"
                          Direction="270" Opacity="0.1"
                          Color="#44000000"/>

        <!-- ═══════════════ TEXTBOX ═══════════════ -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Effect="{StaticResource FieldShadow}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3949AB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ECEFF5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C5CAE9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ READONLY TEXTBOX ═══════════════ -->
        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#ECEFF5"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════ MULTILINE TEXTBOX ═══════════════ -->
        <Style x:Key="MultiLineTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Height" Value="55"/>
        </Style>

        <!-- ═══════════════ COMBOBOX ═══════════════ -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════ DATEPICKER ═══════════════ -->
        <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <!-- ═══════════════ LABEL ═══════════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ═══════════════ RADIOBUTTON ═══════════════ -->
        <Style x:Key="ModernRadioStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#283593"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ═══════════════ SECTION HEADER ═══════════════ -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A237E"/>
        </Style>

        <!-- ═══════════════ SEARCH BUTTON ═══════════════ -->
        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C5CAE9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9FA8DA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ NAV BUTTON ═══════════════ -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Effect="{StaticResource FieldShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5C6BC0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#283593"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ ACTION BUTTON ═══════════════ -->
        <Style x:Key="ActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ═══════════════ CLOSE BUTTON ═══════════════ -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Effect="{StaticResource FieldShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF5350"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ DATAGRID ═══════════════ -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EAF6"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="AlternationCount" Value="2"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#283593"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C5CAE9"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self},
                             Path=AlternationIndex}" Value="1">
                    <Setter Property="Background" Value="#F8F9FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════ TAB CONTROL ═══════════════ -->
        <Style x:Key="ModernTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5C6BC0"/>
            <Setter Property="Background" Value="#E8EAF6"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3949AB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9FA8DA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ WIN CLOSE ICON BTN ═══════════════ -->
        <Style x:Key="WinCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════ WINDOW BORDER ═══════════════ -->
    <Border CornerRadius="16"
            Background="{StaticResource CardBrush}"
            BorderBrush="#C5CAE9"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════ -->
            <!--                 HEADER                  -->
            <!-- ═══════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- العنوان - يمين -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="🧾" FontSize="24"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="سند قبض من عميل"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="تسجيل وإدارة سندات القبض"
                                       Foreground="#9FA8DA"
                                       FontFamily="Tahoma"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- زر إغلاق - يسار -->
                    <Button Grid.Column="1"
                            Style="{StaticResource WinCloseButtonStyle}"
                            Click="btnClose_Click">
                        <TextBlock Text="✖"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════ -->
            <!--               TAB CONTROL               -->
            <!-- ═══════════════════════════════════════ -->
            <TabControl Grid.Row="1"
                        x:Name="TabControl1"
                        Style="{StaticResource ModernTabControlStyle}"
                        Margin="10,8,10,4">

                <!-- ─────────────────────────────────── -->
                <!--        تاب سندات القبض             -->
                <!-- ─────────────────────────────────── -->
                <TabItem Header="🧾  سندات قبض  "
                         Style="{StaticResource ModernTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6,8,6,6">

                            <!-- ── بيانات السند ── -->
                            <Border Background="{StaticResource SectionBrush}"
                                    BorderBrush="#C5CAE9"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Margin="0,0,0,8"
                                    Effect="{StaticResource CardShadow}">
                                <StackPanel>

                                    <!-- عنوان القسم -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,10">
                                        <TextBlock Text="📋" FontSize="15" Margin="6,0,0,0"/>
                                        <TextBlock Text="بيانات السند"
                                                   Style="{StaticResource SectionHeaderStyle}"/>
                                    </StackPanel>

                                    <!-- الصف الأول: رقم السند | التاريخ | قيمة السند | دفعة من حساب -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- رقم السند -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🔢 رقم السند"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtNo"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                     TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- التاريخ -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="📅 التاريخ"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <DatePicker x:Name="txtDate"
                                                        Style="{StaticResource ModernDatePickerStyle}"/>
                                        </StackPanel>

                                        <!-- قيمة السند -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="💵 قيمة السند"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtVal"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     TextChanged="txtVal_TextChanged"
                                                     GotFocus="txtVal_GotFocus"/>
                                        </StackPanel>

                                        <!-- دفعة من حساب -->
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="👤 دفعة من حساب"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="cmbAccounts"
                                                      Style="{StaticResource ModernComboBoxStyle}"
                                                      SelectionChanged="cmbAccounts_SelectionChanged"/>
                                        </StackPanel>

                                    </Grid>

                                    <!-- الصف الثاني: رصيد الحساب | نوع الرصيد -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- رصيد الحساب -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="💰 رصيد الحساب"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtBalance"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                     TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- نوع الرصيد -->
                                        <Border Grid.Column="2"
                                                CornerRadius="8"
                                                Background="#E8EAF6"
                                                BorderBrush="#C5CAE9"
                                                BorderThickness="1"
                                                Padding="12,4"
                                                VerticalAlignment="Bottom">
                                            <TextBlock x:Name="txtBalanceType"
                                                       FontFamily="Tahoma"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="#1A237E"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ── بيانات الدفع ── -->
                            <Border Background="{StaticResource SectionBrush}"
                                    BorderBrush="#C5CAE9"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Effect="{StaticResource CardShadow}">
                                <StackPanel>

                                    <!-- عنوان القسم + خيارات الدفع -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- خيارات الدفع -->
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                            <RadioButton x:Name="rdCash"
                                                         Style="{StaticResource ModernRadioStyle}"
                                                         Content="💵 نقدي"
                                                         IsChecked="True"
                                                         Checked="rdCash_CheckedChanged"/>
                                            <RadioButton x:Name="rdCheck"
                                                         Style="{StaticResource ModernRadioStyle}"
                                                         Content="🏦 تحويل بنكي"
                                                         Checked="rdCash_CheckedChanged"/>
                                        </StackPanel>

                                        <!-- ════════════ عناصر مخفية (مطلوبة برمجياً) ════════════ -->
                                        <StackPanel Visibility="Collapsed">
                                            <RadioButton x:Name="rdEmp" Content="موظف" IsChecked="True" Checked="rdPDeal_CheckedChanged"/>
                                            <RadioButton x:Name="rdPDeal" Content="جهة" Checked="rdPDeal_CheckedChanged"/>
                                            <ComboBox x:Name="cmbEmployee"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="💳" FontSize="15" Margin="6,0,0,0"/>
                                            <TextBlock Text="بيانات الدفع"
                                                       Style="{StaticResource SectionHeaderStyle}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- الصف الأول: يودع في | مندوب المبيعات -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- يودع في حساب -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🏛️ يودع في حساب"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="cmbEda3"
                                                      Style="{StaticResource ModernComboBoxStyle}"/>
                                        </StackPanel>

                                        <!-- مندوب المبيعات -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="👨‍💼 مندوب المبيعات"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox x:Name="cmbSalesMan"
                                                      Style="{StaticResource ModernComboBoxStyle}"/>
                                        </StackPanel>

                                        <!-- قيمة بالدولار -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="💲 القيمة بالدولار"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox x:Name="txtValD"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     TextChanged="txtValD_TextChanged"
                                                     GotFocus="txtValD_GotFocus"/>
                                        </StackPanel>

                                    </Grid>

                                    <!-- بيانات الشيك (تظهر عند اختيار تحويل بنكي) -->
                                    <Border x:Name="panelCheckDetails"
                                            Visibility="Collapsed"
                                            Background="#EEF0FF"
                                            BorderBrush="#9FA8DA"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🏦 بيانات الشيك"
                                                       Style="{StaticResource SectionHeaderStyle}"
                                                       Margin="0,0,0,8"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- رقم الشيك -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="🔢 رقم الشيك"
                                                               Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtCheckNo"
                                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                                <!-- تاريخ الاستحقاق -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="📅 تاريخ الاستحقاق"
                                                               Style="{StaticResource FieldLabelStyle}"/>
                                                    <DatePicker x:Name="txtCheckDate"
                                                                Style="{StaticResource ModernDatePickerStyle}"/>
                                                </StackPanel>

                                                <!-- حالة الشيك -->
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="📊 حالة الشيك"
                                                               Style="{StaticResource FieldLabelStyle}"/>
                                                    <ComboBox x:Name="cmbCheckType"
                                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                                </StackPanel>

                                                <!-- البنك المسحوب عليه -->
                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="🏛️ مسحوب على بنك"
                                                               Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBox x:Name="txtBankCheck"
                                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>

                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- البيان (ملاحظات) -->
                                    <StackPanel>
                                        <TextBlock Text="📝 البيان"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtNotes"
                                                 Style="{StaticResource MultiLineTextBoxStyle}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ─────────────────────────────────── -->
                <!--           تاب البحث                -->
                <!-- ─────────────────────────────────── -->
                <TabItem Header="🔍  البحث  "
                         Style="{StaticResource ModernTabItemStyle}">
                    <Grid Margin="6,8,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ── فلاتر البحث ── -->
                        <Border Grid.Row="0"
                                Background="{StaticResource SectionBrush}"
                                BorderBrush="#C5CAE9"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                Margin="0,0,0,8"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>

                                <!-- عنوان -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="🔍" FontSize="15" Margin="6,0,0,0"/>
                                    <TextBlock Text="البحث"
                                               Style="{StaticResource SectionHeaderStyle}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- زر البحث -->
                                    <Button Grid.Column="0"
                                            x:Name="btnSearch"
                                            Style="{StaticResource SearchButtonStyle}"
                                            Click="btnSearch_Click"
                                            ToolTip="بحث">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🔍" FontSize="20"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="بحث"
                                                       FontFamily="Tahoma"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#3949AB"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- رقم السند -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="🔢 رقم السند"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="txtSrchNo"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 TextAlignment="Center"
                                                 PreviewKeyDown="txtSrchNo_PreviewKeyDown"/>
                                    </StackPanel>

                                    <!-- من تاريخ -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="📅 من تاريخ"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker x:Name="txtFromDate"
                                                    Style="{StaticResource ModernDatePickerStyle}"/>
                                    </StackPanel>

                                    <!-- إلى تاريخ -->
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="📅 إلى تاريخ"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker x:Name="txtToDate"
                                                    Style="{StaticResource ModernDatePickerStyle}"/>
                                    </StackPanel>

                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── نتائج البحث ── -->
                        <Border Grid.Row="1"
                                BorderBrush="#C5CAE9"
                                BorderThickness="1"
                                CornerRadius="12"
                                ClipToBounds="True"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Border Background="#3949AB"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="📊" FontSize="14" Margin="6,0,0,0"/>
                                        <TextBlock Text="نتائج البحث"
                                                   Foreground="White"
                                                   FontFamily="Tahoma"
                                                   FontSize="13"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="dgvSrch"
                                          Style="{StaticResource ModernDataGridStyle}"
                                          SelectionChanged="dgvSrch_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="🔢 الرقم"
                                                            Binding="{Binding VoucherId}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="📅 التاريخ"
                                                            Binding="{Binding VoucherDate}"
                                                            Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="💵 المبلغ"
                                                            Binding="{Binding Amount}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="👤 المستخدم"
                                                            Binding="{Binding EmployeeName}"
                                                            Width="180">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </TabItem>

            </TabControl>

            <!-- ═══════════════════════════════════════ -->
            <!--                TOOLBAR                  -->
            <!-- ═══════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource ToolbarBrush}"
                    CornerRadius="0,0,16,16"
                    Effect="{StaticResource CardShadow}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- زر الإغلاق -->
                    <Button Grid.Column="0"
                            x:Name="btnClose"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="btnClose_Click"
                            ToolTip="إغلاق">
                        <TextBlock Text="✖" FontSize="16"/>
                    </Button>

                    <!-- أزرار التنقل -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="btnFirst"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnFirst_Click"
                                ToolTip="الأول">
                            <TextBlock Text="⏮" FontSize="16"/>
                        </Button>

                        <Button x:Name="btnPrevious"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnPrevious_Click"
                                ToolTip="السابق">
                            <TextBlock Text="◀" FontSize="16"/>
                        </Button>

                        <!-- مؤشر السجل -->
                        <Border Background="#22FFFFFF"
                                CornerRadius="8"
                                Padding="12,0"
                                Margin="4,0">
                            <TextBlock x:Name="txtRecordIndicator"
                                       Text="📍 سجل جديد"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button x:Name="btnNext"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnNext_Click"
                                ToolTip="التالي">
                            <TextBlock Text="▶" FontSize="16"/>
                        </Button>

                        <Button x:Name="btnLast"
                                Style="{StaticResource NavButtonStyle}"
                                Margin="3,0"
                                Click="btnLast_Click"
                                ToolTip="الأخير">
                            <TextBlock Text="⏭" FontSize="16"/>
                        </Button>

                    </StackPanel>

                    <!-- أزرار العمليات -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="btnNew"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="3,0"
                                Click="btnNew_Click"
                                ToolTip="جديد">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="جديد"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnDelete"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#E53935"
                                Margin="3,0"
                                Click="btnDelete_Click"
                                ToolTip="حذف">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑️" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="حذف"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnPrint"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#5C6BC0"
                                Margin="3,0"
                                Click="btnPrint_Click"
                                ToolTip="طباعة">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="طباعة"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnSave"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2E7D32"
                                Margin="3,0"
                                Click="btnSave_Click"
                                ToolTip="حفظ">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="حفظ"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>