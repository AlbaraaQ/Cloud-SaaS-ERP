<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmReGenerateEntries"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="صيانة القيود"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E67E22" Offset="0"/>
            <GradientStop Color="#CA6F1E" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
        </Style>

        <Style x:Key="ShowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E4E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,16,0"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ شريط الفلترة ═══ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="12,10"
                Effect="{StaticResource CardShadow}">
            <StackPanel>
                <!-- الصف الأول: التواريخ + النوع + الأزرار -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📅 من تاريخ:" Style="{StaticResource FieldLabel}"/>
                        <dxe:DateEdit x:Name="txtDateFrom"
                                      Height="30" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="📅 إلى تاريخ:" Style="{StaticResource FieldLabel}"/>
                        <dxe:DateEdit x:Name="txtDateTo"
                                      Height="30" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="📋 النوع:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbProcType"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="cmbProcType_SelectionChanged">
                            <ComboBoxItem Content="مشتريات"/>
                            <ComboBoxItem Content="مرتجع مشتريات"/>
                            <ComboBoxItem Content="مبيعات"/>
                            <ComboBoxItem Content="مرتجع مبيعات"/>
                            <ComboBoxItem Content="تأجير"/>
                            <ComboBoxItem Content="مرتجع تأجير"/>
                            <ComboBoxItem Content="نقاط بيع"/>
                            <ComboBoxItem Content="مرتجع نقاط بيع"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="btnShow"
                            Grid.Column="6"
                            Content="🔍 عرض"
                            Style="{StaticResource ShowBtn}"
                            Width="100"
                            VerticalAlignment="Bottom"
                            Click="btnShow_Click"/>

                    <Button x:Name="btnRegenerate"
                            Grid.Column="8"
                            Content="🔄 إعادة توليد القيود"
                            Style="{StaticResource WarnBtn}"
                            Width="150"
                            VerticalAlignment="Bottom"
                            Click="btnRegenerate_Click"/>
                </Grid>

                <!-- الصف الثاني: خيارات الضريبة -->
                <Border Background="#F8F9FD"
                        CornerRadius="7" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾 خيارات الضريبة:"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbAllVat"
                                     Content="الكل"
                                     IsChecked="True"
                                     FontWeight="Bold"
                                     Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbWithVAT"
                                     Content="مع الضريبة"
                                     FontWeight="Bold"
                                     Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbNoVAT"
                                     Content="بدون ضريبة"
                                     FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- ProgressBar -->
                <ProgressBar x:Name="ProgressBar1"
                             Height="5"
                             Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#2E4E9E"
                             Background="#E8EBF5"/>
            </StackPanel>
        </Border>

        <!-- ═══ جدول الفواتير ═══ -->
        <Border Grid.Row="1"
                Background="White"
                Margin="6,6,6,4"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="📋 الفواتير"
                               Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <DataGrid x:Name="GridControl1"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                          RowStyle="{StaticResource DgvRow}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          AlternatingRowBackground="#F8F9FD">
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center"
                                              Click="SelectAllRows_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="م"
                                            Binding="{Binding DgvNo}"
                                            Width="60" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="اسم الفاتورة"
                                            Binding="{Binding DgvInvName}"
                                            Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="رقم الفاتورة"
                                            Binding="{Binding DgvInvNo}"
                                            Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="رقم فاتورة المورد"
                                            Binding="{Binding DgvSuplierInvNo}"
                                            Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="التاريخ"
                                            Binding="{Binding DgvDate, StringFormat=d}"
                                            Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="المورد / العميل"
                                            x:Name="colDgvClient"
                                            Binding="{Binding DgvClient}"
                                            Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الرقم الضريبي"
                                            Binding="{Binding DgvVATNo}"
                                            Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding DgvSum2, StringFormat=N2}"
                                            Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الخصم"
                                            Binding="{Binding DgvDiscount, StringFormat=N2}"
                                            Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الصافي قبل الضريبة"
                                            Binding="{Binding DgvNetBeforVat, StringFormat=N2}"
                                            Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الضريبة"
                                            Binding="{Binding DgvVAT, StringFormat=N2}"
                                            Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الصافي"
                                            Binding="{Binding DgvNet, StringFormat=N2}"
                                            Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="نوع الفاتورة"
                                            Binding="{Binding DgvInvType}"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn Header="نوع العملية"
                                            Binding="{Binding DgvOperType}"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn Header="رقم القيد"
                                            Binding="{Binding DgvEntryNo}"
                                            Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="GlobalID"
                                            Binding="{Binding DgvInvGlobalID}"
                                            Visibility="Collapsed"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ شريط المجاميع ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="الإجمالي:" Style="{StaticResource SummaryLabel}" Foreground="White"/>
                <TextBlock x:Name="txtTot" Grid.Column="1" Text="0.00" Style="{StaticResource SummaryValue}" Foreground="White"/>

                <TextBlock Grid.Column="2" Text="الخصم:" Style="{StaticResource SummaryLabel}" Foreground="White"/>
                <TextBlock x:Name="txtTotDiscount" Grid.Column="3" Text="0.00" Style="{StaticResource SummaryValue}" Foreground="White"/>

                <TextBlock Grid.Column="4" Text="الصافي قبل الضريبة:" Style="{StaticResource SummaryLabel}" Foreground="White"/>
                <TextBlock x:Name="txtNetOutTax" Grid.Column="5" Text="0.00" Style="{StaticResource SummaryValue}" Foreground="White"/>

                <TextBlock Grid.Column="6" Text="الضريبة:" Style="{StaticResource SummaryLabel}" Foreground="White"/>
                <TextBlock x:Name="txtTotTax" Grid.Column="7" Text="0.00" Style="{StaticResource SummaryValue}" Foreground="White"/>

                <TextBlock Grid.Column="8" Text="الصافي:" Style="{StaticResource SummaryLabel}" Foreground="White"/>
                <TextBlock x:Name="txtNet" Grid.Column="9" Text="0.00" Style="{StaticResource SummaryValue}" Foreground="White"/>

                <TextBlock x:Name="lblCountsNo"
                           Grid.Column="11"
                           Text="عدد السجلات: 0"
                           Style="{StaticResource SummaryLabel}"
                           Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>