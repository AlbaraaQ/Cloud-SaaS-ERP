<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmManagement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="الإدارات"
    Width="640"
    Height="460"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmManagement_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.13"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="12,8">
            <TextBlock Text="🏢 الإدارات"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1"
                Background="White"
                Margin="8,6,8,4"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Input -->
                <Border Grid.Row="0"
                        Background="#F8FAFD"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Label1"
                                   Grid.Column="0"
                                   Text="🏢 اسم الإدارة"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtName"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 KeyDown="txtName_KeyDown"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid x:Name="dgvManagements"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowStyle="{StaticResource GridRowStyle}"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          AlternatingRowBackground="#F8F9FD"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E7ECF5"
                          Background="White"
                          MouseLeftButtonUp="dgvManagements_CellClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم"
                                            Binding="{Binding Column2}"
                                            Width="70"
                                            Visibility="Collapsed"/>
                        <DataGridTextColumn Header="🏢 اسم الإدارة"
                                            Binding="{Binding Column1}"
                                            Width="*"
                                            ElementStyle="{StaticResource GridCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖"
                        Style="{StaticResource DangerBtn}"
                        Width="44"
                        Margin="0,0,6,0"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnFirst"    Content="⏮" Style="{StaticResource NavBtn}" Margin="0,0,4,0" Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀" Style="{StaticResource NavBtn}" Margin="0,0,4,0" Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"     Content="▶" Style="{StaticResource NavBtn}" Margin="0,0,4,0" Click="btnNext_Click"/>
                    <Button x:Name="btnLast"     Content="⏭" Style="{StaticResource NavBtn}" Margin="0,0,8,0" Click="btnLast_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="btnDelete" Content="🗑️ حذف" Style="{StaticResource DangerBtn}" Width="80" Margin="0,0,6,0" Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"   Content="💾 حفظ" Style="{StaticResource SaveBtn}"   Width="80" Margin="0,0,6,0" Click="btnSave_Click"/>
                    <Button x:Name="btnNew"    Content="➕ جديد" Style="{StaticResource ActionBtn}" Width="80" Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>