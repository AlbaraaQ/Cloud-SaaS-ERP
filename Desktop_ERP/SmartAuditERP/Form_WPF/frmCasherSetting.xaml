<Window x:Class="SmartAuditERP.Form_WPF.frmCasherSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="⚙️ إعدادات الكاشير"
        Width="360"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Loaded="frmCasherSetting_Load">

    <Window.Resources>

        <!-- ═══════════════ GRADIENTS ═══════════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E65100" Offset="0"/>
            <GradientStop Color="#F57C00" Offset="0.5"/>
            <GradientStop Color="#FFA726" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F57F17" Offset="0"/>
            <GradientStop Color="#F9A825" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FFFDF5" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════ SHADOWS ═══════════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Direction="270" Opacity="0.28"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="FieldShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.1"
                          Color="#44000000"/>

        <!-- ═══════════════ CHECKBOX ═══════════════ -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ═══════════════ TEXTBOX ═══════════════ -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCC80"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Effect="{StaticResource FieldShadow}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#F57C00"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ LABEL ═══════════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5D4037"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ═══════════════ COMBOBOX ═══════════════ -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="BorderBrush" Value="#FFCC80"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- ═══════════════ SAVE BUTTON ═══════════════ -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SaveButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Effect="{StaticResource WindowShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ CLOSE BUTTON ═══════════════ -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════ WINDOW BORDER ═══════════════ -->
    <Border CornerRadius="16"
            Background="{StaticResource CardBrush}"
            BorderBrush="#FFCC80"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─── HEADER ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="Window_Close_Click">
                        <TextBlock Text="✖"/>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="⚙️" FontSize="22" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="إعدادات الكاشير"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <TextBlock Text="تهيئة خيارات نقطة البيع"
                                       Foreground="#FFE0B2"
                                       FontFamily="Tahoma"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── CONTENT ─── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,18,22,18">
                <StackPanel>

                    <!-- الباركود أوتوماتيك -->
                    <Border Background="#FFF3E0"
                            BorderBrush="#FFCC80"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <CheckBox x:Name="AutoCheck"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="📷 الباركود أوتوماتيك"
                                  Margin="0"/>
                    </Border>

                    <!-- دعم التاتش -->
                    <Border Background="#FFF3E0"
                            BorderBrush="#FFCC80"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <CheckBox x:Name="chkTouch"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="👆 الشاشة تدعم التاتش سكرين"
                                  Margin="0"/>
                    </Border>

                    <!-- عرض المجموعات والأصناف -->
                    <Border Background="#FFF3E0"
                            BorderBrush="#FFCC80"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <CheckBox x:Name="chkGroupsandItem"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="📦 عرض المجموعات والأصناف"
                                  Margin="0"/>
                    </Border>

                    <!-- قيمة التوصيل -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="🚗 قيمة التوصيل الافتراضية"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtDevM"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- قيمة التأمين -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="🛡️ قيمة التأمين الافتراضية"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="txtRahn"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <!-- الوحدة الافتراضية (مخفية) -->
                    <StackPanel Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock Text="📏 الوحدة الافتراضية"
                                   Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="cmbUnits"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- زر الحفظ -->
                    <Button x:Name="btnSave"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="btnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="حفظ الإعدادات"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>