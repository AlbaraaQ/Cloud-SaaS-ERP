<Window x:Class="SmartAuditERP.Form_WPF.frmBranches"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🏢 تعريف الفروع"
        Height="620" Width="780"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        Background="#F0F2F5"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ═══════════════════════════════════════════════════ -->
        <!--                    COLORS                          -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Color x:Key="PrimaryColor">#3F51B5</Color>
        <Color x:Key="PrimaryDarkColor">#283593</Color>
        <Color x:Key="AccentColor">#5C6BC0</Color>
        <Color x:Key="DangerColor">#C62828</Color>
        <Color x:Key="SuccessColor">#2E7D32</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--                 GRADIENTS                          -->
        <!-- ═══════════════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#283593" Offset="0"/>
            <GradientStop Color="#3F51B5" Offset="0.5"/>
            <GradientStop Color="#5C6BC0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolbarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3949AB" Offset="0"/>
            <GradientStop Color="#283593" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--                DROP SHADOWS                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="15" ShadowDepth="3"
                          Direction="270" Color="#20000000" Opacity="0.3"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Color="#40000000" Opacity="0.4"/>

        <DropShadowEffect x:Key="HeaderShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Color="#60000000" Opacity="0.5"/>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--               BUTTON STYLES                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF5350"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--               INPUT STYLES                         -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernMultiLineTextBox" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--               LABEL STYLE                          -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="GroupHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#283593"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--               CHECKBOX STYLE                       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--               DATAGRID STYLE                       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0FF"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#3949AB"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C5CAE9"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, 
                             Path=AlternationIndex}" Value="1">
                    <Setter Property="Background" Value="#F8F9FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="62"/>
            <!-- Toolbar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--                    HEADER                          -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Effect="{StaticResource HeaderShadow}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="🏢" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تعريف الفروع"
                                   Foreground="White"
                                   FontFamily="Tahoma"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="إدارة بيانات الفروع والحسابات المرتبطة"
                                   Foreground="#B0BEC5"
                                   FontFamily="Tahoma"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--                  MAIN CONTENT                      -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,8">
            <StackPanel>

                <!-- ─────────────────────────────────────────── -->
                <!--           CARD: بيانات أساسية              -->
                <!-- ─────────────────────────────────────────── -->
                <Border Margin="0,6"
                        Background="{StaticResource CardGradient}"
                        CornerRadius="12"
                        Effect="{StaticResource CardShadow}"
                        Padding="16,12">
                    <StackPanel>

                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="البيانات الأساسية"
                                       Style="{StaticResource GroupHeaderLabel}"/>
                        </StackPanel>

                        <Separator Background="#E8EAF6" Margin="0,0,0,12"/>

                        <!-- Row 1: الرمز | افتراضي | نشط | اسم الفرع -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <!-- اسم الفرع -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🏷️ اسم الفرع" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- الرمز -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="🔢 الرمز" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtCode"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <!-- افتراضي -->
                            <CheckBox x:Name="ckDefaultBranch"
                                      Grid.Column="4"
                                      Content="⭐ إفتراضي"
                                      Style="{StaticResource ModernCheckBox}"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,6"/>

                            <!-- نشط -->
                            <CheckBox x:Name="chkActive"
                                      Grid.Column="6"
                                      Content="✅ نشط"
                                      IsChecked="True"
                                      Style="{StaticResource ModernCheckBox}"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,6"/>

                        </Grid>

                        <!-- Row 2: البريد الإلكتروني | الجوال | تليفون -->
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📧 البريد الإلكتروني" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="📱 الجوال" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtMobile" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="📞 تليفون" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtTel" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: العنوان -->
                        <StackPanel Margin="0,4">
                            <TextBlock Text="📍 العنوان" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtAddress" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Row 4: ملاحظات -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="📝 ملاحظات" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtNotes" Style="{StaticResource ModernMultiLineTextBox}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ─────────────────────────────────────────── -->
                <!--        CARD: الحسابات المحاسبية            -->
                <!-- ─────────────────────────────────────────── -->
                <Border Margin="0,6"
                        Background="{StaticResource CardGradient}"
                        CornerRadius="12"
                        Effect="{StaticResource CardShadow}"
                        Padding="16,12">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="💰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الحسابات المحاسبية"
                                       Style="{StaticResource GroupHeaderLabel}"/>
                        </StackPanel>

                        <Separator Background="#E8EAF6" Margin="0,0,0,12"/>

                        <!-- Row 1: حساب العملاء | حساب الموردين | حساب الصندوق -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="👥 حساب العملاء" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbCustAcc"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="🏭 حساب الموردين" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbSuplierAcc"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="🏦 حساب الصندوق" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbTreasury"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: حساب المخزون | حساب البنك | مركز التكلفة -->
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📦 حساب المخزون" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbInventoryAcc"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="🏛️ حساب البنك" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbBankAcc"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="🎯 مركز التكلفة" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbCostCenter"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: حساب تطبيقات الدفع | حساب رواتب مستحقة -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="💳 حساب تطبيقات الدفع" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbAppAcc"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="💼 حساب رواتب مستحقة" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbsalary"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ─────────────────────────────────────────── -->
                <!--           CARD: بيانات الفروع (Grid)       -->
                <!-- ─────────────────────────────────────────── -->
                <Border Margin="0,6,0,10"
                        Background="{StaticResource CardGradient}"
                        CornerRadius="12"
                        Effect="{StaticResource CardShadow}"
                        Padding="16,12">
                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="قائمة الفروع"
                                       Style="{StaticResource GroupHeaderLabel}"/>
                        </StackPanel>

                        <Separator Background="#E8EAF6" Margin="0,0,0,8"/>

                        <DataGrid x:Name="dgvBranches"
                                  Style="{StaticResource ModernDataGrid}"
                                  Height="180"
                                  AlternationCount="2"
                                  SelectionChanged="dgvBranches_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الفرع"
                                                    Binding="{Binding BranchName}"
                                                    Width="160"/>
                                <DataGridTextColumn Header="📞 تليفون"
                                                    Binding="{Binding BranchTel}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="📱 جوال"
                                                    Binding="{Binding BranchMobile}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="📠 فاكس"
                                                    Binding="{Binding Fax}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="📧 بريد إلكتروني"
                                                    Binding="{Binding BranchEmail}"
                                                    Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!--                   TOOLBAR                          -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource ToolbarGradient}"
                Effect="{StaticResource HeaderShadow}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- إغلاق -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Navigation -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- زر الإغلاق -->
                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Style="{StaticResource DangerButtonStyle}"
                        Width="50"
                        Click="btnClose_Click"
                        ToolTip="إغلاق">
                    <TextBlock Text="✖" FontSize="18" Foreground="White"/>
                </Button>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button x:Name="btnFirst"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="3,0"
                            Click="btnFirst_Click"
                            ToolTip="الأول">
                        <TextBlock Text="⏮" FontSize="16" Foreground="White"/>
                    </Button>

                    <Button x:Name="btnPrevious"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="3,0"
                            Click="btnPrevious_Click"
                            ToolTip="السابق">
                        <TextBlock Text="◀" FontSize="16" Foreground="White"/>
                    </Button>

                    <!-- مؤشر السجل -->
                    <Border Background="#FFFFFF20" CornerRadius="6" Padding="12,0" Margin="4,0">
                        <TextBlock x:Name="txtRecordIndicator"
                                   Text="📍 سجل جديد"
                                   Foreground="White"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button x:Name="btnNext"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="3,0"
                            Click="btnNext_Click"
                            ToolTip="التالي">
                        <TextBlock Text="▶" FontSize="16" Foreground="White"/>
                    </Button>

                    <Button x:Name="btnLast"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="3,0"
                            Click="btnLast_Click"
                            ToolTip="الأخير">
                        <TextBlock Text="⏭" FontSize="16" Foreground="White"/>
                    </Button>

                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="btnNew"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="3,0"
                            Click="btnNew_Click"
                            ToolTip="إضافة سجل جديد">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="جديد" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnDelete"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#E53935"
                            Margin="3,0"
                            Click="btnDelete_Click"
                            ToolTip="حذف السجل المحدد">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="حذف" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSave"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#2E7D32"
                            Margin="3,0"
                            Click="btnSave_Click"
                            ToolTip="حفظ البيانات">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>