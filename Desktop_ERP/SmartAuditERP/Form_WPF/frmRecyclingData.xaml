<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRecyclingData"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تدوير البيانات"
    Width="720" Height="500"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="WizardPageCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ شريط العنوان والتقدم ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblWizardTitle"
                               Text="🔄 تدوير البيانات"
                               Foreground="White"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="lblWizardStep"
                               Text="الخطوة 1 من 8"
                               Foreground="#BDC3C7"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- مؤشر الخطوات -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="lblStepIndicator"
                               Text="● ○ ○ ○ ○ ○ ○ ○"
                               Foreground="White"
                               FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ محتوى الصفحات (WizardPages) ═══ -->
        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              Padding="12,8">
            <Grid>

                <!-- الصفحة 1: ترحيب -->
                <Border x:Name="Page1"
                Style="{StaticResource WizardPageCard}"
                Visibility="Visible">
                    <StackPanel>
                        <TextBlock Text="🔄 مرحباً في معالج تدوير البيانات"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           Margin="0,0,0,16"/>
                        <TextBlock Text="إن الشروع في هذه العملية يترتب عليها إنشاء قاعدة بيانات جديدة"
                           FontSize="13" Foreground="#1B2642"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="مع إمكانية إدراج التعاريف والحسابات"
                           FontSize="13" Foreground="#1B2642"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="وتوليد فاتورة أول مدة"
                           FontSize="13" Foreground="#1B2642"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Border Background="#FFF9E7"
                        CornerRadius="8" Padding="12,8"
                        Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="14"/>
                                <TextBlock Text="يُرجى التأكد من أخذ نسخة احتياطية قبل البدء"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#E67E22" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- الصفحة 2: إعداد قاعدة البيانات -->
                <Border x:Name="CreateDbPage2"
                Style="{StaticResource WizardPageCard}"
                Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🗄️ إعداد قاعدة البيانات الجديدة"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           Margin="0,0,0,16"/>

                        <TextBlock Text="الرجاء إدخال اسم قاعدة البيانات التي سيتم الاستيراد إليها"
                           FontSize="12" Foreground="#555"
                           Margin="0,0,0,12"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="اسم قاعدة البيانات:"
                               Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtDbName" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="📅 الفترة المحاسبية:"
                               Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <dxe:DateEdit x:Name="txtStartdate"
                                      Grid.Column="0"
                                      Height="30" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                   Text="~"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"/>
                                <dxe:DateEdit x:Name="txtEnddate"
                                      Grid.Column="2"
                                      Height="30" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="📂 مسار قاعدة البيانات:"
                               Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtPath"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"/>
                                <Button x:Name="btnPath"
                                Grid.Column="2"
                                Content="📂 ..."
                                Style="{StaticResource ActionBtn}"
                                Width="70"
                                Click="btnPath_Click"/>
                            </Grid>
                        </StackPanel>

                        <CheckBox x:Name="RePlaceInvoicesInLastPeriod"
                          Content="📋 نقل الفواتير والقيود خلال الفترة بين بداية الفترة المحاسبية حتى الآن"
                          FontSize="11" FontWeight="Bold"
                          Foreground="#1B2642"
                          Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- الصفحة 3 -->
                <Border x:Name="OptionsPage3"
                Style="{StaticResource WizardPageCard}"
                Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚙️ خيارات التدوير"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           Margin="0,0,0,16"/>

                        <TextBlock Text="اختر البيانات التي تريد تدويرها إلى قاعدة البيانات الجديدة:"
                           FontSize="12" Foreground="#555"
                           Margin="0,0,0,16"/>

                        <Border Background="#F8F9FD" CornerRadius="8" Padding="16,12">
                            <StackPanel>
                                <CheckBox x:Name="ckImportItems"
                                  Content="📦 تدوير بيانات المواد"
                                  IsChecked="True"
                                  FontSize="12" FontWeight="Bold"
                                  Foreground="#1B2642"
                                  Margin="0,0,0,10"/>
                                <CheckBox x:Name="ckcustomers"
                                  Content="👥 تدوير العملاء والموردين"
                                  IsChecked="True"
                                  FontSize="12" FontWeight="Bold"
                                  Foreground="#1B2642"
                                  Margin="0,0,0,10"/>
                                <CheckBox x:Name="ckImportUsers"
                                  Content="👤 تدوير بيانات المستخدمين والصلاحيات"
                                  IsChecked="True"
                                  FontSize="12" FontWeight="Bold"
                                  Foreground="#1B2642"
                                  Margin="0,0,0,10"/>
                                <CheckBox x:Name="ckAccounts"
                                  Content="📊 تدوير الحسابات"
                                  IsChecked="True"
                                  FontSize="12" FontWeight="Bold"
                                  Foreground="#1B2642"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- الصفحة 4 -->
                <Border x:Name="IntialReceiptsPage4"
                Style="{StaticResource WizardPageCard}"
                Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="📑 سند القيد الافتتاحي"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           Margin="0,0,0,16"/>

                        <Border Background="#F8F9FD" CornerRadius="8" Padding="16,12">
                            <StackPanel>
                                <RadioButton x:Name="rbInitialBalance"
                                     Content="✅ نعم: توليد قيد افتتاحي"
                                     IsChecked="True"
                                     FontSize="12" FontWeight="Bold"
                                     Foreground="#1B2642"
                                     Margin="0,0,0,12"/>
                                <RadioButton x:Name="rbNoIntialBalance"
                                     Content="❌ عدم توليد قيد افتتاحي"
                                     FontSize="12" FontWeight="Bold"
                                     Foreground="#1B2642"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- الصفحة 5 -->
                <Border x:Name="FirstStockPage5"
                Style="{StaticResource WizardPageCard}"
                Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🗃️ فواتير بضاعة أول مدة"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           Margin="0,0,0,16"/>

                        <Border Background="#F8F9FD" CornerRadius="8" Padding="16,12">
                            <StackPanel>
                                <RadioButton x:Name="rbFirstStockInv"
                                     Content="✅ نعم: توليد فواتير بضاعة أول مدة"
                                     IsChecked="True"
                                     FontSize="12" FontWeight="Bold"
                                     Foreground="#1B2642"
                                     Margin="0,0,0,12"/>
                                <RadioButton x:Name="rbNoFirstStockInv"
                                     Content="❌ عدم توليد فواتير بضاعة أول مدة"
                                     FontSize="12" FontWeight="Bold"
                                     Foreground="#1B2642"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- الصفحة 6 -->
                <Border x:Name="SubmittedPage6"
                Style="{StaticResource WizardPageCard}"
                Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="✔️ تأكيد تدوير قاعدة البيانات"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           Margin="0,0,0,16"/>

                        <TextBlock Text="تم تجميع كافة المعلومات الضرورية لتدوير قاعدة البيانات"
                           FontSize="12" Foreground="#1B2642"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="ستقوم هذه العملية بتدوير كافة البيانات المختارة من قاعدة البيانات الحالية إلى قاعدة البيانات الجديدة."
                           FontSize="12" Foreground="#1B2642"
                           TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <Border Background="#FFF3CD" CornerRadius="8" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="16"/>
                                <TextBlock Text="تحذير! هذه العملية لا يمكن التراجع عنها"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#856404" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- الصفحة 7 -->
                <Border x:Name="RecyclingPage"
                Style="{StaticResource WizardPageCard}"
                Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏳ يرجى الانتظار، جاري تدوير البيانات"
                           FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>
                        <ProgressBar x:Name="ProgressBar1"
                             Width="500" Height="24"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#2E4E9E"
                             Background="#E8EBF5"/>
                        <TextBlock x:Name="lblProgress"
                           Text="0%"
                           FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2E4E9E"
                           Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- الصفحة 8 -->
                <Border x:Name="CompletionPage7"
                Style="{StaticResource WizardPageCard}"
                Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✅"
                           FontSize="60"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                        <TextBlock Text="تم تدوير البيانات بنجاح"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#27AE60"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                        <TextBlock Text="تهانينا، تمت العملية بنجاح"
                           FontSize="14"
                           Foreground="#1B2642"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
        <!-- ProgressBar عام -->
        <ProgressBar x:Name="ProgressBarGeneral"
                     Grid.Row="2"
                     Height="6"
                     Margin="12,0"
                     Minimum="0" Maximum="8" Value="1"
                     Foreground="#2E4E9E"
                     Background="#E8EBF5"/>

        <!-- ═══ أزرار التنقل ═══ -->
        <Border Grid.Row="3"
                Background="#F0F2F7"
                BorderBrush="{StaticResource BorderLight}"
                FlowDirection="LeftToRight"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر الإلغاء/إغلاق -->
                <Button x:Name="btnCancel"
                        Grid.Column="0"
                        Content="✖ إلغاء"
                        Style="{StaticResource DangerBtn}"
                        Width="90"
                        Click="btnCancel_Click"/>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="btnPrevious"
                            Content="◀ رجوع"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="التالي ▶"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            Margin="0,0,8,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnFinish"
                            Content="✔ إنهاء"
                            Style="{StaticResource SaveBtn}"
                            Width="90"
                            Visibility="Collapsed"
                            Click="btnFinish_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>