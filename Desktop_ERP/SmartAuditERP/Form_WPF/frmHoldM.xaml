<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmHoldM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="ربط الفواتير"
    Width="660" Height="520"
    MinWidth="600" MinHeight="460"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B68EE" Offset="0"/>
            <GradientStop Color="#4B3DBF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══ Styles: Labels ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ═══ Styles: TextBox ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox مميز للوقت (لون مختلف) -->
        <Style x:Key="TimeTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Background" Value="#B0C4DE"/>
            <Setter Property="Foreground" Value="#00008B"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- ═══ Styles: ComboBox ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Styles: DatePicker ═══ -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Styles: Buttons ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="PrintBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- ═══ Styles: DataGrid ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenteredCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════ -->
    <!--              Main Layout                -->
    <!-- ═══════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Input Panel -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--         ROW 0 – Input Fields Panel        -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="14,10"
                Effect="{StaticResource CardShadow}">
            <StackPanel>

                <!-- عنوان الفورم -->
                <Border Background="{StaticResource HeaderBrush}"
                        CornerRadius="8"
                        Padding="12,7"
                        Margin="0,0,0,12">
                    <TextBlock Text="🔗 ربط الفواتير بالمراكب"
                               Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- الصف الأول: الفئة + رقم الفاتورة + التاريخ + الوقت -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <!-- الفئة -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📂 الفئة"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbGroup"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="cmbGroup_SelectionChanged"/>
                    </StackPanel>

                    <!-- رقم الفاتورة -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🧾 رقم الفاتورة"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNo"
                                 Style="{StaticResource ModernTextBox}"
                                 TextChanged="txtNo_TextChanged"/>
                    </StackPanel>

                    <!-- التاريخ -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="📅 التاريخ"
                                   Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="txtDate"
                                    Style="{StaticResource ModernDatePicker}"
                                    FlowDirection="RightToLeft"/>
                    </StackPanel>

                    <!-- الوقت -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="⏰ الوقت"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtTime"
                                 Style="{StaticResource TimeTextBox}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Grid>

                <!-- الصف الثاني: المركب + كود المركب -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- المركب -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🚢 المركب"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbMarine"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="cmbMarine_SelectionChanged"/>
                    </StackPanel>

                    <!-- كود المركب -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🔑 كود المركب"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMarineCode"
                                 Style="{StaticResource ModernTextBox}"
                                 TextChanged="txtMarineCode_TextChanged"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--         ROW 1 – DataGrid Panel            -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="White"
                Margin="8,6,8,0"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- عنوان الجدول -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="📋 قائمة الفواتير المعلقة"
                               Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <!-- DataGrid -->
                <DataGrid x:Name="dgvSrch"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                          RowStyle="{StaticResource DgvRow}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          AlternatingRowBackground="#F8F9FD"
                          BorderThickness="0"
                          MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">

                    <DataGrid.Columns>

                        <!-- رقم الحركة (مخفي) -->
                        <DataGridTextColumn Header="رقم الحركة"
                                            Binding="{Binding proc_id}"
                                            Width="80"
                                            Visibility="Collapsed"/>

                        <!-- الرقم -->
                        <DataGridTextColumn Header="🔢 الرقم"
                                            Binding="{Binding id}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- التاريخ -->
                        <DataGridTextColumn Header="📅 التاريخ"
                                            Binding="{Binding date}"
                                            Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- العميل -->
                        <DataGridTextColumn Header="👤 العميل"
                                            Binding="{Binding cust}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--         ROW 2 – Footer Buttons            -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="12,8"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل + إغلاق (يسار الـ RTL = يمين الشاشة) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">

                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="44"
                            ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>

                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>

                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>

                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>

                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- أزرار العمليات (يمين الـ RTL = يسار الشاشة) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnDelete_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintBtn}"
                            Width="88"
                            Margin="0,0,6,0"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnSave_Click"/>

                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>