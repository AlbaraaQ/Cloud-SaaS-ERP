<Window x:Class="SmartAuditERP.Form_WPF.frmCloseShiftInv"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📋 تفاصيل الإغلاق"
        Width="1060"
        Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ═══════════ GRADIENTS ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#283593" Offset="0.5"/>
            <GradientStop Color="#3949AB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════ SHADOWS ═══════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Direction="270" Opacity="0.28"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12"
                          Color="#44000000"/>

        <!-- ═══════════ WIN CLOSE ═══════════ -->
        <Style x:Key="WinCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ DATAGRID ═══════════ -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C5CAE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EAF6"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3949AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#283593"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EAF6"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C5CAE9"/>
                    <Setter Property="Foreground" Value="#1A237E"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self},
                             Path=AlternationIndex}" Value="1">
                    <Setter Property="Background" Value="#F8F9FF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border CornerRadius="0"
            Background="{StaticResource CardBrush}"
            BorderThickness="0"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── HEADER ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="22" Margin="8,0,0,0"/>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="تفاصيل الإغلاق"
                                       Foreground="White"
                                       FontFamily="Tahoma"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock Text="قائمة فواتير وسندات الوردية"
                                       Foreground="#9FA8DA"
                                       FontFamily="Tahoma"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WinCloseStyle}"
                            Click="Window_Close_Click">
                        <TextBlock Text="✖"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ─── DATAGRID ─── -->
            <Border Grid.Row="1"
                    Margin="8"
                    CornerRadius="10"
                    BorderBrush="#C5CAE9"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Effect="{StaticResource CardShadow}">
                <DataGrid x:Name="GridControl1"
                          Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="النوع"
                                            Binding="{Binding EntryType}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="🔢 الرقم"
                                            Binding="{Binding EntryNo}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📅 التاريخ"
                                            Binding="{Binding EntryDate}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="⏰ الوقت"
                                            Binding="{Binding EntryTime}"
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FlowDirection" Value="LeftToRight"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="💰 المجموع"
                                            Binding="{Binding SumDgv, StringFormat=\{0:0.##\}}"
                                            Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="🏷️ الخصم"
                                            Binding="{Binding DiscountDgv, StringFormat=\{0:0.##\}}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📊 الإجمالي"
                                            Binding="{Binding TotalDgv, StringFormat=\{0:0.##\}}"
                                            Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="🧾 الضريبة"
                                            Binding="{Binding VATDgv, StringFormat=\{0:0.##\}}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="💹 الصافي"
                                            Binding="{Binding NetDgv, StringFormat=\{0:0.##\}}"
                                            Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="💵 نقدي"
                                            Binding="{Binding CashDgv, StringFormat=\{0:0.##\}}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="🌐 شبكة"
                                            Binding="{Binding NetworkDgv, StringFormat=\{0:0.##\}}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📋 آجل"
                                            Binding="{Binding PostPoneSalesDgv, StringFormat=\{0:0.##\}}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="☕ الضيافة"
                                            Binding="{Binding HostingDgv, StringFormat=\{0:0.##\}}"
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ─── SUMMARY FOOTER ─── -->
            <Border Grid.Row="2"
                    Background="#E8EAF6"
                    BorderBrush="#C5CAE9"
                    BorderThickness="0,1,0,0"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="المجموع" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblSumTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1A237E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="الخصم" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblDiscountTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#E65100" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="الإجمالي" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblTotalTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1A237E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="الضريبة" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblVATTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1A237E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="الصافي" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblNetTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1B5E20" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                        <TextBlock Text="نقدي" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblCashTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1A237E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                        <TextBlock Text="شبكة" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblNetworkTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1A237E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="7" HorizontalAlignment="Center">
                        <TextBlock Text="آجل" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblPostPoneTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1A237E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                        <TextBlock Text="ضيافة" FontFamily="Tahoma" FontSize="10"
                                   FontWeight="Bold" Foreground="#5C6BC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblHostingTotal" Text="0.00"
                                   FontFamily="Tahoma" FontSize="12" FontWeight="Bold"
                                   Foreground="#1A237E" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>