<Window x:Class="SmartAuditERP.Form_WPF.frmApps"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📱 تعريف التطبيق" 
        Height="700" 
        Width="950"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        MinWidth="900"
        MinHeight="650">

    <Window.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#f8fafc" Offset="0"/>
            <GradientStop Color="#e2e8f0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#5568d3" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="10" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SmallAddButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#10b981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="5" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#667eea"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#f8fafc"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- TabControl Style -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="White" 
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                CornerRadius="8,8,0,0"
                                Padding="25,12"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#667eea"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#f1f5f9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

    </Window.Resources>

    <Border CornerRadius="15" Background="{StaticResource BackgroundGradient}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="20" ShadowDepth="5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderGradient}" 
                    CornerRadius="10" 
                    Padding="20,15"
                    Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="10" ShadowDepth="3"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="📱 تعريف التطبيق والمؤسسة" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Right"/>
                    <Button x:Name="btnClose"
                            HorizontalAlignment="Left"
                            Width="35" Height="35"
                            Background="#dc2626"
                            BorderThickness="0"
                            ToolTip="إغلاق"
                            Cursor="Hand"
                            Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="8">
                                    <TextBlock Text="✖" 
                                               FontSize="18" 
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- TabControl -->
            <TabControl Grid.Row="1" 
                        Style="{StaticResource ModernTabControl}"
                        Margin="0,0,0,15">

                <!-- Tab 1: General Information -->
                <TabItem Header="📋 عــــام" Style="{StaticResource ModernTabItem}">
                    <Border Background="White" 
                            CornerRadius="0,10,10,10" 
                            Padding="20"
                            Margin="0,5,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                        </Border.Effect>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Basic Information -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 1 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="📱 اسم التطبيق" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtName"
                                             Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <TextBlock Grid.Row="0" Grid.Column="3" 
                                               Text="📞 الجوال" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtMobile"
                                             Grid.Row="0" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <!-- Row 2 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="🏢 اسم المؤسسة" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtFoundation"
                                             Grid.Row="2" Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="3" 
                                               Text="📄 رقم الترخيص" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtLicense"
                                             Grid.Row="2" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <!-- Row 3 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" 
                                               Text="💰 الأسعار" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <ComboBox x:Name="cmbPrices"
                                              Grid.Row="4" Grid.Column="1"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="3" 
                                               Text="🔢 الرقم الضريبي" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtTaxNo"
                                             Grid.Row="4" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <!-- Row 4: Account Code -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" 
                                               Text="🧾 رقم الحساب" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <Grid Grid.Row="6" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtAccCode"
                                                 Grid.Column="0"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 TextChanged="txtAccCode_TextChanged"/>
                                        <Button x:Name="btnSelectAccount"
                                                Grid.Column="1"
                                                Content="..."
                                                Background="#667eea"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Margin="3,0,0,0"
                                                Cursor="Hand"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Visibility="Collapsed"
                                                Click="Button1_Click"/>
                                    </Grid>

                                    <!-- Row 5: Payment Type -->
                                    <TextBlock Grid.Row="6" Grid.Column="3" 
                                               Text="💳 النوع" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <StackPanel Grid.Row="6" Grid.Column="4" 
                                                Orientation="Horizontal">
                                        <RadioButton x:Name="rbCash"
                                                     Content="💵 نقدي"
                                                     IsChecked="True"
                                                     Margin="0,0,20,0"
                                                     VerticalAlignment="Center"
                                                     FontWeight="SemiBold"/>
                                        <RadioButton x:Name="rbPostPone"
                                                     Content="📅 آجل"
                                                     VerticalAlignment="Center"
                                                     FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- App Data Grid -->
                                <Border Background="White" 
                                        CornerRadius="8" 
                                        Padding="10"
                                        Margin="0,20,0,0"
                                        BorderBrush="#e2e8f0"
                                        BorderThickness="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="📊 بيانات التطبيق"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#667eea"
                                                   Margin="0,0,0,10"/>

                                        <DataGrid x:Name="dgvApp"
                                                  Grid.Row="1"
                                                  Style="{StaticResource ModernDataGrid}"
                                                  Height="180">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="📝 الاسم" 
                                                                    Binding="{Binding Name}" 
                                                                    Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Tab 2: Additional Information -->
                <TabItem Header="📍 بيانات إضافية" Style="{StaticResource ModernTabItem}">
                    <Border Background="White" 
                            CornerRadius="0,10,10,10" 
                            Padding="20"
                            Margin="0,5,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                        </Border.Effect>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Location Information -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 1 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="🌍 الدولة" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbCountry"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"
                                                  SelectionChanged="cmbCountry_SelectionChanged"/>
                                        <Button x:Name="btnCountryAdd"
                                                Grid.Column="1"
                                                Content="➕"
                                                Style="{StaticResource SmallAddButton}"
                                                ToolTip="إضافة دولة"
                                                Click="btnCountryAdd_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="0" Grid.Column="3" 
                                               Text="☎️ رقم الهاتف" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtTel"
                                             Grid.Row="0" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <!-- Row 2 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="🏙️ المدينة" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <Grid Grid.Row="2" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbCity"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"
                                                  SelectionChanged="cmbCity_SelectionChanged"/>
                                        <Button x:Name="btnCityAdd"
                                                Grid.Column="1"
                                                Content="➕"
                                                Style="{StaticResource SmallAddButton}"
                                                ToolTip="إضافة مدينة"
                                                Click="btnCityAdd_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Grid.Column="3" 
                                               Text="📧 البريد الإلكتروني" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtEmail"
                                             Grid.Row="2" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <!-- Row 3 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" 
                                               Text="📍 المنطقة" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <Grid Grid.Row="4" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbArea"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"/>
                                        <Button x:Name="btnAreaAdd"
                                                Grid.Column="1"
                                                Content="➕"
                                                Style="{StaticResource SmallAddButton}"
                                                ToolTip="إضافة منطقة"
                                                Click="btnAreaAdd_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="4" Grid.Column="3" 
                                               Text="📠 فاكس" 
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtFax"
                                             Grid.Row="4" Grid.Column="4"
                                             Style="{StaticResource ModernTextBox}"/>

                                    <!-- Row 4: Notes -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" 
                                               Text="📝 ملاحظات" 
                                               Style="{StaticResource ModernLabel}"
                                               VerticalAlignment="Top"
                                               Margin="0,8,10,0"/>
                                    <TextBox x:Name="txtNotes"
                                             Grid.Row="6" Grid.Column="1"
                                             Grid.ColumnSpan="4"
                                             Style="{StaticResource ModernTextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="80"
                                             VerticalContentAlignment="Top"
                                             Padding="8"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Tab 3: Search -->
                <TabItem Header="🔍 البحــــــث" Style="{StaticResource ModernTabItem}">
                    <Border Background="White" 
                            CornerRadius="0,10,10,10" 
                            Padding="20"
                            Margin="0,5,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="10" ShadowDepth="3"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search Panel -->
                            <Border Grid.Row="0"
                                    Background="#f8fafc"
                                    CornerRadius="8"
                                    Padding="20"
                                    BorderBrush="#e2e8f0"
                                    BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="🔍 الاسم"
                                               Style="{StaticResource ModernLabel}"/>
                                    <TextBox x:Name="txtNameSrch"
                                             Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"
                                             KeyDown="txtNameSrch_KeyPress"/>
                                    <Button x:Name="btnSearch"
                                            Grid.Column="2"
                                            Content="🔎 بحث"
                                            Background="{StaticResource PrimaryButtonGradient}"
                                            Foreground="White"
                                            Style="{StaticResource ModernButton}"
                                            Height="35"
                                            Margin="10,0,0,0"
                                            Click="btnSearch_Click"/>
                                </Grid>
                            </Border>

                            <!-- Search Results -->
                            <Border Grid.Row="2"
                                    Background="White"
                                    CornerRadius="8"
                                    Padding="10"
                                    BorderBrush="#e2e8f0"
                                    BorderThickness="2">
                                <DataGrid x:Name="dgvSrch"
                                          Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" 
                                                            Binding="{Binding Id}" 
                                                            Visibility="Collapsed"/>
                                        <DataGridTextColumn Header="📱 اسم التطبيق" 
                                                            Binding="{Binding Name}" 
                                                            Width="180"/>
                                        <DataGridTextColumn Header="🏢 اسم المؤسسة" 
                                                            Binding="{Binding FoundationName}" 
                                                            Width="*"/>
                                        <DataGridTextColumn Header="📄 رقم الترخيص" 
                                                            Binding="{Binding License}" 
                                                            Width="120"/>
                                        <DataGridTextColumn Header="☎️ الهاتف" 
                                                            Binding="{Binding Tel}" 
                                                            Width="100"/>
                                        <DataGridTextColumn Header="📞 الجوال" 
                                                            Binding="{Binding Mobile}" 
                                                            Width="100"/>
                                        <DataGridTextColumn Header="🌍 الدولة" 
                                                            Binding="{Binding Country}" 
                                                            Width="100"/>
                                        <DataGridTextColumn Header="🏙️ المدينة" 
                                                            Binding="{Binding City}" 
                                                            Width="100"/>
                                        <DataGridTextColumn Header="📍 المنطقة" 
                                                            Binding="{Binding Area}" 
                                                            Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem>

            </TabControl>

            <!-- Action Buttons -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Width="70" Height="50"
                            Background="{StaticResource PrimaryButtonGradient}"
                            Foreground="White"
                            Style="{StaticResource ModernButton}"
                            Click="btnNew_Click"/>

                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Width="70" Height="50"
                            Background="{StaticResource PrimaryButtonGradient}"
                            Foreground="White"
                            Style="{StaticResource ModernButton}"
                            Click="btnSave_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Width="75" Height="50"
                            Background="{StaticResource PrimaryButtonGradient}"
                            Foreground="White"
                            Style="{StaticResource ModernButton}"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Width="70" Height="50"
                            Background="#ef4444"
                            Foreground="White"
                            Style="{StaticResource ModernButton}"
                            Click="btnDelete_Click"/>

                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button x:Name="btnLast"
                            Content="⏭️"
                            FontSize="20"
                            Style="{StaticResource NavButton}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>

                    <Button x:Name="btnNext"
                            Content="▶️"
                            FontSize="20"
                            Style="{StaticResource NavButton}"
                            ToolTip="التالي"
                            Click="btnNext_Click"/>

                    <Button x:Name="btnPrevious"
                            Content="◀️"
                            FontSize="20"
                            Style="{StaticResource NavButton}"
                            ToolTip="السابق"
                            Click="btnPrevious_Click"/>

                    <Button x:Name="btnFirst"
                            Content="⏮️"
                            FontSize="20"
                            Style="{StaticResource NavButton}"
                            ToolTip="الأول"
                            Click="btnFirst_Click"/>

                </StackPanel>
            </Grid>

        </Grid>
    </Border>
