<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptProducedItems"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تقرير مواد المنتجة"
    Width="1000" Height="600"
    MinWidth="900" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A90D9" Offset="0"/>
            <GradientStop Color="#2E6DA8" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="PrintBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE6F8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1B3A6B"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFE082"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Summary -->
            <RowDefinition Height="Auto"/>
            <!-- ProgressBar -->
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- من تاريخ -->
                <TextBlock Grid.Column="0"
                           Text="من تاريخ"
                           Foreground="White" FontWeight="Bold" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <dxe:DateEdit x:Name="txtDateFrom"
                              Grid.Column="1"
                              Height="32" Width="130"
                              FontSize="12" Margin="0,0,10,0"/>

                <!-- إلى تاريخ -->
                <TextBlock Grid.Column="2"
                           Text="إلى تاريخ"
                           Foreground="White" FontWeight="Bold" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <dxe:DateEdit x:Name="txtDateTo"
                              Grid.Column="3"
                              Height="32" Width="130"
                              FontSize="12" Margin="0,0,10,0"/>

                <!-- تفصيلي -->
                <CheckBox x:Name="CheckBox1"
                          Grid.Column="4"
                          Content="تفصيلي"
                          Foreground="White" FontWeight="Bold" FontSize="11"
                          VerticalAlignment="Center" Margin="0,0,10,0"
                          Checked="CheckBox1_CheckedChanged"
                          Unchecked="CheckBox1_CheckedChanged"/>

                <!-- زر عرض -->
                <Button x:Name="btnShow"
                        Grid.Column="5"
                        Content="🔍 عرض"
                        Style="{StaticResource ActionBtn}"
                        Width="80" Margin="0,0,6,0"
                        Click="btnShow_Click"/>

                <!-- زر جديد -->
                <Button x:Name="clear"
                        Grid.Column="7"
                        Content="➕ جديد"
                        Style="{StaticResource ActionBtn}"
                        Width="80" Margin="0,0,6,0"
                        Click="clear_Click"/>

                <!-- زر معاينة -->
                <Button x:Name="btnPreview"
                        Grid.Column="8"
                        Content="👁️ معاينة"
                        Style="{StaticResource PrintBtn}"
                        Width="80" Margin="0,0,6,0"
                        Click="btnPreview_Click"/>

                <!-- زر طباعة -->
                <Button x:Name="btnPrint"
                        Grid.Column="9"
                        Content="🖨️ طباعة"
                        Style="{StaticResource PrintBtn}"
                        Width="80" Margin="0,0,6,0"
                        Click="btnPrint_Click"/>

                <!-- زر خروج -->
                <Button x:Name="btnClose"
                        Grid.Column="10"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Click="btnClose_Click"/>

            </Grid>
        </Border>

        <!-- ═══ منطقة الجداول ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- جدول المكونات (مخفي حتى تفصيلي) -->
                <ColumnDefinition x:Name="colComponents" Width="0"/>
                <!-- جدول المنتجات الرئيسي -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- جدول المكونات - PnlComponents -->
            <Border Grid.Column="0"
                    x:Name="PnlComponents"
                    Background="White"
                    Margin="4,4,2,4"
                    CornerRadius="8"
                    Effect="{StaticResource CardShadow}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="🔧 المكونات"
                                   Foreground="White" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="dgvComponent"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNum}" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الكمية"
                                                Binding="{Binding Quantity, StringFormat=N2}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="السعر"
                                                Binding="{Binding Price, StringFormat=N4}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المجموع"
                                                Binding="{Binding Total, StringFormat=N4}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- جدول المنتجات الرئيسي - dgvItems -->
            <Border Grid.Column="1"
                    Background="White"
                    Margin="2,4,4,4"
                    CornerRadius="8"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="🏭 المواد المنتجة"
                                   Foreground="White" FontWeight="Bold" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <DataGrid x:Name="dgvItems"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              RowStyle="{StaticResource DgvRow}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="dgvItems_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding RowNum}"
                                                Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الصنف"
                                                Binding="{Binding ItemName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الوحدة"
                                                Binding="{Binding UnitName}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="الكمية"
                                                Binding="{Binding Quantity, StringFormat=N2}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="السعر"
                                                Binding="{Binding Price, StringFormat=N4}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المجموع"
                                                Binding="{Binding Total, StringFormat=N4}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- ItemID مخفي -->
                            <DataGridTextColumn Header="ItemID"
                                                Binding="{Binding ItemId}"
                                                Width="0"
                                                Visibility="Collapsed"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ بطاقات الملخص ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="10,6">
            <UniformGrid Rows="1" Columns="4">

                <!-- إجمالي المواد -->
                <StackPanel HorizontalAlignment="Center" Margin="4,0">
                    <TextBlock Text="🏭 إجمالي المواد"
                               Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="txtItemQuan"
                               Text="0"
                               Style="{StaticResource SummaryValue}"/>
                </StackPanel>

                <!-- إجمالي الرصيد -->
                <StackPanel HorizontalAlignment="Center" Margin="4,0">
                    <TextBlock Text="📦 إجمالي الرصيد"
                               Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="txtTotStock"
                               Text="0.00"
                               Style="{StaticResource SummaryValue}"/>
                </StackPanel>

                <!-- إجمالي التكلفة -->
                <StackPanel HorizontalAlignment="Center" Margin="4,0">
                    <TextBlock Text="💰 إجمالي التكلفة"
                               Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="txtSum"
                               Text="0.00"
                               Style="{StaticResource SummaryValue}"/>
                </StackPanel>

                <!-- إجمالي البيع -->
                <StackPanel HorizontalAlignment="Center" Margin="4,0">
                    <TextBlock Text="💵 إجمالي البيع"
                               Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="txtSum2"
                               Text="0.00"
                               Style="{StaticResource SummaryValue}"/>
                </StackPanel>

            </UniformGrid>
        </Border>

        <!-- شريط التقدم -->
        <ProgressBar x:Name="ProgressBar1"
                     Grid.Row="3"
                     Height="12"
                     Minimum="0" Maximum="100" Value="0"
                     Foreground="{StaticResource HeaderBrush}"
                     Background="#E0E4EF"
                     Margin="4,2"/>

    </Grid>
</dx:ThemedWindow>