<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmItemM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="بطاقة مركب"
    Width="1020"
    Height="640"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmItemM_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,10">
                <TextBlock Text="⚓ بيانات المركب"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Input Fields -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="رقم العضوية" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtNo" Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="🏷️ الفئة" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbGroup"
                                  Grid.Column="0"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="cmbGroup_SelectedIndexChanged"/>
                        <TextBox x:Name="txtgroupCode"
                                 Grid.Column="2"
                                 Style="{StaticResource ModernTextBox}"
                                 TextChanged="txtgroupCode_TextChanged"/>
                    </Grid>

                    <!-- Row 2 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="🚢 اسم المركب" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtName"
                             Grid.Row="2" Grid.Column="1"
                             Grid.ColumnSpan="7"
                             Style="{StaticResource ModernTextBox}"
                             KeyDown="txtName_KeyDown"/>

                    <!-- Row 4 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="👤 المالك" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbOwners"
                                  Grid.Column="0"
                                  Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="name"
                                  SelectedValuePath="id"/>
                        <Button x:Name="btnAddOwner"
                                Grid.Column="2"
                                Content="➕"
                                Style="{StaticResource ActionBtn}"
                                Height="34"
                                FontSize="16"
                                ToolTip="إضافة مالك جديد"
                                Click="btnAddOwner_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="6" Text="نسبة المالك %" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtOwnerPerc"
                             Grid.Row="4" Grid.Column="7"
                             Style="{StaticResource ModernTextBox}"
                             TextAlignment="Center"/>

                    <!-- Row 6 -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="🔢 رقم المركب" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtMarinacode"
                             Grid.Row="6" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             TextAlignment="Center"/>

                    <TextBlock Grid.Row="6" Grid.Column="3" Text="👥 عدد الركاب" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPsngerNo"
                             Grid.Row="6" Grid.Column="4"
                             Style="{StaticResource ModernTextBox}"
                             TextAlignment="Center"/>

                    <CheckBox x:Name="clk_Inplan"
                              Grid.Row="6" Grid.Column="6"
                              Grid.ColumnSpan="2"
                              Content="📋 ضمن خطة الدور"
                              IsChecked="True"
                              Style="{StaticResource ModernCheckBox}"
                              VerticalAlignment="Center"/>

                    <!-- Row 8: Search -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="🔍 بحث بالفئة" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSrchGrp"
                             Grid.Row="8" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Grid.Row="8" Grid.Column="3" Text="رقم العضوية" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSrchNo"
                             Grid.Row="8" Grid.Column="4"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Grid.Row="8" Grid.Column="6" Text="اسم المالك" Style="{StaticResource FieldLabel}"/>
                    <Grid Grid.Row="8" Grid.Column="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSrchOwn"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"/>
                        <Button x:Name="btnSrch"
                                Grid.Column="2"
                                Content="🔍"
                                Style="{StaticResource ActionBtn}"
                                Height="34"
                                FontSize="16"
                                Click="btnSrch_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- DataGrid -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="⚓ قائمة المراكب"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <DataGrid x:Name="dgvData"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource GridRowStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              AlternatingRowBackground="#F8F9FD"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E7ECF5"
                              Background="White"
                              MouseLeftButtonUp="dgvData_CellClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفئة"
                                                Binding="{Binding Column3}"
                                                Width="90"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="رقم العضوية"
                                                Binding="{Binding Column1}"
                                                Width="110"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="رقم المركب"
                                                Binding="{Binding Column2}"
                                                Width="120"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="اسم المركب"
                                                Binding="{Binding Column5}"
                                                Width="*"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridTextColumn Header="اسم المالك"
                                                Binding="{Binding Column4}"
                                                Width="180"
                                                ElementStyle="{StaticResource GridCellText}"/>

                            <DataGridCheckBoxColumn Header="ضمن الخطة"
                                                    Binding="{Binding Column6}"
                                                    Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖"
                        Style="{StaticResource DangerBtn}"
                        Width="44"
                        Margin="0,0,6,0"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnFirst" Content="⏮" Style="{StaticResource NavBtn}" Margin="0,0,4,0" Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀" Style="{StaticResource NavBtn}" Margin="0,0,4,0" Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext" Content="▶" Style="{StaticResource NavBtn}" Margin="0,0,4,0" Click="btnNext_Click"/>
                    <Button x:Name="btnLast" Content="⏭" Style="{StaticResource NavBtn}" Margin="0,0,8,0" Click="btnLast_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="btnDelete" Content="🗑️ حذف" Style="{StaticResource DangerBtn}" Width="80" Margin="0,0,6,0" Click="btnDelete_Click"/>
                    <Button x:Name="btnSave" Content="💾 حفظ" Style="{StaticResource SaveBtn}" Width="80" Margin="0,0,6,0" Click="btnSave_Click"/>
                    <Button x:Name="btnNew" Content="➕ جديد" Style="{StaticResource ActionBtn}" Width="80" Click="btnNew_Click"/>
                    <Button x:Name="btnPrint" Content="🖨️" Style="{StaticResource ActionBtn}" Width="44" Margin="6,0,0,0" Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>