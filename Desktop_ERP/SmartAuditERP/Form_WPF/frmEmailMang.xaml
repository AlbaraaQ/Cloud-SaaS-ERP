<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmEmailMang"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="📧 البريد الإلكتروني"
    Width="500" Height="480"
    MinWidth="460" MinHeight="440"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ShowIcon="False"
    ResizeMode="CanResizeWithGrip">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SendBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"       Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height"              Value="32"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Background"          Value="White"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Padding"             Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="MinWidth"        Value="100"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Effect"          Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10"
                Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📧" FontSize="20"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="إرسال بريد إلكتروني"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content Card -->
        <Border Grid.Row="1"
                Margin="10,8,10,6"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- To -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="📨 إلى:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtTo"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Subject -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="📌 الموضوع:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSubject"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="54"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Padding="8,6"/>
                    </StackPanel>

                    <!-- Body -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="📝 المحتوى:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtBody"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="130"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="8,6"/>
                    </StackPanel>

                    <!-- Attachments -->
                    <Border Background="#F8FAFF"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,6">
                                <TextBlock Text="📎 المرفقات:"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,10,0"/>
                                <TextBlock x:Name="lnkAttachment"
                                           Text="+ إرفاق ملف"
                                           Foreground="#3A63C3"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Cursor="Hand"
                                           TextDecorations="Underline"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           MouseLeftButtonDown="LnkAttachment_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="lblAttachments"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#546E7A"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Sender Email -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="📤 إيميل المرسل:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtEmail"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Text="🔒 كلمة المرور:"
                                   Style="{StaticResource FieldLabel}"/>
                        <dxe:PasswordBoxEdit x:Name="txtPassword"
                                             Height="32"
                                             FontSize="13"
                                             Background="White"
                                             BorderBrush="{StaticResource BorderLight}"
                                             BorderThickness="1"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="12,8">
            <Button x:Name="btnSend"
                    Content="📤 إرسال"
                    HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                        <Setter Property="Background" Value="{StaticResource SendBrush}"/>
                        <Setter Property="MinWidth" Value="150"/>
                    </Style>
                </Button.Style>
            </Button>
        </Border>

    </Grid>
</dx:ThemedWindow>