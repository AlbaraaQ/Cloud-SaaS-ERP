<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmFPSSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="⚙ إعدادات جهاز البصمة"
    Width="580" Height="260"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    ResizeMode="NoResize"
    ShowIcon="False"
    FontFamily="Cairo, Tahoma, Arial"
    Background="#F3F5F9"
    Loaded="frmSetting_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ConnectBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E88E5" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LoadBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FB8C00" Offset="0"/>
            <GradientStop Color="#E65100" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10">
            <TextBlock Text="⚙ إعدادات جهاز البصمة"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                Margin="10,8,10,4"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="IP :"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,0,10,8"/>
                <TextBox x:Name="txtIP"
                         Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,8"/>
                <Button x:Name="btnConnect"
                        Grid.Row="0" Grid.Column="2"
                        Content="🔌 Connect"
                        Background="{StaticResource ConnectBrush}"
                        Style="{StaticResource ActionBtn}"
                        Width="110"
                        Margin="8,0,0,8"
                        Click="btnConnect_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Port :"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,0,10,8"/>
                <TextBox x:Name="txtPort"
                         Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,8"/>
                <Button x:Name="btnGetGeneralLogData"
                        Grid.Row="1" Grid.Column="2"
                        Content="📥 تحميل يدوي"
                        Background="{StaticResource LoadBrush}"
                        Style="{StaticResource ActionBtn}"
                        Width="110"
                        Margin="8,0,0,8"
                        Click="Button1_Click"/>

                <CheckBox x:Name="ckConnectAuto"
                          Grid.Row="2" Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Content="🔄 الاتصال التلقائي عند فتح البرنامج"
                          FontFamily="Tahoma"
                          FontSize="12"
                          FontWeight="Bold"
                          Foreground="#1B2642"
                          Cursor="Hand"
                          Margin="0,4,0,8"/>

                <TextBlock x:Name="lblState"
                           Grid.Row="3" Grid.Column="0"
                           Grid.ColumnSpan="3"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#3A63C3"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSave"
                        Grid.Column="1"
                        Content="💾 حفظ الإعدادات"
                        Background="{StaticResource SaveBrush}"
                        Style="{StaticResource ActionBtn}"
                        Width="140"
                        Click="btnSave_Click"/>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>