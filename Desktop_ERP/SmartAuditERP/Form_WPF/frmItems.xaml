<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmItems"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="بطاقة صنف"
    Width="1080" Height="640"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7B733" Offset="0"/>
            <GradientStop Color="#E08A00" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- FieldLabel -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- RequiredStar -->
        <Style x:Key="RequiredStar" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- ModernTextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ReadOnlyTextBox -->
        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F0F4FA"/>
            <Setter Property="Foreground" Value="#4A5568"/>
        </Style>

        <!-- ActionBtn -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <Style x:Key="LinkTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A63C3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#4B7BFF"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- GroupBox Header -->
        <Style x:Key="GroupHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Main Content ═══ -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FlowDirection="RightToLeft"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold"
                    Background="#F3F5F9">

            <!-- ══════════════════════════════════════════
                 TAB 1: عام
            ══════════════════════════════════════════ -->
            <TabItem x:Name="General" Header="  عـــام  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border x:Name="GbGeneral"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="6,6,6,6"
                            Padding="10,8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Row 0: رقم + بحث باركود -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 1: اسم + مجموعة -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 2: اسم EN -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 3: الباركود -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 4: الصورة + GroupBox1 + أسعار -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 5: أسعار إضافية -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 6: حدود + خصم -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 7: أسعار جملة/مستهلك -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 8: رصيد المستودع -->
                            </Grid.RowDefinitions>

                            <!-- ═══ Row 0: رقم المادة + بحث باركود ═══ -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="رقم المادة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0" Visibility="Collapsed"/>
                                <TextBox x:Name="txtNo"
                                         Grid.Column="1"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         IsReadOnly="True"
                                         TextAlignment="Center"
                                         Visibility="Collapsed"/>

                                <!-- بحث باركود -->
                                <TextBlock Grid.Column="4" Text="🔍 بحث باركود"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <Grid Grid.Column="5">
                                    <TextBox x:Name="txtSrchBarcode"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"
                                             GotFocus="txtSrchBarcode_GotFocus"
                                             LostFocus="txtSrchBarcode_LostFocus"
                                             KeyDown="txtSrchBarcode_KeyDown"
                                             TextChanged="txtSrchBarcode_TextChanged"/>
                                    <TextBlock x:Name="txtSrchBarcodePlaceholder"
                                               Text="بحث باركود"
                                               IsHitTestVisible="False"
                                               Foreground="Gray"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <!-- ═══ Row 1: الاسم + المجموعة ═══ -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <!-- الاسم -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                                    <TextBlock Text="الاسم" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="*" Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <TextBox x:Name="txtName"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"/>

                                <!-- المجموعة -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,6,0">
                                    <TextBlock Text="المجموعة" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="*" Style="{StaticResource RequiredStar}"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbGroups"
                                          Grid.Column="4"
                                          Height="30" FontSize="12"
                                          IsEditable="True"
                                          SelectionChanged="cmbGroups_SelectionChanged"/>
                                <Button x:Name="btnAddGrp"
                                        Grid.Column="6"
                                        Content="➕"
                                        Style="{StaticResource SmallBtn}"
                                        Height="30" Width="30"
                                        ToolTip="إضافة مجموعة"
                                        Click="btnAddGrp_Click"/>
                            </Grid>

                            <!-- ═══ Row 2: الاسم EN ═══ -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblNameEn" Grid.Column="0"
                                           Text="الاسم (EN)" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtNameEN"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="200"/>
                            </Grid>

                            <!-- ═══ Row 3: الباركود + رمز الصنف ═══ -->
                            <Grid Grid.Row="3" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label2" Grid.Column="0"
                                           Text="الباركود" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtBarcode"
                                         Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center" MaxLength="50"
                                         TextChanged="txtBarcode_TextChanged"/>

                                <Button x:Name="btnGenerateBarcode"
                                        Grid.Column="2"
                                        Content="🔢 توليد"
                                        Style="{StaticResource SmallBtn}"
                                        Height="30" Margin="4,0"
                                        Click="btnGenerateBarcode_Click"/>
                                <Button x:Name="Button1"
                                        Grid.Column="3"
                                        Content="🖨️ طباعة"
                                        Style="{StaticResource SmallBtn}"
                                        Height="30" Margin="0,0,4,0"
                                        Click="Button1_Click"/>
                                <Button x:Name="Button2"
                                        Grid.Column="4"
                                        Content="📋 متعدد"
                                        Style="{StaticResource SmallBtn}"
                                        Height="30"
                                        Click="Button2_Click"/>

                                <TextBlock x:Name="lblItemCode" Grid.Column="6"
                                           Text="رمز الصنف" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtItemCode"
                                         Grid.Column="7"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center" MaxLength="50"/>
                            </Grid>

                            <!-- ═══ Row 4: صورة + خصائص + وحدة + أسعار ═══ -->
                            <Grid Grid.Row="4" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- صورة الصنف -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock x:Name="lblImage"
                                               Text="🖼️ صورة الصنف"
                                               Style="{StaticResource FieldLabel}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,4"/>
                                    <Border BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1" CornerRadius="6"
                                            Width="140" Height="110"
                                            Background="#F5F7FA">
                                        <Image x:Name="picImage"
                                               Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0">
                                        <TextBlock x:Name="lnkImgAdd"
                                                   Text="📂 رفع"
                                                   Style="{StaticResource LinkTextStyle}"
                                                   Margin="0,0,10,0"
                                                   MouseLeftButtonDown="lnkImgAdd_Click"/>
                                        <TextBlock x:Name="lnkImgClr"
                                                   Text="🗑️ حذف"
                                                   Style="{StaticResource LinkTextStyle}"
                                                   MouseLeftButtonDown="lnkImgClr_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- GroupBox1: خصائص الصنف -->
                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="8,6" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource GroupHeader}">
                                            <TextBlock Text="⚙️ خصائص الصنف"
                                                       Foreground="White" FontSize="11"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- نوع الصنف -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Label13" Grid.Column="0"
                                                       Text="نوع الصنف"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="0,0,6,0"/>
                                            <ComboBox x:Name="cmbItemType"
                                                      Grid.Column="1"
                                                      Height="28" FontSize="11"
                                                      IsEditable="True"/>
                                        </Grid>

                                        <!-- خواص الصنف -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Label3" Grid.Column="0"
                                                       Text="خواص الصنف"
                                                       Style="{StaticResource FieldLabel}"
                                                       Margin="0,0,6,0"/>
                                            <ComboBox x:Name="cmbItemProperties"
                                                      Grid.Column="1"
                                                      Height="28" FontSize="11"
                                                      SelectionChanged="cmbItemProperties_SelectionChanged">
                                                <ComboBoxItem>غير محدد</ComboBoxItem>
                                                <ComboBoxItem>ميزان</ComboBoxItem>
                                                <ComboBoxItem>تعبئة</ComboBoxItem>
                                                <ComboBoxItem>مساحة</ComboBoxItem>
                                                <ComboBoxItem>متر طولي</ComboBoxItem>
                                                <ComboBoxItem>رقم تسلسلي</ComboBoxItem>
                                                <ComboBoxItem>موصوف</ComboBoxItem>
                                                <ComboBoxItem>صنف مؤقت</ComboBoxItem>
                                                <ComboBoxItem>تاريخ إنتهاء</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>

                                        <!-- PnlProperty -->
                                        <Border x:Name="PnlProperty"
                                                Background="#F0F0F0"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,0,4"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ckWeightScale"
                                                                 Content="وزن"
                                                                 FontWeight="Bold" FontSize="11"
                                                                 Margin="0,0,8,0"/>
                                                    <RadioButton x:Name="ckScalePrice"
                                                                 Content="سعر"
                                                                 FontWeight="Bold" FontSize="11"
                                                                 Margin="0,0,8,0"/>
                                                    <RadioButton x:Name="chksalWeightScale"
                                                                 Content="سعر مع خصم كمية"
                                                                 FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                                <TextBox x:Name="txtFillVal"
                                                         Style="{StaticResource ModernTextBox}"
                                                         TextAlignment="Center"
                                                         Margin="0,4,0,0"
                                                         Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- CheckBoxes -->
                                        <CheckBox x:Name="ckNoTax"
                                                  Content="معفي من الضريبة"
                                                  FontWeight="Bold" FontSize="11"
                                                  Margin="0,2,0,2"/>
                                        <CheckBox x:Name="clkShowInPOS"
                                                  Content="الظهور في نقطة البيع"
                                                  IsChecked="True"
                                                  FontWeight="Bold" FontSize="11"
                                                  Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chkExtraTax"
                                                  Content="تطبيق ضريبة اضافية"
                                                  FontWeight="Bold" FontSize="11"
                                                  Margin="0,2,0,2"/>
                                        <CheckBox x:Name="chkInAndroid"
                                                  Content="الظهور في أندرويد"
                                                  FontWeight="Bold" FontSize="11"
                                                  Margin="0,2,0,2"
                                                  Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- أسعار + وحدة -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- الوحدة الافتراضية -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                                            <TextBlock x:Name="lbkbUnit"
                                                       Text="الوحدة الافتراضية"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="*" Style="{StaticResource RequiredStar}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="cmbUnit"
                                                  Grid.Column="1"
                                                  Height="30" FontSize="12"
                                                  IsEditable="True"/>
                                        <Button x:Name="btnAddUnit"
                                                Grid.Column="2"
                                                Content="➕" Width="30" Height="30"
                                                Style="{StaticResource SmallBtn}"
                                                Margin="4,0,0,0"
                                                Click="btnAddUnit_Click"/>
                                    </Grid>

                                    <!-- سعر الشراء -->
                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblPurchaseprice" Grid.Column="0"
                                                   Text="سعر الشراء"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtPurchPrice"
                                                 Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 TextChanged="txtPurchPrice_TextChanged"
                                                 GotFocus="txtPurchPrice_Enter"/>
                                    </Grid>

                                    <!-- سعر البيع -->
                                    <Grid Grid.Row="2" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                                            <TextBlock x:Name="lblSalePrice"
                                                       Text="سعر البيع"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="*" Style="{StaticResource RequiredStar}"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtSalePrice"
                                                 Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 TextChanged="txtSalePrice_TextChanged"
                                                 GotFocus="txtSalePrice_Enter"
                                                 KeyDown="txtSalePrice_KeyDown"
                                                 LostFocus="txtSalePrice_Leave"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="الربح %"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="6,0,4,0"/>
                                        <TextBox x:Name="txtProfitPer"
                                                 Grid.Column="3"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 TextChanged="txtProfitPer_TextChanged"
                                                 GotFocus="txtSaleDollar_Enter"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="%"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="2,0,4,0"/>
                                        <TextBox x:Name="txtDiscount"
                                                 Grid.Column="5"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 ToolTip="الخصم"/>
                                    </Grid>

                                    <!-- سعر البيع شامل/غير شامل الضريبة -->
                                    <Grid Grid.Row="3" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblSalePrice2" Grid.Column="0"
                                                   Text="سعر البيع&#x0a;شامل الضريبة"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtSalePrice2"
                                                 Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"
                                                 KeyDown="txtSalePrice2_KeyDown"
                                                 LostFocus="txtSalePrice2_Leave"/>
                                    </Grid>

                                    <!-- آخر سعر شراء + متوسط التكلفة -->
                                    <Grid Grid.Row="4" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblLastPurchasePrice" Grid.Column="0"
                                                   Text="آخر سعر شراء"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtRecentPurchPrice"
                                                 Grid.Column="1"
                                                 Style="{StaticResource ReadOnlyTextBox}"
                                                 TextAlignment="Center"/>
                                        <TextBlock x:Name="Label33" Grid.Column="3"
                                                   Text="متوسط التكلفة"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtCostAvrg"
                                                 Grid.Column="4"
                                                 Style="{StaticResource ReadOnlyTextBox}"
                                                 TextAlignment="Center"/>
                                    </Grid>

                                    <!-- أقل سعر بيع + سعر المنافس -->
                                    <Grid Grid.Row="5" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblLowestSellingPrice" Grid.Column="0"
                                                   Text="أقل سعر بيع"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtLastSalePrice"
                                                 Grid.Column="1"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                        <TextBlock x:Name="Label22" Grid.Column="3"
                                                   Text="سعر المنافس"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtCompetitorPrice"
                                                 Grid.Column="4"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- ═══ Row 5: حدود + خصومات ═══ -->
                            <Grid Grid.Row="5" Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="lblMinimunQuantityLimit" Grid.Column="0"
                                           Text="الحد الأدنى" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtLimit" Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label4" Grid.Column="3"
                                           Text="الحد الأعلى" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtMaxQtyLimit" Grid.Column="4"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="lblMaxDicountParcent" Grid.Column="6"
                                           Text="أعلى خصم نسبة" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtMaxDicountParcent" Grid.Column="7"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="lblMaxDicAmount" Grid.Column="9"
                                           Text="أعلى خصم قيمة" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtMaxDicAmount" Grid.Column="10"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label5" Grid.Column="12"
                                           Text="ترتيب الظهور" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtItemSort" Grid.Column="13"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </Grid>

                            <!-- ═══ Row 6: أسعار الجملة والمستهلك ═══ -->
                            <Grid Grid.Row="6" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="lblWholesalePrice" Grid.Column="0"
                                           Text="سعر الجملة" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtWholesalePrice" Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="lblConsumerPrice" Grid.Column="3"
                                           Text="سعر المستهلك" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtConsumerPrice" Grid.Column="4"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </Grid>

                            <!-- ═══ Row 7: ETA + ضريبة المنبع (مخفية افتراضياً) ═══ -->
                            <Grid Grid.Row="7" Margin="0,0,0,6"
                                  x:Name="PanelEta" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="lblEgyCodeType" Grid.Column="0"
                                           Text="نوع التكويد" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbEgyCodeType" Grid.Column="1"
                                          Height="30" FontSize="12">
                                    <ComboBoxItem>EGS</ComboBoxItem>
                                    <ComboBoxItem>GS1</ComboBoxItem>
                                </ComboBox>

                                <TextBlock x:Name="lblEgyCode" Grid.Column="3"
                                           Text="الرمز المصري" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtEgyCode" Grid.Column="4"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="lblWithholdingTax" Grid.Column="6"
                                           Text="نسبة الخصم من المنبع"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtWithholdingTaxBox" Grid.Column="7"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </Grid>

                            <!-- ═══ Row 8: رصيد المستودع ═══ -->
                            <Border Grid.Row="8"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="6,6" Margin="0,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="120"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource GroupHeader}">
                                        <TextBlock Text="🏪 الرصيد في المستودعات"
                                                   Foreground="White" FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <DataGrid x:Name="dgvSafeBalance"
                                              Grid.Row="1"
                                              AutoGenerateColumns="False"
                                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                              RowStyle="{StaticResource DgvRow}"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#E8EBF5"
                                              AlternatingRowBackground="#F8F9FD"
                                              Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="المستودع"
                                                                Binding="{Binding StoreName}"
                                                                Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource CenterCell}"/>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="الكمية"
                                                                Binding="{Binding Quantity}"
                                                                Width="100">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource CenterCell}"/>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════════════════════════════════
                 TAB 2: وحدات
            ══════════════════════════════════════════ -->
            <TabItem x:Name="TabPage2" Header="  وحــــدات  ">
                <Border Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="8"
                        Margin="6,6,6,6" Padding="10,8"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource GroupHeader}">
                            <TextBlock Text="📦 وحدات الصنف"
                                       Foreground="White" FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- DataGrid الوحدات -->
                        <DataGrid x:Name="GridControl1"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                  RowStyle="{StaticResource DgvRow}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8EBF5"
                                  AlternatingRowBackground="#F8F9FD"
                                  Background="White"
                                  CellEditEnding="GridControl1_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="DgvNoCol"
                                                    Header="#"
                                                    Binding="{Binding DgvNo}"
                                                    Width="50" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn x:Name="DgvUnitCol"
                                                        Header="الوحدة" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DgvUnitName}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox x:Name="cmbUnitInGrid"
                                                      SelectedValue="{Binding DgvUnit, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="id"
                                                      DisplayMemberPath="name"
                                                      Height="26"
                                                      SelectionChanged="cmbUnitInGrid_SelectionChanged"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn x:Name="DgvUnitEqualityCol"
                                                    Header="التعادل"
                                                    Binding="{Binding DgvUnitEquality, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="DgvUnitPurchasePriceCol"
                                                    Header="سعر الشراء"
                                                    Binding="{Binding DgvUnitPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="DgvUnitSalePriceCol"
                                                    Header="سعر البيع"
                                                    Binding="{Binding DgvUnitSalePrice, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="DgvUnitBarcodeCol"
                                                    Header="الباركود"
                                                    Binding="{Binding DgvUnitBarcode, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- زر توليد باركود الوحدة -->
                                <DataGridTemplateColumn Header="توليد باركود" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🔢 توليد"
                                                    Style="{StaticResource SmallBtn}"
                                                    Height="24"
                                                    Tag="{Binding}"
                                                    Click="BtnEditGenerateBarcode_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- زر حذف الوحدة -->
                                <DataGridTemplateColumn Header="حذف" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️"
                                                    Style="{StaticResource DangerBtn}"
                                                    Height="24" Width="40"
                                                    Tag="{Binding}"
                                                    Click="BtnDeleteUnit_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ══════════════════════════════════════════
                 TAB 3: بضاعة أول المدة
            ══════════════════════════════════════════ -->
            <TabItem x:Name="TabPage4" Header="  بضاعة أول المدة  ">
                <Border Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="8"
                        Margin="6,6,6,6" Padding="10,8"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource GroupHeader}">
                            <TextBlock Text="📦 بضاعة أول المدة"
                                       Foreground="White" FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <DataGrid x:Name="dgvFirst"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                  RowStyle="{StaticResource DgvRow}"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8EBF5"
                                  AlternatingRowBackground="#F8F9FD"
                                  Background="White"
                                  CellEditEnding="dgvFirst_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="المستودع" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StoreName}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox x:Name="cmbStoreInDgvFirst"
                                                      SelectedValue="{Binding StoreId, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="id"
                                                      DisplayMemberPath="name"
                                                      Height="26"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="الكمية"
                                                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="إجمالي التكلفة"
                                                    Binding="{Binding TotalCost}"
                                                    Width="150" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️ حذف"
                                                    Style="{StaticResource DangerBtn}"
                                                    Height="24"
                                                    Tag="{Binding}"
                                                    Click="dgvFirst_DeleteRow_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ══════════════════════════════════════════
                 TAB 4: المكونات
            ══════════════════════════════════════════ -->
            <TabItem x:Name="TabPage1" Header="  المكونات  ">
                <Border Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="8"
                        Margin="6,6,6,6" Padding="10,8"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Panel3 -->
                            <RowDefinition Height="*"/>
                            <!-- dgvComponent -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource GroupHeader}">
                            <TextBlock Text="🔧 مكونات الصنف"
                                       Foreground="White" FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Panel3: إعدادات الإنتاج -->
                        <Border x:Name="Panel3"
                                Grid.Row="1"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="8,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Label9" Grid.Column="0"
                                           Text="مستودع المنتج التام"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="cmbProductionStore"
                                          Grid.Column="1"
                                          Height="30" FontSize="12"
                                          IsEditable="True"/>

                                <TextBlock x:Name="Label11" Grid.Column="3"
                                           Text="تكلفة المادة"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="txtTotal"
                                         Grid.Column="4"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock x:Name="Label14" Grid.Column="6"
                                           Text="كمية المنتج"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,6,0"/>
                                <TextBox x:Name="TextBox1"
                                         Grid.Column="7"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- pnlComponent: DataGrid المكونات -->
                        <Border x:Name="pnlComponent"
                                Grid.Row="2"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1" CornerRadius="6">
                            <DataGrid x:Name="dgvComponent"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      Background="White"
                                      CellEditEnding="dgvComponent_CellEditEnding"
                                      SelectedCellsChanged="dgvComponent_SelectedCellsChanged">
                                <DataGrid.Columns>
                                    <!-- Col 0: # -->
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding RowNo}"
                                                        Width="40" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Col 1: رمز الصنف -->
                                    <DataGridTextColumn Header="رمز الصنف"
                                                        Binding="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Col 2: رقم الصنف (مخفي) -->
                                    <DataGridTextColumn Header="رقم الصنف"
                                                        Binding="{Binding ItemId}"
                                                        Width="0" Visibility="Collapsed"/>
                                    <!-- Col 3: الصنف -->
                                    <DataGridTextColumn Header="الصنف"
                                                        Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Col 4: الوحدة -->
                                    <DataGridTemplateColumn Header="الوحدة" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UnitName}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="id"
                                                          DisplayMemberPath="name"
                                                          Height="26"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Col 5: الكمية -->
                                    <DataGridTextColumn Header="الكمية"
                                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="70">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Col 6: السعر -->
                                    <DataGridTextColumn Header="السعر"
                                                        Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Col 7: المجموع -->
                                    <DataGridTextColumn Header="المجموع"
                                                        Binding="{Binding Total}"
                                                        Width="90" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Col 8: المستودع -->
                                    <DataGridTemplateColumn Header="المستودع" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StoreCompName}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding StoreCompId, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="id"
                                                          DisplayMemberPath="name"
                                                          Height="26"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Col 9: مادة مضافة -->
                                    <DataGridCheckBoxColumn Header="مادة مضافة"
                                                            Binding="{Binding IsAdded, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="80"/>
                                    <!-- Col 10: حذف -->
                                    <DataGridTemplateColumn Header="حذف" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️"
                                                        Style="{StaticResource DangerBtn}"
                                                        Height="24" Width="40"
                                                        Tag="{Binding}"
                                                        Click="dgvComponent_DeleteRow_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,6"
                Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="40" ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Margin="0,0,8,0"
                            Click="btnLast_Click"/>

                    <!-- بحث -->
                    <Button x:Name="btnSearch"
                            Content="🔍 بحث"
                            Style="{StaticResource ActionBtn}"
                            Width="70" ToolTip="بحث عن صنف"
                            Click="btnSearch_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>