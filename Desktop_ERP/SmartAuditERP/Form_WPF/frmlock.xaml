<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="فتح القفل"
    Width="360"
    Height="450"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    Topmost="True"
    FlowDirection="RightToLeft"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Frm_Calculator_Load"
    MouseDown="Frm_Calculator_Click"
    KeyDown="Frm_Calculator_KeyDown">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="LockBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5751AB" Offset="0"/>
            <GradientStop Color="#4B5CA6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5764A6" Offset="0"/>
            <GradientStop Color="#4A56A0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="UnlockBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A9E4E" Offset="0"/>
            <GradientStop Color="#2D7D3C" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.3"
                          Color="#000000"/>

        <Style x:Key="NumBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource KeyBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#7888CC"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearBtn" TargetType="Button" BasedOn="{StaticResource NumBtn}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B94040" Offset="0"/>
                        <GradientStop Color="#922E2E" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnlockBtn" TargetType="Button" BasedOn="{StaticResource NumBtn}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{StaticResource UnlockBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid Background="{StaticResource LockBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo / Header Area -->
        <Border Grid.Row="0"
                Background="#8990B1"
                BorderBrush="#6670A0"
                BorderThickness="0,0,0,2"
                Margin="10,6,10,4">
            <Grid>
                <!-- Logo placeholder -->
                <Border Background="#7880A8"
                        CornerRadius="8"
                        Margin="10">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="🔒"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,4"/>
                        <TextBlock Text="SmartAudit ERP"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Advanced Login Link -->
                <TextBlock x:Name="LinkLabel1"
                           Text="🔑 تسجيل دخول متقدم"
                           Foreground="Black"
                           FontSize="11"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"
                           MouseLeftButtonDown="LinkLabel1_LinkClicked"/>
            </Grid>
        </Border>

        <!-- Keypad Area -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14,14,0,0"
                Margin="8,0,8,0"
                Padding="14,14,14,10">
            <StackPanel>

                <!-- Password Field -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="txtPass"
                                 Grid.Column="0"
                                 Height="36"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Background="White"
                                 BorderBrush="#8898D0"
                                 BorderThickness="2"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="txtPass_KeyDown"/>

                    <TextBlock Grid.Column="1"
                               Text="🔑 كلمة المرور"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#3A4880"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>

                <!-- Row 1: 6 7 8 9 -->
                <UniformGrid Columns="4"
                             Margin="0,0,0,6"
                             HorizontalAlignment="Center">
                    <Button x:Name="cmd6"
                            Content="6"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd6_Click"/>
                    <Button x:Name="cmd7"
                            Content="7"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd7_Click"/>
                    <Button x:Name="cmd8"
                            Content="8"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd8_Click"/>
                    <Button x:Name="cmd9"
                            Content="9"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd9_Click"/>
                </UniformGrid>

                <!-- Row 2: 2 3 4 5 -->
                <UniformGrid Columns="4"
                             Margin="0,0,0,6"
                             HorizontalAlignment="Center">
                    <Button x:Name="cmd2"
                            Content="2"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd2_Click"/>
                    <Button x:Name="cmd3"
                            Content="3"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd3_Click"/>
                    <Button x:Name="cmd4"
                            Content="4"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd4_Click"/>
                    <Button x:Name="cmd5"
                            Content="5"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd5_Click"/>
                </UniformGrid>

                <!-- Row 3: 0 1 C Unlock -->
                <UniformGrid Columns="4"
                             Margin="0,0,0,0"
                             HorizontalAlignment="Center">
                    <Button x:Name="cmd0"
                            Content="0"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd0_Click"/>
                    <Button x:Name="cmd135"
                            Content="1"
                            Style="{StaticResource NumBtn}"
                            Margin="3"
                            Click="cmd135_Click"/>
                    <Button x:Name="cmdClearAll"
                            Content="⌫"
                            Style="{StaticResource ClearBtn}"
                            Margin="3"
                            Click="cmdClearAll_Click"/>
                    <Button x:Name="btnUnlock"
                            Content="🔓"
                            Style="{StaticResource UnlockBtn}"
                            Margin="3"
                            FontSize="22"
                            ToolTip="فتح"
                            Click="btnUnlock_Click"/>
                </UniformGrid>

            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>