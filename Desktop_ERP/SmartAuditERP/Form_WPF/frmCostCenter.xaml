<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCostCenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="مركز التكلفة 🏢"
    Width="850" Height="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmCostCenter_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TreeHeaderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Styles ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ═══ TreeView Styles ═══ -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#2E4E9E"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#3A63C3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══ Main Layout ═══ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Content ═══ -->
        <Grid Grid.Row="0" Margin="6,6,6,4">
            <Grid.ColumnDefinitions>
                <!-- البيانات -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <!-- الشجرة -->
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ─── بيانات مركز التكلفة ─── -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="12,10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="7" Padding="10,5"
                            Margin="0,0,0,12">
                        <TextBlock Text="📝 بيانات مركز التكلفة"
                                   Foreground="White" FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Fields -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: الرقم + الاسم -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="🔢 الرقم"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="Code"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True"
                                     TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="✏️ الاسم"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AName"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- Row 2: الاسم إنجليزي + البند الرئيسي -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="🌐 الاسم EN"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNameEn"
                                     Style="{StaticResource ModernTextBox}"
                                     FlowDirection="LeftToRight"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="📂 البند الرئيسي"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ParentCode"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      SelectionChanged="ParentCode_SelectionChanged"/>
                        </StackPanel>

                        <!-- Row 4: الفرع -->
                        <StackPanel Grid.Row="4" Grid.Column="0"
                                    Grid.ColumnSpan="3">
                            <TextBlock Text="🏬 الفرع"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbBranches"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"/>
                        </StackPanel>

                        <!-- Row 6: النوع -->
                        <StackPanel Grid.Row="6" Grid.Column="0"
                                    Grid.ColumnSpan="3">
                            <TextBlock Text="🏷️ النوع"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <RadioButton x:Name="Main"
                                             Content="🟢 رئيسي"
                                             Style="{StaticResource ModernRadio}"
                                             IsChecked="True"/>
                                <RadioButton x:Name="sub1"
                                             Content="🔵 فرعي"
                                             Style="{StaticResource ModernRadio}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── شجرة مراكز التكلفة ─── -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tree Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource TreeHeaderBrush}"
                            CornerRadius="10,10,0,0"
                            Padding="10,6">
                        <TextBlock Text="🌳 شجرة مراكز التكلفة"
                                   Foreground="White" FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Tree Content -->
                    <TreeView x:Name="TreeView1"
                              Grid.Row="1"
                              BorderThickness="0"
                              Background="Transparent"
                              ItemContainerStyle="{StaticResource TreeItemStyle}"
                              SelectedItemChanged="TreeView1_SelectedItemChanged"
                              Margin="4"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- إغلاق -->
                <Button Grid.Column="0"
                        x:Name="btnClose"
                        Content="✖ إغلاق"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Click="btnClose_Click"/>

                <!-- العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80" Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80" Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>