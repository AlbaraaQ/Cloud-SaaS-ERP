<Window x:Class="SmartAuditERP.Form_WPF.frmCloudPriceSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="إعدادات الأسعار"
        Width="560"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="LeftToRight"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ═══════════ BRUSHES ═══════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00695C" Offset="0"/>
            <GradientStop Color="#00897B" Offset="0.5"/>
            <GradientStop Color="#26A69A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F4FFFD" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════ SHADOWS ═══════════ -->
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Direction="270"
                          Opacity="0.28"
                          Color="#44000000"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.12"
                          Color="#44000000"/>

        <!-- ═══════════ LABEL STYLE ═══════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ═══════════ COMBO STYLE ═══════════ -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#80CBC4"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- ═══════════ BUTTON STYLE ═══════════ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#00695C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Droid Arabic Kufi"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#1565C0"/>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ DATAGRID STYLE ═══════════ -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B2DFDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#00695C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0F2F1"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=AlternationIndex}" Value="1">
                    <Setter Property="Background" Value="#FAFFFE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border CornerRadius="18"
            Background="{StaticResource CardBrush}"
            BorderBrush="#80CBC4"
            BorderThickness="1.5"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="💰" FontSize="22" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblTitle"
                                   Text="إعدادات الأسعار"
                                   Foreground="White"
                                   FontFamily="Droid Arabic Kufi"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource WinCloseStyle}"
                            Click="Window_Close_Click">
                        <TextBlock Text="✖"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- سعر المنافس -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbCompetitorPrice"
                              Grid.Column="0"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                    <TextBlock x:Name="lblCompetitorPrice"
                               Grid.Column="2"
                               Text="سعر المنافس"
                               Style="{StaticResource FieldLabelStyle}"/>
                </Grid>

                <!-- سعر الجملة -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbWholesalePrice"
                              Grid.Column="0"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                    <TextBlock x:Name="lblWholesalePrice"
                               Grid.Column="2"
                               Text="سعر الجملة"
                               Style="{StaticResource FieldLabelStyle}"/>
                </Grid>

                <!-- سعر المستهلك -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbConsumerPrice"
                              Grid.Column="0"
                              Style="{StaticResource ModernComboBoxStyle}"/>
                    <TextBlock x:Name="lblConsumerPrice"
                               Grid.Column="2"
                               Text="سعر المستهلك"
                               Style="{StaticResource FieldLabelStyle}"/>
                </Grid>

                <!-- Grid -->
                <Border Grid.Row="6"
                        Background="White"
                        BorderBrush="#B2DFDB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#E0F2F1"
                                Padding="10"
                                CornerRadius="10,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🏦 إعدادات البنوك وطرق الدفع"
                                           Grid.Column="0"
                                           FontFamily="Droid Arabic Kufi"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#004D40"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="btnAddRow"
                                        Grid.Column="1"
                                        Style="{StaticResource InfoButtonStyle}"
                                        MinWidth="90"
                                        Height="30"
                                        Click="btnAddBankRow_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Margin="0,0,6,0"/>
                                        <TextBlock Text="إضافة"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="GridControl1"
                                  FlowDirection="RightToLeft"
                                  Style="{StaticResource ModernDataGridStyle}">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="البنك" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding BankId, UpdateSourceTrigger=PropertyChanged}"
                                                      Loaded="BankComboInGrid_Loaded"
                                                      Height="28"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="طريقة الدفع" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding PayTypeId, UpdateSourceTrigger=PropertyChanged}"
                                                      Loaded="PayTypeComboInGrid_Loaded"
                                                      Height="28"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="حذف" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑 حذف"
                                                    Style="{StaticResource DeleteButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="BtnDeleteRow_Click"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Buttons -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnSave"
                            Grid.Column="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnUpdateItems"
                            Grid.Column="2"
                            Style="{StaticResource InfoButtonStyle}"
                            Click="BtnUpdateItems_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث الأصناف"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnUpdateCustomers"
                            Grid.Column="4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث أسعار العملاء"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>