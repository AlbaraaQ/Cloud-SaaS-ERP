<Window x:Class="SmartAuditERP.Form_WPF.frmContractPM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="عـقد عمـيل 📋"
        Height="520" Width="820"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        FontFamily="Tahoma">

    <Window.Resources>

        <!-- ==================== TextBox Style ==================== -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#CBD5E1" BlurRadius="4"
                                                  ShadowDepth="1" Opacity="0.3"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#22C55E"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Label Style ==================== -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==================== ComboBox Style ==================== -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ==================== DatePicker Style ==================== -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <!-- ==================== Toolbar Button ==================== -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#483D8B" Offset="0"/>
                        <GradientStop Color="#2F2A6B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#483D8B" BlurRadius="8"
                                                  ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="9" FontFamily="Tahoma"
                                           HorizontalAlignment="Center"
                                           Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#5B4F9E" Offset="0"/>
                                            <GradientStop Color="#3D3580" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2F2A6B" Offset="0"/>
                                            <GradientStop Color="#1E1B4B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Close Button ==================== -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DC2626" Offset="0"/>
                        <GradientStop Color="#991B1B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#DC2626" BlurRadius="8"
                                                  ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="20" HorizontalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="9" FontFamily="Tahoma"
                                           HorizontalAlignment="Center"
                                           Foreground="White" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#EF4444" Offset="0"/>
                                            <GradientStop Color="#B91C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Add Button ==================== -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#16A34A" BlurRadius="6"
                                                  ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16A34A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Search Button ==================== -->
        <Style x:Key="SearchButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,6">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="8"
                                                  ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#60A5FA" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Print Button ==================== -->
        <Style x:Key="PrintButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F59E0B" Offset="0"/>
                        <GradientStop Color="#D97706" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#F59E0B" BlurRadius="6"
                                                  ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FBBF24" Offset="0"/>
                                            <GradientStop Color="#B45309" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Tab Style ==================== -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,0" CornerRadius="8,8,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== DataGrid Style ==================== -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#483D8B" Offset="0"/>
                                    <GradientStop Color="#2F2A6B" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontFamily" Value="Tahoma"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Summary Label Style ==================== -->
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==================== Summary Value Style ==================== -->
        <Style x:Key="SummaryValue" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#16A34A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <!-- ==================== Section Card ==================== -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="10"
                                      ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ==================== Main Grid ==================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Gradient Bar -->
        <Border Grid.Row="0" Height="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="0.5"/>
                    <GradientStop Color="#EC4899" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ==================== Header Info Bar ==================== -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="6,4,6,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- User Info -->
                <Border Grid.Column="0"
                        Background="#EFF6FF" CornerRadius="6" Padding="8,4"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤 " FontSize="14"/>
                        <TextBlock x:Name="txtuser"
                                   Text="المستخدم"
                                   Style="{StaticResource ModernLabel}"
                                   Foreground="#1D4ED8"/>
                        <TextBlock Text=" | 🕐 " FontSize="13" Foreground="#64748B"/>
                        <TextBlock x:Name="txtTime"
                                   Text="00:00"
                                   Style="{StaticResource ModernLabel}"
                                   Foreground="#1D4ED8"/>
                    </StackPanel>
                </Border>

                <!-- Contract Status -->
                <TextBlock Grid.Column="1"
                           Text="حالة العقد ⚡"
                           Style="{StaticResource ModernLabel}"
                           Margin="8,0,4,0"/>
                <ComboBox x:Name="cmbStatus"
                          Grid.Column="2"
                          Style="{StaticResource ModernComboBox}"
                          Width="150"
                          SelectionChanged="cmbStatus_SelectionChanged"/>

                <!-- Date -->
                <TextBlock Grid.Column="3"
                           Text="📅 التاريخ"
                           Style="{StaticResource ModernLabel}"
                           Margin="12,0,4,0"/>
                <DatePicker x:Name="txtDate"
                            Grid.Column="4"
                            Style="{StaticResource ModernDatePicker}"
                            Width="120" Margin="0,0,8,0"/>

                <!-- Contract No -->
                <TextBlock Grid.Column="5"
                           Text="رقم العقد 🔢"
                           Style="{StaticResource ModernLabel}"
                           Margin="8,0,4,0"/>
                <TextBox x:Name="txtNo"
                         Grid.Column="6"
                         Style="{StaticResource ModernTextBox}"
                         IsReadOnly="True"
                         Width="90"
                         TextAlignment="Center"
                         Margin="0,0,8,0"/>
            </Grid>
        </Border>

        <!-- ==================== TabControl ==================== -->
        <TabControl Grid.Row="2"
                    Margin="4,0"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F8FAFC"
                                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True"
                                      HorizontalAlignment="Right" Margin="8,0"/>
                        </Border>
                        <Border Grid.Row="1" Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ========== Tab 1: بيانات العقد ========== -->
            <TabItem Header="📄 بيانات العقد" Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Contract Info Section -->
                    <Border Grid.Row="0" Style="{StaticResource SectionCard}">
                        <StackPanel>

                            <!-- Row 1: Payment + Treasury + Bank + Client -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Payment Type -->
                                <StackPanel Grid.Column="3" Margin="4,0">
                                    <TextBlock Text="طريقة الدفع 💳"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbType"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="cmbType_SelectionChanged">
                                        <ComboBoxItem Content="آجلة"/>
                                        <ComboBoxItem Content="نقدية"/>
                                        <ComboBoxItem Content="بنك"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Treasury -->
                                <StackPanel Grid.Column="2" Margin="4,0">
                                    <TextBlock Text="الصندوق 🏦"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbTreasury"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <!-- Bank -->
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="البنك 🏛️"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbBanks"
                                              Style="{StaticResource ModernComboBox}"/>
                                </StackPanel>

                                <!-- Sales Man -->
                                <StackPanel Grid.Column="0" Margin="4,0">
                                    <TextBlock Text="المندوب 🧑‍💼"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnAddSaleman"
                                                Grid.Column="0"
                                                Content="+"
                                                Style="{StaticResource AddButton}"
                                                Margin="0,0,4,0"
                                                ToolTip="إضافة مندوب جديد"
                                                Click="btnAddSaleman_Click"/>
                                        <ComboBox x:Name="cmbSalesMen"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBox}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Client + Payer + Period + Ref + Dates -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Client -->
                                <StackPanel Grid.Column="5" Margin="4,0">
                                    <TextBlock Text="اسم العميل 👥"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnCustAdd"
                                                Grid.Column="0"
                                                Content="+"
                                                Style="{StaticResource AddButton}"
                                                Margin="0,0,4,0"
                                                ToolTip="إضافة عميل جديد"
                                                Click="btnCustAdd_Click"/>
                                        <ComboBox x:Name="cmbClient"
                                                  Grid.Column="1"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Payer Name -->
                                <StackPanel Grid.Column="4" Margin="4,0">
                                    <TextBlock Text="اسم المحول 📝"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtPayerName"
                                             Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <!-- Period -->
                                <StackPanel Grid.Column="3" Margin="4,0">
                                    <TextBlock Text="مدة التنفيذ 📆"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtPeriod"
                                                 Grid.Column="0"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text=" يوم"
                                                   Style="{StaticResource ModernLabel}"
                                                   Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Reference -->
                                <StackPanel Grid.Column="2" Margin="4,0">
                                    <TextBlock Text="المرجع 🗂️"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtReff"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Start Date -->
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="تاريخ الاتفاق 📅"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <DatePicker x:Name="txtDateStart"
                                                Style="{StaticResource ModernDatePicker}"/>
                                </StackPanel>

                                <!-- Finish Date -->
                                <StackPanel Grid.Column="0" Margin="4,0">
                                    <TextBlock Text="تاريخ نهاية العقد 🏁"
                                               Style="{StaticResource ModernLabel}"
                                               Margin="0,0,0,4"/>
                                    <DatePicker x:Name="txtDateFinish"
                                                Style="{StaticResource ModernDatePicker}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Contract Terms DataGrid -->
                    <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="📋 بنود العقد"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1E293B" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgvterms"
                                      Grid.Row="1"
                                      Style="{StaticResource ModernDataGrid}"
                                      CanUserAddRows="True"
                                      SelectionUnit="Cell"
                                      CellEditEnding="dgvterms_CellEditEnding"
                                      CurrentCellChanged="dgvterms_CurrentCellChanged">
                                <DataGrid.Columns>

                                    <!-- Term (ComboBox) -->
                                    <DataGridTemplateColumn Header="البند 📦" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TermName}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.TermsList}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Code"
                                                          SelectedValue="{Binding TermPk}"
                                                          SelectionChanged="TermComboBox_SelectionChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Project Name -->
                                    <DataGridTextColumn x:Name="ColProjectName"
                                                        Header="اسم المشروع 🏗️"
                                                        Binding="{Binding ProjectName}"
                                                        Width="*"/>

                                    <!-- Quantity -->
                                    <DataGridTextColumn x:Name="ColQuantity"
                                                        Header="الكمية 🔢"
                                                        Binding="{Binding Quantity}"
                                                        Width="70"/>

                                    <!-- Price -->
                                    <DataGridTextColumn x:Name="ColPrice"
                                                        Header="السعر 💰"
                                                        Binding="{Binding Price}"
                                                        Width="80"/>

                                    <!-- Total (hidden) -->
                                    <DataGridTextColumn x:Name="ColTotal"
                                                        Header="المجموع"
                                                        Binding="{Binding Total}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <!-- VAT (hidden) -->
                                    <DataGridTextColumn x:Name="ColVAT"
                                                        Header="الضريبة"
                                                        Binding="{Binding VAT}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <!-- Net -->
                                    <DataGridTextColumn x:Name="ColNet"
                                                        Header="الصافي 🟢"
                                                        Binding="{Binding NetValue}"
                                                        Width="80"/>

                                    <!-- Cost (hidden) -->
                                    <DataGridTextColumn x:Name="ColCost"
                                                        Header="التكلفة"
                                                        Binding="{Binding Cost}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <!-- Net Cost (hidden) -->
                                    <DataGridTextColumn x:Name="ColNetCost"
                                                        Header="صافي التكلفة"
                                                        Binding="{Binding NetCost}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <!-- Status (hidden) -->
                                    <DataGridTextColumn x:Name="ColStatus"
                                                        Header="الحالة"
                                                        Binding="{Binding StatusName}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>

                                    <!-- Delete Button -->
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️ حذف"
                                                        FontSize="11"
                                                        Background="#FEE2E2"
                                                        Foreground="#DC2626"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Padding="4,2"
                                                        Click="DeleteTermRow_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FECACA"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Summary + Print Buttons -->
                    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Summary Values -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Border Background="#F0FDF4" CornerRadius="8"
                                        Padding="10,6" Margin="0,0,6,0"
                                        BorderBrush="#BBF7D0" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الإجمالي 💰 :"
                                                   Style="{StaticResource SummaryLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtTotPrice"
                                                 Style="{StaticResource SummaryValue}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFF7ED" CornerRadius="8"
                                        Padding="10,6" Margin="0,0,6,0"
                                        BorderBrush="#FED7AA" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الضريبة 🧾 :"
                                                   Style="{StaticResource SummaryLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txtNetVAT"
                                                   Style="{StaticResource SummaryLabel}"
                                                   Foreground="#EA580C"
                                                   Width="80"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#EFF6FF" CornerRadius="8"
                                        Padding="10,6"
                                        BorderBrush="#BFDBFE" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="الصافي 🟢 :"
                                                   Style="{StaticResource SummaryLabel}"
                                                   Margin="0,0,6,0"/>
                                        <TextBox x:Name="txtNetVal"
                                                 Style="{StaticResource SummaryValue}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Print Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="Button5"
                                        Content="🖨️ طباعة عقد آبار"
                                        Style="{StaticResource PrintButton}"
                                        Margin="0,0,6,0"
                                        Click="Button5_Click"/>
                                <Button x:Name="Button1"
                                        Content="🕌 طباعة عقد مساجد"
                                        Style="{StaticResource PrintButton}"
                                        Margin="0,0,6,0"
                                        Click="Button1_Click"/>
                                <Button x:Name="Button2"
                                        Content="🎁 إهداء"
                                        Style="{StaticResource PrintButton}"
                                        Click="Button2_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== Tab 2: البحث ========== -->
            <TabItem Header="🔍 البحث" Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Results Grid -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📊 نتائج البحث"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1E293B" Margin="0,0,0,8"/>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      Style="{StaticResource ModernDataGrid}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      IsReadOnly="True"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColContractId"
                                                        Header="كود العقد"
                                                        Binding="{Binding ContractId}"
                                                        Visibility="Collapsed" Width="0"/>
                                    <DataGridTextColumn x:Name="ColContractNo"
                                                        Header="رقم العقد"
                                                        Binding="{Binding ContractNo}"
                                                        Width="*"/>
                                    <DataGridTextColumn x:Name="ColDate"
                                                        Header="التاريخ 📅"
                                                        Binding="{Binding ContractDate}"
                                                        Width="*"/>
                                    <DataGridTextColumn x:Name="ColClient"
                                                        Header="العميل 👤"
                                                        Binding="{Binding ClientName}"
                                                        Width="*"/>
                                    <DataGridTextColumn x:Name="ColStatSearch"
                                                        Header="الحالة ⚡"
                                                        Binding="{Binding StatusName}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Search Panel -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="🔍 خيارات البحث"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#1E293B" Margin="0,0,0,12"/>

                            <!-- Contract Status Search -->
                            <TextBlock Text="حالة العقد ⚡"
                                       Style="{StaticResource ModernLabel}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbStatusSrch"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,10"/>

                            <!-- Contract No Search -->
                            <TextBlock Text="رقم العقد 🔢"
                                       Style="{StaticResource ModernLabel}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="txtSrchNo"
                                     Style="{StaticResource ModernTextBox}"
                                     TextAlignment="Center"
                                     Margin="0,0,0,10"/>

                            <!-- From Date -->
                            <TextBlock Text="من تاريخ 📅"
                                       Style="{StaticResource ModernLabel}"
                                       Margin="0,0,0,4"/>
                            <DatePicker x:Name="txtFromDate"
                                        Style="{StaticResource ModernDatePicker}"
                                        Margin="0,0,0,10"/>

                            <!-- To Date -->
                            <TextBlock Text="إلى تاريخ 📅"
                                       Style="{StaticResource ModernLabel}"
                                       Margin="0,0,0,4"/>
                            <DatePicker x:Name="txtToDate"
                                        Style="{StaticResource ModernDatePicker}"
                                        Margin="0,0,0,10"/>

                            <!-- All Checkbox -->
                            <Border Background="#F8FAFC" CornerRadius="8"
                                    Padding="10,6" Margin="0,0,0,10"
                                    BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox x:Name="chkAll"
                                          Content="الكل 📋"
                                          IsChecked="True"
                                          FontFamily="Tahoma"
                                          FontSize="13"
                                          FontWeight="Bold"
                                          Foreground="#374151"
                                          Checked="chkAll_CheckedChanged"
                                          Unchecked="chkAll_CheckedChanged"/>
                            </Border>

                            <!-- Client Search -->
                            <TextBlock Text="العميل 👤"
                                       Style="{StaticResource ModernLabel}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbClientSrch"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEnabled="False"
                                      IsEditable="True"
                                      Margin="0,0,0,10"/>

                            <!-- Mobile Search -->
                            <TextBlock Text="الجوال 📱"
                                       Style="{StaticResource ModernLabel}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="txtMobile"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="txtMobile_TextChanged"
                                     Margin="0,0,0,12"/>

                            <!-- Search Button -->
                            <Button x:Name="btnSearch"
                                    Content="🔍 بحث"
                                    Style="{StaticResource SearchButton}"
                                    Height="40"
                                    Click="btnSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== Bottom Toolbar ==================== -->
        <Border Grid.Row="3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12"
                                  ShadowDepth="0" Direction="90" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="12,10">

                <!-- Close -->
                <Button x:Name="btnClose"
                        Content="إغلاق" Tag="❌"
                        Style="{StaticResource CloseButton}"
                        ToolTip="إغلاق النافذة"
                        Click="btnClose_Click"
                        Margin="3,0,20,0"/>

                <!-- Separator -->
                <Border Width="1" Background="#334155" Margin="4,8"/>

                <!-- Navigation -->
                <Button x:Name="btnFirst"
                        Content="الأول" Tag="⏮️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="السجل الأول"
                        Click="btnFirst_Click"/>
                <Button x:Name="btnPrevious"
                        Content="السابق" Tag="◀️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="السابق"
                        Click="btnPrevious_Click"/>
                <Button x:Name="btnNext"
                        Content="التالي" Tag="▶️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="التالي"
                        Click="btnNext_Click"/>
                <Button x:Name="btnLast"
                        Content="الأخير" Tag="⏭️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="آخر سجل"
                        Click="btnLast_Click"/>

                <!-- Separator -->
                <Border Width="1" Background="#334155" Margin="8,8"/>

                <!-- Actions -->
                <Button x:Name="btnNew"
                        Content="جديد" Tag="➕"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="سجل جديد"
                        Click="btnNew_Click"/>
                <Button x:Name="btnSave"
                        Content="حفظ" Tag="💾"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="حفظ البيانات"
                        Click="btnSave_Click"/>
                <Button x:Name="btnDelete"
                        Content="حذف" Tag="🗑️"
                        Style="{StaticResource ToolbarButton}"
                        ToolTip="حذف السجل"
                        Click="btnDelete_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>