<Window x:Class="SmartAuditERP.Form_WPF.FrmBond"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💰 تسديد السلف" 
        Height="450" Width="700"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F5F5"
        Loaded="FrmBond_Load">

    <Window.Resources>
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2193b0" Offset="0"/>
            <GradientStop Color="#6dd5ed" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#483D8B" Offset="0"/>
            <GradientStop Color="#6A5ACD" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1e7e34" Offset="0"/>
            <GradientStop Color="#28a745" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8B0000" Offset="0"/>
            <GradientStop Color="#B22222" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Styles -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="White" 
                                BorderBrush="{StaticResource PrimaryGradient}" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="5,5,0,0"
                                Padding="20,8"
                                Margin="2,0">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <GroupBox x:Name="GroupBox1" 
                  Background="White" 
                  Margin="10">
            <TabControl x:Name="TabControl1">
                <!-- Tab 1: تسديد السلف -->
                <TabItem x:Name="TabPage1" Header="💳 تسديد السلف">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Form Content -->
                        <GroupBox Grid.Row="0" 
                                 x:Name="GroupBox2"
                                 Header="📝 تسديد سلفة" 
                                 FontWeight="Bold"
                                 Margin="10"
                                 Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 1: Employee & Type -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          x:Name="Label7"
                                          Text="👤 الموظف" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,15"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                         x:Name="cmbEmp"
                                         FontWeight="Bold"
                                         Padding="5"
                                         Margin="0,0,20,15"
                                         DisplayMemberPath="name"
                                         SelectedValuePath="id"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" 
                                          x:Name="Label6"
                                          Text="📋 النوع" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,15"/>
                                <TextBox Grid.Row="0" Grid.Column="3"
                                        Text="سلفة"
                                        IsReadOnly="True"
                                        FontWeight="Bold"
                                        Padding="5"
                                        Margin="0,0,0,15"/>

                                <!-- Row 2: Date & Amount -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          x:Name="Label3"
                                          Text="📅 التاريخ" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,15"/>
                                <DatePicker Grid.Row="1" Grid.Column="1"
                                           x:Name="txtDate"
                                           FontWeight="Bold"
                                           Padding="5"
                                           Margin="0,0,20,15"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" 
                                          x:Name="Label4"
                                          Text="💵 المبلغ" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,15"/>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                        x:Name="txtVal"
                                        FontWeight="Bold"
                                        Padding="5"
                                        Margin="0,0,0,15"/>

                                <!-- Row 3: Notes -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                          x:Name="Label5"
                                          Text="📝 ملاحظات" 
                                          VerticalAlignment="Top" 
                                          Margin="0,5,10,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                        x:Name="txtNotes"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        FontWeight="Bold"
                                        Padding="5"
                                        Height="80"
                                        Margin="0,0,0,15"/>
                            </Grid>
                        </GroupBox>

                        <!-- Action Panel -->
                        <Border Grid.Row="1" 
                               x:Name="pnlOperBtns"
                               BorderBrush="#CCC" 
                               BorderThickness="1" 
                               Padding="10"
                               Margin="10,0,10,10">
                            <StackPanel Orientation="Horizontal" 
                                       HorizontalAlignment="Center">

                                <!-- Close Button -->
                                <Button x:Name="IconButton7"
                                       Style="{StaticResource NavButton}"
                                       Background="{StaticResource DangerGradient}"
                                       ToolTip="إغلاق">
                                    <TextBlock Text="✖️" FontSize="20"/>
                                </Button>

                                <!-- Navigation Buttons -->
                                <Button x:Name="IconButton1"
                                       Style="{StaticResource NavButton}"
                                       ToolTip="الأول">
                                    <TextBlock Text="⏮️" FontSize="20"/>
                                </Button>

                                <Button x:Name="IconButton3"
                                       Style="{StaticResource NavButton}"
                                       ToolTip="السابق">
                                    <TextBlock Text="◀️" FontSize="20"/>
                                </Button>

                                <Button x:Name="IconButton2"
                                       Style="{StaticResource NavButton}"
                                       ToolTip="التالي">
                                    <TextBlock Text="▶️" FontSize="20"/>
                                </Button>

                                <Button x:Name="IconButton5"
                                       Style="{StaticResource NavButton}"
                                       ToolTip="الأخير">
                                    <TextBlock Text="⏭️" FontSize="20"/>
                                </Button>

                                <!-- Action Buttons -->
                                <Button x:Name="IconButton9"
                                       Style="{StaticResource ActionButton}"
                                       Width="50"
                                       ToolTip="حذف">
                                    <StackPanel>
                                        <TextBlock Text="🗑️" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="حذف" FontSize="9"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnView"
                                       Style="{StaticResource ActionButton}"
                                       Width="55"
                                       ToolTip="معاينة">
                                    <StackPanel>
                                        <TextBlock Text="👁️" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="معاينة" FontSize="9"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="IconButton8"
                                       Style="{StaticResource ActionButton}"
                                       Width="55"
                                       ToolTip="طباعة">
                                    <StackPanel>
                                        <TextBlock Text="🖨️" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="طباعة" FontSize="9"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="IconButton6"
                                       Style="{StaticResource ActionButton}"
                                       Width="50"
                                       ToolTip="حفظ">
                                    <StackPanel>
                                        <TextBlock Text="💾" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="حفظ" FontSize="9"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="IconButton4"
                                       Style="{StaticResource ActionButton}"
                                       Width="50"
                                       ToolTip="جديد">
                                    <StackPanel>
                                        <TextBlock Text="➕" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="جديد" FontSize="9"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: البحث -->
                <TabItem x:Name="TabPage2" Header="🔍 البحث">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Criteria -->
                        <GroupBox Grid.Row="0" 
                                 x:Name="GroupBox6"
                                 Header="🔎 البحث" 
                                 FontWeight="Bold"
                                 Margin="10"
                                 Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 1: Employee -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          x:Name="Label8"
                                          Text="👤 الموظف" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,15"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                         x:Name="cmbEmpSrch"
                                         FontWeight="Bold"
                                         Padding="5"
                                         Margin="0,0,10,15"
                                         DisplayMemberPath="name"
                                         SelectedValuePath="id"/>

                                <CheckBox Grid.Row="0" Grid.Column="2"
                                         x:Name="chkAllEmp"
                                         Content="✅ الكل"
                                         VerticalAlignment="Center"
                                         Margin="10,0,10,15"/>

                                <Button Grid.Row="0" Grid.Column="4"
                                       x:Name="btnSearch"
                                       Background="{StaticResource SuccessGradient}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       BorderThickness="0"
                                       Padding="20,10"
                                       Cursor="Hand"
                                       ToolTip="بحث"
                                       Margin="0,0,0,15"
                                       Click="btnSearch_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontSize="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="بحث" FontSize="14"/>
                                    </StackPanel>
                                </Button>

                                <!-- Row 2: From Date -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          x:Name="Label1"
                                          Text="📅 من تاريخ" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,15"/>
                                <DatePicker Grid.Row="1" Grid.Column="1"
                                           x:Name="txtFromDate"
                                           FontWeight="Bold"
                                           Padding="5"
                                           Margin="0,0,10,15"/>

                                <!-- Row 3: To Date -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                          x:Name="Label2"
                                          Text="📅 الى تاريخ" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,0"/>
                                <DatePicker Grid.Row="2" Grid.Column="1"
                                           x:Name="txtToDate"
                                           FontWeight="Bold"
                                           Padding="5"
                                           Margin="0,0,10,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- Search Results -->
                        <GroupBox Grid.Row="1" 
                                 x:Name="GroupBox4"
                                 Header="📊 نتائج البحث" 
                                 FontWeight="Bold"
                                 Margin="10">
                            <DataGrid x:Name="dgvSrch">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم" 
                                                       Binding="{Binding DataGridViewTextBoxColumn1}" 
                                                       Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="رقم الموظف" 
                                                       Binding="{Binding Column11}" 
                                                       Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="اسم الموظف" 
                                                       Binding="{Binding Column1}" 
                                                       Width="200"/>
                                    <DataGridTextColumn Header="القيمة" 
                                                       Binding="{Binding Column2}" 
                                                       Width="100"/>
                                    <DataGridTextColumn Header="النوع" 
                                                       Binding="{Binding Column4}" 
                                                       Width="120"/>
                                    <DataGridTextColumn Header="التاريخ" 
                                                       Binding="{Binding Column3}" 
                                                       Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </GroupBox>
    </Grid>
</Window>