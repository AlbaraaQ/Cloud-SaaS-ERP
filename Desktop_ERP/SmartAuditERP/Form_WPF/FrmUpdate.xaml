<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.FrmUpdate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="تحديث البرنامج"
    Width="700" Height="480"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="5"  ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="InfoBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Tahoma, Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="WizardBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- Wizard بثلاث صفحات -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer/Navigation -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="lblPageTitle"
                               Text="مرحباً"
                               Foreground="White" FontSize="16" FontWeight="Bold"
                               FontFamily="Cairo, Tahoma, Arial"/>
                    <TextBlock x:Name="lblPageDesc"
                               Text="لتحديث البرنامج يجب أن يكون الجهاز متصلاً بالإنترنت"
                               Foreground="White" FontSize="11"
                               FontFamily="Cairo, Tahoma, Arial"
                               Opacity="0.85" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- مؤشر الصفحات -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="dot1" Background="White" CornerRadius="8"
                            Width="16" Height="16" Margin="3,0"/>
                    <Border x:Name="dot2" Background="White" CornerRadius="8"
                            Width="12" Height="12" Opacity="0.5" Margin="3,0"/>
                    <Border x:Name="dot3" Background="White" CornerRadius="8"
                            Width="12" Height="12" Opacity="0.5" Margin="3,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: TabControl بدون Tabs (Wizard-style) -->
        <TabControl x:Name="wizardPages"
                    Grid.Row="1"
                    TabStripPlacement="Left"
                    Background="White"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.Resources>

            <!-- ─── Page 1: الترحيب ─── -->
            <TabItem>
                <Grid Background="White" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- جدول المقارنة بين النسخ -->
                    <Border Grid.Row="0"
                            Background="#3F3F3F"
                            CornerRadius="8" Padding="12,10"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- رؤوس الجداول -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="النسخة الحديثة"
                                       Foreground="White" FontWeight="Bold"
                                       FontSize="12" HorizontalAlignment="Center"
                                       FontFamily="Cairo, Tahoma, Arial"
                                       Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="النسخة الحالية"
                                       Foreground="White" FontWeight="Bold"
                                       FontSize="12" HorizontalAlignment="Center"
                                       FontFamily="Cairo, Tahoma, Arial"
                                       Margin="0,0,0,6"/>

                            <!-- رقم النسخة -->
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     x:Name="txtOnlineVersion"
                                     Style="{StaticResource InfoBox}"
                                     Foreground="White"
                                     Height="24"/>
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     x:Name="TxtCurrentVer"
                                     Style="{StaticResource InfoBox}"
                                     Foreground="White"
                                     Height="24"/>

                            <!-- التاريخ -->
                            <TextBox Grid.Row="2" Grid.Column="0"
                                     x:Name="txtOnlineVersionDate"
                                     Style="{StaticResource InfoBox}"
                                     Foreground="LightGray"
                                     Height="22"/>
                            <TextBox Grid.Row="2" Grid.Column="2"
                                     x:Name="TxtCurrentVerDate"
                                     Style="{StaticResource InfoBox}"
                                     Foreground="LightGray"
                                     Height="22"/>
                        </Grid>
                    </Border>

                    <!-- طريقة التحديث -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="🔄 اختر طريقة التحديث"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#213A7A" HorizontalAlignment="Center"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton x:Name="rbOnline"
                                         Content="🌐 تحديث أونلاين"
                                         Style="{StaticResource ModernRadio}"
                                         IsChecked="True"
                                         Margin="0,0,16,0"/>
                            <RadioButton x:Name="rbManual"
                                         Content="📁 تحديث يدوي"
                                         Style="{StaticResource ModernRadio}"
                                         Checked="rbManual_Checked"
                                         Unchecked="rbManual_Unchecked"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- معلومات إضافية -->
                    <TextBlock Grid.Row="2"
                               x:Name="lblWelcomeInfo"
                               Text="للاستمرار اضغط التالي >"
                               FontSize="11" FontWeight="Bold"
                               Foreground="#555" HorizontalAlignment="Center"
                               FontFamily="Cairo, Tahoma, Arial"
                               Margin="0,12,0,0"/>
                </Grid>
            </TabItem>

            <!-- ─── Page 2: التحميل ─── -->
            <TabItem>
                <Grid Background="White" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="📥 جارِ تحميل ملفات التحديث..."
                               FontSize="14" FontWeight="Bold"
                               Foreground="#213A7A" HorizontalAlignment="Center"
                               FontFamily="Cairo, Tahoma, Arial"
                               Margin="0,10,0,20"/>

                    <!-- مسار ملف التحديث اليدوي -->
                    <Grid Grid.Row="1" x:Name="pnlManualPath" Visibility="Collapsed"
                          Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtPath" Grid.Column="0"
                                 Height="28" FontSize="11"
                                 Background="White"
                                 BorderBrush="{StaticResource BorderLight}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"/>
                        <Button Grid.Column="2"
                                x:Name="btnPath"
                                Content="📁 المسار"
                                Background="{StaticResource HeaderBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Height="28"
                                Cursor="Hand"
                                Click="btnPath_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ProgressBar -->
                    <ProgressBar Grid.Row="2"
                                 x:Name="ProgressBar1"
                                 Height="14"
                                 Background="#E0E6F5"
                                 Foreground="{StaticResource SaveBrush}"
                                 Minimum="0" Maximum="100" Value="0"
                                 Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="3"
                               x:Name="lblDownloadStatus"
                               Text="انتظر جارِ التحميل..."
                               FontSize="11"
                               Foreground="#555" HorizontalAlignment="Center"
                               FontFamily="Cairo, Tahoma, Arial"/>
                </Grid>
            </TabItem>

            <!-- ─── Page 3: الاكتمال ─── -->
            <TabItem>
                <Grid Background="White" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="✅" FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="تم تنزيل ملفات البرنامج"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#213A7A" HorizontalAlignment="Center"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="سيتم إغلاق البرنامج لإتمام عملية التحديث"
                                   FontSize="12" Foreground="#555"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cairo, Tahoma, Arial"/>
                    </StackPanel>

                    <ProgressBar Grid.Row="1"
                                 x:Name="ProgressBar2"
                                 Height="10"
                                 Background="#E0E6F5"
                                 Foreground="{StaticResource SaveBrush}"
                                 Minimum="0" Maximum="100" Value="100"
                                 Margin="0,0,0,8"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer Navigation -->
        <Border Grid.Row="2"
                Background="#F0F4FF"
                BorderBrush="{StaticResource BorderLight}"
                FlowDirection="LeftToRight"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- إلغاء -->
                <Button Grid.Column="0"
                        Content="✖ إلغاء"
                        Background="{StaticResource DangerBrush}"
                        Style="{StaticResource WizardBtn}"
                        Width="90"
                        Click="btnCancel_Click"/>

                <!-- التالي / إنتهاء -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrev"
                            Content="رجوع"
                            Background="#708090"
                            Style="{StaticResource WizardBtn}"
                            Width="90" Margin="0,0,6,0"
                            IsEnabled="False"
                            Click="btnPrev_Click"/>
                    <Button x:Name="btnNext"
                            Content="التالي >"
                            Background="{StaticResource HeaderBrush}"
                            Style="{StaticResource WizardBtn}"
                            Width="90"
                            Click="btnNext_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>