<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmOwners"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تعريف مالك"
    Width="780" Height="560"
    MinWidth="700" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B9BD5" Offset="0"/>
            <GradientStop Color="#2E75B6" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- FieldLabel Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ModernTextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernTextBoxMulti Style -->
        <Style x:Key="ModernTextBoxMulti" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- ModernComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ActionBtn Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12"
                    FontWeight="Bold"
                    Background="#F3F5F9">

            <!-- ═══ تبويب عام ═══ -->
            <TabItem Header="   🏠 عـــام   ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White"
                            Margin="8,8,8,4"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- عنوان القسم -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8"
                                    Padding="12,7"
                                    Margin="0,0,0,14">
                                <TextBlock Text="👤 البيانات الأساسية"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- صف بيانات الهوية + الصورة -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- صورة الهوية -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🪪 صورة الهوية"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,5"/>
                                    <Border BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Width="190" Height="160"
                                            Background="#F5F7FA"
                                            HorizontalAlignment="Right">
                                        <Image x:Name="IDscan"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Button x:Name="btnScan"
                                            Content="📷 مسح ضوئي"
                                            Style="{StaticResource ActionBtn}"
                                            Margin="0,8,0,0"
                                            Click="btnScan_Click"/>
                                </StackPanel>

                                <!-- حقول البيانات -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- الاسم -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="👤 الاسم:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- الجوال -->
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="📱 الجوال:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtMobile" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- رقم الهوية -->
                                    <StackPanel Grid.Row="4">
                                        <TextBlock Text="🪪 رقم الهوية:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtNationalID" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- الرقم الضريبي -->
                                    <StackPanel Grid.Row="6">
                                        <TextBlock Text="🧾 الرقم الضريبي:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtTaxNo" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <!-- رقم الحساب -->
                                    <StackPanel Grid.Row="8">
                                        <TextBlock Text="🔢 رقم الحساب:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtAccCode"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تبويب بيانات إضافية ═══ -->
            <TabItem Header="   📋 بيانات إضافية   ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White"
                            Margin="8,8,8,4"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            Padding="16,12">
                        <StackPanel>

                            <!-- عنوان -->
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8"
                                    Padding="12,7"
                                    Margin="0,0,0,14">
                                <TextBlock Text="📋 بيانات إضافية"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- الدولة والمدينة -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- الدولة -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🌍 الدولة:" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbCountry"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"
                                                  SelectionChanged="cmbCountry_SelectionChanged"/>
                                        <Button x:Name="btnCountryAdd"
                                                Grid.Column="2"
                                                Content="➕"
                                                Style="{StaticResource InfoBtn}"
                                                ToolTip="إضافة دولة"
                                                Click="btnCountryAdd_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- المدينة -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="🏙️ المدينة:" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbCity"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"
                                                  SelectionChanged="cmbCity_SelectionChanged"/>
                                        <Button x:Name="btnCityAdd"
                                                Grid.Column="2"
                                                Content="➕"
                                                Style="{StaticResource InfoBtn}"
                                                ToolTip="إضافة مدينة"
                                                Click="btnCityAdd_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- المنطقة ومجال العمل -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- المنطقة -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🗺️ المنطقة:" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbArea"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"/>
                                        <Button x:Name="btnAreaAdd"
                                                Grid.Column="2"
                                                Content="➕"
                                                Style="{StaticResource InfoBtn}"
                                                ToolTip="إضافة منطقة"
                                                Click="btnAreaAdd_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- مجال العمل -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="💼 مجال العمل:" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbActs"
                                                  Grid.Column="0"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"/>
                                        <Button x:Name="btnActAdd"
                                                Grid.Column="2"
                                                Content="➕"
                                                Style="{StaticResource InfoBtn}"
                                                ToolTip="إضافة مجال"
                                                Click="btnActAdd_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- الهاتف والفاكس -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📞 رقم الهاتف:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtTel" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📠 فاكس:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtFax" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <!-- البريد الإلكتروني -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="📧 البريد الإلكتروني:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <!-- الرصيد الافتتاحي -->
                            <Border Background="#F8F9FD"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="💰 الرصيد الافتتاحي"
                                               Style="{StaticResource FieldLabel}"
                                               FontSize="12"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- مدين/دائن -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <RadioButton x:Name="debt"
                                                         Content="مدين"
                                                         IsChecked="True"
                                                         Foreground="#1B2642"
                                                         FontWeight="Bold"
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"/>
                                            <RadioButton x:Name="credit"
                                                         Content="دائن"
                                                         Foreground="#1B2642"
                                                         FontWeight="Bold"
                                                         VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- مركز التكلفة -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="مركز التكلفة:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="cmbCostCenter"
                                                      Style="{StaticResource ModernComboBox}"
                                                      Width="160"
                                                      DisplayMemberPath="name"
                                                      SelectedValuePath="id"/>
                                        </StackPanel>

                                        <!-- القيمة -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="القيمة:" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="IValue"
                                                     Style="{StaticResource ModernTextBox}"
                                                     TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ملاحظات -->
                            <StackPanel>
                                <TextBlock Text="📝 ملاحظات:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNotes" Style="{StaticResource ModernTextBoxMulti}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تبويب البحث ═══ -->
            <TabItem Header="   🔍 البحث   ">
                <Grid Margin="8,8,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- بطاقة البحث -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            Padding="14,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="🔍 البحث بالاسم:"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtNameSrch"
                                     Grid.Column="2"
                                     Style="{StaticResource ModernTextBox}"
                                     KeyDown="txtNameSrch_KeyDown"/>

                            <Button x:Name="btnSearch"
                                    Grid.Column="4"
                                    Content="🔍 بحث"
                                    Style="{StaticResource ActionBtn}"
                                    Width="80"
                                    Click="btnSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- جدول النتائج -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvOwners"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseLeftButtonUp="dgvOwners_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم"
                                                        Binding="{Binding id}"
                                                        Width="0"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الاسم"
                                                        Binding="{Binding name}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="رقم الهوية"
                                                        Binding="{Binding national_id}"
                                                        Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="رقم الهاتف"
                                                        Binding="{Binding tel}"
                                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="رقم الجوال"
                                                        Binding="{Binding mobile}"
                                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الدولة"
                                                        Binding="{Binding countryName}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المدينة"
                                                        Binding="{Binding cityName}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المنطقة"
                                                        Binding="{Binding areaName}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل والخروج -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="40" ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>