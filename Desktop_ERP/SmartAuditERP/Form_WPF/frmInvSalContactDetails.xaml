<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvSalContactDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تقرير فواتير المقاولات"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="LeftToRight"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WarningBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#C47D0A" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6"  ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"    Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="MinWidth"        Value="60"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Background"      Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Effect"          Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        </Style>

        <Style x:Key="InCellBtn"  TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgress" TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="Foreground"      Value="#3A63C3"/>
            <Setter Property="Background"      Value="#E0E6F5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="DxRowStyle" TargetType="dxg:RowControl">
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        
    </dx:ThemedWindow.Resources>

    <!-- ══════════════════ ROOT GRID ══════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--  COLUMN 0 : Main Content                  -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Menu Bar ─── -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    Padding="8,4">
                <Menu Background="Transparent" FlowDirection="RightToLeft">
                    <MenuItem x:Name="menuOperations"
                              Header="⚙️ عمليات"
                              Foreground="White"
                              FontSize="13" FontWeight="Bold"
                              Background="Transparent">
                        <MenuItem.Resources>
                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground" Value="#1B2642"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize"   Value="12"/>
                            </Style>
                        </MenuItem.Resources>
                        <MenuItem x:Name="menuChangePayType"
                                  Header="💳 تغيير طريقة الدفع">
                            <MenuItem x:Name="menuCash"
                                      Header="💵 نقدي"
                                      Click="menuCash_Click"/>
                            <MenuItem x:Name="menuVisa"
                                      Header="🏦 شبكة (بنوك)"/>
                            <MenuItem x:Name="menuCredit"
                                      Header="📋 آجل"
                                      Click="menuCredit_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="menuChangeAccount"
                                  Header="🔄 تغيير حساب">
                            <MenuItem x:Name="menuChangeCustomer"
                                      Header="👤 العميل"
                                      Click="menuChangeCustomer_Click"/>
                        </MenuItem>
                    </MenuItem>
                </Menu>
            </Border>

            <!-- ─── Progress Top ─── -->
            <ProgressBar x:Name="progressBarTop"
                         Grid.Row="1"
                         Style="{StaticResource ModernProgress}"
                         Value="0" Maximum="100"
                         Margin="0,2,0,0"/>

            <!-- ─── Grid Area ─── -->
            <Border Grid.Row="2"
        Background="White"
        Margin="6,6,6,0"
        CornerRadius="10"
        Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                CornerRadius="10,10,0,0">
                        <TextBlock Text="📋 تقرير فواتير المقاولات"
                       Style="{StaticResource SectionTitle}"
                       Margin="12,0"/>
                    </Border>

                    <dxg:GridControl x:Name="GridControl2"
                         Grid.Row="1">

                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="GridView2"
                               ShowGroupPanel="False"
                               ShowTotalSummary="True"
                               NavigationStyle="Row"
                               MultiSelectMode="Row"
                               ShowCheckBoxSelectorColumn="True"
                               AllowPerPixelScrolling="True"/>
                        </dxg:GridControl.View>

                        <dxg:GridControl.Columns>

                            <dxg:GridColumn FieldName="AutoIncrementID"
                                Header="م"
                                Width="50"/>

                            <dxg:GridColumn FieldName="InvoiceType"
                                Header="نوع الفاتورة"
                                Visible="False"/>

                            <dxg:GridColumn FieldName="InvoiceTypeTxt"
                                Header="نوع الفاتورة"
                                Width="110"/>

                            <dxg:GridColumn FieldName="InvoiceNo"
                                Header="رقم الفاتورة"
                                Width="90"/>

                            <dxg:GridColumn FieldName="ReffNo"
                                Header="رقم المرجع"
                                Width="90"/>

                            <dxg:GridColumn FieldName="InvDate"
                                Header="تاريخ الفاتورة"
                                Width="110"/>

                            <dxg:GridColumn FieldName="InvoiceTime"
                                Header="الوقت"
                                Width="100"/>

                            <dxg:GridColumn FieldName="PaymentTxt"
                                Header="نوع الدفع"
                                Width="100"/>

                            <dxg:GridColumn FieldName="Paid"
                                Header="المدفوع"
                                Width="90"/>

                            <dxg:GridColumn FieldName="ClientTxt"
                                Header="العميل"
                                Width="145"/>

                            <dxg:GridColumn FieldName="Paycash"
                                Header="نقدي"
                                Width="90"/>

                            <dxg:GridColumn FieldName="PayATM"
                                Header="شبكة"
                                Width="90"/>

                            <dxg:GridColumn FieldName="SumPrice"
                                Header="المجموع"
                                Width="100"/>

                            <dxg:GridColumn FieldName="TotDiscount"
                                Header="الخصم"
                                Width="100"/>

                            <dxg:GridColumn FieldName="Total"
                                Header="الإجمالي"
                                Width="100"/>

                            <dxg:GridColumn FieldName="VAT"
                                Header="الضريبة"
                                Width="100"/>

                            <dxg:GridColumn FieldName="ExtraVAT"
                                Header="الضريبة الإضافية"
                                Width="120"/>

                            <dxg:GridColumn FieldName="TotalTax"
                                Header="إجمالي الضريبة"
                                Width="120"/>

                            <dxg:GridColumn FieldName="Net"
                                Header="الصافي"
                                Width="100"/>

                            <dxg:GridColumn FieldName="InvertoryName"
                                Header="المستودع"
                                Width="145"/>

                            <dxg:GridColumn FieldName="BranchTxt"
                                Header="الفرع"
                                Width="145"/>

                            <dxg:GridColumn FieldName="SalesmanTxt"
                                Header="المندوب"
                                Width="120"/>

                            <dxg:GridColumn FieldName="UserTxt"
                                Header="المستخدم"
                                Width="120"/>

                            <dxg:GridColumn FieldName="Remainder"
                                Header="الباقي"
                                Width="90"/>

                            <!-- تفاصيل -->
                            <dxg:GridColumn FieldName="details"
                                Header="تفاصيل"
                                Width="95">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🔍 تفاصيل"
                                    Style="{StaticResource InCellBtn}"
                                    Background="{StaticResource HeaderBrush}"
                                    Tag="{Binding Path=RowData.Row}"
                                    Click="BtnDetails_Click"/>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>

                            <!-- عرض الفاتورة -->
                            <dxg:GridColumn FieldName="showInv"
                                Header="عرض الفاتورة"
                                Width="110">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="📄 عرض"
                                    Style="{StaticResource InCellBtn}"
                                    Background="{StaticResource SaveBrush}"
                                    Tag="{Binding Path=RowData.Row}"
                                    Click="BtnShowInv_Click"/>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>

                            <!-- مخفية -->
                            <dxg:GridColumn FieldName="InvGlobalID" Visible="False"/>
                            <dxg:GridColumn FieldName="PayType" Visible="False"/>
                            <dxg:GridColumn FieldName="Customer" Visible="False"/>
                            <dxg:GridColumn FieldName="ProcType" Visible="False"/>
                            <dxg:GridColumn FieldName="InvoiceStatus" Visible="False"/>

                        </dxg:GridControl.Columns>

                        <!-- الملخصات: بديل متوافق عن GridColumn.TotalSummary -->
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem FieldName="AutoIncrementID"
                                     SummaryType="Count"
                                     ShowInColumn="AutoIncrementID"
                                     DisplayFormat="{}{0}"/>

                            <dxg:GridSummaryItem FieldName="Paid"
                                     SummaryType="Sum"
                                     ShowInColumn="Paid"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="Paycash"
                                     SummaryType="Sum"
                                     ShowInColumn="Paycash"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="PayATM"
                                     SummaryType="Sum"
                                     ShowInColumn="PayATM"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="SumPrice"
                                     SummaryType="Sum"
                                     ShowInColumn="SumPrice"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="TotDiscount"
                                     SummaryType="Sum"
                                     ShowInColumn="TotDiscount"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="Total"
                                     SummaryType="Sum"
                                     ShowInColumn="Total"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="VAT"
                                     SummaryType="Sum"
                                     ShowInColumn="VAT"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="ExtraVAT"
                                     SummaryType="Sum"
                                     ShowInColumn="ExtraVAT"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="TotalTax"
                                     SummaryType="Sum"
                                     ShowInColumn="TotalTax"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="Net"
                                     SummaryType="Sum"
                                     ShowInColumn="Net"
                                     DisplayFormat="{}{0:0.##}"/>

                            <dxg:GridSummaryItem FieldName="Remainder"
                                     SummaryType="Sum"
                                     ShowInColumn="Remainder"
                                     DisplayFormat="{}{0:0.##}"/>
                        </dxg:GridControl.TotalSummary>

                    </dxg:GridControl>
                </Grid>
            </Border>
            <!-- ─── Progress Bottom ─── -->
            <ProgressBar x:Name="progressBarBottom"
                         Grid.Row="3"
                         Style="{StaticResource ModernProgress}"
                         Value="0" Maximum="100"
                         Margin="6,4"/>

            <!-- ─── Footer ─── -->
            <Border Grid.Row="4"
                    Background="{StaticResource FooterBrush}"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="btnClose"
                                Content="✖ خروج"
                                Style="{StaticResource DangerBtn}"
                                Width="80" Margin="0,0,6,0"
                                Click="btnClose_Click"/>
                        <Button x:Name="btnExportExcel"
                                Content="📊 تصدير Excel"
                                Style="{StaticResource SaveBtn}"
                                Width="120" Margin="0,0,6,0"
                                Click="btnExportExcel_Click"/>
                        <Button x:Name="btnPrint"
                                Content="🖨️ طباعة"
                                Style="{StaticResource ActionBtn}"
                                Width="90" Margin="0,0,6,0"
                                Click="btnPrint_Click"/>
                        <Button x:Name="btnPreview"
                                Content="👁️ معاينة"
                                Style="{StaticResource WarningBtn}"
                                Width="90"
                                Click="btnPreview_Click"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="btnSaveLayout"
                            Content="💾 حفظ المظهر"
                            Style="{StaticResource ActionBtn}"
                            Width="120"
                            Click="btnSaveLayout_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--  COLUMN 1 : Search Panel                  -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1,0,0,0"
                FlowDirection="RightToLeft"
                Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,10">

                    <!-- عنوان البحث -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <TextBlock Text="🔍 خيارات البحث"
                                   Style="{StaticResource SectionTitle}"/>
                    </Border>

                    <!-- ─── نوع الدفع ─── -->
                    <TextBlock Text="💳 نوع الدفع" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllType"
                                  Grid.Column="0" Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllType_CheckedChanged"
                                  Unchecked="ckAllType_CheckedChanged"/>
                        <ComboBox x:Name="cmbType"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"/>
                    </Grid>

                    <!-- ─── المندوب ─── -->
                    <TextBlock Text="👤 المندوب" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="cbAllSalesmen"
                                  Grid.Column="0" Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="cbAllSalesmen_CheckedChanged"
                                  Unchecked="cbAllSalesmen_CheckedChanged"/>
                        <ComboBox x:Name="cmbSaleman"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"/>
                    </Grid>

                    <!-- ─── المستخدم ─── -->
                    <TextBlock Text="🧑‍💼 المستخدم" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllUsers"
                                  Grid.Column="0" Content="الكل"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllUsers_CheckedChanged"
                                  Unchecked="ckAllUsers_CheckedChanged"/>
                        <ComboBox x:Name="cmbusers"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"/>
                    </Grid>

                    <!-- ─── العميل ─── -->
                    <TextBlock Text="🏢 العميل" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ckAllClients"
                                  Grid.Column="0" Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="ckAllClients_CheckedChanged"
                                  Unchecked="ckAllClients_CheckedChanged"/>
                        <ComboBox x:Name="cmbClients"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"/>
                    </Grid>

                    <!-- ─── الفرع ─── -->
                    <TextBlock Text="🏬 الفرع" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkAllBranches"
                                  Grid.Column="0" Content="الكل"
                                  IsChecked="True"
                                  Style="{StaticResource ModernCheck}"
                                  Margin="0,0,6,0"
                                  Checked="chkAllBranches_CheckedChanged"
                                  Unchecked="chkAllBranches_CheckedChanged"/>
                        <ComboBox x:Name="cmbBranches"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernCombo}"/>
                    </Grid>

                    <!-- ─── الفترة ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="8,5" Margin="0,6,0,8">
                        <TextBlock Text="📅 الفترة الزمنية"
                                   Style="{StaticResource SectionTitle}"/>
                    </Border>

                    <CheckBox x:Name="ckTotalPeriod"
                              Content="📌 كل الفترة"
                              IsChecked="True"
                              Style="{StaticResource ModernCheck}"
                              Margin="0,0,0,8"
                              Checked="ckTotalPeriod_CheckedChanged"
                              Unchecked="ckTotalPeriod_CheckedChanged"/>

                    <TextBlock Text="📅 من تاريخ" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="txtFromDate"
                                Style="{StaticResource ModernDatePicker}"
                                IsEnabled="False"
                                Margin="0,0,0,4"/>

                    <TextBlock Text="⏰ وقت البداية" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtStartTime"
                             Style="{StaticResource ModernTextBox}"
                             Text="00:00:00"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="📅 إلى تاريخ" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="txtToDate"
                                Style="{StaticResource ModernDatePicker}"
                                IsEnabled="False"
                                Margin="0,0,0,4"/>

                    <TextBlock Text="⏰ وقت النهاية" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtEndTime"
                             Style="{StaticResource ModernTextBox}"
                             Text="23:59:00"
                             Margin="0,0,0,10"/>

                    <!-- ─── حالة الدفع ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="8,5" Margin="0,4,0,8">
                        <TextBlock Text="💰 حالة الدفع"
                                   Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <StackPanel Margin="4,0,0,10">
                        <RadioButton x:Name="ckAllpaids"
                                     Content="🔵 الكل"
                                     IsChecked="True"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="PayStatus"/>
                        <RadioButton x:Name="rbpaidinvo"
                                     Content="✅ مدفوع"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="PayStatus"/>
                        <RadioButton x:Name="rbunpaidinvo"
                                     Content="❌ غير مدفوع"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="PayStatus"/>
                        <RadioButton x:Name="rbpartialpaidinvo"
                                     Content="⚠️ مدفوع جزئي"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="PayStatus"/>
                    </StackPanel>

                    <!-- ─── الضريبة ─── -->
                    <Border Background="{StaticResource HeaderBrush}"
                            CornerRadius="8" Padding="8,5" Margin="0,4,0,8">
                        <TextBlock Text="🧾 الضريبة"
                                   Style="{StaticResource SectionTitle}"/>
                    </Border>
                    <StackPanel Margin="4,0,0,12">
                        <RadioButton x:Name="rbAllVat"
                                     Content="🔵 الكل"
                                     IsChecked="True"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="VATFilter"/>
                        <RadioButton x:Name="rbWithVat"
                                     Content="✅ مع ضريبة"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="VATFilter"/>
                        <RadioButton x:Name="rbNoVAT"
                                     Content="❌ بدون ضريبة"
                                     Style="{StaticResource ModernRadio}"
                                     GroupName="VATFilter"/>
                    </StackPanel>

                    <!-- ─── زر العرض ─── -->
                    <Button x:Name="Button1"
                            Content="🔍 عرض النتائج"
                            Style="{StaticResource ActionBtn}"
                            Height="44" FontSize="14"
                            Margin="0,6,0,4"
                            Click="Button1_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</dx:ThemedWindow>