<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptIncomeStatement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="أرباح وخسائر حسابات رئيسية"
    WindowState="Maximized"
    MinWidth="897" MinHeight="700"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExcelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27AE60" Offset="0"/>
            <GradientStop Color="#1E8449" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ReadonlyBox" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F0F2F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="ExcelBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExcelBrush}"/>
        </Style>
        <Style x:Key="ShowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ شريط الفلترة العلوي ═══ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="12,10"
                Effect="{StaticResource CardShadow}">
            <StackPanel>

                <!-- عنوان -->
                <Border Background="{StaticResource HeaderBrush}"
                        CornerRadius="8" Padding="10,6"
                        Margin="0,0,0,10">
                    <TextBlock Text="📊 أرباح وخسائر حسابات رئيسية"
                               Foreground="White"
                               FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- صف الفلاتر -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- الفروع -->
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="chkAllBranches"
                                  Content="كل الفروع"
                                  IsChecked="True"
                                  FontSize="11" FontWeight="Bold"
                                  Margin="0,0,0,4"
                                  Checked="chkAllBranches_Changed"
                                  Unchecked="chkAllBranches_Changed"/>
                        <ComboBox x:Name="cmbBranches"
                                  Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="name"
                                  SelectedValuePath="id"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <!-- الفترة الزمنية -->
                    <StackPanel Grid.Column="2">
                        <CheckBox x:Name="ckTotalPeriod"
                                  Content="كل الفترة"
                                  IsChecked="True"
                                  FontSize="11" FontWeight="Bold"
                                  Margin="0,0,0,4"
                                  Checked="ckTotalPeriod_Changed"
                                  Unchecked="ckTotalPeriod_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <dxe:DateEdit x:Name="txtFromDate"
                                          Grid.Column="0"
                                          Height="28" FontSize="11"
                                          IsEnabled="False"/>
                            <dxe:DateEdit x:Name="txtToDate"
                                          Grid.Column="2"
                                          Height="28" FontSize="11"
                                          IsEnabled="False"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtStartTime"
                                     Grid.Column="0"
                                     Height="26" Text="00:00"
                                     IsEnabled="False"
                                     BorderBrush="{StaticResource BorderLight}"
                                     BorderThickness="1"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txtEndTime"
                                     Grid.Column="2"
                                     Height="26" Text="23:59"
                                     IsEnabled="False"
                                     BorderBrush="{StaticResource BorderLight}"
                                     BorderThickness="1"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- فارغ -->
                    <StackPanel Grid.Column="4"/>

                    <!-- زر العرض -->
                    <Button x:Name="btnShow"
                            Grid.Column="6"
                            Content="🔍 عرض"
                            Style="{StaticResource ShowBtn}"
                            Width="90"
                            VerticalAlignment="Bottom"
                            Click="btnShow_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ جدول النتائج ═══ -->
        <Border Grid.Row="1"
                Background="White"
                Margin="6,6,6,4"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="📊 الحسابات"
                               Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <DataGrid x:Name="dgvSrch"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                          RowStyle="{StaticResource DgvRow}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FlowDirection="RightToLeft"
                          Background="White"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EBF5"
                          AlternatingRowBackground="#F8F9FD">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="الحساب"
                                            Binding="{Binding Code}"
                                            Width="100" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="اسم الحساب"
                                            Binding="{Binding Name}"
                                            Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="رصيد مدين"
                                            Binding="{Binding DeptBalance, StringFormat=N2}"
                                            Width="160" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="رصيد دائن"
                                            Binding="{Binding CreditBalance, StringFormat=N2}"
                                            Width="160" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ شريط المجاميع والأرباح ═══ -->
        <Border Grid.Row="2"
                Background="White"
                Margin="6,0,6,4"
                CornerRadius="8"
                Effect="{StaticResource CardShadow}"
                Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- صف 1: قيمة المخزون -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtStockVal"
                             Grid.Column="0"
                             Style="{StaticResource ReadonlyBox}"/>
                    <TextBox x:Name="txtStockVal1"
                             Grid.Column="2"
                             Style="{StaticResource ReadonlyBox}"/>
                    <TextBox Grid.Column="4"
                             Style="{StaticResource ReadonlyBox}"
                             Text="قيمة مخزون بضاعة آخر المدة حتى هذا التاريخ"
                             FontWeight="Bold"/>
                    <TextBox x:Name="txt1"
                             Grid.Column="6"
                             Style="{StaticResource ReadonlyBox}"/>
                </Grid>

                <!-- صف 2: صافي الأرباح -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtProfit2"
                             Grid.Column="0"
                             Style="{StaticResource ReadonlyBox}"/>
                    <TextBox x:Name="txtProfit1"
                             Grid.Column="2"
                             Style="{StaticResource ReadonlyBox}"/>
                    <TextBox x:Name="txtProfitLbl"
                             Grid.Column="4"
                             Style="{StaticResource ReadonlyBox}"
                             Text="صافي أرباح العام"
                             FontWeight="Bold"/>
                    <TextBox x:Name="TextBox1"
                             Grid.Column="6"
                             Style="{StaticResource ReadonlyBox}"/>
                </Grid>

                <!-- صف 3: المجاميع -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtCreditDiff"
                             Grid.Column="0"
                             Style="{StaticResource ReadonlyBox}"/>
                    <TextBox x:Name="txtDeptDiff"
                             Grid.Column="2"
                             Style="{StaticResource ReadonlyBox}"/>
                    <TextBox x:Name="txtIsBalanced"
                             Grid.Column="4"
                             Style="{StaticResource ReadonlyBox}"
                             FontWeight="Bold"
                             Foreground="#27AE60"/>
                    <TextBox x:Name="TextBox6"
                             Grid.Column="6"
                             Style="{StaticResource ReadonlyBox}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="3"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="ProgressBar1"
                             Grid.Column="0"
                             Height="6"
                             Margin="0,0,10,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="White"
                             Background="#3A63C3"
                             VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="90" Margin="0,0,6,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="90" Margin="0,0,6,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="90" Margin="0,0,6,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExcelBtn}"
                            Width="120"
                            Click="btnExport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>