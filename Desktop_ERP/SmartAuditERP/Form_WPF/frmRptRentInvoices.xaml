<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptRentInvoices"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="تقرير فواتير التأجير"
    Width="1100" Height="580"
    MinWidth="1000" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F5F7FB"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1DB954" Offset="0"/>
            <GradientStop Color="#158A3E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A90D9" Offset="0"/>
            <GradientStop Color="#2E6DA8" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="ExportBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>
        <Style x:Key="PrintBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#FFFFFF33"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE6F8"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1B3A6B"/>
        </Style>

        <Style x:Key="SummaryBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar Filter -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Summary -->
        </Grid.RowDefinitions>

        <!-- ═══ شريط الفلاتر العلوي ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="10,8">
            <StackPanel>

                <!-- الصف الأول من الفلاتر -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">

                    <!-- المستخدم -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="👤 المستخدم:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <ComboBox x:Name="cmbUsers"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="140"
                                  SelectionChanged="cmbUsers_SelectionChanged"/>
                    </StackPanel>

                    <!-- الفئة -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="📁 الفئة:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <ComboBox x:Name="cmbGroups"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="130"
                                  SelectionChanged="cmbGroups_SelectionChanged"/>
                    </StackPanel>

                    <!-- اسم العميل -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="👥 العميل:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <TextBox x:Name="txtClientName"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="140"
                                 TextChanged="txtClientName_TextChanged"/>
                    </StackPanel>

                    <!-- جوال العميل -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="📱 الجوال:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <TextBox x:Name="txtClientMobile"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="130"
                                 TextChanged="txtClientMobile_TextChanged"/>
                    </StackPanel>

                </WrapPanel>

                <!-- الصف الثاني من الفلاتر -->
                <WrapPanel Orientation="Horizontal">

                    <!-- التاريخ من -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="📅 من:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <dxe:DateEdit x:Name="txtFromDate"
                                      Height="28" Width="120" FontSize="11"/>
                    </StackPanel>

                    <!-- التاريخ إلى -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="إلى:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <dxe:DateEdit x:Name="txtToDate"
                                      Height="28" Width="120" FontSize="11"/>
                    </StackPanel>

                    <!-- رقم الفاتورة -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🔢 رقم الفاتورة:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <TextBox x:Name="txtInvNo"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="100"
                                 TextChanged="txtInvNo_TextChanged"/>
                    </StackPanel>

                    <!-- نوع العملية -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="⚙️ نوع العملية:"
                                   Style="{StaticResource FilterLabel}"
                                   Foreground="White" Margin="0,0,4,0"/>
                        <ComboBox x:Name="cmbProcType"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="110"
                                  SelectionChanged="cmbProcType_SelectionChanged"/>
                    </StackPanel>

                    <!-- ضمن الخطة -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <RadioButton x:Name="rdAll"
                                     Content="الكل"
                                     GroupName="PlanGroup"
                                     Style="{StaticResource ModernRadio}"
                                     IsChecked="True"
                                     Checked="rdAll_CheckedChanged"/>
                        <RadioButton x:Name="rdInPlan"
                                     Content="ضمن الخطة"
                                     GroupName="PlanGroup"
                                     Style="{StaticResource ModernRadio}"
                                     Checked="rdInPlan_CheckedChanged"/>
                        <RadioButton x:Name="rdOutPlan"
                                     Content="خارج الخطة"
                                     GroupName="PlanGroup"
                                     Style="{StaticResource ModernRadio}"
                                     Checked="rdOutPlan_CheckedChanged"/>
                    </StackPanel>

                    <!-- زر تصفية الحقول -->
                    <Button x:Name="btnClear"
                            Content="🔄 تصفية الحقول"
                            Style="{StaticResource ActionBtn}"
                            Background="#F5A623"
                            Width="130"
                            Click="btnClear_Click"/>

                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ DataGrid الرئيسي ═══ -->
        <Border Grid.Row="1"
                Background="White"
                Margin="6,6,6,4"
                CornerRadius="8"
                Effect="{StaticResource CardShadow}">
            <DataGrid x:Name="dgvItems"
                      AutoGenerateColumns="False"
                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                      RowStyle="{StaticResource DgvRow}"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FlowDirection="RightToLeft"
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8EBF5"
                      AlternatingRowBackground="#F8F9FD"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      SelectionChanged="dgvItems_SelectionChanged"
                      MouseDoubleClick="dgvItems_MouseDoubleClick">
                <DataGrid.Columns>

                    <!-- proc_id مخفي -->
                    <DataGridTextColumn Header="proc_id"
                                        Binding="{Binding proc_id}"
                                        Width="0" Visibility="Collapsed"/>

                    <!-- proc_type مخفي -->
                    <DataGridTextColumn Header="proc_type"
                                        Binding="{Binding proc_type}"
                                        Width="0" Visibility="Collapsed"/>

                    <!-- الرقم -->
                    <DataGridTextColumn Header="الرقم"
                                        Binding="{Binding id}"
                                        Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- المركب -->
                    <DataGridTextColumn Header="المركب"
                                        Binding="{Binding marine}"
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الفئة -->
                    <DataGridTextColumn Header="الفئة"
                                        Binding="{Binding Groupcode}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الصافي -->
                    <DataGridTextColumn Header="الصافي"
                                        Binding="{Binding Net, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- التاريخ -->
                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding date1, StringFormat=d}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- العميل -->
                    <DataGridTextColumn Header="العميل"
                                        Binding="{Binding cust}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- المستخدم -->
                    <DataGridTextColumn Header="المستخدم"
                                        Binding="{Binding emp}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الجوال -->
                    <DataGridTextColumn Header="الجوال"
                                        Binding="{Binding mobile}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ضمن الخطة -->
                    <DataGridCheckBoxColumn Header="ضمن الخطة"
                                            Binding="{Binding InPlan}"
                                            Width="80"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ Footer - المجاميع والأزرار ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر الخروج -->
                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="90" Margin="0,0,6,0"
                        Click="btnClose_Click"/>

                <!-- زر العرض -->
                <Button x:Name="btnShow"
                        Grid.Column="1"
                        Content="🔍 عرض"
                        Style="{StaticResource ActionBtn}"
                        Width="120" Margin="0,0,10,0"
                        Click="btnShow_Click"/>

                <!-- إجمالي الفترة -->
                <TextBlock Grid.Column="2"
                           Text="إجمالي الفترة:"
                           Foreground="White" FontWeight="Bold" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>

                <!-- إيرادات -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="إيرادات:"
                               Foreground="#B0C4FF" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtTotCredit"
                             Style="{StaticResource SummaryBox}"
                             Width="100"/>
                </StackPanel>

                <!-- مرتجع -->
                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="مرتجع:"
                               Foreground="#B0C4FF" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtTotDept"
                             Style="{StaticResource SummaryBox}"
                             Width="100"/>
                </StackPanel>

                <!-- الصافي -->
                <StackPanel Grid.Column="5" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="الصافي:"
                               Foreground="#B0C4FF" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="txtNet"
                             Style="{StaticResource SummaryBox}"
                             Width="100"/>
                </StackPanel>

                <!-- أزرار اليمين -->
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button x:Name="btnExportExcel"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            MinWidth="110" Margin="0,0,6,0"
                            Click="btnExportExcel_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource PrintBtn}"
                            MinWidth="85" Margin="0,0,6,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            MinWidth="85"
                            Click="btnPrint_Click"/>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>