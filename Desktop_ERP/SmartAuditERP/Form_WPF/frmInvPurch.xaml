<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInvPurch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="فاتورة المشتريات"
    Width="1040" Height="760"
    MinWidth="1040" MinHeight="760"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmSalePurch_Load"
    Closing="frmSalePurch_FormClosing"
    KeyDown="frmInvInOut_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ══════════════════ Brushes ══════════════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B4B9E" Offset="0"/>
            <GradientStop Color="#483D8B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#D97706" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="FieldBg" Color="#FAFBFD"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ══════════════════ Styles ══════════════════ -->

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="SmallAddBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E4E9E"/>
            <Setter Property="Background" Value="#E8EDFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D9F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#1D3268"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Summary Card Style -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,2"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyTextBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             المحتوى الرئيسي: TabControl
             ══════════════════════════════════════════════════════════════ -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0" Grid.RowSpan="2"
                    FontSize="12" FontWeight="Bold"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- ═══════════════ Tab 1: الفاتورة ═══════════════ -->
            <TabItem x:Name="TabPage1" Header="📄  الفاتورة  "
                     Padding="30,6">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ GroupBox3: بيانات الفاتورة العلوية ═══ -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6"
                            Effect="{StaticResource CardShadow}">
                        <Grid x:Name="GroupBox3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ سطر 1 ═══ -->
                            <!-- طريقة الدفع -->
                            <TextBlock x:Name="lblPaymentMethod" Text="💳 طريقة الدفع"
                                       Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbPayType"
                                      Grid.Row="0" Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,3"
                                      SelectionChanged="cmbType_SelectedIndexChanged"/>

                            <!-- الصندوق -->
                            <TextBlock x:Name="lblSfe" Text="🏦 الصندوق"
                                       Grid.Row="0" Grid.Column="3"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbTreasury"
                                      Grid.Row="0" Grid.Column="4"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,3"
                                      IsEditable="True"/>

                            <!-- نوع الحركة (مخفي) -->
                            <ComboBox x:Name="cmbProcType"
                                      Grid.Row="0" Grid.Column="6"
                                      Visibility="Collapsed"
                                      IsEnabled="False"/>

                            <!-- تحديث الكميات -->
                            <CheckBox x:Name="CkUpdateQty"
                                      Grid.Row="0" Grid.Column="6"
                                      Content="تحديث الكميات"
                                      Foreground="Red"
                                      FontWeight="Bold"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <!-- الرقم -->
                            <TextBlock x:Name="lblNo" Text="🔢 الرقم"
                                       Grid.Row="0" Grid.Column="9"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="0" Grid.Column="10"
                                        Orientation="Horizontal">
                                <TextBox x:Name="txtNo"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         Width="70" Text="12"
                                         Margin="0,3,4,3"/>
                                <TextBox x:Name="txtInvCode"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         Width="62"
                                         Margin="0,3"/>
                            </StackPanel>

                            <!-- ═══ سطر 2 ═══ -->
                            <!-- المورد -->
                            <TextBlock x:Name="lblClient" Text="👤 اسم المورد"
                                       Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbClient"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True"
                                          Margin="0,3"
                                          KeyDown="cmbClient_KeyPress_WPF"
                                          SelectionChanged="cmbClient_SelectedIndexChanged"/>
                                <Button x:Name="btnCustAdd" Content="➕"
                                        Grid.Column="1"
                                        Style="{StaticResource SmallAddBtn}"
                                        Margin="3,0,0,0"
                                        ToolTip="إضافة مورد"
                                        Click="btnCustAdd_Click"/>
                                <Button x:Name="btnZoom" Content="🔍"
                                        Grid.Column="2"
                                        Style="{StaticResource SmallAddBtn}"
                                        Margin="3,0,0,0"
                                        ToolTip="بحث عن مورد"
                                        Click="btnZoom_Click"/>
                            </Grid>

                            <!-- المستودع -->
                            <TextBlock x:Name="lblStore" Text="🏪 المستودع"
                                       Grid.Row="1" Grid.Column="3"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbStore"
                                      Grid.Row="1" Grid.Column="4"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      Margin="0,3"/>

                            <!-- البنك -->
                            <TextBlock x:Name="lblBank" Text="🏦 البنك"
                                       Grid.Row="1" Grid.Column="6"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbBanks"
                                      Grid.Row="1" Grid.Column="7"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      Margin="0,3"/>

                            <!-- التاريخ -->
                            <TextBlock x:Name="lblDate" Text="📅 التاريخ"
                                       Grid.Row="1" Grid.Column="9"
                                       Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtDate"
                                          Grid.Row="1" Grid.Column="10"
                                          Height="28" Margin="0,3"
                                          FontSize="12" FontWeight="SemiBold"
                                          EditValueChanged="txtDate_ValueChanged"/>

                            <!-- ═══ سطر 3 ═══ -->
                            <!-- المندوب -->
                            <TextBlock x:Name="lblSalesMen" Text="🧑‍💼 المندوب"
                                       Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Row="2" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbSalesMen"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True"
                                          Margin="0,3"/>
                                <Button x:Name="cmbAddSalesMen" Content="➕"
                                        Grid.Column="1"
                                        Style="{StaticResource SmallAddBtn}"
                                        Margin="3,0,0,0"
                                        ToolTip="إضافة مندوب"
                                        Click="cmbAddSalesMen_Click"/>
                            </Grid>

                            <!-- مركز التكلفة -->
                            <TextBlock x:Name="lblCostCenter" Text="📊 مركز التكلفة"
                                       Grid.Row="2" Grid.Column="3"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Row="2" Grid.Column="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cmbCostCenter"
                                          Grid.Column="0"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True"
                                          Margin="0,3"/>
                                <Button x:Name="btnAddCostCenter" Content="➕"
                                        Grid.Column="1"
                                        Style="{StaticResource SmallAddBtn}"
                                        Margin="3,0,0,0"
                                        ToolTip="إضافة مركز تكلفة"
                                        Click="btnAddCostCenter_Click"/>
                            </Grid>

                            <!-- الرصيد -->
                            <TextBlock Text="💰 الرصيد"
                                       Grid.Row="2" Grid.Column="6"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="2" Grid.Column="7"
                                        Orientation="Horizontal" Margin="0,3">
                                <TextBox x:Name="txtBalance"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         Width="80" Margin="0,0,4,0"/>
                                <TextBox x:Name="txtBalancePreviews"
                                         Style="{StaticResource ReadOnlyTextBox}"
                                         Width="80"/>
                            </StackPanel>

                            <!-- وقت الفاتورة -->
                            <TextBlock x:Name="Label3" Text="🕐 وقت الفاتورة"
                                       Grid.Row="2" Grid.Column="9"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="2" Grid.Column="10"
                                        Orientation="Horizontal">
                                <TextBox x:Name="txtInvTime"
                                         Style="{StaticResource ModernTextBox}"
                                         Width="80"
                                         HorizontalContentAlignment="Center"
                                         Margin="0,3,4,3"
                                         GotFocus="txtInvTime_GotFocus"
                                         LostFocus="txtInvTime_LostFocus"/>
                                <TextBlock x:Name="lblCurrentTime"
                                           Text="الوقت"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="Green"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ═══ سطر 4 ═══ -->
                            <!-- البيان -->
                            <TextBlock x:Name="lblNote" Text="📝 البيان"
                                       Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNote"
                                     Grid.Row="3" Grid.Column="1"
                                     Grid.ColumnSpan="4"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,3"
                                     TextChanged="txtNote_TextChanged"/>

                            <!-- إدراج -->
                            <Button x:Name="btnInsertLinkedInv"
                                    Grid.Row="3" Grid.Column="6"
                                    Content="📥 إدراج"
                                    Style="{StaticResource ActionBtn}"
                                    Background="{StaticResource InfoBrush}"
                                    Height="28" Width="80"
                                    Visibility="Collapsed"
                                    Click="btnInsertLinkedInv_Click"/>

                            <!-- المرجع -->
                            <TextBlock x:Name="lblRefNo" Text="📋 المرجع"
                                       Grid.Row="3" Grid.Column="9"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="3" Grid.Column="10"
                                        Orientation="Horizontal" Margin="0,3">
                                <TextBox x:Name="txtRefNo"
                                         Style="{StaticResource ModernTextBox}"
                                         Width="68"
                                         HorizontalContentAlignment="Center"
                                         Margin="0,0,4,0"
                                         TextChanged="txtRefNo_TextChanged"/>
                                <dxe:DateEdit x:Name="txtRefDate"
                                              Width="68" Height="28"
                                              IsEnabled="False"
                                              FontSize="11"/>
                            </StackPanel>

                            <!-- عناصر مخفية -->
                            <TextBlock x:Name="LblReturn" Grid.Row="0" Grid.Column="7"
                                       Foreground="Red" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="lblRefDate" Visibility="Collapsed"/>
                            <TextBlock x:Name="Label5" Visibility="Collapsed"/>
                            <ComboBox x:Name="cmbProcTypeSrch" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- ═══ Panel4: شريط الباركود والبحث ═══ -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1"
                            Padding="10,4">
                        <Grid x:Name="Panel4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- الباركود -->
                            <TextBlock x:Name="lblBarcode" Text="📦 الباركود"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtBarcode"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     HorizontalContentAlignment="Center"
                                     Margin="0,2"/>

                            <!-- بحث في الجدول -->
                            <TextBlock Text="🔎 بحث"
                                       Grid.Column="3"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSrchDgv"
                                     Grid.Column="4"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,2"
                                     TextChanged="txtSrchDgv_TextChanged"/>

                            <!-- بدون ضريبة -->
                            <Border Grid.Column="5"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="6,0" Margin="6,2">
                                <CheckBox x:Name="ckZeroVAT"
                                          Content="بدون ضريبة"
                                          FontSize="11" FontWeight="Bold"
                                          VerticalAlignment="Center"
                                          Checked="ckZeroVAT_CheckedChanged"
                                          Unchecked="ckZeroVAT_CheckedChanged"/>
                            </Border>

                            <!-- إضافة صنف -->
                            <Button x:Name="btnAddNewItem"
                                    Grid.Column="6"
                                    Content="➕"
                                    Style="{StaticResource SmallAddBtn}"
                                    ToolTip="إضافة صنف جديد"
                                    Margin="4,0"
                                    Click="btnAddNewItem_Click"/>

                            <!-- عادي / تلقائي (مخفي) -->
                            <StackPanel x:Name="GroupBox1" Grid.Column="7"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed" Margin="6,0">
                                <RadioButton x:Name="rdNormal" Content="عادي"
                                             IsChecked="True" Margin="0,0,8,0"
                                             FontSize="11" VerticalAlignment="Center"/>
                                <RadioButton x:Name="rdAuto" Content="تلقائي"
                                             FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CheckBox1 مخفي -->
                            <CheckBox x:Name="CheckBox1" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- ═══ GridControl1: جدول الأصناف ═══ -->
                    <Border Grid.Row="2"
                            Background="White"
                            Margin="6,4,6,0"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}">
                        <Grid x:Name="GroupBox7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- عنوان الجدول -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <TextBlock Text="📋 بنود الفاتورة"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <!-- DataGrid بدلاً من DevExpress GridControl -->
                            <DataGrid x:Name="GridControl1"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      KeyDown="GridView1_KeyDown_WPF"
                                      CellEditEnding="GridView1_CellEditEnding_WPF"
                                      CurrentCellChanged="GridView1_FocusedRowChanged_WPF">

                                <DataGrid.ContextMenu>
                                    <ContextMenu FlowDirection="RightToLeft"
                                                 FontFamily="Cairo, Tahoma, Arial"
                                                 FontSize="12">
                                        <MenuItem Header="📋 إستعراض المادة"
                                                  Click="MenuShowItemCard_Click"/>
                                        <MenuItem Header="➕ إضافة مادة"
                                                  Click="MenuAddNewProduct_Click"/>
                                        <Separator/>
                                        <MenuItem Header="📏 الوحدات"
                                                  Click="MenuShowItemUnits_Click"/>
                                        <MenuItem Header="🏪 مخزون الصنف"
                                                  Click="MenuShowItemInvertory_Click"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ حذف سجل"
                                                  Click="MenuDeleteRow_Click"/>
                                        <Separator/>
                                        <MenuItem Header="📊 حركة المادة"
                                                  Click="MenuItemProcess_Click"/>
                                        <MenuItem Header="📈 اخر حركة للمادة"
                                                  Click="MenuItemLastActivity_Click"/>
                                        <MenuItem Header="📈 اخر حركة للمورد"
                                                  Click="MenuClientActivity_Click"/>
                                        <Separator/>
                                        <MenuItem Header="🔢 الرقم التسلسلي"
                                                  Click="MenuItemSerialNo_Click"/>
                                        <MenuItem Header="💰 تكلفة المادة"
                                                  Click="MenuItemCost_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <!-- # -->
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding ItemRowIndex}"
                                                        Width="40" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- رمز الصنف -->
                                    <DataGridTextColumn Header="رمز الصنف"
                                                        Binding="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- رقم الصنف (مخفي) -->
                                    <DataGridTextColumn Header="رقم الصنف"
                                                        Binding="{Binding ItemId}"
                                                        Visibility="Collapsed"/>

                                    <!-- الصنف + زر بحث -->
                                    <DataGridTemplateColumn Header="🔍 الصنف" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ItemName}"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0"/>
                                                    <Button Grid.Column="1"
                                                            Content="🔍"
                                                            FontSize="10"
                                                            Width="20" Height="20"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            Click="ItemSearch_ButtonClick_WPF"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0"
                                                         VerticalContentAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- الوصف -->
                                    <DataGridTextColumn Header="الوصف"
                                                        Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- الوحدة -->
                                    <DataGridTextColumn Header="الوحدة"
                                                        Binding="{Binding UnitName}"
                                                        Width="75" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- الكمية -->
                                    <DataGridTextColumn Header="الكمية"
                                                        Binding="{Binding ItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- السعر -->
                                    <DataGridTextColumn Header="السعر"
                                                        Binding="{Binding ItemPrice, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- المجموع -->
                                    <DataGridTextColumn Header="المجموع"
                                                        Binding="{Binding ItemSumPrice}"
                                                        Width="80" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- الخصم -->
                                    <DataGridTextColumn Header="الخصم"
                                                        Binding="{Binding ItemDiscount, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                                <Setter Property="Foreground" Value="Firebrick"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- الضريبة -->
                                    <DataGridTextColumn Header="الضريبة"
                                                        Binding="{Binding ItemVat}"
                                                        Width="75" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- الصافي -->
                                    <DataGridTextColumn Header="الصافي"
                                                        Binding="{Binding ItemNetPrice}"
                                                        Width="80" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- المستودع -->
                                    <DataGridTextColumn Header="المستودع"
                                                        Binding="{Binding InvertoryName}"
                                                        Width="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- تاريخ الإنتهاء -->
                                    <DataGridTextColumn Header="تاريخ الإنتهاء"
                                                        Binding="{Binding ItemExpireDate, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- أعمدة مخفية -->
                                    <DataGridTextColumn Binding="{Binding ItemBarcode}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding UnitEquality}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemPrimaryQnty}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemCost}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemDiscountPerc}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemTotalPrice}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemVatPerc}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ValiableInvertory}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemNotes}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding InvertoryId}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemPriceWithoutVAT}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemPriceDiscount}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemPriceAfterDiscount}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding ItemCostCenter}" Visibility="Collapsed"/>
                                    <DataGridTextColumn Binding="{Binding salepric}" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ═══ GroupBox9: ملخص الفاتورة ═══ -->
                    <Border Grid.Row="3"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <Grid x:Name="GroupBox9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- القسم الأيمن: بطاقات ملخص -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- صف 1: المجاميع الرئيسية -->
                                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                                    <!-- عدد البنود -->
                                    <Border Style="{StaticResource SummaryCard}" Width="110">
                                        <StackPanel>
                                            <TextBlock x:Name="lblRowsCount" Text="📊 عدد البنود" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtTirmsNo" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- إجمالي الكمية -->
                                    <Border Style="{StaticResource SummaryCard}" Width="110">
                                        <StackPanel>
                                            <TextBlock x:Name="lblTotQty" Text="📦 إجمالي الكمية" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtTotQuan" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- الخصم -->
                                    <Border Style="{StaticResource SummaryCard}" Width="170">
                                        <StackPanel>
                                            <TextBlock x:Name="Label8" Text="🏷️ خصم الفاتورة" Style="{StaticResource SummaryLabel}" Foreground="Firebrick"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBox x:Name="txtInvDiscPerc"
                                                         Style="{StaticResource ModernTextBox}"
                                                         Width="55" Height="24" Margin="0,2,2,0"
                                                         HorizontalContentAlignment="Center"
                                                         Foreground="Firebrick" FontSize="11"
                                                         Text="0"
                                                         LostFocus="txtInvDiscPerc_Leave"
                                                         KeyDown="txtInvDiscPerc_KeyDown"/>
                                                <TextBlock Text="%" Foreground="Firebrick" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,2,4,0"/>
                                                <TextBlock Text="=" Foreground="Firebrick" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="0,2,4,0"/>
                                                <TextBox x:Name="txtInvDiscVal"
                                                         Style="{StaticResource ModernTextBox}"
                                                         Width="65" Height="24" Margin="0,2,0,0"
                                                         HorizontalContentAlignment="Center"
                                                         Foreground="Firebrick" FontSize="11"
                                                         Text="0"
                                                         LostFocus="txtInvDiscVal_Leave"
                                                         KeyDown="txtInvDiscVal_KeyDown"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- تكاليف إضافية -->
                                    <Border Style="{StaticResource SummaryCard}" Width="130">
                                        <StackPanel>
                                            <TextBlock x:Name="lblAdditonalCost" Text="💼 تكاليف إضافية" Style="{StaticResource SummaryLabel}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBox x:Name="txtAdditonalCost"
                                                         Style="{StaticResource SummaryValue}"
                                                         Width="75" Text="0"/>
                                                <Button x:Name="btnAdditonalCost" Content="➕"
                                                        Style="{StaticResource SmallAddBtn}"
                                                        Margin="3,4,0,0"
                                                        Click="btnAdditonalCost_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- صف 2: تفاصيل الصنف المحدد -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Style="{StaticResource SummaryCard}" Width="100">
                                        <StackPanel>
                                            <TextBlock x:Name="lblCurrentqty" Text="📦 الكمية الحالية" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtStock" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" Width="90">
                                        <StackPanel>
                                            <TextBlock x:Name="lblEqlUnit" Text="⚖️ التعادل" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtPerUnit" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" Width="90">
                                        <StackPanel>
                                            <TextBlock x:Name="lblQtyPrice" Text="📊 كمية و/س" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtTotUnitQuan" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" Width="100">
                                        <StackPanel>
                                            <TextBlock Text="💰 آخر شراء" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtRecentPurchPrice" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" Width="100">
                                        <StackPanel>
                                            <TextBlock Text="💰 آخر بيع" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtLastSalePrice" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" Width="100">
                                        <StackPanel>
                                            <TextBlock Text="💰 المتوسط" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtCostAvrg" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCard}" Width="100">
                                        <StackPanel>
                                            <TextBlock Text="💰 المنافس" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtCompetitorPrice" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- الباركود -->
                                    <Border Style="{StaticResource SummaryCard}" Width="150">
                                        <StackPanel>
                                            <TextBlock Text="📦 باركود الصنف" Style="{StaticResource SummaryLabel}"/>
                                            <TextBox x:Name="txtItemBarcode" Style="{StaticResource SummaryValue}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </Grid>

                            <!-- القسم الأيسر: بطاقة الإجماليات -->
                            <Border Grid.Column="1"
                                    Background="#F8F9FD"
                                    BorderBrush="{StaticResource HeaderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Padding="12,6"
                                    Margin="6,0,0,0"
                                    MinWidth="200">
                                <Grid x:Name="Panel1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- المجموع -->
                                    <TextBlock x:Name="lblTotSale" Text="المجموع :"
                                               Grid.Row="0" Grid.Column="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#1B2642"
                                               VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox x:Name="txtSumVal"
                                             Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             Text="0" Height="24" Margin="4,2"/>

                                    <!-- الخصم -->
                                    <TextBlock x:Name="Label22" Text="الخصم :"
                                               Grid.Row="1" Grid.Column="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="Firebrick"
                                               VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox x:Name="txtTotDiscount"
                                             Grid.Row="1" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             Foreground="Firebrick"
                                             Text="0" Height="24" Margin="4,2"/>

                                    <!-- الإجمالي -->
                                    <TextBlock x:Name="Label4" Text="الإجمالي :"
                                               Grid.Row="2" Grid.Column="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#1B2642"
                                               VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox x:Name="txtNetWithoutVAT"
                                             Grid.Row="2" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             Text="0" Height="24" Margin="4,2"/>

                                    <!-- الضريبة -->
                                    <TextBlock x:Name="Label30" Text="الضريبة :"
                                               Grid.Row="3" Grid.Column="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#1B2642"
                                               VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox x:Name="txtTotVAT"
                                             Grid.Row="3" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             Text="0" Height="24" Margin="4,2"/>

                                    <!-- الصافي -->
                                    <TextBlock x:Name="Label20" Text="الصافي :"
                                               Grid.Row="4" Grid.Column="0"
                                               FontSize="13" FontWeight="ExtraBold"
                                               Foreground="#213A7A"
                                               VerticalAlignment="Center" Margin="0,2"/>
                                    <TextBox x:Name="txtNet"
                                             Grid.Row="4" Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBox}"
                                             Text="0" Height="28" Margin="4,2"
                                             FontSize="14" FontWeight="ExtraBold"
                                             Foreground="#213A7A"
                                             MouseDoubleClick="txtNet_DoubleClick"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ═══════════════ Tab 2: البحث ═══════════════ -->
            <TabItem x:Name="TabPage2" Header="🔍  البحث  "
                     Padding="30,6">
                <Grid Background="#F3F5F9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- GroupBox6: أدوات البحث -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            Margin="8,8,8,4"
                            Padding="14,10"
                            Effect="{StaticResource CardShadow}">
                        <Grid x:Name="GroupBox6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- رقم الفاتورة -->
                            <TextBlock x:Name="Label11" Text="🔢 رقم الفاتورة"
                                       Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSrchNo"
                                     Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     HorizontalContentAlignment="Center"
                                     Margin="0,3"/>

                            <!-- رقم المرجع -->
                            <TextBlock x:Name="Label15" Text="📋 رقم المرجع"
                                       Grid.Row="0" Grid.Column="3"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSrchreffNo"
                                     Grid.Row="0" Grid.Column="4"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,3"/>

                            <!-- من تاريخ -->
                            <TextBlock x:Name="Label1" Text="📅 من تاريخ"
                                       Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtFromDate"
                                          Grid.Row="1" Grid.Column="1"
                                          Height="28" Margin="0,3"
                                          FontSize="12"/>

                            <!-- إلى تاريخ -->
                            <TextBlock x:Name="Label2" Text="📅 إلى تاريخ"
                                       Grid.Row="1" Grid.Column="3"
                                       Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit x:Name="txtToDate"
                                          Grid.Row="1" Grid.Column="4"
                                          Height="28" Margin="0,3"
                                          FontSize="12"/>

                            <!-- العميل/المورد -->
                            <TextBlock x:Name="lblClientSrch" Text="👤 المورد"
                                       Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbClientSrch"
                                      Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      IsEnabled="False"
                                      Margin="0,3"/>

                            <!-- الكل -->
                            <CheckBox x:Name="chkAll"
                                      Grid.Row="2" Grid.Column="3"
                                      Content="الكل"
                                      IsChecked="True"
                                      FontSize="12" FontWeight="Bold"
                                      VerticalAlignment="Center"
                                      Checked="chkAll_CheckedChanged"
                                      Unchecked="chkAll_CheckedChanged"/>

                            <!-- زر البحث -->
                            <Button x:Name="btnSearch"
                                    Grid.Row="0" Grid.RowSpan="3"
                                    Grid.Column="6"
                                    Content="🔍 بحث"
                                    Style="{StaticResource ActionBtn}"
                                    Background="{StaticResource InfoBrush}"
                                    Width="90" Height="80"
                                    Margin="6,0,0,0"
                                    FontSize="14"/>

                            <!-- مخفي -->
                            <TextBlock x:Name="Label10" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- GroupBox4: نتائج البحث -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="10"
                            Margin="8,4,8,8"
                            Effect="{StaticResource CardShadow}">
                        <Grid x:Name="GroupBox4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📊 نتائج البحث"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseDoubleClick="dgvSrch_DoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الحركة"
                                                        Binding="{Binding Column10}"
                                                        Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="الرقم"
                                                        Binding="{Binding InvNo}"
                                                        Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="رقم المرجع"
                                                        Binding="{Binding RefNo}"
                                                        Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التاريخ"
                                                        Binding="{Binding InvDate}"
                                                        Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المورد"
                                                        Binding="{Binding ClientName}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══════════════════════════════════════════════════════════════
             الشريط السفلي: أزرار التحكم
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,6">
            <Grid x:Name="pnlOperBtns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار الخروج والتنقل -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose" Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="40" ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnInvSrch" Content="🔍"
                            Style="{StaticResource ActionBtn}"
                            Width="40" ToolTip="بحث عن فاتورة"
                            Margin="0,0,4,0"
                            Click="btnInvSrch_Click_1"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0">
                    <Button x:Name="btnFirst" Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول" Margin="0,0,3,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق" Margin="0,0,3,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext" Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي" Margin="0,0,3,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast" Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- القائمة المنسدلة (ToolStrip) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="ToolStripDropDownButton1"
                            Style="{StaticResource ActionBtn}"
                            Width="36" Height="36"
                            Content="⚙️" ToolTip="خيارات متقدمة"
                            Margin="0,0,3,0"
                            Click="ToolStripDropDownButton1_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AdvancedMenu"
                                         FlowDirection="RightToLeft"
                                         FontFamily="Cairo, Tahoma, Arial"
                                         FontSize="12">
                                <MenuItem x:Name="stripImport" Header="📥 استيراد"
                                          Click="stripImport_Click"/>
                                <MenuItem x:Name="stripExport" Header="📤 تصدير"
                                          Click="stripExport_Click"/>
                                <MenuItem x:Name="btnShortCutInv" Header="⚡ اختصار فاتورة"
                                          Click="btnShortCutInv_Click"/>
                                <MenuItem x:Name="BtnShowEntry" Header="📒 عرض القيد"
                                          Click="BtnShowEntry_Click"/>
                                <MenuItem x:Name="BtnSaveDgvSettings" Header="💾 حفظ المظهر"
                                          Click="BtnSaveDgvSettings_Click"/>
                                <MenuItem x:Name="BtnDefaultSetting" Header="🔄 إعادة الجدول الإفتراضي"
                                          Click="BtnDefaultSetting_Click"/>
                                <MenuItem x:Name="BtnPrintBarcode" Header="🏷️ طباعة باركود"
                                          Click="BtnPrintBarcode_Click"/>
                                <MenuItem x:Name="StripImportInv" Header="📄 إدراج فاتورة"
                                          Click="StripImportInv_Click"/>
                                <MenuItem x:Name="OpenDesginReport" Header="📐 تصميم التقرير"
                                          Click="OpenDesginReport_Click"/>
                                <MenuItem x:Name="ImportDocument" Header="📎 إرفاق المستندات"
                                          Click="ImportDocument_Click"/>
                                <MenuItem x:Name="btnshowdocument" Header="📂 عرض المستندات"
                                          Click="btnshowdocument_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- سند قبض (مخفي) -->
                    <Button x:Name="BtnReceipts" Content="📝 سند قبض"
                            Style="{StaticResource ActionBtn}"
                            Background="{StaticResource WarningBrush}"
                            Width="90" Visibility="Collapsed"
                            Margin="0,0,3,0"
                            Click="BtnReceipts_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="btnDelete" Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="70" Margin="0,0,4,0"
                            ToolTip="حذف (F9)"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnPrint" Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="70" Margin="0,0,4,0"
                            ToolTip="طباعة (F7)"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnView" Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="70" Margin="0,0,4,0"
                            ToolTip="معاينة (F8)"
                            Click="IconButton1_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="btnSavePrint" Content="🖨️💾 حفظ مع طباعة"
                            Style="{StaticResource SaveBtn}"
                            Width="120" Margin="0,0,4,0"
                            Click="btnSavePrint_Click"/>
                    <Button x:Name="btnSave" Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="70" Margin="0,0,4,0"
                            ToolTip="حفظ (F6)"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew" Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Background="{StaticResource InfoBrush}"
                            Width="70"
                            ToolTip="جديد (F5)"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- عناصر مخفية للتوافق مع الكود الخلفي -->
        <TextBox x:Name="TextBox1" Visibility="Collapsed"/>
        <TextBlock x:Name="lblInvTax" Visibility="Collapsed"/>
        <TextBox x:Name="txtInvTax" Visibility="Collapsed"/>
        <TextBox x:Name="txtInvTaxPer" Visibility="Collapsed"/>
        <TextBlock x:Name="Label43" Visibility="Collapsed"/>
        <TextBlock x:Name="Label44" Visibility="Collapsed"/>
        <TextBlock x:Name="Label45" Visibility="Collapsed"/>
        <TextBlock x:Name="Label39" Visibility="Collapsed"/>
        <TextBlock x:Name="Label42" Visibility="Collapsed"/>

    </Grid>
</dx:ThemedWindow>