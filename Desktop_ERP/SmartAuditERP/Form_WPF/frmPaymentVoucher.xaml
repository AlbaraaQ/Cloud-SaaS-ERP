<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmPaymentVoucher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="سند دفع لمقاول"
    Width="860" Height="480"
    MinWidth="800" MinHeight="440"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxMulti" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold"
                    Background="#F3F5F9">

            <!-- ═══ تبويب سند صرف ═══ -->
            <TabItem Header="   📄 سند صرف   ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,8,8,4">

                        <!-- بطاقة البيانات الرئيسية -->
                        <Border Background="White"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Padding="14,10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="8" Padding="10,6"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="📋 بيانات السند"
                                               Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- الصف الأول: رقم السند + التاريخ + القيمة -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🔢 رقم السند:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtNo"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="📅 التاريخ:" Style="{StaticResource FieldLabel}"/>
                                        <dxe:DateEdit x:Name="txtDate"
                                                      Height="30"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="💰 قيمة السند:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtVal" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- الصف الثاني: الحساب + رصيد الحساب -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="📂 دفعة لحساب:" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbAccounts"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="AName"
                                                  SelectedValuePath="Code"
                                                  SelectionChanged="cmbAccounts_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="💳 رصيد الحساب:" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtBalance"
                                                 Style="{StaticResource ModernTextBox}"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4"
                                                VerticalAlignment="Bottom">
                                        <TextBlock x:Name="txtBalanceType"
                                                   Text=""
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#2E4E9E"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- بطاقة طريقة الدفع -->
                        <Border Background="White"
                                CornerRadius="10"
                                Effect="{StaticResource CardShadow}"
                                Padding="14,10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <Border Background="{StaticResource HeaderBrush}"
                                        CornerRadius="8" Padding="10,6"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="💳 طريقة الصرف"
                                               Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- نوع الدفع -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <RadioButton x:Name="rdCash"
                                                 Content="💵 نقدي"
                                                 IsChecked="True"
                                                 FontWeight="Bold"
                                                 Foreground="#1B2642"
                                                 Margin="0,0,16,0"
                                                 Checked="rdPayType_Changed"/>
                                    <RadioButton x:Name="rdCheck"
                                                 Content="🏦 تحويل بنكي"
                                                 FontWeight="Bold"
                                                 Foreground="#1B2642"
                                                 Checked="rdPayType_Changed"/>
                                </StackPanel>

                                <!-- الصف: يصرف من + مندوب المبيعات -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🏦 يصرف من حساب:" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbEda3"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="👤 مندوب المبيعات:" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbSalesMan"
                                                  Style="{StaticResource ModernComboBox}"
                                                  DisplayMemberPath="name"
                                                  SelectedValuePath="id"/>
                                    </StackPanel>
                                </Grid>

                                <!-- البيان -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="📝 البيان:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtNotes" Style="{StaticResource ModernTextBoxMulti}"/>
                                </StackPanel>

                                <!-- لوحة بيانات الشيك (مخفية بالأصل) -->
                                <Border x:Name="Panel1"
                                        Visibility="Collapsed"
                                        Background="#F8F9FD"
                                        BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="🏦 بيانات التحويل البنكي"
                                                   Style="{StaticResource FieldLabel}"
                                                   FontSize="12"
                                                   Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="رقم الشيك:" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="txtCheckNo" Style="{StaticResource ModernTextBox}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="تاريخ الاستحقاق:" Style="{StaticResource FieldLabel}"/>
                                                <dxe:DateEdit x:Name="txtCheckDate"
                                                              Height="30"
                                                              FontSize="12"
                                                              FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="حالة الشيك:" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="cmbCheckType"
                                                          Style="{StaticResource ModernComboBox}">
                                                    <ComboBoxItem Content="تحت التحصيل"/>
                                                    <ComboBoxItem Content="محصّل"/>
                                                    <ComboBoxItem Content="مرتجع"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="الشيك مسحوب على بنك:" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="txtBankCheck" Style="{StaticResource ModernTextBox}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="القيمة بالدولار:" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="txtValD" Style="{StaticResource ModernTextBox}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ تبويب البحث ═══ -->
            <TabItem Header="   🔍 البحث   ">
                <Grid Margin="8,8,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- بطاقة البحث -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}"
                            Padding="14,10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8" Padding="10,6"
                                    Margin="0,0,0,10">
                                <TextBlock Text="🔍 بحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📅 من تاريخ:" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtFromDate"
                                                  Height="30"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="📅 إلى تاريخ:" Style="{StaticResource FieldLabel}"/>
                                    <dxe:DateEdit x:Name="txtToDate"
                                                  Height="30"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="🔢 رقم السند:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtSrchNo"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"
                                             KeyDown="txtSrchNo_KeyDown"/>
                                </StackPanel>

                                <Button x:Name="btnSearch"
                                        Grid.Column="6"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80"
                                        VerticalAlignment="Bottom"
                                        Click="btnSearch_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- جدول النتائج -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="10"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="10,10,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم"
                                                        Binding="{Binding id}"
                                                        Visibility="Collapsed"
                                                        Width="0"/>
                                    <DataGridTextColumn Header="التاريخ"
                                                        Binding="{Binding voucherDate}"
                                                        Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المبلغ"
                                                        Binding="{Binding val}"
                                                        Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="المستخدم"
                                                        Binding="{Binding empName}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="38" ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="78" Margin="0,0,6,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="78" Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="78" Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="78"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>