<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmDBManagment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="🗄️ إنشاء الملف وإدارة قواعد البيانات"
    Height="468" Width="581"
    MinHeight="468" MaxHeight="468"
    MinWidth="581" MaxWidth="581"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    FontFamily="Tahoma"
    FontSize="13"
    ResizeMode="NoResize"
    ShowIcon="False">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#AAAAAA" Direction="270"
                          ShadowDepth="3" BlurRadius="8" Opacity="0.4"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          Color="#333333" Direction="270"
                          ShadowDepth="2" BlurRadius="5" Opacity="0.3"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2"
                                    Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderGradient}"
                                    CornerRadius="10,10,0,0"
                                    Padding="12,6">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="White"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.FontSize="12"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Effect="{StaticResource CardShadow}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="15,0">
                <TextBlock Text="🗄️" FontSize="20"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="إدارة قواعد البيانات"
                           Foreground="White"
                           FontFamily="Tahoma"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <dx:DXTabControl x:Name="TabControl"
                         Grid.Row="1"
                         Margin="8">

            <!-- Tab 1: Files List -->
            <dx:DXTabItem Header="📂 الملفات">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter GroupBox -->
                    <GroupBox Grid.Row="0"
                              Style="{StaticResource ModernGroupBox}"
                              Margin="0,0,0,6">
                        <GroupBox.Header>
                            <TextBlock Text="🔍 تصفية الملفات"/>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal"
                                    Margin="5" HorizontalAlignment="Center">
                            <RadioButton x:Name="rbAllDBs"
                                         Content="🔵 الكل"
                                         Style="{StaticResource ModernRadioButton}"/>
                            <RadioButton x:Name="rbActiveDbs"
                                         Content="✅ ملفات نشطة"
                                         IsChecked="True"
                                         Style="{StaticResource ModernRadioButton}"/>
                            <RadioButton x:Name="rbInactiveDbs"
                                         Content="❌ ملفات غير نشطة"
                                         Style="{StaticResource ModernRadioButton}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Databases Grid -->
                    <GroupBox Grid.Row="1"
                              Style="{StaticResource ModernGroupBox}"
                              Margin="0">
                        <GroupBox.Header>
                            <TextBlock Text="📊 قائمة الملفات"/>
                        </GroupBox.Header>
                        <dxg:GridControl x:Name="DgvDBs">
                            <dxg:GridControl.Columns>

                                <dxg:GridColumn x:Name="ColDbId"
                                                Header="DbId"
                                                FieldName="DbId"
                                                Visible="False"/>

                                <dxg:GridColumn x:Name="ColDbName"
                                                Header="اسم الملف"
                                                FieldName="DbName"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColCreateDate"
                                                Header="تاريخ الإنشاء"
                                                FieldName="CreateDate"
                                                Width="120"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <dxg:GridColumn x:Name="ColIsActive"
                                                Header="نشطة"
                                                FieldName="IsActive"
                                                Width="80"
                                                AllowEditing="False"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <dxe:CheckEdit IsChecked="{Binding Value}"
                                                           IsReadOnly="True"
                                                           HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="GridView1"
                                               ShowGroupPanel="False"
                                               AllowGrouping="False"
                                               NavigationStyle="Row"
                                               AllowPerPixelScrolling="True"
                                               SearchPanelNullText="🔍 ابحث..."
                                               ShowSearchPanelCloseButton="True"/>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </GroupBox>
                </Grid>
            </dx:DXTabItem>

            <!-- Tab 2: Create New DB -->
            <dx:DXTabItem Header="➕ إنشاء ملف جديد">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Style="{StaticResource ModernGroupBox}" Margin="10">
                        <GroupBox.Header>
                            <TextBlock Text="🆕 قاعدة بيانات جديدة"/>
                        </GroupBox.Header>
                        <StackPanel Margin="10">

                            <TextBlock
                                Text="الرجاء اختيار قاعدة البيانات التي سيتم الاستيراد إليها"
                                FontFamily="Tahoma"
                                FontSize="12"
                                Foreground="#546E7A"
                                Margin="0,0,0,20"
                                TextWrapping="Wrap"/>

                            <!-- DB Display Name -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">
                                <TextBlock Text="اسم قاعدة البيانات:"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#37474F"
                                           VerticalAlignment="Center"
                                           Width="160"/>
                                <dxe:TextEdit x:Name="txtDbName"
                                              Width="260" Height="32"
                                              NullText="أدخل اسم قاعدة البيانات..."/>
                            </StackPanel>

                            <!-- Accounting Period -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,20">
                                <TextBlock Text="الفترة المحاسبية:"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#37474F"
                                           VerticalAlignment="Center"
                                           Width="160"/>
                                <dxe:DateEdit x:Name="txtStartdate"
                                              Width="130" Height="32"
                                              Margin="0,0,10,0"/>
                                <TextBlock Text="إلى"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           Foreground="#546E7A"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <dxe:DateEdit x:Name="txtEnddate"
                                              Width="130" Height="32"/>
                            </StackPanel>

                            <!-- Create Button -->
                            <Button x:Name="btnCreateDatabase"
                                    Content="🆕 إنشاء قاعدة بيانات"
                                    HorizontalAlignment="Center"
                                    MinWidth="200" Height="42">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#1976D2" Offset="0"/>
                                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </dx:DXTabItem>

            <!-- Tab 3: Rename DB -->
            <dx:DXTabItem x:Name="DBManagment" Header="✏️ إدارة الملفات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Style="{StaticResource ModernGroupBox}" Margin="10">
                        <GroupBox.Header>
                            <TextBlock Text="✏️ تغيير اسم الملف"/>
                        </GroupBox.Header>
                        <StackPanel Margin="15">

                            <TextBlock Text="تغيير اسم الملف"
                                       FontFamily="Tahoma"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#1A237E"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,25"/>

                            <!-- Select DB -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">
                                <TextBlock x:Name="lblDatabase"
                                           Text="الملف:"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#37474F"
                                           VerticalAlignment="Center"
                                           Width="130"/>
                                <dxe:ComboBoxEdit x:Name="cmbDB"
                                                  Width="250" Height="32"
                                                  AutoComplete="True"
                                                  NullText="اختر الملف..."/>
                            </StackPanel>

                            <!-- New Name -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,25">
                                <TextBlock x:Name="lblDBNewName"
                                           Text="الاسم الجديد:"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#37474F"
                                           VerticalAlignment="Center"
                                           Width="130"/>
                                <dxe:TextEdit x:Name="txtDBNewName"
                                              Width="250" Height="32"
                                              NullText="أدخل الاسم الجديد..."/>
                            </StackPanel>

                            <!-- Save Button -->
                            <Button x:Name="btnSaveChange"
                                    Content="💾 حفظ"
                                    HorizontalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#388E3C" Offset="0"/>
                                                    <GradientStop Color="#1B5E20" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </dx:DXTabItem>

            <!-- Tab 4: Edit Accounting Period -->
            <dx:DXTabItem Header="📅 تعديل الفترة المحاسبية">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Style="{StaticResource ModernGroupBox}" Margin="10">
                        <GroupBox.Header>
                            <TextBlock Text="📅 تعديل الفترة المحاسبية"/>
                        </GroupBox.Header>
                        <StackPanel Margin="15">

                            <!-- Select DB -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,15">
                                <TextBlock Text="الملف:"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#37474F"
                                           VerticalAlignment="Center"
                                           Width="150"/>
                                <dxe:ComboBoxEdit x:Name="CmbDbName"
                                                  Width="230" Height="32"
                                                  AutoComplete="True"
                                                  NullText="اختر قاعدة البيانات..."/>
                            </StackPanel>

                            <!-- Period -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,25">
                                <TextBlock Text="الفترة المحاسبية:"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#37474F"
                                           VerticalAlignment="Center"
                                           Width="150"/>
                                <dxe:DateEdit x:Name="StartDateProid"
                                              Width="130" Height="32"
                                              Margin="0,0,10,0"/>
                                <TextBlock Text="إلى"
                                           FontFamily="Tahoma"
                                           FontSize="12"
                                           Foreground="#546E7A"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <dxe:DateEdit x:Name="EndDateProid"
                                              Width="130" Height="32"/>
                            </StackPanel>

                            <!-- Save Button -->
                            <Button x:Name="BtnSave"
                                    Content="💾 حفظ التعديلات"
                                    HorizontalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#1976D2" Offset="0"/>
                                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </dx:DXTabItem>

        </dx:DXTabControl>
    </Grid>
</dx:ThemedWindow>