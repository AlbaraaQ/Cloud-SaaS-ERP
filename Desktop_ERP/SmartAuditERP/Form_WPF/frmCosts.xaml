<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCosts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="بطاقة تكاليف"
    Width="920" Height="460"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Panel1 - Input Fields ═══ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- الاسم -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="🏷️ الاسم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtCost" Style="{StaticResource ModernTextBox}"/>
                </StackPanel>

                <!-- الاسم الإنجليزي -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="🔤 الاسم (En)"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtCostEn"
                             Style="{StaticResource ModernTextBox}"
                             FlowDirection="LeftToRight"/>
                </StackPanel>

                <!-- حساب التكلفة -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="💰 حساب التكلفة"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbAccounts"
                              Style="{StaticResource ModernComboBox}"
                              IsEditable="True"
                              KeyDown="cmbAccounts_KeyDown"
                              PreviewMouseLeftButtonDown="cmbAccounts_PreviewClick"/>
                </StackPanel>

                <!-- مركز التكلفة -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="🏢 مركز التكلفة"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbCostCenter"
                              Style="{StaticResource ModernComboBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Panel2 - Grid ═══ -->
        <Border Grid.Row="1"
                Background="White"
                Margin="8,6,8,0"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource HeaderBrush}"
                        CornerRadius="10,10,0,0">
                    <TextBlock Text="📋 قائمة التكاليف"
                               Foreground="White"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="14,0"/>
                </Border>

                <dxg:GridControl x:Name="GridControl1"
                                 Grid.Row="1"
                                 AutoGenerateColumns="None">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="GridView1"
                                       ShowGroupPanel="False"
                                       AutoWidth="True"
                                       AllowEditing="False"
                                       NavigationStyle="Row"
                                       RowMinHeight="30"
                                       FocusedRowChanged="GridView1_FocusedRowChanged"/>
                    </dxg:GridControl.View>

                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="id"
                                        Header="🔢 الرقم"
                                        Width="60"
                                        AllowEditing="False"/>
                        <dxg:GridColumn FieldName="name"
                                        Header="🏷️ الاسم"
                                        Width="150"
                                        AllowEditing="False"/>
                        <dxg:GridColumn FieldName="nameEn"
                                        Header="🔤 الاسمEn"
                                        Width="130"
                                        AllowEditing="False"/>
                        <dxg:GridColumn FieldName="AName"
                                        Header="💰 الحساب"
                                        Width="150"
                                        AllowEditing="False"/>
                        <dxg:GridColumn FieldName="account"
                                        Header="كود الحساب"
                                        Width="80"
                                        Visible="False"/>
                        <dxg:GridColumn FieldName="CCName"
                                        Header="🏢 مركز التكلفة"
                                        Width="150"
                                        AllowEditing="False"/>
                        <dxg:GridColumn FieldName="costCenterId"
                                        Header="مركز التكلفة كود"
                                        Width="80"
                                        Visible="False"/>
                    </dxg:GridControl.Columns>
                </dxg:GridControl>
            </Grid>
        </Border>

        <!-- ═══ Panel3 - Buttons ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="12,8"
                Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button x:Name="btnClose"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Margin="0,0,6,0"
                        Click="btnClose_Click"/>
                <Button x:Name="btnDelete"
                        Content="🗑️ حذف"
                        Style="{StaticResource DangerBtn}"
                        Width="80"
                        Margin="0,0,6,0"
                        Click="btnDelete_Click"/>
                <Button x:Name="btnSave"
                        Content="💾 حفظ"
                        Style="{StaticResource SaveBtn}"
                        Width="80"
                        Margin="0,0,6,0"
                        Click="btnSave_Click"/>
                <Button x:Name="btnNew"
                        Content="➕ جديد"
                        Style="{StaticResource ActionBtn}"
                        Width="80"
                        Click="btnNew_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</dx:ThemedWindow>