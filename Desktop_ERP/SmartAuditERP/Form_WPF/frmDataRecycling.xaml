<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmDataRecycling"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="♻️ تدوير البيانات"
    Height="468" Width="581"
    MinHeight="468" MaxHeight="468"
    MinWidth="581" MaxWidth="581"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    FontFamily="Tahoma"
    FontSize="13"
    ResizeMode="NoResize"
    ShowIcon="False">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Gradient Brushes               -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A237E" Offset="0"/>
            <GradientStop Color="#1565C0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ECEFF1" Offset="0"/>
            <GradientStop Color="#CFD8DC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WizardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8F9FA" Offset="0"/>
            <GradientStop Color="#ECEFF1" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Drop Shadows                   -->
        <!-- ═══════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#AAAAAA" Direction="270"
                          ShadowDepth="3" BlurRadius="8" Opacity="0.4"/>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Button Styles                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Info Card Style                -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- ═══════════════════════════════════════════ -->
        <!--              CheckBox Style                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Style x:Key="WizardCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,8"/>
        </Style>

        <Style x:Key="WizardRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,10"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--                  Root Layout                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="68"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--                  Header                     -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="♻️" FontSize="20"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="معالج تدوير البيانات"
                               Foreground="White"
                               FontFamily="Tahoma"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Step Indicator -->
                <Border Grid.Column="1"
                        Background="#1565C0"
                        CornerRadius="12"
                        Padding="12,4"
                        Margin="0,0,15,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الخطوة: "
                                   Foreground="#B3E5FC"
                                   FontFamily="Tahoma"
                                   FontSize="11"/>
                        <TextBlock x:Name="txtStepIndicator"
                                   Text="1"
                                   Foreground="White"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"/>
                        <TextBlock Text=" / 8"
                                   Foreground="#B3E5FC"
                                   FontFamily="Tahoma"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!--            Wizard Tab Control               -->
        <!-- ═══════════════════════════════════════════ -->
        <dx:DXTabControl x:Name="TabControl"
                         Grid.Row="1"
                         Margin="10,8">

            <!-- ─────────────────────── -->
            <!--  Step 1: Welcome        -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="1">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🎉 مرحباً بك في معالج تدوير قاعدة البيانات"
                                   FontFamily="Tahoma"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <Border Background="#E8F5E9" CornerRadius="8"
                                Padding="15" Margin="0,0,0,10">
                            <TextBlock
                                Text="إن الشروع في هذه العملية يترتب عليها إنشاء قاعدة بيانات جديدة مع إمكانية إدراج التعاريف والحسابات وتوليد فاتورة آخر وأول مدة بدون قيد."
                                FontFamily="Tahoma"
                                FontSize="12"
                                Foreground="#2E7D32"
                                TextWrapping="Wrap"/>
                        </Border>

                        <Border Background="#FFEBEE" CornerRadius="8"
                                Padding="15" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="⚠️ تحذير!"
                                           FontFamily="Tahoma"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#C62828"
                                           Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="ستقوم هذه العملية باستبدال كافة البيانات الموجودة في قاعدة البيانات الحالية واستيرادها إلى قاعدة البيانات التي ستختارها لاحقاً."
                                    FontFamily="Tahoma"
                                    FontSize="12"
                                    Foreground="#B71C1C"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </dx:DXTabItem>

            <!-- ─────────────────────── -->
            <!--  Step 2: Source DB      -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="2">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🗄️ اختيار قاعدة البيانات المصدر"
                                   FontFamily="Tahoma"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="الرجاء اختيار قاعدة البيانات التي سيتم تدويرها:"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   Foreground="#546E7A"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="قاعدة البيانات:"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <dxe:ComboBoxEdit x:Name="cmbDBs"
                                              Width="200" Height="32"
                                              AutoComplete="True"
                                              NullText="اختر قاعدة البيانات..."/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="كلمة مرور المسؤول:"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <dxe:PasswordBoxEdit x:Name="txtPwrd"
                                                 Width="200" Height="32"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </dx:DXTabItem>

            <!-- ─────────────────────── -->
            <!--  Step 3: Target DB      -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="3">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🆕 إعداد قاعدة البيانات الجديدة"
                                   FontFamily="Tahoma"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,20"/>

                        <!-- DB Name -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="اسم قاعدة البيانات:"
                                       Style="{StaticResource {x:Type TextBlock}}"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       Width="150"/>
                            <dxe:TextEdit x:Name="txtDbName"
                                         Width="250" Height="30"
                                         NullText="أدخل اسم قاعدة البيانات..."/>
                        </StackPanel>

                        <!-- Period -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="الفترة المحاسبية:"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       Width="150"/>
                            <dxe:DateEdit x:Name="txtStartdate"
                                         Width="130" Height="30"
                                         Margin="0,0,10,0"/>
                            <TextBlock Text="إلى"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       Foreground="#546E7A"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <dxe:DateEdit x:Name="txtEnddate"
                                         Width="130" Height="30"/>
                        </StackPanel>

                        <!-- File Path -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="مسار الملف:"
                                       FontFamily="Tahoma"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       Width="150"/>
                            <dxe:TextEdit x:Name="txtPath"
                                         Width="215" Height="30"
                                         Margin="0,0,8,0"
                                         NullText="مسار حفظ قاعدة البيانات..."/>
                            <Button x:Name="btnPath"
                                    Content="📁"
                                    FontSize="16"
                                    Width="36" Height="30"
                                    Cursor="Hand"
                                    ToolTip="اختر المسار">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#546E7A"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Hidden DB Name -->
                        <dxe:TextEdit x:Name="txtDatabaseName"
                                      Visibility="Collapsed"/>

                    </StackPanel>
                </Border>
            </dx:DXTabItem>

            <!-- ─────────────────────── -->
            <!--  Step 4: Options        -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="4">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="⚙️ خيارات التدوير"
                                   FontFamily="Tahoma"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="اختر البيانات التي تريد تدويرها إلى قاعدة البيانات الجديدة:"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   Foreground="#546E7A"
                                   Margin="0,0,0,15"/>

                        <Border Background="#E3F2FD" CornerRadius="10"
                                Padding="15">
                            <StackPanel>
                                <CheckBox x:Name="ckImportItems"
                                          Content="📦 تدوير بيانات المواد"
                                          IsChecked="True"
                                          Style="{StaticResource WizardCheckBox}"/>

                                <CheckBox x:Name="ckcustomers"
                                          Content="👥 تدوير العملاء والموردين"
                                          IsChecked="True"
                                          Style="{StaticResource WizardCheckBox}"/>

                                <CheckBox x:Name="ckImportUsers"
                                          Content="🔐 تدوير بيانات المستخدمين والصلاحيات"
                                          IsChecked="True"
                                          Style="{StaticResource WizardCheckBox}"/>

                                <CheckBox x:Name="ckAccounts"
                                          Content="📊 تدوير الحسابات"
                                          IsChecked="True"
                                          Style="{StaticResource WizardCheckBox}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </dx:DXTabItem>

            <!-- ─────────────────────── -->
            <!--  Step 5: Opening Entry  -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="5">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📝 سند القيد الافتتاحي"
                                   FontFamily="Tahoma"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,20"/>

                        <Border Background="#E3F2FD" CornerRadius="10"
                                Padding="15">
                            <StackPanel>
                                <RadioButton x:Name="rbInitialBalance"
                                             Content="✅ نعم: توليد قيد افتتاحي"
                                             IsChecked="True"
                                             Style="{StaticResource WizardRadioButton}"/>

                                <RadioButton x:Name="rbNoIntialBalance"
                                             Content="❌ عدم توليد قيد افتتاحي"
                                             Style="{StaticResource WizardRadioButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </dx:DXTabItem>

            <!-- ─────────────────────── -->
            <!--  Step 6: First Stock    -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="6">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📋 فواتير بضاعة أول المدة"
                                   FontFamily="Tahoma"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,20"/>

                        <Border Background="#E3F2FD" CornerRadius="10"
                                Padding="15">
                            <StackPanel>
                                <RadioButton x:Name="rbFirstStockInv"
                                             Content="✅ نعم: توليد فواتير بضاعة أول مدة"
                                             IsChecked="True"
                                             Style="{StaticResource WizardRadioButton}"/>

                                <RadioButton x:Name="rbNoFirstStockInv"
                                             Content="❌ عدم توليد فواتير بضاعة أول مدة"
                                             Style="{StaticResource WizardRadioButton}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </dx:DXTabItem>

            <!-- ─────────────────────── -->
            <!--  Step 7: Confirm        -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="7">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel>
                        <TextBlock Text="✔️ مراجعة وتأكيد التدوير"
                                   FontFamily="Tahoma"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   Margin="0,0,0,15"/>

                        <Border Background="#E8F5E9" CornerRadius="8"
                                Padding="15" Margin="0,0,0,10">
                            <TextBlock
                                Text="تم تجميع كافة المعلومات الضرورية لتدوير قاعدة البيانات. ستقوم هذه العملية بتدوير كافة البيانات المختارة من قاعدة البيانات الحالية إلى قاعدة البيانات الجديدة."
                                FontFamily="Tahoma"
                                FontSize="12"
                                Foreground="#2E7D32"
                                TextWrapping="Wrap"/>
                        </Border>

                        <Border Background="#FFEBEE" CornerRadius="8"
                                Padding="15">
                            <TextBlock
                                Text="⚠️ تحذير! للاستمرار، اضغط زر 'التالي'"
                                FontFamily="Tahoma"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#C62828"
                                TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </dx:DXTabItem>

            <!-- ─────────────────────── -->
            <!--  Step 8: Done           -->
            <!-- ─────────────────────── -->
            <dx:DXTabItem Header="8">
                <Border Style="{StaticResource InfoCard}" Margin="5">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="🎉"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="انتهت عملية تدوير قاعدة البيانات بنجاح"
                                   FontFamily="Tahoma"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#1A237E"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <Border Background="#E8F5E9" CornerRadius="10"
                                Padding="20" Margin="0,10,0,0">
                            <TextBlock
                                Text="تهانينا، تمت العملية بنجاح. اضغط 'إلغاء' لإغلاق المعالج."
                                FontFamily="Tahoma"
                                FontSize="12"
                                Foreground="#2E7D32"
                                TextWrapping="Wrap"
                                TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </dx:DXTabItem>

        </dx:DXTabControl>

        <!-- ═══════════════════════════════════════════ -->
        <!--              Navigation Buttons             -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource FooterGradient}"
                BorderBrush="#B0BEC5"
                BorderThickness="0,1,0,0">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Exit -->
                <Button x:Name="btnExit"
                        Grid.Column="0"
                        Content="❌ إلغاء"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WizardButton}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#D32F2F" Offset="0"/>
                                        <GradientStop Color="#B71C1C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Previous -->
                <Button x:Name="btnPrevious"
                        Grid.Column="2"
                        Content="◀ السابق"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WizardButton}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#546E7A" Offset="0"/>
                                        <GradientStop Color="#37474F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Next -->
                <Button x:Name="btnNext"
                        Grid.Column="3"
                        Content="التالي ▶"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WizardButton}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1976D2" Offset="0"/>
                                        <GradientStop Color="#0D47A1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>