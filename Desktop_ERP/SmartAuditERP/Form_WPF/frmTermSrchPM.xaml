<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmTermSrchPM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="بحث عن بند"
    Width="960" Height="560"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    WindowStyle="None"
    AllowsTransparency="False"
    Deactivated="Window_Deactivated"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#808080" Offset="0"/>
            <GradientStop Color="#505050" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="SrchBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Border Background="White" BorderBrush="#808080" BorderThickness="2"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- شريط البحث -->
                <RowDefinition Height="*"/>
                <!-- الجدول -->
            </Grid.RowDefinitions>

            <!-- ═══ شريط البحث ═══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    CornerRadius="6,6,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- زر الإغلاق -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <!-- المجموعة -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <!-- الرقم -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <!-- الاسم -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <!-- الاسم En -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- زر الإغلاق -->
                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                            Content="✖"
                            Foreground="White"
                            Background="#B03030"
                            BorderThickness="0"
                            Width="38" Height="38"
                            Cursor="Hand"
                            FontSize="14"
                            VerticalAlignment="Center"
                            Click="btnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- المجموعة -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="📂 المجموعة:" Foreground="White"
                                   FontSize="10" FontWeight="Bold"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbTermGrp"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="cmbTermGrp_SelectionChanged"/>
                    </StackPanel>

                    <!-- الرقم -->
                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock Text="🔢 الرقم:" Foreground="White"
                                   FontSize="10" FontWeight="Bold"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   Margin="0,0,0,2"/>
                        <TextBox x:Name="txtSrchCode"
                                 Style="{StaticResource SrchBox}"
                                 TextChanged="txtSrchCode_TextChanged"/>
                    </StackPanel>

                    <!-- الاسم -->
                    <StackPanel Grid.Row="0" Grid.Column="6">
                        <TextBlock Text="📝 الاسم:" Foreground="White"
                                   FontSize="10" FontWeight="Bold"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   Margin="0,0,0,2"/>
                        <TextBox x:Name="txtSrchNm"
                                 Style="{StaticResource SrchBox}"
                                 TextChanged="txtSrchNm_TextChanged"/>
                    </StackPanel>

                    <!-- الاسم En -->
                    <StackPanel Grid.Row="0" Grid.Column="8">
                        <TextBlock Text="🔤 الاسم En:" Foreground="White"
                                   FontSize="10" FontWeight="Bold"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   Margin="0,0,0,2"/>
                        <TextBox x:Name="txtSrchNmEn"
                                 Style="{StaticResource SrchBox}"
                                 TextChanged="txtSrchNmEn_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ الجدول ═══ -->
            <DataGrid x:Name="dgvItems"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                      RowStyle="{StaticResource DgvRow}"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FlowDirection="RightToLeft"
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8EBF5"
                      AlternatingRowBackground="#F8F9FD"
                      BorderThickness="0"
                      MouseDoubleClick="dgvItems_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="🔢 الرقم"
                                        Binding="{Binding Code}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="📝 الاسم العربي"
                                        Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="🔤 الاسم En"
                                        Binding="{Binding NameEn}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="💰 السعر"
                                        Binding="{Binding Price, StringFormat=N2}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</dx:ThemedWindow>