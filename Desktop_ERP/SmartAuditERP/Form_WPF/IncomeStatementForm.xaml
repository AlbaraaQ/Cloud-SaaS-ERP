<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.IncomeStatementForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="قائمة الدخل - Income Statement"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ShowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2E4E9E" Offset="0"/>
            <GradientStop Color="#213A7A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27AE60" Offset="0"/>
            <GradientStop Color="#1B7A42" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8E44AD" Offset="0"/>
            <GradientStop Color="#6C3483" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- Style: ActionBtn -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>

        <Style x:Key="PrintBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>

        <Style x:Key="ShowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ShowBrush}"/>
        </Style>

        <!-- Style: ModernTextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style: SidebarLabel -->
        <Style x:Key="SidebarLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>

        <!-- Style: ModernCheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid Column Header Style -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#1A3070"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8D8F8"/>
                    <Setter Property="Foreground" Value="#0A1A4A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="64"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Progress + Buttons -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Effect="{StaticResource CardShadow}">
            <TextBlock Text="📊 قائمة الدخـــــل - Income Statement"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       FontFamily="Cairo, Tahoma, Arial"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ═══ Main Content: Grid + Sidebar ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- DataGrid Area -->
                <ColumnDefinition Width="*"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ DataGrid Card ═══ -->
            <Border Grid.Column="0"
                    Background="White"
                    Margin="8,8,4,8"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="📋 بيانات قائمة الدخل"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <DataGrid x:Name="dgvIncomeData"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource DgvColHeader}"
                              
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FlowDirection="RightToLeft"
                              Background="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8EBF5"
                              AlternatingRowBackground="#F8F9FD"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionChanged="dgvIncomeData_SelectionChanged">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="📁 المجموعة"
                                                Binding="{Binding Category}"
                                                Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="🔢 رقم الحساب"
                                                Binding="{Binding AccountCode}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="📝 اسم الحساب"
                                                Binding="{Binding AccountName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="💰 الرصيد"
                                                Binding="{Binding BalanceFormatted}"
                                                Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="📌 ملاحظات"
                                                Binding="{Binding Notes}"
                                                Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>

                        <!-- Row Color by AccountCode -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="FontFamily" Value="Cairo, Tahoma, Arial"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RowColor}" Value="LightYellow">
                                        <Setter Property="Background" Value="#FFFDE7"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowColor}" Value="LightGreen">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowColor}" Value="LightCyan">
                                        <Setter Property="Background" Value="#E0F7FA"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowColor}" Value="LightBlue">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#C8D8F8"/>
                                        <Setter Property="Foreground" Value="#0A1A4A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEF1FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ Sidebar ═══ -->
            <Border Grid.Column="1"
                    Background="White"
                    Margin="4,8,8,8"
                    CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0">
                        <TextBlock Text="⚙️ إعدادات القائمة"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   FontFamily="Cairo, Tahoma, Arial"
                                   VerticalAlignment="Center"
                                   Margin="14,0"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14,10">
                        <StackPanel>

                            <!-- من: -->
                            <TextBlock Text="📅 من:"
                                       Style="{StaticResource SidebarLabel}"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <dxe:DateEdit x:Name="txtFromDate"
                                              Grid.Column="0"
                                              Height="34"
                                              FontFamily="Cairo, Tahoma, Arial"
                                              FontSize="12"
                                              DateTime="{Binding ElementName=txtFromDate, Path=DateTime, Mode=TwoWay}"/>

                                <TextBox x:Name="txtStartTime"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="00:00"
                                         ToolTip="وقت البداية HH:mm"
                                         GotFocus="TimeTextBox_GotFocus"
                                         LostFocus="TimeTextBox_LostFocus"/>
                            </Grid>

                            <!-- إلى: -->
                            <TextBlock Text="📅 إلى:"
                                       Style="{StaticResource SidebarLabel}"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <dxe:DateEdit x:Name="txtToDate"
                                              Grid.Column="0"
                                              Height="34"
                                              FontFamily="Cairo, Tahoma, Arial"
                                              FontSize="12"/>

                                <TextBox x:Name="txtEndTime"
                                         Grid.Column="2"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="23:59"
                                         ToolTip="وقت النهاية HH:mm"
                                         GotFocus="TimeTextBox_GotFocus"
                                         LostFocus="TimeTextBox_LostFocus"/>
                            </Grid>

                            <!-- كل الفترة -->
                            <CheckBox x:Name="ckTotalPeriod"
                                      Content="📆 كل الفترة"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="True"
                                      Checked="ckTotalPeriod_CheckedChanged"
                                      Unchecked="ckTotalPeriod_CheckedChanged"/>

                            <Separator Margin="0,8"/>

                            <!-- الفروع -->
                            <TextBlock Text="🏢 الفرع:"
                                       Style="{StaticResource SidebarLabel}"/>

                            <CheckBox x:Name="chkAllBranches"
                                      Content="📂 كل الفروع"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="True"
                                      Checked="chkAllBranches_CheckedChanged"
                                      Unchecked="chkAllBranches_CheckedChanged"/>

                            <ComboBox x:Name="cmbBranches"
                                      Height="34"
                                      FontSize="12"
                                      FontFamily="Cairo, Tahoma, Arial"
                                      IsEnabled="False"
                                      Margin="0,0,0,10"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"/>

                            <Separator Margin="0,8"/>

                            <!-- زر العرض -->
                            <Button x:Name="btnShow"
                                    Content="👁️ عرض البيانات"
                                    Style="{StaticResource ShowBtn}"
                                    Height="48"
                                    FontSize="14"
                                    Margin="0,8,0,0"
                                    Click="btnShow_Click"/>

                            <!-- ملخص مالي -->
                            <Border Margin="0,14,0,0"
                                    Background="#F0F4FF"
                                    CornerRadius="8"
                                    Padding="10"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📊 الملخص المالي"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               FontFamily="Cairo, Tahoma, Arial"
                                               Foreground="#213A7A"
                                               Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="إجمالي الإيرادات:"
                                                   FontSize="11"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#444"/>
                                        <TextBlock x:Name="lblRevTotal"
                                                   Grid.Column="1"
                                                   Text="0.00"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#27AE60"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="تكلفة المبيعات:"
                                                   FontSize="11"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#444"/>
                                        <TextBlock x:Name="lblCogsTotal"
                                                   Grid.Column="1"
                                                   Text="0.00"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#E74C3C"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="مجمل الربح:"
                                                   FontSize="11"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#444"/>
                                        <TextBlock x:Name="lblGrossProfit"
                                                   Grid.Column="1"
                                                   Text="0.00"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#2980B9"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="إجمالي المصروفات:"
                                                   FontSize="11"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#444"/>
                                        <TextBlock x:Name="lblExpTotal"
                                                   Grid.Column="1"
                                                   Text="0.00"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#E74C3C"/>
                                    </Grid>

                                    <Separator Margin="0,6"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="صافي الدخل:"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#1B2642"/>
                                        <TextBlock x:Name="lblNetIncome"
                                                   Grid.Column="1"
                                                   Text="0.00"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   FontFamily="Cairo, Tahoma, Arial"
                                                   Foreground="#213A7A"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ═══ ProgressBar ═══ -->
        <ProgressBar x:Name="ProgressBar1"
                     Grid.Row="2"
                     Height="6"
                     Value="0"
                     Maximum="100"
                     Foreground="#3A63C3"
                     Background="#E8EBF5"
                     BorderThickness="0"
                     Margin="0"/>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="3"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر الخروج -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="100"
                            Click="btnClose_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="btnExport_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintBtn}"
                            Width="100"
                            Margin="0,0,8,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="Button1"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="100"
                            Click="Button1_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>