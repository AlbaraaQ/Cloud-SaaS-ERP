<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmTermGrpPM"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="بطاقة مجموعة"
    Width="780" Height="400"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#DAA520" Offset="0"/>
            <GradientStop Color="#B8860B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GrayBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#708090" Offset="0"/>
            <GradientStop Color="#4A5560" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"  BlurRadius="5"  ShadowDepth="1"
                          Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
        </Style>
        <Style x:Key="BlueBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
        </Style>
        <Style x:Key="GrayBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource GrayBrush}"/>
        </Style>
        <Style x:Key="NavBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#4169E1"/>
        </Style>

        <Style x:Key="LinkStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3A63C3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C0FFC0"/>
                    <Setter Property="Foreground" Value="#1B2642"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    Margin="4,4,4,2"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="14,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </TabControl.Resources>

            <!-- TabPage1: بيانات المجموعة -->
            <TabItem Header="📋 بيانات المجموعة">
                <Border Background="White"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="0,0,8,8"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- صورة المجموعة -->
                        <Border Grid.Row="0" Grid.RowSpan="8" Grid.Column="0"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1" CornerRadius="8"
                                Background="#F5F7FA"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- صورة -->
                                <Border Grid.Row="0" CornerRadius="7,7,0,0"
                                        Background="#EAECF3" Margin="4">
                                    <Image x:Name="picImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MaxHeight="180"/>
                                </Border>

                                <!-- روابط الصورة -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,6,0,8">
                                    <TextBlock Text="📂 رفع"
                                               Style="{StaticResource LinkStyle}"
                                               Margin="0,0,16,0"
                                               MouseLeftButtonDown="lnkImgAdd_Click"/>
                                    <TextBlock Text="🗑️ حذف"
                                               Style="{StaticResource LinkStyle}"
                                               MouseLeftButtonDown="lnkImgClr_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- رقم المجموعة -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="🔢 رقم المجموعة" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtGrpNO"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True"/>
                        </StackPanel>

                        <!-- اسم المجموعة -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="📝 اسم المجموعة" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNameAr"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <!-- الاسم En -->
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="🔤 الاسم En:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtNameEn"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                    </Grid>
                </Border>
            </TabItem>

            <!-- TabPage2: البحث -->
            <TabItem Header="🔍 البحث">
                <Grid Background="#F3F5F9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- الجدول -->
                        <ColumnDefinition Width="230"/>
                        <!-- منطقة البحث -->
                    </Grid.ColumnDefinitions>

                    <!-- جدول المجموعات -->
                    <Border Grid.Column="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1" CornerRadius="8"
                            Margin="4"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0" Padding="10,4">
                                <TextBlock Text="📋 قائمة المجموعات"
                                           Foreground="White" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           FontFamily="Cairo, Tahoma, Arial"/>
                            </Border>

                            <DataGrid x:Name="dgvGrps"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F0FFF0"
                                      BorderThickness="0"
                                      MouseLeftButtonUp="dgvGrps_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="🔢 الرقم"
                                                        Binding="{Binding Id}"
                                                        Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="Gray"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="📝 اسم المجموعة"
                                                        Binding="{Binding Name}"
                                                        Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- منطقة البحث -->
                    <Border Grid.Column="1"
                            Background="#4A4A4A"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1" CornerRadius="8"
                            Margin="0,4,4,4"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="🔍 البحث"
                                       Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                       FontFamily="Cairo, Tahoma, Arial"/>

                            <TextBlock Text="🔢 رقم المجموعة"
                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"
                                       FontFamily="Cairo, Tahoma, Arial"/>
                            <TextBox x:Name="txtSrchNo"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="📝 اسم المجموعة"
                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                       Margin="0,0,0,4"
                                       FontFamily="Cairo, Tahoma, Arial"/>
                            <TextBox x:Name="txtNameSrch"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,12"/>

                            <Button Content="🔍 بحث"
                                    Style="{StaticResource BlueBtn}"
                                    Height="36"
                                    Click="btnSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- التنقل -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖" Style="{StaticResource DangerBtn}"
                            Width="40" ToolTip="إغلاق"
                            Margin="0,0,4,0" Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"   Content="⏮" Style="{StaticResource NavBtn}"
                            ToolTip="الأول"   Margin="0,0,2,0" Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀" Style="{StaticResource NavBtn}"
                            ToolTip="السابق" Margin="0,0,2,0" Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"    Content="▶" Style="{StaticResource NavBtn}"
                            ToolTip="التالي"  Margin="0,0,2,0" Click="btnNext_Click"/>
                    <Button x:Name="btnLast"    Content="⏭" Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"  Click="btnLast_Click"/>
                </StackPanel>

                <!-- العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource GrayBtn}"
                            Width="80" Margin="0,0,4,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource OrangeBtn}"
                            Width="76" Margin="0,0,4,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="76" Margin="0,0,4,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource BlueBtn}"
                            Width="76"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>