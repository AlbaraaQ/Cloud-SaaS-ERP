<Window x:Class="SmartAuditERP.Form_WPF.FrmAccountingPeriods"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="إدارة الفترات المحاسبية" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F5F6FA"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Gradients -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4834DF" Offset="0"/>
            <GradientStop Color="#686DE0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E8EAF6" Offset="0"/>
            <GradientStop Color="#C5CAE9" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styles -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2F3640"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D8E0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- Header -->
            <RowDefinition Height="220"/>
            <!-- Form -->
            <RowDefinition Height="65"/>
            <!-- Actions -->
            <RowDefinition Height="*"/>
            <!-- Grid -->
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}">
            <Grid Margin="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🗂️ إدارة الفترات المحاسبية" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="LblActivePeriod" Text="لا توجد فترة نشطة" Foreground="#FFD93D" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <Button x:Name="BtnRefresh" Content="🔄 تحديث" HorizontalAlignment="Left" 
                        Background="#5F27CD" Width="100" Height="35" Foreground="White" FontWeight="Bold"
                        Click="BtnRefresh_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Form Section -->
        <Border Grid.Row="1" Background="White" Margin="15,10" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="0"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 1 -->
                <Label Grid.Row="0" Grid.Column="0" Content="رقم الفترة:" Style="{StaticResource ModernLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtPeriodID" Style="{StaticResource ModernTextBox}" 
                         IsReadOnly="True" Background="#F8F9FA" Margin="0,5"/>

                <Label Grid.Row="0" Grid.Column="2" Content="اسم الفترة:" Style="{StaticResource ModernLabel}" Margin="15,0,0,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtPeriodName" Style="{StaticResource ModernTextBox}" Margin="0,5"/>

                <!-- Row 2 -->
                <Label Grid.Row="1" Grid.Column="0" Content="تاريخ من:" Style="{StaticResource ModernLabel}"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DtpStartDate" Style="{StaticResource ModernDatePicker}" Margin="0,5"/>

                <Label Grid.Row="1" Grid.Column="2" Content="تاريخ إلى:" Style="{StaticResource ModernLabel}" Margin="15,0,0,0"/>
                <DatePicker Grid.Row="1" Grid.Column="3" x:Name="DtpEndDate" Style="{StaticResource ModernDatePicker}" Margin="0,5"/>

                <!-- Row 3 -->
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkIsActive" 
                          Content="✔️ فترة نشطة حالياً" FontSize="14" FontWeight="SemiBold" 
                          Foreground="#27AE60" Margin="0,10"/>

                <!-- Row 4 - Notes -->
                <Label Grid.Row="3" Grid.Column="0" Content="ملاحظات:" Style="{StaticResource ModernLabel}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtNotes" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Height="60" Padding="10" FontSize="13" Margin="0,5"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="{StaticResource ActionBarGradient}" Margin="15,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnAdd" Content="➕ إضافة" Background="#27AE60" Style="{StaticResource ActionButton}" Click="BtnAdd_Click"/>
                <Button x:Name="BtnUpdate" Content="✏️ تعديل" Background="#3498DB" Style="{StaticResource ActionButton}" Click="BtnUpdate_Click"/>
                <Button x:Name="BtnActivate" Content="⚡ تفعيل" Background="#F39C12" Style="{StaticResource ActionButton}" Click="BtnActivate_Click"/>
                <Button x:Name="BtnClose" Content="🔒 إغلاق الفترة" Background="#E74C3C" Style="{StaticResource ActionButton}" Click="BtnClosePeriod_Click"/>
                <Button x:Name="BtnReopen" Content="🔓 إعادة فتح" Background="#9B59B6" Style="{StaticResource ActionButton}" Click="BtnReopen_Click"/>
                <Button x:Name="BtnClear" Content="🆕 جديد" Background="#95A5A6" Style="{StaticResource ActionButton}" Click="BtnClear_Click"/>
                <Button x:Name="BtnDelete" Content="🗑️ حذف" Background="#C0392B" Style="{StaticResource ActionButton}" Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="3" Background="White" Margin="15,10,15,15" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="0"/>
            </Border.Effect>
            <DataGrid x:Name="DataGridView1" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" AlternatingRowBackground="#F8F9FA"
                      RowHeight="40" SelectionMode="Single" SelectionChanged="DataGridView1_SelectionChanged"
                      MouseDoubleClick="DataGridView1_DoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4834DF"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم" Binding="{Binding PeriodID}" Width="70"/>
                    <DataGridTextColumn Header="اسم الفترة" Binding="{Binding PeriodName}" Width="*"/>
                    <DataGridTextColumn Header="تاريخ البداية" Binding="{Binding StartDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="120"/>
                    <DataGridTextColumn Header="تاريخ النهاية" Binding="{Binding EndDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="120"/>
                    <DataGridCheckBoxColumn Header="نشطة" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridCheckBoxColumn Header="مغلقة" Binding="{Binding IsClosed}" Width="60"/>
                    <DataGridTextColumn Header="أغلقت بواسطة" Binding="{Binding ClosedBy}" Width="130"/>
                    <DataGridTextColumn Header="تاريخ الإغلاق" Binding="{Binding ClosedDate, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="150"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>