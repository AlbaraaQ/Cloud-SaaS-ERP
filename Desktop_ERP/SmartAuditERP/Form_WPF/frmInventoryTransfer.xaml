<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmInventoryTransfer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="مناقلة"
    WindowState="Maximized"
    MinWidth="1020" MinHeight="720"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    KeyDown="Window_KeyDown"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrintBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#7B68EE" Offset="0"/>
            <GradientStop Color="#4B3DBF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ImportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0A500" Offset="0"/>
            <GradientStop Color="#C07800" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NumPadBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8EBF5" Offset="0"/>
            <GradientStop Color="#D0D7E8" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Styles ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#213A7A"/>
        </Style>

        <Style x:Key="NumNoBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#B22222"
                        CornerRadius="6"
                        Padding="4,0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn"   TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="PrintBtn"  TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource PrintBrush}"/>
        </Style>
        <Style x:Key="ImportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ImportBrush}"/>
        </Style>
        <Style x:Key="NavBtn"    TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="NumPadBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#213A7A"/>
            <Setter Property="Background" Value="{StaticResource NumPadBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C8D2EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B0BEDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#D8E0F4"
                                BorderBrush="{StaticResource BorderLight}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Margin="2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{StaticResource HeaderBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <!-- ════════════════════════════════════════════════ -->
    <!--                 Main Layout                    -->
    <!-- ════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════ TabControl2 الرئيسي ════ -->
        <TabControl x:Name="TabControl2"
                    Grid.Row="0"
                    Background="Transparent"
                    BorderThickness="0"
                    FlowDirection="RightToLeft"
                    SelectionChanged="TabControl2_SelectionChanged">

            <!-- ══════════════════════════════════════════ -->
            <!--          Tab 1: الرئيسي (الفاتورة)        -->
            <!-- ══════════════════════════════════════════ -->
            <TabItem Header="📋 الرئيسي" Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- معلومات الفاتورة -->
                        <RowDefinition Height="Auto"/>
                        <!-- TabControl1 داخلي -->
                        <RowDefinition Height="*"/>
                        <!-- GridControl1 -->
                        <RowDefinition Height="Auto"/>
                        <!-- لوحة الأرقام + الملخص -->
                        <RowDefinition Height="Auto"/>
                        <!-- معلومات الصنف -->
                    </Grid.RowDefinitions>

                    <!-- ══ معلومات الفاتورة (GroupBox3) ══ -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8"
                            Margin="4,4,4,0"
                            CornerRadius="10,10,0,0"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- الصف الأول: رقم + تاريخ + وقت + مرجع -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🔢 الرقم"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNo"
                                         Grid.Column="2"
                                         Style="{StaticResource NumNoBox}"
                                         IsReadOnly="True"/>

                                <TextBlock Grid.Column="4" Text="📅 التاريخ"
                                           Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="txtDate"
                                            Grid.Column="6"
                                            Style="{StaticResource ModernDatePicker}"
                                            SelectedDateChanged="txtDate_SelectedDateChanged"/>

                                <TextBlock Grid.Column="8" Text="⏰ الوقت"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtInvTime"
                                         Grid.Column="10"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="00:00:00"
                                         TextAlignment="Center"/>

                                <Button x:Name="btnShortCutInv"
        Content="⚡ اختصارات"
        Style="{StaticResource ImportBtn}"
        Height="32" MinWidth="100"
        Click="btnShortCutInv_Click"/>

                                <CheckBox x:Name="ckZeroVAT"
          Content="تصفير الضريبة"
          Checked="ckZeroVAT_Checked"
          Unchecked="ckZeroVAT_Unchecked"/>

                                <TextBlock Grid.Column="12" Text="🔗 المرجع"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtRefNo"
                                         Grid.Column="14"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"
                                         TextChanged="txtRefNo_TextChanged"/>

                                <TextBlock Grid.Column="16" Text="📅 تاريخ المرجع"
                                           Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="txtRefDate"
                                            Grid.Column="18"
                                            Style="{StaticResource ModernDatePicker}"
                                            SelectedDateChanged="txtRefDate_SelectedDateChanged"/>

                                <!-- الوقت الحالي -->
                                <TextBlock x:Name="lblCurrentTime"
                                           Grid.Column="20"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#1B8E4A"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Grid>

                            <!-- الصف الثاني: مستودع من + مستودع إلى + البيان -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🏪 من مستودع"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSafeFrom"
                                          Grid.Column="2"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="cmbSafeFrom_SelectionChanged"/>

                                <TextBlock Grid.Column="4" Text="🏪 إلى مستودع"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSafeTo"
                                          Grid.Column="6"
                                          Style="{StaticResource ModernComboBox}"/>

                                <TextBlock Grid.Column="8" Text="📝 البيان"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNote"
                                         Grid.Column="10"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="txtNote_TextChanged"/>

                                <TextBlock Grid.Column="12" Text="🔢 نسبة الضريبة"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtInvTaxPer"
                                         Grid.Column="14"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         TextAlignment="Center"/>
                            </Grid>

                            <!-- الصف الثالث: رسالة الاستلام + أزرار إضافية -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="lblReceiveTransfer"
                                           Grid.Column="0"
                                           Foreground="#1B8E4A"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <Button x:Name="btnReceiveQuantity"
                                        Grid.Column="2"
                                        Content="📥 استلام مناقلة"
                                        Style="{StaticResource SaveBtn}"
                                        Height="32" MinWidth="130"
                                        Click="btnReceiveQuantity_Click"/>

                                <Button x:Name="BtnInvertoryOrder"
                                        Grid.Column="4"
                                        Content="📋 إدراج طلب بضاعة"
                                        Style="{StaticResource ImportBtn}"
                                        Height="32" MinWidth="140"
                                        Click="BtnInvertoryOrder_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ══ TabControl1 (الفاتورة / البحث) ══ -->
                    <TabControl x:Name="TabControl1"
                                Grid.Row="1"
                                Background="Transparent"
                                BorderThickness="0"
                                FlowDirection="RightToLeft"
                                Margin="4,0,4,0"
                                SelectionChanged="TabControl1_SelectionChanged">

                        <!-- Tab: الفاتورة (TabPage1) -->
                        <TabItem Header="📄 الفاتورة" Style="{StaticResource ModernTabItem}">
                            <!-- محتوى فارغ - الجدول في Grid.Row=2 -->
                        </TabItem>

                        <!-- Tab: البحث (TabPage2) -->
                        <TabItem Header="🔍 البحث" Style="{StaticResource ModernTabItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <!-- شريط البحث -->
                                <Border Grid.Row="0"
                                        Background="#F0F4FF"
                                        BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8">
                                    <WrapPanel Orientation="Horizontal">

                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="رقم الفاتورة"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtSrchNo"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Width="120"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="رقم المرجع"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="txtSrchreffNo"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Width="120"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <CheckBox x:Name="chkAll"
                                                      Content="الكل"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Checked="chkAll_CheckedChanged"
                                                      Unchecked="chkAll_CheckedChanged"/>
                                            <ComboBox x:Name="cmbClientSrch"
                                                      Style="{StaticResource ModernComboBox}"
                                                      IsEnabled="False"
                                                      Width="160"
                                                      DisplayMemberPath="name"
                                                      SelectedValuePath="id"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="من"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <DatePicker x:Name="txtFromDate"
                                                        Style="{StaticResource ModernDatePicker}"
                                                        Width="120"
                                                        Margin="0,0,6,0"/>
                                            <TextBlock Text="إلى"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <DatePicker x:Name="txtToDate"
                                                        Style="{StaticResource ModernDatePicker}"
                                                        Width="120"/>
                                        </StackPanel>

                                        <Button x:Name="btnSearch"
                                                Content="🔍 بحث"
                                                Style="{StaticResource ActionBtn}"
                                                Height="32" Width="90"
                                                Click="btnSearch_Click"/>
                                    </WrapPanel>
                                </Border>

                                <!-- نتائج البحث -->
                                <DataGrid x:Name="dgvSrch"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                          RowStyle="{StaticResource DgvRow}"
                                          Background="White"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#E8EBF5"
                                          AlternatingRowBackground="#F8F9FD"
                                          BorderThickness="0"
                                          FlowDirection="RightToLeft"
                                          MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="GlobalID"
                                                            Binding="{Binding GlobalID}"
                                                            Visibility="Collapsed" Width="0"/>
                                        <DataGridTextColumn Header="🔢 الرقم"
                                                            Binding="{Binding InvNo}"
                                                            Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="🔗 رقم المرجع"
                                                            Binding="{Binding RefNo}"
                                                            Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="📅 التاريخ"
                                                            Binding="{Binding InvDate}"
                                                            Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="👤 العميل"
                                                            Binding="{Binding Client}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- ══ GridControl1: بنود الفاتورة ══ -->
                    <Border Grid.Row="2"
                            Background="White"
                            Margin="4,0,4,0"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}">
                                <TextBlock Text="📦 بنود المناقلة"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="14,0"/>
                            </Border>

                            <dxg:GridControl x:Name="GridControl1"
                                             Grid.Row="1"
                                             FlowDirection="RightToLeft"
                                             AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="GridView1"
                                                   AllowEditing="True"
                                                   ShowTotalSummary="False"
                                                   NewItemRowPosition="Bottom"
                                                   NavigationStyle="Row"
                                                   ShowGroupPanel="False"
                                                   CellValueChanged="GridView1_CellValueChanged"
                                                   KeyDown="GridView1_KeyDown"
                                                   FocusedRowChanged="GridView1_FocusedRowChanged">
                                    </dxg:TableView>
                                </dxg:GridControl.View>

                                <dxg:GridControl.Columns>

                                    <!-- # -->
                                    <dxg:GridColumn Header="#"
                                                    FieldName="ItemRowIndex"
                                                    Width="50" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- رمز الصنف -->
                                    <dxg:GridColumn Header="رمز الصنف"
                                                    FieldName="ItemCode"
                                                    Width="90"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- اسم الصنف + زر بحث -->
                                    <dxg:GridColumn Header="الصنف"
                                                    FieldName="ItemName"
                                                    Width="160"
                                                    HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <dxe:TextEdit
                                                        Grid.Column="0"
                                                        EditValue="{Binding RowData.Row.ItemName,
                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                        KeyDown="ItemNameEdit_KeyDown"/>
                                                    <Button Grid.Column="1"
                                                            Content="🔍"
                                                            FontSize="10"
                                                            Background="{StaticResource HeaderBrush}"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding RowData.Row}"
                                                            Click="ItemSearchBtn_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>

                                    <!-- الوصف -->
                                    <dxg:GridColumn Header="الوصف"
                                                    FieldName="Description"
                                                    Width="100"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- الباركود -->
                                    <dxg:GridColumn Header="الباركود"
                                                    FieldName="ItemBarcode"
                                                    Width="80"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- الوحدة -->
                                    <dxg:GridColumn Header="الوحدة"
                                                    FieldName="UnitName"
                                                    Width="80" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding RowData.Row.UnitName}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Content="🔄"
                                                            FontSize="9"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding RowData.Row}"
                                                            Click="UnitChangeBtn_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>

                                    <!-- الكمية -->
                                    <dxg:GridColumn Header="الكمية"
                                                    FieldName="ItemQuantity"
                                                    Width="80"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- التعادل -->
                                    <dxg:GridColumn Header="التعادل"
                                                    FieldName="UnitEquality"
                                                    Width="70"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- إجمالي الكمية -->
                                    <dxg:GridColumn Header="إجمالي الكمية"
                                                    FieldName="ItemPrimaryQnty"
                                                    Width="90" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- السعر -->
                                    <dxg:GridColumn Header="السعر"
                                                    FieldName="ItemPrice"
                                                    Width="80"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- المجموع -->
                                    <dxg:GridColumn Header="المجموع"
                                                    FieldName="ItemSumPrice"
                                                    Width="80" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- متوسط التكلفة -->
                                    <dxg:GridColumn Header="التكلفة"
                                                    FieldName="ItemCost"
                                                    Width="80" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- الخصم -->
                                    <dxg:GridColumn Header="الخصم"
                                                    FieldName="ItemDiscount"
                                                    Width="80"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- نسبة الخصم -->
                                    <dxg:GridColumn Header="نسبة الخصم"
                                                    FieldName="ItemDiscountPerc"
                                                    Width="80"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- الإجمالي -->
                                    <dxg:GridColumn Header="الإجمالي"
                                                    FieldName="ItemTotalPrice"
                                                    Width="80" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- نسبة الضريبة -->
                                    <dxg:GridColumn Header="نسبة الضريبة"
                                                    FieldName="ItemVatPerc"
                                                    Width="80"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- الضريبة -->
                                    <dxg:GridColumn Header="الضريبة"
                                                    FieldName="ItemVat"
                                                    Width="80" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- الصافي -->
                                    <dxg:GridColumn Header="الصافي"
                                                    FieldName="ItemNetPrice"
                                                    Width="80" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- الكمية الحالية -->
                                    <dxg:GridColumn Header="الكمية الحالية"
                                                    FieldName="ValiableInvertory"
                                                    Width="90" ReadOnly="True"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- المستودع -->
                                    <dxg:GridColumn Header="المستودع"
                                                    FieldName="InvertoryName"
                                                    Width="100"
                                                    HorizontalHeaderContentAlignment="Center">
                                        <dxg:GridColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding RowData.Row.InvertoryName}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Content="🏪"
                                                            FontSize="9"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Tag="{Binding RowData.Row}"
                                                            Click="InvertoryChangeBtn_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </dxg:GridColumn.CellTemplate>
                                    </dxg:GridColumn>

                                    <!-- تاريخ الانتهاء -->
                                    <dxg:GridColumn Header="تاريخ الانتهاء"
                                                    FieldName="ItemExpireDate"
                                                    Width="100"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- ملاحظة -->
                                    <dxg:GridColumn Header="ملاحظة"
                                                    FieldName="ItemNotes"
                                                    Width="120"
                                                    HorizontalHeaderContentAlignment="Center"/>

                                    <!-- أعمدة مخفية -->
                                    <dxg:GridColumn FieldName="ItemId"       Visible="False" Width="0"/>
                                    <dxg:GridColumn FieldName="ItemBarcode"  Visible="False" Width="0"/>
                                    <dxg:GridColumn FieldName="InvertoryId"  Visible="False" Width="0"/>

                                </dxg:GridControl.Columns>
                            </dxg:GridControl>

                        </Grid>
                    </Border>

                    <!-- ══ لوحة الأرقام + الملخص المالي (GroupBox9) ══ -->
                    <Border Grid.Row="3"
                            Background="White"
                            Margin="4,0,4,0"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,1,0,0"
                            Padding="8,6"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- لوحة الأرقام -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <!-- الملخص المالي -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <!-- معلومات إضافية -->
                            </Grid.ColumnDefinitions>

                            <!-- ── لوحة الأرقام ── -->
                            <Border Grid.Column="0"
                                    Background="#F0F4FF"
                                    CornerRadius="8"
                                    Padding="4"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1">
                                <Grid Width="152">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="cmd135" Grid.Row="0" Grid.Column="0"
                                            Content="1" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="1"/>
                                    <Button x:Name="cmd2" Grid.Row="0" Grid.Column="2"
                                            Content="2" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="2"/>
                                    <Button x:Name="cmd3" Grid.Row="0" Grid.Column="4"
                                            Content="3" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="3"/>

                                    <Button x:Name="cmd4" Grid.Row="2" Grid.Column="0"
                                            Content="4" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="4"/>
                                    <Button x:Name="cmd5" Grid.Row="2" Grid.Column="2"
                                            Content="5" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="5"/>
                                    <Button x:Name="cmd6" Grid.Row="2" Grid.Column="4"
                                            Content="6" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="6"/>

                                    <Button x:Name="cmd7" Grid.Row="4" Grid.Column="0"
                                            Content="7" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="7"/>
                                    <Button x:Name="cmd8" Grid.Row="4" Grid.Column="2"
                                            Content="8" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="8"/>
                                    <Button x:Name="cmd9" Grid.Row="4" Grid.Column="4"
                                            Content="9" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="9"/>

                                    <Button x:Name="cmd0" Grid.Row="6" Grid.Column="0"
                                            Content="0" Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="0"/>
                                    <Button x:Name="cmdDot" Grid.Row="6" Grid.Column="2"
                                            Content="." Style="{StaticResource NumPadBtn}"
                                            Click="NumPad_Click" Tag="."/>
                                    <Button x:Name="cmdClearAll" Grid.Row="6" Grid.Column="4"
                                            Content="C"
                                            FontSize="13"
                                            Style="{StaticResource NumPadBtn}"
                                            Foreground="#CC0000"
                                            Click="cmdClearAll_Click"/>
                                </Grid>
                            </Border>

                            <!-- ── الملخص المالي ── -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- الصف الأول من الملخص -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="💰 المجموع"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtSumVal"
                                                 Style="{StaticResource SummaryBox}"
                                                 Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="💸 إجمالي الخصم"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtTotDiscount"
                                                 Style="{StaticResource SummaryBox}"
                                                 Foreground="#CC0000"
                                                 Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="📊 الضريبة"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtTotVAT"
                                                 Style="{StaticResource SummaryBox}"
                                                 Foreground="#CC8800"
                                                 Text="0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="🏆 الصافي"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,0,3"/>
                                        <TextBox x:Name="txtNetWithoutVAT"
                                                 Style="{StaticResource SummaryBox}"
                                                 FontSize="16"
                                                 Foreground="#213A7A"
                                                 Text="0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- الصف الثاني: خصم الفاتورة + نسبة + ضريبة -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="خصم الفاتورة"
                                               Style="{StaticResource FieldLabel}"
                                               Foreground="#CC0000"/>
                                    <TextBox x:Name="txtInvDiscVal"
                                             Grid.Column="2"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"
                                             Text="0"
                                             Foreground="#CC0000"
                                             LostFocus="txtInvDiscVal_LostFocus"
                                             KeyDown="txtInvDiscVal_KeyDown"/>

                                    <TextBlock Grid.Column="4" Text="%"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#CC0000"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtInvDiscPerc"
                                             Grid.Column="6"
                                             Style="{StaticResource ModernTextBox}"
                                             TextAlignment="Center"
                                             Text="0"
                                             Foreground="#CC0000"
                                             LostFocus="txtInvDiscPerc_LostFocus"
                                             KeyDown="txtInvDiscPerc_KeyDown"/>

                                    <TextBlock Grid.Column="8" Text="عدد الأصناف"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtTirmsNo"
                                             Grid.Column="10"
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"
                                             TextAlignment="Center"
                                             Text="0"/>
                                </Grid>
                            </Grid>

                            <!-- ── معلومات الصنف المختار ── -->
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="الكمية الحالية:"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtStock"
                                         Grid.Row="0" Grid.Column="2"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         FontSize="11"
                                         TextAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="التعادل:"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtPerUnit"
                                         Grid.Row="2" Grid.Column="2"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         FontSize="11"
                                         TextAlignment="Center"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="آخر سعر شراء:"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtRecentPurchPrice"
                                         Grid.Row="4" Grid.Column="2"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         FontSize="11"
                                         TextAlignment="Center"/>
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- ══ معلومات إضافية للصنف (باركود + أسعار) ══ -->
                    <Border Grid.Row="4"
                            Background="#F8F9FD"
                            Margin="4,0,4,4"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,1,0,0"
                            Padding="8,4">
                        <WrapPanel Orientation="Horizontal">

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="باركود:" Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtItemBarcode"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Width="150"
                                         FontSize="11"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="آخر سعر بيع:" Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtLastSalePrice"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Width="90"
                                         FontSize="11"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="سعر المنافس:" Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtCompetitorPrice"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Width="90"
                                         FontSize="11"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="متوسط التكلفة:" Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtCostAvrg"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Width="90"
                                         FontSize="11"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="الكمية الكلية:" Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBox x:Name="txtTotUnitQuan"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Width="90"
                                         FontSize="11"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="عدد الصفوف:" Style="{StaticResource FieldLabel}"
                                           FontSize="10"/>
                                <TextBlock x:Name="lblRowsCount"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#213A7A"/>
                            </StackPanel>

                        </WrapPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════ -->
            <!--       Tab 2: استلام مناقلة (searchTab)   -->
            <!-- ══════════════════════════════════════════ -->
            <TabItem Header="📥 استلام مناقلة" Style="{StaticResource ModernTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- شريط الفلاتر (pnlTop) -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8"
                            Margin="4,4,4,0"
                            CornerRadius="10,10,0,0"
                            Effect="{StaticResource CardShadow}">
                        <WrapPanel Orientation="Horizontal">

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="🔢 رقم المناقلة"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtTransferNo"
                                         Style="{StaticResource ModernTextBox}"
                                         Width="130"
                                         IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <CheckBox x:Name="chkAllTrans"
                                          Content="الكل"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Checked="chkAllTrans_CheckedChanged"
                                          Unchecked="chkAllTrans_CheckedChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <CheckBox x:Name="ckTotalPeriod"
                                          Content="فترة كاملة"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Checked="ckTotalPeriod_CheckedChanged"
                                          Unchecked="ckTotalPeriod_CheckedChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="من" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="txtDateFrom"
                                            Style="{StaticResource ModernDatePicker}"
                                            IsEnabled="False"
                                            Width="120"
                                            Margin="0,0,6,0"/>
                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="txtDateTo"
                                            Style="{StaticResource ModernDatePicker}"
                                            IsEnabled="False"
                                            Width="120"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <CheckBox x:Name="chkAllSafes"
                                          Content="الكل"
                                          IsChecked="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Checked="chkAllSafes_CheckedChanged"
                                          Unchecked="chkAllSafes_CheckedChanged"/>
                                <TextBlock Text="🏪" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSearchSafe"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False"
                                          Width="160"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"/>
                            </StackPanel>

                            <Button Content="🔍 بحث"
                                    Style="{StaticResource ActionBtn}"
                                    Height="32" Width="90"
                                    Margin="0,0,8,0"
                                    Click="LoadMoneyTransferData_Click"/>

                        </WrapPanel>
                    </Border>

                    <!-- GridControl2: قائمة المناقلات -->
                    <Border Grid.Row="1"
                            Background="White"
                            Margin="4,0,4,4"
                            CornerRadius="0,0,10,10"
                            Effect="{StaticResource CardShadow}">
                        <dxg:GridControl x:Name="GridControl2"
                                         FlowDirection="RightToLeft"
                                         AutoGenerateColumns="None">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="GridView2"
                                               AllowEditing="False"
                                               ShowTotalSummary="False"
                                               ShowGroupPanel="False"
                                               NavigationStyle="Row">
                                </dxg:TableView>
                            </dxg:GridControl.View>

                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="InvGlobalID"
                                                Visible="False" Width="0"/>
                                <dxg:GridColumn FieldName="invoiceStatus"
                                                Visible="False" Width="0"/>
                                <dxg:GridColumn FieldName="branchFrom"
                                                Visible="False" Width="0"/>
                                <dxg:GridColumn FieldName="Reff_No"
                                                Visible="False" Width="0"/>

                                <dxg:GridColumn Header="🔢 الرقم"
                                                FieldName="id"
                                                Width="70" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn Header="📅 التاريخ"
                                                FieldName="InvDate"
                                                Width="100" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn Header="من فرع"
                                                FieldName="branchFromName"
                                                Width="130" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn Header="إلى فرع"
                                                FieldName="toBranchName"
                                                Width="130" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn Header="من مستودع"
                                                FieldName="safeFromName"
                                                Width="120" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn Header="إلى مستودع"
                                                FieldName="safeName"
                                                Width="120" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn Header="البيان"
                                                FieldName="notes"
                                                Width="*" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>
                                <dxg:GridColumn Header="الحالة"
                                                FieldName="InvStatus"
                                                Width="80" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center"/>

                                <!-- زر عرض التفاصيل -->
                                <dxg:GridColumn Header="👁️ عرض"
                                                FieldName="details"
                                                Width="60" ReadOnly="True"
                                                HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="👁️"
                                                    FontSize="13"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Center"
                                                    Tag="{Binding RowData.Row}"
                                                    Click="RItemBtnEdit_Click"/>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                            </dxg:GridControl.Columns>
                        </dxg:GridControl>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- ════════════════════════════════════════════ -->
        <!--               Footer Buttons               -->
        <!-- ════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل + خروج -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="44"
                            ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق (F4)"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Margin="0,0,4,0"
                            Click="btnLast_Click"/>
                    <Button x:Name="btnInvSrch"
                            Content="🔍"
                            Style="{StaticResource NavBtn}"
                            ToolTip="بحث بالفاتورة"
                            Click="btnInvSrch_Click"/>
                    <Button x:Name="BtnSaveDgvSettings"
        Content="💾 حفظ المظهر"
        Style="{StaticResource ActionBtn}"
        Height="32" MinWidth="100"
        Click="BtnSaveDgvSettings_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button x:Name="btnInsertPurch"
                            Content="📥 إدراج مشتريات"
                            Style="{StaticResource ImportBtn}"
                            MinWidth="130"
                            Margin="0,0,6,0"
                            Click="btnInsertPurch_Click"/>

                    <Button x:Name="btnInvOrderFooter"
        Content="📋 طلب بضاعة"
        Style="{StaticResource ImportBtn}"
        MinWidth="110"
        Margin="0,0,6,0"
        Click="BtnInvertoryOrder_Click"/>

                    <!-- استيراد/تصدير -->
                    <Button x:Name="btnStripImport"
                            Content="📤 استيراد"
                            Style="{StaticResource ImportBtn}"
                            MinWidth="90"
                            Margin="0,0,6,0"
                            Click="stripImport_Click"/>

                    <Button x:Name="btnStripExport"
                            Content="📊 تصدير"
                            Style="{StaticResource ImportBtn}"
                            MinWidth="90"
                            Margin="0,0,6,0"
                            Click="stripExport_Click"/>

                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            MinWidth="80"
                            Margin="0,0,6,0"
                            ToolTip="حذف (F9)"
                            Click="btnDelete_Click"/>

                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource PrintBtn}"
                            MinWidth="88"
                            Margin="0,0,6,0"
                            ToolTip="معاينة (F8)"
                            Click="btnView_Click"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintBtn}"
                            MinWidth="88"
                            Margin="0,0,6,0"
                            ToolTip="طباعة (F7)"
                            Click="btnPrint_Click"/>

                    <Button x:Name="btnSavePrint"
                            Content="💾🖨️ حفظ+طباعة"
                            Style="{StaticResource PrintBtn}"
                            MinWidth="120"
                            Margin="0,0,6,0"
                            Click="btnSavePrint_Click"/>

                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            MinWidth="80"
                            Margin="0,0,6,0"
                            ToolTip="حفظ (F6)"
                            Click="btnSave_Click"/>

                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            MinWidth="80"
                            ToolTip="جديد (F5)"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>