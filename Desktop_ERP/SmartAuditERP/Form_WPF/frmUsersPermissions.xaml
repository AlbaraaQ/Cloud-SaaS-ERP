<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmUsersPermissions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="صلاحيات المستخدمين"
    Width="660" Height="520"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="PermCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Margin" Value="0,5,16,0"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,10"
                Effect="{StaticResource CardShadow}">
            <TextBlock Text="🔐 صلاحيات المستخدمين"
                       Foreground="White"
                       FontSize="15" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ═══ Employee Info Card ═══ -->
        <Border Grid.Row="1"
                Background="White"
                Padding="14,10"
                Margin="8,6,8,0"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- الموظف -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="👤 الموظف" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbEmp"
                              Style="{StaticResource ModernCombo}"
                              SelectionChanged="cmbEmp_SelectionChanged"/>
                </StackPanel>

                <!-- اسم المستخدم -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="👤 اسم المستخدم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtUser"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"/>
                </StackPanel>

                <!-- كلمة السر -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="🔑 كلمة السر" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPass"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TabControl ═══ -->
        <Border Grid.Row="2"
                Background="White"
                Margin="8,6,8,0"
                CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <TabControl x:Name="TabControl1"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- Tab 1: صلاحيات الشاشات -->
                <TabItem Header="🖥️ صلاحيات الشاشات">
                    <Border Background="#F8F9FD" Padding="4">
                        <TreeView x:Name="treeView1"
                                  Background="#F8F9FD"
                                  BorderThickness="0"
                                  FontSize="12"
                                  FontFamily="Cairo, Tahoma"
                                  SelectedItemChanged="treeView1_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="False"/>
                                    <Setter Property="Padding" Value="2,1"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Border>
                </TabItem>

                <!-- Tab 2: صلاحيات أخرى -->
                <TabItem Header="⚙️ صلاحيات أخرى">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8">

                            <!-- GroupBox العمليات -->
                            <Border Background="White"
                                    CornerRadius="8"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="⚙️ العمليات المسموحة"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#2E4E9E"
                                               Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="ckDiscount"
                                                  Content="تجاوز الخصم الافتراضي"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox1"
                                                  Content="تجاوز أعلى سعر بيع"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox2"
                                                  Content="تجاوز أدنى سعر بيع"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox3"
                                                  Content="تجاوز أعلى سعر شراء"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox4"
                                                  Content="تجاوز أدنى سعر شراء"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox5"
                                                  Content="البيع بأقل من متوسط التكلفة"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox6"
                                                  Content="تعديل سعر"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox7"
                                                  Content="الاطلاع على التكلفة"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox8"
                                                  Content="تعديل التاريخ في الفواتير"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox9"
                                                  Content="إظهار مخزون المواد"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="CheckBox10"
                                                  Content="تعديل بيانات المادة"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="ckShowBranchsAccounts"
                                                  Content="إظهار حسابات الفروع"
                                                  Style="{StaticResource PermCheckBox}"/>
                                        <CheckBox x:Name="chkDiscPassword"
                                                  Content="إلغاء كلمة المرور على الخصم"
                                                  Style="{StaticResource PermCheckBox}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- حدود الخصم -->
                            <Border Background="White"
                                    CornerRadius="8"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="💰 حدود الخصم"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#2E4E9E"
                                               Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="أعلى قيمة للخصم"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="MaxDicount"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="أعلى نسبة للخصم %"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="MaxDicountParcent"
                                                     Style="{StaticResource ModernTextBox}"
                                                     Text="0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>

        <!-- ═══ Footer Buttons ═══ -->
        <Border Grid.Row="3"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="12,8"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- أزرار التنقل -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="40"
                            ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- أزرار العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Visibility="Collapsed"
                            Margin="0,0,6,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnDelete"
                            Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnSave"
                            Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnNew"
                            Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>