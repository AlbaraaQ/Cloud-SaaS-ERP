<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.FrmSyncSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="Sync Settings"
    Width="580" Height="500"
    WindowStartupLocation="CenterScreen"
    Background="#F3F5F9"
    FlowDirection="RightToLeft"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E4E9E"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- ═══ Header ═══ -->
            <Border Background="{StaticResource HeaderBrush}"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,14"
                    Effect="{StaticResource CardShadow}">
                <TextBlock Text="⚙️ إعدادات المزامنة"
                           Foreground="White"
                           FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- ═══ Connection Settings Card ═══ -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,0,0,10"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="🔗 إعدادات الاتصال"
                               Style="{StaticResource GroupTitle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Client Code:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1"
                                 x:Name="txtClientCode"
                                 Style="{StaticResource ModernTextBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="API URL:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1"
                                 x:Name="txtAPIUrl"
                                 Style="{StaticResource ModernTextBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="User:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1"
                                 x:Name="txtUser"
                                 Style="{StaticResource ModernTextBox}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Password:"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1"
                                 x:Name="txtPassword"
                                 Style="{StaticResource ModernTextBox}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Branch Type + Sync Type ═══ -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Branch Type -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        Padding="14,10"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="🏢 Branch Type"
                                   Style="{StaticResource GroupTitle}"/>
                        <RadioButton x:Name="rbDataCenter"
                                     Content="Data Center Branch"
                                     FontWeight="SemiBold"
                                     Margin="0,4,0,0"/>
                        <RadioButton x:Name="rbSecondaryBranch"
                                     Content="Secondary Branch"
                                     FontWeight="SemiBold"
                                     Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Sync Type -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="10"
                        Padding="14,10"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="🔄 Sync Type"
                                   Style="{StaticResource GroupTitle}"/>
                        <RadioButton x:Name="rbAutoSync"
                                     Content="Auto Sync"
                                     FontWeight="SemiBold"
                                     Margin="0,4,0,0"/>
                        <RadioButton x:Name="rbPeriodicSync"
                                     Content="Periodic Sync"
                                     FontWeight="SemiBold"
                                     Margin="0,4,0,0"/>
                        <RadioButton x:Name="rbEndDay"
                                     Content="End Day"
                                     FontWeight="SemiBold"
                                     Margin="0,4,0,0"/>
                        <RadioButton x:Name="rbEndShift"
                                     Content="End Shift"
                                     FontWeight="SemiBold"
                                     Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Data Sync Checkboxes ═══ -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,10"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="📦 Data Sync"
                               Style="{StaticResource GroupTitle}"/>
                    <WrapPanel>
                        <CheckBox x:Name="ckShowMulti"
                                  Content="Accounting Invoices"
                                  IsChecked="True"
                                  FontWeight="SemiBold"
                                  Margin="0,0,16,6"/>
                        <CheckBox x:Name="ckShowVisa"
                                  Content="I/O Invoices"
                                  IsChecked="True"
                                  FontWeight="SemiBold"
                                  Margin="0,0,16,6"/>
                        <CheckBox x:Name="ckATM"
                                  Content="Items"
                                  IsChecked="True"
                                  FontWeight="SemiBold"
                                  Margin="0,0,16,6"/>
                        <CheckBox x:Name="ckShowNetwork"
                                  Content="Entries"
                                  IsChecked="True"
                                  FontWeight="SemiBold"
                                  Margin="0,0,16,6"/>
                        <CheckBox x:Name="ckShowCashMeth"
                                  Content="Clients"
                                  IsChecked="True"
                                  FontWeight="SemiBold"
                                  Margin="0,0,16,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Save Button ═══ -->
            <Button x:Name="btnSyncSave"
                    Content="💾 Save"
                    Style="{StaticResource SaveBtn}"
                    Margin="60,0,60,0"
                    Click="btnSyncSave_Click"/>

        </StackPanel>
    </ScrollViewer>
</dx:ThemedWindow>