<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmRptEntries"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="القيود اليومية"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="8" ShadowDepth="2"
                          Direction="270" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Direction="270" Opacity="0.16" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="40"/>
        </Style>

        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EAF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl -->
        <TabControl x:Name="TabControl1"
                    Grid.Row="0"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold"
                    Background="#F3F5F9">

            <!-- ═══ تبويب 1: بيانات القيد ═══ -->
            <TabItem Header="   📋 بيانات القيد   ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- بطاقة معلومات القيد -->
                    <Border Grid.Row="0"
                            Background="White"
                            Margin="6,6,6,4"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- رقم القيد + رقم المستند -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="رقم القيد:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNo"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="الرقم العام:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtEntryGID"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="📅 تاريخ القيد:" Style="{StaticResource FieldLabel}"/>
                                <dxe:DateEdit x:Name="txtDate"
                                              Height="28" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="6">
                                <TextBlock Text="نوع القيد:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtResType"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <!-- حالة القيد + الفرع + البيان -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="حالة القيد:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbState"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="معتمد"/>
                                    <ComboBoxItem Content="لاغي"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="🏢 الفرع:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbBranches"
                                          Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"
                                          IsEnabled="False"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4"
                                        Grid.ColumnSpan="3">
                                <TextBlock Text="📝 بيان القيد:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNotes"
                                         Style="{StaticResource ModernTextBox}"
                                         Height="42"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Padding="5,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- جدول تفاصيل القيد -->
                    <Border Grid.Row="1"
                            Background="White"
                            Margin="6,0,6,4"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <TextBlock Text="🧾 تفاصيل القيد"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="12,0"/>
                            </Border>

                            <DataGrid x:Name="dgvDetails"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD">
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="م"
                                                        Binding="{Binding RowNo}"
                                                        Width="55" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="مدين"
                                                        Binding="{Binding Dept}"
                                                        Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="دائن"
                                                        Binding="{Binding Credit}"
                                                        Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="كود الحساب"
                                                        Binding="{Binding AccCode}"
                                                        Width="110" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="اسم الحساب"
                                                        Binding="{Binding AccName}"
                                                        Width="180" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="مركز التكلفة"
                                                        Binding="{Binding CostCenter}"
                                                        Width="130" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="البيان"
                                                        Binding="{Binding Notes}"
                                                        Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- شريط المجاميع -->
                    <Border Grid.Row="2"
                            Background="White"
                            Margin="6,0,6,4"
                            CornerRadius="7"
                            Effect="{StaticResource CardShadow}"
                            Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtISBalanced"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="12" FontWeight="Bold"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="إجمالي المدين:" FontSize="11" FontWeight="Bold" Foreground="#1B2642" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="txtTotDebt"
                                         Width="100" Height="26"
                                         IsReadOnly="True"
                                         Background="#F0F2F7"
                                         BorderThickness="0"
                                         FontSize="11" FontWeight="Bold"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="إجمالي الدائن:" FontSize="11" FontWeight="Bold" Foreground="#1B2642" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="txtTotCredit"
                                         Width="100" Height="26"
                                         IsReadOnly="True"
                                         Background="#F0F2F7"
                                         BorderThickness="0"
                                         FontSize="11" FontWeight="Bold"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ تبويب 2: البحث ═══ -->
            <TabItem Header="   🔍 البحث   ">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- لوحة البحث -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="6" Padding="8,5"
                                    Margin="0,0,0,10">
                                <TextBlock Text="🔍 بحث في القيود"
                                           Foreground="White"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <!-- الصف الأول -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- رقم القيد -->
                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="chkAll"
                                              Content="كل القيود"
                                              IsChecked="True"
                                              FontSize="10" FontWeight="Bold"
                                              Margin="0,0,0,3"
                                              Checked="chkAll_Changed"
                                              Unchecked="chkAll_Changed"/>
                                    <TextBox x:Name="txtNoSrch"
                                             Style="{StaticResource ModernTextBox}"
                                             IsEnabled="False"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <!-- نوع السند -->
                                <StackPanel Grid.Column="2">
                                    <CheckBox x:Name="chkAllTypes"
                                              Content="كل الأنواع"
                                              IsChecked="True"
                                              FontSize="10" FontWeight="Bold"
                                              Margin="0,0,0,3"
                                              Checked="chkAllTypes_Changed"
                                              Unchecked="chkAllTypes_Changed"/>
                                    <ComboBox x:Name="cmbType"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              IsEnabled="False"
                                              SelectionChanged="cmbType_SelectionChanged"/>
                                </StackPanel>

                                <!-- الفرع -->
                                <StackPanel Grid.Column="4">
                                    <CheckBox x:Name="chkAllBranches"
                                              Content="كل الفروع"
                                              IsChecked="True"
                                              FontSize="10" FontWeight="Bold"
                                              Margin="0,0,0,3"
                                              Checked="chkAllBranches_Changed"
                                              Unchecked="chkAllBranches_Changed"/>
                                    <ComboBox x:Name="cmbSrcBranch"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="name"
                                              SelectedValuePath="id"
                                              IsEnabled="False"/>
                                </StackPanel>

                                <Button x:Name="btnSearch"
                                        Grid.Column="6"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="80"
                                        VerticalAlignment="Bottom"
                                        Click="btnSearch_Click"/>
                            </Grid>

                            <!-- الصف الثاني: الفترة + رقم المستند -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- الفترة -->
                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="chkAllPeriod"
                                              Content="كل الفترة"
                                              IsChecked="True"
                                              FontSize="10" FontWeight="Bold"
                                              Margin="0,0,0,3"
                                              Checked="chkAllPeriod_Changed"
                                              Unchecked="chkAllPeriod_Changed"/>
                                    <dxe:DateEdit x:Name="txtFromDate"
                                                  Height="28" FontSize="11"
                                                  FontWeight="SemiBold"
                                                  IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Bottom">
                                    <dxe:DateEdit x:Name="txtToDate"
                                                  Height="28" FontSize="11"
                                                  FontWeight="SemiBold"
                                                  IsEnabled="False"/>
                                </StackPanel>

                                <!-- رقم المستند -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="رقم المستند:"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtReffNo"
                                             Style="{StaticResource ModernTextBox}"
                                             IsEnabled="False"
                                             TextAlignment="Center"
                                             KeyDown="txtReffNo_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <!-- ProgressBar -->
                            <ProgressBar x:Name="ProgressBar1"
                                         Height="5"
                                         Margin="0,8,0,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Foreground="#2E4E9E"
                                         Background="#E8EBF5"/>
                        </StackPanel>
                    </Border>

                    <!-- جدول نتائج البحث -->
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="8"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <TextBlock Text="📋 نتائج البحث - انقر مزدوجاً لعرض القيد"
                                           Foreground="White"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="12,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F5F5F5"
                                      MouseDoubleClick="dgvSrch_MouseDoubleClick">
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="الرقم العام"
                                                        Binding="{Binding GlobalID}"
                                                        Width="90" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="رقم المستند"
                                                        Binding="{Binding DocNo}"
                                                        Width="90" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="تاريخ القيد"
                                                        Binding="{Binding EntryDate}"
                                                        Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="نوع القيد"
                                                        Binding="{Binding EntryType}"
                                                        Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="حالة القيد"
                                                        Binding="{Binding EntryState}"
                                                        Width="110" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="البيان"
                                                        Binding="{Binding Notes}"
                                                        Width="*" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="رقم القيد"
                                                        Binding="{Binding EntryId}"
                                                        Width="80" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Footer ═══ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                FlowDirection="LeftToRight"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- التنقل -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose"
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="36" ToolTip="خروج"
                            Margin="0,0,4,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst"
                            Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,4,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious"
                            Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,4,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,4,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast"
                            Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Click="btnLast_Click"/>
                </StackPanel>

                <!-- العمليات -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnShowSuorce"
                            Content="🔗 عرض المصدر"
                            Style="{StaticResource ActionBtn}"
                            Width="120"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="BtnShowSuorce_Click"/>
                    <Button x:Name="btnView"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Margin="0,0,6,0"
                            Click="btnView_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>