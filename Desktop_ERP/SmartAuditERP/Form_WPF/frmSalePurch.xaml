<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmSalePurch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="فاتورة المشتريات"
    MinWidth="1100" MinHeight="750"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown">

    <dx:ThemedWindow.Resources>

        <!-- ═══ Brushes ═══ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#17A2B8" Offset="0"/>
            <GradientStop Color="#117A8B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarnBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFA500" Offset="0"/>
            <GradientStop Color="#CC8400" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══ Effects ═══ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20" Color="#000000"/>

        <!-- ═══ Label Style ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- ═══ TextBox Style ═══ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ComboBox Style ═══ -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <!-- ═══ Button Styles ═══ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="InfoBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="WarnBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource WarnBrush}"/>
        </Style>

        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SmallAddBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

        <!-- ═══ DataGrid Column Header ═══ -->
        <Style x:Key="DgvColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="DgvRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5A6A8A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header: بيانات الفاتورة الرئيسية -->
            <RowDefinition Height="Auto"/>
            <!-- شريط الباركود + أدوات الجدول -->
            <RowDefinition Height="Auto"/>
            <!-- جدول الأصناف -->
            <RowDefinition Height="*"/>
            <!-- المعلومات التفصيلية للصنف + المجاميع -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             Row 0: GroupBox3 - بيانات الفاتورة الرئيسية
             ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Effect="{StaticResource CardShadow}">
            <StackPanel Margin="10,6,10,8">

                <!-- عنوان -->
                <Border Background="{StaticResource HeaderBrush}"
                        CornerRadius="8" Padding="10,5" Margin="0,0,0,8">
                    <TextBlock Text="🧾 بيانات الفاتورة"
                               Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- الصف الأول: رقم + تاريخ + رقم مرجع + تاريخ مرجع + نوع الدفع -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="الرقم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtNo" Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True" TextAlignment="Center"
                             Text="12" Background="#F5F7FA"/>

                    <TextBlock Grid.Column="3" Text="📅 التاريخ" Style="{StaticResource FieldLabel}"/>
                    <dxe:DateEdit x:Name="txtDate" Grid.Column="4"
                                  Height="30" FontSize="12" FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="6" Text="رقم المرجع" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtRefNo" Grid.Column="7"
                             Style="{StaticResource ModernTextBox}"
                             TextAlignment="Center"/>

                    <TextBlock Grid.Column="9" Text="تاريخ المرجع" Style="{StaticResource FieldLabel}"/>
                    <dxe:DateEdit x:Name="txtRefDate" Grid.Column="10"
                                  Height="30" FontSize="12" FontWeight="SemiBold"
                                  IsReadOnly="True"/>

                    <TextBlock Grid.Column="12" Text="طريقة الدفع" Style="{StaticResource FieldLabel}"
                               x:Name="lblPaymentMethod"/>
                    <ComboBox x:Name="cmbPayType" Grid.Column="13"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="cmbPayType_SelectionChanged">
                        <ComboBoxItem Content="آجلة"/>
                        <ComboBoxItem Content="نقدية"/>
                        <ComboBoxItem Content="بنك"/>
                    </ComboBox>
                </Grid>

                <!-- الصف الثاني: المستودع + الصندوق + البنك + المندوب + مركز التكلفة -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="المستودع" Style="{StaticResource FieldLabel}"
                               x:Name="lblStore"/>
                    <ComboBox x:Name="cmbStore" Grid.Column="1"
                              Style="{StaticResource ModernComboBox}"/>

                    <TextBlock Grid.Column="3" Text="الصندوق" Style="{StaticResource FieldLabel}"
                               x:Name="lblSfe"/>
                    <ComboBox x:Name="cmbTreasury" Grid.Column="4"
                              Style="{StaticResource ModernComboBox}"/>

                    <TextBlock Grid.Column="6" Text="البنك" Style="{StaticResource FieldLabel}"
                               x:Name="lblBank"/>
                    <ComboBox x:Name="cmbBanks" Grid.Column="7"
                              Style="{StaticResource ModernComboBox}"
                              IsEnabled="False"/>

                    <TextBlock Grid.Column="9" Text="المندوب" Style="{StaticResource FieldLabel}"
                               x:Name="lblSalesMen"/>
                    <ComboBox x:Name="cmbSalesMen" Grid.Column="10"
                              Style="{StaticResource ModernComboBox}"/>
                    <Button x:Name="cmbAddSalesMen" Grid.Column="11"
                            Content="➕" Style="{StaticResource SmallAddBtn}"
                            ToolTip="إضافة مندوب"
                            Click="cmbAddSalesMen_Click"/>

                    <TextBlock Grid.Column="13" Text="مركز التكلفة" Style="{StaticResource FieldLabel}"
                               x:Name="lblCostCenter"/>
                    <ComboBox x:Name="cmbCostCenter" Grid.Column="14"
                              Style="{StaticResource ModernComboBox}"/>
                    <Button x:Name="addCostCenter" Grid.Column="15"
                            Content="➕" Style="{StaticResource SmallAddBtn}"
                            ToolTip="إضافة مركز تكلفة"
                            Click="addCostCenter_Click"/>
                </Grid>

                <!-- الصف الثالث: المورد + الرصيد + البيان -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <!-- نوع الحركة (مخفي) -->
                        <ColumnDefinition Width="0"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="lblClient"
                               Text="اسم المورد" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbClient" Grid.Column="1"
                              Style="{StaticResource ModernComboBox}"
                              IsEditable="True"
                              SelectionChanged="cmbClient_SelectionChanged"
                              KeyDown="cmbClient_KeyDown"/>
                    <Button x:Name="btnCustAdd" Grid.Column="2"
                            Content="➕" Style="{StaticResource SmallAddBtn}"
                            ToolTip="إضافة مورد"
                            Click="btnCustAdd_Click"/>

                    <TextBlock Grid.Column="4" Text="الرصيد" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtBalance" Grid.Column="5"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True" TextAlignment="Center"/>

                    <TextBlock Grid.Column="7" x:Name="lblNote"
                               Text="البيان" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtNote" Grid.Column="8"
                             Style="{StaticResource ModernTextBox}"
                             TextAlignment="Center"/>

                    <!-- إدراج مرتجع (مخفي افتراضياً) -->
                    <Button x:Name="btnInsertLinkedInv" Grid.Column="10"
                            Content="إدراج" Style="{StaticResource ActionBtn}"
                            Visibility="Collapsed"
                            Click="btnInsertLinkedInv_Click"/>

                    <!-- نوع الحركة مخفي -->
                    <ComboBox x:Name="cmbProcType" Grid.Column="10"
                              Visibility="Collapsed" IsEnabled="False">
                        <ComboBoxItem Content="فاتورة"/>
                        <ComboBoxItem Content="مرتجع فاتورة"/>
                        <ComboBoxItem Content="أصناف أول المدة"/>
                    </ComboBox>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             Row 1: Panel4 - شريط أدوات الجدول (باركود + بحث + راديو)
             ══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#EEF1FA"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- GroupBox2: بدون ضريبة -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <!-- GroupBox1: عادي / تلقائي -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <!-- زر إضافة مادة -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <!-- الباركود -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <!-- بحث داخل الجدول -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- بدون ضريبة -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="6" Padding="8,4"
                        Background="White">
                    <CheckBox x:Name="ckZeroVAT" Content="بدون ضريبة"
                              FontWeight="Bold" FontSize="11"
                              Checked="ckZeroVAT_CheckedChanged"
                              Unchecked="ckZeroVAT_CheckedChanged"/>
                </Border>

                <!-- عادي / تلقائي -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="6" Padding="8,4"
                        Background="White">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rdNormal" Content="عادي"
                                     IsChecked="True" FontWeight="Bold"
                                     FontSize="11" Margin="0,0,10,0"/>
                        <RadioButton x:Name="rdAuto" Content="تلقائي"
                                     FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- زر إضافة مادة جديدة -->
                <Button x:Name="btnAddNewItem" Grid.Column="4"
                        Content="➕ مادة جديدة"
                        Style="{StaticResource SaveBtn}"
                        Height="30" Padding="8,0"
                        Click="btnAddNewItem_Click"/>

                <!-- الباركود -->
                <TextBlock Grid.Column="6" x:Name="lblBarcode"
                           Text="🔍 الباركود" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtBarcode" Grid.Column="7"
                         Style="{StaticResource ModernTextBox}"
                         TextAlignment="Center"
                         KeyDown="txtBarcode_KeyDown"/>

                <!-- بحث داخل الجدول -->
                <TextBlock Grid.Column="9" Text="🔍 بحث في الجدول"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtSrchDgv" Grid.Column="10"
                         Style="{StaticResource ModernTextBox}"
                         KeyDown="txtSrchDgv_KeyDown"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             Row 2: TabControl - الفاتورة / البحث
             ══════════════════════════════════════════ -->
        <TabControl x:Name="TabControl1" Grid.Row="2"
                    Background="#F3F5F9"
                    FontFamily="Cairo, Tahoma, Arial"
                    FontSize="12" FontWeight="Bold">

            <!-- ─── Tab 1: الفاتورة ─── -->
            <TabItem Header="          🧾 الفاتورة          ">
                <Border Background="White" Margin="4,4,4,0"
                        CornerRadius="8" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header جدول الأصناف -->
                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderBrush}"
                                CornerRadius="8,8,0,0">
                            <Grid>
                                <TextBlock Text="📦 بنود الفاتورة"
                                           Foreground="White" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="14,0"/>
                                <!-- Context Menu بديل كزر -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0">
                                    <Button Content="⋮ خيارات" Style="{StaticResource ActionBtn}"
                                            Height="28" FontSize="10" Padding="6,0"
                                            Click="btnItemOptions_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid الأصناف -->
                        <DataGrid x:Name="dgvItems"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                  RowStyle="{StaticResource DgvRow}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  FlowDirection="RightToLeft"
                                  Background="White"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E8EBF5"
                                  AlternatingRowBackground="#F8F9FD"
                                  CellEditEnding="dgvItems_CellEditEnding"
                                  CurrentCellChanged="dgvItems_CurrentCellChanged"
                                  MouseLeftButtonUp="dgvItems_MouseLeftButtonUp"
                                  PreparingCellForEdit="dgvItems_PreparingCellForEdit"
                                  SelectionChanged="dgvItems_SelectionChanged">
                            <DataGrid.Columns>

                                <!-- 0: # -->
                                <DataGridTextColumn Header="#" Width="35"
                                                    Binding="{Binding RowNo}"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 1: رمز المادة (ItemCode) -->
                                <DataGridTextColumn Header="رمز المادة" Width="80"
                                                    Binding="{Binding ItemCode}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 2: رقم الصنف (ItemId) - مخفي -->
                                <DataGridTextColumn Header="رقم الصنف" Width="60"
                                                    Binding="{Binding ItemId}"
                                                    Visibility="Collapsed"/>

                                <!-- 3: الصنف (ItemName) -->
                                <DataGridTextColumn Header="📦 الصنف" Width="*"
                                                    Binding="{Binding ItemName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 4: الوصف (Column2) -->
                                <DataGridTextColumn Header="الوصف" Width="80"
                                                    Binding="{Binding Description}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 5: الباركود (barcodeDgv) - مخفي -->
                                <DataGridTextColumn Header="الباركود" Width="80"
                                                    Binding="{Binding Barcode}"
                                                    Visibility="Collapsed"/>

                                <!-- 6: الوحدة (cmbUnitDgv) -->
                                <DataGridTextColumn Header="الوحدة" Width="80"
                                                    Binding="{Binding UnitName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 7: الكمية (QuantDgv) -->
                                <DataGridTextColumn Header="الكمية" Width="60"
                                                    Binding="{Binding Quantity}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 8: التعادل (PercentUnitDgv) - مخفي -->
                                <DataGridTextColumn Header="التعادل" Width="50"
                                                    Binding="{Binding UnitEquality}"
                                                    Visibility="Collapsed"/>

                                <!-- 9: إجمالي الكمية (totQuantDgv) - مخفي -->
                                <DataGridTextColumn Header="إجمالي الكمية" Width="60"
                                                    Binding="{Binding PrimaryQnty}"
                                                    Visibility="Collapsed"/>

                                <!-- 10: السعر (priceDgv) -->
                                <DataGridTextColumn Header="السعر" Width="70"
                                                    Binding="{Binding Price}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 11: المجموع (SumPriceDgv) -->
                                <DataGridTextColumn Header="المجموع" Width="80"
                                                    Binding="{Binding SumPrice}"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 12: متوسط التكلفة (AvrgCost) - مخفي -->
                                <DataGridTextColumn Header="تكلفة" Width="70"
                                                    Binding="{Binding AvrgCost}"
                                                    Visibility="Collapsed"/>

                                <!-- 13: الخصم (discountValDgv) -->
                                <DataGridTextColumn Header="الخصم" Width="70"
                                                    Binding="{Binding ItemDiscount}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 14: نسبة الخصم (discountPerDgv) - مخفي -->
                                <DataGridTextColumn Header="نسبة الخصم" Width="70"
                                                    Binding="{Binding DiscountPerc}"
                                                    Visibility="Collapsed"/>

                                <!-- 15: الإجمالي (totPriceDgv) -->
                                <DataGridTextColumn Header="الإجمالي" Width="80"
                                                    Binding="{Binding TotalPrice}"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 16: نسبة الضريبة (VatPerDgv) - مخفي -->
                                <DataGridTextColumn Header="نسبة الضريبة" Width="60"
                                                    Binding="{Binding VatPerc}"
                                                    Visibility="Collapsed"/>

                                <!-- 17: الضريبة (VATValDgv) - مخفي -->
                                <DataGridTextColumn Header="الضريبة" Width="60"
                                                    Binding="{Binding VatValue}"
                                                    Visibility="Collapsed"/>

                                <!-- 18: الصافي (NetValDgv) -->
                                <DataGridTextColumn Header="الصافي" Width="80"
                                                    Binding="{Binding NetValue}"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 19: الكمية الحالية (StockDgv) - مخفي -->
                                <DataGridTextColumn Header="الكمية الحالية" Width="70"
                                                    Binding="{Binding Stock}"
                                                    Visibility="Collapsed"/>

                                <!-- 20: المستودع (StoreDgv) -->
                                <DataGridTextColumn Header="المستودع" Width="100"
                                                    Binding="{Binding StoreId}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 21: حذف - زر -->
                                <DataGridTemplateColumn Header="🗑️" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="14"
                                                    Tag="{Binding}"
                                                    Click="DeleteRow_Click"
                                                    ToolTip="حذف البند"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                            <!-- Context Menu -->
                            <DataGrid.ContextMenu>
                                <ContextMenu FlowDirection="RightToLeft">
                                    <MenuItem x:Name="StripItemSearch"
                                              Header="🔍 بحث مادة"
                                              Click="StripItemSearch_Click"/>
                                    <MenuItem x:Name="StripItemDetail"
                                              Header="📋 استعراض المادة"
                                              Click="StripItemDetail_Click"/>
                                    <MenuItem x:Name="StripAddNewItem"
                                              Header="➕ إضافة مادة"
                                              Click="StripAddNewItem_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="StripItemUnits"
                                              Header="📐 الوحدات"
                                              Click="StripItemUnits_Click"/>
                                    <MenuItem x:Name="StripAddGroup"
                                              Header="📁 إضافة مجموعة"
                                              Click="StripAddGroup_Click"/>
                                    <MenuItem x:Name="StripSerialNo"
                                              Header="🔢 الأرقام التسلسلية"
                                              Click="StripSerialNo_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="StripdeleteRow"
                                              Header="🗑️ حذف السجل"
                                              Click="StripdeleteRow_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="StripItemProcess"
                                              Header="📊 حركة المادة"
                                              Click="StripItemProcess_Click"/>
                                    <MenuItem x:Name="StripLastItem"
                                              Header="🔄 آخر حركة للمادة"
                                              Click="StripLastItem_Click"/>
                                    <MenuItem x:Name="StripClientLastItem"
                                              Header="🔄 آخر حركة للعميل"
                                              Click="StripClientLastItem_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="StripItemAvrgCost"
                                              Header="💰 تكلفة المادة"
                                              Click="StripItemAvrgCost_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="btnCustomizeDisplay"
                                              Header="🎨 تخصيص المظهر"
                                              Click="btnCustomizeDisplay_Click"/>
                                    <MenuItem x:Name="stripImport"
                                              Header="📥 استيراد"
                                              Click="stripImport_Click"/>
                                    <MenuItem x:Name="stripExport"
                                              Header="📤 تصدير"
                                              Click="stripExport_Click"/>
                                    <MenuItem x:Name="BtnShowEntry"
                                              Header="📖 عرض القيد"
                                              Click="BtnShowEntry_Click"/>
                                    <MenuItem x:Name="btnShortCutInv"
                                              Header="⚡ اختصار فاتورة"
                                              Click="btnShortCutInv_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ─── Tab 2: البحث ─── -->
            <TabItem Header="          🔍 البحث          ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- GroupBox6: شروط البحث -->
                    <Border Grid.Row="0"
                            Background="White" Margin="6,6,6,4"
                            CornerRadius="8" Effect="{StaticResource CardShadow}">
                        <StackPanel Margin="10,8">
                            <Border Background="{StaticResource HeaderBrush}"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                <TextBlock Text="🔍 شروط البحث"
                                           Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="رقم الفاتورة"
                                           Style="{StaticResource FieldLabel}"
                                           x:Name="Label11"/>
                                <TextBox x:Name="txtSrchNo" Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         TextAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="رقم المرجع"
                                           Style="{StaticResource FieldLabel}"
                                           x:Name="Label15"/>
                                <TextBox x:Name="txtSrchreffNo" Grid.Column="4"
                                         Style="{StaticResource ModernTextBox}"/>

                                <TextBlock Grid.Column="6" Text="من تاريخ"
                                           Style="{StaticResource FieldLabel}"
                                           x:Name="Label1"/>
                                <dxe:DateEdit x:Name="txtFromDate" Grid.Column="7"
                                              Height="30" FontSize="12" FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="9" Text="إلى تاريخ"
                                           Style="{StaticResource FieldLabel}"
                                           x:Name="Label2"/>
                                <dxe:DateEdit x:Name="txtToDate" Grid.Column="10"
                                              Height="30" FontSize="12" FontWeight="SemiBold"/>

                                <StackPanel Grid.Column="12" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="chkAll" Content="الكل"
                                              IsChecked="True" FontWeight="Bold"
                                              Margin="0,0,8,0"
                                              Checked="chkAll_CheckedChanged"
                                              Unchecked="chkAll_CheckedChanged"/>
                                    <TextBlock x:Name="lblClientSrch"
                                               Text="العميل" Style="{StaticResource FieldLabel}"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbClientSrch" Grid.Column="13"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True" IsEnabled="False"/>

                                <Button x:Name="btnSearch" Grid.Column="15"
                                        Content="🔍 بحث"
                                        Style="{StaticResource ActionBtn}"
                                        Width="90" Height="34"
                                        Click="btnSearch_Click"/>
                            </Grid>

                            <!-- نوع الحركة للبحث (مخفي) -->
                            <ComboBox x:Name="cmbProcTypeSrch"
                                      Visibility="Collapsed" IsEnabled="False">
                                <ComboBoxItem Content="فاتورة مبيعات ومشتريات"/>
                                <ComboBoxItem Content="مرتجع فاتورة"/>
                                <ComboBoxItem Content="أصناف أول المدة"/>
                                <ComboBoxItem Content="عرض سعر"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- GroupBox4: نتائج البحث -->
                    <Border Grid.Row="1"
                            Background="White" Margin="6,0,6,6"
                            CornerRadius="8" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource HeaderBrush}"
                                    CornerRadius="8,8,0,0">
                                <TextBlock Text="📋 نتائج البحث"
                                           Foreground="White" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="14,0"/>
                            </Border>

                            <DataGrid x:Name="dgvSrch"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      ColumnHeaderStyle="{StaticResource DgvColHeader}"
                                      RowStyle="{StaticResource DgvRow}"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FlowDirection="RightToLeft"
                                      Background="White"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E8EBF5"
                                      AlternatingRowBackground="#F8F9FD"
                                      MouseLeftButtonUp="dgvSrch_MouseLeftButtonUp">
                                <DataGrid.Columns>
                                    <!-- Column10: رقم الحركة - مخفي -->
                                    <DataGridTextColumn Header="رقم الحركة"
                                                        Binding="{Binding InvGlobalID}"
                                                        Visibility="Collapsed"/>
                                    <!-- DataGridViewTextBoxColumn1: الرقم -->
                                    <DataGridTextColumn Header="الرقم" Width="80"
                                                        Binding="{Binding InvNo}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Column4: رقم المرجع -->
                                    <DataGridTextColumn Header="رقم المرجع" Width="120"
                                                        Binding="{Binding ReffNo}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Column3: التاريخ -->
                                    <DataGridTextColumn Header="📅 التاريخ" Width="120"
                                                        Binding="{Binding InvDate}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}"/>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Column1: العميل -->
                                    <DataGridTextColumn Header="👤 العميل/المورد" Width="*"
                                                        Binding="{Binding ClientName}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="4,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════
             Row 3: GroupBox9 - تفاصيل الصنف + المجاميع
             ══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,1,0,1"
                Effect="{StaticResource CardShadow}">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <!-- Panel1: المجاميع -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <!-- معلومات الصنف -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <!-- معلومات إضافية -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <!-- صورة QR + إحصائيات -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ─── Panel1: المجاميع ─── -->
                <Border Grid.Column="0" Width="310">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <!-- المجموع -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="المجموع :" Style="{StaticResource SummaryLabel}"
                                   x:Name="lblTotSale" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtSumVal" Grid.Row="0" Grid.Column="0"
                                 Style="{StaticResource SummaryValue}"
                                 Text="0" FontSize="13" Foreground="#1B2642"
                                 Margin="0,0,4,2"/>

                        <!-- الخصم -->
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="الخصم :" Style="{StaticResource SummaryLabel}"
                                   Foreground="#B92F2F" Margin="0,0,0,2"/>
                        <TextBox x:Name="txtTotDiscount" Grid.Row="1" Grid.Column="0"
                                 Style="{StaticResource SummaryValue}"
                                 Text="0" Foreground="#B92F2F" Margin="0,0,4,2"/>

                        <!-- الإجمالي بدون ضريبة -->
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   x:Name="Label4"
                                   Text="الإجمالي :" Style="{StaticResource SummaryLabel}"
                                   Margin="0,0,0,2"/>
                        <TextBox x:Name="txtNetWithoutVAT" Grid.Row="2" Grid.Column="0"
                                 Style="{StaticResource SummaryValue}"
                                 Text="0" Margin="0,0,4,2"/>

                        <!-- الضريبة -->
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   x:Name="Label30"
                                   Text="الضريبة :" Style="{StaticResource SummaryLabel}"
                                   Margin="0,0,0,2"/>
                        <TextBox x:Name="txtTotVAT" Grid.Row="3" Grid.Column="0"
                                 Style="{StaticResource SummaryValue}"
                                 Text="0" Margin="0,0,4,2"/>

                        <!-- الصافي -->
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   x:Name="Label20"
                                   Text="الصافي :" Style="{StaticResource SummaryLabel}"
                                   FontSize="12" Foreground="#1B2642" Margin="0,0,0,0"/>
                        <TextBox x:Name="txtNet" Grid.Row="4" Grid.Column="0"
                                 Style="{StaticResource SummaryValue}"
                                 Text="0" FontSize="15" FontWeight="Bold"
                                 Foreground="#213A7A" Margin="0,0,4,0"
                                 MouseDoubleClick="txtNet_DoubleClick"/>
                    </Grid>
                </Border>

                <!-- ─── معلومات الصنف المحدد ─── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- الصف 1: خصم الفاتورة + نسبة الخصم -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="خصم الفاتورة" Style="{StaticResource FieldLabel}"
                                   x:Name="Label8" Foreground="#B92F2F"/>
                        <TextBox x:Name="txtInvDiscPerc" Width="60"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="0" TextAlignment="Center"
                                 Margin="0,0,4,0"
                                 LostFocus="txtInvDiscPerc_LostFocus"
                                 KeyDown="txtInvDiscPerc_KeyDown"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        <TextBlock Text="%" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="#B92F2F"
                                   Margin="0,0,8,0"
                                   x:Name="Label39"/>
                        <TextBlock Text="=" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="#B92F2F"
                                   Margin="0,0,8,0"
                                   x:Name="Label42"/>
                        <TextBox x:Name="txtInvDiscVal" Width="80"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="0" TextAlignment="Center"
                                 LostFocus="txtInvDiscVal_LostFocus"
                                 KeyDown="txtInvDiscVal_KeyDown"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>

                    <!-- الصف 2: ضريبة الفاتورة (مخفية) + إجمالي الكمية + عدد البنود -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="lblRowsCount" Text="عدد البنود :"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtTirmsNo" Width="60"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"
                                 Margin="0,0,12,0"/>

                        <TextBlock x:Name="lblTotQty" Text="إجمالي الكمية :"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtTotQuan" Width="80"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>

                        <!-- مخفي: ضريبة فاتورة -->
                        <TextBox x:Name="txtInvTax" Width="80"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"
                                 Visibility="Collapsed"/>
                        <TextBox x:Name="txtInvTaxPer" Width="60"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"
                                 Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- الصف 3: معلومات الصنف المحدد -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <!-- آخر سعر بيع -->
                        <TextBlock Grid.Column="0" x:Name="lblLastSale"
                                   Text="آخر سعر بيع :" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtLastSalePrice" Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>

                        <!-- سعر المنافس -->
                        <TextBlock Grid.Column="3"
                                   Text="سعر المنافس :" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCompetitorPrice" Grid.Column="4"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>

                        <!-- باركود الصنف -->
                        <TextBlock Grid.Column="6"
                                   Text="باركود :" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtItemBarcode" Grid.Column="7"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>

                        <!-- متوسط التكلفة -->
                        <TextBlock Grid.Column="9"
                                   Text="متوسط التكلفة :" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCostAvrg" Grid.Column="10"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ─── معلومات إضافية: مخزون + تعادل + سعر شراء أخير ─── -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <!-- الكمية الحالية -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="lblCurrentqty" Text="الكمية الحالية :"
                                   Style="{StaticResource FieldLabel}" Width="90"/>
                        <TextBox x:Name="txtStock" Width="90"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>
                    </StackPanel>
                    <!-- التعادل -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="lblEqlUnit" Text="التعادل :"
                                   Style="{StaticResource FieldLabel}" Width="90"/>
                        <TextBox x:Name="txtPerUnit" Width="90"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>
                    </StackPanel>
                    <!-- كمية و/س -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="lblQtyPrice" Text="كمية و/س :"
                                   Style="{StaticResource FieldLabel}" Width="90"/>
                        <TextBox x:Name="txtTotUnitQuan" Width="90"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>
                    </StackPanel>
                    <!-- آخر سعر شراء -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="آخر سعر شراء :"
                                   Style="{StaticResource FieldLabel}" Width="90"/>
                        <TextBox x:Name="txtRecentPurchPrice" Width="90"
                                 Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- ─── QR Code / صورة ─── -->
                <Border Grid.Column="6"
                        BorderBrush="{StaticResource BorderLight}"
                        BorderThickness="1" CornerRadius="6"
                        Width="130" Height="100"
                        Background="#F5F7FA">
                    <Image x:Name="PictureBox1"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             Row 4: Footer - أزرار التحكم
             ══════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource FooterBrush}"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- أزرار التنقل + إغلاق -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- فاصل -->
                    <ColumnDefinition Width="*"/>
                    <!-- بحث فاتورة + عمليات رئيسية -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ─── يسار: إغلاق + تنقل ─── -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnClose" Content="✖"
                            Style="{StaticResource DangerBtn}"
                            Width="40" ToolTip="خروج"
                            Margin="0,0,6,0"
                            Click="btnClose_Click"/>
                    <Button x:Name="btnFirst" Content="⏮"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأول"
                            Margin="0,0,3,0"
                            Click="btnFirst_Click"/>
                    <Button x:Name="btnPrevious" Content="◀"
                            Style="{StaticResource NavBtn}"
                            ToolTip="السابق"
                            Margin="0,0,3,0"
                            Click="btnPrevious_Click"/>
                    <Button x:Name="btnNext" Content="▶"
                            Style="{StaticResource NavBtn}"
                            ToolTip="التالي"
                            Margin="0,0,3,0"
                            Click="btnNext_Click"/>
                    <Button x:Name="btnLast" Content="⏭"
                            Style="{StaticResource NavBtn}"
                            ToolTip="الأخير"
                            Margin="0,0,8,0"
                            Click="btnLast_Click"/>

                    <!-- بحث فاتورة -->
                    <Button x:Name="btnInvSrch" Content="🔍"
                            Style="{StaticResource ActionBtn}"
                            Width="40" ToolTip="بحث فاتورة"
                            Click="btnInvSrch_Click"/>

                    <!-- سند قبض (مخفي افتراضياً) -->
                    <Button x:Name="BtnReceipts" Content="📄 سند قبض"
                            Style="{StaticResource InfoBtn}"
                            Margin="6,0,0,0"
                            Visibility="Collapsed"
                            Click="BtnReceipts_Click"/>

                    <!-- TextBox1 مخفي -->
                    <TextBox x:Name="TextBox1"
                             Visibility="Collapsed" Width="90"
                             IsReadOnly="True" TextAlignment="Center"/>
                </StackPanel>

                <!-- ─── يمين: أزرار العمليات ─── -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnDelete" Content="🗑️ حذف"
                            Style="{StaticResource DangerBtn}"
                            Width="80" Margin="0,0,4,0"
                            Click="btnDelete_Click"/>
                    <Button x:Name="btnPrint" Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="80" Margin="0,0,4,0"
                            Click="btnPrint_Click"/>
                    <Button x:Name="btnView" Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="80" Margin="0,0,4,0"
                            Click="btnView_Click"/>
                    <Button x:Name="btnSave" Content="💾 حفظ"
                            Style="{StaticResource SaveBtn}"
                            Width="80" Margin="0,0,4,0"
                            Click="btnSave_Click"/>
                    <Button x:Name="btnSavePrint" Content="🖨️ حفظ مع طباعة"
                            Style="{StaticResource SaveBtn}"
                            Width="130" Margin="0,0,4,0"
                            Click="btnSavePrint_Click"/>
                    <Button x:Name="btnNew" Content="➕ جديد"
                            Style="{StaticResource ActionBtn}"
                            Width="80"
                            Click="btnNew_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>