<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmCustAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="أرصدة حساب العملاء"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>

        <!-- ═══════ Brushes ═══════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ShowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1B2642"/>
        <SolidColorBrush x:Key="SidePanelBg" Color="#F5F7FC"/>

        <!-- ═══════ Effects ═══════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.14"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══════ TextBox Style ═══════ -->
        <Style x:Key="ModernTxt" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B7BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ ComboBox Style ═══════ -->
        <Style x:Key="ModernCmb" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══════ CheckBox Style ═══════ -->
        <Style x:Key="ModernChk" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══════ Label Style ═══════ -->
        <Style x:Key="FieldLbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ═══════ Button Style ═══════ -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ShowBrush}"/>
            <Setter Property="Height" Value="44"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#27AE60" Offset="0"/>
                        <GradientStop Color="#1B7A44" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!--           Main Content Area               -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- GroupBox1 - Filter Panel -->
                <ColumnDefinition Width="250"/>
                <!-- Splitter -->
                <ColumnDefinition Width="6"/>
                <!-- GroupBox2 - Grid Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ GroupBox1 - Filter Side Panel ═══ -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidePanelBg}"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,1,0"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            Padding="12,10">
                        <TextBlock Text="🔍 خيارات البحث"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Filter Controls -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,10">
                        <StackPanel>

                            <!-- العميل / المورد -->
                            <Border Background="#EEF3FF"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="LblAcc"
                                               Text="👤 اسم العميل"
                                               Style="{StaticResource FieldLbl}"
                                               Margin="0,0,0,6"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <CheckBox x:Name="chkAll"
                                                  Content="الكل"
                                                  Style="{StaticResource ModernChk}"
                                                  IsChecked="True"
                                                  Checked="chkAll_CheckedChanged"
                                                  Unchecked="chkAll_CheckedChanged"/>
                                    </StackPanel>

                                    <ComboBox x:Name="cmbClients"
                                              Style="{StaticResource ModernCmb}"
                                              IsEnabled="False"
                                              IsEditable="True"
                                              PreviewMouseLeftButtonDown="cmbClients_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- المندوب -->
                            <Border Background="#EEF3FF"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <CheckBox x:Name="chkSalesman"
                                                  Content="🤝 كل المندوبين"
                                                  Style="{StaticResource ModernChk}"
                                                  IsChecked="True"
                                                  Checked="chkSalesman_CheckedChanged"
                                                  Unchecked="chkSalesman_CheckedChanged"/>
                                    </StackPanel>

                                    <ComboBox x:Name="cmbSalesman"
                                              Style="{StaticResource ModernCmb}"
                                              IsEnabled="False"/>
                                </StackPanel>
                            </Border>

                            <!-- الفترة الزمنية -->
                            <Border Background="#FFF8EE"
                                    CornerRadius="8"
                                    BorderBrush="#FFD080"
                                    BorderThickness="1"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="ckTotalPeriod"
                                              Content="📅 فترة كاملة"
                                              Style="{StaticResource ModernChk}"
                                              IsChecked="True"
                                              Checked="ckTotalPeriod_CheckedChanged"
                                              Unchecked="ckTotalPeriod_CheckedChanged"
                                              Margin="0,0,0,8"/>

                                    <TextBlock Text="من"
                                               Style="{StaticResource FieldLbl}"
                                               Margin="0,0,0,3"/>
                                    <DatePicker x:Name="txtDateFrom"
                                                Height="32"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                FlowDirection="LeftToRight"
                                                IsEnabled="False"
                                                Margin="0,0,0,8"/>

                                    <TextBlock Text="إلى"
                                               Style="{StaticResource FieldLbl}"
                                               Margin="0,0,0,3"/>
                                    <DatePicker x:Name="txtDateTo"
                                                Height="32"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                FlowDirection="LeftToRight"
                                                IsEnabled="False"/>
                                </StackPanel>
                            </Border>

                            <!-- زر العرض -->
                            <Button x:Name="btnShow"
                                    Content="🔍 عرض النتائج"
                                    Style="{StaticResource ShowBtn}"
                                    FontSize="14"
                                    Margin="0,4,0,0"
                                    Click="btnShow_Click"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ Splitter ═══ -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderLight}"
                          ShowsPreview="True"/>

            <!-- ═══ GroupBox2 - Grid Area ═══ -->
            <Border Grid.Column="2"
                    Background="White"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Grid Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="10,10,0,0"
                            Padding="14,10">
                        <TextBlock Text="📊 أرصدة وحسابات العملاء"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- ProgressBar -->
                    <ProgressBar x:Name="ProgressBar1"
                                 Grid.Row="0"
                                 Height="6"
                                 VerticalAlignment="Bottom"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#3A63C3"
                                 Background="Transparent"/>

                    <!-- DevExpress GridControl -->
                    <dxg:GridControl x:Name="GridControl1"
                 AutoGenerateColumns="None">

                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem SummaryType="Sum"
                             FieldName="DgvDebit"
                             DisplayFormat="مدين: {0:n2}"/>
                            <dxg:GridSummaryItem SummaryType="Sum"
                             FieldName="DgvCredit"
                             DisplayFormat="دائن: {0:n2}"/>
                            <dxg:GridSummaryItem SummaryType="Sum"
                             FieldName="DgvBalance"
                             DisplayFormat="الرصيد: {0:n2}"/>
                        </dxg:GridControl.TotalSummary>

                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="GridView1"
                       ShowGroupPanel="False"
                       AutoWidth="True"
                       AllowEditing="False"
                       NavigationStyle="Row"
                       AllowPerPixelScrolling="True"
                       RowMinHeight="30"/>
                        </dxg:GridControl.View>

                        <dxg:GridControl.Columns>
                            <!-- الأعمدة بدون SummaryItem -->
                            <dxg:GridColumn FieldName="DgvNo"
                        Header="#"
                        Width="50"
                        AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn x:Name="DgvAccCode"
                        FieldName="DgvAccCode"
                        Header="🔢 رقم الحساب"
                        Width="110"
                        AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn x:Name="DgvAccName"
                        FieldName="DgvAccName"
                        Header="👤 اسم العميل"
                        Width="180"
                        AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn x:Name="DgvDebit"
                        FieldName="DgvDebit"
                        Header="💸 حركة مدين"
                        Width="110"
                        AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                      DisplayFormat="n2"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn x:Name="DgvCredit"
                        FieldName="DgvCredit"
                        Header="💰 حركة دائن"
                        Width="110"
                        AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                      DisplayFormat="n2"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn x:Name="DgvBalance"
                        FieldName="DgvBalance"
                        Header="⚖️ الرصيد"
                        Width="110"
                        AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"
                                      DisplayFormat="n2"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn FieldName="DgvStatus"
                        Header="📌 الحالة"
                        Width="90"
                        AllowEditing="False">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                        </dxg:GridControl.Columns>

                    </dxg:GridControl>
                    <!-- Footer Status Bar -->
                    <Border Grid.Row="2"
                            Background="#EEF3FF"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,1,0,0"
                            Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="📊 ملخص النتائج"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    Background="#213A7A"
                                    CornerRadius="8"
                                    Padding="14,4">
                                <TextBlock x:Name="txtSumState"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!--           GroupBox4 - Footer Buttons       -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="12,8"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- زر الخروج -->
                <Button Grid.Column="0"
                        x:Name="btnClose"
                        Content="✖ خروج"
                        Style="{StaticResource DangerBtn}"
                        Width="100"
                        Click="btnClose_Click"/>

                <!-- Spacer -->
                <Grid Grid.Column="1"/>

                <!-- أزرار التقرير -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            Width="120"
                            Margin="0,0,8,0"
                            Click="btnExport_Click"/>
                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="100"
                            Margin="0,0,8,0"
                            Click="btnPreview_Click"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource ActionBtn}"
                            Width="100"
                            Click="btnPrint_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>