<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmGlasses"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="👓 بيانات النظارات"
    Width="480" Height="300"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    ResizeMode="NoResize"
    ShowIcon="False"
    FontFamily="Cairo, Tahoma, Arial"
    Background="#F3F5F9"
    Loaded="frmGlasses_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NewBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#4338CA" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="5" ShadowDepth="1"
                          Direction="270" Opacity="0.18"
                          Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GlassTextBox" TargetType="dxe:TextEdit">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Cairo, Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="14,0">
            <TextBlock Text="👓 بيانات النظارات"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <TabControl x:Name="TabControl1"
                    Grid.Row="1"
                    Margin="6,6,6,4"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1">

            <TabItem x:Name="TabPage1"
                     Header="👓  القياسات"
                     Style="{StaticResource TabHeaderStyle}">
                <Border Background="White"
                        CornerRadius="0,0,8,8"
                        Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#E8EAF6" CornerRadius="4"
                                Padding="6,3" Margin="0,0,0,4">
                            <TextBlock Text="🔴 العين اليمنى (RE)"
                                       Style="{StaticResource FieldLabel}"
                                       Foreground="#283593"/>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2"
                                Background="#E8F5E9" CornerRadius="4"
                                Padding="6,3" Margin="0,0,0,4">
                            <TextBlock Text="🟢 العين اليسرى (LE)"
                                       Style="{StaticResource FieldLabel}"
                                       Foreground="#1B5E20"/>
                        </Border>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblReSPHText"
                                       Grid.Column="0" Text="RE-SPH"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtReSPH"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblLeSphText"
                                       Grid.Column="0" Text="LE-SPH"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtLeSph"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblReCYLText"
                                       Grid.Column="0" Text="RE-CYL"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtReCYL"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblLeCylText"
                                       Grid.Column="0" Text="LE-CYL"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtLeCyl"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblReAxText"
                                       Grid.Column="0" Text="RE-AX"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtReAx"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblLeAxText"
                                       Grid.Column="0" Text="LE-AX"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtLeAx"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="4" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblReAddText"
                                       Grid.Column="0" Text="RE-ADD"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtReAdd"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="4" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblLeAddText"
                                       Grid.Column="0" Text="LE-ADD"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtLeAdd"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="5" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblReIpdText"
                                       Grid.Column="0" Text="RE-IPD"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtReIpd"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>

                        <Grid Grid.Row="5" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="lblLeIpdText"
                                       Grid.Column="0" Text="LE-IPD"
                                       Style="{StaticResource FieldLabel}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <dxe:TextEdit x:Name="txtLeIpd"
                                          Grid.Column="1"
                                          Style="{StaticResource GlassTextBox}"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem x:Name="TabPage2"
                     Header="⚙  أسماء الحقول"
                     Style="{StaticResource TabHeaderStyle}">
                <Border Background="White"
                        CornerRadius="0,0,8,8"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#E8EAF6" CornerRadius="4"
                                Padding="4,2" Margin="0,0,0,6">
                            <TextBlock Text="R (Right)" FontSize="11"
                                       FontWeight="Bold" Foreground="#283593"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="#E8F5E9" CornerRadius="4"
                                Padding="4,2" Margin="0,0,0,6">
                            <TextBlock Text="L (Left)" FontSize="11"
                                       FontWeight="Bold" Foreground="#1B5E20"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 1"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR1" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 6"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR6" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 2"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR2" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 7"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR7" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 3"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR3" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 8"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR8" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="4" Grid.Column="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 4"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR4" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="4" Grid.Column="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 9"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR9" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="5" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 5"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR5" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Grid.Row="5" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="حقل 10"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <TextBox x:Name="txtR10" Grid.Column="1"
                                     Height="28" FontSize="11"
                                     Padding="4,0"
                                     VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose"
                        Grid.Column="0"
                        Content="✖ خروج"
                        Background="{StaticResource DangerBrush}"
                        Style="{StaticResource ActionBtn}"
                        Width="88"
                        Click="btnClose_Click"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button x:Name="BtnSaveinsert"
                            Content="💾 حفظ الأسماء"
                            Background="#FF6F00"
                            Style="{StaticResource ActionBtn}"
                            Width="120"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="BtnSaveinsert_Click"/>

                    <Button x:Name="btnNew"
                            Content="🔄 جديد"
                            Background="{StaticResource NewBrush}"
                            Style="{StaticResource ActionBtn}"
                            Width="88"
                            Margin="0,0,6,0"
                            Click="btnNew_Click"/>

                    <Button x:Name="btnSave"
                            Content="✔ إدراج"
                            Background="{StaticResource SaveBrush}"
                            Style="{StaticResource ActionBtn}"
                            Width="88"
                            Click="btnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>