<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmMezanMorg3a"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="ميزان المراجعة رئيسي خلال فترة"
        Width="1400"
Height="730"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    Loaded="frmMezanMorg3a_Load">

    <dx:ThemedWindow.Resources>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ExportBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#28A745" Offset="0"/>
            <GradientStop Color="#1C7C31" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F7CF7" Offset="0"/>
            <GradientStop Color="#305EDB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ViewBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5A623" Offset="0"/>
            <GradientStop Color="#D98B10" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.13" Color="#000000"/>
        <DropShadowEffect x:Key="BtnShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.18" Color="#000000"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ActionBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ExportBrush}"/>
        </Style>

        <Style x:Key="ViewBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource ViewBrush}"/>
        </Style>

        <Style x:Key="LvlBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#5A6A99"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCE7FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="14,10">
            <TextBlock x:Name="lblHeader" Text="📊 ميزان المراجعة رئيسي خلال فترة" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>

                        <Border Background="{StaticResource HeaderBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <TextBlock Text="⚙️ خيارات العرض" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="📊 مستوى العرض" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Button x:Name="btnLvl1" Content="المستوى 1" Style="{StaticResource LvlBtn}" Click="btnLvl1_Click"/>
                            <Button x:Name="btnLvl2" Content="المستوى 2" Style="{StaticResource LvlBtn}" Click="btnLvl2_Click"/>
                            <Button x:Name="btnlvl3" Content="المستوى 3" Style="{StaticResource LvlBtn}" Click="btnlvl3_Click"/>
                            <Button x:Name="btnlvl4" Content="المستوى 4" Style="{StaticResource LvlBtn}" Click="btnlvl4_Click"/>
                        </UniformGrid>

                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📅 الفترة" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox x:Name="chkAll" Grid.Column="1" Content="كل الفترة" IsChecked="True" Style="{StaticResource ModernCheckBox}" Checked="chkAll_CheckedChanged" Unchecked="chkAll_CheckedChanged"/>
                                </Grid>
                                <TextBlock Text="من" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="txtDateFrom" Style="{StaticResource ModernDatePicker}" IsEnabled="False" SelectedDateFormat="Short" Margin="0,0,0,6"/>
                                <TextBlock Text="إلى" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="txtDateTo" Style="{StaticResource ModernDatePicker}" IsEnabled="False" SelectedDateFormat="Short"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏢 الفرع" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox x:Name="ckAllBranches" Grid.Column="1" Content="الكل" Style="{StaticResource ModernCheckBox}" Checked="ckAllBranches_CheckedChanged" Unchecked="ckAllBranches_CheckedChanged"/>
                                </Grid>
                                <ComboBox x:Name="cmbBranches" Style="{StaticResource ModernComboBox}" DisplayMemberPath="name" SelectedValuePath="id"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox x:Name="chkSecondery" Content="📋 فقط الحسابات الفرعية" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="chkActiveAcc" Content="✅ إظهار الحسابات النشطة" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,6"/>
                                <CheckBox x:Name="chkPrevbalance" Content="📊 استثناء الرصيد السابق" Style="{StaticResource ModernCheckBox}"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnShow" Content="🔎 عرض" Style="{StaticResource ViewBtn}" Height="42" FontSize="14" Margin="0,0,0,10" Click="btnShow_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- DataGrid -->
            <Border Grid.Column="1" Margin="6" Background="White" CornerRadius="10" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" CornerRadius="10,10,0,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📊 ميزان المراجعة" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="lblRowCount" Grid.Column="1" Text="عدد السجلات: 0" Foreground="#DCE7FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="TreeList1"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource GridRowStyle}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              AlternatingRowBackground="#F5F8FF"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E7ECF5"
                              Background="White"
                              MouseRightButtonUp="TreeList1_RightClick">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الحساب" Binding="{Binding TrAccount}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="اسم الحساب" Binding="{Binding TrAccName}" Width="*" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد افتتاحي مدين" Binding="{Binding TrDeptIntial, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد افتتاحي دائن" Binding="{Binding TrCreditIntial, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد سابق مدين" Binding="{Binding TrDeptPervious, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد سابق دائن" Binding="{Binding TrCreditPervious, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="حركة مدين" Binding="{Binding TrDebtorMovement, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="حركة دائن" Binding="{Binding TrCreditorMovement, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد مدين" Binding="{Binding TrDeptBlc, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد دائن" Binding="{Binding TrCreditBlc, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد ختامي مدين" Binding="{Binding TrDeptFinal, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                            <DataGridTextColumn Header="رصيد ختامي دائن" Binding="{Binding TrCreditFinal, StringFormat=N2}" Width="100" ElementStyle="{StaticResource GridCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Balanced Text -->
        <Border Grid.Row="2" Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="0,1,0,1" Padding="10,6">
            <TextBox x:Name="txtIsBalanced" Background="Transparent" BorderThickness="0" FontSize="13" FontWeight="Bold" Foreground="Red" IsReadOnly="True" TextAlignment="Center"/>
        </Border>

        <!-- Footer: Summary & Action Buttons -->
        <Border Grid.Row="3" Background="{StaticResource FooterBrush}" Padding="8" FlowDirection="LeftToRight">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar x:Name="ProgressBar1" Grid.Row="0" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Foreground="#2CC36B" Background="#1D3268" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="btnClose" Content="✖ خروج" Style="{StaticResource DangerBtn}" Margin="0,0,6,0" Click="btnClose_Click"/>
                        <Button x:Name="btnExportExcel" Content="📊 تصدير Excel" Style="{StaticResource ExportBtn}" Margin="0,0,6,0" Click="btnExportExcel_Click"/>
                        <Button x:Name="btnPreview" Content="👁️ معاينة" Style="{StaticResource ActionBtn}" Margin="0,0,6,0" Click="btnPreview_Click"/>
                        <Button x:Name="btnPrint" Content="🖨️ طباعة" Style="{StaticResource ActionBtn}" Click="btnPrint_Click"/>
                    </StackPanel>

                    <!-- Summary Cards -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                            <Border Background="White" BorderThickness="0" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="مجموع مدين الحركة" FontSize="10" FontWeight="Bold" Foreground="#1B2642" TextAlignment="Center"/>
                                    <TextBlock x:Name="txtSumDebtorMovement" Text="0.00" FontSize="13" FontWeight="Bold" Foreground="#2E4E9E" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderThickness="0" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="مجموع دائن الحركة" FontSize="10" FontWeight="Bold" Foreground="#1B2642" TextAlignment="Center"/>
                                    <TextBlock x:Name="txtSumCreditorMovement" Text="0.00" FontSize="13" FontWeight="Bold" Foreground="#2E4E9E" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderThickness="0" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="مجموع ختامي مدين" FontSize="10" FontWeight="Bold" Foreground="#1B2642" TextAlignment="Center"/>
                                    <TextBlock x:Name="txtSumDeptFinal" Text="0.00" FontSize="13" FontWeight="Bold" Foreground="#2E4E9E" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderThickness="0" CornerRadius="6" Padding="10,4" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="مجموع ختامي دائن" FontSize="10" FontWeight="Bold" Foreground="#1B2642" TextAlignment="Center"/>
                                    <TextBlock x:Name="txtSumCreditFinal" Text="0.00" FontSize="13" FontWeight="Bold" Foreground="#2E4E9E" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>