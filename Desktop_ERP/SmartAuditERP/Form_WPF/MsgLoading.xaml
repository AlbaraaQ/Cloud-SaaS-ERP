<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.MsgLoading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="تحميل"
    Width="500" Height="210"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    WindowStyle="ToolWindow"
    ResizeMode="NoResize"
    Loaded="Window_Loaded">

    <dx:ThemedWindow.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>
    </dx:ThemedWindow.Resources>

    <Border Background="White"
            CornerRadius="12"
            Margin="10"
            Padding="20,16"
            Effect="{StaticResource CardShadow}">
        <StackPanel>

            <!-- Header -->
            <TextBlock x:Name="Label2"
                       Text="⏳ انتظر جاري التحميل..."
                       FontSize="14" FontWeight="Bold"
                       Foreground="#2E4E9E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- Progress Bar -->
            <ProgressBar x:Name="ProgressBar1"
                         Height="22"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="#3A63C3"
                         Background="#E8EBF5"
                         Margin="0,0,0,10"/>

            <!-- Percentage Label -->
            <TextBlock x:Name="Label1"
                       Text="0%"
                       FontSize="13" FontWeight="Bold"
                       Foreground="#1B2642"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Border>
</dx:ThemedWindow>