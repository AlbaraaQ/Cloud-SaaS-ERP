<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.frmDecisionHelp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="مساعدة في اتخاذ القرار"
    Width="1100" Height="720"
    MinWidth="980" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ShowIcon="False">

    <dx:ThemedWindow.Resources>

        <!-- ═══════════════════ Brushes ═══════════════════ -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#2E4E9E" Offset="0.6"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FooterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D3268" Offset="0"/>
            <GradientStop Color="#2B4B98" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF9E57" Offset="0"/>
            <GradientStop Color="#E67817" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5A8DFF" Offset="0"/>
            <GradientStop Color="#3D66D6" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BorderLight" Color="#D0D7E8"/>

        <!-- ═══════════════════ Effects ═══════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12" ShadowDepth="2"
                          Direction="270" Opacity="0.15"
                          Color="#000000"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="6" ShadowDepth="1"
                          Direction="270" Opacity="0.20"
                          Color="#000000"/>

        <!-- ═══════════════════ Styles ═══════════════════ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ModernCombo" TargetType="dxe:ComboBoxEdit">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1B2642"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource BtnShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}"/>
        </Style>

        <Style x:Key="PrintBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource SaveBrush}"/>
        </Style>

    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Sidebar Filters -->
                <ColumnDefinition Width="240"/>
                <!-- Main Grid -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════ -->
            <!-- Sidebar -->
            <!-- ═══════════════════════════════════ -->
            <Border Grid.Column="0"
                    Margin="10,10,6,10"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Title -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="12,10">
                        <TextBlock Text="🔎 معايير التصفية"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Filters Content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="12">
                        <StackPanel>

                            <!-- Warehouse -->
                            <Border Background="#F8FAFF"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🏭 المستودع"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="chkAllSafes"
                                              Content="الكل"
                                              IsChecked="True"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,0,0,6"/>
                                    <dxe:ComboBoxEdit x:Name="cmbSafes"
                                                      Style="{StaticResource ModernCombo}"
                                                      IsEnabled="False"
                                                      AutoComplete="True"
                                                      NullText="اختر المستودع..."/>
                                </StackPanel>
                            </Border>

                            <!-- Item -->
                            <Border Background="#F8FAFF"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="📦 الصنف"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="chkAllItems"
                                              Content="الكل"
                                              IsChecked="True"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <dxe:ComboBoxEdit x:Name="txtItemName"
                                                          Grid.Column="0"
                                                          Style="{StaticResource ModernCombo}"
                                                          IsEnabled="False"
                                                          AutoComplete="True"
                                                          NullText="ابحث عن صنف..."/>
                                        <Button x:Name="btnSearch"
                                                Grid.Column="1"
                                                Content="🔍"
                                                FontSize="16"
                                                Background="{StaticResource InfoBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="4,0,0,0"
                                                ToolTip="بحث عن صنف">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Height="34">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Group -->
                            <Border Background="#F8FAFF"
                                    BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🗂️ المجموعة"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,8"/>
                                    <CheckBox x:Name="chkAllGroups"
                                              Content="الكل"
                                              IsChecked="True"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0,0,0,6"/>
                                    <dxe:ComboBoxEdit x:Name="cmbGroups"
                                                      Style="{StaticResource ModernCombo}"
                                                      IsEnabled="False"
                                                      AutoComplete="True"
                                                      NullText="اختر المجموعة..."/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Show Button -->
                    <Border Grid.Row="2" Padding="12,10">
                        <Button x:Name="btnShow"
                                Content="🔍 عرض النتائج"
                                Style="{StaticResource ShowBtn}"
                                Height="44"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ═══════════════════════════════════ -->
            <!-- Main Grid Area -->
            <!-- ═══════════════════════════════════ -->
            <Border Grid.Column="1"
                    Margin="0,10,10,10"
                    Background="White"
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Grid Title -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="16,10">
                        <DockPanel>
                            <TextBlock Text="📊 نتائج تحليل المخزون"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtRecordCount"
                                       Text="| 0 سجل"
                                       Foreground="#B3CCFF"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>

                    <!-- Progress Bar -->
                    <dxe:ProgressBarEdit x:Name="ProgressBar1"
                                         Grid.Row="1"
                                         Height="6"
                                         Margin="0"
                                         Minimum="0"
                                         Maximum="100"/>

                    <!-- DevExpress Grid -->
                    <dxg:GridControl x:Name="GridControl1"
                                     Grid.Row="2">
                        <dxg:GridControl.Columns>

                            <dxg:GridColumn x:Name="DgvItemNo"
                                            Header="رقم الصنف"
                                            FieldName="DgvItemNo"
                                            Width="80"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center"/>

                            <dxg:GridColumn x:Name="DgvItemName"
                                            Header="📦 الصنف"
                                            FieldName="DgvItemName"
                                            Width="220"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center"/>

                            <dxg:GridColumn x:Name="DgvIncome"
                                            Header="📥 المبلغ الوارد"
                                            FieldName="DgvIncome"
                                            Width="110"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center"/>

                            <dxg:GridColumn x:Name="DgvOutcome"
                                            Header="📤 المبلغ الصادر"
                                            FieldName="DgvOutcome"
                                            Width="110"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center"/>

                            <dxg:GridColumn x:Name="DgvBalance"
                                            Header="⚖️ الرصيد"
                                            FieldName="DgvBalance"
                                            Width="100"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center"/>

                            <dxg:GridColumn x:Name="DgvSlackRate"
                                            Header="📉 معدل الركود"
                                            FieldName="DgvSlackRate"
                                            Width="100"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center"/>

                            <dxg:GridColumn x:Name="DgvRotationRate"
                                            Header="🔄 معدل الدوران"
                                            FieldName="DgvRotationRate"
                                            Width="100"
                                            AllowEditing="False"
                                            HorizontalHeaderContentAlignment="Center"/>

                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="GridView1"
                                           ShowGroupPanel="False"
                                           AllowGrouping="False"
                                           AutoWidth="False"
                                           NavigationStyle="Row"
                                           AllowPerPixelScrolling="True"
                                           SearchPanelNullText="🔍 ابحث هنا..."
                                           ShowSearchPanelCloseButton="True">
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition FieldName="DgvBalance"
                                                         Expression="[DgvBalance] &lt; 0"
                                                         ApplyToRow="True">
                                        <dxg:FormatCondition.Format>
                                            <dx:Format Background="#FFEBEE"/>
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>

                </Grid>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════ -->
        <!-- Footer Buttons -->
        <!-- ═══════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource FooterBrush}"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Record info -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="📌 إجمالي السجلات: "
                               Foreground="#B3CCFF"
                               FontFamily="Tahoma"
                               FontSize="12"/>
                    <TextBlock x:Name="txtFooterCount"
                               Text="0"
                               Foreground="White"
                               FontFamily="Tahoma"
                               FontSize="12"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button x:Name="btnClose"
                            Content="✖ خروج"
                            Style="{StaticResource DangerBtn}"
                            Width="90"
                            Margin="0,0,6,0"/>

                    <Button x:Name="btnPreview"
                            Content="👁️ معاينة"
                            Style="{StaticResource ActionBtn}"
                            Width="90"
                            Margin="0,0,6,0"/>

                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintBtn}"
                            Width="90"
                            Margin="0,0,6,0"/>

                    <Button x:Name="btnExport"
                            Content="📊 تصدير Excel"
                            Style="{StaticResource ExportBtn}"
                            Width="120"/>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</dx:ThemedWindow>