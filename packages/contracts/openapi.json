                  "current": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "new": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 200
                  }
                },
                "required": [
                  "current",
                  "new"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "400": {
            "description": "Wrong current password or policy rejection"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Change the caller password and revoke all sessions",
        "tags": [
          "auth"
        ]
      }
    },
