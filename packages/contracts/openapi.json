    "/api/v1/memberships": {
      "get": {
        "operationId": "MembershipsController_list",
        "parameters": [
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "filter[status]",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "Membership page"
          },
          "400": {
            "description": "Disallowed filter (FILTER_NOT_ALLOWED)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List tenant memberships",
        "tags": [
          "tenancy"
        ]
      },
      "post": {
        "operationId": "MembershipsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  },
                  "fullName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "branchScope": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "minItems": 1
                      },
                      {
                        "enum": [
                          "null"
                        ],
                        "nullable": true
                      }
                    ]
                  },
                  "roleIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "email",
                  "roleIds"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Membership created"
          },
          "422": {
            "description": "Role does not belong to this tenant"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Invite a user into the tenant (by e-mail) with roles and branch scope",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/api/v1/memberships/{id}": {
      "get": {
        "operationId": "MembershipsController_read",
        "parameters": [],
