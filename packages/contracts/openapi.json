        "tags": [
          "tenancy"
        ]
      },
      "patch": {
        "operationId": "MembershipsController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "branchScope": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "minItems": 1
                      },
                      {
                        "enum": [
                          "null"
                        ],
                        "nullable": true
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "invited",
                      "suspended"
                    ]
                  },
                  "roleIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated membership"
          },
          "404": {
            "description": "Not found in this tenant"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update a membership (display name, branch scope, status, roles)",
        "tags": [
          "tenancy"
        ]
      },
      "delete": {
        "operationId": "MembershipsController_remove",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "422": {
            "description": "Cannot remove the last active owner"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Soft-delete a membership",
        "tags": [
          "tenancy"
        ]
      }
    },
